def cmd_fire(args: argparse.Namespace) -> int:
    repo_root, open_dir, identity, registry = open_context(Path.cwd())
    current = build_atom_index(open_dir)
    atoms = atom_map(current)
    if args.atom_id not in atoms:
        raise CFError(f"unknown atom: {args.atom_id}")
    fires = load_fires(repo_root, registry)
    fire_no = len(fires) + 1
    key = fire_key(args.atom_id, args.atom_id, args.reason, [args.atom_id], base_commit(registry))
    fires.append(
        {
            "type": "fire",
            "version": VERSION,
            "fire_uid": f"fire_{hashlib.sha1(key.encode()).hexdigest()[:12]}",
            "display_id": f"FIRE-{fire_no:03d}",
            "status": "open",
            "severity": "required",
            "source": {"atom_id": args.atom_id, "content_hash_at_fire": atoms[args.atom_id]["content_hash"]},
            "target": {"atom_id": args.atom_id, "content_hash_at_fire": atoms[args.atom_id]["content_hash"]},
            "reason": args.reason,
            "trace_path": [args.atom_id],
            "created_by": "manual",
            "created_at": now_iso(),
            "key": key,
        }
    )
    save_fires(repo_root, registry, fires)
    set_open_state(repo_root, identity["branch"]["name"], identity["open"]["open_instance_id"], "open-burning")
    print(f"created {fires[-1]['display_id']}")
    return 0


def cmd_extinguish(args: argparse.Namespace) -> int:
    repo_root, open_dir, identity, registry = open_context(Path.cwd())
    policy = parse_policy(open_dir)
    if args.resolution == "no-change-required" and policy.get("no_change_required_requires_rationale", True) and not args.rationale:
        raise CFError("no-change-required requires --rationale")
    if not args.rationale and not args.evidence:
        raise CFError("extinguish requires --rationale or --evidence")
    scan = run_scan()
    atoms = atom_map(scan["atom_index"])
    trace_graph = scan["trace_graph"]
    fires = load_fires(repo_root, registry)
    fire = next((f for f in fires if f["display_id"] == args.fire_id or f["fire_uid"] == args.fire_id), None)
    if not fire:
        raise CFError(f"unknown fire: {args.fire_id}")
    if fire["status"] != "open" and not args.refresh:
        raise CFError(f"fire is not open: {args.fire_id}")
    source_id = fire["source"]["atom_id"]
    target_id = fire["target"]["atom_id"]
    link_basis = []
    for link in trace_graph.get("links", []):
        if {link["from"], link["to"]} == {source_id, target_id}:
            link_basis.append({"link_id": link["link_id"], "link_hash": link["link_hash"]})
    resolution = {
        "type": "resolution",
        "version": VERSION,
        "resolution_uid": "res_" + hashlib.sha1(f"{args.fire_id}:{time.time()}".encode()).hexdigest()[:12],
        "fire_uid": fire["fire_uid"],
        "resolution_type": args.resolution,
        "rationale": args.rationale,
        "evidence": args.evidence,
        "basis": {
            "source_atom": {"atom_id": source_id, "content_hash": atoms.get(source_id, {}).get("content_hash")},
            "target_atom": {"atom_id": target_id, "content_hash": atoms.get(target_id, {}).get("content_hash")},
            "trace_links": link_basis,
            "policy_hash": digest_bytes(canonical_json(parse_policy(open_dir))),
        },
        "resolved_at": now_iso(),
        "status": "active",
    }
    fire["status"] = "extinguished"
    fire["resolution_uid"] = resolution["resolution_uid"]
    resolutions = load_resolutions(repo_root, registry)
    if args.refresh:
        for existing in resolutions:
            if existing.get("fire_uid") == fire["fire_uid"] and existing.get("status") == "active":
                existing["status"] = "superseded"
    resolutions.append(resolution)
    save_fires(repo_root, registry, fires)
    save_resolutions(repo_root, registry, resolutions)
    verb = "refreshed" if args.refresh else "extinguished"
    print(f"{verb} {fire['display_id']}")
    return 0


def cmd_verify(args: argparse.Namespace) -> int:
    result = run_verify()
    if result["result"] == "passed":
        print("Verification passed.")
        return 0
    _, open_dir, _, _ = open_context(Path.cwd())
    policy = parse_policy(open_dir)
    blocking = []
    if policy_enabled(policy, "require_no_required_fires") and result["open_required_fires"]:
        blocking.append("open fires")
    if policy_enabled(policy, "require_trace_completeness") and result["missing_required_links"]:
        blocking.append("missing required links")
    if policy_enabled(policy, "require_no_stale_resolutions") and result["stale_resolutions"]:
        blocking.append("stale resolutions")
    if policy_enabled(policy, "reject_duplicate_atom_ids") and result["duplicate_atom_ids"]:
        blocking.append("duplicate atom ids")
    if policy_enabled(policy, "require_verification_success") and result["failed_checks"]:
        blocking.append("failed checks")
    print("Verification failed.")
    print(f"Blocking checks: {', '.join(blocking) if blocking else 'none'}")
    print(f"Open fires: {result['open_required_fires']}")
    print(f"Missing required links: {len(result['missing_required_links'])}")
    print(f"Stale resolutions: {len(result['stale_resolutions'])}")
    print(f"Duplicate atom ids: {len(result['duplicate_atom_ids'])}")
    print(f"Failed checks: {len(result['failed_checks'])}")
    if args.details:
        print_verify_details(result)
    return 1


def print_verify_details(result: dict[str, Any]) -> None:
    if result["missing_required_links"]:
        print("Missing required link details:")
        for item in result["missing_required_links"][:5]:
            print(f"  {item['atom_id']} requires {item['required_type']} -> {item['target_kind']} min {item.get('min', 1)}")
    if result["stale_resolutions"]:
        print("Stale resolution details:")
        for item in result["stale_resolutions"][:5]:
            print(f"  {item['resolution_uid']}: {item['reason']}")
    if result["duplicate_atom_ids"]:
        print("Duplicate Atom ID details:")
        for atom_id in result["duplicate_atom_ids"][:5]:
            print(f"  {atom_id}")
    if result["failed_checks"]:
        print("Failed check details:")
        for item in result["failed_checks"][:5]:
            first_line = item.get("output", "").strip().splitlines()
            summary = first_line[0] if first_line else ""
            print(f"  {item.get('id', 'verification')}: {item.get('command', '')} {summary}")


def cmd_commit(args: argparse.Namespace) -> int:
    repo_root, open_dir, identity, registry = open_context(Path.cwd())
    verification = run_verify()
    if verification["result"] != "passed":
        raise CFError("commit blocked: verification failed or consistency blockers remain")
    policy = parse_policy(open_dir)
    scan = read_json(active_dir(repo_root, registry["open"]["open_instance_id"]) / "scan.json")
    manifest = build_manifest(repo_root, open_dir)
    manifest_id = store_object(repo_root, "content_manifest", manifest)
    atom_id = store_object(repo_root, "atom_index", scan["atom_index"])
    trace_id = store_object(repo_root, "trace_graph", scan["trace_graph"])
    fires = load_fires(repo_root, registry)
    resolutions = load_resolutions(repo_root, registry)
    fire_id = store_object(repo_root, "fire_ledger", {"type": "fire_ledger", "version": VERSION, "fires": fires})
    resolution_id = store_object(repo_root, "resolution_ledger", {"type": "resolution_ledger", "version": VERSION, "resolutions": resolutions})
    verification_id = store_object(repo_root, "verification", verification)
    policy_id = store_object(repo_root, "policy", {"type": "policy", "version": VERSION, "policy": policy})
    state = active_state(repo_root, registry)
    parents = [registry["open"]["current_base_commit"]]
    if state.get("pending_merge_parent"):
        parents.append(state["pending_merge_parent"])
    commit = {
        "type": "commit",
        "version": VERSION,
        "parents": parents,
        "message": args.message,
        "roots": {
            "content_manifest": manifest_id,
            "atom_index": atom_id,
            "trace_graph": trace_id,
            "fire_delta": fire_id,
            "resolution_ledger": resolution_id,
            "verification": verification_id,
            "policy": policy_id,
        },
        "certificate": {
            "result": "consistent",
            "open_required_fires": verification["open_required_fires"],
            "failed_checks": len(verification["failed_checks"]),
            "missing_required_links": len(verification["missing_required_links"]),
            "stale_resolutions": len(verification["stale_resolutions"]),
            "duplicate_atom_ids": len(verification["duplicate_atom_ids"]),
        },
        "changed_atoms": scan["changed_atoms"],
        "extinguished_fires": [f["fire_uid"] for f in fires if f.get("status") == "extinguished"],
        "created_at": now_iso(),
    }
    signing_key = os.environ.get("CODEFIRE_SIGNING_KEY", "")
    signer = args.signer or os.environ.get("CODEFIRE_SIGNER") or os.environ.get("USER") or "anonymous"
    key_id = args.key_id or os.environ.get("CODEFIRE_SIGNING_KEY_ID") or signer
    if signing_key:
        commit = sign_commit_payload(commit, signer, signing_key, key_id)
    elif policy.get("require_commit_signature"):
        raise CFError("commit blocked: commit signature is required but CODEFIRE_SIGNING_KEY is not set")
    commit_id = store_object(repo_root, "commit", commit)
    with file_lock(repo_dirs(repo_root)["locks"] / "repo.lock"):
        branch = load_branch(repo_root, identity["branch"]["name"])
        branch["head"] = commit_id
        branch["state"] = "open-clean"
        save_branch(repo_root, branch)
        registry["open"]["current_base_commit"] = commit_id
        registry["state"]["last_known"] = "open-clean"
        write_json(opened_registry_path(repo_root, identity["branch"]["name"]), registry)
        reset_active(repo_root, registry, "open-clean")
    print("Sealed commit created.")
    print(f"Commit: {commit_id}")
    print(f"Branch: {identity['branch']['name']}")
    print("State: open-clean")
    return 0


def cmd_merge(args: argparse.Namespace) -> int:
    repo_root = find_repo_root(Path.cwd())
    with file_lock(repo_dirs(repo_root)["locks"] / "repo.lock"):
        source = load_branch(repo_root, args.source_branch)
        require_source_branch_sealed(repo_root, args.source_branch, "merge")
        target_branch = load_branch(repo_root, args.into)
        validate_sealed_commit(repo_dirs(repo_root)["objects"], source["head"])
        validate_sealed_commit(repo_dirs(repo_root)["objects"], target_branch["head"])
        registry = read_json(opened_registry_path(repo_root, args.into))
        if not registry:
            raise CFError(f"target branch must be open: {args.into}")
        if registry["state"]["last_known"] != "open-clean":
            raise CFError("target branch must be open-clean before merge")
        base = common_ancestor(repo_root, source["head"], target_branch["head"])
        if not base:
            raise CFError("no common ancestor found")
        target_dir = Path(registry["open"]["path"])
        base_files = manifest_contents(repo_root, base)
        source_files = manifest_contents(repo_root, source["head"])
        target_files = manifest_contents(repo_root, target_branch["head"])
        conflicts: list[str] = []
        for rel in sorted(set(base_files) | set(source_files) | set(target_files)):
            b = base_files.get(rel)
            s = source_files.get(rel)
            t = target_files.get(rel)
            out = target_dir / rel
            if s == b:
                continue
            if t == b:
                write_merged_file(out, s)
                continue
            if s == t:
                continue
            conflicts.append(rel)
            write_merged_file(out, conflict_content(t, s))
        state_path = active_dir(repo_root, registry["open"]["open_instance_id"]) / "state.json"
        state = read_json(state_path, {})
        state["pending_merge_parent"] = source["head"]
        state["pending_merge_base"] = base
        state["merge_conflicts"] = conflicts
        write_json(state_path, state)
        set_open_state(repo_root, args.into, registry["open"]["open_instance_id"], "open-burning")
    if conflicts:
        print(f"merged {args.source_branch} into {args.into} with conflicts; target is open-burning")
        for rel in conflicts:
            print(f"  conflict: {rel}")
    else:
        print(f"merged {args.source_branch} into {args.into}; target is open-burning")
    return 0


