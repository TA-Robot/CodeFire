def ruby_block_delta(line: str) -> int:
    stripped = line.strip()
    if not stripped or stripped.startswith("#"):
        return 0
    opens = 0
    if re.match(r"^(class|module|def|if|unless|case|while|until|for|begin)\b", stripped):
        opens += 1
    if re.search(r"\bdo\b(?:\s*\|[^|]*\|)?\s*(?:#.*)?$", stripped):
        opens += 1
    closes = 1 if re.match(r"^end\b", stripped) else 0
    return opens - closes


def ruby_block_end(lines: list[str], start: int) -> int:
    depth = 0
    for j in range(start, len(lines)):
        depth += ruby_block_delta(lines[j])
        if j > start and depth <= 0:
            return j + 1
    return len(lines)


def ruby_blocks(lines: list[str]) -> list[tuple[int, int, str, str]]:
    blocks: list[tuple[int, int, str, str]] = []
    type_pattern = re.compile(r"^\s*(class|module)\s+([A-Z][A-Za-z0-9_:]*)\b")
    method_pattern = re.compile(r"^\s*def\s+(?:self\.)?([A-Za-z_][A-Za-z0-9_!?=]*)\b")
    type_stack: list[tuple[str, int]] = []
    depth = 0
    for i, line in enumerate(lines):
        while type_stack and depth < type_stack[-1][1]:
            type_stack.pop()
        type_match = type_pattern.match(line)
        if type_match:
            name = type_match.group(2).split("::")[-1]
            end = ruby_block_end(lines, i)
            type_stack.append((name, depth + 1))
            blocks.append((i, end, "type", name))
        else:
            method_match = method_pattern.match(line)
            if method_match:
                method_name = method_match.group(1)
                owner = type_stack[-1][0] if type_stack else ""
                name = f"{owner}.{method_name}" if owner else method_name
                symbol_type = "method" if owner else "function"
                end = ruby_block_end(lines, i)
                blocks.append((i, end, symbol_type, name))
        depth += ruby_block_delta(line)
    return blocks


