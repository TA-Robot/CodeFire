            explicit_by_line[i] = m.group(1)
    atoms: list[dict[str, Any]] = []
    used_explicit: set[int] = set()
    for start, end, symbol_type, name in swift_blocks(lines):
        explicit_line = None
        for candidate in range(max(0, start - 3), start + 1):
            if candidate in explicit_by_line and candidate not in used_explicit:
                explicit_line = candidate
        if explicit_line is not None:
            atom_id = explicit_by_line[explicit_line]
            used_explicit.add(explicit_line)
        else:
            atom_id = f"CODE:{rel.as_posix()}::{symbol_type}:{name}"
        content_start = explicit_line if explicit_line is not None else start
        content = "\n".join(lines[content_start:end]).strip() + "\n"
        atoms.append(
            {
                "atom_id": atom_id,
                "kind": kind_from_atom_id(atom_id, fallback_kind),
                "artifact_path": rel.as_posix(),
                "selector": {"type": f"swift_{symbol_type}", "value": name},
                "content_hash": hash_text(content),
            }
        )
    for line_no, atom_id in explicit_by_line.items():
        if line_no in used_explicit:
            continue
        content = lines[line_no].strip() + "\n"
        atoms.append(
            {
                "atom_id": atom_id,
                "kind": kind_from_atom_id(atom_id, fallback_kind),
                "artifact_path": rel.as_posix(),
                "selector": {"type": "swift_comment", "value": atom_id},
                "content_hash": hash_text(content),
            }
        )
    return atoms


def cpp_blocks(lines: list[str]) -> list[tuple[int, int, str, str]]:
    blocks: list[tuple[int, int, str, str]] = []
    type_pattern = re.compile(
        r"^\s*(?:template\s*<[^>]+>\s*)?(class|struct|enum(?:\s+class)?)\s+([A-Za-z_][A-Za-z0-9_]*)\b"
    )
    function_pattern = re.compile(
        r"^\s*(?:template\s*<[^>]+>\s*)?(?:inline|static|virtual|constexpr|consteval|friend|extern|explicit|\s)*[\w:<>\*&,\s~]+?\s+((?:[A-Za-z_][A-Za-z0-9_]*::)?~?[A-Za-z_][A-Za-z0-9_]*)\s*\([^;]*\)\s*(?:const\s*)?(?:noexcept\s*)?(?:override\s*)?(?:final\s*)?(?:->\s*[^{]+)?\{"
    )
    current_type = ""
    type_stack: list[tuple[str, int]] = []
    depth = 0
    for i, line in enumerate(lines):
        while type_stack and depth < type_stack[-1][1]:
            type_stack.pop()
        current_type = type_stack[-1][0] if type_stack else current_type
        type_match = type_pattern.match(line)
        if type_match:
            keyword = type_match.group(1)
            symbol_type = "enum" if keyword.startswith("enum") else "type"
            name = type_match.group(2)
            current_type = name
            end = len(lines)
            brace_balance = line.count("{") - line.count("}")
            if brace_balance > 0:
                type_stack.append((name, depth + brace_balance))
                for j in range(i + 1, len(lines)):
                    brace_balance += lines[j].count("{") - lines[j].count("}")
                    if brace_balance <= 0:
                        end = j + 1
                        break
            else:
                for j in range(i + 1, len(lines)):
                    if lines[j].strip() and (type_pattern.match(lines[j]) or function_pattern.match(lines[j])):
                        end = j
                        break
            blocks.append((i, end, symbol_type, name))
        function_match = function_pattern.match(line)
        if function_match:
            raw_name = function_match.group(1)
            owner = type_stack[-1][0] if type_stack else ""
            function_name = raw_name
            if "::" in raw_name:
                owner, function_name = raw_name.rsplit("::", 1)
                owner = owner.split("::")[-1]
            if owner and function_name in {owner, f"~{owner}"}:
                depth += line.count("{") - line.count("}")
                continue
            name = f"{owner}.{function_name}" if owner else function_name
            symbol_type = "method" if owner else "function"
            end = len(lines)
            brace_balance = line.count("{") - line.count("}")
            if brace_balance > 0:
                for j in range(i + 1, len(lines)):
                    brace_balance += lines[j].count("{") - lines[j].count("}")
                    if brace_balance <= 0:
                        end = j + 1
                        break
            blocks.append((i, end, symbol_type, name))
        depth += line.count("{") - line.count("}")
    return blocks


def extract_cpp_atoms(path: Path, rel: Path, fallback_kind: str) -> list[dict[str, Any]]:
    lines = read_text_lossy(path).splitlines()
    explicit_by_line: dict[int, str] = {}
    for i, line in enumerate(lines):
