def _rename_directory_noreplace_at(directory_fd: int, source: str, target: str) -> None:
    import ctypes

    renameat2 = getattr(ctypes.CDLL(None, use_errno=True), "renameat2", None)
    if renameat2 is None:
        raise CFError("atomic no-replace remote bootstrap is unsupported on this platform")
    renameat2.argtypes = [
        ctypes.c_int,
        ctypes.c_char_p,
        ctypes.c_int,
        ctypes.c_char_p,
        ctypes.c_uint,
    ]
    renameat2.restype = ctypes.c_int
    result = renameat2(
        directory_fd,
        source.encode("utf-8"),
        directory_fd,
        target.encode("utf-8"),
        1,
    )
    if result != 0:
        errno_value = ctypes.get_errno()
        raise OSError(errno_value, os.strerror(errno_value), target)


def _write_remote_project_descriptor_at(
    project_fd: int, project_root: Path, org: str, app: str, provenance: str
) -> None:
    descriptor = {
        "type": "codefire_remote_project",
        "version": 1,
        "stable_project_id": f"CF-PROJECT-{secrets.token_hex(16)}",
        "protocol_generation": 1,
        "organization": org,
        "application": app,
        "creation_provenance": provenance,
        "created_at": now_iso(),
    }
    try:
        _write_create_noreplace_at(
            project_fd, "remote_project.json", canonical_json(descriptor) + b"\n"
        )
    except FileExistsError:
        _validate_remote_project_descriptor_at(project_fd, project_root, org, app)


def _validate_remote_project_descriptor_at(
    project_fd: int, project_root: Path, org: str, app: str
) -> dict[str, Any]:
    descriptor = json.loads(
        _read_regular_bounded_at(project_fd, "remote_project.json", 16 * 1024)
    )
    stable_id = descriptor.get("stable_project_id")
    valid = (
        descriptor.get("type") == "codefire_remote_project"
        and descriptor.get("version") == 1
        and descriptor.get("protocol_generation") == 1
        and descriptor.get("organization") == org
        and descriptor.get("application") == app
        and isinstance(stable_id, str)
        and stable_id.startswith("CF-PROJECT-")
        and len(stable_id) == 43
    )
    if not valid:
        raise CFError(f"remote project descriptor is invalid: {project_root / 'remote_project.json'}")
    return descriptor


