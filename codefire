def reject_legacy_cross_project_merge_request_read(
    mr: dict[str, Any], source_project_root: Path, target_project_root: Path
) -> None:
    if "subject" not in mr and source_project_root != target_project_root:
        raise CFError(
            "legacy cross-project merge request cannot be read without holding both "
            "project gates; run request-review to materialize its target-local subject"
        )


def canonical_remote_object_records(
    records: list[dict[str, Any]],
) -> list[dict[str, Any]]:
    canonical = sorted(
        records,
        key=lambda record: str(record.get("object_id", ""))
        if isinstance(record, dict)
        else "",
    )
    seen: set[str] = set()
    for record in canonical:
        object_id = record.get("object_id") if isinstance(record, dict) else None
        if not isinstance(object_id, str) or not object_id:
            raise CFError("remote object set contains a record without an object ID")
        if object_id in seen:
            raise CFError("remote object set contains a duplicate object ID")
        seen.add(object_id)
    return canonical


class AccountedRemoteObjectSetDigest:
    """Own one canonical object-set digest on a decision-work ledger."""

    ORDERED_LIST_BASE_BYTES = sys.getsizeof([])
    ORDERED_LIST_SLOT_BYTES = 16
    DIGEST_RETAINED_BYTES = 256
    ENCODER_BASE_BYTES = 4096
    ENCODER_BYTES_PER_SOURCE_BYTE = 256

    def __init__(
        self,
        records: list[dict[str, Any]],
        ledger: DecisionWorkLedger,
        source_canonical_upper: int,
        deadline: HTTPRequestDeadline | None = None,
        *,
        _handoff_owner: Any | None = None,
    ) -> None:
        if (
            isinstance(source_canonical_upper, bool)
            or not isinstance(source_canonical_upper, int)
            or source_canonical_upper < 0
        ):
            raise CFError(
                "remote object-set source upper must be a non-negative integer"
            )
        if source_canonical_upper > (
            U64_MAX - self.ENCODER_BASE_BYTES
        ) // self.ENCODER_BYTES_PER_SOURCE_BYTE:
            raise CFError("remote object-set source upper exceeds the u64 domain")
        self._ledger = ledger
        self._ledger_identity = id(ledger)
        self._ordered: list[dict[str, Any]] | None = None
        self._digest: str | None = None
        self._retained_bytes = 0
        self._temporary_bytes = 0
        self._work_permit: DecisionWorkPermit | None = None
        self._closed = False
        if _handoff_owner is not None:
            if object.__getattribute__(_handoff_owner, "_digest_owner") is not None:
                raise CFError("remote object-set digest handoff slot is occupied")
            # Publish the exact child before its first reservation.  A
            # constructor/cleanup failure therefore remains caller-owned by
            # the already-returned semantic destination.
            object.__setattr__(_handoff_owner, "_digest_owner", self)
        initialized = False
        failure: BaseException | None = None
        work_permit: DecisionWorkPermit | None = None
        try:
            retained_bytes = (
                self.ORDERED_LIST_BASE_BYTES
                + self.ORDERED_LIST_SLOT_BYTES * len(records)
                + self.DIGEST_RETAINED_BYTES
            )
            temporary_bytes = (
                self.ENCODER_BASE_BYTES
                + self.ENCODER_BYTES_PER_SOURCE_BYTE * source_canonical_upper
            )
            acquires = {
                "retained_bytes": retained_bytes,
                "temporary_bytes": temporary_bytes,
            }
            # Publish a caller-created permit before reserve_into.  A
            # registered-then-raise reservation therefore cannot become an
            # unobservable constructor-local permit.
            work_permit = DecisionWorkPermit()
            self._work_permit = work_permit
            reserve_failure: BaseException | None = None
            try:
                ledger.reserve_into(
                    work_permit,
                    "query",
                    charges={
                        "aggregate_bytes": source_canonical_upper,
                        "object_records": len(records),
                    },
                    acquires=acquires,
                    counters={"object_records": len(records)},
                )
            except BaseException as error:
                reserve_failure = error
            if work_permit not in ledger._reserved:
                self._work_permit = None
                work_permit = None
                if reserve_failure is not None:
                    raise reserve_failure
                raise CFError(
                    "remote object-set digest reservation was not registered"
                )
            if reserve_failure is not None:
                self._detach_failure_chain(reserve_failure)

            # Reconcile acquisitions even if the ledger raises after commit.
            # The published owner can then release the exact scalars.
            retained_before = ledger._current.get("retained_bytes", 0)
            temporary_before = ledger._current.get("temporary_bytes", 0)
            consume_failure: BaseException | None = None
            try:
                ledger.consume_reserved(
                    work_permit,
                    phase="query",
                    acquires=acquires,
                )
            except BaseException as error:
                consume_failure = error
            retained_committed = (
                ledger._current.get("retained_bytes", 0)
                == retained_before + retained_bytes
            )
            temporary_committed = (
                ledger._current.get("temporary_bytes", 0)
                == temporary_before + temporary_bytes
            )
            if retained_committed and temporary_committed:
                self._retained_bytes = retained_bytes
                self._temporary_bytes = temporary_bytes
                if consume_failure is not None:
                    self._detach_failure_chain(consume_failure)
            elif consume_failure is not None:
                raise consume_failure
            else:
                raise CFError(
                    "remote object-set digest acquisition did not commit"
                )
            if work_permit not in ledger._reserved:
                self._work_permit = None
            work_permit = None
            self._ordered = list(records)
            self._heap_sort(deadline)
            self._validate_ordered(deadline)
            self._validate_source_upper(
                source_canonical_upper, deadline
            )
            self._digest = self._hash_ordered(deadline)
            permit = self._work_permit
            if permit is not None and self._ledger.permit_is_open(permit):
                self._ledger.cancel_permit(permit)
            self._work_permit = None
            initialized = True
        except BaseException as exc:
            # Streaming helpers may leave large local stacks/key lists in an
            # exception traceback. Detach those frames before ledger-owned
            # Temporary/Retained scalars are released by close().
            self._detach_failure_chain(exc)
            failure = exc
        finally:
            if work_permit is not None and ledger.permit_is_open(work_permit):
                ledger.cancel_permit(work_permit)
            if not initialized:
                self.close()
        if failure is not None:
            raise failure

    @staticmethod
    def _poll(deadline: HTTPRequestDeadline | None) -> None:
        if deadline is not None:
            deadline.check("remote object-set digest")

    @staticmethod
    def _detach_failure_chain(failure: BaseException) -> None:
        current: BaseException | None = failure
        while current is not None:
            next_failure = current.__cause__ or current.__context__
            current.__traceback__ = None
            current.__cause__ = None
            current.__context__ = None
            current = next_failure

    @staticmethod
    def _sort_key(record: Any) -> str:
        return (
            str(record.get("object_id", ""))
            if isinstance(record, dict)
            else ""
        )

    def _heap_sort(self, deadline: HTTPRequestDeadline | None) -> None:
        ordered = self._ordered
        if ordered is None:
            raise CFError("remote object-set digest owner is unavailable")

        def sift_down(root: int, end: int) -> None:
            while root * 2 + 1 <= end:
                self._poll(deadline)
                child = root * 2 + 1
                if (
                    child + 1 <= end
                    and self._sort_key(ordered[child])
                    < self._sort_key(ordered[child + 1])
                ):
                    child += 1
                if self._sort_key(ordered[root]) >= self._sort_key(
                    ordered[child]
                ):
                    return
                ordered[root], ordered[child] = ordered[child], ordered[root]
                root = child

        for root in range((len(ordered) - 2) // 2, -1, -1):
            sift_down(root, len(ordered) - 1)
        for end in range(len(ordered) - 1, 0, -1):
            self._poll(deadline)
            ordered[0], ordered[end] = ordered[end], ordered[0]
            sift_down(0, end - 1)

    def _validate_ordered(
        self, deadline: HTTPRequestDeadline | None
    ) -> None:
        ordered = self._ordered
        if ordered is None:
            raise CFError("remote object-set digest owner is unavailable")
        prior: str | None = None
        for record in ordered:
            self._poll(deadline)
            object_id = (
                record.get("object_id")
                if isinstance(record, dict)
                else None
            )
            if not isinstance(object_id, str) or not object_id:
                raise CFError(
                    "remote object set contains a record without an object ID"
                )
            if object_id == prior:
                raise CFError(
                    "remote object set contains a duplicate object ID"
                )
            prior = object_id

    def _validate_source_upper(
        self,
        source_canonical_upper: int,
        deadline: HTTPRequestDeadline | None,
    ) -> None:
        """Reject a false source bound before encoder-owned key allocations."""
        ordered = self._ordered
        if ordered is None:
            raise CFError("remote object-set digest owner is unavailable")
        remaining = source_canonical_upper
        framing = 2 + max(0, len(ordered) - 1)
        if framing > remaining:
            raise CFError(
                "remote object-set canonical bytes exceed the source upper"
            )
        remaining -= framing
        for record in ordered:
            self._poll(deadline)
            record_bytes = canonical_json_size_up_to(
                record,
                remaining,
                None if deadline is None else lambda: self._poll(deadline),
            )
            if record_bytes > remaining:
                raise CFError(
                    "remote object-set canonical bytes exceed the source upper"
                )
            remaining -= record_bytes

    def _consume_hash_work(self, amount: int, *, record: bool = False) -> None:
        permit = self._work_permit
        if permit is None:
            raise CFError("remote object-set digest reservation is unavailable")
        self._ledger.consume_reserved(
            permit,
            phase="query",
            charges={
                "aggregate_bytes": amount,
                **({"object_records": 1} if record else {}),
            },
            counters={"object_records": 1} if record else {},
        )
        if not self._ledger.permit_is_open(permit):
            self._work_permit = None

    class _AccountedDigest:
        def __init__(self, owner: "AccountedRemoteObjectSetDigest") -> None:
            self._owner = owner
            self._digest = hashlib.sha256()

        def update(self, data: Any) -> None:
            self._owner._consume_hash_work(len(data))
            self._digest.update(data)

        def hexdigest(self) -> str:
            return self._digest.hexdigest()

    def _hash_ordered(
        self, deadline: HTTPRequestDeadline | None
    ) -> str:
        ordered = self._ordered
        if ordered is None:
            raise CFError("remote object-set digest owner is unavailable")
        digest = self._AccountedDigest(self)
        digest.update(b"[")
        for index, record in enumerate(ordered):
            self._poll(deadline)
            if index:
                digest.update(b",")
            self._consume_hash_work(0, record=True)
            _hash_canonical_json_polling(
                digest,
                record,
                lambda: self._poll(deadline),
            )
        digest.update(b"]")
        return "sha256:" + digest.hexdigest()

    def matches_digest(self, expected: str) -> bool:
        if self._closed or self._digest is None:
            raise CFError("remote object-set digest owner is closed")
        if not isinstance(expected, str):
            return False
        return hmac.compare_digest(self._digest, expected)

    def close(self) -> None:
        if self._closed:
            return
        if id(self._ledger) != self._ledger_identity:
            raise CFError(
                "remote object-set digest belongs to a different ledger"
            )
        self._digest = None
        if self._ordered is not None:
            self._ordered.clear()
            self._ordered = None
        permit = self._work_permit
        if permit is not None and self._ledger.permit_is_open(permit):
            self._ledger.cancel_permit(permit)
        self._work_permit = None
        self._release_owned_dimension("temporary_bytes", "_temporary_bytes")
        self._release_owned_dimension("retained_bytes", "_retained_bytes")
        self._closed = True

    def _release_owned_dimension(self, dimension: str, attribute: str) -> None:
        amount = getattr(self, attribute)
        if not amount:
            return
        before = self._ledger._current.get(dimension, 0)
        expected_after = before - amount
        failure: BaseException | None = None
        try:
            self._ledger.release(dimension, amount)
        except BaseException as error:
            failure = error
        after = self._ledger._current.get(dimension, 0)
        committed = after == expected_after
        if committed:
            setattr(self, attribute, 0)
        if failure is not None:
            if not committed:
                raise failure
            self._detach_failure_chain(failure)
        elif not committed:
            raise CFError(
                f"remote object-set digest {dimension} release did not commit"
            )

    def __del__(self) -> None:
        try:
            self.close()
        except BaseException:
            pass


def prepare_remote_object_set_digest(
    records: list[dict[str, Any]],
    ledger: DecisionWorkLedger,
    source_canonical_upper: int,
    deadline: HTTPRequestDeadline | None = None,
) -> AccountedRemoteObjectSetDigest:
    """Prepare a non-escaping digest owner from an already-owned source upper."""
    return AccountedRemoteObjectSetDigest(
        records, ledger, source_canonical_upper, deadline
    )


class AccountedHTTPUploadExistingPublicationInput:
    """Preaccount one bounded immutable existing-upload publication plan.

    This prerequisite deliberately has no payload getter or effect API.  The
    caller supplies a finite canonical byte upper before this owner or any
    canonical output is allocated.  ``prepare`` validates the legacy ordering
    contract, freezes every caller-controlled value as exact bytes, charges
    the bounded work, and reconciles the same retained scalar to exact size.
    """

    RESERVED = "RESERVED"
    PLAN_PREPARED = "PLAN_PREPARED"
    PREPARED = "PREPARED"
    IDENTITY_BINDING = "IDENTITY_BINDING"
    IDENTITY_BOUND = "IDENTITY_BOUND"
    CLOSED = "CLOSED"
    MAX_WRITES = 64
    MAX_POSTIMAGE_BYTES = 64 * 1024 * 1024
    MAX_RELATIVE_PATH_BYTES = 512
    MAX_JSON_DEPTH = 128
    FIXED_RETAINED_BYTES = 0
    TEMPORARY_BASE_BYTES = 0
    TEMPORARY_BYTES_PER_CANONICAL_BYTE = 4
    WORK_BYTES_PER_CANONICAL_BYTE = 8
    REQUEST_IDENTITY_BYTES_PER_PLAN_BYTE = 1
    REQUEST_IDENTITY_BYTES_PER_SEMANTIC_BYTE = 9
    REQUEST_IDENTITY_FIXED_WORK_BYTES = 512

    @classmethod
    def retained_upper(cls) -> int:
        shell = object.__new__(cls)
        entry_shell = (None,) * 7
        measured = (
            sys.getsizeof(shell)
            + sys.getsizeof(dict.fromkeys(range(32)))
            + sys.getsizeof((None,) * cls.MAX_WRITES)
            + cls.MAX_WRITES * sys.getsizeof(entry_shell)
            + sys.getsizeof((None,) * 8)
            + cls.MAX_WRITES
            * sys.getsizeof("\U00010000" * cls.MAX_RELATIVE_PATH_BYTES)
            + 2 * cls.MAX_WRITES * sys.getsizeof("0" * 64)
            + (3 * cls.MAX_WRITES + 5) * sys.getsizeof(b"")
            + sys.getsizeof("0" * 64)
        )
        page = 4096
        return max(page, ((measured + page - 1) // page) * page)

    @classmethod
    def temporary_base_upper(cls) -> int:
        frame = ("mapping", None, cls.MAX_JSON_DEPTH)
        iterator = max(
            sys.getsizeof(iter(())),
            sys.getsizeof(iter({}.items())),
        )
        measured = (
            4096
            + sys.getsizeof([None] * (cls.MAX_JSON_DEPTH + 2))
            + (cls.MAX_JSON_DEPTH + 2)
            * (sys.getsizeof(frame) + iterator)
        )
        page = 4096
        return ((measured + page - 1) // page) * page

    def __init__(
        self,
        ledger: DecisionWorkLedger,
        canonical_upper: int,
        transition: _StablePermitTransition,
        semantic_upper: int = 0,
        *,
        _factory_token: Any | None = None,
    ) -> None:
        if _factory_token is not _HTTP_UPLOAD_PUBLICATION_INPUT_FACTORY_TOKEN:
            raise CFError("use prepare_http_upload_existing_publication_input")
        if type(transition) is not _StablePermitTransition:
            raise CFError("HTTP upload publication input has no accounting owner")
        self._ledger = ledger
        self._ledger_identity = id(ledger)
        self._canonical_upper = canonical_upper
        self._semantic_upper = semantic_upper
        self._retained_upper = canonical_upper + self.FIXED_RETAINED_BYTES
        self._retained_exact: int | None = None
        self._transition: _StablePermitTransition | None = transition
        self._identity_parts: tuple[bytes, ...] | None = None
        self._write_plan: tuple[tuple[Any, ...], ...] | None = None
        self._result_bytes: bytes | None = None
        self._request_hash: str | None = None
        self._semantic_owner: Any | None = None
        self._semantic_token: Any | None = None
        self._state = self.RESERVED
        self._preparing = False
        self._closing = False
        self._closed = False

    def _ensure_ledger(self, ledger: DecisionWorkLedger) -> None:
        if ledger is not self._ledger or id(ledger) != self._ledger_identity:
            raise CFError("HTTP upload publication input belongs to another ledger")

    @staticmethod
    def _encoded(value: Any, upper: int) -> bytes:
        """Validate an exact JSON tree and bound it before materialization."""
        if upper < 0:
            raise CFError(
                "HTTP upload publication canonical input exceeds its upper"
            )
        stack: list[tuple[str, Any, int]] = [("value", value, 0)]
        visited = 0
        while stack:
            action, item, depth = stack.pop()
            if action == "sequence":
                try:
                    child = next(item)
                except StopIteration:
                    continue
                stack.append(("sequence", item, depth))
                stack.append(("value", child, depth + 1))
                continue
            if action == "mapping":
                try:
                    key, child = next(item)
                except StopIteration:
                    continue
                if type(key) is not str:
                    raise CFError(
                        "HTTP upload publication requires exact JSON values"
                    )
                stack.append(("mapping", item, depth))
                stack.append(("value", child, depth + 1))
                continue

            visited += 1
            if depth > AccountedHTTPUploadExistingPublicationInput.MAX_JSON_DEPTH:
                raise CFError(
                    "HTTP upload publication JSON depth exceeds its bounded limit"
                )
            if visited > upper + 1:
                raise CFError(
                    "HTTP upload publication canonical input exceeds its upper"
                )
            value_type = type(item)
            if value_type is dict:
                stack.append(("mapping", iter(item.items()), depth))
            elif value_type is list or value_type is tuple:
                stack.append(("sequence", iter(item), depth))
            elif value_type not in {type(None), bool, int, float, str}:
                raise CFError(
                    "HTTP upload publication requires exact JSON values"
                )

        try:
            size = canonical_json_size_up_to(value, upper)
        except (OverflowError, TypeError, ValueError) as exc:
            raise CFError(
                "HTTP upload publication requires canonical JSON values"
            ) from exc
        if size > upper:
            raise CFError(
                "HTTP upload publication canonical input exceeds its upper"
            )
        encoded = canonical_json(value)
        if type(encoded) is not bytes:
            raise CFError("HTTP upload publication canonicalizer changed")
        if len(encoded) != size:
            raise CFError("HTTP upload publication canonical size changed")
        return encoded

    def prepare(
        self,
        ledger: DecisionWorkLedger,
        project_root: Path,
        operation: str,
        actor: str,
        writes: list[tuple[dict[str, Any], Any, Any]],
        result: dict[str, Any],
        idempotency_key: str | None,
        object_roots: list[str],
    ) -> None:
        """Freeze one bounded plan without exposing it or reading preimages."""
        self._ensure_ledger(ledger)
        if self._closed or self._state != self.RESERVED:
            raise CFError("HTTP upload publication input prepare is single-use")
        if self._preparing:
            raise CFError("HTTP upload publication input prepare is already active")
        if (
            not isinstance(project_root, Path)
            or type(operation) is not str
            or type(actor) is not str
            or type(writes) is not list
            or type(result) is not dict
            or (idempotency_key is not None and type(idempotency_key) is not str)
            or type(object_roots) is not list
        ):
            raise CFError("HTTP upload publication input requires exact built-ins")
        if not writes or len(writes) > self.MAX_WRITES:
            raise CFError("remote publication write count must be 1..=64")
        if len(object_roots) > self.MAX_WRITES:
            raise CFError(
                "remote publication object roots are duplicated or exceed the bounded limit"
            )
        if any(type(root) is not str for root in object_roots):
            raise CFError("HTTP upload publication input requires exact built-ins")
        roots = tuple(object_roots)
        transition = self._transition
        if transition is None:
            raise CFError("HTTP upload publication input has no accounting owner")

        self._preparing = True
        failure: BaseException | None = None
        identity_parts: tuple[bytes, ...] | None = None
        frozen_plan: tuple[tuple[Any, ...], ...] | None = None
        result_bytes: bytes | None = None
        retained_exact = 0
        try:
            operation_bytes = self._encoded(operation, self._canonical_upper)
            actor_bytes = self._encoded(
                actor, self._canonical_upper - len(operation_bytes)
            )
            key_bytes = self._encoded(
                idempotency_key,
                self._canonical_upper
                - len(operation_bytes)
                - len(actor_bytes),
            )
            roots_bytes = self._encoded(
                list(roots),
                self._canonical_upper
                - len(operation_bytes)
                - len(actor_bytes)
                - len(key_bytes),
            )
            result_bytes = self._encoded(
                result,
                self._canonical_upper
                - len(operation_bytes)
                - len(actor_bytes)
                - len(key_bytes)
                - len(roots_bytes),
            )
            validate_remote_json_publication_subject(
                operation, actor, idempotency_key
            )
            if len(set(roots)) != len(roots):
                raise CFError(
                    "remote publication object roots are duplicated or exceed the bounded limit"
                )
            identity_parts = (
                operation_bytes,
                actor_bytes,
                key_bytes,
                roots_bytes,
            )
            retained_exact = sum(map(len, identity_parts)) + len(result_bytes)
            if retained_exact > self._canonical_upper:
                raise CFError(
                    "HTTP upload publication canonical input exceeds its upper"
                )

            seen_paths: set[str] = set()
            entries: list[tuple[Any, ...]] = []
            hashed_exact = 0
            for write in writes:
                if type(write) is not tuple or len(write) != 3:
                    raise CFError(
                        "HTTP upload publication writes require exact triples"
                    )
                authority, before, after = write
                if type(authority) is not dict:
                    raise CFError(
                        "HTTP upload publication authority requires an exact mapping"
                    )
                remaining = self._canonical_upper - retained_exact
                authority_bytes = self._encoded(authority, remaining)
                remaining -= len(authority_bytes)
                before_bytes = self._encoded(before, remaining)
                remaining -= len(before_bytes)
                after_bytes = self._encoded(after, remaining)
                kind = authority.get("kind")
                if kind == "branch" and set(authority) == {"kind", "name"}:
                    component = authority.get("name")
                    if type(component) is not str:
                        raise CFError(
                            "remote publication branch authority is invalid"
                        )
                    validate_remote_component(component, "branch")
                elif kind == "merge_request" and set(authority) == {"kind", "id"}:
                    component = authority.get("id")
                    if type(component) is not str:
                        raise CFError(
                            "remote publication merge-request authority is invalid"
                        )
                    validate_remote_component(component, "merge-request")
                elif not (
                    kind in {"generation", "request_nonce_cache"}
                    and set(authority) == {"kind"}
                ):
                    raise CFError(
                        f"unsupported remote publication authority: {kind}"
                    )
                relative_root = Path(".")
                path = remote_publication_authority_path(
                    relative_root, authority
                )
                relative_path = path.relative_to(relative_root).as_posix()
                if (
                    len(relative_path.encode("utf-8"))
                    > self.MAX_RELATIVE_PATH_BYTES
                ):
                    raise CFError(
                        "remote publication authority path exceeds the bounded limit"
                    )
                if relative_path in seen_paths:
                    raise CFError(
                        "remote publication contains duplicate authority writes"
                    )
                seen_paths.add(relative_path)
                if len(after_bytes) > self.MAX_POSTIMAGE_BYTES:
                    raise CFError(
                        "remote publication postimage exceeds the bounded record limit"
                    )
                retained_exact += (
                    len(authority_bytes) + len(before_bytes) + len(after_bytes)
                )
                if retained_exact > self._canonical_upper:
                    raise CFError(
                        "HTTP upload publication canonical input exceeds its upper"
                    )
                before_hash = (
                    None
                    if before is None
                    else hashlib.sha256(before_bytes).hexdigest()
                )
                hashed_exact += len(after_bytes)
                if before is not None:
                    hashed_exact += len(before_bytes)
                entries.append(
                    (
                        relative_path,
                        authority_bytes,
                        before_bytes,
                        after_bytes,
                        before is None,
                        before_hash,
                        hashlib.sha256(after_bytes).hexdigest(),
                    )
                )
            frozen_plan = tuple(entries)
            entries = None
            actual_work = self.WORK_BYTES_PER_CANONICAL_BYTE * retained_exact
            transition.consume(
                phase="publication_preflight",
                charges={"aggregate_bytes": actual_work},
                counters={"bytes_hashed": hashed_exact},
            )
            transition.shrink_retained_primary(
                retained_exact + self.FIXED_RETAINED_BYTES
            )
            self._identity_parts = identity_parts
            self._write_plan = frozen_plan
            self._result_bytes = result_bytes
            self._retained_exact = retained_exact + self.FIXED_RETAINED_BYTES
            if self._semantic_upper:
                self._state = self.PLAN_PREPARED
            else:
                transition.cancel()
                transition.release_temporary()
                self._state = self.PREPARED
        except BaseException as exc:
            _detach_exception_chain(exc)
            failure = exc
        finally:
            self._preparing = False
        if failure is not None:
            raise failure.with_traceback(None)

    def _bind_request_identity(
        self,
        semantic: "AccountedHTTPUploadSemantic",
        ledger: DecisionWorkLedger,
    ) -> Any:
        """Bind the exact prepared semantic and freeze the legacy request hash."""
        self._ensure_ledger(ledger)
        if self._state == self.IDENTITY_BINDING:
            transition = self._transition
            token = self._semantic_token
            if (
                semantic is not self._semantic_owner
                or semantic._publication_input is not self
                or semantic._publication_token is not token
                or type(self._request_hash) is not str
                or transition is None
                or transition._permit is not None
            ):
                raise CFError(
                    "HTTP upload publication request identity retry changed"
                )
            transition.release_temporary()
            self._state = self.IDENTITY_BOUND
            return token
        if (
            self._closed
            or self._state != self.PLAN_PREPARED
            or self._semantic_owner is not None
            or self._semantic_token is not None
            or self._request_hash is not None
        ):
            raise CFError("HTTP upload publication request identity is unavailable")
        if type(semantic) is not AccountedHTTPUploadSemantic:
            raise CFError("HTTP upload publication requires an exact semantic owner")
        semantic_mapping = object.__getattribute__(semantic, "__dict__")
        if type(semantic_mapping) is not dict or any(
            name not in semantic_mapping
            for name in (
                "_ledger",
                "_ledger_identity",
                "_source",
                "_allocation",
                "_record_refs",
                "_sorted_refs",
                "_copy_bytes",
                "_request_digest",
                "_semantic",
                "_semantic_view",
                "_digest_owner",
                "_prepared",
                "_preparing",
                "_terminal_started",
                "_terminal_active",
                "_terminal_complete",
                "_terminal_failed",
                "_closing",
                "_close_requested",
                "_closed",
                "_publication_input",
                "_publication_token",
            )
        ):
            raise CFError("HTTP upload publication semantic identity is incomplete")
        semantic._ensure_ledger(ledger)
        mapping = semantic._semantic
        view = semantic._semantic_view
        source = semantic._source
        allocation = semantic._allocation
        semantic_keys = (
            "stable_project_id",
            "remote_branch",
            "local_branch",
            "head",
            "object_set_digest",
        )
        if (
            not semantic._prepared
            or semantic._preparing
            or semantic._terminal_started
            or semantic._terminal_active
            or semantic._terminal_complete
            or semantic._terminal_failed
            or semantic._closing
            or semantic._close_requested
            or semantic._closed
            or type(mapping) is not dict
            or type(view) is not MappingProxyType
            or tuple(dict.keys(mapping)) != semantic_keys
            or any(
                type(dict.__getitem__(mapping, key)) is not str
                for key in semantic_keys
            )
            or view != mapping
            or type(source) is not AccountedHTTPUploadRequestSource
            or source._ledger is not ledger
            or source._destination is not semantic
            or source._adopted_semantic_identity is not semantic
            or type(allocation) is not _StablePermitTransition
            or allocation._ledger is not ledger
            or allocation._permit is not None
            or not allocation._retained_acquired
            or not allocation._temporary_acquired
            or allocation._retained_primary_released
            or allocation._temporary_released
            or type(semantic._record_refs) is not tuple
            or type(semantic._sorted_refs) is not tuple
            or type(semantic._copy_bytes) is not tuple
            or type(semantic._request_digest) is not str
            or semantic._digest_owner is not None
            or semantic._publication_input is not None
            or semantic._publication_token is not None
        ):
            raise CFError("HTTP upload publication semantic identity is unavailable")
        identity = self._identity_parts
        transition = self._transition
        if (
            type(identity) is not tuple
            or len(identity) != 4
            or any(type(value) is not bytes for value in identity)
            or transition is None
            or transition._permit is None
            or transition._temporary_released
        ):
            raise CFError("HTTP upload publication request accounting is unavailable")

        operation_bytes, actor_bytes, key_bytes, roots_bytes = identity
        token = object()
        failure: BaseException | None = None
        semantic_bytes: bytes | None = None
        request_hash: str | None = None
        try:
            semantic_bytes = self._encoded(mapping, self._semantic_upper)
            version_bytes = self._encoded(VERSION, 32)
            fragments = (
                b'{"actor":',
                actor_bytes,
                b',"idempotency_key":',
                key_bytes,
                b',"object_roots":',
                roots_bytes,
                b',"operation":',
                operation_bytes,
                b',"semantic":',
                semantic_bytes,
                b',"type":"codefire_remote_publication_request","version":',
                version_bytes,
                b'}',
            )
            hasher = hashlib.sha256()
            hashed = 0
            for fragment in fragments:
                hasher.update(fragment)
                hashed += len(fragment)
            request_hash = hasher.hexdigest()
            transition.consume(
                phase="publication_preflight",
                charges={
                    "aggregate_bytes":
                    8 * len(semantic_bytes) + hashed
                },
                counters={"bytes_hashed": hashed},
            )
            transition.cancel()
            self._request_hash = request_hash
            self._semantic_owner = semantic
            self._semantic_token = token
            semantic._publication_input = self
            semantic._publication_token = token
            self._state = self.IDENTITY_BINDING
            transition.release_temporary()
            self._state = self.IDENTITY_BOUND
        except BaseException as exc:
            _detach_exception_chain(exc)
            failure = exc
        semantic_bytes = None
        request_hash = None
        if failure is not None:
            if self._state == self.IDENTITY_BINDING:
                raise failure.with_traceback(None)
            if semantic._publication_input is self:
                semantic._publication_input = None
            if semantic._publication_token is token:
                semantic._publication_token = None
            if self._semantic_owner is semantic:
                self._semantic_owner = None
            if self._semantic_token is token:
                self._semantic_token = None
            self._request_hash = None
            raise failure.with_traceback(None)
        return token

    def _baseline_values(
        self,
        ledger: DecisionWorkLedger,
        semantic: Any | None = None,
        token: Any | None = None,
    ) -> tuple[_StablePermitTransition, int, int]:
        self._ensure_ledger(ledger)
        transition = self._transition
        retained_exact = self._retained_exact
        if (
            self._state not in {self.PREPARED, self.IDENTITY_BOUND}
            or transition is None
            or retained_exact is None
            or transition._permit is not None
            or not transition._retained_acquired
            or not transition._temporary_released
            or transition._retained_primary_released
            or transition._retained_primary != retained_exact
            or (
                self._state == self.IDENTITY_BOUND
                and (
                    semantic is not self._semantic_owner
                    or token is not self._semantic_token
                    or type(self._request_hash) is not str
                    or len(self._request_hash) != 64
                )
            )
        ):
            raise CFError("HTTP upload publication input baseline is unavailable")
        return transition, retained_exact, self._retained_upper

    def _capture_terminal_probe(self, semantic: Any, token: Any) -> Any:
        """Capture one callback-free exact-state fence for the frozen plan."""
        if (
            self._state != self.IDENTITY_BOUND
            or self._semantic_owner is not semantic
            or self._semantic_token is not token
        ):
            raise CFError("HTTP upload publication terminal probe is unavailable")
        owner_type = AccountedHTTPUploadExistingPublicationInput
        class_mapping = type.__getattribute__(owner_type, "__dict__")
        mapping_items = type(class_mapping).items
        expected_class = tuple(mapping_items(class_mapping))
        owner_mapping = object.__getattribute__(self, "__dict__")
        expected_keys = tuple(dict.keys(owner_mapping))
        transition = self._transition
        retained_exact = self._retained_exact
        pins = (
            self._identity_parts,
            self._write_plan,
            self._result_bytes,
            self._request_hash,
        )
        used = [False]
        identity_bound_state = self.IDENTITY_BOUND
        error_type = CFError

        def exact_class() -> bool:
            if len(class_mapping) != len(expected_class):
                return False
            index = 0
            for key, value in mapping_items(class_mapping):
                expected_key, expected_value = expected_class[index]
                if key is not expected_key or value is not expected_value:
                    return False
                index += 1
            return True

        def exact_keys(mapping: dict[str, Any]) -> bool:
            if len(mapping) != len(expected_keys):
                return False
            index = 0
            for key in dict.keys(mapping):
                if key is not expected_keys[index]:
                    return False
                index += 1
            return True

        def intact() -> bool:
            return (
                type(self) is owner_type
                and exact_class()
                and object.__getattribute__(self, "__dict__") is owner_mapping
            )

        def probe() -> None:
            if list.__getitem__(used, 0):
                raise error_type(
                    "HTTP upload publication terminal probe is single-use"
                )
            list.__setitem__(used, 0, True)
            actual_mapping = object.__getattribute__(self, "__dict__")
            if (
                not intact()
                or not exact_keys(actual_mapping)
                or dict.__getitem__(actual_mapping, "_ledger") is not self._ledger
                or dict.__getitem__(actual_mapping, "_ledger_identity")
                != self._ledger_identity
                or dict.__getitem__(actual_mapping, "_semantic_owner") is not semantic
                or dict.__getitem__(actual_mapping, "_semantic_token") is not token
                or dict.__getitem__(actual_mapping, "_transition") is not transition
                or dict.__getitem__(actual_mapping, "_retained_exact")
                != retained_exact
                or dict.__getitem__(actual_mapping, "_state")
                != identity_bound_state
                or dict.__getitem__(actual_mapping, "_closed") is not False
                or dict.__getitem__(actual_mapping, "_identity_parts")
                is not tuple.__getitem__(pins, 0)
                or dict.__getitem__(actual_mapping, "_write_plan")
                is not tuple.__getitem__(pins, 1)
                or dict.__getitem__(actual_mapping, "_result_bytes")
                is not tuple.__getitem__(pins, 2)
                or dict.__getitem__(actual_mapping, "_request_hash")
                is not tuple.__getitem__(pins, 3)
                or transition is None
                or transition._permit is not None
                or transition._retained_primary != retained_exact
                or transition._retained_primary_released
                or not transition._temporary_released
            ):
                raise error_type(
                    "HTTP upload publication input changed before terminal"
                )

        return probe, intact

    def close(
        self,
        ledger: DecisionWorkLedger,
        *,
        _semantic_owner: Any | None = None,
        _semantic_token: Any | None = None,
    ) -> None:
        self._ensure_ledger(ledger)
        if self._closed:
            return
        if self._preparing:
            raise CFError("HTTP upload publication input prepare is active")
        semantic = self._semantic_owner
        token = self._semantic_token
        if semantic is not None and (
            semantic is not _semantic_owner or token is not _semantic_token
        ):
            raise CFError("HTTP upload semantic adopted publication input")
        if self._closing:
            return
        self._closing = True
        completed = False
        try:
            self._identity_parts = None
            self._write_plan = None
            self._result_bytes = None
            self._request_hash = None
            transition = self._transition
            if transition is not None:
                transition.release_all()
                self._transition = None
            if semantic is not None:
                if semantic._publication_input is self:
                    semantic._publication_input = None
                if semantic._publication_token is token:
                    semantic._publication_token = None
            self._semantic_owner = None
            self._semantic_token = None
            self._canonical_upper = 0
            self._semantic_upper = 0
            self._retained_upper = 0
            self._retained_exact = None
            self._state = self.CLOSED
            completed = True
        finally:
            self._closing = False
            if completed:
                self._closed = True

    def __del__(self) -> None:
        try:
            if self._semantic_owner is None:
                self.close(self._ledger)
        except BaseException:
            pass


_HTTP_UPLOAD_PUBLICATION_INPUT_FACTORY_TOKEN = object()
AccountedHTTPUploadExistingPublicationInput.FIXED_RETAINED_BYTES = (
    AccountedHTTPUploadExistingPublicationInput.retained_upper()
)
AccountedHTTPUploadExistingPublicationInput.TEMPORARY_BASE_BYTES = (
    AccountedHTTPUploadExistingPublicationInput.temporary_base_upper()
)


def prepare_http_upload_existing_publication_input(
    ledger: DecisionWorkLedger,
    *,
    canonical_upper: int,
    semantic_upper: int = 0,
) -> AccountedHTTPUploadExistingPublicationInput:
    """Acquire finite plan/control/work uppers before publication allocation."""
    bootstrap = ledger.__dict__.get("_upload_publication_input_bootstrap")
    if bootstrap is not None:
        if (
            type(bootstrap) is not _StablePermitTransition
            or bootstrap._ledger is not ledger
        ):
            raise CFError(
                "HTTP upload publication factory bootstrap ownership changed"
            )
        bootstrap.release_all()
        ledger.__dict__.pop("_upload_publication_input_bootstrap", None)
    for value, label in (
        (canonical_upper, "canonical upper"),
        (semantic_upper, "semantic upper"),
    ):
        if isinstance(value, bool) or not isinstance(value, int) or value < 0:
            raise CFError(f"HTTP upload publication {label} is invalid")
    fixed = AccountedHTTPUploadExistingPublicationInput.FIXED_RETAINED_BYTES
    retained_upper = canonical_upper + fixed
    total_upper = canonical_upper + semantic_upper
    multiplier = (
        AccountedHTTPUploadExistingPublicationInput
        .TEMPORARY_BYTES_PER_CANONICAL_BYTE
    )
    work_multiplier = (
        AccountedHTTPUploadExistingPublicationInput
        .WORK_BYTES_PER_CANONICAL_BYTE
    )
    if (
        retained_upper > U64_MAX
        or total_upper > U64_MAX
        or total_upper
        > (U64_MAX - AccountedHTTPUploadExistingPublicationInput.TEMPORARY_BASE_BYTES)
        // multiplier
        or total_upper > U64_MAX // work_multiplier
    ):
        raise CFError("HTTP upload publication upper exceeds u64")
    temporary_upper = (
        AccountedHTTPUploadExistingPublicationInput.TEMPORARY_BASE_BYTES
        + multiplier * total_upper
    )
    work_upper = work_multiplier * canonical_upper
    if semantic_upper:
        work_upper += (
            AccountedHTTPUploadExistingPublicationInput
            .REQUEST_IDENTITY_BYTES_PER_PLAN_BYTE
            * canonical_upper
            + AccountedHTTPUploadExistingPublicationInput
            .REQUEST_IDENTITY_BYTES_PER_SEMANTIC_BYTE
            * semantic_upper
            + AccountedHTTPUploadExistingPublicationInput
            .REQUEST_IDENTITY_FIXED_WORK_BYTES
        )
    if work_upper > U64_MAX:
        raise CFError("HTTP upload publication upper exceeds u64")
    transition = _StablePermitTransition(
        ledger,
        retained_primary=retained_upper,
        temporary=temporary_upper,
    )
    ledger.__dict__["_upload_publication_input_bootstrap"] = transition
    owner: AccountedHTTPUploadExistingPublicationInput | None = None
    try:
        transition.reserve(
            "publication_preflight",
            charges={"aggregate_bytes": work_upper},
            acquires={
                "retained_bytes": retained_upper,
                "temporary_bytes": temporary_upper,
            },
            counters={"bytes_hashed": work_upper},
        )
        transition.consume(
            phase="publication_preflight",
            acquires={
                "retained_bytes": retained_upper,
                "temporary_bytes": temporary_upper,
            },
        )
        owner = AccountedHTTPUploadExistingPublicationInput(
            ledger,
            canonical_upper,
            transition,
            semantic_upper,
            _factory_token=_HTTP_UPLOAD_PUBLICATION_INPUT_FACTORY_TOKEN,
        )
        ledger.__dict__.pop("_upload_publication_input_bootstrap", None)
        return owner
    except BaseException as failure:
        cleanup_failure: BaseException | None = None
        if owner is not None:
            try:
                owner.close(ledger)
            except BaseException as error:
                cleanup_failure = error
        else:
            try:
                transition.release_all()
            except BaseException as error:
                cleanup_failure = error
        if cleanup_failure is None:
            ledger.__dict__.pop("_upload_publication_input_bootstrap", None)
            raise
        _detach_exception_chain(failure)
        _detach_exception_chain(cleanup_failure)
        raise cleanup_failure.with_traceback(None)


class AccountedHTTPUploadResponseInput:
    """Preparse-accounted immutable success/durable response input.

    The factory acquires the complete payload/control upper before this owner
    exists. ``prepare`` then stores caller-built immutable bytes inside that
    already-owned upper, charges the exact response work, and shrinks the same
    scalar. No response bytes or selection API escape this prerequisite.
    """

    RESERVED = "RESERVED"
    PREPARED = "PREPARED"
    ADOPTED = "ADOPTED"
    EFFECT_ADOPTED = "EFFECT_ADOPTED"
    SELECTING = "SELECTING"
    SELECTED = "SELECTED"
    CLOSED = "CLOSED"
    FIXED_RETAINED_BYTES = 0

    @classmethod
    def retained_upper(cls) -> int:
        shell = object.__new__(cls)
        measured = (
            sys.getsizeof(shell)
            + sys.getsizeof(dict.fromkeys(range(32)))
            + sys.getsizeof((None,) * 32)
            + sys.getsizeof(object.__new__(_PreparedHTTPResponseOwner))
            + sys.getsizeof(dict.fromkeys(range(8)))
            + sys.getsizeof(object())
        )
        page = 4096
        return max(page, ((measured + page - 1) // page) * page)

    def __init__(
        self,
        ledger: DecisionWorkLedger,
        body_upper: int,
        header_upper: int,
        transition: _StablePermitTransition,
        *,
        _factory_token: Any | None = None,
    ) -> None:
        if _factory_token is not _HTTP_UPLOAD_RESPONSE_INPUT_FACTORY_TOKEN:
            raise CFError("use prepare_http_upload_response_input")
        if type(transition) is not _StablePermitTransition:
            raise CFError("HTTP upload response input has no accounting owner")
        self._ledger = ledger
        self._ledger_identity = id(ledger)
        self._body_upper = body_upper
        self._header_upper = header_upper
        self._retained_upper = (
            2 * body_upper + 2 * header_upper + self.FIXED_RETAINED_BYTES
        )
        self._retained_exact: int | None = None
        self._transition: _StablePermitTransition | None = transition
        self._success_status: int | None = None
        self._success_header: bytes | None = None
        self._success_body: bytes | None = None
        self._durable_header: bytes | None = None
        self._durable_body: bytes | None = None
        self._semantic_owner: Any | None = None
        self._semantic_token: Any | None = None
        self._effect_input_owner: Any | None = None
        self._effect_input_token: Any | None = None
        self._selection: bool | None = None
        self._selected_status: int | None = None
        self._prepared_response: _PreparedHTTPResponseOwner | None = (
            _PreparedHTTPResponseOwner(ledger, b"", 0, b"", 0)
        )
        self._state = self.RESERVED
        self._preparing = False
        self._closing = False
        self._closed = False

    def _ensure_ledger(self, ledger: DecisionWorkLedger) -> None:
        if ledger is not self._ledger or id(ledger) != self._ledger_identity:
            raise CFError("HTTP upload response input belongs to another ledger")

    def prepare(
        self,
        ledger: DecisionWorkLedger,
        success_status: int,
        success_header: bytes,
        success_body: bytes,
        durable_header: bytes,
        durable_body: bytes,
    ) -> None:
        """Reconcile the preparse upper to one exact immutable response pair."""
        self._ensure_ledger(ledger)
        if self._closed or self._state != self.RESERVED:
            raise CFError("HTTP upload response input prepare is single-use")
        if self._preparing:
            raise CFError("HTTP upload response input prepare is already active")
        if (
            isinstance(success_status, bool)
            or not isinstance(success_status, int)
            or success_status < 100
            or success_status > 599
            or type(success_header) is not bytes
            or type(success_body) is not bytes
            or type(durable_header) is not bytes
            or type(durable_body) is not bytes
        ):
            raise CFError("HTTP upload response input requires exact response bytes")
        body_actual = max(len(success_body), len(durable_body))
        header_actual = max(len(success_header), len(durable_header))
        retained_payload = (
            len(success_header)
            + len(success_body)
            + len(durable_header)
            + len(durable_body)
        )
        if body_actual > self._body_upper or header_actual > self._header_upper:
            raise CFError("HTTP upload response input exceeds its preparse upper")
        retained_exact = retained_payload + self.FIXED_RETAINED_BYTES
        if retained_exact > self._retained_upper:
            raise CFError("HTTP upload response input retained upper is insufficient")
        transition = self._transition
        if transition is None:
            raise CFError("HTTP upload response input has no accounting owner")
        self._preparing = True
        failure: BaseException | None = None
        try:
            transition.consume(
                phase="response_body",
                charges={
                    "response_bytes": body_actual,
                    "response_header_bytes": header_actual,
                },
            )
            transition.cancel()
            transition.shrink_retained_primary(retained_exact)
            self._success_status = success_status
            self._success_header = success_header
            self._success_body = success_body
            self._durable_header = durable_header
            self._durable_body = durable_body
            self._retained_exact = retained_exact
            self._state = self.PREPARED
        except BaseException as exc:
            _detach_exception_chain(exc)
            failure = exc
        finally:
            self._preparing = False
        if failure is not None:
            raise failure.with_traceback(None)

    def _baseline_values(
        self, ledger: DecisionWorkLedger
    ) -> tuple[_StablePermitTransition, int, int]:
        self._ensure_ledger(ledger)
        transition = self._transition
        retained_exact = self._retained_exact
        if (
            self._state not in {self.PREPARED, self.ADOPTED}
            or transition is None
            or retained_exact is None
            or transition._permit is not None
            or not transition._retained_acquired
            or transition._retained_primary_released
            or transition._retained_primary != retained_exact
            or transition._retained_secondary != 0
            or transition._temporary != 0
        ):
            raise CFError("HTTP upload response input baseline is unavailable")
        return transition, retained_exact, self._retained_upper

    def _adopt_semantic(
        self,
        semantic: Any,
        scalar: "AccountedHTTPUploadParserScalar",
        ledger: DecisionWorkLedger,
    ) -> Any:
        self._ensure_ledger(ledger)
        if self._state != self.PREPARED or self._semantic_owner is not None:
            raise CFError("HTTP upload response input is unavailable for semantic")
        token = object()
        scalar._adopt_response_predecessor(self, token, ledger)
        self._semantic_owner = semantic
        self._semantic_token = token
        self._state = self.ADOPTED
        return token

    def _close_from_semantic(
        self, semantic: Any, token: Any, ledger: DecisionWorkLedger
    ) -> None:
        self._ensure_ledger(ledger)
        if self._semantic_owner is not semantic or self._semantic_token is not token:
            raise CFError("HTTP upload response input has a foreign semantic")
        self._semantic_owner = None
        self._semantic_token = None
        if self._effect_input_owner is not None:
            self._state = (
                self.SELECTED
                if self._state == self.SELECTED
                else self.SELECTING
                if self._state == self.SELECTING
                else self.EFFECT_ADOPTED
            )
            return
        self._state = self.PREPARED
        try:
            AccountedHTTPUploadResponseInput.close(self, ledger)
        except BaseException:
            if not self._closed:
                self._semantic_owner = semantic
                self._semantic_token = token
                self._state = self.ADOPTED
            raise

    def _adopt_effect_input(
        self,
        owner: Any,
        token: Any,
        semantic: Any,
        semantic_token: Any,
        ledger: DecisionWorkLedger,
    ) -> None:
        """Mirror the terminal token without releasing semantic ownership."""
        self._ensure_ledger(ledger)
        if type(self) is not AccountedHTTPUploadResponseInput:
            raise CFError("HTTP upload response input type changed")
        if (
            self._state != self.ADOPTED
            or self._semantic_owner is not semantic
            or self._semantic_token is not semantic_token
            or self._effect_input_owner is not None
            or self._effect_input_token is not None
            or owner is None
            or token is None
        ):
            raise CFError("HTTP upload response input cannot adopt effect input")
        self._effect_input_owner = owner
        self._effect_input_token = token
        self._state = self.EFFECT_ADOPTED

    def _select_from_effect_input(
        self,
        owner: Any,
        token: Any,
        ledger: DecisionWorkLedger,
        durable: bool,
    ) -> int:
        """Discard one response and retain exactly one immutable pair."""
        self._ensure_ledger(ledger)
        if type(self) is not AccountedHTTPUploadResponseInput:
            raise CFError("HTTP upload response input type changed")
        if type(durable) is not bool:
            raise CFError("HTTP upload response selection requires a boolean")
        if (
            self._state not in {self.EFFECT_ADOPTED, self.SELECTING}
            or self._effect_input_owner is not owner
            or self._effect_input_token is not token
        ):
            raise CFError("HTTP upload response selection is unavailable")
        if self._selection is not None:
            if self._selection is not durable:
                raise CFError("HTTP upload response selection is single-use")
            selected_status = self._selected_status
            selected_header = self._success_header
            selected_body = self._success_body
        else:
            if durable:
                selected_status = 503
                selected_header = self._durable_header
                selected_body = self._durable_body
            else:
                selected_status = self._success_status
                selected_header = self._success_header
                selected_body = self._success_body
        if (
            type(selected_status) is not int
            or type(selected_header) is not bytes
            or type(selected_body) is not bytes
        ):
            raise CFError("HTTP upload selected response is incomplete")
        transition = self._transition
        if transition is None:
            raise CFError("HTTP upload selected response has no accounting owner")
        selected_retained = len(selected_header) + len(selected_body)
        if self._selection is None:
            self._success_header = selected_header
            self._success_body = selected_body
            self._durable_header = None
            self._durable_body = None
            self._selection = durable
            self._selected_status = selected_status
            self._state = self.SELECTING
        transition.shrink_retained_primary(
            selected_retained + self.FIXED_RETAINED_BYTES
        )
        if (
            type(self) is not AccountedHTTPUploadResponseInput
            or self._effect_input_owner is not owner
            or self._effect_input_token is not token
            or self._selection is not durable
            or self._selected_status != selected_status
            or self._success_header is not selected_header
            or self._success_body is not selected_body
            or self._durable_header is not None
            or self._durable_body is not None
            or self._transition is not transition
            or self._state != self.SELECTING
        ):
            raise CFError("HTTP upload response changed during selection")
        self._retained_exact = selected_retained + self.FIXED_RETAINED_BYTES
        self._state = self.SELECTED
        return selected_status

    def _take_selected_from_effect_input(
        self, owner: Any, token: Any, ledger: DecisionWorkLedger
    ) -> tuple[int, _PreparedHTTPResponseOwner]:
        """Transfer selected bytes after semantic/carrier cleanup completed."""
        self._ensure_ledger(ledger)
        if type(self) is not AccountedHTTPUploadResponseInput:
            raise CFError("HTTP upload response input type changed")
        if (
            self._state != self.SELECTED
            or self._effect_input_owner is not owner
            or self._effect_input_token is not token
            or self._semantic_owner is not None
            or self._semantic_token is not None
        ):
            raise CFError("HTTP upload selected response transfer is unavailable")
        header = self._success_header
        body = self._success_body
        status = self._selected_status
        prepared = self._prepared_response
        transition = self._transition
        prepared_mapping = (
            object.__getattribute__(prepared, "__dict__")
            if type(prepared) is _PreparedHTTPResponseOwner
            else None
        )
        selected_retained = (
            len(header) + len(body)
            if type(header) is bytes and type(body) is bytes
            else -1
        )
        if (
            type(status) is not int
            or type(header) is not bytes
            or type(body) is not bytes
            or type(prepared) is not _PreparedHTTPResponseOwner
            or prepared_mapping is None
            or dict.__getitem__(prepared_mapping, "ledger") is not ledger
            or dict.__getitem__(prepared_mapping, "header_retained") != 0
            or dict.__getitem__(prepared_mapping, "body_retained") != 0
            or transition is None
            or self._retained_exact
            != selected_retained + self.FIXED_RETAINED_BYTES
        ):
            raise CFError("HTTP upload selected response transfer is incomplete")
        transition.shrink_retained_primary(selected_retained)
        if (
            type(self) is not AccountedHTTPUploadResponseInput
            or self._effect_input_owner is not owner
            or self._effect_input_token is not token
            or self._semantic_owner is not None
            or self._semantic_token is not None
            or self._success_header is not header
            or self._success_body is not body
            or self._selected_status != status
            or self._prepared_response is not prepared
            or object.__getattribute__(prepared, "__dict__") is not prepared_mapping
            or dict.__getitem__(prepared_mapping, "header_retained") != 0
            or dict.__getitem__(prepared_mapping, "body_retained") != 0
            or self._transition is not transition
            or self._state != self.SELECTED
        ):
            raise CFError("HTTP upload response changed during transfer")
        dict.__setitem__(prepared_mapping, "header", header)
        dict.__setitem__(prepared_mapping, "body", body)
        dict.__setitem__(prepared_mapping, "header_retained", len(header))
        dict.__setitem__(prepared_mapping, "body_retained", len(body))
        if selected_retained:
            transition.handoff_retained_primary(selected_retained)
        elif not transition._retained_primary_released:
            raise CFError("HTTP upload empty response handoff is incomplete")
        self._success_header = None
        self._success_body = None
        self._prepared_response = None
        self._transition = None
        self._retained_exact = None
        self._effect_input_owner = None
        self._effect_input_token = None
        self._selection = None
        self._selected_status = None
        self._success_status = None
        self._body_upper = 0
        self._header_upper = 0
        self._retained_upper = 0
        self._state = self.CLOSED
        self._closed = True
        return status, prepared

    def _close_from_effect_input(
        self, owner: Any, token: Any, ledger: DecisionWorkLedger
    ) -> None:
        self._ensure_ledger(ledger)
        if (
            self._effect_input_owner is not owner
            or self._effect_input_token is not token
            or self._semantic_owner is not None
        ):
            raise CFError("HTTP upload response input has a foreign effect input")
        self._effect_input_owner = None
        self._effect_input_token = None
        self._selection = None
        self._selected_status = None
        self._state = self.PREPARED
        try:
            AccountedHTTPUploadResponseInput.close(self, ledger)
        except BaseException:
            if not self._closed:
                self._effect_input_owner = owner
                self._effect_input_token = token
            raise

    def _capture_terminal_probe(self, semantic: Any, token: Any) -> Any:
        if (
            self._state != self.ADOPTED
            or self._semantic_owner is not semantic
            or self._semantic_token is not token
        ):
            raise CFError("HTTP upload response terminal probe is unavailable")
        owner_type = AccountedHTTPUploadResponseInput
        class_mapping = type.__getattribute__(owner_type, "__dict__")
        mapping_items = type(class_mapping).items
        expected_class = tuple(mapping_items(class_mapping))
        owner_mapping = object.__getattribute__(self, "__dict__")
        expected_keys = tuple(dict.keys(owner_mapping))
        prepared = self._prepared_response
        if type(prepared) is not _PreparedHTTPResponseOwner:
            raise CFError("HTTP upload prepared response shell is unavailable")
        prepared_mapping = object.__getattribute__(prepared, "__dict__")
        prepared_keys = tuple(dict.keys(prepared_mapping))
        prepared_class_mapping = type.__getattribute__(
            _PreparedHTTPResponseOwner, "__dict__"
        )
        expected_prepared_class = tuple(mapping_items(prepared_class_mapping))
        transition = self._transition
        retained_exact = self._retained_exact
        pins = (
            self._success_status,
            self._success_header,
            self._success_body,
            self._durable_header,
            self._durable_body,
            self._prepared_response,
        )
        used = [False]
        adopted_state = self.ADOPTED
        error_type = CFError

        def exact_mapping(mapping: Any, expected: tuple[Any, ...]) -> bool:
            if len(mapping) != len(expected):
                return False
            index = 0
            for key, value in mapping_items(mapping):
                expected_key, expected_value = expected[index]
                if key is not expected_key or value is not expected_value:
                    return False
                index += 1
            return True

        def exact_class() -> bool:
            return exact_mapping(class_mapping, expected_class)

        def exact_keys(mapping: dict[str, Any]) -> bool:
            if len(mapping) != len(expected_keys):
                return False
            index = 0
            for key in dict.keys(mapping):
                if key is not expected_keys[index]:
                    return False
                index += 1
            return True

        def intact() -> bool:
            return exact_class() and prepared_intact()

        def prepared_intact() -> bool:
            if (
                type(prepared) is not _PreparedHTTPResponseOwner
                or not exact_mapping(
                    prepared_class_mapping, expected_prepared_class
                )
                or object.__getattribute__(prepared, "__dict__")
                is not prepared_mapping
                or len(prepared_mapping) != len(prepared_keys)
            ):
                return False
            index = 0
            for key in dict.keys(prepared_mapping):
                if key is not prepared_keys[index]:
                    return False
                index += 1
            return (
                dict.__getitem__(prepared_mapping, "ledger") is self._ledger
                and type(dict.__getitem__(prepared_mapping, "header")) is bytes
                and len(dict.__getitem__(prepared_mapping, "header")) == 0
                and type(dict.__getitem__(prepared_mapping, "body")) is bytes
                and len(dict.__getitem__(prepared_mapping, "body")) == 0
                and dict.__getitem__(prepared_mapping, "header_retained") == 0
                and dict.__getitem__(prepared_mapping, "body_retained") == 0
            )

        def probe() -> None:
            if list.__getitem__(used, 0):
                raise error_type("HTTP upload response terminal probe is single-use")
            list.__setitem__(used, 0, True)
            actual_mapping = object.__getattribute__(self, "__dict__")
            if (
                type(self) is not owner_type
                or not exact_class()
                or actual_mapping is not owner_mapping
                or not exact_keys(actual_mapping)
                or dict.__getitem__(actual_mapping, "_semantic_owner") is not semantic
                or dict.__getitem__(actual_mapping, "_semantic_token") is not token
                or dict.__getitem__(actual_mapping, "_transition") is not transition
                or dict.__getitem__(actual_mapping, "_retained_exact") != retained_exact
                or dict.__getitem__(actual_mapping, "_state") != adopted_state
                or dict.__getitem__(actual_mapping, "_closed") is not False
                or dict.__getitem__(actual_mapping, "_success_status")
                != tuple.__getitem__(pins, 0)
                or dict.__getitem__(actual_mapping, "_success_header")
                is not tuple.__getitem__(pins, 1)
                or dict.__getitem__(actual_mapping, "_success_body")
                is not tuple.__getitem__(pins, 2)
                or dict.__getitem__(actual_mapping, "_durable_header")
                is not tuple.__getitem__(pins, 3)
                or dict.__getitem__(actual_mapping, "_durable_body")
                is not tuple.__getitem__(pins, 4)
                or dict.__getitem__(actual_mapping, "_prepared_response")
                is not tuple.__getitem__(pins, 5)
                or not prepared_intact()
                or dict.__getitem__(actual_mapping, "_effect_input_owner") is not None
                or dict.__getitem__(actual_mapping, "_effect_input_token") is not None
                or dict.__getitem__(actual_mapping, "_selection") is not None
                or transition is None
                or transition._permit is not None
                or transition._retained_primary != retained_exact
                or transition._retained_primary_released
            ):
                raise error_type("HTTP upload response input changed before terminal")

        return probe, intact

    def close(self, ledger: DecisionWorkLedger) -> None:
        self._ensure_ledger(ledger)
        if self._closed:
            return
        if self._effect_input_owner is not None:
            raise CFError("HTTP upload effect input adopted response input")
        if self._semantic_owner is not None:
            raise CFError("HTTP upload semantic adopted response input")
        if self._preparing:
            raise CFError("HTTP upload response input prepare is active")
        if self._closing:
            return
        self._closing = True
        completed = False
        try:
            self._success_header = None
            self._success_body = None
            self._durable_header = None
            self._durable_body = None
            prepared = self._prepared_response
            if prepared is not None:
                prepared.close()
                self._prepared_response = None
            transition = self._transition
            if transition is not None:
                transition.release_all()
                self._transition = None
            self._retained_exact = None
            self._success_status = None
            self._selection = None
            self._selected_status = None
            self._body_upper = 0
            self._header_upper = 0
            self._retained_upper = 0
            self._state = self.CLOSED
            completed = True
        finally:
            self._closing = False
            if completed:
                self._closed = True

    def __del__(self) -> None:
        try:
            self.close(self._ledger)
        except BaseException:
            pass


_HTTP_UPLOAD_RESPONSE_INPUT_FACTORY_TOKEN = object()
AccountedHTTPUploadResponseInput.FIXED_RETAINED_BYTES = (
    AccountedHTTPUploadResponseInput.retained_upper()
)


def prepare_http_upload_response_input(
    ledger: DecisionWorkLedger,
    *,
    body_upper: int,
    header_upper: int,
) -> AccountedHTTPUploadResponseInput:
    """Acquire response payload/control before parser or response allocation."""
    for value, label in (
        (body_upper, "body upper"),
        (header_upper, "header upper"),
    ):
        if isinstance(value, bool) or not isinstance(value, int) or value < 0:
            raise CFError(f"HTTP upload response input {label} is invalid")
    payload_upper = 2 * body_upper + 2 * header_upper
    retained_upper = (
        payload_upper + AccountedHTTPUploadResponseInput.FIXED_RETAINED_BYTES
    )
    if payload_upper > U64_MAX or retained_upper > U64_MAX:
        raise CFError("HTTP upload response input upper exceeds u64")
    transition = _StablePermitTransition(
        ledger, retained_primary=retained_upper
    )
    owner: AccountedHTTPUploadResponseInput | None = None
    try:
        transition.reserve(
            "response_body",
            charges={
                "response_bytes": body_upper,
                "response_header_bytes": header_upper,
            },
            acquires={"retained_bytes": retained_upper},
        )
        transition.consume(
            phase="response_body",
            acquires={"retained_bytes": retained_upper},
        )
        owner = AccountedHTTPUploadResponseInput(
            ledger,
            body_upper,
            header_upper,
            transition,
            _factory_token=_HTTP_UPLOAD_RESPONSE_INPUT_FACTORY_TOKEN,
        )
        return owner
    except BaseException:
        if owner is not None:
            try:
                owner.close(ledger)
            except BaseException:
                pass
        else:
            try:
                transition.release_all()
            except BaseException:
                pass
        raise


class AccountedHTTPUploadParserScalar:
    """Own one parser Retained upper and reconcile it to the exact AST."""

    def __init__(
        self, ledger: DecisionWorkLedger, parser_canonical_upper: int
    ) -> None:
        if (
            isinstance(parser_canonical_upper, bool)
            or not isinstance(parser_canonical_upper, int)
            or parser_canonical_upper < 0
        ):
            raise CFError(
                "HTTP upload parser upper must be a non-negative integer"
            )
        self._ledger = ledger
        self._ledger_identity = id(ledger)
        self._parser_canonical_upper = parser_canonical_upper
        self._parser_canonical_bytes: int | None = None
        self._allocation = _StablePermitTransition(ledger)
        self._source: AccountedHTTPUploadRequestSource | None = None
        self._response_input: AccountedHTTPUploadResponseInput | None = None
        self._response_token: Any | None = None
        self._acquiring = False
        self._reconciling = False
        self._acquired = False
        self._acquire_used = False
        self._reconcile_target: int | None = None
        self._reconciled = False
        self._closing = False
        self._close_requested = False
        self._closed = False

    def _ensure_ledger(self, ledger: DecisionWorkLedger) -> None:
        if (
            id(ledger) != self._ledger_identity
            or id(self._ledger) != self._ledger_identity
        ):
            raise CFError("HTTP upload parser scalar belongs to a different ledger")

    def acquire(self, ledger: DecisionWorkLedger) -> None:
        """Acquire the exact scalar after the caller owns this token."""
        self._ensure_ledger(ledger)
        if self._closed:
            raise CFError("HTTP upload parser scalar is closed")
        if self._acquiring:
            raise CFError("HTTP upload parser scalar acquisition is already active")
        if self._acquire_used:
            raise CFError("HTTP upload parser scalar acquisition is single-use")
        self._acquire_used = True
        self._acquiring = True
        failure: BaseException | None = None
        amount = self._parser_canonical_upper
        try:
            self._allocation.__init__(ledger, retained_primary=amount)
            self._allocation.reserve(
                "request_body", acquires={"retained_bytes": amount}
            )
            self._allocation.consume(
                phase="request_body", acquires={"retained_bytes": amount}
            )
            self._allocation.cancel()
            self._acquired = True
        except BaseException as error:
            AccountedRemoteObjectSetDigest._detach_failure_chain(error)
            failure = error
        self._acquiring = False
        close_requested = self._close_requested
        cleanup_failure: BaseException | None = None
        if close_requested:
            try:
                self.close(ledger)
            except BaseException as error:
                AccountedRemoteObjectSetDigest._detach_failure_chain(error)
                cleanup_failure = error
        if cleanup_failure is not None:
            if failure is not None:
                raise cleanup_failure from failure
            raise cleanup_failure from None
        if failure is not None:
            raise failure from None
        if close_requested:
            raise CFError("HTTP upload parser scalar acquisition was cancelled by close")

    def reconcile_exact(
        self, ledger: DecisionWorkLedger, parser_canonical_bytes: int
    ) -> None:
        """Shrink the pre-parse upper to the parser's exact canonical size."""
        self._ensure_ledger(ledger)
        if self._closed or not self._acquired:
            raise CFError("HTTP upload parser scalar is not acquired")
        if (
            isinstance(parser_canonical_bytes, bool)
            or not isinstance(parser_canonical_bytes, int)
            or parser_canonical_bytes < 0
            or parser_canonical_bytes > self._parser_canonical_upper
        ):
            raise CFError("HTTP upload parser exact scalar exceeds its upper")
        if self._reconciling:
            raise CFError("HTTP upload parser reconciliation is already active")
        if self._reconciled:
            raise CFError("HTTP upload parser reconciliation is single-use")
        if self._reconcile_target is None:
            self._reconcile_target = parser_canonical_bytes
        elif self._reconcile_target != parser_canonical_bytes:
            raise CFError("HTTP upload parser reconciliation target changed")
        self._reconciling = True
        failure: BaseException | None = None
        try:
            self._allocation.shrink_retained_primary(parser_canonical_bytes)
            self._parser_canonical_bytes = parser_canonical_bytes
            self._reconciled = True
        except BaseException as error:
            AccountedRemoteObjectSetDigest._detach_failure_chain(error)
            failure = error
        self._reconciling = False
        close_requested = self._close_requested
        cleanup_failure: BaseException | None = None
        if close_requested:
            try:
                self.close(ledger)
            except BaseException as error:
                AccountedRemoteObjectSetDigest._detach_failure_chain(error)
                cleanup_failure = error
        if cleanup_failure is not None:
            if failure is not None:
                raise cleanup_failure from failure
            raise cleanup_failure from None
        if failure is not None:
            raise failure from None
        if close_requested:
            raise CFError(
                "HTTP upload parser reconciliation was cancelled by close"
            )

    def _ensure_reconciled(self, ledger: DecisionWorkLedger) -> None:
        self._ensure_ledger(ledger)
        if self._closed or not self._acquired or not self._reconciled:
            raise CFError("HTTP upload parser scalar is not reconciled")

    def _adopt_response_predecessor(
        self,
        response: AccountedHTTPUploadResponseInput,
        token: Any,
        ledger: DecisionWorkLedger,
    ) -> None:
        self._ensure_reconciled(ledger)
        if self._response_input is not None or self._response_token is not None:
            raise CFError("HTTP upload parser scalar already has response input")
        response_transition, response_exact, response_upper = (
            response._baseline_values(ledger)
        )
        transition = self._allocation
        predecessor = response_transition._baseline_retained
        if (
            transition._permit is not None
            or not transition._retained_acquired
            or transition._retained_primary_released
            or transition._retained_secondary != 0
            or transition._temporary != 0
            or transition._baseline_retained != predecessor + response_upper
            or transition._expected_retained
            != predecessor + response_upper + transition._retained_primary
            or ledger._current.get("retained_bytes", 0)
            != predecessor + response_exact + transition._retained_primary
        ):
            raise CFError("HTTP upload response predecessor cannot be reconciled")
        transition._baseline_retained = predecessor + response_exact
        transition._expected_retained = (
            transition._baseline_retained + transition._retained_primary
        )
        self._response_input = response
        self._response_token = token

    def _close_from_source(
        self, source: "AccountedHTTPUploadRequestSource"
    ) -> None:
        if self._source is not source:
            raise CFError("HTTP upload parser scalar has a foreign source")
        self._close(source)

    def _close(
        self, source: "AccountedHTTPUploadRequestSource" | None
    ) -> None:
        if self._closed:
            return
        if self._source is not source:
            if self._source is not None:
                raise CFError("HTTP upload parser scalar was adopted")
            raise CFError("HTTP upload parser scalar has a foreign source")
        if self._acquiring or self._reconciling:
            self._close_requested = True
            return
        if self._closing:
            return
        self._closing = True
        completed = False
        try:
            self._allocation.release_all()
            self._source = None
            self._response_input = None
            self._response_token = None
            self._parser_canonical_upper = 0
            self._parser_canonical_bytes = None
            self._acquired = False
            self._reconciled = False
            self._close_requested = False
            completed = True
        finally:
            if completed:
                self._closed = True
            self._closing = False

    def close(self, ledger: DecisionWorkLedger) -> None:
        self._ensure_ledger(ledger)
        self._close(None)

    def __del__(self) -> None:
        try:
            if self._source is None:
                self._close(None)
        except BaseException:
            pass


def prepare_http_upload_parser_scalar(
    ledger: DecisionWorkLedger, parser_canonical_upper: int
) -> AccountedHTTPUploadParserScalar:
    """Allocate one parser token before acquiring its pre-parse upper."""
    return AccountedHTTPUploadParserScalar(ledger, parser_canonical_upper)


class AccountedHTTPUploadRequestSource:
    """Bind one exactly reconciled parser AST scalar to its request.

    This production-unwired source does not acquire memory.  The HTTP parser
    token has already acquired its pre-parse upper and shrunk it in-place to
    ``parser_canonical_bytes`` for ``request``; the source merely makes that
    exact scalar transferable without a release/reacquire gap.  Only
    ``AccountedHTTPUploadSemantic`` may adopt it.
    """

    def __init__(
        self,
        request: dict[str, Any],
        ledger: DecisionWorkLedger,
        scalar: AccountedHTTPUploadParserScalar,
    ) -> None:
        if type(request) is not dict:
            raise CFError("HTTP upload request source requires a parser mapping")
        records = dict.get(request, "objects")
        if type(records) is not list:
            raise CFError("HTTP upload request source requires the exact objects list")
        if not isinstance(scalar, AccountedHTTPUploadParserScalar):
            raise CFError("HTTP upload request source requires a parser scalar token")
        scalar._ensure_reconciled(ledger)
        if scalar._source is not None:
            raise CFError("HTTP upload parser scalar is already adopted")
        self._ledger = ledger
        self._ledger_identity = id(ledger)
        self._request: dict[str, Any] | None = request
        self._records: list[dict[str, Any]] | None = records
        self._scalar: AccountedHTTPUploadParserScalar | None = scalar
        parser_canonical_bytes = scalar._parser_canonical_bytes
        if parser_canonical_bytes is None:
            raise CFError("HTTP upload parser scalar is not reconciled")
        self._parser_canonical_bytes = parser_canonical_bytes
        self._destination: AccountedHTTPUploadSemantic | None = None
        self._adopted_semantic_identity: AccountedHTTPUploadSemantic | None = None
        self._closing = False
        self._closed = False
        # Destination-first at the source boundary as well: the exact token
        # is reachable from this source before its public alias is marked.
        scalar._source = self

    def _ensure_ledger(self, ledger: DecisionWorkLedger) -> None:
        if (
            id(ledger) != self._ledger_identity
            or id(self._ledger) != self._ledger_identity
        ):
            raise CFError("HTTP upload request source belongs to a different ledger")

    def _ensure_open(self, ledger: DecisionWorkLedger) -> None:
        self._ensure_ledger(ledger)
        if self._closed or self._request is None or self._records is None:
            raise CFError("HTTP upload request source is closed")

    def _close_from_destination(
        self, destination: "AccountedHTTPUploadSemantic"
    ) -> None:
        if (
            self._destination is not destination
            or self._adopted_semantic_identity is not destination
        ):
            raise CFError("HTTP upload request source has a foreign destination")
        self._close(destination)

    def _close(
        self, destination: "AccountedHTTPUploadSemantic" | None
    ) -> None:
        if self._closed:
            return
        if (
            self._destination is not destination
            or self._adopted_semantic_identity is not destination
        ):
            if (
                self._destination is not None
                or self._adopted_semantic_identity is not None
            ):
                raise CFError("HTTP upload request source was adopted")
            raise CFError("HTTP upload request source has a foreign destination")
        if self._closing:
            return
        self._closing = True
        completed = False
        try:
            # The complete parser AST and exact objects list die before their
            # scalar. A pre-effect release failure retains only the scalar for
            # the same destination-owned retry.
            self._request = None
            self._records = None
            scalar = self._scalar
            if scalar is not None:
                scalar._close_from_source(self)
                self._scalar = None
            self._parser_canonical_bytes = 0
            self._destination = None
            self._adopted_semantic_identity = None
            completed = True
        finally:
            if completed:
                self._closed = True
            self._closing = False

    def close(self, ledger: DecisionWorkLedger) -> None:
        self._ensure_ledger(ledger)
        self._close(None)

    def __del__(self) -> None:
        try:
            if (
                self._destination is None
                and self._adopted_semantic_identity is None
            ):
                self._close(None)
        except BaseException:
            pass


def bind_http_upload_request_source(
    request: dict[str, Any],
    ledger: DecisionWorkLedger,
    scalar: AccountedHTTPUploadParserScalar,
) -> AccountedHTTPUploadRequestSource:
    """Move one exact acquired parser token into its request source."""
    return AccountedHTTPUploadRequestSource(request, ledger, scalar)


class AccountedHTTPUploadSemantic:
    """Own one unwired upload semantic and immutable object-copy input.

    The caller receives this destination before explicit ``prepare`` performs
    digest/copy work.  The digest and future effect inputs remain private;
    this type deliberately has no digest or payload getter.
    """

    SEMANTIC_RETAINED_BYTES = 8192
    # Filled from the carrier's runtime-sized conservative ownership upper
    # after that exact class is defined below.
    PAIR_SEMANTIC_CARRIER_RETAINED_BYTES = 0
    EXISTING_EFFECT_INPUT_RETAINED_BYTES = 0
    REFERENCE_TUPLE_BASE_BYTES = sys.getsizeof(())
    REFERENCE_SLOT_BYTES = 16
    COPY_LIST_BASE_BYTES = sys.getsizeof([])
    COPY_LIST_SLOT_BYTES = 16
    COPY_BYTES_BASE_BYTES = sys.getsizeof(b"")
    SEMANTIC_TEMPORARY_BASE_BYTES = 4096
    # Full-request fingerprinting and terminal canonical revalidation build
    # encoder stacks/key lists as well as output bytes.  Reuse the digest
    # owner's conservative per-source-byte scratch envelope; these semantic
    # walks are sequential with the separately accounted digest child.
    SEMANTIC_TEMPORARY_BYTES_PER_SOURCE_BYTE = 256
    # Full-request size + fingerprint, object validation + core serialization,
    # then the same four source-sized walks at the terminal fence.
    SEMANTIC_WORK_PASSES = 8

    def __init__(
        self,
        source: AccountedHTTPUploadRequestSource,
        ledger: DecisionWorkLedger,
        stable_project_id: str,
        remote_branch: str,
        deadline: HTTPRequestDeadline | None,
        pair_semantic_carrier: bool = False,
        existing_project_gate: Any | None = None,
        existing_effect_input: bool = False,
        existing_response_input: Any | None = None,
    ) -> None:
        self._ledger = ledger
        self._ledger_identity = id(ledger)
        self._deadline = deadline
        self._source: AccountedHTTPUploadRequestSource | None = None
        self._digest_owner: AccountedRemoteObjectSetDigest | None = None
        self._allocation = _StablePermitTransition(ledger)
        self._record_refs: tuple[dict[str, Any], ...] | None = None
        self._sorted_refs: tuple[dict[str, Any], ...] | None = None
        self._copy_build: list[bytes] | None = None
        self._copy_bytes: tuple[bytes, ...] | None = None
        self._request_digest: str | None = None
        self._semantic: dict[str, Any] | None = None
        self._semantic_view: MappingProxyType | None = None
        self._effect_copy_bytes: tuple[bytes, ...] | None = None
        self._effect_semantic: MappingProxyType | None = None
        self._stable_project_id = stable_project_id
        self._remote_branch = remote_branch
        self._preparing = False
        self._prepared = False
        self._prepare_used = False
        self._terminal_active = False
        self._terminal_started = False
        self._terminal_revalidated = False
        self._terminal_failed = False
        self._terminal_complete = False
        self._terminal_probe_owner: _HTTPUploadSemanticTerminalProbe | None = None
        self._pair_semantic_carrier_owner: Any | None = None
        self._pair_semantic_carrier_control = pair_semantic_carrier
        self._existing_effect_input_control = existing_effect_input
        self._response_input: AccountedHTTPUploadResponseInput | None = None
        self._response_token: Any | None = None
        self._publication_input: AccountedHTTPUploadExistingPublicationInput | None = None
        self._publication_token: Any | None = None
        self._pair_semantic_control_bytes = (
            self.PAIR_SEMANTIC_CARRIER_RETAINED_BYTES
            + (
                self.EXISTING_EFFECT_INPUT_RETAINED_BYTES
                if existing_effect_input
                else 0
            )
        )
        self._stable_gate_owner: Any | None = None
        self._stable_gate_token: Any | None = None
        self._carrier_payload_released = False
        self._closing = False
        self._close_requested = False
        self._closed = False

        if not isinstance(source, AccountedHTTPUploadRequestSource):
            raise CFError("HTTP upload semantic requires a request source")
        if existing_effect_input and not pair_semantic_carrier:
            raise CFError(
                "HTTP upload effect input requires pair carrier control"
            )
        if (
            existing_response_input is not None
            and type(existing_response_input) is not AccountedHTTPUploadResponseInput
        ):
            raise CFError("HTTP upload semantic requires exact response input")
        source._ensure_open(ledger)
        if (
            source._destination is not None
            or source._adopted_semantic_identity is not None
        ):
            raise CFError("HTTP upload request source is already adopted")
        if type(stable_project_id) is not str or not stable_project_id:
            raise CFError("HTTP upload semantic requires a stable project ID")
        if type(remote_branch) is not str or not remote_branch:
            raise CFError("HTTP upload semantic requires a remote branch")
        request = source._request
        if request is None:
            raise CFError("HTTP upload request source is unavailable")
        local_branch = dict.get(request, "branch")
        head = dict.get(request, "head")
        if type(local_branch) is not str or not local_branch:
            raise CFError("HTTP upload semantic requires a local branch")
        if (
            type(head) is not str
            or not head.startswith("CF-COMMIT-")
        ):
            raise CFError("HTTP upload semantic requires a commit head")
        if any(
            len(value) > 255
            for value in (
                stable_project_id,
                remote_branch,
                local_branch,
                head,
            )
        ):
            raise CFError("HTTP upload semantic identity exceeds 255 characters")
        if existing_project_gate is not None:
            gate_type = AccountedHTTPUploadExistingProjectGate
            if type(existing_project_gate) is not gate_type:
                raise CFError("HTTP upload semantic requires an exact project gate")
            gate_token = existing_project_gate._semantic_proof(
                ledger, stable_project_id
            )
            self._stable_gate_owner = existing_project_gate
            self._stable_gate_token = gate_token
        if existing_response_input is not None:
            scalar = source._scalar
            if type(scalar) is not AccountedHTTPUploadParserScalar:
                raise CFError("HTTP upload response input requires parser scalar")
            response_token = existing_response_input._adopt_semantic(
                self, scalar, ledger
            )
            self._response_input = existing_response_input
            self._response_token = response_token
        # Destination-first adoption: the exact source owner is reachable
        # from this caller-owned object before its public alias is marked as
        # transferred. There is no scalar release/reacquire operation.
        if existing_project_gate is not None:
            existing_project_gate._publish_semantic(
                self, ledger, gate_token
            )
        self._source = source
        source._destination = self
        source._adopted_semantic_identity = self

    def _ensure_ledger(self, ledger: DecisionWorkLedger) -> None:
        if (
            id(ledger) != self._ledger_identity
            or id(self._ledger) != self._ledger_identity
        ):
            raise CFError("HTTP upload semantic belongs to a different ledger")

    def _ensure_bound(self, carrier_owner: Any | None = None) -> None:
        self._ensure_ledger(self._ledger)
        registry = object.__getattribute__(
            self._ledger, "_upload_terminal_owner"
        )
        if carrier_owner is not None:
            effect_input_owner = object.__getattribute__(
                carrier_owner, "_effect_input_owner"
            )
            registry_matches = registry is carrier_owner
            if effect_input_owner is not None and registry is effect_input_owner:
                registry_matches = (
                    object.__getattribute__(effect_input_owner, "_carrier")
                    is carrier_owner
                    and object.__getattribute__(effect_input_owner, "_token")
                    is object.__getattribute__(
                        carrier_owner, "_effect_input_token"
                    )
                )
            if (
                self._pair_semantic_carrier_owner is not carrier_owner
                or not registry_matches
            ):
                raise CFError("HTTP upload pair semantic carrier adopted semantic")
        elif self._pair_semantic_carrier_control:
            pair_owner = registry
            pair_matches = (
                type(pair_owner) is AccountedHTTPUploadExistingTerminalOwner
                and pair_owner._sealed_owner is not None
                and pair_owner._sealed_owner._semantic_baseline_owner is self
            )
            if self._pair_semantic_carrier_owner is not None or not (
                registry is None or pair_matches
            ):
                raise CFError("HTTP upload pair semantic carrier adopted semantic")
        elif self._pair_semantic_carrier_owner is not None:
            raise CFError("HTTP upload pair semantic carrier adopted semantic")
        if self._closed:
            raise CFError("HTTP upload semantic owner is closed")

    @staticmethod
    def _checked_product(value: int, multiplier: int, label: str) -> int:
        if value > U64_MAX // multiplier:
            raise CFError(f"HTTP upload semantic {label} exceeds the u64 domain")
        return value * multiplier

    def _allocation_upper(
        self, source_bytes: int, record_count: int
    ) -> tuple[int, int, int]:
        reference_slots = self._checked_product(
            record_count, self.REFERENCE_SLOT_BYTES * 2, "reference storage"
        )
        copy_slots = self._checked_product(
            record_count,
            self.COPY_LIST_SLOT_BYTES + self.COPY_BYTES_BASE_BYTES,
            "copy storage",
        )
        retained = (
            self.SEMANTIC_RETAINED_BYTES
            + 2 * self.REFERENCE_TUPLE_BASE_BYTES
            + self.COPY_LIST_BASE_BYTES
            + reference_slots
            + copy_slots
            + source_bytes
        )
        temporary = (
            self.SEMANTIC_TEMPORARY_BASE_BYTES
            + self._checked_product(
                source_bytes,
                self.SEMANTIC_TEMPORARY_BYTES_PER_SOURCE_BYTE,
                "canonical scratch",
            )
        )
        work = self._checked_product(
            source_bytes, self.SEMANTIC_WORK_PASSES, "semantic work"
        )
        if retained > U64_MAX or temporary > U64_MAX:
            raise CFError("HTTP upload semantic allocation exceeds the u64 domain")
        return retained, temporary, work

    def _poll(self) -> None:
        if self._deadline is not None:
            self._deadline.check("upload semantic preparation")

    def _validate_source_exact(self, *, polling: bool) -> None:
        source = self._source
        if source is None:
            raise CFError("HTTP upload semantic request source is unavailable")
        source._ensure_open(self._ledger)
        request = source._request
        records = source._records
        if request is None or records is None or dict.get(request, "objects") is not records:
            raise CFError("HTTP upload semantic request source changed")
        limit = source._parser_canonical_bytes
        actual = canonical_json_size_up_to(
            request,
            limit,
            self._poll if polling else None,
        )
        if actual != limit:
            raise CFError("HTTP upload parser scalar does not match its full request")

    def prepare(self, ledger: DecisionWorkLedger) -> None:
        """Prepare private semantic/copy inputs after caller ownership exists."""
        self._ensure_ledger(ledger)
        self._ensure_bound()
        if self._preparing:
            raise CFError("HTTP upload semantic prepare is already active")
        if self._prepare_used:
            raise CFError("HTTP upload semantic prepare is single-use")
        source = self._source
        if source is None:
            raise CFError("HTTP upload semantic request source is unavailable")
        source._ensure_open(ledger)
        records = source._records
        request = source._request
        if records is None or request is None:
            raise CFError("HTTP upload semantic request source is unavailable")
        source_bytes = source._parser_canonical_bytes
        retained, temporary, work = self._allocation_upper(
            source_bytes, len(records)
        )
        self._prepare_used = True
        self._preparing = True
        failure: BaseException | None = None
        digest_owner: AccountedRemoteObjectSetDigest | None = None
        record: dict[str, Any] | None = None
        digest: str | None = None
        local_branch: str | None = None
        head: str | None = None
        try:
            self._allocation.__init__(
                ledger,
                retained_primary=retained,
                retained_secondary=(
                    self._pair_semantic_control_bytes
                    if self._pair_semantic_carrier_control
                    else 0
                ),
                temporary=temporary,
            )
            retained_total = retained + (
                self._pair_semantic_control_bytes
                if self._pair_semantic_carrier_control
                else 0
            )
            self._allocation.reserve(
                "query",
                charges={"aggregate_bytes": work},
                acquires={
                    "retained_bytes": retained_total,
                    "temporary_bytes": temporary,
                },
            )
            self._allocation.consume(
                phase="query",
                charges={"aggregate_bytes": work},
                acquires={
                    "retained_bytes": retained_total,
                    "temporary_bytes": temporary,
                },
            )
            self._allocation.cancel()
            self._validate_source_exact(polling=True)
            request_hasher = hashlib.sha256()
            _hash_canonical_json_polling(
                request_hasher, request, self._poll
            )
            self._request_digest = "sha256:" + request_hasher.hexdigest()
            request_hasher = None
            AccountedRemoteObjectSetDigest(
                records,
                ledger,
                source_bytes,
                self._deadline,
                _handoff_owner=self,
            )
            digest_owner = self._digest_owner
            if digest_owner is None or digest_owner._ordered is None:
                raise CFError("HTTP upload semantic digest owner is unavailable")
            self._record_refs = tuple(records)
            self._sorted_refs = tuple(digest_owner._ordered)
            self._copy_build = []
            for record in self._sorted_refs:
                self._poll()
                validate_object_record(record)
                # Freeze the exact bytes the post-terminal object-copy effect
                # can write. Digest evidence remains the full request record,
                # including historical ``remote`` extensions; publication
                # bytes intentionally use the existing core-plus-newline form.
                self._copy_build.append(_serialize_object_record_core(record))
            self._copy_bytes = tuple(self._copy_build)
            self._copy_build = None
            record = None
            digest = digest_owner._digest
            if digest is None:
                raise CFError("HTTP upload semantic digest is unavailable")
            local_branch = dict.get(request, "branch")
            head = dict.get(request, "head")
            self._semantic = {
                "stable_project_id": self._stable_project_id,
                "remote_branch": self._remote_branch,
                "local_branch": local_branch,
                "head": head,
                "object_set_digest": digest,
            }
            self._semantic_view = MappingProxyType(self._semantic)
            # The destination mapping owns the exact string before the child
            # drops its copy/reference collections and scalar reservation.
            digest_owner._digest = None
            digest_owner.close()
            self._digest_owner = None
            self._prepared = True
        except BaseException as error:
            AccountedRemoteObjectSetDigest._detach_failure_chain(error)
            failure = error
        source = None
        records = None
        request = None
        request_hasher = None
        digest_owner = None
        record = None
        digest = None
        local_branch = None
        head = None
        self._preparing = False
        close_requested = self._close_requested
        cleanup_failure: BaseException | None = None
        if close_requested:
            try:
                self.close(ledger)
            except BaseException as error:
                AccountedRemoteObjectSetDigest._detach_failure_chain(error)
                cleanup_failure = error
        if cleanup_failure is not None:
            if failure is not None:
                raise cleanup_failure from failure
            raise cleanup_failure from None
        if failure is not None:
            # The caller already owns every exact partial child/source field.
            raise failure from None
        if close_requested:
            raise CFError("HTTP upload semantic prepare was cancelled by close")

    def _selected_semantic(self) -> Any:
        if self._effect_semantic is not None:
            return self._effect_semantic
        return self._semantic_view

    def matches_semantic(self, expected: Any) -> bool:
        self._ensure_bound()
        if self._preparing or self._terminal_active:
            raise CFError("HTTP upload semantic owner is active")
        semantic = self._selected_semantic()
        if not self._prepared or semantic is None:
            raise CFError("HTTP upload semantic owner is not prepared")
        return type(expected) is dict and semantic == expected

    def _revalidate_terminal_inputs(self) -> None:
        self._validate_source_exact(polling=False)
        source = self._source
        if source is None or source._records is None:
            raise CFError("HTTP upload semantic request source is unavailable")
        records = source._records
        record_refs = self._record_refs
        sorted_refs = self._sorted_refs
        copy_bytes = self._copy_bytes
        semantic = self._semantic
        expected_request_digest = self._request_digest
        if (
            record_refs is None
            or sorted_refs is None
            or copy_bytes is None
            or semantic is None
            or expected_request_digest is None
            or len(records) != len(record_refs)
            or len(sorted_refs) != len(copy_bytes)
        ):
            raise CFError("HTTP upload semantic terminal inputs are unavailable")
        request = source._request
        if request is None:
            raise CFError("HTTP upload semantic request source is unavailable")
        actual_request_digest = "sha256:" + hashlib.sha256(
            canonical_json(request)
        ).hexdigest()
        if not hmac.compare_digest(
            actual_request_digest, expected_request_digest
        ):
            raise CFError("HTTP upload full request changed before terminal")
        for index, record in enumerate(records):
            if record is not record_refs[index]:
                raise CFError("HTTP upload request record identity changed")
        digest = hashlib.sha256()
        digest.update(b"[")
        prior_object_id: str | None = None
        for index, record in enumerate(sorted_refs):
            object_id = dict.get(record, "object_id") if type(record) is dict else None
            if type(object_id) is not str or not object_id:
                raise CFError("HTTP upload request record identity changed")
            if prior_object_id is not None and object_id <= prior_object_id:
                raise CFError("HTTP upload request record identity changed")
            prior_object_id = object_id
            encoded = canonical_json(record)
            if index:
                digest.update(b",")
            digest.update(encoded)
            encoded = None
            copy_input = _serialize_object_record_core(record)
            if copy_input != copy_bytes[index]:
                copy_input = None
                raise CFError("HTTP upload object-copy input changed before terminal")
            copy_input = None
        digest.update(b"]")
        actual = "sha256:" + digest.hexdigest()
        expected = dict.get(semantic, "object_set_digest")
        if type(expected) is not str or not hmac.compare_digest(actual, expected):
            raise CFError("HTTP upload semantic digest changed before terminal")

    def terminal_detach(self, ledger: DecisionWorkLedger) -> None:
        """Revalidate mutable input, then detach private effect slots."""
        self._ensure_ledger(ledger)
        self._ensure_bound()
        if self._terminal_probe_owner is not None:
            raise CFError("HTTP upload semantic terminal probe is still live")
        if not self._prepared:
            raise CFError("HTTP upload semantic owner is not prepared")
        if self._terminal_complete:
            raise CFError("HTTP upload semantic terminal detach is single-use")
        if self._terminal_active:
            raise CFError("HTTP upload semantic terminal detach is already active")
        if self._terminal_failed:
            raise CFError("HTTP upload semantic owner is abort-only")
        if self._terminal_started and not self._terminal_revalidated:
            raise CFError("HTTP upload semantic owner is abort-only")
        self._terminal_started = True
        self._terminal_active = True
        failure: BaseException | None = None
        try:
            if not self._terminal_revalidated:
                # This is the last callback-rich fence. Any mutation it
                # triggers is observed by the callback-free revalidation that
                # immediately follows.
                if self._deadline is not None:
                    self._deadline.check("upload semantic terminal")
                self._revalidate_terminal_inputs()
                # All locals in the revalidation frame are gone before the
                # parser source can release its mutable AST scalar.
                self._record_refs = None
                self._sorted_refs = None
                self._terminal_revalidated = True
            source = self._source
            if source is not None:
                source._close_from_destination(self)
                self._source = None
            self._allocation.release_temporary()
        except BaseException as error:
            AccountedRemoteObjectSetDigest._detach_failure_chain(error)
            failure = error
            if not self._terminal_revalidated:
                self._terminal_failed = True
        self._terminal_active = False
        close_requested = self._close_requested
        cleanup_failure: BaseException | None = None
        if close_requested:
            try:
                self.close(ledger)
            except BaseException as error:
                AccountedRemoteObjectSetDigest._detach_failure_chain(error)
                cleanup_failure = error
        if cleanup_failure is not None:
            if failure is not None:
                raise cleanup_failure from failure
            raise cleanup_failure from None
        if failure is not None:
            raise failure from None
        if close_requested:
            raise CFError("HTTP upload semantic terminal was cancelled by close")
        # Callback-free final detach: only prepublished field assignments.
        self._effect_semantic = self._semantic_view
        self._effect_copy_bytes = self._copy_bytes
        self._semantic = None
        self._semantic_view = None
        self._copy_bytes = None
        self._request_digest = None
        self._terminal_complete = True

    def _cleanup_terminal_for_pair_semantic_carrier(self, owner: Any) -> None:
        """Release mutable parser state after callback-free carrier commit."""
        self._ensure_bound(owner)
        if self._terminal_active:
            raise CFError("HTTP upload semantic terminal cleanup is already active")
        if (
            not self._terminal_started
            or not self._terminal_revalidated
            or self._terminal_failed
            or self._semantic is not None
            or self._semantic_view is not None
            or self._copy_bytes is not None
            or self._request_digest is not None
            or self._record_refs is not None
            or self._sorted_refs is not None
        ):
            raise CFError("HTTP upload semantic carrier commit is incomplete")
        if self._terminal_complete:
            return
        self._terminal_active = True
        failure: BaseException | None = None
        try:
            source = self._source
            if source is not None:
                source._close_from_destination(self)
                self._source = None
            self._allocation.release_temporary()
            self._terminal_complete = True
        except BaseException as error:
            AccountedRemoteObjectSetDigest._detach_failure_chain(error)
            failure = error
        finally:
            self._terminal_active = False
        if failure is not None:
            raise failure from None

    def _close_payload_from_pair_semantic_carrier(self, owner: Any) -> None:
        """Drop payload ownership but retain the carrier control scalar."""
        self._ensure_bound(owner)
        if self._carrier_payload_released:
            return
        if self._preparing or self._terminal_active:
            raise CFError("HTTP upload semantic payload cleanup is active")
        if self._closing:
            return
        self._closing = True
        completed = False
        try:
            terminal_probe = self._terminal_probe_owner
            if terminal_probe is not None:
                terminal_probe.close()
                self._terminal_probe_owner = None
            self._effect_semantic = None
            self._effect_copy_bytes = None
            self._semantic = None
            self._semantic_view = None
            self._copy_bytes = None
            self._request_digest = None
            self._copy_build = None
            self._record_refs = None
            self._sorted_refs = None
            digest_owner = self._digest_owner
            if digest_owner is not None:
                digest_owner.close()
                self._digest_owner = None
            source = self._source
            if source is not None:
                source._close_from_destination(self)
                self._source = None
            self._close_publication_input()
            self._allocation.release_temporary()
            self._allocation.release_retained_primary()
            self._close_response_input()
            self._deadline = None
            self._stable_project_id = None
            self._remote_branch = None
            self._close_requested = False
            completed = True
        finally:
            if completed:
                self._carrier_payload_released = True
            self._closing = False

    def _release_pair_semantic_carrier_control(self, owner: Any) -> None:
        """Release the logically transferred secondary scalar exactly once."""
        self._ensure_bound(owner)
        if self._closed:
            return
        if not self._carrier_payload_released:
            raise CFError("HTTP upload semantic payload remains live")
        self._allocation.release_retained_secondary()
        if not self._allocation._retained_secondary_released:
            raise CFError("HTTP upload semantic carrier control release is incomplete")
        self._pair_semantic_carrier_control = False
        self._stable_gate_owner = None
        self._stable_gate_token = None
        self._closed = True

    def _close_response_input(self) -> None:
        response = self._response_input
        if response is None:
            return
        response._close_from_semantic(
            self, self._response_token, self._ledger
        )
        self._response_input = None
        self._response_token = None

    def _close_publication_input(self) -> None:
        publication = self._publication_input
        if publication is None:
            return
        publication.close(
            self._ledger,
            _semantic_owner=self,
            _semantic_token=self._publication_token,
        )
        if publication._closed:
            self._publication_input = None
            self._publication_token = None

    def close(
        self,
        ledger: DecisionWorkLedger,
        *,
        _pair_semantic_carrier_owner: Any | None = None,
    ) -> None:
        self._ensure_ledger(ledger)
        if (
            self._pair_semantic_carrier_owner is not None
            and self._pair_semantic_carrier_owner
            is not _pair_semantic_carrier_owner
        ):
            raise CFError("HTTP upload pair semantic carrier adopted semantic")
        if self._closed:
            return
        if self._preparing or self._terminal_active:
            self._close_requested = True
            return
        if self._closing:
            return
        self._closing = True
        completed = False
        try:
            terminal_probe = self._terminal_probe_owner
            if terminal_probe is not None:
                terminal_probe.close()
                self._terminal_probe_owner = None
            self._effect_semantic = None
            self._effect_copy_bytes = None
            self._semantic = None
            self._semantic_view = None
            self._copy_bytes = None
            self._request_digest = None
            self._copy_build = None
            self._record_refs = None
            self._sorted_refs = None
            digest_owner = self._digest_owner
            if digest_owner is not None:
                digest_owner.close()
                self._digest_owner = None
            source = self._source
            if source is not None:
                source._close_from_destination(self)
                self._source = None
            self._close_publication_input()
            self._allocation.release_all()
            self._close_response_input()
            self._deadline = None
            self._stable_project_id = None
            self._stable_gate_owner = None
            self._stable_gate_token = None
            self._remote_branch = None
            self._close_requested = False
            completed = True
        finally:
            if completed:
                self._closed = True
            self._closing = False

    def __del__(self) -> None:
        try:
            if self._pair_semantic_carrier_owner is None:
                self.close(self._ledger)
        except BaseException:
            pass


class _HTTPUploadSemanticTerminalProbe:
    """Preallocated no-hook terminal probe for one prepared semantic.

    Construction is callback-rich and must happen before a caller's final
    deadline callback. ``capture`` then returns the exact callback-free probe
    closure. This prerequisite is production-unwired and mints no capability.
    """

    # Five parallel frame arrays use at most 40(L + 1) pointer bytes.  The
    # immutable plan has one descriptor plus key/child-link tuples per
    # container; every container, key and edge consumes canonical
    # input bytes, so their tuple slots, exact plan-index integers, copy views,
    # frame-index integers and <= 12L scalar encoding transient fit within the
    # semantic owner's conservative 256(L + 1) terminal scratch envelope.
    # Mutable builder maps/lists are discarded before the final callback.
    FRAME_ARRAYS = 5
    KEY_ARENAS = 0
    IDENTITY_ARENAS = 0
    STEP_MULTIPLIER = 4

    VALUE = 0
    DICT = 1
    LIST = 2

    def __init__(self, semantic: AccountedHTTPUploadSemantic) -> None:
        if type(semantic) is not AccountedHTTPUploadSemantic:
            raise CFError("HTTP upload terminal probe requires an exact semantic")
        semantic._ensure_bound()
        if semantic._terminal_probe_owner is not None:
            raise CFError("HTTP upload terminal probe is already owned")
        if (
            not semantic._prepared
            or semantic._preparing
            or semantic._terminal_started
            or semantic._terminal_active
            or semantic._terminal_complete
            or semantic._terminal_failed
            or semantic._closed
        ):
            raise CFError("HTTP upload terminal probe requires a prepared semantic")
        source = semantic._source
        if source is None or source._request is None or source._records is None:
            raise CFError("HTTP upload terminal probe source is unavailable")
        request = source._request
        records = source._records
        record_refs = semantic._record_refs
        sorted_refs = semantic._sorted_refs
        copy_bytes = semantic._copy_bytes
        mapping = semantic._semantic
        view = semantic._semantic_view
        request_digest = semantic._request_digest
        limit = source._parser_canonical_bytes
        if (
            type(request) is not dict
            or type(records) is not list
            or dict.get(request, "objects") is not records
            or type(record_refs) is not tuple
            or type(sorted_refs) is not tuple
            or type(copy_bytes) is not tuple
            or type(mapping) is not dict
            or type(view) is not MappingProxyType
            or type(request_digest) is not str
            or type(limit) is not int
            or limit < 0
            or len(records) != len(record_refs)
            or len(sorted_refs) != len(copy_bytes)
        ):
            raise CFError("HTTP upload terminal probe inputs are incomplete")
        for record in record_refs:
            if (
                type(record) is not dict
                or type(dict.get(record, "object_id")) is not str
            ):
                raise CFError(
                    "HTTP upload terminal probe requires exact object records"
                )
        if any(type(value) is not bytes for value in copy_bytes):
            raise CFError("HTTP upload terminal probe copy inputs are incomplete")
        capacity = limit + 1
        frame_kind = [0] * capacity
        frame_value = [None] * capacity
        frame_aux = [None] * capacity
        frame_index = [0] * capacity
        frame_root = [False] * capacity
        arrays = (
            frame_kind,
            frame_value,
            frame_aux,
            frame_index,
            frame_root,
        )
        expected_sorted = tuple(
            sorted(record_refs, key=lambda record: dict.get(record, "object_id"))
        )
        plan_bundle = _HTTPUploadSemanticTerminalProbe._build_plan(
            request,
            limit,
            expected_sorted,
        )
        semantic_keys = tuple(dict.keys(mapping))
        semantic_values = tuple(dict.__getitem__(mapping, key) for key in semantic_keys)
        if any(type(value) is not str for value in semantic_values):
            raise CFError("HTTP upload terminal probe semantic is incomplete")
        if semantic_keys != (
            "stable_project_id",
            "remote_branch",
            "local_branch",
            "head",
            "object_set_digest",
        ):
            raise CFError("HTTP upload terminal probe semantic keys are incomplete")
        self._semantic = semantic
        self._pins = None
        self._primitives = None
        self._exact_probe = None
        self._revoke = None
        self._closed = False

        def capture_instance_state(
            owner: Any,
            owner_type: type,
            required_names: tuple[str, ...],
        ) -> tuple[Any, ...]:
            class_mapping = type.__getattribute__(owner_type, "__dict__")
            descriptor = MappingProxyType.__getitem__(class_mapping, "__dict__")
            descriptor_get = type(descriptor).__get__
            instance_mapping = descriptor_get(descriptor, owner, owner_type)
            if type(instance_mapping) is not dict:
                raise CFError("HTTP upload terminal probe requires exact state")
            keys = tuple(dict.keys(instance_mapping))
            positions = []
            for required_name in required_names:
                for index, key in enumerate(keys):
                    if key == required_name:
                        positions.append(index)
                        break
                else:
                    raise CFError("HTTP upload terminal probe state is incomplete")
            return (
                owner,
                owner_type,
                descriptor,
                instance_mapping,
                keys,
                tuple(positions),
            )

        semantic_state = capture_instance_state(
            semantic,
            AccountedHTTPUploadSemantic,
            (
                "_source",
                "_record_refs",
                "_sorted_refs",
                "_copy_bytes",
                "_semantic",
                "_semantic_view",
                "_request_digest",
                "_terminal_probe_owner",
            ),
        )
        source_state = capture_instance_state(
            source,
            AccountedHTTPUploadRequestSource,
            ("_request", "_records", "_parser_canonical_bytes"),
        )
        probe_state = capture_instance_state(
            self,
            _HTTPUploadSemanticTerminalProbe,
            (
                "_semantic",
                "_pins",
                "_primitives",
                "_exact_probe",
                "_revoke",
                "_closed",
            ),
        )
        descriptor_get = type(tuple.__getitem__(semantic_state, 2)).__get__

        primitives = (
            type,
            len,
            range,
            id,
            object.__getattribute__,
            dict.keys,
            dict.get,
            dict.__getitem__,
            dict.__contains__,
            list.__getitem__,
            tuple.__getitem__,
            str.__lt__,
            str.encode,
            int.__repr__,
            int.bit_length,
            repr,
            json.encoder.encode_basestring,
            hashlib.sha256,
            hmac.compare_digest,
            float("inf"),
            float("-inf"),
            CFError,
            dict,
            list,
            tuple,
            str,
            int,
            float,
            bool,
            descriptor_get,
            dict.__setitem__,
        )
        probe_fn = _HTTPUploadSemanticTerminalProbe._probe
        walk_fn = _HTTPUploadSemanticTerminalProbe._walk
        error_type = CFError
        list_item = list.__getitem__
        list_set = list.__setitem__
        tuple_item = tuple.__getitem__
        release_view = None
        dict_keys = dict.keys
        dict_item = dict.__getitem__
        dict_set = dict.__setitem__
        selected_type = type
        dict_type = dict
        str_type = str
        index_range = range
        length_of = len
        capsule = [1, None, primitives, probe_fn, walk_fn]

        def validated_state(state: tuple[Any, ...]) -> dict[str, Any] | None:
            owner = tuple_item(state, 0)
            owner_type = tuple_item(state, 1)
            descriptor = tuple_item(state, 2)
            expected_mapping = tuple_item(state, 3)
            expected_keys = tuple_item(state, 4)
            if selected_type(owner) is not owner_type:
                return None
            actual_mapping = descriptor_get(descriptor, owner, owner_type)
            if (
                actual_mapping is not expected_mapping
                or selected_type(actual_mapping) is not dict_type
                or length_of(actual_mapping) != length_of(expected_keys)
            ):
                return None
            key_index = 0
            for key in dict_keys(actual_mapping):
                if key is not tuple_item(expected_keys, key_index):
                    return None
                key_index += 1
            return actual_mapping

        def revoke() -> None:
            if list_item(capsule, 0) == 0:
                return
            list_set(capsule, 0, 0)
            selected_pins = list_item(capsule, 1)
            if selected_pins is not None:
                for selected_view in tuple_item(selected_pins, 7):
                    release_view(selected_view)
                selected_semantic_state = tuple_item(selected_pins, 17)
                semantic_mapping = validated_state(selected_semantic_state)
                if semantic_mapping is not None:
                    positions = tuple_item(selected_semantic_state, 5)
                    keys = tuple_item(selected_semantic_state, 4)
                    owner_key = tuple_item(keys, tuple_item(positions, 7))
                    if dict_item(semantic_mapping, owner_key) is self:
                        dict_set(semantic_mapping, owner_key, None)
                selected_probe_state = tuple_item(selected_pins, 19)
                probe_mapping = validated_state(selected_probe_state)
                if probe_mapping is not None:
                    positions = tuple_item(selected_probe_state, 5)
                    keys = tuple_item(selected_probe_state, 4)
                    for field_index in index_range(5):
                        key = tuple_item(keys, tuple_item(positions, field_index))
                        dict_set(probe_mapping, key, None)
                    closed_key = tuple_item(keys, tuple_item(positions, 5))
                    dict_set(probe_mapping, closed_key, True)
            for index in index_range(1, length_of(capsule)):
                list_set(capsule, index, None)

        def exact_probe() -> None:
            if list_item(capsule, 0) != 1:
                raise error_type("HTTP upload terminal probe is single-use")
            list_set(capsule, 0, 2)
            try:
                list_item(capsule, 3)(
                    list_item(capsule, 1),
                    list_item(capsule, 2),
                    list_item(capsule, 4),
                )
            finally:
                revoke()

        copy_view_build: list[memoryview] = []
        copy_views: tuple[memoryview, ...] | None = None
        release_built_view = None
        try:
            for value in copy_bytes:
                built_view = memoryview(value)
                if release_built_view is None:
                    release_built_view = type(built_view).release
                copy_view_build.append(built_view)
            copy_views = tuple(copy_view_build)
            release_view = release_built_view
            pins = (
                semantic,
                source,
                request,
                records,
                record_refs,
                sorted_refs,
                copy_bytes,
                copy_views,
                mapping,
                view,
                request_digest,
                limit,
                arrays,
                plan_bundle,
                expected_sorted,
                semantic_values,
                semantic_keys,
                semantic_state,
                source_state,
                probe_state,
            )
            list.__setitem__(capsule, 1, pins)
            probe_mapping = tuple.__getitem__(probe_state, 3)
            probe_positions = tuple.__getitem__(probe_state, 5)
            probe_keys = tuple.__getitem__(probe_state, 4)
            dict.__setitem__(
                probe_mapping,
                tuple.__getitem__(probe_keys, tuple.__getitem__(probe_positions, 1)),
                pins,
            )
            dict.__setitem__(
                probe_mapping,
                tuple.__getitem__(probe_keys, tuple.__getitem__(probe_positions, 2)),
                primitives,
            )
            dict.__setitem__(
                probe_mapping,
                tuple.__getitem__(probe_keys, tuple.__getitem__(probe_positions, 3)),
                exact_probe,
            )
            dict.__setitem__(
                probe_mapping,
                tuple.__getitem__(probe_keys, tuple.__getitem__(probe_positions, 4)),
                revoke,
            )
            semantic._terminal_probe_owner = self
        except BaseException:
            semantic_mapping = validated_state(semantic_state)
            if semantic_mapping is not None:
                semantic_positions = tuple.__getitem__(semantic_state, 5)
                semantic_keys = tuple.__getitem__(semantic_state, 4)
                owner_key = tuple.__getitem__(
                    semantic_keys,
                    tuple.__getitem__(semantic_positions, 7),
                )
                if dict.__getitem__(semantic_mapping, owner_key) is self:
                    dict.__setitem__(semantic_mapping, owner_key, None)
            if release_built_view is not None:
                selected_views = (
                    copy_views if copy_views is not None else tuple(copy_view_build)
                )
                for selected_view in selected_views:
                    release_built_view(selected_view)
            for index in range(1, len(capsule)):
                list.__setitem__(capsule, index, None)
            raise
        finally:
            copy_view_build = []

    def capture(self) -> Any:
        if self._closed:
            raise CFError("HTTP upload terminal probe is closed")
        return self._exact_probe

    @staticmethod
    def _build_plan(
        root: Any,
        limit: int,
        tracked: tuple[Any, ...],
    ) -> tuple[tuple[tuple[Any, ...], ...], int, tuple[int, ...]]:
        """Pin one exact parser DAG, then discard every mutable builder."""
        identity_to_index: dict[int, int] = {}
        builders: list[tuple[Any, ...]] = []
        stack = [root]
        steps = 0
        while stack:
            steps += 1
            if steps > 4 * (limit + 1):
                raise CFError("HTTP upload terminal probe plan exceeds its bound")
            value = stack.pop()
            selected = type(value)
            if selected is dict:
                identity = id(value)
                if identity in identity_to_index:
                    continue
                identity_to_index[identity] = len(builders)
                insertion_keys = []
                for key in dict.keys(value):
                    if type(key) is not str:
                        raise CFError(
                            "HTTP upload terminal probe requires exact string keys"
                        )
                    insertion_keys.append(key)
                canonical_keys = list(insertion_keys)
                canonical_keys.sort()
                remote_index = -1
                for index, key in enumerate(canonical_keys):
                    if key == "remote":
                        remote_index = index
                        break
                canonical_children = tuple(
                    dict.__getitem__(value, key) for key in canonical_keys
                )
                builders.append((
                    1,
                    value,
                    tuple(insertion_keys),
                    tuple(canonical_keys),
                    canonical_children,
                    remote_index,
                ))
                for child in reversed(canonical_children):
                    stack.append(child)
            elif selected is list:
                identity = id(value)
                if identity in identity_to_index:
                    continue
                identity_to_index[identity] = len(builders)
                children = tuple(value)
                builders.append((2, value, children))
                for child in reversed(children):
                    stack.append(child)
            elif selected not in {str, int, float, bool} and value is not None:
                raise CFError(
                    "HTTP upload terminal probe requires exact built-in JSON"
                )
        finalized: list[tuple[Any, ...]] = []
        for builder in builders:
            kind = builder[0]
            children = builder[4] if kind == 1 else builder[2]
            child_plan_indices = tuple(
                identity_to_index[id(child)]
                if type(child) is dict or type(child) is list
                else -1
                for child in children
            )
            if kind == 1:
                finalized.append(builder + (child_plan_indices,))
            else:
                finalized.append(builder + (child_plan_indices,))
        try:
            root_index = identity_to_index[id(root)]
            tracked_indices = tuple(identity_to_index[id(value)] for value in tracked)
        except KeyError as error:
            raise CFError("HTTP upload terminal probe plan is incomplete") from error
        return tuple(finalized), root_index, tracked_indices

    @staticmethod
    def _walk(
        root: Any,
        omit_remote: bool,
        output_limit: int,
        emit: Any,
        arrays: tuple[Any, ...],
        primitives: tuple[Any, ...],
        plan_table: tuple[tuple[Any, ...], ...],
        root_plan_index: int,
    ) -> None:
        (
            selected_type,
            length_of,
            index_range,
            _identity_of,
            _get_attribute,
            dict_keys,
            dict_get,
            dict_item,
            dict_contains,
            list_item,
            tuple_item,
            _text_less,
            _encode_text,
            integer_text,
            integer_bits,
            float_text,
            encode_string,
            _digest_constructor,
            _compare_digest,
            positive_infinity,
            negative_infinity,
            error_type,
            dict_type,
            list_type,
            tuple_type,
            str_type,
            int_type,
            float_type,
            bool_type,
            _descriptor_get,
            _dict_set,
        ) = primitives
        (
            frame_kind,
            frame_value,
            frame_aux,
            frame_index,
            frame_root,
        ) = arrays
        capacity = length_of(frame_kind)
        stack_top = 1
        steps = 0
        frame_kind[0] = 0
        frame_value[0] = root
        frame_aux[0] = root_plan_index
        frame_root[0] = True
        while stack_top:
            steps += 1
            if steps > 4 * capacity:
                raise error_type("HTTP upload terminal probe tree exceeds its bound")
            stack_top -= 1
            kind = frame_kind[stack_top]
            value = frame_value[stack_top]
            aux = frame_aux[stack_top]
            index = frame_index[stack_top]
            is_root = frame_root[stack_top]
            frame_value[stack_top] = None
            frame_aux[stack_top] = None
            if kind == 1:
                plan_index = aux
                plan = tuple_item(plan_table, plan_index)
                canonical_keys = tuple_item(plan, 3)
                children = tuple_item(plan, 4)
                remote_index = tuple_item(plan, 5)
                child_plan_indices = tuple_item(plan, 6)
                if index == length_of(canonical_keys):
                    emit(b"}")
                    continue
                key = tuple_item(canonical_keys, index)
                if omit_remote and is_root and index == remote_index:
                    frame_kind[stack_top] = 1
                    frame_value[stack_top] = value
                    frame_aux[stack_top] = plan_index
                    frame_index[stack_top] = index + 1
                    frame_root[stack_top] = is_root
                    stack_top += 1
                    continue
                emitted_before = index
                if (
                    omit_remote
                    and is_root
                    and remote_index >= 0
                    and remote_index < index
                ):
                    emitted_before -= 1
                if emitted_before:
                    emit(b",")
                emit(_encode_text(encode_string(key), "utf-8"))
                emit(b":")
                if stack_top + 2 > capacity:
                    raise error_type("HTTP upload terminal probe frame overflow")
                frame_kind[stack_top] = 1
                frame_value[stack_top] = value
                frame_aux[stack_top] = plan_index
                frame_index[stack_top] = index + 1
                frame_root[stack_top] = is_root
                stack_top += 1
                expected = tuple_item(children, index)
                if (
                    not dict_contains(value, key)
                    or dict_item(value, key) is not expected
                ):
                    raise error_type(
                        "HTTP upload terminal probe dictionary child changed"
                    )
                frame_kind[stack_top] = 0
                frame_value[stack_top] = expected
                frame_aux[stack_top] = tuple_item(child_plan_indices, index)
                frame_root[stack_top] = False
                stack_top += 1
                continue
            if kind == 2:
                plan_index = aux
                plan = tuple_item(plan_table, plan_index)
                children = tuple_item(plan, 2)
                child_plan_indices = tuple_item(plan, 3)
                if index == length_of(children):
                    emit(b"]")
                    continue
                if index:
                    emit(b",")
                if stack_top + 2 > capacity:
                    raise error_type("HTTP upload terminal probe frame overflow")
                frame_kind[stack_top] = 2
                frame_value[stack_top] = value
                frame_aux[stack_top] = plan_index
                frame_index[stack_top] = index + 1
                frame_root[stack_top] = is_root
                stack_top += 1
                expected = tuple_item(children, index)
                if list_item(value, index) is not expected:
                    raise error_type("HTTP upload terminal probe list child changed")
                frame_kind[stack_top] = 0
                frame_value[stack_top] = expected
                frame_aux[stack_top] = tuple_item(child_plan_indices, index)
                frame_root[stack_top] = False
                stack_top += 1
                continue

            selected = selected_type(value)
            if selected is dict_type:
                if selected_type(plan_table) is not tuple_type or aux < 0:
                    raise error_type("HTTP upload terminal probe map plan changed")
                plan = tuple_item(plan_table, aux)
                if (
                    selected_type(plan) is not tuple_type
                    or tuple_item(plan, 0) != 1
                    or tuple_item(plan, 1) is not value
                ):
                    raise error_type("HTTP upload terminal probe map identity changed")
                insertion_keys = tuple_item(plan, 2)
                if selected_type(insertion_keys) is not tuple_type:
                    raise error_type("HTTP upload terminal probe map plan changed")
                if length_of(value) != length_of(insertion_keys):
                    raise error_type("HTTP upload terminal probe map length changed")
                insertion_index = 0
                for key in dict_keys(value):
                    if key is not tuple_item(insertion_keys, insertion_index):
                        raise error_type(
                            "HTTP upload terminal probe map insertion order changed"
                        )
                    insertion_index += 1
                emit(b"{")
                frame_kind[stack_top] = 1
                frame_value[stack_top] = value
                frame_aux[stack_top] = aux
                frame_index[stack_top] = 0
                frame_root[stack_top] = is_root
                stack_top += 1
            elif selected is list_type:
                if selected_type(plan_table) is not tuple_type or aux < 0:
                    raise error_type("HTTP upload terminal probe list plan changed")
                plan = tuple_item(plan_table, aux)
                if (
                    selected_type(plan) is not tuple_type
                    or tuple_item(plan, 0) != 2
                    or tuple_item(plan, 1) is not value
                ):
                    raise error_type("HTTP upload terminal probe list identity changed")
                children = tuple_item(plan, 2)
                if (
                    selected_type(children) is not tuple_type
                    or length_of(value) != length_of(children)
                ):
                    raise error_type("HTTP upload terminal probe list length changed")
                emit(b"[")
                frame_kind[stack_top] = 2
                frame_value[stack_top] = value
                frame_aux[stack_top] = aux
                frame_index[stack_top] = 0
                frame_root[stack_top] = is_root
                stack_top += 1
            elif selected is str_type:
                if length_of(value) > output_limit:
                    raise error_type("HTTP upload terminal probe string exceeds its bound")
                emit(_encode_text(encode_string(value), "utf-8"))
            elif selected is int_type:
                if integer_bits(value) > 4 * capacity:
                    raise error_type("HTTP upload terminal probe integer exceeds its bound")
                emit(_encode_text(integer_text(value), "utf-8"))
            elif selected is float_type:
                if value != value:
                    emit(b"NaN")
                elif value == positive_infinity:
                    emit(b"Infinity")
                elif value == negative_infinity:
                    emit(b"-Infinity")
                else:
                    emit(_encode_text(float_text(value), "utf-8"))
            elif selected is bool_type:
                emit(b"true" if value else b"false")
            elif value is None:
                emit(b"null")
            else:
                raise error_type("HTTP upload terminal probe requires exact built-in JSON")

    @staticmethod
    def _probe(
        pins: tuple[Any, ...],
        primitives: tuple[Any, ...],
        walk: Any,
    ) -> None:
        (
            semantic,
            source,
            request,
            records,
            record_refs,
            sorted_refs,
            copy_bytes,
            copy_views,
            mapping,
            view,
            request_digest,
            limit,
            arrays,
            plan_bundle,
            expected_sorted,
            semantic_values,
            semantic_keys,
            semantic_state,
            source_state,
            probe_state,
        ) = pins
        (
            selected_type,
            length_of,
            index_range,
            _identity_of,
            _get_attribute,
            dict_keys,
            dict_get,
            dict_item,
            _dict_contains,
            list_item,
            tuple_item,
            _text_less,
            _encode_text,
            _integer_text,
            _integer_bits,
            _float_text,
            _encode_string,
            digest_constructor,
            compare_digest,
            _positive_infinity,
            _negative_infinity,
            error_type,
            dict_type,
            list_type,
            tuple_type,
            str_type,
            _int_type,
            _float_type,
            _bool_type,
            descriptor_get,
            _dict_set,
        ) = primitives

        def validate_state(state: tuple[Any, ...]) -> dict[str, Any]:
            owner = tuple_item(state, 0)
            owner_type = tuple_item(state, 1)
            descriptor = tuple_item(state, 2)
            expected_mapping = tuple_item(state, 3)
            expected_keys = tuple_item(state, 4)
            if selected_type(owner) is not owner_type:
                raise error_type("HTTP upload terminal probe private type changed")
            actual_mapping = descriptor_get(descriptor, owner, owner_type)
            if (
                actual_mapping is not expected_mapping
                or selected_type(actual_mapping) is not dict_type
                or length_of(actual_mapping) != length_of(expected_keys)
            ):
                raise error_type("HTTP upload terminal probe private state changed")
            key_index = 0
            for key in dict_keys(actual_mapping):
                if key is not tuple_item(expected_keys, key_index):
                    raise error_type(
                        "HTTP upload terminal probe private state keys changed"
                    )
                key_index += 1
            return actual_mapping

        def state_value(
            state: tuple[Any, ...],
            state_mapping: dict[str, Any],
            position: int,
        ) -> Any:
            keys = tuple_item(state, 4)
            positions = tuple_item(state, 5)
            key = tuple_item(keys, tuple_item(positions, position))
            return dict_item(state_mapping, key)

        semantic_mapping = validate_state(semantic_state)
        source_mapping = validate_state(source_state)
        validate_state(probe_state)
        if (
            state_value(semantic_state, semantic_mapping, 0) is not source
            or state_value(source_state, source_mapping, 0) is not request
            or state_value(source_state, source_mapping, 1) is not records
            or selected_type(request) is not dict_type
            or selected_type(records) is not list_type
            or selected_type(mapping) is not dict_type
            or state_value(source_state, source_mapping, 2) != limit
            or state_value(semantic_state, semantic_mapping, 1) is not record_refs
            or state_value(semantic_state, semantic_mapping, 2) is not sorted_refs
            or state_value(semantic_state, semantic_mapping, 3) is not copy_bytes
            or state_value(semantic_state, semantic_mapping, 4) is not mapping
            or state_value(semantic_state, semantic_mapping, 5) is not view
            or state_value(semantic_state, semantic_mapping, 6) is not request_digest
        ):
            raise error_type("HTTP upload terminal probe private subject changed")
        if selected_type(plan_bundle) is not tuple_type:
            raise error_type("HTTP upload terminal probe plan changed")
        plan_table = tuple_item(plan_bundle, 0)
        request_plan_index = tuple_item(plan_bundle, 1)
        record_plan_indices = tuple_item(plan_bundle, 2)
        if (
            selected_type(plan_table) is not tuple_type
            or selected_type(record_plan_indices) is not tuple_type
            or length_of(record_plan_indices) != length_of(sorted_refs)
        ):
            raise error_type("HTTP upload terminal probe plan changed")
        if length_of(mapping) != length_of(semantic_keys):
            raise error_type("HTTP upload terminal probe semantic changed")
        semantic_index = 0
        for key in dict_keys(mapping):
            if key is not tuple_item(semantic_keys, semantic_index):
                raise error_type("HTTP upload terminal probe semantic keys changed")
            semantic_index += 1
        for index in index_range(length_of(semantic_keys)):
            key = tuple_item(semantic_keys, index)
            if dict_item(mapping, key) is not tuple_item(semantic_values, index):
                raise error_type("HTTP upload terminal probe semantic changed")

        request_hash = digest_constructor()
        request_size = 0

        def emit_request(chunk: bytes) -> None:
            nonlocal request_size
            request_size += length_of(chunk)
            if request_size > limit:
                raise error_type("HTTP upload terminal probe request exceeds its bound")
            request_hash.update(chunk)

        walk(
            request,
            False,
            limit,
            emit_request,
            arrays,
            primitives,
            plan_table,
            request_plan_index,
        )
        actual_request = "sha256:" + request_hash.hexdigest()
        if request_size != limit or not compare_digest(
            actual_request, request_digest
        ):
            raise error_type("HTTP upload terminal probe full request changed")

        if length_of(records) != length_of(record_refs):
            raise error_type("HTTP upload terminal probe record count changed")
        for index in index_range(length_of(records)):
            if list_item(records, index) is not tuple_item(record_refs, index):
                raise error_type("HTTP upload terminal probe record identity changed")
        for index in index_range(length_of(sorted_refs)):
            if tuple_item(sorted_refs, index) is not tuple_item(
                expected_sorted, index
            ):
                raise error_type("HTTP upload terminal probe sorted order changed")
        prior_object_id = None
        for index in index_range(length_of(sorted_refs)):
            record = tuple_item(sorted_refs, index)
            object_id = dict_get(record, "object_id")
            if (
                selected_type(object_id) is not str_type
                or prior_object_id is not None
                and not _text_less(prior_object_id, object_id)
            ):
                raise error_type("HTTP upload terminal probe sorted IDs changed")
            prior_object_id = object_id

        object_hash = digest_constructor()
        object_size = 1
        object_hash.update(b"[")
        for index in index_range(length_of(sorted_refs)):
            record = tuple_item(sorted_refs, index)
            if selected_type(record) is not dict_type:
                raise error_type("HTTP upload terminal probe record type changed")
            object_id = dict_get(record, "object_id")
            if selected_type(object_id) is not str_type:
                raise error_type("HTTP upload terminal probe object ID changed")
            if index:
                object_hash.update(b",")
                object_size += 1

            def emit_object(chunk: bytes) -> None:
                nonlocal object_size
                object_size += length_of(chunk)
                if object_size > limit:
                    raise error_type("HTTP upload terminal probe object set exceeds bound")
                object_hash.update(chunk)

            walk(
                record,
                False,
                limit,
                emit_object,
                arrays,
                primitives,
                plan_table,
                tuple_item(record_plan_indices, index),
            )
        object_hash.update(b"]")
        object_size += 1
        expected_object_digest = tuple_item(semantic_values, 4)
        actual_object_digest = "sha256:" + object_hash.hexdigest()
        if (
            selected_type(expected_object_digest) is not str_type
            or not compare_digest(actual_object_digest, expected_object_digest)
        ):
            raise error_type("HTTP upload terminal probe object-set digest changed")

        for index in index_range(length_of(sorted_refs)):
            record = tuple_item(sorted_refs, index)
            expected = tuple_item(copy_views, index)
            offset = 0

            def emit_core(chunk: bytes) -> None:
                nonlocal offset
                end = offset + length_of(chunk)
                if end > length_of(expected) or expected[offset:end] != chunk:
                    raise error_type("HTTP upload terminal probe copy input changed")
                offset = end

            walk(
                record,
                True,
                limit,
                emit_core,
                arrays,
                primitives,
                plan_table,
                tuple_item(record_plan_indices, index),
            )
            emit_core(b"\n")
            if offset != length_of(expected):
                raise error_type("HTTP upload terminal probe copy input changed")

    def close(self) -> None:
        if self._closed:
            return
        self._revoke()
        self._semantic = None
        self._pins = None
        self._primitives = None
        self._exact_probe = None
        self._revoke = None
        self._closed = True


def prepare_http_upload_semantic(
    source: AccountedHTTPUploadRequestSource,
    ledger: DecisionWorkLedger,
    stable_project_id: str,
    remote_branch: str,
    deadline: HTTPRequestDeadline | None = None,
    *,
    _pair_semantic_carrier: bool = False,
    _existing_project_gate: Any | None = None,
    _existing_effect_input: bool = False,
    _existing_response_input: Any | None = None,
) -> AccountedHTTPUploadSemantic:
    """Allocate the private semantic destination before explicit prepare."""
    return AccountedHTTPUploadSemantic(
        source,
        ledger,
        stable_project_id,
        remote_branch,
        deadline,
        _pair_semantic_carrier,
        _existing_project_gate,
        _existing_effect_input,
        _existing_response_input,
    )


def merge_request_object_set_digest(records: list[dict[str, Any]]) -> str:
    return "sha256:" + hashlib.sha256(
        canonical_json(canonical_remote_object_records(records))
    ).hexdigest()


def build_merge_request_subject(
    mr_id: str,
    source: dict[str, Any],
    target: dict[str, Any],
    source_head: str,
    target_head: str,
    object_set_digest: str,
) -> dict[str, Any]:
    return {
        "type": "codefire_merge_request_subject",
        "version": VERSION,
        "merge_request_id": mr_id,
        "source_project_id": remote_project_stable_id(source["project_root"]),
        "target_project_id": remote_project_stable_id(target["project_root"]),
        "source_branch": source["branch"],
        "target_branch": target["branch"],
        "source_head": source_head,
        "target_head_at_request": target_head,
        "source_object_set_digest": object_set_digest,
    }


def merge_request_subject_digest(subject: dict[str, Any]) -> str:
    return "sha256:" + hashlib.sha256(canonical_json(subject)).hexdigest()


def validate_merge_request_subject(
    mr: dict[str, Any], source: dict[str, Any], target: dict[str, Any]
) -> str:
    subject = mr.get("subject")
    if "subject" not in mr:
        raise CFError("legacy merge request requires a new subject-bound review before apply")
    if not isinstance(subject, dict):
        raise CFError("merge request subject is malformed")
    source_head = mr.get("source_head")
    if not isinstance(source_head, str):
        raise CFError("merge request subject does not match the current request")
    escrow_records = collect_object_records(remote_dirs(target["project_root"])["objects"], source_head)
    source_project_id = subject.get("source_project_id")
    valid_source_project_id = (
        isinstance(source_project_id, str)
        and source_project_id.startswith("CF-PROJECT-")
        and len(source_project_id.removeprefix("CF-PROJECT-")) == 32
        and all(character in "0123456789abcdefABCDEF" for character in source_project_id.removeprefix("CF-PROJECT-"))
    )
    valid = (
        set(subject) == MERGE_REQUEST_SUBJECT_FIELDS
        and subject.get("type") == "codefire_merge_request_subject"
        and subject.get("version") == VERSION
        and subject.get("merge_request_id") == mr.get("id")
        and valid_source_project_id
        and subject.get("target_project_id") == remote_project_stable_id(target["project_root"])
        and subject.get("source_branch") == source.get("branch")
        and subject.get("target_branch") == target.get("branch")
        and subject.get("source_head") == source_head
        and subject.get("target_head_at_request") == mr.get("target_head_at_request")
        and subject.get("source_object_set_digest") == merge_request_object_set_digest(escrow_records)
    )
    if not valid:
        raise CFError("merge request subject does not match the current request")
    digest = merge_request_subject_digest(subject)
    if mr.get("subject_digest") != digest:
        raise CFError("merge request subject digest diverged")
    return digest


def materialize_merge_request_subject(
    mr: dict[str, Any], source: dict[str, Any], target: dict[str, Any]
) -> str:
    if "subject" in mr:
        return validate_merge_request_subject(mr, source, target)
    reviews = mr.get("reviews")
    if isinstance(reviews, list) and reviews:
        if "legacy_review_history" in mr:
            raise CFError("legacy merge request review history is already materialized")
        mr["legacy_review_history"] = {
            "version": VERSION,
            "reason": "unbound_before_subject_v1",
            "reviews": reviews,
        }
        mr["reviews"] = []
    source_head = mr.get("source_head")
    target_head = mr.get("target_head_at_request")
    if not isinstance(source_head, str) or not isinstance(target_head, str):
        raise CFError("legacy merge request cannot materialize a subject")
    records = collect_object_records(remote_dirs(source["project_root"])["objects"], source_head)
    copy_object_graph(
        remote_dirs(source["project_root"])["objects"],
        remote_dirs(target["project_root"])["objects"],
        source_head,
    )
    subject = build_merge_request_subject(
        str(mr.get("id", "")),
        source,
        target,
        source_head,
        target_head,
        merge_request_object_set_digest(records),
    )
    digest = merge_request_subject_digest(subject)
    mr["subject"] = subject
    mr["subject_digest"] = digest
    return digest


def merge_request_has_effective_approval(mr: dict[str, Any], subject_digest: str) -> bool:
    reviews = mr.get("reviews")
    if not isinstance(reviews, list) or not reviews:
        return False
    for review in reviews:
        if (
            not isinstance(review, dict)
            or set(review) != MERGE_REQUEST_REVIEW_FIELDS
            or not isinstance(review.get("reviewer"), str)
            or not isinstance(review.get("comment"), str)
            or not isinstance(review.get("reviewed_at"), str)
            or not isinstance(review.get("subject_digest"), str)
            or review.get("decision") not in {"approve", "reject"}
        ):
            raise CFError("merge request review has an invalid or future schema")
    effective = reviews[-1]
    expected_status = "approved" if effective["decision"] == "approve" else "rejected"
    if mr.get("status") != expected_status:
        raise CFError("merge request status diverges from its effective review")
    return effective["decision"] == "approve" and effective["subject_digest"] == subject_digest


def validate_merge_request_record(mr: dict[str, Any]) -> None:
    validate_persisted_record_version(mr, "remote_merge_request")
    validate_remote_component(str(mr.get("id", "")), "merge-request ID")
    source = parse_cf_url(mr["source_url"])
    target = parse_cf_url(mr["target_url"])
    source_objects = (
        remote_dirs(target["project_root"])["objects"]
        if "subject" in mr
        else remote_dirs(source["project_root"])["objects"]
    )
    refs = [
        ("source_head", source_objects, mr.get("source_head")),
        ("target_head_at_request", remote_dirs(target["project_root"])["objects"], mr.get("target_head_at_request")),
    ]
    if mr.get("applied_head"):
        refs.append(("applied_head", remote_dirs(target["project_root"])["objects"], mr.get("applied_head")))
    for key, objects_root, commit_id in refs:
        if not isinstance(commit_id, str):
            raise CFError(f"merge request validation failed: {key} must be a commit object id")
        try:
            validate_sealed_commit(objects_root, commit_id)
        except CFError as exc:
            raise CFError(f"merge request validation failed: {key}: {exc}") from exc
    if "subject" in mr:
        validate_merge_request_subject(mr, source, target)


def validate_persisted_record_version(record: Any, contract: str) -> None:
    if not isinstance(record, dict):
        raise CFError(f"{contract} must be an object")
    version = record.get("version")
    if isinstance(version, bool) or version != 1:
        if version is None:
            raise CFError(f"{contract}.version is required")
        raise CFError(f"unsupported {contract}.version {version}; readable version is 1")


def validate_remote_branch_record(branch: Any) -> dict[str, Any]:
    validate_persisted_record_version(branch, "remote_branch")
    validate_remote_component(str(branch.get("name", "")), "branch")
    head = branch.get("head")
    if not isinstance(head, str) or not head.startswith("CF-COMMIT-"):
        raise CFError("remote branch head is not a commit object ID")
    return branch


def read_remote_branch_record(project_root: Path, branch: str) -> dict[str, Any] | None:
    record = read_json(remote_branch_path(project_root, branch))
    if record is None:
        return None
    return validate_remote_branch_record(record)


class RetainedObjectDocument:
    def __init__(
        self,
        object_id: str,
        path: Path | None,
        record: dict[str, Any],
        physical_bytes: int,
        retained_bytes: int,
        digest: str | None,
        subdir: str | None = None,
        file_name: str | None = None,
        identity: tuple[int, int] | None = None,
    ) -> None:
        self.object_id = object_id
        self.path = path
        self.record = record
        self.physical_bytes = physical_bytes
        self.retained_bytes = retained_bytes
        self.digest = digest
        self.subdir = subdir
        self.file_name = file_name
        self.identity = identity
        # Lazily populated before this retained record is exposed through the
        # production borrow surface.  The canonical fingerprint remains live
        # through the final fence so a caller cannot retain a raw payload,
        # close its handle, and mutate the session authority afterwards.
        self.borrow_token = 0
        self.borrow_canonical_bytes = 0
        self.borrow_digest: str | None = None
        self.borrow_fingerprint_bytes = 0


class _SealedValidationFileDescriptor:
    """One descriptor owner whose numeric close capability is single-use."""

    def __init__(self) -> None:
        self._fd = -1
        self._identity: tuple[int, int] | None = None

    def open(self, path: Any, flags: int, *, dir_fd: int | None = None) -> int:
        if self._fd >= 0:
            raise CFError("sealed validation descriptor owner is already occupied")
        if dir_fd is None:
            file_descriptor = os.open(path, flags)
        else:
            file_descriptor = os.open(path, flags, dir_fd=dir_fd)
        self._fd = file_descriptor
        return file_descriptor

    def capture_identity(self) -> os.stat_result:
        metadata = os.fstat(self.fileno())
        self._identity = (metadata.st_dev, metadata.st_ino)
        return metadata

    def fileno(self) -> int:
        if self._fd < 0:
            raise CFError("sealed validation descriptor is unavailable")
        return self._fd

    @property
    def identity(self) -> tuple[int, int] | None:
        return self._identity

    @staticmethod
    def _close_fd(file_descriptor: int) -> None:
        _CODEFIRE_OS_CLOSE(file_descriptor)

    def close(self) -> None:
        if self._fd < 0:
            return
        file_descriptor = self._fd
        # Linux does not provide a safe retry proof for close(2): the same
        # integer can be reopened onto the same inode before an exception is
        # observed. Consume numeric ownership before the one allowed call.
        self._fd = -1
        self._identity = None
        self._close_fd(file_descriptor)

    def __del__(self) -> None:
        try:
            self.close()
        except BaseException:
            pass


class _CallbackFreeFD:
    """Preallocated destination for one captured-primitive probe FD."""

    __slots__ = ("_fd",)

    def __init__(self) -> None:
        self._fd = -1

    def open(self, path: Any, flags: int, *, dir_fd: int | None = None) -> int:
        if self._fd >= 0:
            raise CFError("callback-free descriptor slot is occupied")
        descriptor = -1
        try:
            if dir_fd is None:
                descriptor = _CODEFIRE_OS_OPEN(path, flags)
            else:
                descriptor = _CODEFIRE_OS_OPEN(path, flags, dir_fd=dir_fd)
            object.__setattr__(self, "_fd", descriptor)
            return descriptor
        except BaseException:
            if descriptor >= 0 and object.__getattribute__(self, "_fd") != descriptor:
                _CODEFIRE_OS_CLOSE(descriptor)
            raise

    def close(self) -> None:
        descriptor = object.__getattribute__(self, "_fd")
        if descriptor < 0:
            return
        object.__setattr__(self, "_fd", -1)
        _CODEFIRE_OS_CLOSE(descriptor)

    def __del__(self) -> None:
        try:
            self.close()
        except BaseException:
            pass


class SealedCommitValidationSession:
    """One command-scoped memo and snapshot boundary for sealed validation."""

    # Control-state uppers, measured from the interpreter rather than assumed.
    # ``CONTROL_BASE_BYTES`` covers the document memo, the validated-commit set,
    # the descriptor-owner registry, the descriptor reuse pool and the
    # subdirectory map; ``DESCRIPTOR_OWNER_BYTES`` covers one descriptor owner
    # plus its registry and pool slots.
    CONTROL_BASE_BYTES = (
        2 * sys.getsizeof({})
        + sys.getsizeof(set())
        + 2 * sys.getsizeof([])
        + sys.getsizeof(Path("."))
        + 512
    )
    DESCRIPTOR_OWNER_BYTES = (
        sys.getsizeof(object.__new__(_SealedValidationFileDescriptor))
        + sys.getsizeof({"_fd": 0, "_identity": None})
        + 2 * _CANONICAL_POINTER_BYTES
    )
    SUBDIR_ENTRY_BYTES = _CANONICAL_POINTER_BYTES * 3 + 128

    @classmethod
    def control_state_upper(cls, path_bytes: int) -> int:
        """Retained upper for one session's own control state."""
        return cls.CONTROL_BASE_BYTES + path_bytes + cls.DESCRIPTOR_OWNER_BYTES

    def __init__(
        self,
        objects_root: Path,
        ledger: DecisionWorkLedger,
        *,
        memory_owner: Any | None = None,
        control_owner: Any | None = None,
    ) -> None:
        self.ledger = ledger
        self._memory_owner = memory_owner
        # The control owner reserves this session's own Path, memo, sets, lists
        # and descriptor owners.  A payload owner covers both by default; a
        # caller that keeps document accounting on the ledger -- the commit
        # source traversals -- supplies only a control owner.
        self._control_owner = (
            memory_owner if control_owner is None else control_owner
        )
        self._control_bytes = 0
        self._descriptor_owner_bytes = 0
        self._subdir_entry_bytes = 0
        self._ordered_projection_bytes = 0
        # Measure the absolute store path before adopting it, then claim the
        # whole control state -- Path, memo, validated-commit set, descriptor
        # registry, reuse pool, subdirectory map and the root descriptor owner --
        # before the first of those allocators runs.
        absolute_root = os.path.abspath(objects_root)
        control_bytes = self.control_state_upper(
            len(absolute_root.encode("utf-8"))
        )
        self._acquire_control(
            "retained_bytes", control_bytes, "semantic_validation"
        )
        self._control_bytes = control_bytes
        try:
            self.objects_root = Path(absolute_root)
            self.documents: dict[str, RetainedObjectDocument] = {}
            self.validated_commits: set[str] = set()
            self.closed = False
            self.finalized = False
            self._frame_bytes = 0
            self._aux_retained_bytes = 0
            self._pending_document_retained_bytes = 0
            self._pending_temporary_bytes = 0
            self.scanned_object_records = 0
            self._validation_active = False
            self._closing = False
            self._pending_terminal_reason: str | None = None
            self._fd_owners: list[_SealedValidationFileDescriptor] = []
            self._fd_owner_pool: list[_SealedValidationFileDescriptor] = []
            self._subdir_fds: dict[str, _SealedValidationFileDescriptor] = {}
            self._root_fd_owner = self._new_fd_owner(covered=False)
        except BaseException:
            self._release_control("retained_bytes", control_bytes)
            self._control_bytes = 0
            raise
        try:
            root_flags = (
                os.O_RDONLY
                | getattr(os, "O_DIRECTORY", 0)
                | getattr(os, "O_NOFOLLOW", 0)
            )
            self._root_fd_owner.open(self.objects_root, root_flags)
        except OSError as exc:
            raise CFError(f"object store is unavailable: {self.objects_root}") from exc
        root_stat = self._root_fd_owner.capture_identity()
        self._root_identity = (root_stat.st_dev, root_stat.st_ino)

    def _acquire_control(self, dimension: str, amount: int, phase: str) -> None:
        """Claim control state, where an explicit owner covers this session.

        An owner-covered session proves which outstanding reservation owns each
        control allocation.  A session with no control owner keeps its legacy
        accounting: those routes never reserved control state, so claiming it
        here would change established command budgets rather than close an
        escape.
        """
        owner = self._control_owner
        if owner is None or not amount:
            return
        owner._claim_control_memory(dimension, amount, phase)

    def _release_control(self, dimension: str, amount: int) -> None:
        owner = self._control_owner
        if owner is None or not amount:
            return
        owner._release_control_memory(dimension, amount)

    def _charged_allocation_boundary(
        self, dimension: str, amount: int, what: str
    ) -> None:
        """Refuse an allocation whose charge cannot be proved on the ledger.

        This is the production boundary the ordered object-id projection passes
        through -- currently its only caller.  It is a *pre*-allocation check: a build
        that stops charging this structure, or charges it in a dimension the
        caller's ledger never sees, fails here instead of allocating unowned
        memory and being noticed by a later observation.
        """
        owner = self._control_owner
        if owner is None or not amount:
            return
        witness = owner._control_charge_witness(dimension)
        if witness < amount:
            raise CFError(
                f"sealed validation {what} is not charged before allocation: "
                f"{witness} of {amount} {dimension} proved"
            )

    def _charged_ordered_projection(self, phase: str) -> list[str]:
        """Charge, prove the charge, then allocate the ordered object-id list.

        The projection is live for the whole snapshot-revalidation pass, so its
        exact cost is acquired first, proved second, and only then spent.
        """
        projection_bytes = (
            sys.getsizeof([])
            + _CANONICAL_POINTER_BYTES * len(self.documents)
        )
        self._acquire_control("temporary_bytes", projection_bytes, phase)
        self._charged_allocation_boundary(
            "temporary_bytes",
            projection_bytes,
            "ordered object-id projection",
        )
        # Charge, prove, *then* record what is owed -- a boundary refusal must
        # not leave a scalar claiming bytes the owner never accepted.  Nothing
        # fallible separates this from the allocation it pays for.
        self._ordered_projection_bytes = projection_bytes
        return list(self.documents)

    def control_reservation_outstanding(self, dimension: str) -> int:
        """Bytes the control owner still has reserved for this session."""
        owner = self._control_owner
        if owner is None:
            return 0
        return owner._control_reservation_outstanding(dimension)

    def _new_fd_owner(
        self, *, covered: bool = True
    ) -> _SealedValidationFileDescriptor:
        """Return one closed descriptor owner, reusing a released slot first.

        ``_fd_owners`` is the close-all registry, so a fresh owner per read used
        to grow it once per record.  Released owners return to
        ``_fd_owner_pool`` instead, which bounds both the registry and the open
        descriptor count by the number of simultaneously live descriptors:
        the root, one per object subdirectory, and at most two transients.
        """
        pool = self._fd_owner_pool
        while pool:
            reused = pool.pop()
            if reused._fd < 0:
                return reused
        owner_bytes = self.DESCRIPTOR_OWNER_BYTES
        if covered:
            self._acquire_control(
                "retained_bytes", owner_bytes, "graph_discovery"
            )
        owner = _SealedValidationFileDescriptor()
        try:
            self._fd_owners.append(owner)
        except BaseException:
            if covered:
                self._release_control("retained_bytes", owner_bytes)
            raise
        if covered:
            self._descriptor_owner_bytes += owner_bytes
        return owner

    def _recycle_fd_owner(
        self, owner: _SealedValidationFileDescriptor
    ) -> None:
        """Return one released descriptor owner to the reuse pool."""
        if owner._fd >= 0 or self._closing or self.closed:
            return
        if owner is self._root_fd_owner:
            return
        self._fd_owner_pool.append(owner)

    def _memory_apply(
        self,
        phase: str,
        *,
        charges: dict[str, int] | None = None,
        maxima: dict[str, int] | None = None,
        acquires: dict[str, int] | None = None,
        counters: dict[str, int] | None = None,
    ) -> None:
        """Apply work atomically while a prepared owner covers Python heap memory."""
        if self._memory_owner is None:
            self.ledger.apply(
                phase,
                charges=charges,
                maxima=maxima,
                acquires=acquires,
                counters=counters,
            )
            return
        acquired = dict(acquires or {})
        for dimension, amount in acquired.items():
            self._memory_owner._claim_memory(dimension, amount)
        try:
            self.ledger.apply(
                phase,
                charges=charges,
                maxima=maxima,
                counters=counters,
            )
        except BaseException:
            for dimension, amount in reversed(tuple(acquired.items())):
                self._memory_owner._release_memory_claim(dimension, amount)
            raise

    def _memory_acquire(self, dimension: str, amount: int, phase: str) -> None:
        if self._memory_owner is None:
            self.ledger.acquire(dimension, amount, phase)
            return
        self._memory_owner._claim_memory(dimension, amount)

    def _memory_release(self, dimension: str, amount: int) -> None:
        if self._memory_owner is None:
            self.ledger.release(dimension, amount)
            return
        self._memory_owner._release_memory_claim(dimension, amount)

    def _memory_current(self, dimension: str) -> int:
        if self._memory_owner is None:
            return self.ledger._current.get(dimension, 0)
        return self._memory_owner._claimed_memory.get(dimension, 0)

    def _release_memory_scalar(
        self,
        dimension: str,
        scalar_name: str,
        amount: int | None = None,
    ) -> None:
        owned = getattr(self, scalar_name)
        release_amount = owned if amount is None else amount
        if not release_amount:
            return
        if release_amount > owned:
            raise CFError("sealed validation memory scalar underflow")
        current_before = self._memory_current(dimension)
        try:
            self._memory_release(dimension, release_amount)
            setattr(self, scalar_name, owned - release_amount)
        except BaseException:
            current_after = self._memory_current(dimension)
            if (
                current_before >= release_amount
                and current_after == current_before - release_amount
            ):
                setattr(self, scalar_name, owned - release_amount)
            raise

    @staticmethod
    def _object_location(object_id: str) -> tuple[str, str]:
        return exact_object_record_location(object_id)

    def _subdir_fd(self, subdir: str) -> int:
        retained = self._subdir_fds.get(subdir)
        if retained is not None:
            return retained.fileno()
        flags = os.O_RDONLY | getattr(os, "O_DIRECTORY", 0) | getattr(os, "O_NOFOLLOW", 0)
        owner = self._new_fd_owner()
        try:
            owner.open(subdir, flags, dir_fd=self._root_fd_owner.fileno())
        except OSError as exc:
            raise CFError(f"object store directory is unavailable: {subdir}") from exc
        owner.capture_identity()
        # Claim the map entry before inserting it: this owner is retained for
        # the whole session, so it never returns to the reuse pool.
        entry_bytes = self.SUBDIR_ENTRY_BYTES + len(subdir.encode("utf-8"))
        self._acquire_control("retained_bytes", entry_bytes, "graph_discovery")
        try:
            self._subdir_fds[subdir] = owner
        except BaseException:
            self._release_control("retained_bytes", entry_bytes)
            raise
        self._subdir_entry_bytes += entry_bytes
        return owner.fileno()

    def _check_store_identity(self, poll: Any | None = None) -> None:
        def changed(path: Path) -> SealedValidationSubjectChanged:
            return SealedValidationSubjectChanged(
                "<object-store>", path, "store_identity_changed", 0, None
            )

        try:
            root = os.fstat(self._root_fd_owner.fileno())
        except OSError as exc:
            raise changed(self.objects_root) from exc
        if (root.st_dev, root.st_ino) != self._root_identity:
            raise changed(self.objects_root)
        for subdir, owner in self._subdir_fds.items():
            if poll is not None:
                poll()
            try:
                actual = os.fstat(owner.fileno())
            except OSError as exc:
                raise changed(self.objects_root / subdir) from exc
            if (actual.st_dev, actual.st_ino) != owner.identity:
                raise changed(self.objects_root / subdir)
        ambient_root_owner = self._new_fd_owner()
        try:
            root_flags = (
                os.O_RDONLY
                | getattr(os, "O_DIRECTORY", 0)
                | getattr(os, "O_NOFOLLOW", 0)
            )
            ambient_root_owner.open(self.objects_root, root_flags)
        except OSError as exc:
            raise changed(self.objects_root) from exc
        try:
            try:
                ambient_root = ambient_root_owner.capture_identity()
            except OSError as exc:
                raise changed(self.objects_root) from exc
            if (ambient_root.st_dev, ambient_root.st_ino) != self._root_identity:
                raise changed(self.objects_root)
            flags = (
                os.O_RDONLY
                | getattr(os, "O_DIRECTORY", 0)
                | getattr(os, "O_NOFOLLOW", 0)
            )
            for subdir, retained_owner in self._subdir_fds.items():
                if poll is not None:
                    poll()
                ambient_subdir_owner = self._new_fd_owner()
                try:
                    ambient_subdir_owner.open(
                        subdir,
                        flags,
                        dir_fd=ambient_root_owner.fileno(),
                    )
                    ambient_subdir = ambient_subdir_owner.capture_identity()
                    if (
                        ambient_subdir.st_dev,
                        ambient_subdir.st_ino,
                    ) != retained_owner.identity:
                        raise changed(self.objects_root / subdir)
                except SealedValidationSubjectChanged:
                    raise
                except OSError as exc:
                    raise changed(self.objects_root / subdir) from exc
                finally:
                    ambient_subdir_owner.close()
                    self._recycle_fd_owner(ambient_subdir_owner)
        finally:
            ambient_root_owner.close()
            self._recycle_fd_owner(ambient_root_owner)

    def _read_exact_bounded(
        self,
        object_id: str,
        subdir: str,
        file_name: str,
        charge: Any,
        *,
        revalidation: bool,
        expected_document: RetainedObjectDocument | None = None,
        poll: Any | None = None,
    ) -> tuple[bytes, int, tuple[int, int]]:
        if poll is not None:
            poll()
        directory_fd = self._subdir_fd(subdir)
        flags = os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0)
        display_path = self.objects_root / subdir / file_name
        try:
            initial = os.stat(
                file_name,
                dir_fd=directory_fd,
                follow_symlinks=False,
            )
        except OSError as exc:
            if revalidation and expected_document is not None:
                raise SealedValidationSubjectChanged(
                    object_id,
                    display_path,
                    "unreadable",
                    expected_document.physical_bytes,
                    None,
                ) from exc
            raise CFError(f"object not found: {object_id}") from exc
        file_owner = self._new_fd_owner()
        try:
            file_owner.open(file_name, flags, dir_fd=directory_fd)
        except OSError as exc:
            if revalidation and expected_document is not None:
                raise SealedValidationSubjectChanged(
                    object_id,
                    display_path,
                    "unreadable",
                    expected_document.physical_bytes,
                    None,
                ) from exc
            raise CFError(f"object not found: {object_id}") from exc
        try:
            before = file_owner.capture_identity()
            initial_identity = (initial.st_dev, initial.st_ino)
            opened_identity = (before.st_dev, before.st_ino)
            if (
                not stat.S_ISREG(initial.st_mode)
                or not stat.S_ISREG(before.st_mode)
                or initial.st_nlink != 1
                or before.st_nlink != 1
                or initial_identity != opened_identity
                or initial.st_size != before.st_size
            ):
                if revalidation and expected_document is not None:
                    raise SealedValidationSubjectChanged(
                        object_id,
                        display_path,
                        "identity_changed",
                        expected_document.physical_bytes,
                        before.st_size,
                    )
                raise CFError(f"object record identity is invalid: {display_path}")
            size = before.st_size
            if size > MAX_OBJECT_RECORD_BYTES:
                if revalidation and expected_document is not None:
                    raise SealedValidationSubjectChanged(
                        object_id,
                        display_path,
                        "size_changed",
                        expected_document.physical_bytes,
                        size,
                    )
                raise CFError(
                    "object record exceeds the "
                    f"{MAX_OBJECT_RECORD_BYTES}-byte limit at {display_path}: {size} bytes"
                )
            charge(size)
            buffer = bytearray()
            while len(buffer) < size:
                if poll is not None:
                    poll()
                chunk = os.read(
                    file_owner.fileno(), min(64 * 1024, size - len(buffer))
                )
                if not chunk:
                    break
                buffer.extend(chunk)
            if poll is not None:
                poll()
            extension = os.read(file_owner.fileno(), 1)
            after = os.fstat(file_owner.fileno())
            identity_before = (before.st_dev, before.st_ino)
            identity_after = (after.st_dev, after.st_ino)
            try:
                named = os.stat(
                    file_name,
                    dir_fd=directory_fd,
                    follow_symlinks=False,
                )
            except OSError as exc:
                if revalidation and expected_document is not None:
                    raise SealedValidationSubjectChanged(
                        object_id,
                        display_path,
                        "unreadable",
                        expected_document.physical_bytes,
                        None,
                    ) from exc
                raise SealedValidationSubjectChanged(
                    object_id, display_path, "unreadable", size, None
                ) from exc
            named_identity = (named.st_dev, named.st_ino)
            if (
                len(buffer) != size
                or extension
                or identity_before != identity_after
                or after.st_size != size
                or after.st_nlink != 1
                or not stat.S_ISREG(named.st_mode)
                or named.st_nlink != 1
                or named_identity != identity_before
                or named.st_size != size
            ):
                actual_size = named.st_size
                if revalidation and expected_document is not None:
                    raise SealedValidationSubjectChanged(
                        object_id,
                        display_path,
                        "size_changed",
                        expected_document.physical_bytes,
                        actual_size,
                    )
                raise SealedValidationSubjectChanged(
                    object_id, display_path, "size_changed", size, actual_size
                )
            return bytes(buffer), size, identity_before
        finally:
            file_owner.close()
            self._recycle_fd_owner(file_owner)

    def _ensure_open(self) -> None:
        if self.closed:
            raise CFError("sealed validation session is closed")

    def __del__(self) -> None:
        try:
            self.close(None)
        except Exception:
            pass

    def adopt_aux_retained(self, amount: int) -> None:
        self._ensure_open()
        self._aux_retained_bytes += amount

    @staticmethod
    def _frame_size(object_id: str) -> int:
        return 256 + len(object_id.encode("utf-8"))

    def _charge_frame(
        self, object_id: str, depth: int, frontier: int, *, edge: bool
    ) -> None:
        frame_bytes = self._frame_size(object_id)
        charges = {"graph_edges": 1} if edge else None
        counters = {"frontier_insertion_attempts": 1}
        if edge:
            counters["edge_occurrences"] = 1
        self._memory_apply(
            "graph_discovery",
            charges=charges,
            maxima={"logical_depth": depth, "maximum_frontier": frontier},
            acquires={"retained_bytes": frame_bytes},
            counters=counters,
        )
        self._frame_bytes += frame_bytes

    def _release_frame(self, object_id: str) -> None:
        frame_bytes = self._frame_size(object_id)
        self._release_memory_scalar(
            "retained_bytes", "_frame_bytes", frame_bytes
        )

    def _charge_root_edge(self) -> None:
        self.ledger.apply(
            "graph_discovery",
            charges={"graph_edges": 1},
            counters={"edge_occurrences": 1},
        )

    def _preflight_object_memory(self, object_id: str) -> None:
        if self._memory_owner is not None:
            self._memory_owner._preflight_source(self, object_id)

    def _load_payload_unprotected(
        self, object_id: str, poll: Any | None = None
    ) -> Any:
        if poll is not None:
            poll()
        self._ensure_open()
        retained = self.documents.get(object_id)
        if retained is not None:
            self.ledger.count("memo_hits", 1, "record_read")
            return retained.record["payload"]

        subdir, file_name = self._object_location(object_id)
        path = self.objects_root / subdir / file_name
        if load_object_from_root is not _DEFAULT_LOAD_OBJECT_FROM_ROOT and not path.exists():
            # Preserve the injectable loader used by the iterative cycle test
            # and treat such values as in-memory overlay documents.
            try:
                if poll is not None:
                    poll()
                payload = load_object_from_root(self.objects_root, object_id)
            except CFError:
                raise
            record = {"payload": payload}
            retained_bytes = canonical_json_size_up_to(record, U64_MAX, poll)
            if self._memory_owner is not None:
                self._memory_owner._observe_record(retained_bytes)
            self._memory_apply(
                "record_read",
                acquires={"retained_bytes": retained_bytes},
                counters={"memo_misses": 1, "unique_nodes_discovered": 1},
            )
            self._pending_document_retained_bytes += retained_bytes
            self.documents[object_id] = RetainedObjectDocument(
                object_id, None, record, 0, retained_bytes, None
            )
            return payload

        scratch_bytes = 0
        def charge_read(expected_size: int) -> None:
            nonlocal scratch_bytes
            if self._memory_owner is not None:
                self._memory_owner._observe_loaded_record(
                    object_id, expected_size
                )
            requested_scratch = expected_size * 2
            self._memory_apply(
                "record_read",
                charges={"aggregate_bytes": expected_size, "object_records": 1},
                acquires={"temporary_bytes": requested_scratch},
                counters={
                    "files_read": 1,
                    "file_bytes_read": expected_size,
                    "bytes_hashed": expected_size,
                    "record_reads": 1,
                    "memo_misses": 1,
                    "unique_nodes_discovered": 1,
                    "object_records": 1,
                },
            )
            scratch_bytes = requested_scratch
            self._pending_temporary_bytes += requested_scratch
        retained_bytes = 0
        retained_acquired = 0
        raw: bytes | None = None
        try:
            raw, expected_size, identity = self._read_exact_bounded(
                object_id,
                subdir,
                file_name,
                charge_read,
                revalidation=False,
                poll=poll,
            )
            if poll is not None:
                poll()
            digest = _sha256_hexdigest_polling(raw, poll)
            if poll is not None:
                poll()
            try:
                record = json.loads(raw)
            except (UnicodeDecodeError, json.JSONDecodeError) as exc:
                raise CFError(f"invalid object JSON: {path}: {exc}") from exc
            if poll is not None:
                poll()
            validate_object_record(
                record, expected_oid=object_id, path=path, poll=poll
            )
            self.ledger.count("semantic_validations", 1, "semantic_validation")
            retained_bytes = canonical_json_size_up_to(record, U64_MAX, poll)
            self._memory_acquire("retained_bytes", retained_bytes, "record_read")
            self._pending_document_retained_bytes += retained_bytes
            retained_acquired = retained_bytes
            retained = RetainedObjectDocument(
                object_id,
                path,
                record,
                expected_size,
                retained_bytes,
                digest,
                subdir,
                file_name,
                identity,
            )
            self.documents[object_id] = retained
            raw = None
            return record["payload"]
        except BaseException:
            if retained_acquired:
                self._release_memory_scalar(
                    "retained_bytes",
                    "_pending_document_retained_bytes",
                    retained_acquired,
                )
            raise
        finally:
            raw = None
            if scratch_bytes:
                self._release_memory_scalar(
                    "temporary_bytes", "_pending_temporary_bytes", scratch_bytes
                )

    def load_payload(self, object_id: str, poll: Any | None = None) -> Any:
        try:
            self._preflight_object_memory(object_id)
            return self._load_payload_unprotected(object_id, poll)
        except SealedValidationSubjectChanged:
            if not self._validation_active:
                self.close("subject_changed")
            raise
        except ResourceBudgetExceeded:
            if not self._validation_active:
                self.close(None)
            raise

    def _accounted_sorted_directory_names(
        self, directory_fd: int
    ) -> tuple[list[str], int]:
        names: list[str] = []
        names_bytes = 0
        try:
            with os.scandir(directory_fd) as entries:
                for entry in entries:
                    name_bytes = len(entry.name.encode("utf-8")) + 64
                    self.ledger.acquire(
                        "temporary_bytes", name_bytes, "graph_discovery"
                    )
                    names_bytes += name_bytes
                    names.append(entry.name)
            sort_scratch = names_bytes + 8 * len(names)
            self.ledger.acquire("temporary_bytes", sort_scratch, "query")
            try:
                names.sort()
            finally:
                self.ledger.release("temporary_bytes", sort_scratch)
            return names, names_bytes
        except Exception:
            names.clear()
            if names_bytes:
                self.ledger.release("temporary_bytes", names_bytes)
            raise

    def scan_object_hash_errors(self) -> list[Path]:
        """Validate every exact object record once through this session memo."""
        self._ensure_open()
        bad: list[Path] = []
        for type_tag in OBJECT_PREFIXES:
            subdir = object_subdir(type_tag)
            try:
                directory_fd = self._subdir_fd(subdir)
            except CFError:
                continue
            names, names_bytes = self._accounted_sorted_directory_names(
                directory_fd
            )
            try:
                for name in names:
                    self.ledger.apply(
                        "graph_discovery",
                        maxima={"maximum_frontier": 1},
                        counters={"frontier_insertion_attempts": 1},
                    )
                    path = self.objects_root / subdir / name
                    if not name.endswith(".json"):
                        path_bytes = len(str(path).encode("utf-8")) + 32
                        self.ledger.acquire(
                            "retained_bytes", path_bytes, "graph_discovery"
                        )
                        self.adopt_aux_retained(path_bytes)
                        bad.append(path)
                        continue
                    self.scanned_object_records += 1
                    object_id = name[:-5]
                    try:
                        expected_subdir, expected_name = exact_object_record_location(
                            object_id
                        )
                        if expected_subdir != subdir or expected_name != name:
                            raise CFError("object filename/type mismatch")
                        self.load_payload(object_id)
                    except (ResourceBudgetExceeded, SealedValidationSubjectChanged):
                        raise
                    except (CFError, OSError):
                        path_bytes = len(str(path).encode("utf-8")) + 32
                        self.ledger.acquire(
                            "retained_bytes", path_bytes, "graph_discovery"
                        )
                        self.adopt_aux_retained(path_bytes)
                        bad.append(path)
            finally:
                names.clear()
                if names_bytes:
                    self.ledger.release("temporary_bytes", names_bytes)
        scratch = sum(len(str(path).encode("utf-8")) + 32 for path in bad)
        self.ledger.acquire("temporary_bytes", scratch, "query")
        try:
            return sorted(bad)
        finally:
            self.ledger.release("temporary_bytes", scratch)

    def missing_references(self, roots: list[str]) -> list[str]:
        """Traverse references through the same document memo used by validation."""
        self._ensure_open()
        missing: set[str] = set()
        seen: set[str] = set()
        missing_output_bytes = 0
        stack: list[str] = []
        stack_bytes = 0
        try:
            for root in reversed(roots):
                frame_bytes = self._frame_size(root)
                self.ledger.apply(
                    "graph_discovery",
                    maxima={"maximum_frontier": len(stack) + 1},
                    acquires={"retained_bytes": frame_bytes},
                    counters={"frontier_insertion_attempts": 1},
                )
                stack_bytes += frame_bytes
                stack.append(root)
            while stack:
                object_id = stack.pop()
                frame_bytes = self._frame_size(object_id)
                stack_bytes -= frame_bytes
                self.ledger.release("retained_bytes", frame_bytes)
                if object_id in seen:
                    self.ledger.count("revisits", 1, "graph_discovery")
                    continue
                seen.add(object_id)
                try:
                    self.load_payload(object_id)
                    record = self.documents[object_id].record
                except (ResourceBudgetExceeded, SealedValidationSubjectChanged):
                    raise
                except CFError:
                    if object_record_path(self.objects_root, object_id) is not None:
                        continue
                    missing_bytes = len(object_id.encode("utf-8")) + 32
                    self.ledger.acquire(
                        "retained_bytes", missing_bytes, "graph_discovery"
                    )
                    self.adopt_aux_retained(missing_bytes)
                    missing_output_bytes += missing_bytes
                    missing.add(object_id)
                    continue
                references = object_record_references(record)
                for reference in reversed(references):
                    frame_bytes = self._frame_size(reference)
                    self.ledger.apply(
                        "graph_discovery",
                        charges={"graph_edges": 1},
                        maxima={"maximum_frontier": len(stack) + 1},
                        acquires={"retained_bytes": frame_bytes},
                        counters={
                            "edge_occurrences": 1,
                            "frontier_insertion_attempts": 1,
                        },
                    )
                    stack_bytes += frame_bytes
                    stack.append(reference)
            sort_scratch = missing_output_bytes + 8 * len(missing)
            self.ledger.acquire("temporary_bytes", sort_scratch, "query")
            try:
                return sorted(missing)
            finally:
                self.ledger.release("temporary_bytes", sort_scratch)
        except SealedValidationSubjectChanged:
            self.close("subject_changed")
            raise
        except ResourceBudgetExceeded:
            self.close(None)
            raise
        finally:
            if stack_bytes:
                self.ledger.release("retained_bytes", stack_bytes)

    def validate_commit(self, commit_id: str, poll: Any | None = None) -> None:
        self._ensure_open()
        active: set[str] = set()
        stack: list[tuple[Any, ...]] = []
        terminal_failure: str | None = None
        self._validation_active = True
        try:
            if poll is not None:
                poll()
            self._preflight_object_memory(commit_id)
            self._charge_frame(commit_id, 0, 1, edge=False)
            stack.append(("enter", commit_id, 0))
            while stack:
                if poll is not None:
                    poll()
                frame = stack.pop()
                action = frame[0]
                if action == "enter":
                    current, depth = frame[1], frame[2]
                    if current in self.validated_commits:
                        self._memory_apply(
                            "semantic_validation",
                            counters={"memo_hits": 1, "revisits": 1},
                        )
                        self._release_frame(current)
                        continue
                    if current in active:
                        raise CFError(
                            "sealed commit validation failed: "
                            f"parent cycle detected at {current}"
                        )
                    active.add(current)
                    commit = self.load_payload(current, poll)
                    if not isinstance(commit, dict) or commit.get("type") != "commit":
                        raise CFError(f"not a commit object: {current}")
                    parents = commit.get("parents")
                    if not isinstance(parents, list):
                        raise CFError(
                            "sealed commit validation failed: parents must be a list"
                        )
                    stack.append(("parent", current, commit, parents, 0, depth))
                    continue

                if action == "parent":
                    current, commit, parents, index, depth = frame[1:]
                    if index >= len(parents):
                        stack.append(("finish", current, commit))
                        continue
                    parent = parents[index]
                    if not isinstance(parent, str) or not parent.startswith("CF-COMMIT-"):
                        raise CFError(
                            "sealed commit validation failed: "
                            f"parent {index} must be a commit object id"
                        )
                    stack.append(
                        ("parent", current, commit, parents, index + 1, depth)
                    )
                    child_depth = depth + 1
                    self._preflight_object_memory(parent)
                    self._charge_frame(
                        parent, child_depth, len(stack) + 1, edge=True
                    )
                    stack.append(("enter", parent, child_depth))
                    continue

                current, commit = frame[1], frame[2]
                self.ledger.apply(
                    "semantic_validation",
                    charges={"graph_nodes": 1},
                    counters={"semantic_validations": 1},
                )
                if poll is not None:
                    poll()
                _validate_sealed_commit_payload(
                    commit,
                    lambda object_id: self.load_payload(object_id, poll),
                    self._charge_root_edge,
                    poll,
                    self._preflight_object_memory,
                )
                active.remove(current)
                self.validated_commits.add(current)
                self._release_frame(current)
        except SealedValidationSubjectChanged:
            terminal_failure = "subject_changed"
            raise
        except ResourceBudgetExceeded:
            terminal_failure = "budget_exceeded"
            raise
        finally:
            stack.clear()
            active.clear()
            remaining_frame_bytes = self._frame_bytes
            if remaining_frame_bytes:
                self._release_memory_scalar(
                    "retained_bytes", "_frame_bytes", remaining_frame_bytes
                )
            self._validation_active = False
            if terminal_failure == "subject_changed":
                self.close("subject_changed")
            elif terminal_failure == "budget_exceeded":
                self.close(None)

    def finalize(
        self,
        *,
        terminate: bool = True,
        poll: Any | None = None,
        retain_documents: bool = False,
    ) -> None:
        self._ensure_open()
        if retain_documents and terminate:
            raise CFError(
                "sealed validation cannot retain documents while terminating"
            )
        projection_bytes = 0
        try:
            if poll is not None:
                poll()
            self._check_store_identity(poll)
            # The ordered projection is live for the whole revalidation pass.
            # Charge it, prove the charge, and only then allocate and sort it.
            ordered_object_ids = self._charged_ordered_projection(
                "snapshot_revalidation"
            )
            projection_bytes = self._ordered_projection_bytes
            _sort_strings_polling(ordered_object_ids, poll)
            for object_id in ordered_object_ids:
                if poll is not None:
                    poll()
                retained = self.documents[object_id]
                if retained.path is None:
                    continue
                scratch_bytes = 0
                def charge_revalidation(actual_size: int) -> None:
                    nonlocal scratch_bytes
                    self._memory_apply(
                        "snapshot_revalidation",
                        charges={
                            "snapshot_revalidation_records": 1,
                            "snapshot_revalidation_bytes": actual_size,
                        },
                        acquires={"temporary_bytes": actual_size * 2},
                        counters={
                            "snapshot_revalidation_records": 1,
                            "snapshot_revalidation_bytes": actual_size,
                            "files_read": 1,
                            "file_bytes_read": actual_size,
                            "bytes_hashed": actual_size,
                        },
                    )
                    scratch_bytes = actual_size * 2
                    self._pending_temporary_bytes += scratch_bytes
                raw: bytes | None = None
                actual_length = 0
                try:
                    raw, actual_size, actual_identity = self._read_exact_bounded(
                        object_id,
                        retained.subdir,
                        retained.file_name,
                        charge_revalidation,
                        revalidation=True,
                        expected_document=retained,
                        poll=poll,
                    )
                    actual_length = len(raw)
                    if poll is not None:
                        poll()
                    digest = _sha256_hexdigest_polling(raw, poll)
                    if poll is not None:
                        poll()
                finally:
                    raw = None
                    if scratch_bytes:
                        self._release_memory_scalar(
                            "temporary_bytes",
                            "_pending_temporary_bytes",
                            scratch_bytes,
                        )
                if actual_length != retained.physical_bytes:
                    raise SealedValidationSubjectChanged(
                        object_id,
                        retained.path,
                        "size_changed",
                        retained.physical_bytes,
                        actual_length,
                    )
                if actual_identity != retained.identity:
                    raise SealedValidationSubjectChanged(
                        object_id,
                        retained.path,
                        "identity_changed",
                        retained.physical_bytes,
                        actual_length,
                    )
                if digest != retained.digest:
                    raise SealedValidationSubjectChanged(
                        object_id,
                        retained.path,
                        "digest_changed",
                        retained.physical_bytes,
                        actual_length,
                    )
            if poll is not None:
                poll()
            self._check_store_identity(poll)
            self.finalized = True
            if not retain_documents:
                self.close("complete" if terminate else None)
        except SealedValidationSubjectChanged:
            self.close("subject_changed")
            raise
        except BaseException:
            self.close(None)
            raise
        finally:
            self._release_control_scalar(
                "temporary_bytes", "_ordered_projection_bytes"
            )

    def _release_control_scalar(self, dimension: str, scalar_name: str) -> None:
        """Release one control claim, keeping it owned until that succeeds.

        The scalar is the only record that these bytes are still owed.  Clearing
        it before the fallible release would strand them on a pre-effect failure
        and make the retry a no-op, so it is cleared only once the owner has
        accepted the release.
        """
        amount = getattr(self, scalar_name)
        if not amount:
            return
        owner = self._control_owner
        if owner is None:
            setattr(self, scalar_name, 0)
            return
        held_before = owner._control_claim_held(dimension)
        released = False
        try:
            owner._release_control_memory(dimension, amount)
            released = True
        except BaseException:
            if owner._control_claim_held(dimension) == held_before - amount:
                # The owner accepted the release and the failure arrived after
                # it; the scalar must not stay owed.
                released = True
            raise
        finally:
            if released:
                setattr(self, scalar_name, 0)

    def close(self, terminal_reason: str | None = None) -> None:
        if self.closed or self._closing:
            return
        if terminal_reason is not None and self._pending_terminal_reason is None:
            self._pending_terminal_reason = terminal_reason
        self._closing = True
        completed = False
        try:
            self.documents.clear()
            self.validated_commits.clear()
            self._release_memory_scalar("retained_bytes", "_frame_bytes")
            self._release_memory_scalar(
                "retained_bytes", "_pending_document_retained_bytes"
            )
            self._release_memory_scalar("retained_bytes", "_aux_retained_bytes")
            self._release_memory_scalar(
                "temporary_bytes", "_pending_temporary_bytes"
            )
            self._release_control_scalar(
                "temporary_bytes", "_ordered_projection_bytes"
            )
            for owner in reversed(self._fd_owners):
                owner.close()
            self._subdir_fds.clear()
            self._fd_owner_pool.clear()
            self._fd_owners.clear()
            # The control claims outlive every collection they cover, so they
            # are released only once those collections are empty.
            self._release_control_scalar(
                "retained_bytes", "_subdir_entry_bytes"
            )
            self._release_control_scalar(
                "retained_bytes", "_descriptor_owner_bytes"
            )
            self._release_control_scalar("retained_bytes", "_control_bytes")
            if (
                self._pending_terminal_reason is not None
                and self.ledger.terminal_reason is None
            ):
                self.ledger.terminate(self._pending_terminal_reason)
            self._pending_terminal_reason = None
            completed = True
        finally:
            if completed:
                self.closed = True
            self._closing = False


# ``PATH_MAX`` bound on the absolutised object-store path a session adopts.  A
# longer path is refused by the covered owner's ``_claim_memory`` with the typed
# pre-effect diagnostic instead of being allocated unreserved.
SEALED_SESSION_PATH_BYTES = 4096
# Snapshot of the real session's control-state upper, taken here rather than
# resolved through module globals: ``_from_acquired`` looks
# ``SealedCommitValidationSession`` up dynamically so a fault test can inject a
# failing constructor, and the reservation must stay derived from the production
# session in either case.  ``_new_fd_owner`` recycles released owners, so the
# descriptor count is bounded by the simultaneously open descriptors -- the root,
# one per object subdirectory, and at most two transients.
SEALED_SESSION_CONTROL_UPPER = (
    SealedCommitValidationSession.control_state_upper(SEALED_SESSION_PATH_BYTES)
    + SealedCommitValidationSession.DESCRIPTOR_OWNER_BYTES
    * (len(OBJECT_PREFIXES) + 3)
    + (SealedCommitValidationSession.SUBDIR_ENTRY_BYTES + 64)
    * len(OBJECT_PREFIXES)
)


class _HTTPUploadSealedCommitBorrow:
    """Revocable callable view over already-validated retained commits.

    The handle is allocated inside the sealed owner's pre-acquired fixed
    overhead.  It never loads a document or widens the validated authority;
    callers may only borrow commit payloads already retained by the session.
    """

    def __init__(self, owner: Any, mode: str) -> None:
        self._owner: Any | None = owner
        self._token = 0
        self._mode = mode
        self._used = False

    def _activate(self, token: int) -> None:
        if self._used:
            raise CFError("HTTP upload sealed commit borrow is single-use")
        self._used = True
        self._token = token

    def _revoke(self, owner: Any) -> None:
        if self._owner is owner:
            self._token = 0

    def _detach(self, owner: Any) -> None:
        self._revoke(owner)
        if self._owner is owner:
            self._owner = None

    def __call__(self, object_id: str) -> Any:
        owner = self._owner
        if owner is None or not self._token:
            raise CFError("HTTP upload sealed commit borrow is revoked")
        failure: BaseException | None = None
        result: Any = None
        try:
            result = owner._borrow_commit(
                self, self._token, self._mode, object_id
            )
        except BaseException as exc:
            failure = owner._detach_failure(exc)
        owner = None
        if failure is not None:
            raise failure.with_traceback(None)
        return result

    def close(self, ledger: DecisionWorkLedger | None = None) -> None:
        owner = self._owner
        if owner is None:
            return
        owner._release_commit_borrow(self, self._token, ledger)


class AccountedHTTPUploadSealedValidation:
    """Single-use owner for the post-staging sealed-validation prerequisite.

    The caller supplies immutable upper bounds already known by the staging
    planner.  One reservation is acquired before the validation session (and
    therefore its dict/set/list/path allocators) is constructed.  The owner
    borrows the staged object capability and the session's parsed documents;
    it never clones either payload collection.

    The reservation is a *concurrent* upper, derived in
    ``concurrent_retained_upper`` from the owner lifetimes that really overlap.
    Per-record decode state is streamed -- one record is read, hashed, parsed
    and released before the next read starts -- so its upper is charged once for
    the largest record rather than once per record.
    """

    RETAINED_BASE_BYTES = 64 * 1024
    TEMPORARY_BASE_BYTES = 64 * 1024
    # Temporary scratch owned against the single largest live record.  Every
    # factor names a claim site rather than a heap guess: ``_read_exact_bounded``
    # holds the growing buffer plus its immutable snapshot (2x), and the terminal
    # pair probe preallocates one physical-size read buffer (1x).  Nothing
    # multiplies a whole record into a decode residue any more -- the canonical
    # encoder streams, so its scratch is ``_stream_scratch_upper``.
    TEMPORARY_READ_SCRATCH_MULTIPLIER = 2
    PAIR_PROBE_BYTES_MULTIPLIER = 1
    PAIR_PROBE_TEMPORARY_BASE_BYTES = 4096
    RETAINED_RECORD_BYTES = 4096
    TEMPORARY_RECORD_BYTES = 128
    BORROW_CONTROL_BYTES = 4096
    # The publication-root proof's own control block, plus one slot and the id
    # bytes per certified root (at most 64 by publication identity's own limit).
    PUBLICATION_PROOF_BYTES = 1024
    PUBLICATION_PROOF_ROOT_LIMIT = 64
    PUBLICATION_PROOF_ROOT_BYTES = 256
    SESSION_PATH_BYTES = SEALED_SESSION_PATH_BYTES

    @staticmethod
    def _session_control_upper() -> int:
        """Retained upper for the covered session's own control state.

        Names every structure HIGH-3/MEDIUM-4 found unreserved: the absolutised
        store ``Path``, the document memo, the validated-commit set, the
        descriptor registry and its reuse pool, every descriptor owner, and every
        subdirectory-map entry.  Each is claimed before its own allocator runs.
        """
        return SEALED_SESSION_CONTROL_UPPER
    # Covers the retained baseline digest and the transient size/digest return
    # used to compare it after Temporary encoder storage is released.
    BORROW_FINGERPRINT_BYTES = 1024

    @staticmethod
    def _pair_plan_upper(record_count: int) -> int:
        pointer_bytes = sys.getsizeof((None,)) - sys.getsizeof(tuple())
        subdir_count = min(record_count, len(OBJECT_PREFIXES))
        slot_count = subdir_count + 2
        return (
            3 * sys.getsizeof(tuple())
            + pointer_bytes * (2 * record_count + subdir_count)
            + sys.getsizeof((None, None, None)) * subdir_count
            + sys.getsizeof(object.__new__(_CallbackFreeFD)) * slot_count
        )

    @staticmethod
    def _ordered_projection_upper(record_count: int) -> int:
        """Upper on ``finalize``'s ordered object-id list.

        ``_sort_strings_polling`` is an in-place heapsort, so the projection is
        one list of ``record_count`` pointers and nothing else.
        """
        return sys.getsizeof([]) + _CANONICAL_POINTER_BYTES * record_count

    @staticmethod
    def _pair_builder_temporary_upper(record_count: int) -> int:
        pointer_bytes = sys.getsizeof((None,)) - sys.getsizeof(tuple())
        rounded_records = record_count + (record_count & 1)
        subdir_count = min(record_count, len(OBJECT_PREFIXES))
        return max(
            sys.getsizeof([]) + pointer_bytes * rounded_records,
            sys.getsizeof([]) + pointer_bytes * record_count,
            sys.getsizeof([]) + pointer_bytes * subdir_count,
        )

    def __init__(self, *args: Any, **kwargs: Any) -> None:
        raise TypeError("use prepare_http_upload_sealed_validation")

    @staticmethod
    def _checked_bound(value: int, label: str) -> int:
        if isinstance(value, bool) or not isinstance(value, int) or value < 0:
            raise CFError(f"HTTP upload sealed-validation {label} must be non-negative")
        if value > U64_MAX:
            raise CFError(f"HTTP upload sealed-validation {label} must fit u64")
        return value

    @staticmethod
    def _capture_semantic_baseline(
        semantic: AccountedHTTPUploadSemantic,
        ledger: DecisionWorkLedger,
    ) -> tuple[Any, ...]:
        source = semantic._source
        scalar = None if source is None else source._scalar
        semantic_transition = semantic._allocation
        parser_transition = None if scalar is None else scalar._allocation
        gate_owner = semantic._stable_gate_owner
        gate_token = semantic._stable_gate_token
        gate_transition = None
        gate_retained = 0
        gate_temporary = 0
        gate_epoch = None
        response_owner = semantic._response_input
        response_token = semantic._response_token
        response_transition = None
        response_retained = 0
        response_upper = 0
        publication_owner = semantic._publication_input
        publication_token = semantic._publication_token
        publication_transition = None
        publication_retained = 0
        publication_upper = 0
        publication_request_hash = None
        if gate_owner is not None:
            if type(gate_owner) is not AccountedHTTPUploadExistingProjectGate:
                raise CFError("HTTP upload semantic gate ownership is unavailable")
            (
                gate_transition,
                gate_retained,
                gate_temporary,
                gate_epoch,
            ) = gate_owner._baseline_values(ledger, gate_token)
        elif gate_token is not None:
            raise CFError("HTTP upload semantic gate ownership is unavailable")
        if response_owner is not None:
            if type(response_owner) is not AccountedHTTPUploadResponseInput:
                raise CFError("HTTP upload response baseline is unavailable")
            (
                response_transition,
                response_retained,
                response_upper,
            ) = response_owner._baseline_values(ledger)
        elif response_token is not None:
            raise CFError("HTTP upload response baseline is unavailable")
        if publication_owner is not None:
            if (
                type(publication_owner)
                is not AccountedHTTPUploadExistingPublicationInput
            ):
                raise CFError("HTTP upload publication baseline is unavailable")
            (
                publication_transition,
                publication_retained,
                publication_upper,
            ) = publication_owner._baseline_values(
                ledger, semantic, publication_token
            )
            publication_request_hash = publication_owner._request_hash
        elif publication_token is not None:
            raise CFError("HTTP upload publication baseline is unavailable")
        base_retained = (
            gate_retained
            + response_retained
            + semantic_transition._retained_total
            + (0 if parser_transition is None else parser_transition._retained_total)
        )
        if (
            type(semantic) is not AccountedHTTPUploadSemantic
            or not semantic._pair_semantic_carrier_control
            or semantic._ledger is not ledger
            or source is None
            or source._ledger is not ledger
            or source._destination is not semantic
            or source._adopted_semantic_identity is not semantic
            or scalar is None
            or scalar._ledger is not ledger
            or scalar._source is not source
            or semantic_transition._ledger is not ledger
            or parser_transition is None
            or parser_transition._ledger is not ledger
            or semantic_transition._permit is not None
            or parser_transition._permit is not None
            or semantic_transition._retained_secondary
            != semantic._pair_semantic_control_bytes
            or semantic_transition._retained_total
            != (
                semantic_transition._retained_primary
                + semantic_transition._retained_secondary
            )
            or semantic_transition._baseline_retained
            != gate_retained + response_retained
            + parser_transition._retained_total
            or semantic_transition._expected_retained
            != (
                semantic_transition._baseline_retained
                + semantic_transition._retained_total
            )
            or semantic_transition._baseline_temporary != gate_temporary
            or semantic_transition._expected_temporary
            != gate_temporary + semantic_transition._temporary
            or parser_transition._retained_secondary != 0
            or parser_transition._retained_total
            != parser_transition._retained_primary
            or parser_transition._temporary != 0
            or parser_transition._baseline_retained
            != gate_retained + response_retained
            or parser_transition._expected_retained
            != gate_retained + response_retained
            + parser_transition._retained_total
            or parser_transition._baseline_temporary != gate_temporary
            or parser_transition._expected_temporary != gate_temporary
            or not semantic_transition._acquires_resolved
            or not parser_transition._acquires_resolved
            or not semantic_transition._retained_acquired
            or not semantic_transition._temporary_acquired
            or not parser_transition._retained_acquired
            or semantic_transition._retained_primary_released
            or semantic_transition._retained_secondary_released
            or semantic_transition._temporary_released
            or parser_transition._retained_primary_released
            or not parser_transition._retained_secondary_released
            or not parser_transition._temporary_released
            or ledger.has_open_permits()
            or (
                publication_owner is not None
                and (
                    publication_transition is None
                    or publication_transition._baseline_retained != base_retained
                    or publication_transition._expected_retained
                    != base_retained + publication_retained
                    or publication_transition._baseline_temporary
                    != gate_temporary + semantic_transition._temporary
                    or publication_transition._expected_temporary
                    != (
                        gate_temporary
                        + semantic_transition._temporary
                        + publication_transition._temporary
                    )
                    or publication_transition._permit is not None
                    or not publication_transition._retained_acquired
                    or not publication_transition._temporary_released
                    or publication_transition._retained_primary_released
                )
            )
        ):
            raise CFError("HTTP upload semantic baseline ownership is unavailable")
        retained = base_retained + publication_retained
        temporary = gate_temporary + semantic_transition._temporary
        if (
            ledger._current.get("retained_bytes", 0) != retained
            or ledger._current.get("temporary_bytes", 0) != temporary
        ):
            raise CFError("HTTP upload semantic baseline has foreign scalars")
        return (
            ledger,
            semantic,
            semantic_transition,
            source,
            scalar,
            parser_transition,
            semantic_transition._retained_primary,
            semantic_transition._retained_secondary,
            semantic_transition._temporary,
            parser_transition._retained_primary,
            retained,
            temporary,
            gate_owner,
            gate_token,
            gate_transition,
            gate_retained,
            gate_temporary,
            gate_epoch,
            semantic._pair_semantic_control_bytes,
            semantic._existing_effect_input_control,
            publication_owner,
            publication_token,
            publication_transition,
            publication_retained,
            publication_upper,
            publication_request_hash,
            response_owner,
            response_token,
            response_transition,
            response_retained,
            response_upper,
        )

    @staticmethod
    def _semantic_baseline_intact(
        proof: tuple[Any, ...],
        *,
        require_current: bool,
    ) -> bool:
        (
            ledger,
            semantic,
            semantic_transition,
            source,
            scalar,
            parser_transition,
            semantic_primary,
            semantic_secondary,
            semantic_temporary,
            parser_primary,
            retained,
            temporary,
            gate_owner,
            gate_token,
            gate_transition,
            gate_retained,
            gate_temporary,
            gate_epoch,
            semantic_control_bytes,
            existing_effect_input_control,
            publication_owner,
            publication_token,
            publication_transition,
            publication_retained,
            publication_upper,
            publication_request_hash,
            response_owner,
            response_token,
            response_transition,
            response_retained,
            response_upper,
        ) = proof
        gate_intact = gate_owner is None and gate_token is None
        if gate_owner is not None:
            gate_intact = (
                type(gate_owner) is AccountedHTTPUploadExistingProjectGate
                and object.__getattribute__(gate_owner, "_factory_owned")
                and object.__getattribute__(gate_owner, "_semantic_owner")
                is semantic
                and object.__getattribute__(gate_owner, "_ledger") is ledger
                and object.__getattribute__(gate_owner, "_proof_token")
                is gate_token
                and object.__getattribute__(gate_owner, "_transition")
                is gate_transition
                and object.__getattribute__(gate_owner, "_retained_upper")
                == gate_retained
                and object.__getattribute__(gate_owner, "_temporary_upper")
                == gate_temporary
                and object.__getattribute__(gate_owner, "_acquired_epoch")
                == gate_epoch
                and object.__getattribute__(gate_owner, "_state")
                in {
                    AccountedHTTPUploadExistingProjectGate.READY,
                    AccountedHTTPUploadExistingProjectGate.ADOPTED,
                }
                and not object.__getattribute__(gate_owner, "_closed")
                and gate_transition is not None
                and gate_transition._permit is None
                and gate_transition._retained_acquired
                and gate_transition._temporary_acquired
                and not gate_transition._retained_primary_released
                and not gate_transition._temporary_released
            )
        response_intact = response_owner is None and response_token is None
        if response_owner is not None:
            response_intact = (
                type(response_owner) is AccountedHTTPUploadResponseInput
                and response_owner._semantic_owner is semantic
                and response_owner._semantic_token is response_token
                and response_owner._transition is response_transition
                and response_owner._retained_exact == response_retained
                and response_owner._retained_upper == response_upper
                and response_owner._state == response_owner.ADOPTED
                and not response_owner._closed
                and response_transition is not None
                and response_transition._baseline_retained == gate_retained
                and response_transition._retained_primary == response_retained
                and response_transition._expected_retained
                == gate_retained + response_retained
                and response_transition._permit is None
                and response_transition._retained_acquired
                and not response_transition._retained_primary_released
            )
        publication_intact = (
            publication_owner is None and publication_token is None
        )
        publication_base_retained = (
            gate_retained
            + response_retained
            + semantic_primary
            + semantic_secondary
            + parser_primary
        )
        if publication_owner is not None:
            publication_intact = (
                type(publication_owner)
                is AccountedHTTPUploadExistingPublicationInput
                and publication_owner._ledger is ledger
                and publication_owner._semantic_owner is semantic
                and publication_owner._semantic_token is publication_token
                and publication_owner._transition is publication_transition
                and publication_owner._retained_exact == publication_retained
                and publication_owner._retained_upper == publication_upper
                and publication_owner._request_hash is publication_request_hash
                and type(publication_request_hash) is str
                and len(publication_request_hash) == 64
                and publication_owner._state
                == publication_owner.IDENTITY_BOUND
                and not publication_owner._closed
                and publication_transition is not None
                and publication_transition._baseline_retained
                == publication_base_retained
                and publication_transition._expected_retained
                == publication_base_retained + publication_retained
                and publication_transition._baseline_temporary
                == gate_temporary + semantic_temporary
                and publication_transition._expected_temporary
                == (
                    gate_temporary
                    + semantic_temporary
                    + publication_transition._temporary
                )
                and publication_transition._permit is None
                and publication_transition._retained_acquired
                and publication_transition._temporary_released
                and not publication_transition._retained_primary_released
            )
        intact = (
            gate_intact
            and response_intact
            and publication_intact
            and type(semantic) is AccountedHTTPUploadSemantic
            and semantic._ledger is ledger
            and semantic._source is source
            and semantic._allocation is semantic_transition
            and semantic._pair_semantic_carrier_control
            and semantic._pair_semantic_control_bytes
            == semantic_control_bytes
            and semantic._existing_effect_input_control
            is existing_effect_input_control
            and semantic._response_input is response_owner
            and semantic._response_token is response_token
            and semantic._publication_input is publication_owner
            and semantic._publication_token is publication_token
            and source._ledger is ledger
            and source._destination is semantic
            and source._adopted_semantic_identity is semantic
            and source._scalar is scalar
            and scalar._ledger is ledger
            and scalar._source is source
            and scalar._allocation is parser_transition
            and scalar._response_input is response_owner
            and scalar._response_token is response_token
            and semantic_transition._ledger is ledger
            and parser_transition._ledger is ledger
            and semantic_transition._permit is None
            and parser_transition._permit is None
            and semantic_transition._retained_primary == semantic_primary
            and semantic_transition._retained_secondary == semantic_secondary
            and semantic_transition._temporary == semantic_temporary
            and parser_transition._retained_primary == parser_primary
            and semantic_secondary
            == semantic_control_bytes
            and semantic_transition._retained_total
            == semantic_primary + semantic_secondary
            and semantic_transition._baseline_retained
            == gate_retained + response_retained
            + parser_transition._retained_total
            and semantic_transition._expected_retained
            == semantic_transition._baseline_retained
            + semantic_transition._retained_total
            and semantic_transition._baseline_temporary == gate_temporary
            and semantic_transition._expected_temporary
            == gate_temporary + semantic_temporary
            and parser_transition._retained_secondary == 0
            and parser_transition._retained_total == parser_primary
            and parser_transition._temporary == 0
            and parser_transition._baseline_retained
            == gate_retained + response_retained
            and parser_transition._expected_retained
            == gate_retained + response_retained + parser_primary
            and parser_transition._baseline_temporary == gate_temporary
            and parser_transition._expected_temporary == gate_temporary
            and retained
            == gate_retained + response_retained
            + semantic_transition._retained_total
            + parser_transition._retained_total
            + publication_retained
            and temporary == gate_temporary + semantic_temporary
            and semantic_transition._acquires_resolved
            and parser_transition._acquires_resolved
            and semantic_transition._retained_acquired
            and semantic_transition._temporary_acquired
            and parser_transition._retained_acquired
            and not semantic_transition._retained_primary_released
            and not semantic_transition._retained_secondary_released
            and not semantic_transition._temporary_released
            and not parser_transition._retained_primary_released
            and parser_transition._retained_secondary_released
            and parser_transition._temporary_released
        )
        if not intact:
            return False
        return not require_current or (
            ledger._current.get("retained_bytes", 0) == retained
            and ledger._current.get("temporary_bytes", 0) == temporary
        )

    @classmethod
    def concurrent_retained_upper(
        cls,
        record_count: int,
        aggregate_bytes: int,
        maximum_record_bytes: int,
    ) -> int:
        """Upper bound on retained bytes this owner holds at any one instant.

        Every term below is derived from an owner lifetime that is actually
        concurrent, so the reservation tracks the request's real high-water
        instead of the sum of every record's peak:

        * ``_session_control_upper`` covers the validation session's own control
          state -- its store ``Path``, document memo, validated-commit set,
          descriptor registry, reuse pool, descriptor owners and subdirectory
          map -- each of which is claimed before its allocator runs.
          ``BORROW_CONTROL_BYTES`` covers the two preallocated borrow handles and
          ``RETAINED_BASE_BYTES`` the owner's own fixed fields.  All live for the
          whole session.
        * ``RETAINED_RECORD_BYTES`` per record covers the one
          ``RetainedObjectDocument`` control block, its memo slot, and the
          fixed part of the one ``_charge_frame`` traversal frame that record
          may occupy.  A record may hold all three at once, so this term is
          linear in the count.
        * ``BORROW_FINGERPRINT_BYTES`` per record covers
          ``_seal_borrowed_document``, which keeps one fingerprint per borrowed
          document until final detach; a ``require_history`` policy can borrow
          the whole staged history.
        * ``aggregate_bytes`` covers the retained documents themselves.  Each
          one claims exactly its own canonical measure and the memo keeps them
          live for final snapshot revalidation, so their concurrent total is
          bounded by the staged aggregate -- once, not once per record.
        * ``aggregate_bytes`` again covers the variable part of the concurrent
          traversal frames.  ``_frame_size`` adds the object id, one frame is
          live per active node, and every distinct id a frame can carry occurs
          inside the staged bundle, so their total is bounded by the aggregate
          one more time.
        * ``_pair_plan_upper`` covers the pair-probe plan tuples, and the
          ``PUBLICATION_PROOF_*`` terms the request-owned publication-root proof
          and its certified object ids, bounded by publication identity's own
          64-root limit.

        There is deliberately no ``maximum_record_bytes`` term.  Every retained
        claim in the covered pool is one of: a document's own canonical measure
        (``_load_payload_unprotected``), a ``256 + len(object_id)`` traversal
        frame (``_charge_frame``), the fixed ``BORROW_FINGERPRINT_BYTES``
        fingerprint (``_seal_borrowed_document``), the session control blocks, or
        the pair-probe plan -- and each is already covered above.  No claim
        multiplies a record's bytes into ``retained_bytes``, so a per-record heap
        factor here would refuse admissible bundles on formula slack alone.
        ``maximum_record_bytes`` is still validated against
        ``aggregate_bytes_upper`` by ``allocation_upper``.
        """
        return (
            cls.RETAINED_BASE_BYTES
            + cls.BORROW_CONTROL_BYTES
            + cls._session_control_upper()
            + cls.PUBLICATION_PROOF_BYTES
            + cls.PUBLICATION_PROOF_ROOT_BYTES * cls.PUBLICATION_PROOF_ROOT_LIMIT
            + (cls.RETAINED_RECORD_BYTES + cls.BORROW_FINGERPRINT_BYTES)
            * record_count
            + 2 * aggregate_bytes
            + cls._pair_plan_upper(record_count)
        )

    @classmethod
    def concurrent_temporary_upper(
        cls,
        record_count: int,
        maximum_record_bytes: int,
    ) -> int:
        """Upper bound on temporary bytes this owner claims at any one instant.

        The reader streams: one record is read, hashed, parsed and released
        before the next read begins, and the canonical encoder now emits bounded
        chunks instead of materialising a whole record.  The concurrent claims
        are therefore

        * ``TEMPORARY_BASE_BYTES`` plus ``TEMPORARY_RECORD_BYTES`` per record for
          the session's own bookkeeping,
        * ``_pair_builder_temporary_upper`` and
          ``PAIR_PROBE_TEMPORARY_BASE_BYTES`` for the terminal pair builders,
        * ``_ordered_projection_upper`` for ``finalize``'s ordered-id list, which
          is live for the whole snapshot-revalidation pass, and
        * the largest single-record scratch.

        The three per-record scratch sets never overlap.  ``charge_read`` and
        ``charge_revalidation`` release in their own ``finally`` before the next
        read or the final detach begins; ``_verify_borrowed_documents`` runs
        before the pair claim is taken and cannot run while a borrow token is
        active; and the pair probe streams inside the claim it already holds.
        The concurrent upper is therefore the largest of the three, not the sum.
        """
        read_scratch = cls.TEMPORARY_READ_SCRATCH_MULTIPLIER * maximum_record_bytes
        encoder_scratch = cls._stream_scratch_upper(maximum_record_bytes)
        probe_scratch = (
            cls.PAIR_PROBE_BYTES_MULTIPLIER * maximum_record_bytes
            + encoder_scratch
        )
        return (
            cls.TEMPORARY_BASE_BYTES
            + cls.PAIR_PROBE_TEMPORARY_BASE_BYTES
            + cls._pair_builder_temporary_upper(record_count)
            + cls._ordered_projection_upper(record_count)
            + cls.TEMPORARY_RECORD_BYTES * record_count
            + max(read_scratch, encoder_scratch, probe_scratch)
        )

    @classmethod
    def allocation_upper(
        cls,
        record_count_upper: int,
        aggregate_bytes_upper: int,
        maximum_record_bytes_upper: int,
    ) -> tuple[int, int]:
        record_count = cls._checked_bound(record_count_upper, "record count upper")
        aggregate_bytes = cls._checked_bound(
            aggregate_bytes_upper, "aggregate byte upper"
        )
        maximum_record_bytes = cls._checked_bound(
            maximum_record_bytes_upper, "maximum record byte upper"
        )
        if maximum_record_bytes > aggregate_bytes:
            raise CFError(
                "HTTP upload sealed-validation maximum record upper exceeds aggregate upper"
            )
        if record_count == 0 and (aggregate_bytes or maximum_record_bytes):
            raise CFError(
                "HTTP upload sealed-validation empty record bound has nonzero bytes"
            )
        retained = cls.concurrent_retained_upper(
            record_count, aggregate_bytes, maximum_record_bytes
        )
        temporary = cls.concurrent_temporary_upper(
            record_count, maximum_record_bytes
        )
        if retained > U64_MAX or temporary > U64_MAX:
            raise CFError("HTTP upload sealed-validation allocation upper overflows u64")
        return retained, temporary

    @classmethod
    def _from_acquired(
        cls,
        ledger: DecisionWorkLedger,
        objects_root: Path,
        head: str,
        record_count_upper: int,
        aggregate_bytes_upper: int,
        maximum_record_bytes_upper: int,
        retained_upper: int,
        temporary_upper: int,
        scalar_owner: Any,
        deadline: HTTPRequestDeadline | None,
        semantic_baseline_owner: AccountedHTTPUploadSemantic | None,
        semantic_baseline_proof: tuple[Any, ...] | None,
    ) -> tuple[
        "AccountedHTTPUploadSealedValidation | None", BaseException | None
    ]:
        owner = object.__new__(cls)
        owner._ledger = ledger
        owner._construction_epoch = ledger._mutation_epoch
        owner._objects_root = objects_root
        owner._head = head
        owner._deadline = deadline
        owner._record_count_upper = record_count_upper
        owner._aggregate_bytes_upper = aggregate_bytes_upper
        owner._maximum_record_bytes_upper = maximum_record_bytes_upper
        owner._observed_records = 0
        owner._observed_aggregate_bytes = 0
        owner._source_sizes = {}
        owner._claimed_memory = {"retained_bytes": 0, "temporary_bytes": 0}
        # High-water of the covered pool.  The concurrent reservation above is
        # only honest if this stays under it, so keep it observable.
        owner._claimed_memory_peak = {"retained_bytes": 0, "temporary_bytes": 0}
        owner._coverage_retained_upper = retained_upper
        owner._coverage_temporary_upper = temporary_upper
        # The same fixed owner that held the permit before consume remains the
        # sole scalar owner for the lifetime of this payload owner.  There is
        # no post-consume numeric hand-off window.
        owner._scalar_owner = scalar_owner
        owner._semantic_baseline_owner = semantic_baseline_owner
        owner._semantic_baseline_proof = semantic_baseline_proof
        owner._validated = False
        owner._borrow_generation = 0
        owner._active_borrow_token = 0
        owner._borrow_failed = False
        owner._borrow_releasing = False
        owner._borrow_reading = False
        owner._upload_terminal_active = False
        owner._upload_terminal_owner = None
        owner._pair_probe_transition = None
        owner._pair_probe_documents = None
        owner._pair_probe_borrowed_documents = None
        owner._pair_probe_scratch = None
        owner._pair_probe_retained = 0
        owner._pair_probe_temporary = 0
        owner._pair_probe_root_slot = None
        owner._pair_probe_file_slot = None
        owner._pair_probe_subdir_slots = None
        owner._pair_probe_prepared = False
        owner._root_proof = None
        owner._root_proof_bytes = 0
        owner._pair_detached = False
        owner._pair_cleanup_session = None
        owner._closed = False
        owner._closing = False
        owner._finishing = False
        owner._session = None
        # Publish the collection before either handle allocator so a partial
        # constructor always remains closeable by the scalar retry owner.
        owner._borrow_handles: dict[str, _HTTPUploadSealedCommitBorrow] = {}
        failure: BaseException | None = None
        try:
            owner._borrow_handles["signature"] = _HTTPUploadSealedCommitBorrow(
                owner, "signature"
            )
            owner._borrow_handles["ancestry"] = _HTTPUploadSealedCommitBorrow(
                owner, "ancestry"
            )
            owner._poll()
            session_type = SealedCommitValidationSession
            owner._session = session_type.__new__(session_type)
            session_type.__init__(
                owner._session, objects_root, ledger, memory_owner=owner
            )
        except BaseException as exc:
            failure = cls._detach_failure(exc)
        if failure is not None:
            # The partial session is reachable only from the detached
            # construction traceback. The separate scalar retry owner retains
            # the acquired upper until construction succeeds.
            owner._source_sizes.clear()
            owner._objects_root = None
            owner._head = None
            owner._deadline = None
            return owner, failure
        return owner, None

    def _ensure_ledger(self, ledger: DecisionWorkLedger) -> None:
        if ledger is not self._ledger:
            raise CFError("HTTP upload sealed validation belongs to a different ledger")

    def _ensure_open(self, ledger: DecisionWorkLedger) -> None:
        self._ensure_ledger(ledger)
        if self._closed:
            raise CFError("HTTP upload sealed validation owner is closed")

    def _ensure_upload_terminal_access(
        self,
        owner: Any | None,
        expected_registry: Any | None = None,
    ) -> None:
        ledger_bound = self._ledger._upload_terminal_owner
        bound = self._upload_terminal_owner
        if bound is None:
            if (
                type(ledger_bound)
                is AccountedHTTPUploadSignatureVerificationComposite
                and object.__getattribute__(ledger_bound, "_sealed_owner") is self
            ) or (
                type(ledger_bound) is AccountedHTTPUploadExistingTerminalOwner
                and object.__getattribute__(ledger_bound, "_sealed_owner") is self
            ):
                raise CFError("upload terminal composite owns sealed authority")
            return
        if bound is not owner:
            raise CFError("upload terminal composite owns sealed authority")
        registry_owner = owner if expected_registry is None else expected_registry
        if ledger_bound is not None and ledger_bound is not registry_owner:
            raise CFError("upload terminal composite owns sealed authority")

    def _poll(self) -> None:
        if self._deadline is not None:
            self._deadline.check("upload sealed validation")

    def _observe_record(self, physical_bytes: int) -> None:
        if physical_bytes < 0:
            raise CFError("HTTP upload sealed validation observed a negative record size")
        # Filesystem-backed records were charged before their first DFS frame
        # or root-key list. In-memory test overlays have no source stat and are
        # bounded here before their borrowed payload is retained.
        next_records = self._observed_records + 1
        next_bytes = self._observed_aggregate_bytes + physical_bytes
        if next_records > self._record_count_upper:
            raise CFError("HTTP upload sealed validation exceeded its record-count upper")
        if physical_bytes > self._maximum_record_bytes_upper:
            raise CFError("HTTP upload sealed validation exceeded its record-size upper")
        if next_bytes > self._aggregate_bytes_upper:
            raise CFError("HTTP upload sealed validation exceeded its aggregate-byte upper")
        self._observed_records = next_records
        self._observed_aggregate_bytes = next_bytes

    def _preflight_source(
        self, session: SealedCommitValidationSession, object_id: str
    ) -> None:
        if object_id in self._source_sizes or object_id in session.documents:
            return
        try:
            subdir, file_name = session._object_location(object_id)
            directory_fd = session._subdir_fd(subdir)
            metadata = os.stat(file_name, dir_fd=directory_fd, follow_symlinks=False)
        except (CFError, OSError):
            # Semantic lookup owns invalid/missing precedence. Bounds preflight
            # must not convert those cases into a different diagnostic.
            return
        if (
            not stat.S_ISREG(metadata.st_mode)
            or metadata.st_nlink != 1
            or metadata.st_size < 0
            or metadata.st_size > MAX_OBJECT_RECORD_BYTES
        ):
            # Preserve the legacy identity/oversize diagnostic. Only a source
            # that the real reader could admit may consume a caller upper.
            return
        physical_bytes = metadata.st_size
        self._observe_record(physical_bytes)
        self._source_sizes[object_id] = physical_bytes

    def _observe_loaded_record(self, object_id: str, physical_bytes: int) -> None:
        expected = self._source_sizes.get(object_id)
        if expected is None:
            self._observe_record(physical_bytes)
            return
        if expected != physical_bytes:
            subdir, file_name = exact_object_record_location(object_id)
            raise SealedValidationSubjectChanged(
                object_id,
                self._objects_root / subdir / file_name,
                "size_changed",
                expected,
                physical_bytes,
            )

    def _claim_memory(self, dimension: str, amount: int) -> None:
        if dimension not in self._claimed_memory:
            raise CFError("HTTP upload sealed validation claimed an unknown memory dimension")
        upper = (
            self._coverage_retained_upper
            if dimension == "retained_bytes"
            else self._coverage_temporary_upper
        )
        claimed = self._claimed_memory[dimension] + amount
        if claimed > upper:
            raise CFError(
                f"HTTP upload sealed validation exceeded prepared {dimension}"
            )
        self._claimed_memory[dimension] = claimed
        if claimed > self._claimed_memory_peak[dimension]:
            self._claimed_memory_peak[dimension] = claimed

    def _release_memory_claim(self, dimension: str, amount: int) -> None:
        current = self._claimed_memory.get(dimension)
        if current is None or amount > current:
            raise CFError("HTTP upload sealed validation memory claim underflow")
        self._claimed_memory[dimension] = current - amount

    # The one prepared reservation covers this owner's payload claims and its
    # session's control state alike, so both routes are the same claim path and
    # the claim's phase is already inside the reservation's own accounting.
    def _claim_control_memory(
        self, dimension: str, amount: int, phase: str | None = None
    ) -> None:
        del phase
        self._claim_memory(dimension, amount)

    def _release_control_memory(self, dimension: str, amount: int) -> None:
        self._release_memory_claim(dimension, amount)

    def _control_reservation_outstanding(self, dimension: str) -> int:
        return self.reservation_outstanding(dimension)

    def _control_claim_held(self, dimension: str) -> int:
        return self._claimed_memory.get(dimension, 0)

    def _control_charge_witness(self, dimension: str) -> int:
        # This owner's whole reservation is consumed onto the request ledger
        # before any session allocator runs, so a live claim is already charged.
        return self._claimed_memory.get(dimension, 0)

    def reservation_outstanding(self, dimension: str) -> int:
        """Prepared bytes not yet claimed in ``dimension``.

        Production reads this before every covered allocation, so an allocation
        that no outstanding reservation owns cannot proceed silently.
        """
        claimed = self._claimed_memory.get(dimension)
        if claimed is None:
            raise CFError(
                "HTTP upload sealed validation claimed an unknown memory dimension"
            )
        upper = (
            self._coverage_retained_upper
            if dimension == "retained_bytes"
            else self._coverage_temporary_upper
        )
        return upper - claimed

    def _assert_prepared_coverage(self) -> None:
        """Check the prepared upper really covered this owner, in production.

        ``_claim_memory`` refuses an over-claim as it happens.  This is the same
        invariant from the other side, and it runs on the live route instead of
        only in a test that reads ``_claimed_memory_peak``: at the final fence
        every claim must have been released, every dimension's high-water must
        sit inside the reservation the request admitted, and the covered pool
        must actually have been used -- an owner that claimed nothing would make
        the whole coverage check vacuous.
        """
        for dimension, upper in (
            ("retained_bytes", self._coverage_retained_upper),
            ("temporary_bytes", self._coverage_temporary_upper),
        ):
            if self._claimed_memory[dimension]:
                raise CFError(
                    "HTTP upload sealed validation retains "
                    f"{dimension} debt at its final fence"
                )
            if self._claimed_memory_peak[dimension] > upper:
                raise CFError(
                    "HTTP upload sealed validation peak exceeded its prepared "
                    f"{dimension}"
                )
        if not self._claimed_memory_peak["retained_bytes"]:
            raise CFError(
                "HTTP upload sealed validation claimed no covered retained bytes"
            )

    @staticmethod
    def _detach_failure(failure: BaseException) -> BaseException:
        current: BaseException | None = failure
        while current is not None:
            # Save the effective next link before destructively severing this
            # node.  Clearing each visited link also makes exception cycles
            # terminate without allocating a visited set.
            next_failure = current.__cause__
            if next_failure is None:
                next_failure = current.__context__
            current.__traceback__ = None
            current.__context__ = None
            current.__cause__ = None
            current = next_failure
        return failure

    def validate(self, ledger: DecisionWorkLedger) -> None:
        self._ensure_open(ledger)
        if self._validated:
            raise CFError("HTTP upload sealed validation owner is single-use")
        session = self._session
        if session is None:
            raise CFError("HTTP upload sealed validation session is unavailable")
        failure: BaseException | None = None
        try:
            self._poll()
            session.validate_commit(self._head, poll=self._poll)
            self._poll()
            self._validated = True
        except BaseException as exc:
            failure = self._detach_failure(exc)
        if failure is not None:
            # Leave the exception handler and drop its session local before
            # payload cleanup can release the preaccounted scalar owner.
            session = None
            self.close(ledger)
            raise failure

    def publication_root_proof(
        self, ledger: DecisionWorkLedger, roots: tuple[str, ...]
    ) -> RemoteJSONPublicationRootProof:
        """Certify roots this owner's validated snapshot already covers.

        The proof is derived from ``validated_commits`` -- the set this owner
        filled while traversing the staged closure under the request ledger and
        deadline -- so publication identity and publication preflight consume
        that snapshot instead of traversing the same root again.  The proof
        object itself is claimed against the prepared reservation before it is
        allocated, and released when this owner closes.
        """
        self._ensure_open(ledger)
        self._ensure_upload_terminal_access(None)
        if not self._validated:
            raise CFError("HTTP upload sealed validation has not validated its head")
        if self._finishing:
            raise CFError("HTTP upload sealed validation final fence is active")
        if self._root_proof is not None:
            raise CFError("HTTP upload sealed validation root proof is single-use")
        session = self._session
        if session is None:
            raise CFError("HTTP upload sealed validation session is unavailable")
        ordered = tuple(roots)
        for root in ordered:
            if root not in session.validated_commits:
                raise CFError(
                    "HTTP upload sealed validation did not validate object "
                    f"root {root}"
                )
        self._poll()
        proof_bytes = self.PUBLICATION_PROOF_BYTES + sum(
            len(root.encode("utf-8")) + _CANONICAL_POINTER_BYTES
            for root in ordered
        )
        self._claim_memory("retained_bytes", proof_bytes)
        try:
            proof = RemoteJSONPublicationRootProof(
                self._objects_root, ordered, self._deadline
            )
        except BaseException:
            self._release_memory_claim("retained_bytes", proof_bytes)
            raise
        self._root_proof = proof
        self._root_proof_bytes = proof_bytes
        return proof

    def borrow_commits(
        self,
        ledger: DecisionWorkLedger,
        mode: str,
        *,
        _handoff_owner: Any | None = None,
        _upload_terminal_owner: Any | None = None,
    ) -> _HTTPUploadSealedCommitBorrow:
        """Activate the preallocated callable for one synchronous consumer."""
        self._ensure_open(ledger)
        self._ensure_upload_terminal_access(_upload_terminal_owner)
        if not self._validated:
            raise CFError("HTTP upload sealed validation has not validated its head")
        if self._finishing:
            raise CFError("HTTP upload sealed validation final fence is active")
        if self._borrow_releasing:
            raise CFError("HTTP upload sealed commit borrow release is active")
        if self._borrow_reading:
            raise CFError("HTTP upload sealed commit lookup is active")
        if self._borrow_failed:
            raise CFError("HTTP upload sealed commit borrow owner is abort-only")
        if mode != "signature" and mode != "ancestry":
            raise CFError("HTTP upload sealed commit borrow mode is invalid")
        if self._active_borrow_token:
            raise CFError("HTTP upload sealed commit borrow is already active")
        handle = self._borrow_handles.get(mode)
        if handle is None:
            raise CFError("HTTP upload sealed commit borrow is unavailable")
        if handle._used:
            raise CFError("HTTP upload sealed commit borrow is single-use")
        if _handoff_owner is not None:
            if object.__getattribute__(_handoff_owner, "_borrow") is not None:
                raise CFError("HTTP upload sealed borrow handoff slot is occupied")
            # Destination-first publication closes the activation-return gap.
            # A post-effect activation fault leaves this exact handle under
            # composite cleanup even when it is already revoked/abort-only.
            object.__setattr__(_handoff_owner, "_borrow", handle)
        token = self._borrow_generation + 1
        try:
            handle._activate(token)
        except BaseException as exc:
            failure = self._detach_failure(exc)
            # A failed activation can consume the purpose's single-use bit
            # even when its token was never published. The request cannot
            # prove that mandatory purpose remains available, so only abort
            # may follow either a pre- or post-token failure.
            self._borrow_failed = True
            if handle._token == token:
                # The effect committed but the caller never received the
                # handle. Revoke without another fallible call, make the owner
                # abort-only, and preserve even control-flow BaseExceptions.
                handle._token = 0
                self._active_borrow_token = 0
            raise failure
        self._borrow_generation = token
        self._active_borrow_token = token
        return handle

    def _borrow_mutation_failure(
        self, document: RetainedObjectDocument, actual_size: int | None
    ) -> CFError:
        self._borrow_failed = True
        actual = "unavailable" if actual_size is None else str(actual_size)
        return CFError(
            "HTTP upload sealed borrowed commit changed: "
            f"{document.object_id} (expected {document.borrow_canonical_bytes} "
            f"canonical bytes, actual {actual})"
        )

    @classmethod
    def _stream_scratch_upper(cls, canonical_bytes: int) -> int:
        """Upper on the encoder scratch one streamed record holds at once."""
        return (
            CANONICAL_STREAM_SCRATCH_BYTES
            + CANONICAL_STREAM_KEY_MULTIPLIER * canonical_bytes
        )

    @staticmethod
    def _stream_projection_guard(scratch_bytes: int) -> Any:
        """Prove the claimed encoder scratch owns every key projection.

        The streaming encoder reports the signed delta of each mapping's
        sorted-key list.  Nothing here touches the ledger: the block claim made
        before the first allocation is the outstanding reservation, and this
        guard refuses any projection the claim does not already own.
        """
        outstanding = [0]

        def observe(delta: int) -> None:
            live = outstanding[0] + delta
            if live < 0 or live > scratch_bytes:
                raise CFError(
                    "HTTP upload sealed validation canonical key projection "
                    "exceeded its claimed encoder scratch"
                )
            outstanding[0] = live

        return observe

    def _canonical_borrow_digest(
        self, document: RetainedObjectDocument
    ) -> tuple[int, str]:
        """Fingerprint one retained record under the prepared request upper."""
        expected_upper = document.retained_bytes
        scratch_bytes = self._stream_scratch_upper(expected_upper)
        self._claim_memory("temporary_bytes", scratch_bytes)
        try:
            # Reserve all bounded work before the first traversal/encoder
            # allocation.  This is intentionally separate from the raw-file
            # digest: persisted records are pretty-printed while this seal is
            # over the parsed record's canonical semantic representation.
            self._ledger.apply(
                "snapshot_revalidation",
                charges={"snapshot_revalidation_bytes": expected_upper},
                counters={"bytes_hashed": expected_upper},
            )
            self._poll()
            actual_size = canonical_json_size_up_to(
                document.record, expected_upper, self._poll
            )
            if actual_size != expected_upper:
                raise self._borrow_mutation_failure(document, actual_size)
            self._poll()
            # Stream the canonical form through the hash instead of holding a
            # whole-record encode: the scratch claimed above is a constant plus
            # the key projections, never a multiple of the record.
            streamed_size, digest = canonical_json_stream_digest(
                document.record,
                self._poll,
                self._stream_projection_guard(scratch_bytes),
            )
            self._poll()
            if streamed_size != actual_size:
                raise self._borrow_mutation_failure(document, streamed_size)
            return actual_size, digest
        finally:
            self._release_memory_claim("temporary_bytes", scratch_bytes)

    def _seal_borrowed_document(
        self, document: RetainedObjectDocument, token: int
    ) -> None:
        initial_fingerprint = document.borrow_digest is None
        if initial_fingerprint:
            fingerprint_bytes = self.BORROW_FINGERPRINT_BYTES
            self._claim_memory("retained_bytes", fingerprint_bytes)
            # Publish the destination ownership before the digest allocator.
            document.borrow_fingerprint_bytes = fingerprint_bytes
        try:
            actual_size, digest = self._canonical_borrow_digest(document)
        except BaseException:
            if initial_fingerprint:
                document.borrow_fingerprint_bytes = 0
                self._release_memory_claim("retained_bytes", fingerprint_bytes)
            raise
        if initial_fingerprint:
            try:
                document.borrow_canonical_bytes = actual_size
                document.borrow_digest = digest
            except BaseException:
                document.borrow_canonical_bytes = 0
                document.borrow_digest = None
                document.borrow_fingerprint_bytes = 0
                self._release_memory_claim("retained_bytes", fingerprint_bytes)
                raise
        elif (
            actual_size != document.borrow_canonical_bytes
            or digest != document.borrow_digest
        ):
            raise self._borrow_mutation_failure(document, actual_size)
        document.borrow_token = token

    def _verify_borrowed_documents(self, token: int | None = None) -> None:
        session = self._session
        if session is None:
            raise CFError("HTTP upload sealed validation session is unavailable")
        try:
            for document in session.documents.values():
                if document.borrow_digest is None:
                    continue
                if token is not None and document.borrow_token != token:
                    continue
                self._seal_borrowed_document(document, document.borrow_token)
        except BaseException:
            self._borrow_failed = True
            raise

    def _final_detach_borrowed_documents(self) -> None:
        """Verify and detach borrowed authority without a post-read callback."""
        session = self._session
        if session is None:
            raise CFError("HTTP upload sealed validation session is unavailable")
        while True:
            selected: RetainedObjectDocument | None = None
            for document in session.documents.values():
                if document.borrow_digest is not None:
                    selected = document
                    break
            if selected is None:
                return
            expected_size = selected.borrow_canonical_bytes
            scratch_bytes = self._stream_scratch_upper(selected.retained_bytes)
            self._claim_memory("temporary_bytes", scratch_bytes)
            try:
                # All fallible accounting and cooperative interruption happen
                # before the final critical read. No callback may mutate the
                # raw alias after this canonical snapshot and before the
                # corresponding document is removed from session authority.
                self._ledger.apply(
                    "snapshot_revalidation",
                    charges={"snapshot_revalidation_bytes": selected.retained_bytes},
                    counters={"bytes_hashed": selected.retained_bytes},
                )
                self._poll()
                actual_size = canonical_json_size_up_to(
                    selected.record, selected.retained_bytes, None
                )
                if actual_size != expected_size:
                    raise self._borrow_mutation_failure(selected, actual_size)
                streamed_size, digest = canonical_json_stream_digest(
                    selected.record, None, None
                )
                if streamed_size != actual_size:
                    raise self._borrow_mutation_failure(selected, streamed_size)
                if digest != selected.borrow_digest:
                    raise self._borrow_mutation_failure(selected, actual_size)
                object_id = selected.object_id
                selected.borrow_token = 0
                del session.documents[object_id]
                session.validated_commits.discard(object_id)
                # The fingerprint was claimed for as long as this document was
                # borrowable authority.  It is not, any more.
                fingerprint_bytes = selected.borrow_fingerprint_bytes
                if fingerprint_bytes:
                    selected.borrow_fingerprint_bytes = 0
                    selected.borrow_digest = None
                    selected.borrow_canonical_bytes = 0
                    self._release_memory_claim(
                        "retained_bytes", fingerprint_bytes
                    )
            finally:
                selected = None
                self._release_memory_claim("temporary_bytes", scratch_bytes)

    def _borrow_commit(
        self,
        handle: _HTTPUploadSealedCommitBorrow,
        token: int,
        mode: str | None,
        object_id: str,
    ) -> Any:
        self._ensure_open(self._ledger)
        if self._borrow_reading:
            raise CFError("HTTP upload sealed commit lookup is already active")
        if (
            handle is not self._borrow_handles.get(mode)
            or not token
            or token != self._active_borrow_token
        ):
            raise CFError("HTTP upload sealed commit borrow is revoked")
        self._borrow_reading = True
        try:
            if not isinstance(object_id, str) or not object_id.startswith("CF-COMMIT-"):
                raise CFError("HTTP upload sealed commit borrow requires a commit object ID")
            session = self._session
            if session is None or object_id not in session.validated_commits:
                raise CFError(
                    "HTTP upload sealed commit borrow is outside validated authority"
                )
            document = session.documents.get(object_id)
            if document is None:
                raise CFError("HTTP upload sealed commit is not retained by its session")
            if document.path is None or document.digest is None:
                raise CFError(
                    "HTTP upload sealed commit borrow requires pinned filesystem authority"
                )
            self._seal_borrowed_document(document, token)
            # Fingerprinting contains deadline/accounting callbacks. Recheck
            # every authority component before obtaining the raw payload, so
            # no revoked lookup can complete even under an injected callback.
            if (
                handle is not self._borrow_handles.get(mode)
                or handle._token != token
                or token != self._active_borrow_token
            ):
                raise CFError("HTTP upload sealed commit borrow is revoked")
            payload = document.record.get("payload")
            if not isinstance(payload, dict) or payload.get("type") != "commit":
                payload = None
                raise CFError("HTTP upload sealed retained commit is invalid")
            if mode == "signature":
                return payload, document.retained_bytes
            if mode == "ancestry":
                return payload
            payload = None
            raise CFError("HTTP upload sealed commit borrow is revoked")
        finally:
            self._borrow_reading = False

    def _release_commit_borrow(
        self,
        handle: _HTTPUploadSealedCommitBorrow,
        token: int,
        ledger: DecisionWorkLedger | None,
    ) -> None:
        selected = self._ledger if ledger is None else ledger
        self._ensure_ledger(selected)
        if self._borrow_reading:
            raise CFError("HTTP upload sealed commit lookup is active")
        if self._borrow_releasing:
            raise CFError("HTTP upload sealed commit borrow release is already active")
        if handle is not self._borrow_handles.get(handle._mode):
            raise CFError("HTTP upload sealed commit borrow has a foreign owner")
        self._borrow_releasing = True
        try:
            if token and token == self._active_borrow_token:
                # Revoke in the owner first. A retry after interruption can
                # safely clear the stale handle token without reopening
                # authority. The release single-flight blocks another purpose
                # from entering during deadline/accounting callbacks.
                self._active_borrow_token = 0
            verification_failure: BaseException | None = None
            try:
                if token:
                    self._verify_borrowed_documents(token)
            except BaseException as exc:
                verification_failure = self._detach_failure(exc)
            revoke_failure: BaseException | None = None
            try:
                handle._revoke(self)
            except BaseException as exc:
                revoke_failure = self._detach_failure(exc)
            if revoke_failure is not None:
                raise revoke_failure
            if verification_failure is not None:
                raise verification_failure
        finally:
            self._borrow_releasing = False

    def finish(self, ledger: DecisionWorkLedger) -> None:
        self._ensure_open(ledger)
        self._ensure_upload_terminal_access(None)
        if self._upload_terminal_active:
            raise CFError("sealed signature handoff is active")
        if self._finishing:
            raise CFError("HTTP upload sealed validation final fence is already active")
        if self._borrow_releasing:
            raise CFError("HTTP upload sealed commit borrow release is active")
        if not self._validated:
            raise CFError("HTTP upload sealed validation has not validated its head")
        if self._active_borrow_token:
            raise CFError("HTTP upload sealed commit borrow is still active")
        if self._borrow_failed:
            raise CFError("HTTP upload sealed commit borrow owner is abort-only")
        session = self._session
        if session is None:
            raise CFError("HTTP upload sealed validation session is unavailable")
        failure: BaseException | None = None
        self._finishing = True
        try:
            self._poll()
            self._verify_borrowed_documents()
            self._poll()
            session.finalize(
                terminate=False,
                poll=self._poll,
                retain_documents=True,
            )
            self._final_detach_borrowed_documents()
            session.close(None)
            # The proof certified a snapshot this fence has now re-proven and
            # released, so it is revoked here rather than at cleanup, which lets
            # the coverage invariant below see a fully settled pool.
            root_proof = self._root_proof
            if root_proof is not None:
                root_proof.revoke()
                self._root_proof = None
            self._release_pair_claim("retained_bytes", "_root_proof_bytes")
            self._assert_prepared_coverage()
        except BaseException as exc:
            failure = self._detach_failure(exc)
        session = None
        self._finishing = False
        self.close(ledger)
        if failure is not None:
            raise failure

    def _prepare_upload_terminal_pair(
        self,
        owner: Any,
        expected_registry: Any | None = None,
    ) -> None:
        """Run callback-rich sealed work and precharge the final probe."""
        self._ensure_open(self._ledger)
        self._ensure_upload_terminal_access(owner, expected_registry)
        if self._pair_probe_prepared or self._pair_detached:
            raise CFError("HTTP upload sealed pair preparation is single-use")
        if self._borrow_releasing or self._borrow_reading:
            raise CFError("HTTP upload sealed pair preparation overlaps a consumer")
        if not self._validated or self._active_borrow_token or self._borrow_failed:
            raise CFError("HTTP upload sealed pair preparation is unavailable")
        session = self._session
        if session is None:
            raise CFError("HTTP upload sealed validation session is unavailable")

        self._poll()
        self._verify_borrowed_documents()
        self._poll()

        document_count = len(session.documents)
        borrowed_count = sum(
            1
            for document in session.documents.values()
            if document.borrow_digest is not None
        )
        subdir_count = len(session._subdir_fds)
        pointer_bytes = sys.getsizeof((None,)) - sys.getsizeof(tuple())
        slot_count = subdir_count + 2
        slot_bytes = slot_count * sys.getsizeof(object.__new__(_CallbackFreeFD))
        plan_bytes = (
            2 * sys.getsizeof(tuple())
            + pointer_bytes * (document_count + borrowed_count)
            + sys.getsizeof(tuple())
            + pointer_bytes * subdir_count
            + sys.getsizeof((None, None, None)) * subdir_count
            + slot_bytes
        )
        if plan_bytes > self._pair_plan_upper(self._record_count_upper):
            raise CFError("HTTP upload sealed pair plan exceeded its retained upper")
        maximum_physical = 0
        maximum_canonical_scratch = 0
        disk_bytes = 0
        disk_document_count = 0
        borrowed_bytes = 0
        for document in session.documents.values():
            if document.path is not None:
                disk_document_count += 1
                disk_bytes += document.physical_bytes
                maximum_physical = max(maximum_physical, document.physical_bytes)
            if document.borrow_digest is not None:
                borrowed_bytes += document.retained_bytes
                maximum_canonical_scratch = max(
                    maximum_canonical_scratch,
                    self._stream_scratch_upper(document.retained_bytes),
                )
        temporary_bytes = (
            self.PAIR_PROBE_TEMPORARY_BASE_BYTES
            + self._pair_builder_temporary_upper(document_count)
            + maximum_physical
            + maximum_canonical_scratch
        )
        self._claim_memory("retained_bytes", plan_bytes)
        self._pair_probe_retained = plan_bytes
        self._claim_memory("temporary_bytes", temporary_bytes)
        self._pair_probe_temporary = temporary_bytes
        ordered_documents = list(session.documents)
        _sort_strings_polling(ordered_documents, self._poll)
        for index, object_id in enumerate(ordered_documents):
            ordered_documents[index] = session.documents[object_id]
        self._pair_probe_documents = tuple(ordered_documents)
        ordered_documents = None
        borrowed_documents = [None] * borrowed_count
        borrowed_index = 0
        for document in session.documents.values():
            if document.borrow_digest is not None:
                borrowed_documents[borrowed_index] = document
                borrowed_index += 1
        self._pair_probe_borrowed_documents = tuple(borrowed_documents)
        borrowed_documents = None
        self._pair_probe_scratch = bytearray(maximum_physical)
        self._pair_probe_root_slot = _CallbackFreeFD()
        self._pair_probe_file_slot = _CallbackFreeFD()
        subdir_slots = [None] * subdir_count
        for index, (subdir, retained_owner) in enumerate(
            session._subdir_fds.items()
        ):
            subdir_slots[index] = (subdir, retained_owner, _CallbackFreeFD())
        self._pair_probe_subdir_slots = tuple(subdir_slots)
        subdir_slots = None

        total_bytes = disk_bytes + borrowed_bytes
        total_records = disk_document_count
        if total_bytes or total_records:
            transition = _StablePermitTransition(self._ledger)
            self._pair_probe_transition = transition
            charges: dict[str, int] = {}
            counters: dict[str, int] = {}
            if total_records:
                charges["snapshot_revalidation_records"] = total_records
                counters["snapshot_revalidation_records"] = total_records
            if total_bytes:
                charges["snapshot_revalidation_bytes"] = total_bytes
                counters["bytes_hashed"] = total_bytes
            if disk_bytes:
                counters["snapshot_revalidation_bytes"] = disk_bytes
            if disk_document_count:
                counters["files_read"] = disk_document_count
                counters["file_bytes_read"] = disk_bytes
            transition.reserve(
                "snapshot_revalidation",
                charges=charges,
                counters=counters,
            )
            transition.consume(
                phase="snapshot_revalidation",
                charges=charges,
                counters=counters,
            )
        self._poll()
        object.__setattr__(self, "_pair_probe_prepared", True)

    @staticmethod
    def _pair_changed(
        document: RetainedObjectDocument,
        reason: str,
        actual: int | None,
    ) -> SealedValidationSubjectChanged:
        return SealedValidationSubjectChanged(
            document.object_id,
            document.path,
            reason,
            document.physical_bytes,
            actual,
        )

    def _probe_upload_terminal_pair(
        self,
        owner: Any,
        expected_registry: Any,
        store_probe: Any,
        pair_changed: Any,
        borrow_mutation_failure: Any,
        fd_open: Any,
        fd_close: Any,
    ) -> None:
        """Callback-free sealed half of the terminal pair decision."""
        if object.__getattribute__(self, "_closed"):
            raise CFError("HTTP upload sealed validation owner is closed")
        if (
            object.__getattribute__(self, "_upload_terminal_owner") is not owner
            or object.__getattribute__(
                object.__getattribute__(self, "_ledger"),
                "_upload_terminal_owner",
            )
            is not expected_registry
        ):
            raise CFError("upload terminal composite owns sealed authority")
        if not self._pair_probe_prepared or self._pair_detached:
            raise CFError("HTTP upload sealed pair probe is unavailable")
        session = self._session
        documents = self._pair_probe_documents
        borrowed_documents = self._pair_probe_borrowed_documents
        scratch = self._pair_probe_scratch
        if (
            session is None
            or documents is None
            or borrowed_documents is None
            or scratch is None
        ):
            raise CFError("HTTP upload sealed pair probe is unavailable")

        # Borrowed mutable aliases are the first sealed diagnostic, matching
        # finish().  No accounting/deadline callback occurs from here through
        # the policy probe and both commits.
        for document in borrowed_documents:
            actual_size = canonical_json_size_up_to(
                document.record, document.retained_bytes, None
            )
            if actual_size != document.borrow_canonical_bytes:
                raise borrow_mutation_failure(self, document, actual_size)
            streamed_size, streamed_digest = canonical_json_stream_digest(
                document.record, None, None
            )
            if (
                streamed_size != actual_size
                or streamed_digest != document.borrow_digest
            ):
                raise borrow_mutation_failure(self, document, actual_size)

        store_probe(self, session, fd_open, fd_close)
        for document in documents:
            if document.path is None:
                continue
            retained_subdir = object.__getattribute__(
                session, "_subdir_fds"
            ).get(document.subdir)
            if retained_subdir is None:
                raise CFError("HTTP upload sealed pair subdirectory is unavailable")
            directory_fd = object.__getattribute__(retained_subdir, "_fd")
            if directory_fd < 0:
                raise CFError("HTTP upload sealed pair subdirectory is unavailable")
            file_slot = self._pair_probe_file_slot
            if file_slot is None:
                raise CFError("HTTP upload sealed pair file slot is unavailable")
            descriptor = -1
            view: memoryview | None = None
            try:
                initial = _CODEFIRE_OS_STAT(
                    document.file_name,
                    dir_fd=directory_fd,
                    follow_symlinks=False,
                )
                descriptor = fd_open(
                    file_slot,
                    document.file_name,
                    os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0),
                    dir_fd=directory_fd,
                )
                opened = _CODEFIRE_OS_FSTAT(descriptor)
                opened_identity = (opened.st_dev, opened.st_ino)
                if (
                    not stat.S_ISREG(initial.st_mode)
                    or not stat.S_ISREG(opened.st_mode)
                    or initial.st_nlink != 1
                    or opened.st_nlink != 1
                    or (initial.st_dev, initial.st_ino) != opened_identity
                    or opened_identity != document.identity
                    or initial.st_size != opened.st_size
                    or opened.st_size != document.physical_bytes
                ):
                    raise pair_changed(document, "identity_changed", opened.st_size)
                _CODEFIRE_OS_LSEEK(descriptor, 0, os.SEEK_SET)
                view = memoryview(scratch)
                offset = 0
                while offset < document.physical_bytes:
                    read = _CODEFIRE_OS_READV(
                        descriptor,
                        [view[offset:document.physical_bytes]],
                    )
                    if not read:
                        break
                    offset += read
                extension = _CODEFIRE_OS_READ(descriptor, 1)
                after = _CODEFIRE_OS_FSTAT(descriptor)
                named = _CODEFIRE_OS_STAT(
                    document.file_name,
                    dir_fd=directory_fd,
                    follow_symlinks=False,
                )
                if (
                    offset != document.physical_bytes
                    or extension
                    or (after.st_dev, after.st_ino) != document.identity
                    or (named.st_dev, named.st_ino) != document.identity
                    or after.st_nlink != 1
                    or named.st_nlink != 1
                    or after.st_size != document.physical_bytes
                    or named.st_size != document.physical_bytes
                ):
                    raise pair_changed(document, "size_changed", named.st_size)
                if hashlib.sha256(view[:offset]).hexdigest() != document.digest:
                    raise pair_changed(document, "digest_changed", offset)
            except SealedValidationSubjectChanged:
                raise
            except OSError as error:
                raise pair_changed(document, "unreadable", None) from error
            finally:
                view = None
                if descriptor >= 0:
                    fd_close(file_slot)
        store_probe(self, session, fd_open, fd_close)

    def _probe_pair_store(
        self,
        session: SealedCommitValidationSession,
        fd_open: Any,
        fd_close: Any,
    ) -> None:
        """Revalidate retained and ambient store FDs without callbacks."""
        def changed(path: Path) -> SealedValidationSubjectChanged:
            return SealedValidationSubjectChanged(
                "<object-store>", path, "store_identity_changed", 0, None
            )

        root_owner = object.__getattribute__(session, "_root_fd_owner")
        root_fd = object.__getattribute__(root_owner, "_fd")
        root_identity = object.__getattribute__(session, "_root_identity")
        objects_root = object.__getattribute__(session, "objects_root")
        subdir_fds = object.__getattribute__(session, "_subdir_fds")
        root_slot = self._pair_probe_root_slot
        subdir_slots = self._pair_probe_subdir_slots
        if root_slot is None or subdir_slots is None:
            raise CFError("HTTP upload sealed pair store slots are unavailable")
        try:
            root_metadata = _CODEFIRE_OS_FSTAT(root_fd)
            if (
                root_fd < 0
                or (
                    root_metadata.st_dev,
                    root_metadata.st_ino,
                )
                != root_identity
            ):
                raise changed(objects_root)
        except OSError as error:
            raise changed(objects_root) from error
        for subdir, retained_owner in subdir_fds.items():
            retained_fd = object.__getattribute__(retained_owner, "_fd")
            retained_identity = object.__getattribute__(retained_owner, "_identity")
            try:
                actual = _CODEFIRE_OS_FSTAT(retained_fd)
            except OSError as error:
                raise changed(objects_root / subdir) from error
            if (actual.st_dev, actual.st_ino) != retained_identity:
                raise changed(objects_root / subdir)

        flags = os.O_RDONLY | getattr(os, "O_DIRECTORY", 0) | getattr(
            os, "O_NOFOLLOW", 0
        )
        ambient_root = -1
        try:
            ambient_root = fd_open(root_slot, objects_root, flags)
            actual_root = _CODEFIRE_OS_FSTAT(ambient_root)
            if (actual_root.st_dev, actual_root.st_ino) != root_identity:
                raise changed(objects_root)
            for subdir, retained_owner, slot in subdir_slots:
                ambient_subdir = fd_open(
                    slot,
                    subdir, flags, dir_fd=ambient_root
                )
                actual = _CODEFIRE_OS_FSTAT(ambient_subdir)
                if (
                    actual.st_dev,
                    actual.st_ino,
                ) != object.__getattribute__(retained_owner, "_identity"):
                    raise changed(objects_root / subdir)
                fd_close(slot)
        except SealedValidationSubjectChanged:
            raise
        except OSError as error:
            raise changed(objects_root) from error
        finally:
            for _subdir, _retained_owner, slot in subdir_slots:
                fd_close(slot)
            fd_close(root_slot)

    def _commit_upload_terminal_pair(self, owner: Any) -> None:
        """Detach logical sealed authority with field assignments only."""
        session = object.__getattribute__(self, "_session")
        object.__setattr__(session, "finalized", True)
        object.__setattr__(self, "_pair_cleanup_session", session)
        object.__setattr__(self, "_session", None)
        object.__setattr__(self, "_pair_detached", True)
        object.__setattr__(self, "_pair_probe_prepared", False)

    def _release_pair_claim(self, dimension: str, attribute: str) -> None:
        amount = object.__getattribute__(self, attribute)
        if not amount:
            return
        before = self._claimed_memory.get(dimension, 0)
        try:
            self._release_memory_claim(dimension, amount)
            object.__setattr__(self, attribute, 0)
        except BaseException:
            after = self._claimed_memory.get(dimension, 0)
            if before >= amount and after == before - amount:
                object.__setattr__(self, attribute, 0)
            raise

    def close(
        self,
        ledger: DecisionWorkLedger,
        *,
        _upload_terminal_owner: Any | None = None,
        _upload_terminal_registry: Any | None = None,
    ) -> None:
        self._ensure_upload_terminal_access(
            _upload_terminal_owner,
            _upload_terminal_registry,
        )
        if self._closed:
            self._ensure_ledger(ledger)
            return
        self._ensure_ledger(ledger)
        if self._closing:
            return
        if (
            self._finishing
            or self._borrow_releasing
            or self._borrow_reading
            or self._upload_terminal_active
        ):
            # Abort remains available after the outer release attempt exits;
            # do not tear down document or scalar ownership from a
            # deadline/accounting callback while fingerprint/final-fence
            # locals are live. finish clears its flag before its own close.
            return
        self._closing = True
        completed = False
        try:
            self._finishing = False
            self._borrow_releasing = False
            self._borrow_reading = False
            borrow_handles = self._borrow_handles
            self._active_borrow_token = 0
            for borrow_handle in borrow_handles.values():
                borrow_handle._detach(self)
            borrow_handles.clear()
            file_slot = self._pair_probe_file_slot
            if file_slot is not None:
                file_slot.close()
            root_slot = self._pair_probe_root_slot
            if root_slot is not None:
                root_slot.close()
            subdir_slots = self._pair_probe_subdir_slots
            if subdir_slots is not None:
                for _subdir, _retained_owner, slot in subdir_slots:
                    slot.close()
            self._pair_probe_file_slot = None
            self._pair_probe_root_slot = None
            self._pair_probe_subdir_slots = None
            session = (
                self._session
                if self._session is not None
                else self._pair_cleanup_session
            )
            if session is not None:
                close_session = getattr(session, "close", None)
                if close_session is not None:
                    close_session(None)
                self._session = None
                self._pair_cleanup_session = None
            close_session = None
            session = None
            borrow_handle = None
            self._pair_probe_documents = None
            self._pair_probe_borrowed_documents = None
            self._pair_probe_scratch = None
            file_slot = None
            root_slot = None
            subdir_slots = None
            slot = None
            _subdir = None
            _retained_owner = None
            self._release_pair_claim(
                "retained_bytes", "_pair_probe_retained"
            )
            self._release_pair_claim(
                "temporary_bytes", "_pair_probe_temporary"
            )
            # The proof certifies a snapshot that no longer exists once this owner
            # closes, so it stops being consumable at the same instant its bytes
            # are released.
            root_proof = self._root_proof
            if root_proof is not None:
                root_proof.revoke()
                self._root_proof = None
            self._release_pair_claim("retained_bytes", "_root_proof_bytes")
            root_proof = None
            if self._pair_probe_transition is not None:
                self._pair_probe_transition.release_all()
                self._pair_probe_transition = None
            self._source_sizes.clear()
            self._head = None
            self._objects_root = None
            self._deadline = None
            self._claimed_memory["retained_bytes"] = 0
            self._claimed_memory["temporary_bytes"] = 0
            if self._scalar_owner is not None:
                proof = self._semantic_baseline_proof
                if proof is not None and (
                    not AccountedHTTPUploadSealedValidation
                    ._semantic_baseline_intact(proof, require_current=False)
                    or self._scalar_owner._retained_baseline
                    != tuple.__getitem__(proof, 10)
                    or self._scalar_owner._temporary_baseline
                    != tuple.__getitem__(proof, 11)
                ):
                    raise CFError(
                        "HTTP upload sealed semantic baseline changed before cleanup"
                    )
                self._scalar_owner.close()
                self._scalar_owner = None
            self._semantic_baseline_owner = None
            self._semantic_baseline_proof = None
            completed = True
        finally:
            if completed:
                self._closed = True
            self._closing = False

    def __del__(self) -> None:
        try:
            self.close(self._ledger)
        except BaseException:
            pass


class AccountedHTTPUploadSignatureVerificationComposite:
    """Own the sealed-to-signature-to-verification prerequisite handoff.

    Construction transfers the two parent owners to this production-unwired
    controller.  Callers must not use stale parent aliases.  ``prepare`` lends
    the sealed owner's exact preallocated signature handle and revokes it
    before any verification child can be constructed or published.
    """

    def __init__(
        self,
        sealed_owner: AccountedHTTPUploadSealedValidation,
        policy_authority: AccountedRemoteSignaturePolicyAuthority,
        ledger: DecisionWorkLedger,
    ) -> None:
        if not isinstance(sealed_owner, AccountedHTTPUploadSealedValidation):
            raise CFError("signature verification composite requires a sealed owner")
        if not isinstance(
            policy_authority, AccountedRemoteSignaturePolicyAuthority
        ):
            raise CFError(
                "signature verification composite requires a policy authority"
            )
        sealed_owner._ensure_open(ledger)
        policy_authority._ensure_open(ledger)
        if sealed_owner._deadline is not policy_authority._deadline:
            raise CFError(
                "signature verification composite requires the same deadline"
            )
        if not sealed_owner._validated:
            raise CFError(
                "signature verification composite requires validated authority"
            )
        if sealed_owner._upload_terminal_active:
            raise CFError("signature verification composite is already active")
        if policy_authority._policy_bound or policy_authority._verification_bound:
            raise CFError(
                "signature verification composite requires an unused policy authority"
            )
        if (
            sealed_owner._upload_terminal_owner is not None
            or policy_authority._upload_terminal_owner is not None
            or ledger._upload_terminal_owner is not None
        ):
            raise CFError("signature verification composite already owns a parent")
        self._ledger = ledger
        self._sealed_owner: AccountedHTTPUploadSealedValidation | None = sealed_owner
        self._policy_authority: AccountedRemoteSignaturePolicyAuthority | None = (
            policy_authority
        )
        self._signature_borrow: _HTTPUploadSealedCommitBorrow | None = None
        self._used = False
        self._operating = False
        self._closing = False
        self._abort_only = False
        self._closed = False
        self._binding = True
        bind_failure: BaseException | None = None
        try:
            object.__setattr__(ledger, "_upload_terminal_owner", self)
            object.__setattr__(sealed_owner, "_upload_terminal_owner", self)
            object.__setattr__(policy_authority, "_upload_terminal_owner", self)
        except BaseException as error:
            _detach_exception_chain(error)
            bind_failure = error
        if bind_failure is not None:
            # The caller cannot receive this controller after constructor
            # failure. Bypass replaceable __setattr__ hooks and roll back only
            # fields whose pre/post-effect assignment published this exact
            # controller, leaving any foreign authority untouched.
            if (
                object.__getattribute__(
                    sealed_owner, "_upload_terminal_owner"
                )
                is self
            ):
                object.__setattr__(
                    sealed_owner, "_upload_terminal_owner", None
                )
            if (
                object.__getattribute__(
                    policy_authority, "_upload_terminal_owner"
                )
                is self
            ):
                object.__setattr__(
                    policy_authority, "_upload_terminal_owner", None
                )
            if object.__getattribute__(ledger, "_upload_terminal_owner") is self:
                object.__setattr__(ledger, "_upload_terminal_owner", None)
            # A failed constructor never transferred parent ownership. Make
            # this unreachable partial controller inert before rethrow so its
            # finalizer cannot later close caller-owned parents.
            object.__setattr__(self, "_policy_authority", None)
            object.__setattr__(self, "_sealed_owner", None)
            object.__setattr__(self, "_closed", True)
            raise bind_failure.with_traceback(None)
        object.__setattr__(self, "_binding", False)

    def _ensure_ledger(self, ledger: DecisionWorkLedger) -> None:
        if ledger is not self._ledger:
            raise CFError(
                "signature verification composite belongs to a different ledger"
            )

    def prepare(
        self,
        branch: str,
        commit_id: str,
        ledger: DecisionWorkLedger,
        *,
        output_limit_bytes: int = 1024 * 1024,
        allow_missing_project: bool = False,
    ) -> "AccountedServerVerification":
        self._ensure_ledger(ledger)
        if self._binding:
            raise CFError("signature verification composite binding is in progress")
        if self._closed:
            raise CFError("signature verification composite is closed")
        if self._used:
            raise CFError("signature verification composite is single-use")
        if self._operating or self._closing:
            raise CFError("signature verification composite is already active")
        sealed_owner = self._sealed_owner
        policy_authority = self._policy_authority
        if sealed_owner is None or policy_authority is None:
            raise CFError("signature verification composite has no parent authority")
        sealed_owner._ensure_open(ledger)
        policy_authority._ensure_open(ledger)
        if sealed_owner._head != commit_id:
            raise CFError(
                "signature verification composite requires the validated head"
            )

        self._used = True
        authority_started = False
        verification_owner: AccountedServerVerification | None = None
        failure: BaseException | None = None
        try:
            # Both operating guards are inside this try so a pre/post-effect
            # __setattr__ or asynchronous exception still enters the
            # callback-free finally rollback below.
            self._operating = True
            sealed_owner._upload_terminal_active = True
            try:
                # Publish finally-cleanup responsibility before the fallible
                # begin call. A wrapper may raise after begin committed its
                # construction guard but before control returns here.
                authority_started = True
                policy_authority._begin_verified_server_verification(
                    branch,
                    commit_id,
                    ledger,
                    _upload_terminal_owner=self,
                )
                expected_borrow = sealed_owner._borrow_handles.get("signature")
                if not isinstance(expected_borrow, _HTTPUploadSealedCommitBorrow):
                    raise CFError(
                        "signature verification composite has no signature borrow"
                    )
                # Publish the exact preallocated cleanup authority before the
                # fallible activation call. A wrapper that raises after the
                # real borrow returned cannot strand the active token.
                self._signature_borrow = expected_borrow
                signature_borrow = sealed_owner.borrow_commits(
                    ledger,
                    "signature",
                    _upload_terminal_owner=self,
                )
                if signature_borrow is not expected_borrow:
                    raise CFError(
                        "signature verification composite received a foreign borrow"
                    )
                verification_owner = (
                    policy_authority._prepare_verified_server_verification_core(
                        signature_borrow,
                        branch,
                        commit_id,
                        output_limit_bytes=output_limit_bytes,
                        allow_missing_project=allow_missing_project,
                        close_loader=True,
                        _upload_terminal_owner=self,
                    )
                )
                if (
                    not isinstance(
                        verification_owner, AccountedServerVerification
                    )
                    or verification_owner
                    is not policy_authority._verification_owner
                ):
                    raise CFError(
                        "signature verification composite received a foreign "
                        "verification owner"
                    )
            except BaseException as error:
                _detach_exception_chain(error)
                failure = error

            cleanup_failure: BaseException | None = None
            signature_borrow = self._signature_borrow
            if (
                signature_borrow is not None
                and object.__getattribute__(signature_borrow, "_token")
            ):
                try:
                    signature_borrow.close(ledger)
                except BaseException as error:
                    _detach_exception_chain(error)
                    cleanup_failure = error
            if signature_borrow is not None:
                borrow_owner = object.__getattribute__(
                    signature_borrow, "_owner"
                )
                release_complete = (
                    borrow_owner is sealed_owner
                    and object.__getattribute__(signature_borrow, "_token") == 0
                    and object.__getattribute__(
                        sealed_owner, "_active_borrow_token"
                    )
                    == 0
                )
                if release_complete:
                    self._signature_borrow = None
                elif cleanup_failure is None:
                    cleanup_failure = CFError(
                        "sealed signature handoff borrow release is incomplete"
                    )
            signature_borrow = None

            if failure is not None or cleanup_failure is not None:
                self._abort_only = True
            if cleanup_failure is not None:
                if failure is not None:
                    raise cleanup_failure.with_traceback(None) from failure
                raise cleanup_failure.with_traceback(None)
            if failure is not None:
                raise failure.with_traceback(None)
            if verification_owner is None:
                self._abort_only = True
                raise CFError(
                    "signature verification composite produced no verification owner"
                )
            return verification_owner
        finally:
            verification_owner = None
            if authority_started:
                # This composite published cleanup responsibility before
                # begin. Clear the two existing guard fields directly so a
                # replaceable helper call cannot introduce a pre-effect
                # cleanup fault that strands the parent forever.
                object.__setattr__(
                    policy_authority, "_verification_handoff_open", False
                )
                object.__setattr__(
                    policy_authority, "_verification_constructing", False
                )
            object.__setattr__(
                sealed_owner, "_upload_terminal_active", False
            )
            object.__setattr__(self, "_operating", False)

    def close(self, ledger: DecisionWorkLedger) -> None:
        self._ensure_ledger(ledger)
        if self._binding:
            raise CFError("signature verification composite binding is in progress")
        if self._closed:
            return
        if self._operating:
            raise CFError("signature verification composite operation is in progress")
        if self._closing:
            raise CFError("signature verification composite cleanup is in progress")
        completed = False
        failure: BaseException | None = None
        try:
            # As with prepare, install the reentry guard only after the
            # finally cleanup region is active.
            self._closing = True
            signature_borrow = self._signature_borrow
            if signature_borrow is not None:
                try:
                    signature_borrow.close(ledger)
                except BaseException as error:
                    _detach_exception_chain(error)
                    failure = error
                if not signature_borrow._token:
                    self._signature_borrow = None
            signature_borrow = None
            if failure is None:
                policy_authority = self._policy_authority
                if policy_authority is not None:
                    try:
                        policy_authority.close(
                            ledger, _upload_terminal_owner=self
                        )
                    except BaseException as error:
                        _detach_exception_chain(error)
                        failure = error
            if failure is None:
                sealed_owner = self._sealed_owner
                if sealed_owner is not None:
                    try:
                        sealed_owner.close(
                            ledger, _upload_terminal_owner=self
                        )
                    except BaseException as error:
                        _detach_exception_chain(error)
                        failure = error
            policy_authority = self._policy_authority
            sealed_owner = self._sealed_owner
            completed = (
                failure is None
                and self._signature_borrow is None
                and (policy_authority is None or policy_authority._closed)
                and (sealed_owner is None or sealed_owner._closed)
            )
            if completed:
                if policy_authority is not None:
                    policy_authority._upload_terminal_owner = None
                if sealed_owner is not None:
                    sealed_owner._upload_terminal_owner = None
                object.__setattr__(self._ledger, "_upload_terminal_owner", None)
                self._policy_authority = None
                self._sealed_owner = None
                self._closed = True
        finally:
            object.__setattr__(self, "_closing", False)
        if failure is not None:
            raise failure.with_traceback(None)
        if not completed:
            raise CFError("signature verification composite cleanup is incomplete")

    def __del__(self) -> None:
        try:
            self.close(self._ledger)
        except BaseException:
            pass


class AccountedHTTPUploadExistingTerminalOwner:
    """Own all existing-project consumers under one parent authority token.

    This production-unwired owner closes the lifetime gap between signature,
    server verification, ancestry, and the final sealed/policy pair fence. It
    intentionally exposes no child, borrow, capability, semantic input,
    publication input, or handler wiring.
    """

    BOUND = "BOUND"
    VERIFYING = "VERIFYING"
    VERIFIED = "VERIFIED"
    ANCESTRY_RUNNING = "ANCESTRY_RUNNING"
    ANCESTRY_DONE = "ANCESTRY_DONE"
    PAIR_PREPARING = "PAIR_PREPARING"
    PAIR_DETACHING = "PAIR_DETACHING"
    PAIR_DETACHED = "PAIR_DETACHED"
    ABORT_ONLY = "ABORT_ONLY"

    @staticmethod
    def _bind_parent_tokens(
        sealed_owner: AccountedHTTPUploadSealedValidation,
        policy_authority: AccountedRemoteSignaturePolicyAuthority,
        owner: "AccountedHTTPUploadExistingTerminalOwner",
    ) -> None:
        """Publish both diagnostic mirrors without replaceable callbacks."""
        object.__setattr__(sealed_owner, "_upload_terminal_owner", owner)
        object.__setattr__(policy_authority, "_upload_terminal_owner", owner)

    def __init__(
        self,
        sealed_owner: AccountedHTTPUploadSealedValidation,
        policy_authority: AccountedRemoteSignaturePolicyAuthority,
        ledger: DecisionWorkLedger,
    ) -> None:
        if not isinstance(sealed_owner, AccountedHTTPUploadSealedValidation):
            raise CFError("existing upload terminal requires a sealed owner")
        if not isinstance(
            policy_authority, AccountedRemoteSignaturePolicyAuthority
        ):
            raise CFError("existing upload terminal requires a policy authority")
        sealed_owner._ensure_open(ledger)
        policy_authority._ensure_open(ledger)
        if sealed_owner._deadline is not policy_authority._deadline:
            raise CFError("existing upload terminal requires the same deadline")
        if not sealed_owner._validated:
            raise CFError("existing upload terminal requires validated authority")
        if policy_authority._policy_bound or policy_authority._verification_bound:
            raise CFError("existing upload terminal requires an unused policy authority")
        if policy_authority._project_fd < 0 or policy_authority._missing_parts:
            raise CFError("existing upload terminal requires an existing project")
        if (
            sealed_owner._active_borrow_token
            or sealed_owner._borrow_failed
            or sealed_owner._borrow_releasing
            or sealed_owner._borrow_reading
            or sealed_owner._upload_terminal_active
            or sealed_owner._finishing
            or sealed_owner._closing
        ):
            raise CFError("existing upload terminal requires idle sealed authority")
        if (
            policy_authority._verification_constructing
            or policy_authority._verification_handoff_open
        ):
            raise CFError("existing upload terminal requires idle policy authority")
        for purpose in ("signature", "ancestry"):
            handle = sealed_owner._borrow_handles.get(purpose)
            if not isinstance(handle, _HTTPUploadSealedCommitBorrow) or handle._used:
                raise CFError("existing upload terminal requires unused consumer handles")
        if (
            sealed_owner._upload_terminal_owner is not None
            or policy_authority._upload_terminal_owner is not None
            or ledger._upload_terminal_owner is not None
        ):
            raise CFError("existing upload terminal already owns a parent")

        # Publish every cleanup field before binding either parent.  A failed
        # second bind can roll back both tokens without an unreachable owner.
        self._ledger = ledger
        self._ledger_identity = id(ledger)
        self._deadline = sealed_owner._deadline
        self._sealed_owner: AccountedHTTPUploadSealedValidation | None = (
            sealed_owner
        )
        self._policy_authority: (
            AccountedRemoteSignaturePolicyAuthority | None
        ) = policy_authority
        self._signature_borrow: _HTTPUploadSealedCommitBorrow | None = None
        self._verification: AccountedServerVerification | None = None
        self._ancestry_borrow: _HTTPUploadSealedCommitBorrow | None = None
        self._ancestry: AccountedHTTPUploadAncestry | None = None
        # Fixed control-plane reference slots bind the exact immutable
        # verification subject without cloning either caller string.
        self._verified_branch: str | None = None
        self._verified_head: str | None = None
        self._state = self.BOUND
        self._operating = False
        self._closing = False
        self._close_requested = False
        self._pair_resources_released = False
        self._pair_semantic_carrier_owner: Any | None = None
        self._pair_semantic_carrier_token: Any | None = None
        self._closed = False
        self._binding = True

        bind_failure: BaseException | None = None
        try:
            # One callback-free request registry assignment blocks stale
            # aliases of both parents before either diagnostic mirror bind.
            object.__setattr__(ledger, "_upload_terminal_owner", self)
            AccountedHTTPUploadExistingTerminalOwner._bind_parent_tokens(
                sealed_owner, policy_authority, self
            )
            if (
                object.__getattribute__(
                    sealed_owner, "_upload_terminal_owner"
                )
                is not self
                or object.__getattribute__(
                    policy_authority, "_upload_terminal_owner"
                )
                is not self
            ):
                raise CFError(
                    "existing upload terminal did not bind both parents"
                )
        except BaseException as exc:
            _detach_exception_chain(exc)
            bind_failure = exc
        if bind_failure is not None:
            if object.__getattribute__(sealed_owner, "_upload_terminal_owner") is self:
                object.__setattr__(sealed_owner, "_upload_terminal_owner", None)
            if object.__getattribute__(policy_authority, "_upload_terminal_owner") is self:
                object.__setattr__(policy_authority, "_upload_terminal_owner", None)
            if object.__getattribute__(ledger, "_upload_terminal_owner") is self:
                object.__setattr__(ledger, "_upload_terminal_owner", None)
            object.__setattr__(self, "_sealed_owner", None)
            object.__setattr__(self, "_policy_authority", None)
            object.__setattr__(self, "_closed", True)
            raise bind_failure.with_traceback(None)
        object.__setattr__(self, "_binding", False)
        if self._close_requested:
            self.close(ledger)
            raise CFError("existing upload terminal binding was cancelled by close")

    @staticmethod
    def _detach_failure(exc: BaseException) -> BaseException:
        _detach_exception_chain(exc)
        return exc

    def _ensure_ledger(self, ledger: DecisionWorkLedger) -> None:
        if ledger is not self._ledger or id(ledger) != self._ledger_identity:
            raise CFError("existing upload terminal belongs to a different ledger")

    def _ensure_available(self, carrier_owner: Any | None = None) -> None:
        if self._binding:
            raise CFError("existing upload terminal binding is in progress")
        if self._closed:
            raise CFError("existing upload terminal is closed")
        if self._closing:
            raise CFError("existing upload terminal cleanup is in progress")
        registry = object.__getattribute__(
            self._ledger, "_upload_terminal_owner"
        )
        if carrier_owner is None:
            registry_matches = registry is self
        else:
            registry_matches = registry is carrier_owner
        if (
            not registry_matches
            or self._pair_semantic_carrier_owner is not carrier_owner
        ):
            raise CFError("HTTP upload pair semantic carrier adopted pair")

    @staticmethod
    def _borrow_released(
        borrow: _HTTPUploadSealedCommitBorrow,
        sealed_owner: AccountedHTTPUploadSealedValidation,
    ) -> bool:
        return (
            object.__getattribute__(borrow, "_owner") is sealed_owner
            and object.__getattribute__(borrow, "_token") == 0
            and object.__getattribute__(sealed_owner, "_active_borrow_token") == 0
        )

    def _finish_operation(
        self,
        failure: BaseException | None,
        cancellation: str,
    ) -> None:
        close_requested = self._close_requested
        if failure is not None or close_requested:
            object.__setattr__(self, "_state", self.ABORT_ONLY)
            cleanup_failure: BaseException | None = None
            try:
                self.close(self._ledger)
            except BaseException as exc:
                cleanup_failure = self._detach_failure(exc)
            if cleanup_failure is not None:
                if failure is not None:
                    raise cleanup_failure.with_traceback(None) from failure
                raise cleanup_failure.with_traceback(None)
            if failure is not None:
                raise failure.with_traceback(None)
            raise CFError(cancellation)

    def verify_signature_and_server(
        self,
        branch: str,
        head: str,
        ledger: DecisionWorkLedger,
        *,
        output_limit_bytes: int = AccountedServerVerification.DEFAULT_OUTPUT_LIMIT_BYTES,
    ) -> None:
        """Run and close both consumers without exposing either child."""
        self._ensure_ledger(ledger)
        self._ensure_available()
        if self._operating:
            raise CFError("existing upload terminal operation is in progress")
        if self._state != self.BOUND:
            if self._state == self.ABORT_ONLY:
                raise CFError("existing upload terminal is abort-only")
            raise CFError("existing upload terminal verification is single-use")
        sealed_owner = self._sealed_owner
        policy_authority = self._policy_authority
        if sealed_owner is None or policy_authority is None:
            raise CFError("existing upload terminal has no parent authority")
        if sealed_owner._head != head:
            raise CFError("existing upload terminal requires the validated head")

        failure: BaseException | None = None
        authority_started = False
        try:
            object.__setattr__(self, "_state", self.VERIFYING)
            object.__setattr__(self, "_operating", True)
            object.__setattr__(sealed_owner, "_upload_terminal_active", True)
            authority_started = True
            policy_authority._begin_verified_server_verification(
                branch,
                head,
                ledger,
                _upload_terminal_owner=self,
            )
            expected = sealed_owner._borrow_handles.get("signature")
            if not isinstance(expected, _HTTPUploadSealedCommitBorrow):
                raise CFError("existing upload terminal has no signature borrow")
            # Publish the exact preallocated handle before activation.
            self._signature_borrow = expected
            borrowed = sealed_owner.borrow_commits(
                ledger,
                "signature",
                _upload_terminal_owner=self,
            )
            if borrowed is not expected:
                raise CFError("existing upload terminal received a foreign borrow")
            verification = policy_authority._prepare_verified_server_verification_core(
                borrowed,
                branch,
                head,
                output_limit_bytes=output_limit_bytes,
                allow_missing_project=False,
                close_loader=True,
                _upload_terminal_owner=self,
            )
            if verification is not self._verification:
                raise CFError("existing upload terminal received a foreign verification child")
            if self._borrow_released(expected, sealed_owner):
                self._signature_borrow = None
            if self._close_requested:
                raise CFError(
                    "existing upload terminal verification was cancelled before execution"
                )
            verification.run()
            verification.close()
            if not verification._closed:
                raise CFError("existing upload terminal verification cleanup is incomplete")
            self._verification = None
            object.__setattr__(self, "_verified_branch", branch)
            object.__setattr__(self, "_verified_head", head)
            object.__setattr__(self, "_state", self.VERIFIED)
        except BaseException as exc:
            failure = self._detach_failure(exc)
            # Construction publishes partial verification into this owner.
            if self._verification is None:
                child = policy_authority._verification_owner
                if child is not None:
                    object.__setattr__(self, "_verification", child)
        finally:
            if authority_started:
                object.__setattr__(policy_authority, "_verification_handoff_open", False)
                object.__setattr__(policy_authority, "_verification_constructing", False)
            object.__setattr__(sealed_owner, "_upload_terminal_active", False)
            object.__setattr__(self, "_operating", False)
        sealed_owner = None
        policy_authority = None
        self._finish_operation(
            failure,
            "existing upload terminal verification was cancelled by close",
        )

    def contains_ancestor(
        self,
        ancestor: str,
        head: str,
        ledger: DecisionWorkLedger,
    ) -> bool:
        """Run the complete exact-handle BFS without exposing its borrow."""
        self._ensure_ledger(ledger)
        self._ensure_available()
        if self._operating:
            raise CFError("existing upload terminal operation is in progress")
        if self._state == self.ABORT_ONLY:
            raise CFError("existing upload terminal is abort-only")
        if self._state != self.VERIFIED:
            raise CFError("existing upload terminal ancestry requires verification")
        if head != self._verified_head:
            raise CFError("existing upload terminal ancestry subject changed")
        sealed_owner = self._sealed_owner
        if sealed_owner is None:
            raise CFError("existing upload terminal has no sealed authority")
        if sealed_owner._head != head:
            raise CFError("existing upload terminal requires the validated head")

        result = False
        failure: BaseException | None = None
        try:
            object.__setattr__(self, "_state", self.ANCESTRY_RUNNING)
            object.__setattr__(self, "_operating", True)
            object.__setattr__(sealed_owner, "_upload_terminal_active", True)
            expected = sealed_owner._borrow_handles.get("ancestry")
            if not isinstance(expected, _HTTPUploadSealedCommitBorrow):
                raise CFError("existing upload terminal has no ancestry borrow")
            self._ancestry_borrow = expected
            borrowed = sealed_owner.borrow_commits(
                ledger,
                "ancestry",
                _upload_terminal_owner=self,
            )
            if borrowed is not expected:
                raise CFError("existing upload terminal received a foreign borrow")
            AccountedHTTPUploadAncestry(
                ledger,
                borrowed,
                self._deadline,
                _handoff_owner=self,
            )
            ancestry = self._ancestry
            if ancestry is None:
                raise CFError("existing upload terminal produced no ancestry child")
            if self._close_requested:
                raise CFError(
                    "existing upload terminal ancestry was cancelled before decision"
                )
            result = ancestry.contains(ancestor, head)
            ancestry.close(ledger)
            if ancestry._closed:
                self._ancestry = None
            borrowed.close(ledger)
            if not self._borrow_released(borrowed, sealed_owner):
                raise CFError("existing upload terminal ancestry release is incomplete")
            self._ancestry_borrow = None
            object.__setattr__(self, "_state", self.ANCESTRY_DONE)
        except BaseException as exc:
            failure = self._detach_failure(exc)
        finally:
            object.__setattr__(sealed_owner, "_upload_terminal_active", False)
            object.__setattr__(self, "_operating", False)
        sealed_owner = None
        self._finish_operation(
            failure,
            "existing upload terminal ancestry was cancelled by close",
        )
        return result

    def finalize_pair(
        self,
        ledger: DecisionWorkLedger,
        *,
        _pair_semantic_carrier_owner: Any | None = None,
        _pair_semantic_carrier_token: Any | None = None,
        _semantic_probe: Any | None = None,
        _semantic_commit: Any | None = None,
    ) -> None:
        """Probe both final authorities and detach them as one decision."""
        self._ensure_ledger(ledger)
        self._ensure_available(_pair_semantic_carrier_owner)
        if _pair_semantic_carrier_owner is None:
            if (
                _pair_semantic_carrier_token is not None
                or _semantic_probe is not None
                or _semantic_commit is not None
            ):
                raise CFError("existing upload terminal received foreign semantic input")
        else:
            carrier_type = AccountedHTTPUploadExistingPairSemanticCarrier
            if type(_pair_semantic_carrier_owner) is not carrier_type:
                raise CFError("existing upload terminal requires its semantic carrier")
            carrier_descriptor = MappingProxyType.__getitem__(
                type.__getattribute__(carrier_type, "__dict__"),
                "__dict__",
            )
            carrier_mapping = type(carrier_descriptor).__get__(
                carrier_descriptor,
                _pair_semantic_carrier_owner,
                carrier_type,
            )
            if (
                type(carrier_mapping) is not dict
                or self._pair_semantic_carrier_owner
                is not _pair_semantic_carrier_owner
                or self._pair_semantic_carrier_token
                is not _pair_semantic_carrier_token
                or _pair_semantic_carrier_token is None
                or object.__getattribute__(ledger, "_upload_terminal_owner")
                is not _pair_semantic_carrier_owner
                or dict.__getitem__(carrier_mapping, "_pair_owner") is not self
                or dict.__getitem__(carrier_mapping, "_pair_token")
                is not _pair_semantic_carrier_token
                or dict.__getitem__(carrier_mapping, "_state")
                != carrier_type.FINALIZING
                or dict.__getitem__(carrier_mapping, "_closed") is not False
                or dict.__getitem__(carrier_mapping, "_semantic_probe")
                is not _semantic_probe
                or dict.__getitem__(carrier_mapping, "_semantic_commit")
                is not _semantic_commit
            ):
                raise CFError("existing upload terminal requires its semantic carrier")
        if self._operating:
            raise CFError("existing upload terminal operation is in progress")
        if self._state == self.PAIR_DETACHED:
            if self._pair_resources_released:
                raise CFError("existing upload terminal pair is single-use")
            self.close(ledger, _preserve_pair=True)
            return
        if self._state == self.ABORT_ONLY:
            raise CFError("existing upload terminal is abort-only")
        if self._state != self.ANCESTRY_DONE:
            raise CFError("existing upload terminal pair requires ancestry")
        sealed_owner = self._sealed_owner
        policy_authority = self._policy_authority
        if sealed_owner is None or policy_authority is None:
            raise CFError("existing upload terminal has no parent authority")
        failure: BaseException | None = None
        detached = False
        verified_branch = self._verified_branch
        verified_head = self._verified_head
        expected_registry = (
            self
            if _pair_semantic_carrier_owner is None
            else _pair_semantic_carrier_owner
        )
        pair_type = AccountedHTTPUploadExistingTerminalOwner
        pair_class_mapping = type.__getattribute__(pair_type, "__dict__")
        class_mapping_get = type(pair_class_mapping).get
        expected_pair_getattribute = class_mapping_get(
            pair_class_mapping, "__getattribute__", None
        )
        expected_pair_setattr = class_mapping_get(
            pair_class_mapping, "__setattr__", None
        )
        pair_descriptor = MappingProxyType.__getitem__(
            pair_class_mapping,
            "__dict__",
        )
        pair_descriptor_get = type(pair_descriptor).__get__
        pair_mapping = pair_descriptor_get(pair_descriptor, self, pair_type)
        sealed_type = type(sealed_owner)
        sealed_class_mapping = type.__getattribute__(sealed_type, "__dict__")
        expected_sealed_getattribute = class_mapping_get(
            sealed_class_mapping, "__getattribute__", None
        )
        expected_sealed_setattr = class_mapping_get(
            sealed_class_mapping, "__setattr__", None
        )
        policy_type = type(policy_authority)
        policy_class_mapping = type.__getattribute__(policy_type, "__dict__")
        expected_policy_getattribute = class_mapping_get(
            policy_class_mapping, "__getattribute__", None
        )
        expected_policy_setattr = class_mapping_get(
            policy_class_mapping, "__setattr__", None
        )
        semantic_class_mapping = None
        expected_semantic_getattribute = None
        expected_semantic_setattr = None
        if _pair_semantic_carrier_owner is not None:
            semantic_owner = dict.__getitem__(carrier_mapping, "_semantic_owner")
            if (
                type(semantic_owner) is not AccountedHTTPUploadSemantic
                or semantic_owner._pair_semantic_carrier_owner
                is not _pair_semantic_carrier_owner
            ):
                raise CFError("existing upload terminal requires its semantic carrier")
            semantic_class_mapping = type.__getattribute__(
                AccountedHTTPUploadSemantic, "__dict__"
            )
            expected_semantic_getattribute = class_mapping_get(
                semantic_class_mapping, "__getattribute__", None
            )
            expected_semantic_setattr = class_mapping_get(
                semantic_class_mapping, "__setattr__", None
            )
        ledger_type = DecisionWorkLedger
        ledger_class_mapping = type.__getattribute__(ledger_type, "__dict__")
        expected_ledger_getattribute = class_mapping_get(
            ledger_class_mapping, "__getattribute__", None
        )
        expected_ledger_setattr = class_mapping_get(
            ledger_class_mapping, "__setattr__", None
        )
        carrier_class_mapping = None
        expected_carrier_getattribute = None
        expected_carrier_setattr = None
        if _pair_semantic_carrier_owner is not None:
            carrier_class_mapping = type.__getattribute__(carrier_type, "__dict__")
            expected_carrier_getattribute = class_mapping_get(
                carrier_class_mapping, "__getattribute__", None
            )
            expected_carrier_setattr = class_mapping_get(
                carrier_class_mapping, "__setattr__", None
            )
        ledger_descriptor = MappingProxyType.__getitem__(
            ledger_class_mapping,
            "__dict__",
        )
        ledger_descriptor_get = type(ledger_descriptor).__get__
        ledger_mapping = ledger_descriptor_get(ledger_descriptor, ledger, ledger_type)
        if type(pair_mapping) is not dict or type(ledger_mapping) is not dict:
            raise CFError("existing upload terminal requires exact state")
        dict_item = dict.__getitem__
        dict_get = dict.get
        dict_set = dict.__setitem__
        mapping_length = len
        detach_failure = _detach_exception_chain
        pair_close = AccountedHTTPUploadExistingTerminalOwner.close
        pair_detaching_state = self.PAIR_DETACHING
        pair_detached_state = self.PAIR_DETACHED
        abort_only_state = self.ABORT_ONLY
        # Resolve every replaceable class attribute before the first
        # cooperative callback. The critical probe/commit interval invokes
        # only these exact function objects and captured OS primitives.
        policy_prepare = (
            AccountedRemoteSignaturePolicyAuthority._prepare_upload_terminal_pair
        )
        sealed_prepare = (
            AccountedHTTPUploadSealedValidation._prepare_upload_terminal_pair
        )
        sealed_probe = (
            AccountedHTTPUploadSealedValidation._probe_upload_terminal_pair
        )
        policy_probe = (
            AccountedRemoteSignaturePolicyAuthority._probe_upload_terminal_pair
        )
        sealed_commit = (
            AccountedHTTPUploadSealedValidation._commit_upload_terminal_pair
        )
        policy_commit = (
            AccountedRemoteSignaturePolicyAuthority._commit_upload_terminal_pair
        )
        sealed_store_probe = AccountedHTTPUploadSealedValidation._probe_pair_store
        policy_project_probe = (
            AccountedRemoteSignaturePolicyAuthority._probe_pair_project
        )
        pair_changed = AccountedHTTPUploadSealedValidation._pair_changed
        borrow_mutation_failure = (
            AccountedHTTPUploadSealedValidation._borrow_mutation_failure
        )
        fingerprint = AccountedRemoteSignaturePolicyAuthority._fingerprint
        safe_policy_metadata = (
            AccountedRemoteSignaturePolicyAuthority._safe_policy_metadata
        )
        fd_open = _CallbackFreeFD.open
        fd_close = _CallbackFreeFD.close
        try:
            object.__setattr__(self, "_state", self.PAIR_PREPARING)
            object.__setattr__(self, "_operating", True)
            object.__setattr__(sealed_owner, "_upload_terminal_active", True)
            if (
                verified_branch is None
                or verified_head is None
                or sealed_owner._head != verified_head
            ):
                raise CFError("existing upload terminal pair subject changed")
            policy_prepare(policy_authority, self, expected_registry)
            sealed_prepare(sealed_owner, self, expected_registry)
            expected_epoch = dict_item(ledger_mapping, "_mutation_epoch")
            expected_current = dict_item(ledger_mapping, "_current")
            expected_current_length = mapping_length(expected_current)
            expected_retained = dict_get(expected_current, "retained_bytes", 0)
            expected_temporary = dict_get(expected_current, "temporary_bytes", 0)
            expected_terminal = dict_item(ledger_mapping, "_terminal_reason")
            expected_sealed = dict_item(ledger_mapping, "_prepublication_sealed")
            if dict_item(ledger_mapping, "_reserved"):
                raise CFError("existing upload terminal has an open final permit")
            deadline = dict_item(pair_mapping, "_deadline")
            if deadline is not None:
                deadline.check("upload terminal pair probe")
            if (
                pair_descriptor_get(pair_descriptor, self, pair_type)
                is not pair_mapping
                or class_mapping_get(
                    pair_class_mapping, "__getattribute__", None
                )
                is not expected_pair_getattribute
                or class_mapping_get(pair_class_mapping, "__setattr__", None)
                is not expected_pair_setattr
                or class_mapping_get(
                    sealed_class_mapping, "__getattribute__", None
                )
                is not expected_sealed_getattribute
                or class_mapping_get(
                    sealed_class_mapping, "__setattr__", None
                )
                is not expected_sealed_setattr
                or class_mapping_get(
                    policy_class_mapping, "__getattribute__", None
                )
                is not expected_policy_getattribute
                or class_mapping_get(
                    policy_class_mapping, "__setattr__", None
                )
                is not expected_policy_setattr
                or (
                    semantic_class_mapping is not None
                    and (
                        class_mapping_get(
                            semantic_class_mapping, "__getattribute__", None
                        )
                        is not expected_semantic_getattribute
                        or class_mapping_get(
                            semantic_class_mapping, "__setattr__", None
                        )
                        is not expected_semantic_setattr
                    )
                )
                or class_mapping_get(
                    ledger_class_mapping, "__getattribute__", None
                )
                is not expected_ledger_getattribute
                or class_mapping_get(
                    ledger_class_mapping, "__setattr__", None
                )
                is not expected_ledger_setattr
                or (
                    carrier_class_mapping is not None
                    and (
                        class_mapping_get(
                            carrier_class_mapping, "__getattribute__", None
                        )
                        is not expected_carrier_getattribute
                        or class_mapping_get(
                            carrier_class_mapping, "__setattr__", None
                        )
                        is not expected_carrier_setattr
                    )
                )
                or ledger_descriptor_get(ledger_descriptor, ledger, ledger_type)
                is not ledger_mapping
                or dict_item(ledger_mapping, "_mutation_epoch") != expected_epoch
                or dict_item(ledger_mapping, "_current") is not expected_current
                or mapping_length(expected_current) != expected_current_length
                or dict_get(expected_current, "retained_bytes", 0)
                != expected_retained
                or dict_get(expected_current, "temporary_bytes", 0)
                != expected_temporary
                or dict_item(ledger_mapping, "_reserved")
                or dict_item(ledger_mapping, "_terminal_reason")
                is not expected_terminal
                or dict_item(ledger_mapping, "_prepublication_sealed")
                is not expected_sealed
            ):
                raise CFError("existing upload terminal ledger changed during callback")
            if dict_item(pair_mapping, "_close_requested"):
                raise CFError(
                    "existing upload terminal pair was cancelled before probe"
                )
            if sealed_owner._head != verified_head:
                raise CFError("existing upload terminal pair subject changed")

            dict_set(pair_mapping, "_state", pair_detaching_state)
            # This exact order is the legacy diagnostic contract.  Neither
            # half changes success state until both callback-free probes pass.
            sealed_probe(
                sealed_owner,
                self,
                expected_registry,
                sealed_store_probe,
                pair_changed,
                borrow_mutation_failure,
                fd_open,
                fd_close,
            )
            if dict_item(pair_mapping, "_close_requested"):
                raise CFError(
                    "existing upload terminal pair was cancelled during probe"
                )
            policy_probe(
                policy_authority,
                self,
                expected_registry,
                policy_project_probe,
                fingerprint,
                safe_policy_metadata,
                fd_open,
                fd_close,
            )
            if dict_item(pair_mapping, "_close_requested"):
                raise CFError(
                    "existing upload terminal pair was cancelled during probe"
                )
            # Restore the exact pre-callback immutable subject references as
            # part of the field-only logical commit. No callback follows.
            dict_set(pair_mapping, "_verified_branch", verified_branch)
            dict_set(pair_mapping, "_verified_head", verified_head)
            if _semantic_probe is not None:
                _semantic_probe()
            sealed_commit(sealed_owner, self)
            policy_commit(policy_authority, self)
            if _semantic_probe is not None:
                _semantic_commit()
            dict_set(pair_mapping, "_state", pair_detached_state)
            detached = True
        except BaseException as exc:
            detach_failure(exc)
            failure = exc
        finally:
            object.__setattr__(sealed_owner, "_upload_terminal_active", False)
            dict_set(pair_mapping, "_operating", False)
            policy_prepare = None
            sealed_prepare = None
            sealed_probe = None
            policy_probe = None
            sealed_commit = None
            policy_commit = None
            sealed_store_probe = None
            policy_project_probe = None
            pair_changed = None
            borrow_mutation_failure = None
            fingerprint = None
            safe_policy_metadata = None
            fd_open = None
            fd_close = None
            _semantic_probe = None
            _semantic_commit = None
            verified_branch = None
            verified_head = None
            expected_registry = None
            deadline = None
            expected_current = None
        sealed_owner = None
        policy_authority = None
        if not detached:
            if _pair_semantic_carrier_owner is not None:
                dict_set(pair_mapping, "_state", abort_only_state)
                if failure is not None:
                    raise failure.with_traceback(None)
                raise CFError("existing upload terminal semantic carrier was cancelled")
            self._finish_operation(
                failure,
                "existing upload terminal pair was cancelled",
            )
            return
        try:
            pair_close(
                self,
                ledger,
                _preserve_pair=True,
                _pair_semantic_carrier_owner=_pair_semantic_carrier_owner,
            )
        except BaseException:
            # Logical success is already detached. A retry must resume only
            # policy-then-sealed cleanup and must never rerun either probe.
            raise

    def close(
        self,
        ledger: DecisionWorkLedger,
        *,
        _preserve_pair: bool = False,
        _pair_semantic_carrier_owner: Any | None = None,
        _pair_semantic_registry: Any | None = None,
    ) -> None:
        self._ensure_ledger(ledger)
        if self._closed:
            return
        registry = object.__getattribute__(ledger, "_upload_terminal_owner")
        expected_registry = (
            self
            if _pair_semantic_carrier_owner is None
            else _pair_semantic_carrier_owner
        )
        if _pair_semantic_registry is not None:
            expected_registry = _pair_semantic_registry
        registry_matches = registry is expected_registry
        if (
            not registry_matches
            or
            self._pair_semantic_carrier_owner is not None
            and self._pair_semantic_carrier_owner
            is not _pair_semantic_carrier_owner
        ):
            raise CFError("HTTP upload pair semantic carrier adopted pair")
        if self._binding:
            object.__setattr__(self, "_close_requested", True)
            return
        if self._operating:
            self._close_requested = True
            return
        if self._closing:
            return
        object.__setattr__(self, "_closing", True)
        failure: BaseException | None = None
        try:
            sealed_owner = self._sealed_owner
            ancestry = self._ancestry
            if ancestry is not None:
                try:
                    ancestry.close(ledger)
                except BaseException as exc:
                    failure = self._detach_failure(exc)
                if ancestry._closed:
                    self._ancestry = None
            ancestry = None

            if failure is None:
                borrow = self._ancestry_borrow
                if borrow is not None:
                    try:
                        borrow.close(ledger)
                    except BaseException as exc:
                        failure = self._detach_failure(exc)
                    if sealed_owner is not None and self._borrow_released(
                        borrow, sealed_owner
                    ):
                        self._ancestry_borrow = None
                borrow = None

            if failure is None:
                verification = self._verification
                if verification is not None:
                    try:
                        verification.close()
                    except BaseException as exc:
                        failure = self._detach_failure(exc)
                    if verification._closed:
                        self._verification = None
                verification = None

            policy_authority = self._policy_authority
            if failure is None and policy_authority is not None:
                signature = policy_authority._policy_owner
                if signature is not None:
                    try:
                        signature.close(ledger)
                    except BaseException as exc:
                        failure = self._detach_failure(exc)
                    if signature._closed:
                        policy_authority._policy_owner = None
                signature = None

            if failure is None:
                borrow = self._signature_borrow
                if borrow is not None:
                    try:
                        borrow.close(ledger)
                    except BaseException as exc:
                        failure = self._detach_failure(exc)
                    if sealed_owner is not None and self._borrow_released(
                        borrow, sealed_owner
                    ):
                        self._signature_borrow = None
                borrow = None

            if failure is None and policy_authority is not None:
                try:
                    policy_authority.close(
                        ledger,
                        _upload_terminal_owner=self,
                        _upload_terminal_registry=(
                            expected_registry
                        ),
                    )
                except BaseException as exc:
                    failure = self._detach_failure(exc)

            if failure is None and sealed_owner is not None:
                try:
                    sealed_owner.close(
                        ledger,
                        _upload_terminal_owner=self,
                        _upload_terminal_registry=(
                            expected_registry
                        ),
                    )
                except BaseException as exc:
                    failure = self._detach_failure(exc)

            completed = (
                failure is None
                and self._ancestry is None
                and self._ancestry_borrow is None
                and self._verification is None
                and self._signature_borrow is None
                and (policy_authority is None or policy_authority._closed)
                and (sealed_owner is None or sealed_owner._closed)
            )
            if completed:
                if policy_authority is not None:
                    object.__setattr__(
                        policy_authority, "_upload_terminal_owner", None
                    )
                if sealed_owner is not None:
                    object.__setattr__(sealed_owner, "_upload_terminal_owner", None)
                self._policy_authority = None
                self._sealed_owner = None
                self._deadline = None
                self._close_requested = False
                self._pair_resources_released = True
                if not _preserve_pair:
                    self._verified_branch = None
                    self._verified_head = None
                    if _pair_semantic_carrier_owner is None:
                        object.__setattr__(
                            self._ledger, "_upload_terminal_owner", None
                        )
                    self._closed = True
        finally:
            object.__setattr__(self, "_closing", False)
        if failure is not None:
            raise failure.with_traceback(None)
        if not self._closed and not (
            _preserve_pair
            and self._state == self.PAIR_DETACHED
            and self._pair_resources_released
        ):
            raise CFError("existing upload terminal cleanup is incomplete")

    def _close_from_pair_semantic_carrier(self, owner: Any) -> None:
        self.close(
            self._ledger,
            _pair_semantic_carrier_owner=owner,
        )

    def __del__(self) -> None:
        try:
            if self._pair_semantic_carrier_owner is None:
                self.close(self._ledger)
        except BaseException:
            pass


class ExistingProjectGateChanged(CFError):
    """The exact existing-project gate subject no longer matches."""

    def __init__(self, path: Path, reason: str) -> None:
        self.path = path
        self.reason = reason
        super().__init__(f"existing project gate changed: {path}: {reason}")


class AccountedHTTPUploadExistingProjectGate:
    """Own one existing project identity and its exclusive persistent gate.

    The owner is deliberately production-unwired.  It acquires every live
    memory/capability upper before opening the project, validates one bounded
    version-1 descriptor, and keeps the exact project/locks/gate/descriptor
    subject pinned until an adopting pair-semantic carrier closes.
    """

    INITIALIZING = "INITIALIZING"
    READY = "READY"
    ADOPTED = "ADOPTED"
    CLOSED = "CLOSED"
    MAX_DESCRIPTOR_BYTES = 16 * 1024
    PATH_PREFLIGHT_TEMPORARY_BYTES = 64 * 1024
    CONTROL_RETAINED_BYTES = 32 * 1024
    CAPABILITY_COMPONENT_BYTES = 1024
    CAPABILITY_PATH_MULTIPLIER = 4
    CAPABILITY_TEMPORARY_BYTES = 64 * 1024
    JSON_TEMPORARY_BASE_BYTES = 4096
    JSON_TEMPORARY_BYTES_PER_INPUT_BYTE = 256
    CLOSE_CAPABILITY = staticmethod(_CODEFIRE_OS_CLOSE)
    FSTAT_CAPABILITY = staticmethod(_CODEFIRE_OS_FSTAT)
    FLOCK = staticmethod(fcntl.flock) if fcntl is not None else None

    @classmethod
    def live_upper(cls, project_root: Path) -> tuple[int, int]:
        absolute = Path(os.path.abspath(project_root))
        path_bytes = len(os.fsencode(absolute))
        components = max(len(absolute.parts) - 1, 1)
        retained = (
            cls.CONTROL_RETAINED_BYTES
            + cls.MAX_DESCRIPTOR_BYTES
            + cls.CAPABILITY_COMPONENT_BYTES * (components + 5)
            + cls.CAPABILITY_PATH_MULTIPLIER * path_bytes
        )
        temporary = (
            cls.CAPABILITY_TEMPORARY_BYTES
            + cls.MAX_DESCRIPTOR_BYTES
            + 1
            + cls.JSON_TEMPORARY_BASE_BYTES
            + cls.JSON_TEMPORARY_BYTES_PER_INPUT_BYTE
            * cls.MAX_DESCRIPTOR_BYTES
            + cls.CAPABILITY_PATH_MULTIPLIER * path_bytes
        )
        if retained > U64_MAX or temporary > U64_MAX:
            raise CFError("existing project gate allocation upper overflows u64")
        return retained, temporary

    @classmethod
    def construction_upper(cls, project_root: Path) -> tuple[int, int]:
        retained, temporary = cls.live_upper(project_root)
        total_temporary = temporary + cls.PATH_PREFLIGHT_TEMPORARY_BYTES
        if total_temporary > U64_MAX:
            raise CFError("existing project gate construction upper overflows u64")
        return retained, total_temporary

    @staticmethod
    def _fingerprint(metadata: os.stat_result) -> tuple[int, ...]:
        return (
            metadata.st_mode,
            metadata.st_dev,
            metadata.st_ino,
            metadata.st_nlink,
            metadata.st_size,
            metadata.st_mtime_ns,
            metadata.st_ctime_ns,
        )

    @staticmethod
    def _directory_identity(metadata: os.stat_result) -> tuple[int, int]:
        if not stat.S_ISDIR(metadata.st_mode):
            raise CFError("existing project gate requires directory capabilities")
        return metadata.st_dev, metadata.st_ino

    @staticmethod
    def _regular_identity(metadata: os.stat_result) -> tuple[int, int]:
        if not stat.S_ISREG(metadata.st_mode) or metadata.st_nlink != 1:
            raise CFError("existing project gate requires single-link regular files")
        return metadata.st_dev, metadata.st_ino

    @staticmethod
    def _strict_object(pairs: list[tuple[str, Any]]) -> dict[str, Any]:
        result: dict[str, Any] = {}
        for key, value in pairs:
            if type(key) is not str or key in result:
                raise CFError("remote project descriptor has duplicate or invalid keys")
            result[key] = value
        return result

    @classmethod
    def _validate_descriptor(
        cls, raw: bytes, project_root: Path, org: str, app: str
    ) -> str:
        try:
            descriptor = json.loads(raw, object_pairs_hook=cls._strict_object)
        except (UnicodeDecodeError, json.JSONDecodeError) as exc:
            _detach_exception_chain(exc)
            raise CFError("remote project descriptor JSON is invalid") from None
        if type(descriptor) is not dict:
            raise CFError("remote project descriptor must be an object")
        stable_id = dict.get(descriptor, "stable_project_id")
        valid = (
            type(dict.get(descriptor, "type")) is str
            and dict.get(descriptor, "type") == "codefire_remote_project"
            and type(dict.get(descriptor, "version")) is int
            and dict.get(descriptor, "version") == 1
            and type(dict.get(descriptor, "protocol_generation")) is int
            and dict.get(descriptor, "protocol_generation") == 1
            and type(dict.get(descriptor, "organization")) is str
            and dict.get(descriptor, "organization") == org
            and type(dict.get(descriptor, "application")) is str
            and dict.get(descriptor, "application") == app
            and type(stable_id) is str
            and re.fullmatch(r"CF-PROJECT-[0-9a-f]{32}", stable_id) is not None
        )
        if not valid:
            raise CFError(
                f"remote project descriptor is invalid: "
                f"{project_root / 'remote_project.json'}"
            )
        return stable_id

    def __init__(
        self,
        project_root: Path,
        organization: str,
        application: str,
        ledger: DecisionWorkLedger,
        deadline: HTTPRequestDeadline | None = None,
        *,
        _preacquired: tuple[Any, ...] | None = None,
    ) -> None:
        self._ledger = ledger
        self._ledger_identity = id(ledger)
        self._deadline = deadline
        self._project_root: Path | None = None
        self._parent_root: Path | None = None
        self._organization: str | None = None
        self._application: str | None = None
        self._stable_id: str | None = None
        self._descriptor_raw: bytes | None = None
        self._scratch: bytearray | None = None
        self._parent_fd = -1
        self._project_fd = -1
        self._locks_fd = -1
        self._gate_fd = -1
        self._descriptor_fd = -1
        self._parent_identity: tuple[int, int] | None = None
        self._project_identity: tuple[int, int] | None = None
        self._locks_identity: tuple[int, int] | None = None
        self._gate_fingerprint: tuple[int, ...] | None = None
        self._descriptor_fingerprint: tuple[int, ...] | None = None
        self._path_transition: _StablePermitTransition | None = None
        self._transition: _StablePermitTransition | None = None
        self._work_transition: _StablePermitTransition | None = None
        self._retained_upper = 0
        self._temporary_upper = 0
        self._acquired_epoch: int | None = None
        self._proof_token: Any = object()
        self._carrier_owner: Any | None = None
        self._semantic_owner: Any | None = None
        self._factory_owned = _preacquired is not None
        self._lock_held = False
        self._closing = False
        self._closed = False
        self._state = self.INITIALIZING

        failure: BaseException | None = None
        try:
            if self.FLOCK is None or _CODEFIRE_OS_PREAD is None:
                raise CFError("existing project gate is unsupported on this platform")
            if _preacquired is None:
                if ledger.has_open_permits() or any(
                    ledger._current.get(name, 0)
                    for name in ("retained_bytes", "temporary_bytes")
                ):
                    raise CFError("existing project gate must precede live owners")
                path_transition = _StablePermitTransition(
                    ledger, temporary=self.PATH_PREFLIGHT_TEMPORARY_BYTES
                )
                self._path_transition = path_transition
                path_transition.reserve(
                    "record_read",
                    acquires={
                        "temporary_bytes": self.PATH_PREFLIGHT_TEMPORARY_BYTES
                    },
                )
                path_transition.consume(
                    phase="record_read",
                    acquires={
                        "temporary_bytes": self.PATH_PREFLIGHT_TEMPORARY_BYTES
                    },
                )
                absolute = Path(os.path.abspath(project_root))
                retained, temporary = self.live_upper(absolute)
                transition = _StablePermitTransition(
                    ledger,
                    retained_primary=retained,
                    temporary=temporary,
                )
                self._transition = transition
                transition.reserve(
                    "record_read",
                    acquires={
                        "retained_bytes": retained,
                        "temporary_bytes": temporary,
                    },
                )
                transition.consume(
                    phase="record_read",
                    acquires={
                        "retained_bytes": retained,
                        "temporary_bytes": temporary,
                    },
                )
            else:
                (
                    absolute,
                    path_transition,
                    transition,
                    retained,
                    temporary,
                ) = _preacquired
                if (
                    not isinstance(absolute, Path)
                    or type(path_transition) is not _StablePermitTransition
                    or type(transition) is not _StablePermitTransition
                ):
                    raise CFError("existing project gate preacquisition is invalid")
                self._path_transition = path_transition
                self._transition = transition
            validate_remote_component(organization, "organization")
            validate_remote_component(application, "application")
            if absolute.parent.name != organization or absolute.name != application:
                raise CFError("existing project gate path does not match org/app")
            self._project_root = absolute
            self._parent_root = absolute.parent
            self._organization = organization
            self._application = application
            self._retained_upper = retained
            self._temporary_upper = temporary
            path_transition.release_temporary()
            self._path_transition = None
            self._scratch = bytearray(self.MAX_DESCRIPTOR_BYTES + 1)
            self._open_subject()
            self._read_subject()
            if deadline is not None:
                deadline.check("upload existing project gate")
            self._probe_subject()
            self._acquired_epoch = ledger._mutation_epoch
            self._state = self.READY
        except BaseException as exc:
            _detach_exception_chain(exc)
            failure = exc
        if failure is not None:
            cleanup_failure: BaseException | None = None
            try:
                self._close_core(None, construction=True)
            except BaseException as exc:
                _detach_exception_chain(exc)
                cleanup_failure = exc
            if cleanup_failure is not None:
                raise cleanup_failure.with_traceback(None) from failure
            raise failure.with_traceback(None)

    def _ensure_ledger(self, ledger: DecisionWorkLedger) -> None:
        if ledger is not self._ledger or id(ledger) != self._ledger_identity:
            raise CFError("existing project gate belongs to another ledger")

    def _poll(self, phase: str) -> None:
        if self._deadline is not None:
            self._deadline.check(phase)

    def _open_subject(self) -> None:
        project_root = self._project_root
        parent_root = self._parent_root
        if project_root is None or parent_root is None:
            raise CFError("existing project gate path is unavailable")
        self._poll("upload existing project gate path")
        self._parent_fd = _open_directory_nofollow(parent_root)
        parent_stat = os.fstat(self._parent_fd)
        self._parent_identity = self._directory_identity(parent_stat)
        flags = os.O_RDONLY | getattr(os, "O_DIRECTORY", 0) | os.O_NOFOLLOW
        named_project = os.stat(
            project_root.name, dir_fd=self._parent_fd, follow_symlinks=False
        )
        self._project_fd = os.open(
            project_root.name, flags, dir_fd=self._parent_fd
        )
        opened_project = os.fstat(self._project_fd)
        project_identity = self._directory_identity(opened_project)
        if self._directory_identity(named_project) != project_identity:
            raise ExistingProjectGateChanged(project_root, "project_identity")
        self._project_identity = project_identity
        named_locks = os.stat(
            "locks", dir_fd=self._project_fd, follow_symlinks=False
        )
        self._locks_fd = os.open("locks", flags, dir_fd=self._project_fd)
        opened_locks = os.fstat(self._locks_fd)
        locks_identity = self._directory_identity(opened_locks)
        if self._directory_identity(named_locks) != locks_identity:
            raise ExistingProjectGateChanged(project_root, "locks_identity")
        self._locks_identity = locks_identity
        try:
            named_gate = os.stat(
                "project-gate.lock",
                dir_fd=self._locks_fd,
                follow_symlinks=False,
            )
        except FileNotFoundError:
            named_gate = None
        self._gate_fd = os.open(
            "project-gate.lock",
            os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW,
            0o600,
            dir_fd=self._locks_fd,
        )
        opened_gate = os.fstat(self._gate_fd)
        gate_fingerprint = self._fingerprint(opened_gate)
        if named_gate is not None and (
            self._regular_identity(named_gate)
            != self._regular_identity(opened_gate)
        ):
            raise ExistingProjectGateChanged(project_root, "gate_identity")
        self._regular_identity(opened_gate)
        self._gate_fingerprint = gate_fingerprint
        try:
            self.FLOCK(self._gate_fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError as exc:
            raise CFError(
                f"existing project gate is already held: {project_root}"
            ) from exc
        self._lock_held = True
        after_gate = os.stat(
            "project-gate.lock", dir_fd=self._locks_fd, follow_symlinks=False
        )
        if self._fingerprint(after_gate) != gate_fingerprint:
            raise ExistingProjectGateChanged(project_root, "gate_after_lock")

    def _read_exact(self, descriptor: int, physical_bytes: int) -> bytes:
        scratch = self._scratch
        if scratch is None:
            raise CFError("existing project gate scratch is unavailable")
        offset = 0
        while offset <= physical_bytes:
            chunk = _CODEFIRE_OS_PREAD(
                descriptor,
                physical_bytes + 1 - offset,
                offset,
            )
            if not chunk:
                break
            end = offset + len(chunk)
            scratch[offset:end] = chunk
            offset = end
        if offset != physical_bytes:
            raise ExistingProjectGateChanged(
                self._project_root, "descriptor_size"
            )
        return bytes(memoryview(scratch)[:physical_bytes])

    def _read_subject(self) -> None:
        project_root = self._project_root
        if project_root is None or self._project_fd < 0:
            raise CFError("existing project gate project capability is unavailable")
        initial = os.stat(
            "remote_project.json",
            dir_fd=self._project_fd,
            follow_symlinks=False,
        )
        self._regular_identity(initial)
        if initial.st_size < 0 or initial.st_size > self.MAX_DESCRIPTOR_BYTES:
            raise CFError("remote project descriptor exceeds 16 KiB")
        work = _StablePermitTransition(self._ledger)
        self._work_transition = work
        work.reserve(
            "record_read",
            charges={"aggregate_bytes": 2 * initial.st_size},
            counters={
                "files_read": 2,
                "file_bytes_read": 2 * initial.st_size,
            },
        )
        work.consume(
            phase="record_read",
            charges={"aggregate_bytes": 2 * initial.st_size},
            counters={
                "files_read": 2,
                "file_bytes_read": 2 * initial.st_size,
            },
        )
        work.cancel()
        self._work_transition = None
        self._descriptor_fd = os.open(
            "remote_project.json",
            os.O_RDONLY | os.O_NOFOLLOW,
            dir_fd=self._project_fd,
        )
        opened = os.fstat(self._descriptor_fd)
        if self._fingerprint(opened) != self._fingerprint(initial):
            raise ExistingProjectGateChanged(project_root, "descriptor_identity")
        raw = self._read_exact(self._descriptor_fd, initial.st_size)
        final = os.stat(
            "remote_project.json",
            dir_fd=self._project_fd,
            follow_symlinks=False,
        )
        if self._fingerprint(final) != self._fingerprint(initial):
            raise ExistingProjectGateChanged(project_root, "descriptor_final")
        stable_id = self._validate_descriptor(
            raw,
            project_root,
            self._organization,
            self._application,
        )
        self._descriptor_raw = raw
        self._stable_id = stable_id
        self._descriptor_fingerprint = self._fingerprint(initial)

    def _probe_subject(self) -> None:
        project_root = self._project_root
        parent_root = self._parent_root
        raw = self._descriptor_raw
        if (
            project_root is None
            or parent_root is None
            or raw is None
            or self._parent_fd < 0
            or self._project_fd < 0
            or self._locks_fd < 0
            or self._gate_fd < 0
            or self._descriptor_fd < 0
        ):
            raise CFError("existing project gate proof is unavailable")
        rebound_parent = -1
        try:
            rebound_parent = _open_directory_nofollow(parent_root)
            if any(
                self._directory_identity(metadata) != self._parent_identity
                for metadata in (
                    os.fstat(self._parent_fd),
                    os.fstat(rebound_parent),
                )
            ):
                raise ExistingProjectGateChanged(project_root, "project_parent")
            named_project = os.stat(
                project_root.name,
                dir_fd=self._parent_fd,
                follow_symlinks=False,
            )
            if (
                self._directory_identity(named_project) != self._project_identity
                or self._directory_identity(os.fstat(self._project_fd))
                != self._project_identity
            ):
                raise ExistingProjectGateChanged(project_root, "project_identity")
            named_locks = os.stat(
                "locks", dir_fd=self._project_fd, follow_symlinks=False
            )
            if (
                self._directory_identity(named_locks) != self._locks_identity
                or self._directory_identity(os.fstat(self._locks_fd))
                != self._locks_identity
            ):
                raise ExistingProjectGateChanged(project_root, "locks_identity")
            named_gate = os.stat(
                "project-gate.lock",
                dir_fd=self._locks_fd,
                follow_symlinks=False,
            )
            if any(
                self._fingerprint(metadata) != self._gate_fingerprint
                for metadata in (named_gate, os.fstat(self._gate_fd))
            ):
                raise ExistingProjectGateChanged(project_root, "gate_identity")
            named_descriptor = os.stat(
                "remote_project.json",
                dir_fd=self._project_fd,
                follow_symlinks=False,
            )
            if any(
                self._fingerprint(metadata) != self._descriptor_fingerprint
                for metadata in (
                    named_descriptor,
                    os.fstat(self._descriptor_fd),
                )
            ):
                raise ExistingProjectGateChanged(
                    project_root, "descriptor_identity"
                )
            current = self._read_exact(self._descriptor_fd, len(raw))
            if current != raw:
                raise ExistingProjectGateChanged(
                    project_root, "descriptor_content"
                )
        finally:
            if rebound_parent >= 0:
                self.CLOSE_CAPABILITY(rebound_parent)

    def _semantic_proof(
        self, ledger: DecisionWorkLedger, stable_id: str
    ) -> Any:
        self._ensure_ledger(ledger)
        if (
            self._state != self.READY
            or self._closed
            or not self._factory_owned
            or self._semantic_owner is not None
            or self._stable_id is not stable_id
        ):
            raise CFError("existing project gate semantic proof is unavailable")
        self._probe_subject()
        return self._proof_token

    def _publish_semantic(
        self,
        semantic: AccountedHTTPUploadSemantic,
        ledger: DecisionWorkLedger,
        token: Any,
    ) -> None:
        self._ensure_ledger(ledger)
        if (
            type(semantic) is not AccountedHTTPUploadSemantic
            or token is not self._proof_token
            or self._state != self.READY
            or self._closed
            or self._semantic_owner is not None
        ):
            raise CFError("existing project gate semantic publication is unavailable")
        self._semantic_owner = semantic

    def _baseline_values(
        self, ledger: DecisionWorkLedger, token: Any
    ) -> tuple[_StablePermitTransition, int, int, int]:
        self._ensure_ledger(ledger)
        transition = self._transition
        epoch = self._acquired_epoch
        if (
            token is not self._proof_token
            or self._state not in {self.READY, self.ADOPTED}
            or self._closed
            or transition is None
            or epoch is None
            or transition._permit is not None
            or not transition._retained_acquired
            or not transition._temporary_acquired
            or transition._retained_primary_released
            or transition._temporary_released
        ):
            raise CFError("existing project gate baseline proof is unavailable")
        return (
            transition,
            self._retained_upper,
            self._temporary_upper,
            epoch,
        )

    def prepare_semantic(
        self,
        source: AccountedHTTPUploadRequestSource,
        ledger: DecisionWorkLedger,
        remote_branch: str,
        deadline: HTTPRequestDeadline | None = None,
        *,
        _existing_effect_input: bool = False,
        _existing_response_input: Any | None = None,
    ) -> AccountedHTTPUploadSemantic:
        self._ensure_ledger(ledger)
        if self._state != self.READY or self._stable_id is None:
            raise CFError("existing project gate semantic handoff is unavailable")
        if deadline is not self._deadline:
            raise CFError("existing project gate requires the same deadline")
        return AccountedHTTPUploadSemantic(
            source,
            ledger,
            self._stable_id,
            remote_branch,
            deadline,
            True,
            self,
            _existing_effect_input,
            _existing_response_input,
        )

    def _capture_carrier_probe(
        self,
        carrier: Any,
        token: Any,
    ) -> tuple[Any, Any]:
        """Capture one hook-free terminal gate fence and its drift predicate."""
        gate_type = AccountedHTTPUploadExistingProjectGate
        selected_type = type
        object_getattribute = object.__getattribute__
        dict_item = dict.__getitem__
        dict_get = dict.get
        dict_keys = dict.keys
        dict_items = dict.items
        length_of = len
        missing = object()
        class_mapping = type.__getattribute__(gate_type, "__dict__")
        mapping_get = type(class_mapping).get
        dependency_names = (
            "__getattribute__",
            "__setattr__",
            "_probe_subject",
            "_read_exact",
            "_directory_identity",
            "_fingerprint",
            "_ensure_ledger",
            "_descriptor_identity",
            "_descriptor_is_owned",
            "_close_descriptor",
            "_close_core",
            "_close_from_carrier",
            "CLOSE_CAPABILITY",
            "FSTAT_CAPABILITY",
            "FLOCK",
            "READY",
            "ADOPTED",
            "CLOSED",
        )
        expected_class_dependencies = tuple(
            (name, mapping_get(class_mapping, name, missing))
            for name in dependency_names
        )
        probe_subject = mapping_get(class_mapping, "_probe_subject", missing)
        if selected_type(probe_subject) is not FunctionType:
            raise CFError("existing project gate terminal probe is unavailable")
        probe_globals = object_getattribute(probe_subject, "__globals__")
        global_names = (
            "_open_directory_nofollow",
            "_CODEFIRE_OS_PREAD",
            "_CODEFIRE_OS_CLOSE",
            "_CODEFIRE_OS_FSTAT",
            "os",
            "stat",
            "fcntl",
            "CFError",
            "ExistingProjectGateChanged",
        )
        expected_globals = tuple(
            (name, dict_get(probe_globals, name, missing))
            for name in global_names
        )
        os_module = dict_item(probe_globals, "os")
        stat_module = dict_item(probe_globals, "stat")
        fcntl_module = dict_item(probe_globals, "fcntl")
        os_mapping = object_getattribute(os_module, "__dict__")
        stat_mapping = object_getattribute(stat_module, "__dict__")
        fcntl_mapping = object_getattribute(fcntl_module, "__dict__")
        os_names = (
            "open",
            "close",
            "stat",
            "fstat",
            "O_RDONLY",
            "O_DIRECTORY",
            "O_NOFOLLOW",
            "sep",
        )
        stat_names = ("S_ISDIR",)
        fcntl_names = ("flock", "LOCK_EX", "LOCK_NB", "LOCK_UN")
        expected_os = tuple(
            (name, dict_get(os_mapping, name, missing)) for name in os_names
        )
        expected_stat = tuple(
            (name, dict_get(stat_mapping, name, missing))
            for name in stat_names
        )
        expected_fcntl = tuple(
            (name, dict_get(fcntl_mapping, name, missing))
            for name in fcntl_names
        )

        instance_mapping = object_getattribute(self, "__dict__")
        adopted_state = gate_type.ADOPTED
        expected_items = []
        for key, value in dict_items(instance_mapping):
            if key == "_carrier_owner":
                value = carrier
            elif key == "_stable_id":
                value = None
            elif key == "_state":
                value = adopted_state
            expected_items.append((key, value))
        expected_items = tuple(expected_items)

        project_root = dict_item(instance_mapping, "_project_root")
        parent_root = dict_item(instance_mapping, "_parent_root")
        raw = dict_item(instance_mapping, "_descriptor_raw")
        scratch = dict_item(instance_mapping, "_scratch")
        parent_fd = dict_item(instance_mapping, "_parent_fd")
        project_fd = dict_item(instance_mapping, "_project_fd")
        locks_fd = dict_item(instance_mapping, "_locks_fd")
        gate_fd = dict_item(instance_mapping, "_gate_fd")
        descriptor_fd = dict_item(instance_mapping, "_descriptor_fd")
        parent_identity = dict_item(instance_mapping, "_parent_identity")
        project_identity = dict_item(instance_mapping, "_project_identity")
        locks_identity = dict_item(instance_mapping, "_locks_identity")
        gate_fingerprint = dict_item(instance_mapping, "_gate_fingerprint")
        descriptor_fingerprint = dict_item(
            instance_mapping, "_descriptor_fingerprint"
        )
        gate_identity = (
            gate_fingerprint[1],
            gate_fingerprint[2],
        )
        descriptor_identity = (
            descriptor_fingerprint[1],
            descriptor_fingerprint[2],
        )
        owned_descriptor_identities = (
            (parent_fd, parent_identity),
            (project_fd, project_identity),
            (locks_fd, locks_identity),
            (gate_fd, gate_identity),
            (descriptor_fd, descriptor_identity),
        )
        if (
            project_root is None
            or parent_root is None
            or selected_type(raw) is not bytes
            or selected_type(scratch) is not bytearray
        ):
            raise CFError("existing project gate terminal subject is unavailable")
        parent_components = tuple(parent_root.parts[1:])
        project_name = project_root.name

        os_open = dict_item(os_mapping, "open")
        os_close = dict_item(os_mapping, "close")
        os_stat = dict_item(os_mapping, "stat")
        os_fstat = dict_item(os_mapping, "fstat")
        os_pread = dict_item(probe_globals, "_CODEFIRE_OS_PREAD")
        close_capability = gate_type.CLOSE_CAPABILITY
        flock_call = gate_type.FLOCK
        stat_isdir = dict_item(stat_mapping, "S_ISDIR")
        directory_flags = (
            dict_item(os_mapping, "O_RDONLY")
            | dict_item(os_mapping, "O_DIRECTORY")
            | dict_item(os_mapping, "O_NOFOLLOW")
        )
        os_separator = dict_item(os_mapping, "sep")
        lock_operation = (
            dict_item(fcntl_mapping, "LOCK_EX")
            | dict_item(fcntl_mapping, "LOCK_NB")
        )
        blocking_error = BlockingIOError
        error_type = CFError
        changed_error_type = ExistingProjectGateChanged
        bytes_type = bytes
        memoryview_type = memoryview

        def exact_state_intact() -> bool:
            if selected_type(self) is not gate_type:
                return False
            for name, expected in expected_class_dependencies:
                if mapping_get(class_mapping, name, missing) is not expected:
                    return False
            for name, expected in expected_globals:
                if dict_get(probe_globals, name, missing) is not expected:
                    return False
            for module_mapping, expected_dependencies in (
                (os_mapping, expected_os),
                (stat_mapping, expected_stat),
                (fcntl_mapping, expected_fcntl),
            ):
                for name, expected in expected_dependencies:
                    if dict_get(module_mapping, name, missing) is not expected:
                        return False
            actual_mapping = object_getattribute(self, "__dict__")
            if (
                actual_mapping is not instance_mapping
                or length_of(actual_mapping) != length_of(expected_items)
            ):
                return False
            position = 0
            for key in dict_keys(actual_mapping):
                expected_key, expected_value = expected_items[position]
                if (
                    key is not expected_key
                    or dict_item(actual_mapping, key) is not expected_value
                ):
                    return False
                position += 1
            return True

        def directory_identity(metadata: os.stat_result) -> tuple[int, int]:
            if not stat_isdir(metadata.st_mode):
                raise error_type(
                    "existing project gate requires directory capabilities"
                )
            return metadata.st_dev, metadata.st_ino

        def exact_fd_ownership_intact() -> bool:
            for descriptor, expected_identity in owned_descriptor_identities:
                if descriptor < 0 or expected_identity is None:
                    return False
                try:
                    metadata = os_fstat(descriptor)
                except OSError:
                    return False
                if (
                    metadata.st_dev,
                    metadata.st_ino,
                ) != expected_identity:
                    return False
            return True

        def fingerprint(metadata: os.stat_result) -> tuple[int, ...]:
            return (
                metadata.st_mode,
                metadata.st_dev,
                metadata.st_ino,
                metadata.st_nlink,
                metadata.st_size,
                metadata.st_mtime_ns,
                metadata.st_ctime_ns,
            )

        def exact_probe() -> None:
            if not exact_state_intact():
                raise error_type("existing project gate carrier proof changed")
            if not exact_fd_ownership_intact():
                raise error_type(
                    "existing project gate descriptor ownership changed"
                )
            if fingerprint(os_fstat(gate_fd)) != gate_fingerprint:
                raise changed_error_type(project_root, "gate_identity")
            try:
                flock_call(gate_fd, lock_operation)
            except blocking_error:
                raise changed_error_type(
                    project_root, "exclusive_gate"
                ) from None
            rebound_parent = -1
            try:
                rebound_parent = os_open(os_separator, directory_flags)
                for component in parent_components:
                    next_fd = os_open(
                        component, directory_flags, dir_fd=rebound_parent
                    )
                    os_close(rebound_parent)
                    rebound_parent = next_fd
                if (
                    directory_identity(os_fstat(parent_fd)) != parent_identity
                    or directory_identity(os_fstat(rebound_parent))
                    != parent_identity
                ):
                    raise changed_error_type(project_root, "project_parent")
                named_project = os_stat(
                    project_name,
                    dir_fd=parent_fd,
                    follow_symlinks=False,
                )
                if (
                    directory_identity(named_project) != project_identity
                    or directory_identity(os_fstat(project_fd))
                    != project_identity
                ):
                    raise changed_error_type(project_root, "project_identity")
                named_locks = os_stat(
                    "locks", dir_fd=project_fd, follow_symlinks=False
                )
                if (
                    directory_identity(named_locks) != locks_identity
                    or directory_identity(os_fstat(locks_fd)) != locks_identity
                ):
                    raise changed_error_type(project_root, "locks_identity")
                named_gate = os_stat(
                    "project-gate.lock",
                    dir_fd=locks_fd,
                    follow_symlinks=False,
                )
                if (
                    fingerprint(named_gate) != gate_fingerprint
                    or fingerprint(os_fstat(gate_fd)) != gate_fingerprint
                ):
                    raise changed_error_type(project_root, "gate_identity")
                named_descriptor = os_stat(
                    "remote_project.json",
                    dir_fd=project_fd,
                    follow_symlinks=False,
                )
                if (
                    fingerprint(named_descriptor) != descriptor_fingerprint
                    or fingerprint(os_fstat(descriptor_fd))
                    != descriptor_fingerprint
                ):
                    raise changed_error_type(
                        project_root, "descriptor_identity"
                    )
                physical_bytes = length_of(raw)
                offset = 0
                while offset <= physical_bytes:
                    chunk = os_pread(
                        descriptor_fd,
                        physical_bytes + 1 - offset,
                        offset,
                    )
                    if selected_type(chunk) is not bytes_type:
                        raise error_type(
                            "existing project gate descriptor read changed"
                        )
                    if not chunk:
                        break
                    end = offset + length_of(chunk)
                    scratch[offset:end] = chunk
                    offset = end
                if offset != physical_bytes:
                    raise changed_error_type(project_root, "descriptor_size")
                current = bytes_type(
                    memoryview_type(scratch)[:physical_bytes]
                )
                if current != raw:
                    raise changed_error_type(project_root, "descriptor_content")
            finally:
                if rebound_parent >= 0:
                    close_capability(rebound_parent)

        return exact_probe, exact_state_intact, exact_fd_ownership_intact

    def _adopt_carrier(
        self,
        carrier: Any,
        pair: AccountedHTTPUploadExistingTerminalOwner,
        semantic: AccountedHTTPUploadSemantic,
        ledger: DecisionWorkLedger,
        token: Any,
    ) -> tuple[str, Any]:
        self._ensure_ledger(ledger)
        sealed = object.__getattribute__(pair, "_sealed_owner")
        stable_id = self._stable_id
        if (
            type(carrier) is not AccountedHTTPUploadExistingPairSemanticCarrier
            or token is not self._proof_token
            or self._state != self.READY
            or self._closed
            or self._carrier_owner is not None
            or self._semantic_owner is not semantic
            or stable_id is None
            or type(sealed) is not AccountedHTTPUploadSealedValidation
            or object.__getattribute__(sealed, "_semantic_baseline_owner")
            is not semantic
            or object.__getattribute__(semantic, "_stable_gate_owner") is not self
            or object.__getattribute__(semantic, "_stable_gate_token") is not token
            or self._acquired_epoch is None
            or object.__getattribute__(sealed, "_construction_epoch")
            <= self._acquired_epoch
        ):
            raise CFError("existing project gate carrier proof is unavailable")
        self._probe_subject()
        (
            exact_probe,
            exact_state_intact,
            exact_fd_ownership_intact,
        ) = self._capture_carrier_probe(carrier, token)

        self._carrier_owner = carrier
        self._stable_id = None
        self._state = self.ADOPTED
        return (
            stable_id,
            exact_probe,
            exact_state_intact,
            exact_fd_ownership_intact,
        )

    def _rollback_carrier(self, carrier: Any, stable_id: str) -> None:
        if self._carrier_owner is carrier and self._state == self.ADOPTED:
            self._stable_id = stable_id
            self._carrier_owner = None
            self._state = self.READY

    def prepare_carrier(
        self,
        pair: AccountedHTTPUploadExistingTerminalOwner,
        semantic: AccountedHTTPUploadSemantic,
        ledger: DecisionWorkLedger,
    ) -> "AccountedHTTPUploadExistingPairSemanticCarrier":
        self._ensure_ledger(ledger)
        return AccountedHTTPUploadExistingPairSemanticCarrier(
            pair,
            semantic,
            ledger,
            _stable_gate_owner=self,
            _stable_gate_token=self._proof_token,
        )

    def _descriptor_identity(self, attribute: str) -> tuple[int, int] | None:
        if attribute == "_parent_fd":
            return object.__getattribute__(self, "_parent_identity")
        if attribute == "_project_fd":
            return object.__getattribute__(self, "_project_identity")
        if attribute == "_locks_fd":
            return object.__getattribute__(self, "_locks_identity")
        if attribute == "_gate_fd":
            fingerprint = object.__getattribute__(self, "_gate_fingerprint")
        elif attribute == "_descriptor_fd":
            fingerprint = object.__getattribute__(
                self, "_descriptor_fingerprint"
            )
        else:
            return None
        if fingerprint is None:
            return None
        return fingerprint[1], fingerprint[2]

    def _descriptor_is_owned(self, attribute: str, descriptor: int) -> bool:
        expected = self._descriptor_identity(attribute)
        if descriptor < 0 or expected is None:
            return False
        try:
            metadata = self.FSTAT_CAPABILITY(descriptor)
        except OSError:
            return False
        return (metadata.st_dev, metadata.st_ino) == expected

    def _close_descriptor(self, attribute: str) -> None:
        descriptor = object.__getattribute__(self, attribute)
        if descriptor < 0:
            return
        owned = self._descriptor_is_owned(attribute, descriptor)
        object.__setattr__(self, attribute, -1)
        if owned:
            self.CLOSE_CAPABILITY(descriptor)

    def _close_core(self, carrier: Any | None, *, construction: bool) -> None:
        if self._closed:
            return
        if self._closing:
            return
        if not construction and self._state == self.ADOPTED:
            if carrier is not self._carrier_owner:
                raise CFError("existing project gate was adopted by its carrier")
        if not construction and self._state == self.READY:
            semantic = self._semantic_owner
            if semantic is not None and not object.__getattribute__(
                semantic, "_closed"
            ):
                raise CFError("existing project gate still owns upload semantic")
        self._closing = True
        try:
            self._stable_id = None
            self._descriptor_raw = None
            self._scratch = None
            self._close_descriptor("_descriptor_fd")
            if self._lock_held:
                gate_fd = self._gate_fd
                if self._descriptor_is_owned("_gate_fd", gate_fd):
                    self.FLOCK(gate_fd, fcntl.LOCK_UN)
                self._lock_held = False
            self._close_descriptor("_gate_fd")
            self._close_descriptor("_locks_fd")
            self._close_descriptor("_project_fd")
            self._close_descriptor("_parent_fd")
            self._project_root = None
            self._parent_root = None
            self._organization = None
            self._application = None
            if self._path_transition is not None:
                self._path_transition.release_all()
                self._path_transition = None
            if self._work_transition is not None:
                self._work_transition.release_all()
                self._work_transition = None
            if self._transition is not None:
                self._transition.release_temporary()
                self._transition.release_retained_primary()
                self._transition = None
            self._carrier_owner = None
            self._semantic_owner = None
            self._state = self.CLOSED
            self._closed = True
        finally:
            self._closing = False

    def close(self, ledger: DecisionWorkLedger) -> None:
        self._ensure_ledger(ledger)
        self._close_core(None, construction=False)

    def _close_from_carrier(self, carrier: Any, ledger: DecisionWorkLedger) -> None:
        self._ensure_ledger(ledger)
        self._close_core(carrier, construction=False)

    def __del__(self) -> None:
        try:
            if self._state != self.ADOPTED:
                self._close_core(None, construction=True)
        except BaseException:
            pass


def prepare_http_upload_existing_project_gate(
    project_root: Path,
    organization: str,
    application: str,
    ledger: DecisionWorkLedger,
    deadline: HTTPRequestDeadline | None = None,
) -> AccountedHTTPUploadExistingProjectGate:
    """Preaccount the complete gate owner before its first owner allocation."""
    gate_type = AccountedHTTPUploadExistingProjectGate
    if ledger.has_open_permits() or any(
        ledger._current.get(name, 0)
        for name in ("retained_bytes", "temporary_bytes")
    ):
        raise CFError("existing project gate must precede live owners")
    path_transition = _StablePermitTransition(
        ledger, temporary=gate_type.PATH_PREFLIGHT_TEMPORARY_BYTES
    )
    transition: _StablePermitTransition | None = None
    owner: AccountedHTTPUploadExistingProjectGate | None = None
    failure: BaseException | None = None
    try:
        path_transition.reserve(
            "record_read",
            acquires={
                "temporary_bytes": gate_type.PATH_PREFLIGHT_TEMPORARY_BYTES
            },
        )
        path_transition.consume(
            phase="record_read",
            acquires={
                "temporary_bytes": gate_type.PATH_PREFLIGHT_TEMPORARY_BYTES
            },
        )
        absolute = Path(os.path.abspath(project_root))
        validate_remote_component(organization, "organization")
        validate_remote_component(application, "application")
        if absolute.parent.name != organization or absolute.name != application:
            raise CFError("existing project gate path does not match org/app")
        retained, temporary = gate_type.live_upper(absolute)
        transition = _StablePermitTransition(
            ledger,
            retained_primary=retained,
            temporary=temporary,
        )
        transition.reserve(
            "record_read",
            acquires={
                "retained_bytes": retained,
                "temporary_bytes": temporary,
            },
        )
        transition.consume(
            phase="record_read",
            acquires={
                "retained_bytes": retained,
                "temporary_bytes": temporary,
            },
        )
        owner = object.__new__(gate_type)
        gate_type.__init__(
            owner,
            absolute,
            organization,
            application,
            ledger,
            deadline,
            _preacquired=(
                absolute,
                path_transition,
                transition,
                retained,
                temporary,
            ),
        )
        return owner
    except BaseException as exc:
        _detach_exception_chain(exc)
        failure = exc
    cleanup_failure: BaseException | None = None
    try:
        if owner is not None and not object.__getattribute__(owner, "_closed"):
            owner._close_core(None, construction=True)
        else:
            if transition is not None:
                transition.release_all()
            path_transition.release_all()
    except BaseException as exc:
        _detach_exception_chain(exc)
        cleanup_failure = exc
    if cleanup_failure is not None:
        raise cleanup_failure.with_traceback(None) from failure
    raise failure.with_traceback(None)


class _HTTPUploadMissingBootstrapReducerCapability:
    """Private proof that a missing-project reducer owns the renamed gate."""

    __slots__ = ("_owner", "_token")

    def __init__(self, owner: Any, token: Any) -> None:
        self._owner = owner
        self._token = token


class _HTTPUploadMissingBootstrapHandoff:
    """Single typed transition surface for one prepared hidden project."""

    __slots__ = ("_owner", "_token")

    def __init__(self, owner: Any, token: Any) -> None:
        self._owner = owner
        self._token = token

    def start_effect(self, ledger: DecisionWorkLedger) -> None:
        owner = self._owner
        if type(owner) is not AccountedHTTPUploadMissingProjectBootstrapTransaction:
            raise CFError("missing-project bootstrap handoff is closed")
        owner._start_effect(self, self._token, ledger)

    def rename_visible(self, ledger: DecisionWorkLedger) -> None:
        owner = self._owner
        if type(owner) is not AccountedHTTPUploadMissingProjectBootstrapTransaction:
            raise CFError("missing-project bootstrap handoff is closed")
        owner._rename_visible(self, self._token, ledger)

    def reduce(self, ledger: DecisionWorkLedger) -> None:
        owner = self._owner
        if type(owner) is not AccountedHTTPUploadMissingProjectBootstrapTransaction:
            raise CFError("missing-project bootstrap handoff is closed")
        owner._reduce(self, self._token, ledger)

    def close(self, ledger: DecisionWorkLedger) -> None:
        owner = self._owner
        if type(owner) is not AccountedHTTPUploadMissingProjectBootstrapTransaction:
            return
        owner.close(ledger)


class AccountedHTTPUploadMissingProjectBootstrapTransaction:
    """Own one hidden missing-project bootstrap through its durable reducer.

    This production-unwired owner deliberately has no handler entry point.  It
    creates and gates a private stage under a pinned organization directory,
    publishes that exact inode with one relative no-replace rename, and keeps
    the original gate descriptor through a retryable durable-only reducer.
    """

    INITIALIZING = "INITIALIZING"
    PREPARED_HIDDEN = "PREPARED_HIDDEN"
    TERMINAL_READY = "TERMINAL_READY"
    EFFECT_STARTED = "EFFECT_STARTED"
    RENAMED_VISIBLE = "RENAMED_VISIBLE"
    REDUCING = "REDUCING"
    COMPLETE = "COMPLETE"
    CLOSED = "CLOSED"
    MAX_DESCRIPTOR_BYTES = 16 * 1024
    PATH_PREFLIGHT_TEMPORARY_BYTES = 64 * 1024
    CONTROL_RETAINED_BYTES = 96 * 1024
    CONTROL_TEMPORARY_BYTES = 512 * 1024
    CAPABILITY_COMPONENT_BYTES = 2048
    CAPABILITY_PATH_MULTIPLIER = 6
    CLOSE_CAPABILITY = staticmethod(_CODEFIRE_OS_CLOSE)
    FSTAT_CAPABILITY = staticmethod(_CODEFIRE_OS_FSTAT)
    FLOCK = staticmethod(fcntl.flock) if fcntl is not None else None
    FSYNC = staticmethod(os.fsync)
    RENAME_NOREPLACE = staticmethod(_rename_directory_noreplace_at)
    REMOVE_HIDDEN = staticmethod(shutil.rmtree)
    @classmethod
    def live_upper(cls, project_root: Path) -> tuple[int, int]:
        absolute = Path(os.path.abspath(project_root))
        path_bytes = len(os.fsencode(absolute))
        components = max(len(absolute.parts) - 1, 1)
        retained = (
            cls.CONTROL_RETAINED_BYTES
            + cls.MAX_DESCRIPTOR_BYTES
            + cls.CAPABILITY_COMPONENT_BYTES * (components + 18)
            + cls.CAPABILITY_PATH_MULTIPLIER * path_bytes
        )
        temporary = (
            cls.CONTROL_TEMPORARY_BYTES
            + cls.MAX_DESCRIPTOR_BYTES
            + cls.CAPABILITY_COMPONENT_BYTES * (components + 32)
            + cls.CAPABILITY_PATH_MULTIPLIER * path_bytes
        )
        if retained > U64_MAX or temporary > U64_MAX:
            raise CFError("missing-project bootstrap allocation upper overflows u64")
        return retained, temporary

    @classmethod
    def construction_upper(cls, project_root: Path) -> tuple[int, int]:
        retained, temporary = cls.live_upper(project_root)
        temporary += cls.PATH_PREFLIGHT_TEMPORARY_BYTES
        if temporary > U64_MAX:
            raise CFError("missing-project bootstrap construction upper overflows u64")
        return retained, temporary

    @staticmethod
    def _identity(metadata: os.stat_result) -> tuple[int, int]:
        return metadata.st_dev, metadata.st_ino

    @staticmethod
    def _fingerprint(metadata: os.stat_result) -> tuple[int, ...]:
        return (
            metadata.st_mode,
            metadata.st_dev,
            metadata.st_ino,
            metadata.st_nlink,
            metadata.st_size,
            metadata.st_mtime_ns,
            metadata.st_ctime_ns,
        )

    @staticmethod
    def _require_directory(metadata: os.stat_result) -> tuple[int, int]:
        if not stat.S_ISDIR(metadata.st_mode):
            raise CFError("missing-project bootstrap capability is not a directory")
        return metadata.st_dev, metadata.st_ino

    @staticmethod
    def _require_regular(metadata: os.stat_result) -> tuple[int, int]:
        if not stat.S_ISREG(metadata.st_mode) or metadata.st_nlink != 1:
            raise CFError("missing-project bootstrap requires single-link files")
        return metadata.st_dev, metadata.st_ino

    def __init__(
        self,
        project_root: Path,
        organization: str,
        application: str,
        stable_project_id: str,
        ledger: DecisionWorkLedger,
        durable_reducer: FunctionType,
        deadline: HTTPRequestDeadline | None = None,
        *,
        _preacquired: tuple[Any, ...] | None = None,
    ) -> None:
        self._ledger = ledger
        self._ledger_identity = id(ledger)
        self._deadline = deadline
        self._project_root: Path | None = None
        self._projects_root: Path | None = None
        self._organization: str | None = None
        self._application: str | None = None
        self._stable_project_id: str | None = None
        self._descriptor_raw: bytes | None = None
        self._stage_name: str | None = None
        self._stage_path: Path | None = None
        self._bootstrap_lock_name: str | None = None
        self._projects_fd = -1
        self._bootstrap_dir_fd = -1
        self._bootstrap_lock_fd = -1
        self._org_fd = -1
        self._stage_fd = -1
        self._locks_fd = -1
        self._gate_fd = -1
        self._descriptor_fd = -1
        self._projects_identity: tuple[int, int] | None = None
        self._bootstrap_dir_identity: tuple[int, int] | None = None
        self._bootstrap_lock_identity: tuple[int, int] | None = None
        self._org_identity: tuple[int, int] | None = None
        self._stage_identity: tuple[int, int] | None = None
        self._locks_identity: tuple[int, int] | None = None
        self._gate_identity: tuple[int, int] | None = None
        self._descriptor_identity: tuple[int, int] | None = None
        self._gate_fingerprint: tuple[int, ...] | None = None
        self._descriptor_fingerprint: tuple[int, ...] | None = None
        self._path_transition: _StablePermitTransition | None = None
        self._transition: _StablePermitTransition | None = None
        self._retained_upper = 0
        self._temporary_upper = 0
        self._token: Any = object()
        self._handoff: _HTTPUploadMissingBootstrapHandoff | None = None
        self._reducer_capability: _HTTPUploadMissingBootstrapReducerCapability | None = None
        self._durable_reducer: FunctionType | None = durable_reducer
        self._bootstrap_lock_held = False
        self._gate_lock_held = False
        self._stage_created = False
        self._renamed = False
        self._hidden_removed = False
        self._reducer_active = False
        self._closing = False
        self._closed = False
        self._state = self.INITIALIZING

        failure: BaseException | None = None
        try:
            if _preacquired is None:
                raise CFError("use prepare_http_upload_missing_project_bootstrap_transaction")
            if self.FLOCK is None or _CODEFIRE_OS_PREAD is None:
                raise CFError("missing-project bootstrap is unsupported on this platform")
            (
                absolute,
                path_transition,
                transition,
                retained,
                temporary,
            ) = _preacquired
            if (
                not isinstance(absolute, Path)
                or type(path_transition) is not _StablePermitTransition
                or type(transition) is not _StablePermitTransition
            ):
                raise CFError("missing-project bootstrap preacquisition is invalid")
            self._path_transition = path_transition
            self._transition = transition
            validate_remote_component(organization, "organization")
            validate_remote_component(application, "application")
            if absolute.parent.name != organization or absolute.name != application:
                raise CFError("missing-project bootstrap path does not match org/app")
            if (
                type(stable_project_id) is not str
                or re.fullmatch(
                    r"CF-PROJECT-[0-9a-f]{32}", stable_project_id
                )
                is None
            ):
                raise CFError("missing-project bootstrap stable ID is invalid")
            if type(durable_reducer) is not FunctionType:
                raise CFError("missing-project bootstrap reducer must be an exact function")
            self._project_root = absolute
            self._projects_root = absolute.parent.parent
            self._organization = organization
            self._application = application
            self._stable_project_id = stable_project_id
            self._retained_upper = retained
            self._temporary_upper = temporary
            self._stage_name = f".bootstrap-{stable_project_id}"
            self._stage_path = absolute.parent / self._stage_name
            lock_hash = hashlib.sha256(
                f"codefire-remote-project\0{organization}\0{application}".encode(
                    "utf-8"
                )
            ).hexdigest()
            self._bootstrap_lock_name = f"project-{lock_hash}.lock"
            descriptor = {
                "type": "codefire_remote_project",
                "version": 1,
                "stable_project_id": stable_project_id,
                "protocol_generation": 1,
                "organization": organization,
                "application": application,
                "creation_provenance": "authenticated_bootstrap_transaction",
                "created_at": now_iso(),
            }
            raw = canonical_json(descriptor) + b"\n"
            if len(raw) > self.MAX_DESCRIPTOR_BYTES:
                raise CFError("missing-project bootstrap descriptor exceeds 16 KiB")
            self._descriptor_raw = raw
            transition.consume(
                phase="staging",
                charges={"aggregate_bytes": len(raw)},
                acquires={
                    "retained_bytes": retained,
                    "temporary_bytes": temporary,
                },
            )
            transition.cancel()
            path_transition.release_temporary()
            self._path_transition = None
            self._handoff = _HTTPUploadMissingBootstrapHandoff(
                self, self._token
            )
            self._reducer_capability = (
                _HTTPUploadMissingBootstrapReducerCapability(
                    self, self._token
                )
            )
            self._open_namespace_and_stage()
            self._probe_subject(visible=False)
            self._state = self.PREPARED_HIDDEN
        except BaseException as exc:
            _detach_exception_chain(exc)
            failure = exc
        if failure is not None:
            cleanup_failure: BaseException | None = None
            try:
                self._close_core(construction=True)
            except BaseException as exc:
                _detach_exception_chain(exc)
                cleanup_failure = exc
            if cleanup_failure is not None:
                raise cleanup_failure.with_traceback(None) from failure
            raise failure.with_traceback(None)

    def _ensure_ledger(self, ledger: DecisionWorkLedger) -> None:
        if ledger is not self._ledger or id(ledger) != self._ledger_identity:
            raise CFError("missing-project bootstrap belongs to another ledger")

    def _open_single_link_lock(self, directory_fd: int, name: str) -> tuple[int, tuple[int, int]]:
        descriptor = os.open(
            name,
            os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW,
            0o600,
            dir_fd=directory_fd,
        )
        try:
            opened = os.fstat(descriptor)
            named = os.stat(name, dir_fd=directory_fd, follow_symlinks=False)
            opened_identity = self._require_regular(opened)
            if self._require_regular(named) != opened_identity:
                raise CFError(
                    "missing-project bootstrap lock identity changed"
                )
            return descriptor, opened_identity
        except BaseException:
            self.CLOSE_CAPABILITY(descriptor)
            raise

    def _open_namespace_and_stage(self) -> None:
        projects_root = self._projects_root
        project_root = self._project_root
        stage_name = self._stage_name
        lock_name = self._bootstrap_lock_name
        raw = self._descriptor_raw
        if (
            projects_root is None
            or project_root is None
            or stage_name is None
            or lock_name is None
            or raw is None
        ):
            raise CFError("missing-project bootstrap subject is unavailable")
        self._projects_fd = _open_directory_nofollow(projects_root)
        self._projects_identity = self._require_directory(
            os.fstat(self._projects_fd)
        )
        self._bootstrap_dir_fd = _open_or_create_directory_at(
            self._projects_fd, ".bootstrap-locks"
        )
        self._bootstrap_dir_identity = self._require_directory(
            os.fstat(self._bootstrap_dir_fd)
        )
        (
            self._bootstrap_lock_fd,
            self._bootstrap_lock_identity,
        ) = self._open_single_link_lock(
            self._bootstrap_dir_fd, lock_name
        )
        try:
            self.FLOCK(
                self._bootstrap_lock_fd,
                fcntl.LOCK_EX | fcntl.LOCK_NB,
            )
        except BlockingIOError as exc:
            raise CFError("missing-project bootstrap target is busy") from exc
        self._bootstrap_lock_held = True
        self._org_fd = _open_directory_at(self._projects_fd, self._organization)
        self._org_identity = self._require_directory(os.fstat(self._org_fd))
        try:
            os.stat(
                self._application,
                dir_fd=self._org_fd,
                follow_symlinks=False,
            )
        except FileNotFoundError:
            pass
        else:
            raise CFError("missing-project bootstrap target already exists")
        os.mkdir(stage_name, 0o700, dir_fd=self._org_fd)
        self._stage_created = True
        named_stage = os.stat(
            stage_name,
            dir_fd=self._org_fd,
            follow_symlinks=False,
        )
        self._stage_identity = self._require_directory(named_stage)
        self._stage_fd = _open_directory_at(self._org_fd, stage_name)
        if self._require_directory(os.fstat(self._stage_fd)) != self._stage_identity:
            raise CFError("missing-project bootstrap stage identity changed")
        _write_create_noreplace_at(
            self._stage_fd, "remote_project.json", raw
        )
        _create_remote_base_layout_at(self._stage_fd)
        self._locks_fd = _open_directory_at(self._stage_fd, "locks")
        self._locks_identity = self._require_directory(
            os.fstat(self._locks_fd)
        )
        self._gate_fd, self._gate_identity = self._open_single_link_lock(
            self._locks_fd, "project-gate.lock"
        )
        self.FLOCK(self._gate_fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        self._gate_lock_held = True
        gate_metadata = os.fstat(self._gate_fd)
        self._gate_fingerprint = self._fingerprint(gate_metadata)
        self._descriptor_fd = os.open(
            "remote_project.json",
            os.O_RDONLY | os.O_NOFOLLOW,
            dir_fd=self._stage_fd,
        )
        descriptor_metadata = os.fstat(self._descriptor_fd)
        self._descriptor_identity = self._require_regular(
            descriptor_metadata
        )
        self._descriptor_fingerprint = self._fingerprint(
            descriptor_metadata
        )
        self.FSYNC(self._stage_fd)

    def _expected_identity(self, attribute: str) -> tuple[int, int] | None:
        if attribute == "_projects_fd":
            return self._projects_identity
        if attribute == "_bootstrap_dir_fd":
            return self._bootstrap_dir_identity
        if attribute == "_bootstrap_lock_fd":
            return self._bootstrap_lock_identity
        if attribute == "_org_fd":
            return self._org_identity
        if attribute == "_stage_fd":
            return self._stage_identity
        if attribute == "_locks_fd":
            return self._locks_identity
        if attribute == "_gate_fd":
            return self._gate_identity
        if attribute == "_descriptor_fd":
            return self._descriptor_identity
        return None

    def _fd_is_owned(self, attribute: str, descriptor: int) -> bool:
        expected = self._expected_identity(attribute)
        if descriptor < 0 or expected is None:
            return False
        try:
            metadata = self.FSTAT_CAPABILITY(descriptor)
        except OSError:
            return False
        return self._identity(metadata) == expected

    def _all_fds_owned(self) -> bool:
        if not self._fd_is_owned("_projects_fd", self._projects_fd):
            return False
        if not self._fd_is_owned("_bootstrap_dir_fd", self._bootstrap_dir_fd):
            return False
        if not self._fd_is_owned(
            "_bootstrap_lock_fd", self._bootstrap_lock_fd
        ):
            return False
        if not self._fd_is_owned("_org_fd", self._org_fd):
            return False
        if not self._fd_is_owned("_stage_fd", self._stage_fd):
            return False
        if not self._fd_is_owned("_locks_fd", self._locks_fd):
            return False
        if not self._fd_is_owned("_gate_fd", self._gate_fd):
            return False
        return self._fd_is_owned(
            "_descriptor_fd", self._descriptor_fd
        )

    def _probe_subject(self, *, visible: bool) -> None:
        if not self._all_fds_owned():
            raise CFError("missing-project bootstrap descriptor ownership changed")
        project_root = self._project_root
        stage_name = self._stage_name
        raw = self._descriptor_raw
        if project_root is None or stage_name is None or raw is None:
            raise CFError("missing-project bootstrap proof is unavailable")
        selected_name = self._application if visible else stage_name
        named_stage = os.stat(
            selected_name,
            dir_fd=self._org_fd,
            follow_symlinks=False,
        )
        if self._require_directory(named_stage) != self._stage_identity:
            raise CFError("missing-project bootstrap stage identity changed")
        other_name = stage_name if visible else self._application
        try:
            os.stat(other_name, dir_fd=self._org_fd, follow_symlinks=False)
        except FileNotFoundError:
            pass
        else:
            raise CFError("missing-project bootstrap namespace is ambiguous")
        named_locks = os.stat(
            "locks", dir_fd=self._stage_fd, follow_symlinks=False
        )
        if self._require_directory(named_locks) != self._locks_identity:
            raise CFError("missing-project bootstrap locks identity changed")
        named_gate = os.stat(
            "project-gate.lock",
            dir_fd=self._locks_fd,
            follow_symlinks=False,
        )
        if (
            self._fingerprint(named_gate) != self._gate_fingerprint
            or self._fingerprint(os.fstat(self._gate_fd))
            != self._gate_fingerprint
        ):
            raise CFError("missing-project bootstrap gate identity changed")
        named_descriptor = os.stat(
            "remote_project.json",
            dir_fd=self._stage_fd,
            follow_symlinks=False,
        )
        if (
            self._fingerprint(named_descriptor)
            != self._descriptor_fingerprint
            or self._fingerprint(os.fstat(self._descriptor_fd))
            != self._descriptor_fingerprint
        ):
            raise CFError("missing-project bootstrap descriptor identity changed")
        current = _CODEFIRE_OS_PREAD(
            self._descriptor_fd, len(raw) + 1, 0
        )
        if current != raw:
            raise CFError("missing-project bootstrap descriptor content changed")
        self.FLOCK(
            self._bootstrap_lock_fd,
            fcntl.LOCK_EX | fcntl.LOCK_NB,
        )
        self.FLOCK(self._gate_fd, fcntl.LOCK_EX | fcntl.LOCK_NB)

    def _capture_callback_fence(
        self, ledger: DecisionWorkLedger
    ) -> tuple[FunctionType, FunctionType, Any, type[CFError]]:
        """Capture exact owner and primitive state around one callback."""
        selected_type = type
        owner_type = AccountedHTTPUploadMissingProjectBootstrapTransaction
        handoff_type = _HTTPUploadMissingBootstrapHandoff
        capability_type = _HTTPUploadMissingBootstrapReducerCapability
        object_getattribute = object.__getattribute__
        dict_get = dict.get
        dict_items = dict.items
        mapping_items = type(owner_type.__dict__).items
        length_of = len
        error_type = CFError
        probe = owner_type._probe_subject
        owner_mapping = type.__getattribute__(owner_type, "__dict__")
        handoff_mapping = type.__getattribute__(handoff_type, "__dict__")
        capability_mapping = type.__getattribute__(capability_type, "__dict__")
        expected_owner_items = tuple(mapping_items(owner_mapping))
        expected_handoff_items = tuple(mapping_items(handoff_mapping))
        expected_capability_items = tuple(mapping_items(capability_mapping))
        instance_mapping = object_getattribute(self, "__dict__")
        expected_instance_items = tuple(dict_items(instance_mapping))
        handoff = instance_mapping["_handoff"]
        capability = instance_mapping["_reducer_capability"]
        expected_handoff_owner = object_getattribute(handoff, "_owner")
        expected_handoff_token = object_getattribute(handoff, "_token")
        expected_capability_owner = object_getattribute(capability, "_owner")
        expected_capability_token = object_getattribute(capability, "_token")
        ledger_mapping = object_getattribute(ledger, "__dict__")
        expected_ledger_epoch = ledger_mapping["_mutation_epoch"]
        expected_ledger_current = ledger_mapping["_current"]
        expected_current_items = tuple(dict_items(expected_ledger_current))
        expected_ledger_reserved = ledger_mapping["_reserved"]
        expected_reserved_items = tuple(dict_items(expected_ledger_reserved))
        probe_globals = object_getattribute(probe, "__globals__")
        missing = object()
        global_names = (
            "AccountedHTTPUploadMissingProjectBootstrapTransaction",
            "_HTTPUploadMissingBootstrapHandoff",
            "_HTTPUploadMissingBootstrapReducerCapability",
            "_CODEFIRE_OS_PREAD",
            "FunctionType",
            "CFError",
            "os",
            "fcntl",
        )
        expected_globals = tuple(
            (name, dict_get(probe_globals, name, missing))
            for name in global_names
        )
        os_mapping = object_getattribute(probe_globals["os"], "__dict__")
        fcntl_mapping = object_getattribute(
            probe_globals["fcntl"], "__dict__"
        )
        expected_os = tuple(
            (name, dict_get(os_mapping, name, missing))
            for name in ("stat", "fstat")
        )
        expected_fcntl = tuple(
            (name, dict_get(fcntl_mapping, name, missing))
            for name in ("flock", "LOCK_EX", "LOCK_NB", "LOCK_UN")
        )

        def exact_items(current: Any, expected: tuple[Any, ...]) -> bool:
            current_items = mapping_items(current)
            if length_of(current) != length_of(expected):
                return False
            index = 0
            for key, value in current_items:
                expected_key, expected_value = expected[index]
                if key is not expected_key or value is not expected_value:
                    return False
                index += 1
            return True

        def exact_dict_items(current: dict[Any, Any], expected: tuple[Any, ...]) -> bool:
            if length_of(current) != length_of(expected):
                return False
            index = 0
            for key, value in dict_items(current):
                expected_key, expected_value = expected[index]
                if key is not expected_key or value is not expected_value:
                    return False
                index += 1
            return True

        def exact_state_intact() -> bool:
            if selected_type(self) is not owner_type:
                return False
            if not exact_items(owner_mapping, expected_owner_items):
                return False
            if not exact_items(handoff_mapping, expected_handoff_items):
                return False
            if not exact_items(capability_mapping, expected_capability_items):
                return False
            if not exact_dict_items(instance_mapping, expected_instance_items):
                return False
            if (
                object_getattribute(handoff, "_owner")
                is not expected_handoff_owner
                or object_getattribute(handoff, "_token")
                is not expected_handoff_token
                or object_getattribute(capability, "_owner")
                is not expected_capability_owner
                or object_getattribute(capability, "_token")
                is not expected_capability_token
            ):
                return False
            if object_getattribute(ledger, "__dict__") is not ledger_mapping:
                return False
            if ledger_mapping.get("_mutation_epoch") != expected_ledger_epoch:
                return False
            if ledger_mapping.get("_current") is not expected_ledger_current:
                return False
            if not exact_dict_items(expected_ledger_current, expected_current_items):
                return False
            if ledger_mapping.get("_reserved") is not expected_ledger_reserved:
                return False
            if not exact_dict_items(expected_ledger_reserved, expected_reserved_items):
                return False
            if ledger_mapping.get("_prepublication_sealed") is not True:
                return False
            for name, expected in expected_globals:
                if dict_get(probe_globals, name, missing) is not expected:
                    return False
            for mapping, expected_dependencies in (
                (os_mapping, expected_os),
                (fcntl_mapping, expected_fcntl),
            ):
                for name, expected in expected_dependencies:
                    if dict_get(mapping, name, missing) is not expected:
                        return False
            return True

        return probe, exact_state_intact, object.__setattr__, error_type

    def prepare_terminal(
        self, ledger: DecisionWorkLedger
    ) -> _HTTPUploadMissingBootstrapHandoff:
        self._ensure_ledger(ledger)
        if self._state != self.PREPARED_HIDDEN or self._handoff is None:
            raise CFError("missing-project bootstrap terminal handoff is unavailable")
        if not ledger._prepublication_sealed or ledger.has_open_permits():
            raise CFError("missing-project bootstrap terminal requires a sealed ledger")
        owner_type = AccountedHTTPUploadMissingProjectBootstrapTransaction
        capture_fence = owner_type._capture_callback_fence
        probe, exact_state_intact, _object_setattr, error_type = capture_fence(
            self, ledger
        )
        deadline = self._deadline
        if deadline is not None:
            deadline.check("upload missing bootstrap terminal")
        if not exact_state_intact():
            raise error_type(
                "missing-project bootstrap terminal dependency changed"
            )
        probe(self, visible=False)
        self._state = self.TERMINAL_READY
        return self._handoff

    def _validate_handoff(
        self,
        handoff: _HTTPUploadMissingBootstrapHandoff,
        token: Any,
        ledger: DecisionWorkLedger,
    ) -> None:
        self._ensure_ledger(ledger)
        if (
            type(handoff) is not _HTTPUploadMissingBootstrapHandoff
            or handoff is not self._handoff
            or token is not self._token
            or handoff._owner is not self
            or handoff._token is not token
            or self._closed
        ):
            raise CFError("missing-project bootstrap handoff proof changed")

    def _start_effect(
        self,
        handoff: _HTTPUploadMissingBootstrapHandoff,
        token: Any,
        ledger: DecisionWorkLedger,
    ) -> None:
        self._validate_handoff(handoff, token, ledger)
        if self._state != self.TERMINAL_READY:
            raise CFError("missing-project bootstrap effect-start is unavailable")
        self._probe_subject(visible=False)
        self._state = self.EFFECT_STARTED

    def _rename_is_committed(self) -> bool:
        try:
            os.stat(
                self._stage_name,
                dir_fd=self._org_fd,
                follow_symlinks=False,
            )
        except FileNotFoundError:
            pass
        else:
            return False
        try:
            visible = os.stat(
                self._application,
                dir_fd=self._org_fd,
                follow_symlinks=False,
            )
        except FileNotFoundError:
            return False
        return self._require_directory(visible) == self._stage_identity

    def _rename_visible(
        self,
        handoff: _HTTPUploadMissingBootstrapHandoff,
        token: Any,
        ledger: DecisionWorkLedger,
    ) -> None:
        self._validate_handoff(handoff, token, ledger)
        if self._state != self.EFFECT_STARTED:
            raise CFError("missing-project bootstrap rename is unavailable")
        if not self._renamed:
            self._probe_subject(visible=False)
            try:
                self.RENAME_NOREPLACE(
                    self._org_fd,
                    self._stage_name,
                    self._application,
                )
            except BaseException as exc:
                if not self._rename_is_committed():
                    raise
                _detach_exception_chain(exc)
            self._renamed = True
        self.FSYNC(self._org_fd)
        self._probe_subject(visible=True)
        self._state = self.RENAMED_VISIBLE

    def _reduce(
        self,
        handoff: _HTTPUploadMissingBootstrapHandoff,
        token: Any,
        ledger: DecisionWorkLedger,
    ) -> None:
        self._validate_handoff(handoff, token, ledger)
        if self._state not in {self.RENAMED_VISIBLE, self.REDUCING}:
            raise CFError("missing-project bootstrap reducer is unavailable")
        if self._reducer_active:
            raise CFError("missing-project bootstrap reducer is already active")
        reducer = self._durable_reducer
        capability = self._reducer_capability
        if type(reducer) is not FunctionType or type(capability) is not _HTTPUploadMissingBootstrapReducerCapability:
            raise CFError("missing-project bootstrap reducer proof changed")
        if capability._owner is not self or capability._token is not token:
            raise CFError("missing-project bootstrap reducer capability changed")
        self._probe_subject(visible=True)
        self._state = self.REDUCING
        owner_type = AccountedHTTPUploadMissingProjectBootstrapTransaction
        capture_fence = owner_type._capture_callback_fence
        probe, exact_state_intact, object_setattr, error_type = capture_fence(
            self, ledger
        )
        object_setattr(self, "_reducer_active", True)
        failure: BaseException | None = None
        result: Any = None
        try:
            result = reducer(capability)
        except BaseException as exc:
            _detach_exception_chain(exc)
            failure = exc
        finally:
            object_setattr(self, "_reducer_active", False)
        if not exact_state_intact():
            raise error_type(
                "missing-project bootstrap reducer dependency changed"
            )
        if failure is not None:
            raise failure.with_traceback(None)
        if result is not None:
            raise CFError("missing-project bootstrap reducer must not return a value")
        probe(self, visible=True)
        self._state = self.COMPLETE

    def _close_fd(self, attribute: str) -> None:
        descriptor = object.__getattribute__(self, attribute)
        if descriptor < 0:
            return
        owned = self._fd_is_owned(attribute, descriptor)
        object.__setattr__(self, attribute, -1)
        if owned:
            self.CLOSE_CAPABILITY(descriptor)

    def _remove_hidden_stage(self) -> None:
        if not self._stage_created or self._renamed or self._hidden_removed:
            return
        try:
            named = os.stat(
                self._stage_name,
                dir_fd=self._org_fd,
                follow_symlinks=False,
            )
        except FileNotFoundError:
            self._hidden_removed = True
            return
        if self._require_directory(named) != self._stage_identity:
            raise CFError("missing-project bootstrap hidden cleanup identity changed")
        self.REMOVE_HIDDEN(self._stage_path)
        self._hidden_removed = True
        self.FSYNC(self._org_fd)

    def _close_core(self, *, construction: bool) -> None:
        if self._closed or self._closing:
            return
        if (
            not construction
            and self._state
            in {self.EFFECT_STARTED, self.RENAMED_VISIBLE, self.REDUCING}
        ):
            raise CFError("missing-project bootstrap durable reducer is incomplete")
        self._closing = True
        try:
            self._descriptor_raw = None
            self._stable_project_id = None
            self._close_fd("_descriptor_fd")
            if self._gate_lock_held:
                if self._fd_is_owned("_gate_fd", self._gate_fd):
                    self.FLOCK(self._gate_fd, fcntl.LOCK_UN)
                self._gate_lock_held = False
            self._close_fd("_gate_fd")
            self._close_fd("_locks_fd")
            self._close_fd("_stage_fd")
            self._remove_hidden_stage()
            if self._bootstrap_lock_held:
                if self._fd_is_owned(
                    "_bootstrap_lock_fd", self._bootstrap_lock_fd
                ):
                    self.FLOCK(self._bootstrap_lock_fd, fcntl.LOCK_UN)
                self._bootstrap_lock_held = False
            self._close_fd("_bootstrap_lock_fd")
            self._close_fd("_org_fd")
            self._close_fd("_bootstrap_dir_fd")
            self._close_fd("_projects_fd")
            if self._transition is not None:
                self._transition.release_all()
                self._transition = None
            if self._path_transition is not None:
                self._path_transition.release_all()
                self._path_transition = None
            if self._handoff is not None:
                self._handoff._owner = None
                self._handoff._token = None
            if self._reducer_capability is not None:
                self._reducer_capability._owner = None
                self._reducer_capability._token = None
            self._durable_reducer = None
            self._state = self.CLOSED
            self._closed = True
        finally:
            self._closing = False

    def close(self, ledger: DecisionWorkLedger) -> None:
        self._ensure_ledger(ledger)
        self._close_core(construction=False)

    def __del__(self) -> None:
        try:
            if self._state in {
                self.INITIALIZING,
                self.PREPARED_HIDDEN,
                self.TERMINAL_READY,
            }:
                self._close_core(construction=True)
        except BaseException:
            pass


def prepare_http_upload_missing_project_bootstrap_transaction(
    project_root: Path,
    organization: str,
    application: str,
    stable_project_id: str,
    ledger: DecisionWorkLedger,
    durable_reducer: FunctionType,
    deadline: HTTPRequestDeadline | None = None,
) -> AccountedHTTPUploadMissingProjectBootstrapTransaction:
    """Preaccount and prepare one hidden, already-gated missing project."""
    owner_type = AccountedHTTPUploadMissingProjectBootstrapTransaction
    path_transition = _StablePermitTransition(
        ledger,
        temporary=owner_type.PATH_PREFLIGHT_TEMPORARY_BYTES,
    )
    transition: _StablePermitTransition | None = None
    owner: AccountedHTTPUploadMissingProjectBootstrapTransaction | None = None
    failure: BaseException | None = None
    try:
        path_transition.reserve(
            "staging",
            acquires={
                "temporary_bytes": owner_type.PATH_PREFLIGHT_TEMPORARY_BYTES
            },
        )
        path_transition.consume(
            phase="staging",
            acquires={
                "temporary_bytes": owner_type.PATH_PREFLIGHT_TEMPORARY_BYTES
            },
        )
        absolute = Path(os.path.abspath(project_root))
        retained, temporary = owner_type.live_upper(absolute)
        transition = _StablePermitTransition(
            ledger,
            retained_primary=retained,
            temporary=temporary,
        )
        transition.reserve(
            "staging",
            charges={"aggregate_bytes": owner_type.MAX_DESCRIPTOR_BYTES},
            acquires={
                "retained_bytes": retained,
                "temporary_bytes": temporary,
            },
        )
        owner = object.__new__(owner_type)
        owner_type.__init__(
            owner,
            absolute,
            organization,
            application,
            stable_project_id,
            ledger,
            durable_reducer,
            deadline,
            _preacquired=(
                absolute,
                path_transition,
                transition,
                retained,
                temporary,
            ),
        )
        return owner
    except BaseException as exc:
        _detach_exception_chain(exc)
        failure = exc
    cleanup_failure: BaseException | None = None
    try:
        if owner is not None:
            if not object.__getattribute__(owner, "_closed"):
                owner._close_core(construction=True)
        else:
            if transition is not None:
                transition.release_all()
            path_transition.release_all()
    except BaseException as exc:
        _detach_exception_chain(exc)
        cleanup_failure = exc
    if cleanup_failure is not None:
        raise cleanup_failure.with_traceback(None) from failure
    raise failure.with_traceback(None)


class AccountedHTTPUploadExistingPairSemanticCarrier:
    """Own one detached pair plus immutable semantic input, without effect API.

    This production-unwired carrier is deliberately payload-opaque.  It owns
    the exact pair/semantic parents before the pair's only final deadline
    callback, then commits the already-prepared mapping proxy and copy tuple
    only after both pair probes and the captured semantic probe succeed.
    """

    ADOPTED = "ADOPTED"
    FINALIZING = "FINALIZING"
    CLEANUP_PENDING = "CLEANUP_PENDING"
    READY = "READY"
    ABORT_ONLY = "ABORT_ONLY"
    CLOSED = "CLOSED"
    FIXED_RETAINED_BYTES = 0

    @classmethod
    def retained_upper(cls) -> int:
        """Conservative runtime upper for carrier-only Python heap owners."""
        instance_shell = object.__new__(cls)
        instance_bytes = sys.getsizeof(instance_shell)
        instance_shell = None
        carrier_dict_bytes = sys.getsizeof(dict.fromkeys(range(64)))
        five_field_dict = dict.fromkeys(range(5))
        destination_bytes = (
            sys.getsizeof(five_field_dict)
            + sys.getsizeof(MappingProxyType(five_field_dict))
        )
        state_shells = 3 * (
            sys.getsizeof((None,) * 6)
            + sys.getsizeof((None,) * 64)
            + sys.getsizeof((None,) * 12)
        )
        captured = (lambda value: (lambda: value))(None)
        function_bytes = sys.getsizeof(captured)
        cell_bytes = sys.getsizeof(tuple.__getitem__(captured.__closure__, 0))
        closure_bytes = 6 * (
            function_bytes + sys.getsizeof((None,) * 40)
        ) + 96 * cell_bytes
        fixed_shells = (
            sys.getsizeof([])
            + sys.getsizeof(object())
            + 6 * sys.getsizeof((None,) * 8)
        )
        measured = (
            instance_bytes
            + carrier_dict_bytes
            + destination_bytes
            + state_shells
            + closure_bytes
            + fixed_shells
        )
        page = 4096
        return max(2 * page, ((measured + page - 1) // page) * page)

    @staticmethod
    def _bind_sources(
        ledger: DecisionWorkLedger,
        pair: AccountedHTTPUploadExistingTerminalOwner,
        semantic: AccountedHTTPUploadSemantic,
        owner: "AccountedHTTPUploadExistingPairSemanticCarrier",
        token: Any,
    ) -> None:
        if object.__getattribute__(ledger, "_upload_terminal_owner") is not pair:
            raise CFError("HTTP upload pair semantic carrier requires pair registry")
        # Registry-first linearization blocks every stale pair/semantic alias
        # before either diagnostic mirror is published.
        object.__setattr__(ledger, "_upload_terminal_owner", owner)
        object.__setattr__(pair, "_pair_semantic_carrier_owner", owner)
        object.__setattr__(pair, "_pair_semantic_carrier_token", token)
        object.__setattr__(semantic, "_pair_semantic_carrier_owner", owner)

    @staticmethod
    def _rollback_bind(
        ledger: DecisionWorkLedger,
        pair: AccountedHTTPUploadExistingTerminalOwner,
        semantic: AccountedHTTPUploadSemantic,
        owner: "AccountedHTTPUploadExistingPairSemanticCarrier",
        token: Any,
    ) -> None:
        if object.__getattribute__(semantic, "_pair_semantic_carrier_owner") is owner:
            object.__setattr__(semantic, "_pair_semantic_carrier_owner", None)
        if object.__getattribute__(pair, "_pair_semantic_carrier_owner") is owner:
            object.__setattr__(pair, "_pair_semantic_carrier_owner", None)
        if object.__getattribute__(pair, "_pair_semantic_carrier_token") is token:
            object.__setattr__(pair, "_pair_semantic_carrier_token", None)
        if object.__getattribute__(ledger, "_upload_terminal_owner") is owner:
            object.__setattr__(ledger, "_upload_terminal_owner", pair)

    @staticmethod
    def _capture_state(
        owner: Any,
        owner_type: type,
        required_names: tuple[str, ...],
    ) -> tuple[Any, ...]:
        class_mapping = type.__getattribute__(owner_type, "__dict__")
        descriptor = MappingProxyType.__getitem__(class_mapping, "__dict__")
        descriptor_get = type(descriptor).__get__
        instance_mapping = descriptor_get(descriptor, owner, owner_type)
        if type(instance_mapping) is not dict:
            raise CFError("HTTP upload pair semantic carrier requires exact state")
        keys = tuple(dict.keys(instance_mapping))
        positions = []
        for required_name in required_names:
            for index, key in enumerate(keys):
                if key == required_name:
                    positions.append(index)
                    break
            else:
                raise CFError("HTTP upload pair semantic carrier state is incomplete")
        return (
            owner,
            owner_type,
            descriptor,
            instance_mapping,
            keys,
            tuple(positions),
        )

    def __init__(
        self,
        pair: AccountedHTTPUploadExistingTerminalOwner,
        semantic: AccountedHTTPUploadSemantic,
        ledger: DecisionWorkLedger,
        *,
        _stable_gate_owner: Any | None = None,
        _stable_gate_token: Any | None = None,
    ) -> None:
        if type(pair) is not AccountedHTTPUploadExistingTerminalOwner:
            raise CFError("HTTP upload pair semantic carrier requires an exact pair")
        if type(semantic) is not AccountedHTTPUploadSemantic:
            raise CFError("HTTP upload pair semantic carrier requires an exact semantic")
        if (
            semantic._stable_gate_owner is None
        ) != (_stable_gate_owner is None):
            raise CFError("HTTP upload pair semantic carrier requires an exact gate")
        if (_stable_gate_owner is None) != (_stable_gate_token is None):
            raise CFError("HTTP upload pair semantic carrier gate proof is incomplete")
        if _stable_gate_owner is not None and (
            type(_stable_gate_owner)
            is not AccountedHTTPUploadExistingProjectGate
            or semantic._stable_gate_owner is not _stable_gate_owner
            or semantic._stable_gate_token is not _stable_gate_token
        ):
            raise CFError("HTTP upload pair semantic carrier requires an exact gate")
        pair._ensure_ledger(ledger)
        semantic._ensure_ledger(ledger)
        if (
            pair._closed
            or pair._operating
            or pair._closing
            or pair._close_requested
            or pair._state != pair.ANCESTRY_DONE
            or pair._pair_resources_released
            or pair._pair_semantic_carrier_owner is not None
            or pair._sealed_owner is None
            or type(pair._sealed_owner)
            is not AccountedHTTPUploadSealedValidation
            or type(pair._policy_authority)
            is not AccountedRemoteSignaturePolicyAuthority
            or pair._sealed_owner._semantic_baseline_owner is not semantic
            or pair._sealed_owner._semantic_baseline_proof is None
            or object.__getattribute__(ledger, "_upload_terminal_owner") is not pair
        ):
            raise CFError("HTTP upload pair semantic carrier requires ancestry-complete pair")
        if (
            semantic._closed
            or semantic._preparing
            or semantic._terminal_active
            or semantic._terminal_started
            or semantic._terminal_complete
            or semantic._terminal_failed
            or semantic._closing
            or semantic._close_requested
            or not semantic._prepared
            or semantic._digest_owner is not None
            or semantic._terminal_probe_owner is not None
            or semantic._pair_semantic_carrier_owner is not None
        ):
            raise CFError("HTTP upload pair semantic carrier requires prepared semantic")
        if pair._deadline is not semantic._deadline:
            raise CFError("HTTP upload pair semantic carrier requires the same deadline")
        mapping = semantic._semantic
        view = semantic._semantic_view
        copy_bytes = semantic._copy_bytes
        if (
            type(mapping) is not dict
            or type(view) is not MappingProxyType
            or type(copy_bytes) is not tuple
        ):
            raise CFError("HTTP upload pair semantic carrier input is incomplete")
        remote_branch = dict.get(mapping, "remote_branch")
        head = dict.get(mapping, "head")
        semantic_keys = (
            "stable_project_id",
            "remote_branch",
            "local_branch",
            "head",
            "object_set_digest",
        )
        if tuple(dict.keys(mapping)) != semantic_keys:
            raise CFError("HTTP upload pair semantic carrier mapping changed")
        semantic_values = tuple(dict.__getitem__(mapping, key) for key in semantic_keys)
        if (
            type(remote_branch) is not str
            or type(head) is not str
            or type(pair._verified_branch) is not str
            or type(pair._verified_head) is not str
            or not hmac.compare_digest(remote_branch, pair._verified_branch)
            or not hmac.compare_digest(head, pair._verified_head)
        ):
            raise CFError("HTTP upload pair semantic carrier subject mismatch")
        if any(type(value) is not str for value in semantic_values):
            raise CFError("HTTP upload pair semantic carrier mapping is incomplete")
        # Never carry the source MappingProxy: a caller may still hold the
        # original mutable backing dict.  Only immutable scalar refs enter a
        # fresh private backing dict whose sole direct reference dies here.
        destination_backing = dict(zip(semantic_keys, semantic_values))
        destination_view = MappingProxyType(destination_backing)
        destination_backing = None

        self._ledger = ledger
        self._ledger_identity = id(ledger)
        self._pair_owner: AccountedHTTPUploadExistingTerminalOwner | None = pair
        self._semantic_owner: AccountedHTTPUploadSemantic | None = semantic
        self._pair_token: Any | None = object()
        self._stable_gate_owner: Any | None = _stable_gate_owner
        self._stable_gate_token: Any | None = _stable_gate_token
        self._stable_project_id: str | None = None
        self._stable_gate_probe: Any | None = None
        self._stable_gate_intact: Any | None = None
        self._stable_gate_fd_intact: Any | None = None
        self._response_probe_intact: Any | None = None
        self._publication_probe_intact: Any | None = None
        self._stable_gate_close: Any | None = (
            AccountedHTTPUploadExistingProjectGate._close_from_carrier
            if _stable_gate_owner is not None
            else None
        )
        self._pair_class_mapping = type.__getattribute__(
            AccountedHTTPUploadExistingTerminalOwner, "__dict__"
        )
        self._pair_getattribute = type(self._pair_class_mapping).get(
            self._pair_class_mapping, "__getattribute__", None
        )
        self._pair_setattr = type(self._pair_class_mapping).get(
            self._pair_class_mapping, "__setattr__", None
        )
        critical_types = (
            AccountedHTTPUploadExistingTerminalOwner,
            AccountedHTTPUploadSealedValidation,
            AccountedRemoteSignaturePolicyAuthority,
            AccountedHTTPUploadSemantic,
            AccountedHTTPUploadExistingPairSemanticCarrier,
            AccountedHTTPUploadResponseInput,
            _PreparedHTTPResponseOwner,
            DecisionWorkLedger,
        ) + (
            (AccountedHTTPUploadExistingPublicationInput,)
            if semantic._publication_input is not None
            else ()
        ) + (
            (AccountedHTTPUploadExistingProjectGate,)
            if _stable_gate_owner is not None
            else ()
        )
        critical_states = []
        for critical_type in critical_types:
            class_mapping = type.__getattribute__(critical_type, "__dict__")
            mapping_get = type(class_mapping).get
            critical_states.append(
                (
                    class_mapping,
                    mapping_get(class_mapping, "__getattribute__", None),
                    mapping_get(class_mapping, "__setattr__", None),
                )
            )
        self._critical_class_states = tuple(critical_states)
        critical_states = None
        critical_types = None
        self._effect_semantic: MappingProxyType | None = None
        self._effect_copy_bytes: tuple[bytes, ...] | None = None
        self._effect_input_owner: Any | None = None
        self._effect_input_token: Any | None = None
        self._effect_input_finish: Any | None = None
        self._input_committed = False
        self._semantic_probe_owner: _HTTPUploadSemanticTerminalProbe | None = None
        self._semantic_probe: Any | None = None
        self._semantic_commit: Any | None = None
        self._pair_finalize = AccountedHTTPUploadExistingTerminalOwner.finalize_pair
        self._pair_close = AccountedHTTPUploadExistingTerminalOwner.close
        self._semantic_cleanup = (
            AccountedHTTPUploadSemantic._cleanup_terminal_for_pair_semantic_carrier
        )
        self._semantic_payload_close = (
            AccountedHTTPUploadSemantic._close_payload_from_pair_semantic_carrier
        )
        self._semantic_control_release = (
            AccountedHTTPUploadSemantic._release_pair_semantic_carrier_control
        )
        self._state = self.ADOPTED
        self._operating = False
        self._closing = False
        self._close_requested = False
        self._closed = False

        probe: _HTTPUploadSemanticTerminalProbe | None = None
        bound = False
        gate_bound = False
        adopted_stable_id: str | None = None
        exact_gate_intact: Any | None = None
        exact_gate_fd_intact: Any | None = None
        failure: BaseException | None = None
        try:
            if (
                pair._state != pair.ANCESTRY_DONE
                or pair._closed
                or pair._operating
                or pair._closing
                or pair._close_requested
                or pair._pair_semantic_carrier_owner is not None
                or semantic._closed
                or semantic._preparing
                or semantic._terminal_active
                or semantic._terminal_started
                or semantic._terminal_complete
                or semantic._terminal_failed
                or semantic._closing
                or semantic._close_requested
                or not semantic._prepared
                or semantic._terminal_probe_owner is not None
                or semantic._pair_semantic_carrier_owner is not None
                or semantic._semantic is not mapping
                or semantic._semantic_view is not view
                or semantic._copy_bytes is not copy_bytes
                or pair._deadline is not semantic._deadline
                or pair._sealed_owner is None
                or pair._sealed_owner._semantic_baseline_owner is not semantic
                or pair._sealed_owner._semantic_baseline_proof is None
                or not AccountedHTTPUploadSealedValidation
                ._semantic_baseline_intact(
                    pair._sealed_owner._semantic_baseline_proof,
                    require_current=False,
                )
                or object.__getattribute__(ledger, "_upload_terminal_owner") is not pair
            ):
                raise CFError("HTTP upload pair semantic carrier source changed")
            probe = _HTTPUploadSemanticTerminalProbe(semantic)
            exact_probe = probe.capture()
            response_probe = None
            response_probe_intact = None
            if semantic._response_input is not None:
                (
                    response_probe,
                    response_probe_intact,
                ) = semantic._response_input._capture_terminal_probe(
                    semantic, semantic._response_token
                )
                self._response_probe_intact = response_probe_intact
            publication_probe = None
            publication_probe_intact = None
            if semantic._publication_input is not None:
                (
                    publication_probe,
                    publication_probe_intact,
                ) = semantic._publication_input._capture_terminal_probe(
                    semantic, semantic._publication_token
                )
                self._publication_probe_intact = publication_probe_intact
            self._semantic_probe_owner = probe
            if _stable_gate_owner is not None:
                (
                    adopted_stable_id,
                    exact_gate_probe,
                    exact_gate_intact,
                    exact_gate_fd_intact,
                ) = (
                    _stable_gate_owner._adopt_carrier(
                        self,
                        pair,
                        semantic,
                        ledger,
                        _stable_gate_token,
                    )
                )
                gate_bound = True
                if (
                    type(adopted_stable_id) is not str
                    or dict.__getitem__(mapping, "stable_project_id")
                    is not adopted_stable_id
                ):
                    raise CFError(
                        "HTTP upload pair semantic carrier stable identity changed"
                    )

                def combined_probe() -> None:
                    exact_gate_probe()
                    exact_probe()
                    if response_probe is not None:
                        response_probe()
                    if publication_probe is not None:
                        publication_probe()

                self._stable_project_id = adopted_stable_id
                self._stable_gate_probe = exact_gate_probe
                self._stable_gate_intact = exact_gate_intact
                self._stable_gate_fd_intact = exact_gate_fd_intact
                self._semantic_probe = combined_probe
            else:
                if response_probe is None and publication_probe is None:
                    self._semantic_probe = exact_probe
                else:
                    def combined_input_probe() -> None:
                        exact_probe()
                        if response_probe is not None:
                            response_probe()
                        if publication_probe is not None:
                            publication_probe()

                    self._semantic_probe = combined_input_probe

            carrier_state = self._capture_state(
                self,
                AccountedHTTPUploadExistingPairSemanticCarrier,
                (
                    "_pair_owner",
                    "_semantic_owner",
                    "_effect_semantic",
                    "_effect_copy_bytes",
                    "_input_committed",
                    "_state",
                    "_close_requested",
                    "_stable_gate_owner",
                    "_stable_gate_token",
                    "_stable_project_id",
                    "_stable_gate_intact",
                    "_stable_gate_fd_intact",
                ),
            )
            semantic_state = self._capture_state(
                semantic,
                AccountedHTTPUploadSemantic,
                (
                    "_semantic",
                    "_semantic_view",
                    "_copy_bytes",
                    "_request_digest",
                    "_record_refs",
                    "_sorted_refs",
                    "_terminal_started",
                    "_terminal_revalidated",
                    "_pair_semantic_carrier_owner",
                    "_terminal_probe_owner",
                ),
            )
            pair_state = self._capture_state(
                pair,
                AccountedHTTPUploadExistingTerminalOwner,
                (
                    "_pair_semantic_carrier_owner",
                    "_state",
                    "_verified_branch",
                    "_verified_head",
                    "_sealed_owner",
                ),
            )
            sealed_owner = pair._sealed_owner
            semantic_baseline_proof = sealed_owner._semantic_baseline_proof
            verified_branch = pair._verified_branch
            verified_head = pair._verified_head
            descriptor_get = type(tuple.__getitem__(carrier_state, 2)).__get__
            object_getattribute = object.__getattribute__
            selected_type = type
            length_of = len
            dict_type = dict
            dict_keys = dict.keys
            dict_item = dict.__getitem__
            dict_set = dict.__setitem__
            tuple_item = tuple.__getitem__
            carrier_type = AccountedHTTPUploadExistingPairSemanticCarrier
            semantic_type = AccountedHTTPUploadSemantic
            pair_type = AccountedHTTPUploadExistingTerminalOwner
            error_type = CFError
            index_range = range
            finalizing_state = self.FINALIZING
            pair_detaching_state = pair.PAIR_DETACHING
            semantic_baseline_intact = (
                AccountedHTTPUploadSealedValidation._semantic_baseline_intact
            )
            gate = [True]

            def validate_state(state: tuple[Any, ...], expected_type: type) -> dict[str, Any]:
                owner = tuple_item(state, 0)
                if selected_type(owner) is not expected_type:
                    raise error_type("HTTP upload pair semantic carrier type changed")
                expected_mapping = tuple_item(state, 3)
                expected_keys = tuple_item(state, 4)
                actual_mapping = descriptor_get(
                    tuple_item(state, 2), owner, expected_type
                )
                if (
                    actual_mapping is not expected_mapping
                    or selected_type(actual_mapping) is not dict_type
                    or length_of(actual_mapping) != length_of(expected_keys)
                ):
                    raise error_type("HTTP upload pair semantic carrier state changed")
                key_index = 0
                for key in dict_keys(actual_mapping):
                    if key is not tuple_item(expected_keys, key_index):
                        raise error_type(
                            "HTTP upload pair semantic carrier state keys changed"
                        )
                    key_index += 1
                return actual_mapping

            def state_key(state: tuple[Any, ...], position: int) -> str:
                return tuple_item(
                    tuple_item(state, 4),
                    tuple_item(tuple_item(state, 5), position),
                )

            def commit_input() -> None:
                if not list.__getitem__(gate, 0):
                    raise error_type("HTTP upload pair semantic carrier commit is single-use")
                carrier_mapping = validate_state(carrier_state, carrier_type)
                semantic_mapping = validate_state(semantic_state, semantic_type)
                pair_mapping = validate_state(pair_state, pair_type)
                if (
                    object_getattribute(ledger, "_upload_terminal_owner") is not self
                    or
                    dict_item(carrier_mapping, state_key(carrier_state, 0)) is not pair
                    or dict_item(carrier_mapping, state_key(carrier_state, 1))
                    is not semantic
                    or dict_item(carrier_mapping, state_key(carrier_state, 5))
                    != finalizing_state
                    or dict_item(carrier_mapping, state_key(carrier_state, 6))
                    is not False
                    or dict_item(carrier_mapping, state_key(carrier_state, 7))
                    is not _stable_gate_owner
                    or dict_item(carrier_mapping, state_key(carrier_state, 8))
                    is not _stable_gate_token
                    or dict_item(carrier_mapping, state_key(carrier_state, 9))
                    is not adopted_stable_id
                    or dict_item(carrier_mapping, state_key(carrier_state, 10))
                    is not exact_gate_intact
                    or dict_item(carrier_mapping, state_key(carrier_state, 11))
                    is not exact_gate_fd_intact
                    or dict_item(semantic_mapping, state_key(semantic_state, 0))
                    is not mapping
                    or dict_item(semantic_mapping, state_key(semantic_state, 1))
                    is not view
                    or dict_item(semantic_mapping, state_key(semantic_state, 2))
                    is not copy_bytes
                    or dict_item(semantic_mapping, state_key(semantic_state, 8))
                    is not self
                    or dict_item(semantic_mapping, state_key(semantic_state, 9))
                    is not None
                    or dict_item(pair_mapping, state_key(pair_state, 0)) is not self
                    or dict_item(pair_mapping, state_key(pair_state, 1))
                    != pair_detaching_state
                    or dict_item(pair_mapping, state_key(pair_state, 2))
                    is not verified_branch
                    or dict_item(pair_mapping, state_key(pair_state, 3))
                    is not verified_head
                    or dict_item(pair_mapping, state_key(pair_state, 4))
                    is not sealed_owner
                    or object_getattribute(
                        sealed_owner, "_semantic_baseline_owner"
                    )
                    is not semantic
                    or object_getattribute(
                        sealed_owner, "_semantic_baseline_proof"
                    )
                    is not semantic_baseline_proof
                    or not semantic_baseline_intact(
                        semantic_baseline_proof,
                        require_current=False,
                    )
                ):
                    raise error_type("HTTP upload pair semantic carrier input changed")
                list.__setitem__(gate, 0, False)
                dict_set(
                    carrier_mapping,
                    state_key(carrier_state, 2),
                    destination_view,
                )
                dict_set(carrier_mapping, state_key(carrier_state, 3), copy_bytes)
                dict_set(carrier_mapping, state_key(carrier_state, 4), True)
                for position in index_range(6):
                    dict_set(
                        semantic_mapping,
                        state_key(semantic_state, position),
                        None,
                    )
                dict_set(
                    semantic_mapping,
                    state_key(semantic_state, 6),
                    True,
                )
                dict_set(
                    semantic_mapping,
                    state_key(semantic_state, 7),
                    True,
                )

            self._semantic_commit = commit_input
            self._bind_sources(ledger, pair, semantic, self, self._pair_token)
            bound = True
            if (
                object.__getattribute__(ledger, "_upload_terminal_owner") is not self
                or pair._pair_semantic_carrier_owner is not self
                or pair._pair_semantic_carrier_token is not self._pair_token
                or semantic._pair_semantic_carrier_owner is not self
            ):
                raise CFError("HTTP upload pair semantic carrier bind is incomplete")
        except BaseException as exc:
            _detach_exception_chain(exc)
            failure = exc
        if failure is not None:
            cleanup_failure: BaseException | None = None
            if bound or object.__getattribute__(ledger, "_upload_terminal_owner") is self:
                try:
                    self._rollback_bind(
                        ledger, pair, semantic, self, self._pair_token
                    )
                except BaseException as exc:
                    _detach_exception_chain(exc)
                    cleanup_failure = exc
            if probe is not None:
                try:
                    probe.close()
                except BaseException as exc:
                    _detach_exception_chain(exc)
                    if cleanup_failure is None:
                        cleanup_failure = exc
            if gate_bound and adopted_stable_id is not None:
                try:
                    _stable_gate_owner._rollback_carrier(
                        self, adopted_stable_id
                    )
                except BaseException as exc:
                    _detach_exception_chain(exc)
                    if cleanup_failure is None:
                        cleanup_failure = exc
            self._pair_owner = None
            self._semantic_owner = None
            self._semantic_probe_owner = None
            self._semantic_probe = None
            self._semantic_commit = None
            self._stable_gate_owner = None
            self._stable_gate_token = None
            self._stable_project_id = None
            self._stable_gate_probe = None
            self._stable_gate_intact = None
            self._stable_gate_fd_intact = None
            self._response_probe_intact = None
            self._publication_probe_intact = None
            self._stable_gate_close = None
            self._closed = cleanup_failure is None
            if cleanup_failure is not None:
                raise cleanup_failure.with_traceback(None) from failure
            raise failure.with_traceback(None)

    def _ensure_ledger(self, ledger: DecisionWorkLedger) -> None:
        if ledger is not self._ledger or id(ledger) != self._ledger_identity:
            raise CFError("HTTP upload pair semantic carrier belongs to another ledger")

    def finalize(self, ledger: DecisionWorkLedger) -> None:
        """Run the unique pair callback/fences, then finish retryable cleanup."""
        self._ensure_ledger(ledger)
        carrier_type = AccountedHTTPUploadExistingPairSemanticCarrier
        carrier_descriptor = MappingProxyType.__getitem__(
            type.__getattribute__(carrier_type, "__dict__"), "__dict__"
        )
        descriptor_get = type(carrier_descriptor).__get__
        carrier_mapping = descriptor_get(carrier_descriptor, self, carrier_type)
        dict_item = dict.__getitem__
        dict_set = dict.__setitem__
        if type(carrier_mapping) is not dict:
            raise CFError("HTTP upload pair semantic carrier state changed")
        if dict_item(carrier_mapping, "_closed"):
            raise CFError("HTTP upload pair semantic carrier is closed")
        if dict_item(carrier_mapping, "_operating"):
            raise CFError("HTTP upload pair semantic carrier operation is active")
        state = dict_item(carrier_mapping, "_state")
        ready_state = self.READY
        abort_state = self.ABORT_ONLY
        adopted_state = self.ADOPTED
        cleanup_state = self.CLEANUP_PENDING
        finalizing_state = self.FINALIZING
        if state == ready_state:
            raise CFError("HTTP upload pair semantic carrier finalize is single-use")
        if state == abort_state:
            raise CFError("HTTP upload pair semantic carrier is abort-only")
        if state not in {adopted_state, cleanup_state}:
            raise CFError("HTTP upload pair semantic carrier state is invalid")
        pair = dict_item(carrier_mapping, "_pair_owner")
        semantic = dict_item(carrier_mapping, "_semantic_owner")
        if pair is None or semantic is None:
            raise CFError("HTTP upload pair semantic carrier has no source owners")
        pair_type = AccountedHTTPUploadExistingTerminalOwner
        pair_descriptor = MappingProxyType.__getitem__(
            type.__getattribute__(pair_type, "__dict__"), "__dict__"
        )
        pair_mapping = type(pair_descriptor).__get__(
            pair_descriptor, pair, pair_type
        )
        semantic_type = AccountedHTTPUploadSemantic
        semantic_descriptor = MappingProxyType.__getitem__(
            type.__getattribute__(semantic_type, "__dict__"), "__dict__"
        )
        semantic_mapping = type(semantic_descriptor).__get__(
            semantic_descriptor, semantic, semantic_type
        )
        if type(pair_mapping) is not dict or type(semantic_mapping) is not dict:
            raise CFError("HTTP upload pair semantic carrier source state changed")
        pair_detached_state = pair.PAIR_DETACHED
        pair_finalize = dict_item(carrier_mapping, "_pair_finalize")
        pair_close = dict_item(carrier_mapping, "_pair_close")
        semantic_cleanup = dict_item(carrier_mapping, "_semantic_cleanup")
        effect_input_finish = dict_item(
            carrier_mapping, "_effect_input_finish"
        )
        effect_input_owner = dict_item(
            carrier_mapping, "_effect_input_owner"
        )
        if effect_input_owner is not None:
            effect_owner_mapping = object.__getattribute__(
                effect_input_owner, "__dict__"
            )
            if (
                type(effect_owner_mapping) is not dict
                or effect_input_finish is None
                or dict.get(effect_owner_mapping, "_finish")
                is not effect_input_finish
            ):
                raise CFError("HTTP upload effect input finish slot changed")
        stable_gate_intact = dict_item(
            carrier_mapping, "_stable_gate_intact"
        )
        stable_gate_fd_intact = dict_item(
            carrier_mapping, "_stable_gate_fd_intact"
        )
        response_probe_intact = dict_item(
            carrier_mapping, "_response_probe_intact"
        )
        publication_probe_intact = dict_item(
            carrier_mapping, "_publication_probe_intact"
        )
        carrier_close = AccountedHTTPUploadExistingPairSemanticCarrier.close
        failure: BaseException | None = None
        dict_set(carrier_mapping, "_operating", True)
        try:
            if not dict_item(carrier_mapping, "_input_committed"):
                dict_set(carrier_mapping, "_state", finalizing_state)
                pair_finalize(
                    pair,
                    ledger,
                    _pair_semantic_carrier_owner=self,
                    _pair_semantic_carrier_token=dict_item(
                        carrier_mapping, "_pair_token"
                    ),
                    _semantic_probe=dict_item(
                        carrier_mapping, "_semantic_probe"
                    ),
                    _semantic_commit=dict_item(
                        carrier_mapping, "_semantic_commit"
                    ),
                )
            dict_set(carrier_mapping, "_state", cleanup_state)
            if not dict_item(pair_mapping, "_pair_resources_released"):
                pair_close(
                    pair,
                    ledger,
                    _preserve_pair=True,
                    _pair_semantic_carrier_owner=self,
                )
            semantic_cleanup(semantic, self)
            if (
                not dict_item(carrier_mapping, "_input_committed")
                or dict_item(carrier_mapping, "_effect_semantic") is None
                or dict_item(carrier_mapping, "_effect_copy_bytes") is None
                or dict_item(pair_mapping, "_state") != pair_detached_state
                or not dict_item(pair_mapping, "_pair_resources_released")
                or not dict_item(semantic_mapping, "_terminal_complete")
            ):
                raise CFError("HTTP upload pair semantic carrier cleanup is incomplete")
            dict_set(carrier_mapping, "_semantic_probe_owner", None)
            dict_set(carrier_mapping, "_semantic_probe", None)
            dict_set(carrier_mapping, "_semantic_commit", None)
            if effect_input_finish is not None:
                effect_input_finish()
            dict_set(carrier_mapping, "_state", ready_state)
        except BaseException as exc:
            _detach_exception_chain(exc)
            failure = exc
        finally:
            dict_set(carrier_mapping, "_operating", False)
        if failure is not None:
            if dict_item(carrier_mapping, "_input_committed"):
                dict_set(carrier_mapping, "_state", cleanup_state)
                raise failure.with_traceback(None)
            dict_set(carrier_mapping, "_state", abort_state)
            critical_drift = (
                stable_gate_intact is not None
                and not stable_gate_intact()
            )
            if (
                not critical_drift
                and stable_gate_fd_intact is not None
                and not stable_gate_fd_intact()
            ):
                critical_drift = True
            if (
                not critical_drift
                and response_probe_intact is not None
                and not response_probe_intact()
            ):
                critical_drift = True
            if (
                not critical_drift
                and publication_probe_intact is not None
                and not publication_probe_intact()
            ):
                critical_drift = True
            for class_mapping, expected_get, expected_set in dict_item(
                carrier_mapping, "_critical_class_states"
            ):
                if critical_drift:
                    break
                mapping_get = type(class_mapping).get
                if (
                    mapping_get(class_mapping, "__getattribute__", None)
                    is not expected_get
                    or mapping_get(class_mapping, "__setattr__", None)
                    is not expected_set
                ):
                    critical_drift = True
                    break
            if critical_drift:
                raise failure.with_traceback(None)
            cleanup_failure: BaseException | None = None
            try:
                carrier_close(
                    self,
                    ledger,
                    _effect_input_owner=dict_item(
                        carrier_mapping, "_effect_input_owner"
                    ),
                    _effect_input_token=dict_item(
                        carrier_mapping, "_effect_input_token"
                    ),
                )
            except BaseException as exc:
                _detach_exception_chain(exc)
                cleanup_failure = exc
            if cleanup_failure is not None:
                raise cleanup_failure.with_traceback(None) from failure
            raise failure.with_traceback(None)
        if dict_item(carrier_mapping, "_close_requested"):
            dict_set(carrier_mapping, "_state", abort_state)
            carrier_close(
                self,
                ledger,
                _effect_input_owner=dict_item(
                    carrier_mapping, "_effect_input_owner"
                ),
                _effect_input_token=dict_item(
                    carrier_mapping, "_effect_input_token"
                ),
            )
            raise CFError("HTTP upload pair semantic carrier was cancelled by close")

    def close(
        self,
        ledger: DecisionWorkLedger,
        *,
        _effect_input_owner: Any | None = None,
        _effect_input_token: Any | None = None,
    ) -> None:
        """Discard payload first; stop and retain the first cleanup owner."""
        self._ensure_ledger(ledger)
        adopted_effect_input = object.__getattribute__(
            self, "_effect_input_owner"
        )
        if adopted_effect_input is not None and (
            _effect_input_owner is not adopted_effect_input
            or _effect_input_token
            is not object.__getattribute__(self, "_effect_input_token")
        ):
            raise CFError("HTTP upload effect input adopted carrier")
        if self._closed:
            return
        if self._operating:
            self._close_requested = True
            return
        if self._closing:
            return
        effect_registry = (
            adopted_effect_input
            if object.__getattribute__(ledger, "_upload_terminal_owner")
            is adopted_effect_input
            else None
        )
        stable_gate_intact = object.__getattribute__(
            self, "_stable_gate_intact"
        )
        if (
            stable_gate_intact is not None
            and (
                object.__getattribute__(self, "_pair_owner") is not None
                or object.__getattribute__(self, "_semantic_owner") is not None
            )
            and not stable_gate_intact()
        ):
            raise CFError(
                "HTTP upload pair semantic carrier gate cleanup is deferred"
            )
        self._closing = True
        failure: BaseException | None = None
        adopted_pair = self._pair_owner
        try:
            self._effect_semantic = None
            self._effect_copy_bytes = None
            pair = self._pair_owner
            pair_first = pair is not None and not pair._pair_resources_released
            if pair_first:
                try:
                    self._pair_close(
                        pair,
                        ledger,
                        _pair_semantic_carrier_owner=self,
                        _pair_semantic_registry=effect_registry,
                    )
                except BaseException as exc:
                    _detach_exception_chain(exc)
                    failure = exc
                if pair._closed:
                    object.__setattr__(pair, "_pair_semantic_carrier_owner", None)
                    object.__setattr__(pair, "_pair_semantic_carrier_token", None)
                    self._pair_owner = None
            pair = None

            semantic = self._semantic_owner
            if failure is None and semantic is not None:
                try:
                    self._semantic_payload_close(semantic, self)
                except BaseException as exc:
                    _detach_exception_chain(exc)
                    failure = exc
            semantic = None

            pair = self._pair_owner
            if failure is None and pair is not None:
                try:
                    self._pair_close(
                        pair,
                        ledger,
                        _pair_semantic_carrier_owner=self,
                        _pair_semantic_registry=effect_registry,
                    )
                except BaseException as exc:
                    _detach_exception_chain(exc)
                    failure = exc
                if pair._closed:
                    object.__setattr__(pair, "_pair_semantic_carrier_owner", None)
                    object.__setattr__(pair, "_pair_semantic_carrier_token", None)
                    self._pair_owner = None
            pair = None

            semantic = self._semantic_owner
            if failure is None and semantic is not None:
                try:
                    self._semantic_control_release(semantic, self)
                except BaseException as exc:
                    _detach_exception_chain(exc)
                    failure = exc
                if semantic._closed:
                    object.__setattr__(
                        semantic, "_pair_semantic_carrier_owner", None
                    )
                    self._semantic_owner = None
            semantic = None

            gate_owner = self._stable_gate_owner
            if failure is None and gate_owner is not None:
                try:
                    self._stable_gate_close(gate_owner, self, ledger)
                except BaseException as exc:
                    _detach_exception_chain(exc)
                    failure = exc
                if gate_owner._closed:
                    self._stable_gate_owner = None
                    self._stable_gate_token = None
                    self._stable_project_id = None
                    self._stable_gate_probe = None
                    self._stable_gate_intact = None
                    self._stable_gate_fd_intact = None
                    self._response_probe_intact = None
                    self._publication_probe_intact = None
            gate_owner = None

            if (
                failure is None
                and self._semantic_owner is None
                and self._pair_owner is None
                and self._stable_gate_owner is None
            ):
                registry = object.__getattribute__(ledger, "_upload_terminal_owner")
                if registry is self or registry is adopted_pair:
                    object.__setattr__(ledger, "_upload_terminal_owner", None)
                self._semantic_probe_owner = None
                self._semantic_probe = None
                self._response_probe_intact = None
                self._publication_probe_intact = None
                self._semantic_commit = None
                self._effect_input_owner = None
                self._effect_input_token = None
                self._effect_input_finish = None
                self._pair_finalize = None
                self._pair_close = None
                self._semantic_cleanup = None
                self._semantic_payload_close = None
                self._semantic_control_release = None
                self._stable_gate_close = None
                self._pair_token = None
                self._pair_class_mapping = None
                self._pair_getattribute = None
                self._pair_setattr = None
                self._critical_class_states = None
                self._close_requested = False
                self._state = self.CLOSED
                self._closed = True
        finally:
            self._closing = False
        if failure is not None:
            raise failure.with_traceback(None)
        if not self._closed:
            raise CFError("HTTP upload pair semantic carrier cleanup is incomplete")

    def __del__(self) -> None:
        try:
            self.close(self._ledger)
        except BaseException:
            pass


class AccountedHTTPUploadExistingEffectInput:
    """Destination-first owner for one callback-free existing upload input.

    This production-unwired boundary is deliberately payload-opaque.  It is
    allocated and accounted before the pair carrier's final callback, replaces
    that carrier's private commit with one captured field-only transfer, and
    keeps the carrier (and therefore its project gate) until explicit close.
    """

    BOUND = "BOUND"
    STAGED = "STAGED"
    READY = "READY"
    CLOSED = "CLOSED"
    FIXED_RETAINED_BYTES = 0

    @classmethod
    def retained_upper(cls) -> int:
        instance = object.__new__(cls)
        instance_bytes = sys.getsizeof(instance)
        instance = None
        owner_dict_bytes = sys.getsizeof(dict.fromkeys(range(40)))
        captured = (lambda value: (lambda: value))(None)
        function_bytes = sys.getsizeof(captured)
        cell_bytes = sys.getsizeof(tuple.__getitem__(captured.__closure__, 0))
        closure_bytes = 6 * (
            function_bytes + sys.getsizeof((None,) * 64)
        ) + 128 * cell_bytes
        measured = instance_bytes + owner_dict_bytes + closure_bytes
        page = 4096
        return max(2 * page, ((measured + page - 1) // page) * page)

    def __init__(
        self,
        carrier: AccountedHTTPUploadExistingPairSemanticCarrier,
        ledger: DecisionWorkLedger,
        *,
        _preacquired: _StablePermitTransition | None = None,
    ) -> None:
        if type(carrier) is not AccountedHTTPUploadExistingPairSemanticCarrier:
            raise CFError("HTTP upload effect input requires an exact carrier")
        carrier._ensure_ledger(ledger)
        if type(_preacquired) is not _StablePermitTransition:
            raise CFError("use prepare_http_upload_existing_effect_input")
        semantic_owner = carrier._semantic_owner
        if (
            type(semantic_owner) is not AccountedHTTPUploadSemantic
            or not semantic_owner._existing_effect_input_control
        ):
            raise CFError("HTTP upload effect input has no semantic control")
        if (
            carrier._state != carrier.ADOPTED
            or carrier._operating
            or carrier._closing
            or carrier._closed
            or carrier._input_committed
            or carrier._effect_input_owner is not None
            or carrier._effect_input_token is not None
            or carrier._effect_input_finish is not None
            or carrier._effect_semantic is not None
            or carrier._effect_copy_bytes is not None
            or type(carrier._semantic_commit) is not FunctionType
            or semantic_owner._allocation is not _preacquired
            or _preacquired._retained_secondary
            != (
                semantic_owner.PAIR_SEMANTIC_CARRIER_RETAINED_BYTES
                + semantic_owner.EXISTING_EFFECT_INPUT_RETAINED_BYTES
            )
            or _preacquired._retained_secondary_released
            or object.__getattribute__(ledger, "_upload_terminal_owner")
            is not carrier
        ):
            raise CFError("HTTP upload effect input requires an adopted carrier")

        self._ledger = ledger
        self._ledger_identity = id(ledger)
        self._carrier: AccountedHTTPUploadExistingPairSemanticCarrier | None = (
            carrier
        )
        self._token: Any | None = object()
        self._transition: _StablePermitTransition | None = _preacquired
        self._effect_semantic: MappingProxyType | None = None
        self._effect_copy_bytes: tuple[bytes, ...] | None = None
        self._response_input: AccountedHTTPUploadResponseInput | None = (
            semantic_owner._response_input
        )
        self._response_token: Any | None = None
        self._response_status: int | None = None
        self._response_durable: bool | None = None
        self._carrier_close = AccountedHTTPUploadExistingPairSemanticCarrier.close
        self._response_adopt = AccountedHTTPUploadResponseInput._adopt_effect_input
        self._response_select = (
            AccountedHTTPUploadResponseInput._select_from_effect_input
        )
        self._response_take = (
            AccountedHTTPUploadResponseInput._take_selected_from_effect_input
        )
        self._response_close = (
            AccountedHTTPUploadResponseInput._close_from_effect_input
        )
        self._finish: Any | None = None
        self._state = self.BOUND
        self._closing = False
        self._closed = False

        carrier_type = AccountedHTTPUploadExistingPairSemanticCarrier
        owner_type = AccountedHTTPUploadExistingEffectInput
        carrier_mapping = object.__getattribute__(carrier, "__dict__")
        owner_mapping = object.__getattribute__(self, "__dict__")
        carrier_class_mapping = type.__getattribute__(carrier_type, "__dict__")
        owner_class_mapping = type.__getattribute__(owner_type, "__dict__")
        mapping_items = type(carrier_class_mapping).items
        expected_carrier_class = tuple(mapping_items(carrier_class_mapping))
        expected_owner_class = tuple(mapping_items(owner_class_mapping))
        object_getattribute = object.__getattribute__
        dict_item = dict.__getitem__
        dict_set = dict.__setitem__
        length_of = len
        error_type = CFError
        old_commit = carrier._semantic_commit
        carrier_close = self._carrier_close
        response = self._response_input
        response_semantic_token = semantic_owner._response_token
        response_adopt = self._response_adopt
        token = self._token
        bound_state = self.BOUND
        staged_state = self.STAGED
        ready_state = self.READY

        def exact_class(
            mapping: Any, expected: tuple[Any, ...]
        ) -> bool:
            if length_of(mapping) != length_of(expected):
                return False
            index = 0
            for key, value in mapping_items(mapping):
                expected_key, expected_value = expected[index]
                if key is not expected_key or value is not expected_value:
                    return False
                index += 1
            return True

        def exact_bound() -> bool:
            return (
                type(self) is owner_type
                and type(carrier) is carrier_type
                and exact_class(carrier_class_mapping, expected_carrier_class)
                and exact_class(owner_class_mapping, expected_owner_class)
                and object_getattribute(self, "__dict__") is owner_mapping
                and object_getattribute(carrier, "__dict__")
                is carrier_mapping
                and dict_item(owner_mapping, "_ledger") is ledger
                and dict_item(owner_mapping, "_carrier") is carrier
                and dict_item(owner_mapping, "_token") is token
                and dict_item(owner_mapping, "_transition") is _preacquired
                and dict_item(owner_mapping, "_effect_semantic") is None
                and dict_item(owner_mapping, "_effect_copy_bytes") is None
                and dict_item(owner_mapping, "_response_input") is response
                and dict_item(owner_mapping, "_response_token") is None
                and dict_item(owner_mapping, "_response_status") is None
                and dict_item(owner_mapping, "_response_durable") is None
                and dict_item(owner_mapping, "_carrier_close") is carrier_close
                and dict_item(owner_mapping, "_finish") is finish_input
                and dict_item(owner_mapping, "_state") == bound_state
                and dict_item(owner_mapping, "_closed") is False
                and dict_item(carrier_mapping, "_effect_input_owner") is self
                and dict_item(carrier_mapping, "_effect_input_token") is token
                and dict_item(carrier_mapping, "_semantic_commit") is commit_input
                and dict_item(carrier_mapping, "_effect_input_finish")
                is finish_input
                and dict_item(carrier_mapping, "_input_committed") is False
                and dict_item(carrier_mapping, "_effect_semantic") is None
                and dict_item(carrier_mapping, "_effect_copy_bytes") is None
                and (
                    response is None
                    or (
                        type(response) is AccountedHTTPUploadResponseInput
                        and semantic_owner._response_input is response
                        and semantic_owner._response_token
                        is response_semantic_token
                        and response._semantic_owner is semantic_owner
                        and response._semantic_token is response_semantic_token
                        and response._effect_input_owner is None
                        and response._effect_input_token is None
                    )
                )
                and object_getattribute(ledger, "_upload_terminal_owner")
                is carrier
            )

        def commit_input() -> None:
            if not exact_bound():
                raise error_type("HTTP upload effect input changed before commit")
            old_commit()
            semantic = dict_item(carrier_mapping, "_effect_semantic")
            copy_bytes = dict_item(carrier_mapping, "_effect_copy_bytes")
            if type(semantic) is not MappingProxyType or type(copy_bytes) is not tuple:
                raise error_type("HTTP upload effect input carrier commit is incomplete")
            dict_set(owner_mapping, "_effect_semantic", semantic)
            dict_set(owner_mapping, "_effect_copy_bytes", copy_bytes)
            dict_set(owner_mapping, "_state", staged_state)

        def finish_input() -> None:
            semantic = dict_item(owner_mapping, "_effect_semantic")
            copy_bytes = dict_item(owner_mapping, "_effect_copy_bytes")
            if (
                type(self) is not owner_type
                or type(carrier) is not carrier_type
                or not exact_class(carrier_class_mapping, expected_carrier_class)
                or not exact_class(owner_class_mapping, expected_owner_class)
                or object_getattribute(self, "__dict__") is not owner_mapping
                or object_getattribute(carrier, "__dict__")
                is not carrier_mapping
                or dict_item(owner_mapping, "_carrier") is not carrier
                or dict_item(owner_mapping, "_token") is not token
                or dict_item(owner_mapping, "_state") != staged_state
                or dict_item(owner_mapping, "_carrier_close") is not carrier_close
                or dict_item(owner_mapping, "_finish") is not finish_input
                or type(semantic) is not MappingProxyType
                or type(copy_bytes) is not tuple
                or dict_item(carrier_mapping, "_effect_input_owner") is not self
                or dict_item(carrier_mapping, "_effect_input_token") is not token
                or dict_item(carrier_mapping, "_effect_input_finish")
                is not finish_input
                or dict_item(carrier_mapping, "_semantic_commit") is not None
                or dict_item(carrier_mapping, "_effect_semantic") is not semantic
                or dict_item(carrier_mapping, "_effect_copy_bytes")
                is not copy_bytes
                or dict_item(carrier_mapping, "_input_committed") is not True
                or object_getattribute(ledger, "_upload_terminal_owner")
                is not carrier
            ):
                raise error_type("HTTP upload effect input changed before finish")
            if response is not None:
                response_adopt(
                    response,
                    self,
                    token,
                    semantic_owner,
                    response_semantic_token,
                    ledger,
                )
                dict_set(owner_mapping, "_response_token", token)
            dict_set(carrier_mapping, "_effect_semantic", None)
            dict_set(carrier_mapping, "_effect_copy_bytes", None)
            dict_set(carrier_mapping, "_effect_input_finish", None)
            object.__setattr__(ledger, "_upload_terminal_owner", self)
            dict_set(owner_mapping, "_state", ready_state)

        failure: BaseException | None = None
        try:
            self._finish = finish_input
            carrier._effect_input_owner = self
            carrier._effect_input_token = token
            carrier._semantic_commit = commit_input
            carrier._effect_input_finish = finish_input
            if not exact_bound():
                raise CFError("HTTP upload effect input bind is incomplete")
        except BaseException as exc:
            _detach_exception_chain(exc)
            failure = exc
        if failure is not None:
            if carrier._effect_input_owner is self:
                carrier._effect_input_owner = None
            if carrier._effect_input_token is token:
                carrier._effect_input_token = None
            if carrier._semantic_commit is commit_input:
                carrier._semantic_commit = old_commit
            if carrier._effect_input_finish is finish_input:
                carrier._effect_input_finish = None
            self._carrier = None
            self._token = None
            self._carrier_close = None
            self._response_input = None
            self._response_token = None
            self._response_adopt = None
            self._response_select = None
            self._response_take = None
            self._response_close = None
            self._finish = None
            self._transition = None
            self._closed = True
            raise failure.with_traceback(None)

    def _ensure_ledger(self, ledger: DecisionWorkLedger) -> None:
        if ledger is not self._ledger or id(ledger) != self._ledger_identity:
            raise CFError("HTTP upload effect input belongs to another ledger")

    def _take_prepared_response(
        self, ledger: DecisionWorkLedger, *, durable: bool
    ) -> tuple[int, _PreparedHTTPResponseOwner]:
        """Select once, close every terminal parent, and return response bytes."""
        self._ensure_ledger(ledger)
        if type(durable) is not bool:
            raise CFError("HTTP upload effect response requires a boolean")
        if self._closed or self._state != self.READY or self._closing:
            raise CFError("HTTP upload effect response is not ready")
        response = self._response_input
        token = self._response_token
        if response is None or token is None:
            raise CFError("HTTP upload effect response is unavailable")
        if self._response_durable is not None and self._response_durable is not durable:
            raise CFError("HTTP upload effect response selection is single-use")
        if self._response_status is None:
            self._response_durable = durable
            self._response_status = self._response_select(
                response, self, token, ledger, durable
            )
        self._effect_semantic = None
        self._effect_copy_bytes = None
        carrier = self._carrier
        if carrier is not None:
            self._carrier_close(
                carrier,
                ledger,
                _effect_input_owner=self,
                _effect_input_token=self._token,
            )
            if carrier._closed:
                self._carrier = None
        carrier = None
        if self._carrier is not None:
            raise CFError("HTTP upload effect response carrier remains live")
        if (
            response._state != response.SELECTED
            or response._effect_input_owner is not self
            or response._effect_input_token is not token
            or response._selected_status != self._response_status
            or response._selection is not durable
        ):
            raise CFError("HTTP upload effect response changed before transfer")
        status, prepared = self._response_take(
            response, self, token, ledger
        )
        if status != self._response_status:
            prepared.close()
            raise CFError("HTTP upload effect response status changed")
        transition = self._transition
        if transition is not None:
            if not transition._retained_secondary_released:
                prepared.close()
                raise CFError("HTTP upload effect response control remains live")
            self._transition = None
        if object.__getattribute__(ledger, "_upload_terminal_owner") is self:
            object.__setattr__(ledger, "_upload_terminal_owner", None)
        self._response_input = None
        self._response_token = None
        self._response_status = None
        self._response_durable = None
        self._token = None
        self._carrier_close = None
        self._response_adopt = None
        self._response_select = None
        self._response_take = None
        self._response_close = None
        self._finish = None
        self._state = self.CLOSED
        self._closed = True
        return status, prepared

    def close(self, ledger: DecisionWorkLedger) -> None:
        """Drop effect input, close the gate-owning carrier, then control."""
        self._ensure_ledger(ledger)
        if self._closed:
            return
        if self._closing:
            return
        self._closing = True
        failure: BaseException | None = None
        try:
            self._effect_semantic = None
            self._effect_copy_bytes = None
            carrier = self._carrier
            if carrier is not None:
                try:
                    self._carrier_close(
                        carrier,
                        ledger,
                        _effect_input_owner=self,
                        _effect_input_token=self._token,
                    )
                except BaseException as exc:
                    _detach_exception_chain(exc)
                    failure = exc
                if carrier._closed:
                    self._carrier = None
            carrier = None
            if failure is None and self._carrier is None:
                response = self._response_input
                if response is not None:
                    if not response._closed:
                        try:
                            self._response_close(
                                response, self, self._response_token, ledger
                            )
                        except BaseException as exc:
                            _detach_exception_chain(exc)
                            failure = exc
                    if response._closed:
                        self._response_input = None
                        self._response_token = None
                response = None
            if failure is None and self._carrier is None and self._response_input is None:
                transition = self._transition
                if transition is not None:
                    if not transition._retained_secondary_released:
                        raise CFError(
                            "HTTP upload effect input control remains live"
                        )
                    self._transition = None
                if object.__getattribute__(ledger, "_upload_terminal_owner") is self:
                    object.__setattr__(ledger, "_upload_terminal_owner", None)
                self._token = None
                self._carrier_close = None
                self._response_status = None
                self._response_durable = None
                self._response_adopt = None
                self._response_select = None
                self._response_take = None
                self._response_close = None
                self._finish = None
                self._state = self.CLOSED
                self._closed = True
        finally:
            self._closing = False
        if failure is not None:
            raise failure.with_traceback(None)
        if not self._closed:
            raise CFError("HTTP upload effect input cleanup is incomplete")

    def __del__(self) -> None:
        try:
            self.close(self._ledger)
        except BaseException:
            pass


_HTTP_UPLOAD_PAIR_SEMANTIC_CARRIER_RETAINED_BYTES = (
    AccountedHTTPUploadExistingPairSemanticCarrier.retained_upper()
)
AccountedHTTPUploadExistingPairSemanticCarrier.FIXED_RETAINED_BYTES = (
    _HTTP_UPLOAD_PAIR_SEMANTIC_CARRIER_RETAINED_BYTES
)
AccountedHTTPUploadSemantic.PAIR_SEMANTIC_CARRIER_RETAINED_BYTES = (
    _HTTP_UPLOAD_PAIR_SEMANTIC_CARRIER_RETAINED_BYTES
)
_HTTP_UPLOAD_EXISTING_EFFECT_INPUT_RETAINED_BYTES = (
    AccountedHTTPUploadExistingEffectInput.retained_upper()
)
AccountedHTTPUploadExistingEffectInput.FIXED_RETAINED_BYTES = (
    _HTTP_UPLOAD_EXISTING_EFFECT_INPUT_RETAINED_BYTES
)
AccountedHTTPUploadSemantic.EXISTING_EFFECT_INPUT_RETAINED_BYTES = (
    _HTTP_UPLOAD_EXISTING_EFFECT_INPUT_RETAINED_BYTES
)


def prepare_http_upload_existing_pair_semantic_carrier(
    pair: AccountedHTTPUploadExistingTerminalOwner,
    semantic: AccountedHTTPUploadSemantic,
    ledger: DecisionWorkLedger,
) -> AccountedHTTPUploadExistingPairSemanticCarrier:
    """Adopt pair/semantic owners without exposing payload or effect API."""
    return AccountedHTTPUploadExistingPairSemanticCarrier(pair, semantic, ledger)


def prepare_http_upload_existing_effect_input(
    carrier: AccountedHTTPUploadExistingPairSemanticCarrier,
    ledger: DecisionWorkLedger,
) -> AccountedHTTPUploadExistingEffectInput:
    """Preaccount and bind one payload-opaque destination before terminal."""
    if type(carrier) is not AccountedHTTPUploadExistingPairSemanticCarrier:
        raise CFError("HTTP upload effect input requires an exact carrier")
    semantic = carrier._semantic_owner
    if type(semantic) is not AccountedHTTPUploadSemantic:
        raise CFError("HTTP upload effect input has no semantic control")
    transition = semantic._allocation
    owner: AccountedHTTPUploadExistingEffectInput | None = None
    try:
        owner = object.__new__(AccountedHTTPUploadExistingEffectInput)
        AccountedHTTPUploadExistingEffectInput.__init__(
            owner, carrier, ledger, _preacquired=transition
        )
        return owner
    except BaseException:
        if owner is not None and not getattr(owner, "_closed", True):
            try:
                owner.close(ledger)
            except BaseException:
                pass
        raise


class _HTTPUploadSealedValidationReservation:
    """Stable retry owner for both the permit and its consumed scalars."""

    def __init__(
        self,
        ledger: DecisionWorkLedger,
        temporary_bytes: int,
        retained_bytes: int,
    ) -> None:
        self._ledger = ledger
        self._permit: DecisionWorkPermit | None = DecisionWorkPermit()
        self._armed = True
        self._acquired = False
        self._temporary_bytes = temporary_bytes
        self._retained_bytes = retained_bytes
        self._temporary_baseline = ledger._current.get("temporary_bytes", 0)
        self._retained_baseline = ledger._current.get("retained_bytes", 0)
        self._temporary_consumed = self._temporary_baseline + temporary_bytes
        self._retained_consumed = self._retained_baseline + retained_bytes

    def borrow(self) -> DecisionWorkPermit:
        if self._permit is None:
            raise CFError("HTTP upload sealed reservation has no permit")
        return self._permit

    def _release_dimension(self, dimension: str, scalar_name: str) -> None:
        amount = getattr(self, scalar_name)
        if not amount:
            return
        current_before = self._ledger._current.get(dimension, 0)
        try:
            self._ledger.release(dimension, amount)
            setattr(self, scalar_name, 0)
        except BaseException:
            current_after = self._ledger._current.get(dimension, 0)
            if (
                current_before >= amount
                and current_after == current_before - amount
            ):
                # The ledger committed and a wrapper/asynchronous exception
                # arrived after it returned. Reconcile before propagating so a
                # retry cannot release the same scalar twice.
                setattr(self, scalar_name, 0)
            raise

    def close(self) -> None:
        if not self._armed:
            return
        permit = self._permit
        if permit is not None:
            if self._ledger.permit_is_open(permit):
                self._ledger.cancel_permit(permit)
                # Publish completion first: an asynchronous interruption after
                # cancel committed may safely re-enter close as a no-op.
                self._armed = False
                self._permit = None
                self._temporary_bytes = 0
                self._retained_bytes = 0
                return
            temporary_current = self._ledger._current.get("temporary_bytes", 0)
            retained_current = self._ledger._current.get("retained_bytes", 0)
            if (
                temporary_current == self._temporary_baseline
                and retained_current == self._retained_baseline
            ):
                # cancel committed and a wrapper/asynchronous exception was
                # raised before this owner could clear its permit field.
                self._armed = False
                self._permit = None
                self._temporary_bytes = 0
                self._retained_bytes = 0
                return
            if not (
                temporary_current == self._temporary_consumed
                and retained_current == self._retained_consumed
            ):
                raise CFError(
                    "HTTP upload sealed reservation closed with indeterminate scalars"
                )
            # consume committed. This also covers an exception raised before
            # factory code could execute another ownership operation.
            self._acquired = True
            self._permit = None
        if not self._acquired:
            raise CFError("HTTP upload sealed reservation ownership is indeterminate")
        self._release_dimension("temporary_bytes", "_temporary_bytes")
        self._release_dimension("retained_bytes", "_retained_bytes")
        self._armed = False
        self._acquired = False

    def __del__(self) -> None:
        try:
            self.close()
        except BaseException:
            pass


def prepare_http_upload_sealed_validation(
    ledger: DecisionWorkLedger,
    objects_root: Path,
    head: str,
    *,
    record_count_upper: int,
    aggregate_bytes_upper: int,
    maximum_record_bytes_upper: int,
    deadline: HTTPRequestDeadline | None,
    _semantic_baseline_owner: AccountedHTTPUploadSemantic | None = None,
) -> AccountedHTTPUploadSealedValidation:
    """Acquire the complete validation heap upper before its first allocator."""
    if not isinstance(head, str) or not head.startswith("CF-COMMIT-"):
        raise CFError("HTTP upload sealed validation requires a commit object ID")
    semantic_baseline_proof = None
    if _semantic_baseline_owner is not None:
        semantic_baseline_proof = (
            AccountedHTTPUploadSealedValidation._capture_semantic_baseline(
                _semantic_baseline_owner,
                ledger,
            )
        )
    retained_upper, temporary_upper = (
        AccountedHTTPUploadSealedValidation.allocation_upper(
            record_count_upper,
            aggregate_bytes_upper,
            maximum_record_bytes_upper,
        )
    )
    reservation_owner = _HTTPUploadSealedValidationReservation(
        ledger, temporary_upper, retained_upper
    )
    reservation_failure: BaseException | None = None
    try:
        ledger.reserve_into(
            reservation_owner.borrow(),
            "semantic_validation",
            acquires={
                "retained_bytes": retained_upper,
                "temporary_bytes": temporary_upper,
            },
        )
        if deadline is not None:
            deadline.check("upload sealed validation")
        ledger.consume_reserved(
            reservation_owner.borrow(),
            phase="semantic_validation",
            acquires={
                "retained_bytes": retained_upper,
                "temporary_bytes": temporary_upper,
            },
        )
    except BaseException as exc:
        reservation_failure = AccountedHTTPUploadSealedValidation._detach_failure(
            exc
        )
    if reservation_failure is not None:
        cleanup_failure: BaseException | None = None
        try:
            reservation_owner.close()
        except BaseException as exc:
            cleanup_failure = AccountedHTTPUploadSealedValidation._detach_failure(
                exc
            )
        if cleanup_failure is not None:
            retry_failure: BaseException | None = None
            try:
                reservation_owner.close()
            except BaseException as exc:
                retry_failure = AccountedHTTPUploadSealedValidation._detach_failure(
                    exc
                )
            if retry_failure is not None:
                raise retry_failure
            raise cleanup_failure
        raise reservation_failure

    owner: AccountedHTTPUploadSealedValidation | None = None
    construction_failure: BaseException | None = None
    try:
        owner, construction_failure = (
            AccountedHTTPUploadSealedValidation._from_acquired(
                ledger,
                objects_root,
                head,
                record_count_upper,
                aggregate_bytes_upper,
                maximum_record_bytes_upper,
                retained_upper,
                temporary_upper,
                reservation_owner,
                deadline,
                _semantic_baseline_owner,
                semantic_baseline_proof,
            )
        )
    except BaseException as exc:
        construction_failure = AccountedHTTPUploadSealedValidation._detach_failure(
            exc
        )
    if owner is None and construction_failure is None:
        construction_failure = CFError(
            "HTTP upload sealed validation constructor returned no owner"
        )
    if construction_failure is not None:
        cleanup_failure: BaseException | None = None
        if owner is not None:
            try:
                owner.close(ledger)
            except BaseException as exc:
                cleanup_failure = AccountedHTTPUploadSealedValidation._detach_failure(
                    exc
                )
        else:
            try:
                reservation_owner.close()
            except BaseException as exc:
                cleanup_failure = AccountedHTTPUploadSealedValidation._detach_failure(
                    exc
                )
        if cleanup_failure is not None:
            retry_failure: BaseException | None = None
            try:
                if owner is not None:
                    owner.close(ledger)
                else:
                    reservation_owner.close()
            except BaseException as exc:
                retry_failure = AccountedHTTPUploadSealedValidation._detach_failure(
                    exc
                )
            if retry_failure is not None:
                raise retry_failure
            raise cleanup_failure
        owner = None
        raise construction_failure
    if semantic_baseline_proof is not None:
        if (
            owner._semantic_baseline_owner is not _semantic_baseline_owner
            or owner._semantic_baseline_proof is not semantic_baseline_proof
            or not AccountedHTTPUploadSealedValidation._semantic_baseline_intact(
                semantic_baseline_proof,
                require_current=False,
            )
            or reservation_owner._retained_baseline
            != tuple.__getitem__(semantic_baseline_proof, 10)
            or reservation_owner._temporary_baseline
            != tuple.__getitem__(semantic_baseline_proof, 11)
        ):
            owner.close(ledger)
            raise CFError("HTTP upload sealed validation semantic baseline changed")
    return owner


class AccountedHTTPUploadSealedAncestry:
    """Own one sealed commit borrow through one accounted ancestry walk.

    This is a production-unwired handoff.  It never reopens or clones a
    commit: ``AccountedHTTPUploadAncestry`` receives only the sealed owner's
    purpose-specific callable borrow.  The ancestry payload/loader is always
    dropped before the borrow is released, and the sealed owner remains with
    its caller for the later terminal fence.
    """

    def __init__(
        self,
        sealed_owner: AccountedHTTPUploadSealedValidation,
        ledger: DecisionWorkLedger,
        deadline: HTTPRequestDeadline | None,
    ) -> None:
        # Publish every cleanup field before the first fallible authority
        # operation.  A prepare fault can then unwind through this same
        # object without losing an activated sealed borrow.
        self._ledger = ledger
        self._ledger_identity = id(ledger)
        self._deadline = deadline
        self._sealed_owner: AccountedHTTPUploadSealedValidation | None = None
        self._borrow: _HTTPUploadSealedCommitBorrow | None = None
        self._ancestry: AccountedHTTPUploadAncestry | None = None
        self._preparing = False
        self._prepared = False
        self._running = False
        self._closing = False
        self._close_requested = False
        self._closed = False
        self._prepare_used = False
        self._decision_used = False

        if not isinstance(sealed_owner, AccountedHTTPUploadSealedValidation):
            raise CFError("HTTP upload sealed ancestry requires a sealed owner")
        sealed_owner._ensure_open(ledger)
        if sealed_owner._deadline is not deadline:
            raise CFError(
                "HTTP upload sealed ancestry must share the sealed deadline"
            )
        self._sealed_owner = sealed_owner

    def _ensure_ledger(self, ledger: DecisionWorkLedger) -> None:
        if (
            id(ledger) != self._ledger_identity
            or id(self._ledger) != self._ledger_identity
        ):
            raise CFError(
                "HTTP upload sealed ancestry belongs to a different ledger"
            )

    def _ensure_bound(self) -> None:
        self._ensure_ledger(self._ledger)
        if self._closed:
            raise CFError("HTTP upload sealed ancestry owner is closed")

    def _ensure_open(self) -> None:
        self._ensure_bound()
        if (
            not self._prepared
            or self._borrow is None
            or self._ancestry is None
        ):
            raise CFError("HTTP upload sealed ancestry owner is not prepared")

    def prepare(self, ledger: DecisionWorkLedger) -> None:
        """Activate both child owners after the caller owns this composite."""
        self._ensure_ledger(ledger)
        self._ensure_bound()
        if self._preparing:
            raise CFError("HTTP upload sealed ancestry prepare is already active")
        if self._prepare_used:
            raise CFError("HTTP upload sealed ancestry prepare is single-use")
        sealed_owner = self._sealed_owner
        if sealed_owner is None:
            raise CFError("HTTP upload sealed ancestry has no sealed owner")
        if sealed_owner._deadline is not self._deadline:
            raise CFError(
                "HTTP upload sealed ancestry deadline changed before prepare"
            )
        self._prepare_used = True
        self._preparing = True
        failure: BaseException | None = None
        try:
            sealed_owner.borrow_commits(
                ledger, "ancestry", _handoff_owner=self
            )
            assert self._borrow is not None
            AccountedHTTPUploadAncestry(
                ledger,
                self._borrow,
                self._deadline,
                _handoff_owner=self,
            )
            self._prepared = True
        except BaseException as exc:
            _detach_ancestry_exception_chain(exc)
            failure = exc
        sealed_owner = None
        self._sealed_owner = None
        self._preparing = False
        close_requested = self._close_requested
        cleanup_failure: BaseException | None = None
        if close_requested:
            try:
                self.close(ledger)
            except BaseException as exc:
                _detach_ancestry_exception_chain(exc)
                cleanup_failure = exc
        if cleanup_failure is not None:
            if failure is not None:
                raise cleanup_failure from failure
            raise cleanup_failure from None
        if failure is not None:
            # Do not auto-close.  The caller received this owner before
            # prepare and can retry an arbitrary cleanup failure on the same
            # exact ancestry/borrow fields.
            raise failure from None
        if close_requested:
            raise CFError(
                "HTTP upload sealed ancestry prepare was cancelled by close"
            )

    def contains(self, ancestor: str, head: str) -> bool:
        self._ensure_open()
        if self._running:
            raise CFError("HTTP upload sealed ancestry decision is already active")
        if self._decision_used:
            raise CFError("HTTP upload sealed ancestry owner is single-use")
        self._decision_used = True
        self._running = True
        result = False
        failure: BaseException | None = None
        ancestry = self._ancestry
        try:
            assert ancestry is not None
            result = ancestry.contains(ancestor, head)
        except BaseException as exc:
            _detach_ancestry_exception_chain(exc)
            failure = exc
        ancestry = None
        self._running = False

        cleanup_failure: BaseException | None = None
        try:
            self.close(self._ledger)
        except BaseException as exc:
            _detach_ancestry_exception_chain(exc)
            cleanup_failure = exc
        if cleanup_failure is not None:
            result = False
            if failure is not None:
                raise cleanup_failure from failure
            raise cleanup_failure from None
        if failure is not None:
            raise failure from None
        return result

    def close(self, ledger: DecisionWorkLedger | None = None) -> None:
        selected = self._ledger if ledger is None else ledger
        self._ensure_ledger(selected)
        if self._closed:
            return
        if self._preparing:
            self._close_requested = True
            return
        if self._running:
            # A deadline/accounting callback may request teardown while the
            # ancestry owner or borrow lookup still has payload locals.  The
            # outer decision performs the close after those frames unwind.
            self._close_requested = True
            return
        if self._closing:
            return
        self._closing = True
        completed = False
        try:
            ancestry = self._ancestry
            if ancestry is not None:
                ancestry.close(self._ledger)
                self._ancestry = None
            borrow = self._borrow
            if borrow is not None:
                borrow.close(self._ledger)
                self._borrow = None
            self._sealed_owner = None
            self._deadline = None
            self._prepared = False
            self._close_requested = False
            completed = True
        finally:
            if completed:
                self._closed = True
            self._closing = False

    def __del__(self) -> None:
        try:
            self.close(self._ledger)
        except BaseException:
            pass


def prepare_http_upload_sealed_ancestry(
    sealed_owner: AccountedHTTPUploadSealedValidation,
    ledger: DecisionWorkLedger,
    deadline: HTTPRequestDeadline | None = None,
) -> AccountedHTTPUploadSealedAncestry:
    """Allocate the handoff destination before its explicit prepare step."""
    return AccountedHTTPUploadSealedAncestry(
        sealed_owner, ledger, deadline
    )


def validate_sealed_commit(
    objects_root: Path,
    commit_id: str,
    seen: set[str] | None = None,
    *,
    ledger: DecisionWorkLedger | None = None,
    deadline: HTTPRequestDeadline | None = None,
    phase: str = "sealed validation",
) -> None:
    """Validate one sealed commit closure, optionally on a caller's budget.

    A caller that already owns a request budget passes its *exact*
    ``DecisionWorkLedger`` and ``HTTPRequestDeadline``: the traversal is then
    charged to that request and polled against its deadline, its session control
    state is reserved before allocation, and the request ledger is not
    terminated when the closure completes.  Only a caller with no budget of its
    own -- a local CLI command -- mints the ``local_v1`` ledger this used to
    create unconditionally, which is how an HTTP request could run an
    unaccounted, unpolled traversal.
    """
    caller_owned = ledger is not None
    active_ledger = ledger or DecisionWorkLedger(
        DecisionWorkProfile.local_v1(), "sealed validation"
    )
    poll: Any | None = None
    if deadline is not None:
        def poll() -> None:
            deadline.check(phase)

    memory: _AccountedUploadSourceMemory | None = None
    if caller_owned:
        # The caller's budget owns this session, so its control state is
        # reserved before the constructor that allocates it.
        memory = _AccountedUploadSourceMemory(active_ledger)
        memory.acquire()
    session: SealedCommitValidationSession | None = None
    try:
        session = SealedCommitValidationSession(
            objects_root, active_ledger, control_owner=memory
        )
    except BaseException:
        # Primary-error precedence on the constructor unwind, matching the main
        # body below: the constructor's decision is what the caller sees, and a
        # cleanup that could not release leaves the owner alive so its finalizer
        # still gives the reservation back.
        if memory is not None:
            try:
                memory.close()
            except BaseException as cleanup_error:
                _detach_exception_chain(cleanup_error)
        raise
    if seen:
        session.validated_commits.update(seen)
    run_error: BaseException | None = None
    try:
        session.validate_commit(commit_id, poll)
        if seen is not None:
            seen.update(session.validated_commits)
        session.finalize(terminate=not caller_owned, poll=poll)
    except BaseException as exc:
        run_error = exc
    # Primary-error precedence: a cleanup failure never masks the decision that
    # caused it, and a still-owed release stays retryable through its owner.
    cleanup_error: BaseException | None = None
    for release in (lambda: session.close(None), None if memory is None else memory.close):
        if release is None:
            continue
        try:
            release()
        except BaseException as exc:
            if cleanup_error is None:
                cleanup_error = exc
    if run_error is not None:
        raise run_error
    if cleanup_error is not None:
        raise cleanup_error


def _validate_sealed_commit_payload(
    commit: dict[str, Any],
    load_payload: Any,
    charge_edge: Any = lambda: None,
    poll: Any | None = None,
    preflight_source: Any | None = None,
) -> None:
    def check() -> None:
        if poll is not None:
            poll()

    roots = commit.get("roots")
    if not isinstance(roots, dict):
        raise CFError("sealed commit validation failed: roots must be an object")
    required_roots = ["content_manifest", "atom_index", "trace_graph", "fire_delta", "verification", "policy"]
    expected_root_types = {
        "content_manifest": "content_manifest",
        "atom_index": "atom_index",
        "trace_graph": "trace_graph",
        "fire_delta": "fire_ledger",
        "resolution_ledger": "resolution_ledger",
        "verification": "verification",
        "policy": "policy",
    }
    for root in required_roots:
        check()
        if root not in roots:
            raise CFError(f"sealed commit validation failed: missing root {root}")
    ordered_roots = list(roots)
    _sort_strings_polling(ordered_roots, poll)
    for root in ordered_roots:
        check()
        oid = roots[root]
        if not isinstance(oid, str) or not oid.startswith("CF-"):
            raise CFError(f"sealed commit validation failed: root {root} must be an object id")
        expected_type = expected_root_types.get(root)
        if expected_type and preflight_source is not None:
            preflight_source(oid)
        charge_edge()
        if not expected_type:
            continue
        payload = load_payload(oid)
        if payload.get("type") != expected_type:
            raise CFError(f"sealed commit validation failed: root {root} has type {payload.get('type', '(missing)')}, expected {expected_type}")
    certificate = commit.get("certificate")
    if not isinstance(certificate, dict):
        raise CFError("sealed commit validation failed: certificate must be an object")
    if certificate.get("result") != "consistent":
        raise CFError("sealed commit validation failed: certificate is not consistent")
    policy_record = load_payload(roots["policy"])
    policy = policy_record.get("policy", {})
    if policy.get("require_commit_signature"):
        validate_commit_signature_structure(commit, required=True)
    else:
        validate_commit_signature_structure(commit, required=False)
    verification = load_payload(roots["verification"])
    check()
    if verification.get("result") != "passed":
        raise CFError("sealed commit validation failed: verification object did not pass")
    for failed_check in verification.get("failed_checks", []):
        check()
        if failed_check.get("id") == "merge-conflicts":
            raise CFError("sealed commit validation failed: merge conflicts remain")
    if policy_enabled(policy, "require_no_required_fires") and certificate.get("open_required_fires", 0) != 0:
        raise CFError("sealed commit validation failed: open fires remain")
    if policy_enabled(policy, "require_verification_success") and certificate.get("failed_checks", 0) != 0:
        raise CFError("sealed commit validation failed: verification checks failed")
    if policy_enabled(policy, "require_trace_completeness") and certificate.get("missing_required_links", 0) != 0:
        raise CFError("sealed commit validation failed: required links are missing")
    if policy_enabled(policy, "require_no_stale_resolutions") and certificate.get("stale_resolutions", 0) != 0:
        raise CFError("sealed commit validation failed: stale resolutions remain")
    if policy_enabled(policy, "reject_duplicate_atom_ids") and certificate.get("duplicate_atom_ids", 0) != 0:
        raise CFError("sealed commit validation failed: duplicate Atom IDs remain")


def ref_file_name(name: str) -> str:
    return urllib.parse.quote(name, safe="")


def branch_path(repo_root: Path, name: str) -> Path:
    return repo_dirs(repo_root)["branches"] / f"{ref_file_name(name)}.json"


def load_branch(repo_root: Path, name: str) -> dict[str, Any]:
    data = read_json(branch_path(repo_root, name))
    if not data:
        raise CFError(f"unknown branch: {name}")
    return data


def opened_registry_path(repo_root: Path, branch: str) -> Path:
    return repo_dirs(repo_root)["opened"] / f"{ref_file_name(branch)}.json"


def opened_branch_state(repo_root: Path, branch: str) -> str | None:
    registry = read_json(opened_registry_path(repo_root, branch))
    if not registry:
        return None
    return registry.get("state", {}).get("last_known", "open-clean")


def require_source_branch_sealed(repo_root: Path, branch: str, operation: str) -> None:
    state = opened_branch_state(repo_root, branch)
    if state and state != "open-clean":
        raise CFError(f"cannot {operation} from branch '{branch}' while it is {state}; commit or discard first")


def save_branch(repo_root: Path, data: dict[str, Any]) -> None:
    lock_name = f"branch-{ref_file_name(data['name'])}.lock"
    with file_lock(repo_dirs(repo_root)["locks"] / lock_name):
        write_json(branch_path(repo_root, data["name"]), data)
        store_object(repo_root, "branch", data)


def branch_names(repo_root: Path) -> list[str]:
    names = []
    for path in sorted(repo_dirs(repo_root)["branches"].glob("*.json")):
        names.append(read_json(path)["name"])
    return names


def active_dir(repo_root: Path, open_instance_id: str) -> Path:
    return repo_dirs(repo_root)["active"] / open_instance_id


def rel_files(open_dir: Path) -> list[Path]:
    files: list[Path] = []
    for root, dirs, names in os.walk(open_dir):
        root_path = Path(root)
        dirs[:] = [d for d in dirs if d not in {".codefire", "__pycache__", ".pytest_cache"}]
        for name in names:
            path = root_path / name
            rel = path.relative_to(open_dir)
            if rel.as_posix() == ".codefire-open":
                continue
            files.append(rel)
    return sorted(files, key=lambda p: p.as_posix())


def read_text_lossy(path: Path) -> str:
    return path.read_text(encoding="utf-8", errors="replace")


def parse_links(path: Path) -> list[dict[str, str]]:
    if not path.exists():
        return []
    links: list[dict[str, str]] = []
    current: dict[str, str] | None = None
    current_line = 0

    def flush_link() -> None:
        if current is None:
            return
        missing = {"from", "to", "type"} - set(current)
        if missing:
            raise CFError(f"invalid codefire.links.yaml: link at line {current_line} missing {', '.join(sorted(missing))}")
        links.append(current)

    for line_no, raw_line in enumerate(path.read_text(encoding="utf-8").splitlines(), start=1):
        line = raw_line.split("#", 1)[0]
        stripped = line.strip()
        if not stripped:
            continue
        m = re.match(r"-\s+from:\s*(.+)$", stripped)
        if m:
            flush_link()
            current = {"from": unquote(m.group(1))}
            current_line = line_no
            continue
        if current is None:
            continue
        m = re.match(r"(to|type):\s*(.+)$", stripped)
        if m:
            current[m.group(1)] = unquote(m.group(2))
    flush_link()
    return links


def unquote(value: str) -> str:
    value = value.strip()
    if len(value) >= 2 and value[0] in {'"', "'"} and value[-1] == value[0]:
        return value[1:-1]
    return value


def parse_bool(value: str) -> bool:
    normalized = unquote(value).strip().lower()
    if normalized in {"true", "yes", "on", "1"}:
        return True
    if normalized in {"false", "no", "off", "0"}:
        return False
    raise CFError(f"invalid boolean value in policy: {value}")


def policy_enabled(policy: dict[str, Any], key: str) -> bool:
    return bool(policy.get(key, True))


def parse_config(open_dir: Path) -> dict[str, list[str]]:
    defaults = {
        "requirements": ["docs/spec/**/*.md", "docs/requirements/**/*.md"],
        "designs": ["docs/design/**/*.md"],
        "adrs": ["adr/**/*.md", "docs/adr/**/*.md", "docs/adrs/**/*.md"],
        "ops": ["docs/ops/**/*.md", "docs/runbooks/**/*.md", "runbooks/**/*.md"],
        "apis": [
            "docs/api/**/*.json",
            "docs/api/**/*.yaml",
            "docs/api/**/*.yml",
            "openapi/**/*.json",
            "openapi/**/*.yaml",
            "openapi/**/*.yml",
            "api/**/*.json",
            "api/**/*.yaml",
            "api/**/*.yml",
        ],
        "db": ["db/**/*.sql", "schema/**/*.sql", "schemas/**/*.sql"],
        "code": ["src/**/*.py"],
        "tests": ["tests/**/*.py"],
    }
    path = open_dir / "codefire.yaml"
    if not path.exists():
        return defaults
    config = {k: [] for k in defaults}
    current: str | None = None
    for line_no, raw_line in enumerate(path.read_text(encoding="utf-8").splitlines(), start=1):
        line = raw_line.split("#", 1)[0]
        stripped = line.strip()
        if not stripped:
            continue
        if not raw_line.startswith((" ", "\t")):
            current = None
        if stripped.rstrip(":") in config and stripped.endswith(":"):
            current = stripped[:-1]
            continue
        m = re.match(r"-\s+path:\s*(.+)$", stripped)
        if current and m:
            value = unquote(m.group(1))
            if not value:
                raise CFError(f"invalid codefire.yaml: empty path at line {line_no}")
            config[current].append(value)
            continue
        if current and stripped.startswith("- "):
            raise CFError(f"invalid codefire.yaml: artifact entry at line {line_no} must start with 'path:'")
    for key, value in defaults.items():
        if not config[key]:
            config[key] = value
    return config


def parse_policy(open_dir: Path) -> dict[str, Any]:
    path = open_dir / "codefire.policy.yaml"
    default_required_links = {
        "requirement": [
            {"type": "refined_by", "target_kind": "design", "min": 1},
            {"type": "verified_by", "target_kind": "test", "min": 1},
        ],
        "design": [{"type": "implemented_by", "target_kind": "code", "min": 1}],
    }
    policy = {
        "require_no_required_fires": True,
        "require_no_stale_resolutions": True,
        "require_trace_completeness": True,
        "require_verification_success": True,
        "reject_duplicate_atom_ids": True,
        "no_change_required_requires_rationale": True,
        "required_links": default_required_links,
        "verification": [],
    }
    if not path.exists():
        return policy
    checks: list[dict[str, str]] = []
    current: dict[str, str] | None = None
    custom_required_links: dict[str, list[dict[str, Any]]] = {}
    current_link_kind: str | None = None
    current_link_rule: dict[str, Any] | None = None
    in_required_links = False
    in_commit_policy = False
    in_extinguish_policy = False
    in_no_change_required_policy = False

    def flush_check() -> None:
        if current and current.get("command"):
            check = dict(current)
            check.setdefault("id", f"verification-{len(checks) + 1}")
            check.setdefault("cwd", ".")
            checks.append(check)
        elif current:
            raise CFError("invalid codefire.policy.yaml: verification entry missing command")

    def flush_required_link() -> None:
        if current_link_kind and current_link_rule:
            missing = {"type", "target_kind"} - set(current_link_rule)
            if missing:
                raise CFError(f"invalid codefire.policy.yaml: required_links.{current_link_kind} missing {', '.join(sorted(missing))}")
            rule = dict(current_link_rule)
            try:
                rule["min"] = int(rule.get("min", 1) or 1)
            except ValueError as exc:
                raise CFError(f"invalid codefire.policy.yaml: required_links.{current_link_kind}.min must be an integer") from exc
            custom_required_links.setdefault(current_link_kind, []).append(rule)

    for raw_line in path.read_text(encoding="utf-8").splitlines():
        line = raw_line.split("#", 1)[0].rstrip()
        stripped = line.strip()
        if not stripped:
            continue
        if not raw_line.startswith((" ", "\t")):
            if stripped == "required_links:":
                flush_required_link()
                current_link_kind = None
                current_link_rule = None
                in_required_links = True
                in_commit_policy = False
            elif stripped == "commit_policy:":
                flush_required_link()
                current_link_kind = None
                current_link_rule = None
                in_required_links = False
                in_commit_policy = True
                in_extinguish_policy = False
                in_no_change_required_policy = False
            elif stripped == "extinguish_policy:":
                flush_required_link()
                current_link_kind = None
                current_link_rule = None
                in_required_links = False
                in_commit_policy = False
                in_extinguish_policy = True
                in_no_change_required_policy = False
            else:
                flush_required_link()
                current_link_kind = None
                current_link_rule = None
                in_required_links = False
                in_commit_policy = False
                in_extinguish_policy = False
                in_no_change_required_policy = False
        if in_commit_policy:
            m = re.match(r"(require_no_required_fires|require_no_stale_resolutions|require_trace_completeness|require_verification_success|reject_duplicate_atom_ids):\s*(.+)$", stripped)
            if m:
                policy[m.group(1)] = parse_bool(m.group(2))
                continue
        if in_extinguish_policy:
            if re.match(r"^\s{2}no-change-required:\s*$", line):
                in_no_change_required_policy = True
                continue
            m = re.match(r"requires_rationale:\s*(.+)$", stripped)
            if m and in_no_change_required_policy:
                policy["no_change_required_requires_rationale"] = parse_bool(m.group(1))
                continue
        if in_required_links:
            m = re.match(r"^\s{2}([A-Za-z_][A-Za-z0-9_-]*):\s*$", line)
            if m:
                flush_required_link()
                current_link_kind = m.group(1)
                current_link_rule = None
                custom_required_links.setdefault(current_link_kind, [])
                continue
            m = re.match(r"-\s+(type|target_kind|min):\s*(.+)$", stripped)
            if m:
                flush_required_link()
                current_link_rule = {m.group(1): unquote(m.group(2))}
                continue
            m = re.match(r"(type|target_kind|min):\s*(.+)$", stripped)
            if m and current_link_rule is not None:
                current_link_rule[m.group(1)] = unquote(m.group(2))
                continue
        m = re.match(r"-\s+(id|command|cwd):\s*(.+)$", stripped)
        if m:
            flush_check()
            current = {m.group(1): unquote(m.group(2))}
            if "cwd" not in current:
                current["cwd"] = "."
            continue
        m = re.match(r"(id|command|cwd):\s*(.+)$", stripped)
        if m:
            if current is None:
                current = {"cwd": "."}
            current[m.group(1)] = unquote(m.group(2))
    flush_check()
    flush_required_link()
    if custom_required_links:
        policy["required_links"] = custom_required_links
    policy["verification"].extend(checks)
    return policy


def matches_any(rel: Path, patterns: list[str]) -> bool:
    s = rel.as_posix()
    for pat in patterns:
        if fnmatch.fnmatch(s, pat):
            return True
        if "**/" in pat and fnmatch.fnmatch(s, pat.replace("**/", "")):
            return True
    return False


def kind_from_atom_id(atom_id: str, fallback: str = "unknown") -> str:
    if atom_id.startswith("REQ-"):
        return "requirement"
    if atom_id.startswith("DES-"):
        return "design"
    if atom_id.startswith("TEST-"):
        return "test"
    if atom_id.startswith("CODE-") or atom_id.startswith("CODE:"):
        return "code"
    if atom_id.startswith("ADR-"):
        return "adr"
    if atom_id.startswith("OPS-"):
        return "ops"
    if atom_id.startswith("API-"):
        return "api"
    if atom_id.startswith("DB-"):
        return "db"
    return fallback


def hash_text(text: str) -> str:
    return digest_bytes(text.encode("utf-8"))


def extract_markdown_atoms(path: Path, rel: Path, fallback_kind: str) -> list[dict[str, Any]]:
    lines = read_text_lossy(path).splitlines()
    headings: list[tuple[int, int, str]] = []
    for i, line in enumerate(lines):
        m = re.match(r"^(#{1,6})\s+([A-Z]+-[A-Za-z0-9_.-]+)(?::|\s|$)", line)
        if m:
            headings.append((i, len(m.group(1)), m.group(2)))
    atoms: list[dict[str, Any]] = []
    for idx, (start, level, atom_id) in enumerate(headings):
        end = len(lines)
        for next_start, next_level, _ in headings[idx + 1 :]:
            if next_level <= level:
                end = next_start
                break
        content = "\n".join(lines[start:end]).strip() + "\n"
        atoms.append(
            {
                "atom_id": atom_id,
                "kind": kind_from_atom_id(atom_id, fallback_kind),
                "artifact_path": rel.as_posix(),
                "selector": {"type": "markdown_heading", "value": atom_id},
                "content_hash": hash_text(content),
            }
        )
    return atoms


def python_blocks(lines: list[str]) -> list[tuple[int, int, str, str]]:
    blocks: list[tuple[int, int, str, str]] = []
    class_stack: list[tuple[int, str]] = []
    for i, line in enumerate(lines):
        m = re.match(r"^(\s*)(class|def)\s+([A-Za-z_][A-Za-z0-9_]*)", line)
        if not m:
            continue
        indent = len(m.group(1))
        while class_stack and indent <= class_stack[-1][0]:
            class_stack.pop()
        end = len(lines)
        for j in range(i + 1, len(lines)):
            text = lines[j]
            if text.strip() == "":
                continue
            current_indent = len(text) - len(text.lstrip(" "))
            if current_indent <= indent and not text.lstrip().startswith(("#", "@")):
                end = j
                break
        symbol_type = m.group(2)
        name = m.group(3)
        if symbol_type == "class":
            class_stack.append((indent, name))
        elif class_stack:
            symbol_type = "method"
            name = f"{class_stack[-1][1]}.{name}"
        blocks.append((i, end, symbol_type, name))
    return blocks


def extract_python_atoms(path: Path, rel: Path, fallback_kind: str) -> list[dict[str, Any]]:
    lines = read_text_lossy(path).splitlines()
    explicit_by_line: dict[int, str] = {}
    for i, line in enumerate(lines):
        m = re.search(r"#\s*cf-atom:\s*([A-Za-z0-9_.:-]+)", line)
        if m:
            explicit_by_line[i] = m.group(1)
    atoms: list[dict[str, Any]] = []
    used_explicit: set[int] = set()
    for start, end, symbol_type, name in python_blocks(lines):
        explicit_line = None
        for candidate in range(max(0, start - 3), start + 1):
            if candidate in explicit_by_line and candidate not in used_explicit:
                explicit_line = candidate
        if explicit_line is not None:
            atom_id = explicit_by_line[explicit_line]
            used_explicit.add(explicit_line)
        else:
            prefix = "TEST" if fallback_kind == "test" else "CODE"
            atom_id = f"{prefix}:{rel.as_posix()}::{symbol_type}:{name}"
        content_start = explicit_line if explicit_line is not None else start
        content = "\n".join(lines[content_start:end]).strip() + "\n"
        atoms.append(
            {
                "atom_id": atom_id,
                "kind": kind_from_atom_id(atom_id, fallback_kind),
                "artifact_path": rel.as_posix(),
                "selector": {"type": f"python_{symbol_type}", "value": name},
                "content_hash": hash_text(content),
            }
        )
    for line_no, atom_id in explicit_by_line.items():
        if line_no in used_explicit:
