class DecisionWorkLedger:
    """Checked, pre-effect accounting for one Python command or request."""

    def __init__(
        self,
        profile: DecisionWorkProfile,
        command: str,
        command_kind: str = "local_graph",
    ) -> None:
        if command_kind not in DECISION_WORK_COMMANDS:
            raise CFError(f"unknown decision-work command kind: {command_kind}")
        if command_kind not in profile.applicable_commands:
            raise CFError(
                f"decision-work command kind {command_kind} is not applicable to this profile"
            )
        self._profile = profile
        self._command = command
        self._command_kind = command_kind
        self._reserved: dict[DecisionWorkPermit, dict[str, Any]] = {}
        self._prepublication_sealed = False
        self._cumulative: dict[str, int] = {}
        self._maximum: dict[str, int] = {}
        self._current: dict[str, int] = {}
        self._peak: dict[str, int] = {}
        self._counters: dict[str, int] = {}
        self._phases: dict[str, dict[str, int]] = {}
        self._phase_counters: dict[str, dict[str, int]] = {}
        self._terminal_reason: str | None = None
        self._mutation_epoch = 0
        # Request-scoped coordinator registry.  Binding this one field blocks
        # stale aliases of both sealed and policy parents before either
        # parent's diagnostic mirror slot is assigned.
        self._upload_terminal_owner: Any | None = None

    @property
    def profile(self) -> DecisionWorkProfile:
        return self._profile

    @property
    def command(self) -> str:
        return self._command

    @property
    def command_kind(self) -> str:
        return self._command_kind

    @property
    def terminal_reason(self) -> str | None:
        return self._terminal_reason

    @property
    def cumulative(self) -> MappingProxyType:
        return MappingProxyType(self._cumulative)

    @property
    def maximum(self) -> MappingProxyType:
        return MappingProxyType(self._maximum)

    @property
    def current(self) -> MappingProxyType:
        return MappingProxyType(self._current)

    @property
    def peak(self) -> MappingProxyType:
        return MappingProxyType(self._peak)

    @property
    def counters(self) -> MappingProxyType:
        return MappingProxyType(self._counters)

    @staticmethod
    def _amount(value: int) -> int:
        if isinstance(value, bool) or not isinstance(value, int) or value < 0:
            raise CFError("decision-work charge must be a non-negative integer")
        return value

    @staticmethod
    def _checked_add(current: int, amount: int) -> int | None:
        if current > U64_MAX - amount:
            return None
        return current + amount

    def _ensure_active(self) -> None:
        if self._terminal_reason is not None:
            raise CFError(
                f"decision-work ledger is already terminal: {self._terminal_reason}"
            )

    def _exceeded(
        self,
        dimension: str,
        observed: int,
        phase: str,
        surface: str,
    ) -> ResourceBudgetExceeded:
        self._terminal_reason = "budget_exceeded"
        return ResourceBudgetExceeded(
            profile=self._profile.profile_id,
            dimension=dimension,
            observed=observed,
            limit=self._profile.limit(dimension),
            phase=phase,
            command=self._command,
            continuation_supported=surface == "snapshot_paged",
        )

    def _candidate(
        self, current: int, amount: int, dimension: str
    ) -> tuple[int, bool]:
        candidate = self._checked_add(current, self._amount(amount))
        if candidate is None:
            return min(U64_MAX, self._profile.limit(dimension) + 1), True
        return candidate, False

    def apply(
        self,
        phase: str,
        *,
        charges: dict[str, int] | None = None,
        maxima: dict[str, int] | None = None,
        acquires: dict[str, int] | None = None,
        counters: dict[str, int] | None = None,
        surface: str = "atomic",
    ) -> None:
        """Preflight and commit one Rust-style reservation atomically."""
        if self._prepublication_sealed:
            raise CFError("decision-work ledger is sealed for publication")
        reservation = self._reservation(
            phase, charges, maxima, acquires, counters, surface
        )
        actual = self._accounting_clone()
        try:
            self._apply_reservation(actual, reservation)
            capacity = actual._accounting_clone()
            for existing in self._reserved.values():
                self._apply_reservation(capacity, existing)
        except ResourceBudgetExceeded:
            self._terminal_reason = "budget_exceeded"
            raise
        self._mutation_epoch += 1
        self._cumulative = dict(actual._cumulative)
        self._maximum = dict(actual._maximum)
        self._current = dict(actual._current)
        self._peak = dict(actual._peak)
        self._counters = dict(actual._counters)
        self._phases = {key: dict(value) for key, value in actual._phases.items()}
        self._phase_counters = {
            key: dict(value) for key, value in actual._phase_counters.items()
        }

    def _apply_unsealed(
        self,
        phase: str,
        *,
        charges: dict[str, int] | None = None,
        maxima: dict[str, int] | None = None,
        acquires: dict[str, int] | None = None,
        counters: dict[str, int] | None = None,
        surface: str = "atomic",
    ) -> None:
        self._ensure_active()
        if phase not in DECISION_WORK_PHASES:
            raise CFError(f"unknown decision-work phase: {phase}")
        if phase not in self._profile.applicable_phases:
            raise CFError(
                f"decision-work phase {phase} is not applicable to this profile"
            )
        if surface not in {"atomic", "snapshot_paged"}:
            raise CFError(f"unknown decision-work surface: {surface}")
        for dimension in [
            *(charges or {}),
            *(maxima or {}),
            *(acquires or {}),
        ]:
            if dimension not in _DIMENSION_ORDER:
                raise CFError(f"unknown decision-work dimension: {dimension}")
        for counter in counters or {}:
            if counter not in _COUNTER_ORDER:
                raise CFError(f"unknown decision-work counter: {counter}")
        next_cumulative = dict(self._cumulative)
        next_maximum = dict(self._maximum)
        next_current = dict(self._current)
        next_peak = dict(self._peak)
        next_counters = dict(self._counters)

        for dimension, amount in sorted(
            (charges or {}).items(), key=lambda item: _DIMENSION_ORDER[item[0]]
        ):
            measurement, limit = self._profile.limits.get(dimension, (None, None))
            if measurement != "cumulative":
                raise CFError(f"decision-work measurement mismatch for {dimension}")
            observed, overflow = self._candidate(
                next_cumulative.get(dimension, 0), amount, dimension
            )
            if overflow or observed > limit:
                raise self._exceeded(dimension, observed, phase, surface)
            next_cumulative[dimension] = observed
        maximum_deltas: dict[str, int] = {}
        for dimension, value in sorted(
            (maxima or {}).items(), key=lambda item: _DIMENSION_ORDER[item[0]]
        ):
            measurement, limit = self._profile.limits.get(dimension, (None, None))
            if measurement != "maximum":
                raise CFError(f"decision-work measurement mismatch for {dimension}")
            requested = self._amount(value)
            domain_overflow = requested > U64_MAX
            observed = min(U64_MAX, requested)
            if domain_overflow or observed > limit:
                raise self._exceeded(dimension, observed, phase, surface)
            previous = next_maximum.get(dimension, 0)
            next_maximum[dimension] = max(previous, observed)
            maximum_deltas[dimension] = max(0, observed - previous)
        for dimension, amount in sorted(
            (acquires or {}).items(), key=lambda item: _DIMENSION_ORDER[item[0]]
        ):
            measurement, limit = self._profile.limits.get(dimension, (None, None))
            if measurement != "concurrent":
                raise CFError(f"decision-work measurement mismatch for {dimension}")
            observed, overflow = self._candidate(
                next_current.get(dimension, 0), amount, dimension
            )
            if overflow or observed > limit:
                raise self._exceeded(dimension, observed, phase, surface)
            next_current[dimension] = observed
            next_peak[dimension] = max(next_peak.get(dimension, 0), observed)
        counter_limit = self._profile.limit("counter_values")
        for counter, amount in sorted(
            (counters or {}).items(), key=lambda item: _COUNTER_ORDER[item[0]]
        ):
            observed, overflow = self._candidate(
                next_counters.get(counter, 0), amount, "counter_values"
            )
            if overflow or observed > counter_limit:
                raise self._exceeded("counter_values", observed, phase, surface)
            next_counters[counter] = observed

        next_phases = {key: dict(value) for key, value in self._phases.items()}
        phase_values = next_phases.setdefault(phase, {})
        for dimension, amount in (charges or {}).items():
            value = self._checked_add(phase_values.get(dimension, 0), amount)
            if value is None:
                raise CFError("decision-work phase accounting overflow")
            phase_values[dimension] = value
        for dimension, delta in maximum_deltas.items():
            if delta:
                value = self._checked_add(phase_values.get(dimension, 0), delta)
                if value is None:
                    raise CFError("decision-work phase accounting overflow")
                phase_values[dimension] = value
        for dimension, amount in (acquires or {}).items():
            value = self._checked_add(phase_values.get(dimension, 0), amount)
            if value is None:
                raise CFError("decision-work phase accounting overflow")
            phase_values[dimension] = value
        next_phase_counters = {
            key: dict(value) for key, value in self._phase_counters.items()
        }
        phase_counter_values = next_phase_counters.setdefault(phase, {})
        for counter, amount in (counters or {}).items():
            value = self._checked_add(phase_counter_values.get(counter, 0), amount)
            if value is None:
                raise CFError("decision-work phase counter accounting overflow")
            phase_counter_values[counter] = value

        self._cumulative = next_cumulative
        self._maximum = next_maximum
        self._current = next_current
        self._peak = next_peak
        self._counters = next_counters
        self._phases = next_phases
        self._phase_counters = next_phase_counters

    def _accounting_clone(self) -> "DecisionWorkLedger":
        clone = object.__new__(type(self))
        clone._profile = self._profile
        clone._command = self._command
        clone._command_kind = self._command_kind
        clone._reserved = {}
        clone._prepublication_sealed = False
        clone._cumulative = dict(self._cumulative)
        clone._maximum = dict(self._maximum)
        clone._current = dict(self._current)
        clone._peak = dict(self._peak)
        clone._counters = dict(self._counters)
        clone._phases = {key: dict(value) for key, value in self._phases.items()}
        clone._phase_counters = {
            key: dict(value) for key, value in self._phase_counters.items()
        }
        clone._terminal_reason = self._terminal_reason
        clone._mutation_epoch = self._mutation_epoch
        clone._upload_terminal_owner = None
        return clone

    @staticmethod
    def _reservation(
        phase: str,
        charges: dict[str, int] | None,
        maxima: dict[str, int] | None,
        acquires: dict[str, int] | None,
        counters: dict[str, int] | None,
        surface: str,
    ) -> dict[str, Any]:
        return {
            "phase": phase,
            "charges": dict(charges or {}),
            "maxima": dict(maxima or {}),
            "acquires": dict(acquires or {}),
            "counters": dict(counters or {}),
            "surface": surface,
        }

    @staticmethod
    def _apply_reservation(
        ledger: "DecisionWorkLedger", reservation: dict[str, Any]
    ) -> None:
        ledger._apply_unsealed(**reservation)

    def reserve(
        self,
        phase: str,
        *,
        charges: dict[str, int] | None = None,
        maxima: dict[str, int] | None = None,
        acquires: dict[str, int] | None = None,
        counters: dict[str, int] | None = None,
        surface: str = "atomic",
    ) -> DecisionWorkPermit:
        permit = DecisionWorkPermit()
        self.reserve_into(
            permit,
            phase,
            charges=charges,
            maxima=maxima,
            acquires=acquires,
            counters=counters,
            surface=surface,
        )
        return permit

    def _register_reservation(
        self,
        permit: DecisionWorkPermit,
        reservation: dict[str, Any],
    ) -> None:
        """Publish one preflighted reservation at a fault-injectable boundary."""
        self._mutation_epoch += 1
        self._reserved[permit] = reservation

    def reserve_into(
        self,
        permit: DecisionWorkPermit,
        phase: str,
        *,
        charges: dict[str, int] | None = None,
        maxima: dict[str, int] | None = None,
        acquires: dict[str, int] | None = None,
        counters: dict[str, int] | None = None,
        surface: str = "atomic",
    ) -> None:
        """Register a caller-owned permit after an atomic capacity preflight."""
        if self._prepublication_sealed:
            raise CFError("decision-work ledger is sealed for publication")
        if not isinstance(permit, DecisionWorkPermit):
            raise CFError("decision-work permit has an invalid type")
        if permit._ledger_identity is not None:
            raise CFError("decision-work permit is already bound")
        reservation = self._reservation(
            phase, charges, maxima, acquires, counters, surface
        )
        capacity = self._accounting_clone()
        try:
            for existing in self._reserved.values():
                self._apply_reservation(capacity, existing)
            self._apply_reservation(capacity, reservation)
        except ResourceBudgetExceeded:
            self._terminal_reason = "budget_exceeded"
            raise
        object.__setattr__(permit, "_ledger_identity", id(self))
        self._register_reservation(permit, reservation)

    def consume_reserved(
        self,
        permit: DecisionWorkPermit,
        *,
        phase: str,
        charges: dict[str, int] | None = None,
        maxima: dict[str, int] | None = None,
        acquires: dict[str, int] | None = None,
        counters: dict[str, int] | None = None,
        surface: str = "atomic",
    ) -> None:
        if (
            not isinstance(permit, DecisionWorkPermit) or permit not in self._reserved
        ):
            raise CFError("decision-work permit does not belong to this ledger")
        actual = self._reservation(phase, charges, maxima, acquires, counters, surface)
        upper = self._reserved[permit]
        if actual["phase"] != upper["phase"] or actual["surface"] != upper["surface"]:
            raise CFError("decision-work permit consumption exceeds its reserved upper bound")
        remaining = self._reservation(
            upper["phase"], {}, dict(upper["maxima"]), {}, {}, upper["surface"]
        )
        for field in ["charges", "acquires", "counters"]:
            remaining[field] = dict(upper[field])
            for key, amount in actual[field].items():
                if key not in remaining[field] or amount > remaining[field][key]:
                    raise CFError(
                        "decision-work permit consumption exceeds its reserved upper bound"
                    )
                left = remaining[field][key] - amount
                if left:
                    remaining[field][key] = left
                else:
                    del remaining[field][key]
        for key, value in actual["maxima"].items():
            if key not in upper["maxima"] or value > upper["maxima"][key]:
                raise CFError(
                    "decision-work permit consumption exceeds its reserved upper bound"
                )
        actual_ledger = self._accounting_clone()
        try:
            self._apply_reservation(actual_ledger, actual)
            capacity = actual_ledger._accounting_clone()
            for reserved_permit, reservation in self._reserved.items():
                self._apply_reservation(
                    capacity,
                    remaining if reserved_permit is permit else reservation,
                )
        except ResourceBudgetExceeded:
            self._terminal_reason = "budget_exceeded"
            raise
        self._mutation_epoch += 1
        self._cumulative = dict(actual_ledger._cumulative)
        self._maximum = dict(actual_ledger._maximum)
        self._current = dict(actual_ledger._current)
        self._peak = dict(actual_ledger._peak)
        self._counters = dict(actual_ledger._counters)
        self._phases = {
            key: dict(value) for key, value in actual_ledger._phases.items()
        }
        self._phase_counters = {
            key: dict(value) for key, value in actual_ledger._phase_counters.items()
        }
        if any(remaining[field] for field in ["charges", "maxima", "acquires", "counters"]):
            self._reserved[permit] = remaining
        else:
            del self._reserved[permit]

    def cancel_permit(self, permit: DecisionWorkPermit) -> None:
        if (
            not isinstance(permit, DecisionWorkPermit) or permit not in self._reserved
        ):
            raise CFError("decision-work permit does not belong to this ledger")
        self._mutation_epoch += 1
        del self._reserved[permit]

    def has_open_permits(self) -> bool:
        return bool(self._reserved)

    def permit_is_open(self, permit: DecisionWorkPermit) -> bool:
        return permit in self._reserved

    def seal_prepublication(self) -> None:
        self._ensure_active()
        self._mutation_epoch += 1
        self._prepublication_sealed = True

    def charge(
        self, dimension: str, amount: int, phase: str, surface: str = "atomic"
    ) -> None:
        self.apply(phase, charges={dimension: amount}, surface=surface)

    def observe_maximum(
        self, dimension: str, value: int, phase: str, surface: str = "atomic"
    ) -> None:
        self.apply(phase, maxima={dimension: value}, surface=surface)

    def acquire(
        self, dimension: str, amount: int, phase: str, surface: str = "atomic"
    ) -> None:
        self.apply(phase, acquires={dimension: amount}, surface=surface)

    def release(self, dimension: str, amount: int) -> None:
        amount = self._amount(amount)
        measurement, _ = self._profile.limits.get(dimension, (None, None))
        if measurement != "concurrent":
            raise CFError(f"decision-work measurement mismatch for {dimension}")
        current = self._current.get(dimension, 0)
        if amount > current:
            raise CFError(f"decision-work release underflow for {dimension}")
        self._mutation_epoch += 1
        self._current[dimension] = current - amount

    def count(self, counter: str, amount: int, phase: str) -> None:
        self.apply(phase, counters={counter: amount})

    def terminate(self, reason: str) -> None:
        if self._reserved:
            raise CFError("decision-work ledger still has open publication permits")
        if self._terminal_reason is not None:
            raise CFError(
                f"decision-work ledger is already terminal: {self._terminal_reason}"
            )
        self._mutation_epoch += 1
        self._terminal_reason = reason

    def snapshot(self) -> dict[str, Any]:
        return {
            "cumulative": dict(self._cumulative),
            "maximum": dict(self._maximum),
            "current": dict(self._current),
            "peak": dict(self._peak),
            "counters": dict(self._counters),
            "phases": {key: dict(value) for key, value in self._phases.items()},
            "phase_counters": {
                key: dict(value) for key, value in self._phase_counters.items()
            },
            "terminal_reason": self._terminal_reason,
        }


@contextlib.contextmanager
def file_lock(lock_path: Path):
    lock_path.parent.mkdir(parents=True, exist_ok=True)
    try:
        fd = os.open(lock_path, os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o600)
    except FileExistsError as exc:
        raise CFError(f"lock is already held: {lock_path}") from exc
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write(f"pid={os.getpid()}\ncreated_at={now_iso()}\n")
        yield
    finally:
        try:
            lock_path.unlink()
        except FileNotFoundError:
            pass


def _open_directory_nofollow(path: Path) -> int:
    """Open an absolute directory one component at a time without following links."""
    if not hasattr(os, "O_NOFOLLOW"):
        raise CFError("no-follow directory capabilities are unsupported on this platform")
    absolute = Path(os.path.abspath(path))
    flags = os.O_RDONLY | getattr(os, "O_DIRECTORY", 0) | os.O_NOFOLLOW
    fd = os.open(os.sep, flags)
    try:
        for component in absolute.parts[1:]:
            next_fd = os.open(component, flags, dir_fd=fd)
            os.close(fd)
            fd = next_fd
        return fd
    except Exception:
        os.close(fd)
        raise


def _open_or_create_directory_nofollow(path: Path) -> int:
    """Create missing components relative to already-open parents; reject every link."""
    if not hasattr(os, "O_NOFOLLOW"):
        raise CFError("no-follow directory capabilities are unsupported on this platform")
    absolute = Path(os.path.abspath(path))
    flags = os.O_RDONLY | getattr(os, "O_DIRECTORY", 0) | os.O_NOFOLLOW
    fd = os.open(os.sep, flags)
    try:
        for component in absolute.parts[1:]:
            try:
                next_fd = os.open(component, flags, dir_fd=fd)
            except FileNotFoundError:
                os.mkdir(component, 0o700, dir_fd=fd)
                next_fd = os.open(component, flags, dir_fd=fd)
            os.close(fd)
            fd = next_fd
        return fd
    except Exception:
        os.close(fd)
        raise


def _open_or_create_directory_at(parent_fd: int, name: str) -> int:
    validate_remote_component(name, "directory")
    try:
        os.mkdir(name, 0o700, dir_fd=parent_fd)
    except FileExistsError:
        pass
    flags = os.O_RDONLY | getattr(os, "O_DIRECTORY", 0) | os.O_NOFOLLOW
    return os.open(name, flags, dir_fd=parent_fd)


@contextlib.contextmanager
def stable_remote_lock(
    lock_path: Path, *, shared: bool = False, directory_fd: int | None = None
):
    """Hold a persistent, no-follow remote lock inode with Unix flock."""
    if fcntl is None or not hasattr(os, "O_NOFOLLOW"):
        raise CFError("persistent remote locking is unsupported on this platform")
    owned_directory_fd = (
        _open_directory_nofollow(lock_path.parent)
        if directory_fd is None
        else os.dup(directory_fd)
    )
    fd = -1
    try:
        fd = os.open(
            lock_path.name,
            os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW,
            0o600,
            dir_fd=owned_directory_fd,
        )
        before = os.stat(lock_path.name, dir_fd=owned_directory_fd, follow_symlinks=False)
        opened = os.fstat(fd)
        if (
            not stat.S_ISREG(before.st_mode)
            or not stat.S_ISREG(opened.st_mode)
            or before.st_nlink != 1
            or opened.st_nlink != 1
            or (before.st_dev, before.st_ino) != (opened.st_dev, opened.st_ino)
        ):
            raise CFError(f"remote lock identity is invalid: {lock_path}")
        operation = fcntl.LOCK_SH if shared else fcntl.LOCK_EX
        try:
            fcntl.flock(fd, operation | fcntl.LOCK_NB)
        except BlockingIOError as exc:
            raise CFError(f"lock is already held: {lock_path}") from exc
        after = os.stat(lock_path.name, dir_fd=owned_directory_fd, follow_symlinks=False)
        if (
            not stat.S_ISREG(after.st_mode)
            or after.st_nlink != 1
            or (after.st_dev, after.st_ino) != (opened.st_dev, opened.st_ino)
        ):
            raise CFError(f"remote lock identity changed: {lock_path}")
        _publish_remote_lock_owner(owned_directory_fd, lock_path.name, shared)
        yield
    finally:
        if fd >= 0:
            try:
                fcntl.flock(fd, fcntl.LOCK_UN)
            finally:
                os.close(fd)
        os.close(owned_directory_fd)


def _publish_remote_lock_owner(directory_fd: int, lock_name: str, shared: bool) -> None:
    owner_name = f"{lock_name}.owner.json"
    temp_name = f".{owner_name}.tmp-{os.getpid()}-{time.time_ns()}"
    payload = canonical_json(
        {
            "version": 1,
            "pid": os.getpid(),
            "mode": "shared" if shared else "exclusive",
            "created_at": now_iso(),
        }
    ) + b"\n"
    temp_fd = -1
    try:
        temp_fd = os.open(
            temp_name,
            os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW,
            0o600,
            dir_fd=directory_fd,
        )
        os.write(temp_fd, payload)
        os.fsync(temp_fd)
        os.close(temp_fd)
        temp_fd = -1
        os.replace(temp_name, owner_name, src_dir_fd=directory_fd, dst_dir_fd=directory_fd)
        os.fsync(directory_fd)
    except OSError:
        # Owner metadata is diagnostic and never authoritative.
        if temp_fd >= 0:
            os.close(temp_fd)
        try:
            os.unlink(temp_name, dir_fd=directory_fd)
        except OSError:
            pass


def now_iso() -> str:
    return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())


def canonical_json(value: Any) -> bytes:
    return json.dumps(value, ensure_ascii=False, sort_keys=True, separators=(",", ":")).encode("utf-8")


# ``json.dumps(..., ensure_ascii=False)`` escapes exactly these characters with
# a short form and every other code point below 0x20 as lowercase ``\uXXXX``.
_CANONICAL_SHORT_ESCAPES = {
    "\\": "\\\\",
    '"': '\\"',
    "\b": "\\b",
    "\f": "\\f",
    "\n": "\\n",
    "\r": "\\r",
    "\t": "\\t",
}
# One string is escaped a slice at a time and chunks are flushed once this many
# code points are pending, so the encoder's live scratch is a constant instead
# of a multiple of the encoded document.
CANONICAL_STREAM_SLICE_CHARS = 4096
CANONICAL_STREAM_CHUNK_CHARS = 32 * 1024
# Measured upper on the peak Python heap one ``canonical_json_stream`` call
# holds for its chunk scratch, independent of the encoded size: the worst
# observed shape (control characters escaped to six bytes each) peaks at
# 313,236 bytes for both a 720 KiB and a 2 MiB record.
CANONICAL_STREAM_SCRATCH_BYTES = 512 * 1024
# Each mapping's key order is materialised once while that mapping is emitted.
# A key costs at least three canonical bytes (``"":``) and at most one pointer,
# so three times the encoded size is an upper on every simultaneously live
# projection along one nesting path.
CANONICAL_STREAM_KEY_MULTIPLIER = 3
# One list slot, measured rather than assumed.
_CANONICAL_POINTER_BYTES = sys.getsizeof((None,)) - sys.getsizeof(tuple())


def _canonical_escaped_text(text: str) -> str:
    """Escape one bounded slice exactly as the canonical encoder would."""
    pieces: list[str] | None = None
    start = 0
    for index, character in enumerate(text):
        if character != '"' and character != "\\" and character > "\x1f":
            continue
        if pieces is None:
            pieces = []
        if start != index:
            pieces.append(text[start:index])
        escape = _CANONICAL_SHORT_ESCAPES.get(character)
        pieces.append("\\u%04x" % ord(character) if escape is None else escape)
        start = index + 1
    if pieces is None:
        return text
    if start != len(text):
        pieces.append(text[start:])
    return "".join(pieces)


def canonical_json_stream(
    value: Any,
    sink: Any,
    poll: Any | None = None,
    claim: Any | None = None,
) -> None:
    """Emit ``canonical_json(value)`` iteratively in bounded chunks.

    The byte stream handed to ``sink`` concatenates to exactly what
    ``canonical_json`` returns, but no more than one chunk of encoder scratch is
    ever live, so a whole-record heap duplicate is never reserved.  ``claim``,
    when supplied, receives the signed delta of each mapping's sorted-key
    projection so the caller can prove an outstanding reservation owns it.
    """
    pieces: list[str] = []
    pending = 0

    def flush() -> None:
        nonlocal pending
        if not pieces:
            return
        text = "".join(pieces)
        del pieces[:]
        pending = 0
        sink(text.encode("utf-8"))

    def emit(text: str) -> None:
        nonlocal pending
        if not text:
            return
        pieces.append(text)
        pending += len(text)
        if pending >= CANONICAL_STREAM_CHUNK_CHARS:
            flush()

    def emit_string(text: str) -> None:
        length = len(text)
        if length <= CANONICAL_STREAM_SLICE_CHARS:
            emit('"' + _canonical_escaped_text(text) + '"')
            return
        emit('"')
        offset = 0
        while offset < length:
            if poll is not None:
                poll()
            emit(
                _canonical_escaped_text(
                    text[offset : offset + CANONICAL_STREAM_SLICE_CHARS]
                )
            )
            offset += CANONICAL_STREAM_SLICE_CHARS
        emit('"')

    def projection_bytes(count: int) -> int:
        return sys.getsizeof([]) + _CANONICAL_POINTER_BYTES * count

    stack: list[tuple[str, Any]] = [("value", value)]
    try:
        while stack:
            if poll is not None:
                poll()
            action, item = stack.pop()
            if action == "sequence":
                sequence, index = item
                if index >= len(sequence):
                    emit("]")
                    continue
                stack.append(("sequence", (sequence, index + 1)))
                if index:
                    emit(",")
                stack.append(("value", sequence[index]))
                continue
            if action == "mapping":
                mapping, keys, index = item
                if index >= len(keys):
                    emit("}")
                    if claim is not None:
                        claim(-projection_bytes(len(keys)))
                    continue
                stack.append(("mapping", (mapping, keys, index + 1)))
                if index:
                    emit(",")
                key = keys[index]
                emit_string(key if type(key) is str else str(key))
                emit(":")
                stack.append(("value", mapping[key]))
                continue
            if item is None:
                emit("null")
            elif item is True:
                emit("true")
            elif item is False:
                emit("false")
            elif isinstance(item, str):
                emit_string(item)
            elif isinstance(item, (list, tuple)):
                emit("[")
                if not item:
                    emit("]")
                    continue
                stack.append(("sequence", (item, 0)))
            elif isinstance(item, (dict, MappingProxyType)):
                emit("{")
                if not item:
                    emit("}")
                    continue
                if claim is not None:
                    claim(projection_bytes(len(item)))
                stack.append(("mapping", (item, sorted(item), 0)))
            else:
                # Uncommon scalars keep exact encoder compatibility; their
                # canonical form is a handful of characters.
                emit(
                    json.dumps(
                        item,
                        ensure_ascii=False,
                        sort_keys=True,
                        separators=(",", ":"),
                    )
                )
        flush()
    finally:
        del pieces[:]


def canonical_json_stream_digest(
    value: Any, poll: Any | None = None, claim: Any | None = None
) -> tuple[int, str]:
    """Return ``(size, sha256)`` of ``canonical_json(value)`` without holding it."""
    digest = hashlib.sha256()
    total = 0

    def sink(chunk: bytes) -> None:
        nonlocal total
        total += len(chunk)
        digest.update(chunk)

    canonical_json_stream(value, sink, poll, claim)
    return total, digest.hexdigest()


def canonical_json_size(value: Any) -> int:
    """Return canonical_json's byte length without materializing the document."""
    if value is None:
        return 4
    if value is True:
        return 4
    if value is False:
        return 5
    if isinstance(value, str):
        size = 2
        for character in value:
            point = ord(character)
            if character in {'"', "\\"} or character in "\b\f\n\r\t":
                size += 2
            elif point < 0x20:
                size += 6
            else:
                size += len(character.encode("utf-8"))
        return size
    if isinstance(value, int) and not isinstance(value, bool):
        if value == 0:
            return 1
        return (1 if value < 0 else 0) + int(math.log10(abs(value))) + 1
    if isinstance(value, list) or isinstance(value, tuple):
        return 2 + max(0, len(value) - 1) + sum(
            canonical_json_size(item) for item in value
        )
    if isinstance(value, dict) or isinstance(value, MappingProxyType):
        return 2 + max(0, len(value) - 1) + sum(
            canonical_json_size(str(key)) + 1 + canonical_json_size(item)
            for key, item in value.items()
        )
    # This helper is used for resource-sized JSON structures; retain exact
    # compatibility for uncommon scalar types through the canonical encoder.
    return len(canonical_json(value))


def canonical_json_size_up_to(
    value: Any, limit: int, poll: Any | None = None
) -> int:
    """Return the exact size through ``limit``, then stop at ``limit + 1``."""
    if isinstance(limit, bool) or not isinstance(limit, int) or limit < 0:
        raise CFError("canonical JSON size limit must be a non-negative integer")
    size = 0
    stack: list[tuple[str, Any]] = [("value", value)]
    while stack:
        if poll is not None:
            poll()
        action, item = stack.pop()
        if action == "sequence":
            try:
                child = next(item)
            except StopIteration:
                continue
            stack.append(("sequence", item))
            stack.append(("value", child))
            continue
        if action == "mapping":
            try:
                key, child = next(item)
            except StopIteration:
                continue
            stack.append(("mapping", item))
            stack.append(("value", child))
            stack.append(("value", str(key)))
            size += 1
        elif item is None:
            size += 4
        elif item is True:
            size += 4
        elif item is False:
            size += 5
        elif isinstance(item, str):
            size += 2
            for index, character in enumerate(item):
                if poll is not None and index % 256 == 0:
                    poll()
                point = ord(character)
                if character in {'"', "\\"} or character in "\b\f\n\r\t":
                    size += 2
                elif point < 0x20:
                    size += 6
                else:
                    size += len(character.encode("utf-8"))
                if size > limit:
                    return limit + 1
        elif isinstance(item, int) and not isinstance(item, bool):
            if item == 0:
                size += 1
            else:
                size += (1 if item < 0 else 0) + int(math.log10(abs(item))) + 1
        elif isinstance(item, (list, tuple)):
            size += 2 + max(0, len(item) - 1)
            stack.append(("sequence", iter(item)))
        elif isinstance(item, (dict, MappingProxyType)):
            size += 2 + max(0, len(item) - 1)
            stack.append(("mapping", iter(item.items())))
        else:
            size += len(canonical_json(item))
        if size > limit:
            return limit + 1
    return size


def _sha256_hexdigest_polling(
    data: bytes | bytearray | memoryview,
    poll: Any | None = None,
    *,
    chunk_bytes: int = 64 * 1024,
) -> str:
    """Hash bytes in bounded chunks, polling between every chunk."""
    if chunk_bytes <= 0:
        raise CFError("hash chunk size must be positive")
    digest = hashlib.sha256()
    view = memoryview(data)
    try:
        for offset in range(0, len(view), chunk_bytes):
            if poll is not None:
                poll()
            digest.update(view[offset : offset + chunk_bytes])
        if poll is not None:
            poll()
        return digest.hexdigest()
    finally:
        view.release()


def _sort_strings_polling(values: list[str], poll: Any | None = None) -> None:
    """In-place deterministic heapsort with one deadline poll per sift step."""

    def check() -> None:
        if poll is not None:
            poll()

    def sift_down(root: int, end: int) -> None:
        while root * 2 + 1 <= end:
            check()
            child = root * 2 + 1
            if child + 1 <= end and values[child] < values[child + 1]:
                child += 1
            if values[child] <= values[root]:
                return
            values[root], values[child] = values[child], values[root]
            root = child

    for root in range((len(values) - 2) // 2, -1, -1):
        sift_down(root, len(values) - 1)
    for end in range(len(values) - 1, 0, -1):
        check()
        values[0], values[end] = values[end], values[0]
        sift_down(0, end - 1)
    check()


def _hash_canonical_json_polling(
    digest: Any, value: Any, poll: Any
) -> None:
    """Feed compact canonical JSON to a digest without one large encoding."""

    def feed_bytes(data: bytes) -> None:
        view = memoryview(data)
        try:
            for offset in range(0, len(view), 64 * 1024):
                poll()
                digest.update(view[offset : offset + 64 * 1024])
        finally:
            view.release()

    def feed_string(text: str) -> None:
        buffer = bytearray(b'"')
        escapes = {
            '"': b'\\"',
            "\\": b"\\\\",
            "\b": b"\\b",
            "\f": b"\\f",
            "\n": b"\\n",
            "\r": b"\\r",
            "\t": b"\\t",
        }
        for index, character in enumerate(text):
            if index % 1024 == 0:
                poll()
            escaped = escapes.get(character)
            if escaped is not None:
                buffer.extend(escaped)
            elif ord(character) < 0x20:
                buffer.extend(f"\\u{ord(character):04x}".encode("ascii"))
            else:
                buffer.extend(character.encode("utf-8"))
            if len(buffer) >= 64 * 1024:
                digest.update(buffer)
                buffer.clear()
        buffer.extend(b'"')
        if buffer:
            poll()
            digest.update(buffer)

    def sort_mapping_keys(keys: list[Any]) -> None:
        def sift_down(root: int, end: int) -> None:
            while root * 2 + 1 <= end:
                poll()
                child = root * 2 + 1
                if (
                    child + 1 <= end
                    and keys[child] < keys[child + 1]
                ):
                    child += 1
                if keys[child] <= keys[root]:
                    return
                keys[root], keys[child] = keys[child], keys[root]
                root = child

        for root in range((len(keys) - 2) // 2, -1, -1):
            sift_down(root, len(keys) - 1)
        for end in range(len(keys) - 1, 0, -1):
            poll()
            keys[0], keys[end] = keys[end], keys[0]
            sift_down(0, end - 1)

    def canonical_mapping_key(key: Any) -> str:
        if isinstance(key, str):
            return key
        if key is True:
            return "true"
        if key is False:
            return "false"
        if key is None:
            return "null"
        if isinstance(key, int):
            return str(key)
        if isinstance(key, float):
            return canonical_json(key).decode("ascii")
        raise TypeError(
            "keys must be str, int, float, bool or None, "
            f"not {key.__class__.__name__}"
        )

    stack: list[tuple[str, Any]] = [("value", value)]
    while stack:
        poll()
        action, item = stack.pop()
        if action == "bytes":
            digest.update(item)
            continue
        if action == "string":
            feed_string(item)
            continue
        if action == "sequence":
            sequence, index = item
            if index >= len(sequence):
                digest.update(b"]")
                continue
            stack.append(("sequence", (sequence, index + 1)))
            if index + 1 < len(sequence):
                stack.append(("bytes", b","))
            stack.append(("value", sequence[index]))
            continue
        if action == "mapping":
            mapping, keys, index = item
            if index >= len(keys):
                digest.update(b"}")
                while keys:
                    poll()
                    keys.pop()
                continue
            key = keys[index]
            stack.append(("mapping", (mapping, keys, index + 1)))
            if index + 1 < len(keys):
                stack.append(("bytes", b","))
            stack.append(("value", mapping[key]))
            stack.append(("bytes", b":"))
            stack.append(("string", canonical_mapping_key(key)))
            continue
        if item is None:
            digest.update(b"null")
        elif item is True:
            digest.update(b"true")
        elif item is False:
            digest.update(b"false")
        elif isinstance(item, str):
            feed_string(item)
        elif isinstance(item, int) and not isinstance(item, bool):
            feed_bytes(str(item).encode("ascii"))
        elif isinstance(item, float):
            feed_bytes(canonical_json(item))
        elif isinstance(item, (list, tuple)):
            digest.update(b"[")
            stack.append(("sequence", (item, 0)))
        elif isinstance(item, (dict, MappingProxyType)):
            keys: list[Any] = []
            for key in item:
                poll()
                keys.append(key)
            sort_mapping_keys(keys)
            digest.update(b"{")
            stack.append(("mapping", (item, keys, 0)))
        else:
            feed_bytes(canonical_json(item))


def digest_bytes(data: bytes) -> str:
    return "sha256:" + hashlib.sha256(data).hexdigest()


def object_digest(type_tag: str, payload: Any, poll: Any | None = None) -> str:
    h = hashlib.sha256()
    h.update(type_tag.encode("utf-8"))
    h.update(b"\0")
    if poll is not None:
        _hash_canonical_json_polling(h, payload, poll)
        return h.hexdigest()
    h.update(canonical_json(payload))
    return h.hexdigest()


OBJECT_PREFIXES = {
    "blob": "CF-BLOB",
    "content_manifest": "CF-MANIFEST",
    "atom_index": "CF-ATOMINDEX",
    "trace_graph": "CF-TRACE",
    "fire_ledger": "CF-FIRELEDGER",
    "resolution_ledger": "CF-RESOLUTION",
    "verification": "CF-VERIFY",
    "policy": "CF-POLICY",
    "commit": "CF-COMMIT",
    "branch": "CF-BRANCH",
}


def object_id(type_tag: str, payload: Any) -> str:
    return f"{OBJECT_PREFIXES.get(type_tag, 'CF-OBJECT')}-{object_digest(type_tag, payload)[:24]}"


def object_id_matches_digest(object_id_value: str, type_tag: str, digest: str) -> bool:
    prefix = OBJECT_PREFIXES.get(type_tag, "CF-OBJECT") + "-"
    suffix = object_id_value.removeprefix(prefix)
    return (
        object_id_value.startswith(prefix)
        and len(suffix) in {12, 24}
        and all(character in "0123456789abcdef" for character in suffix)
        and digest.startswith(suffix)
    )


def read_json(path: Path, default: Any = None) -> Any:
    if not path.exists():
        return default
    return json.loads(path.read_text(encoding="utf-8"))


FILESYSTEM_AUTHORITY_DIAGNOSTIC = "filesystem authority is unusable"
PINNED_AUTHORITY_CHANGED_DIAGNOSTIC = "pinned authority record changed"
OWNER_OVER_RELEASE_DIAGNOSTIC = "decision-work owner over-release"

# One shared error-origin taxonomy for the whole GET/POST spine.  An ``OSError``
# is classified by the boundary that raised it and never by its Python exception
# class: ``TimeoutError``/``ConnectionError`` are raised both by a client socket
# and by a remote filesystem, so a class test cannot tell a client disconnect
# from an ``ETIMEDOUT`` authority read.  Exactly one boundary marks each origin,
# so the proof survives being composed into one dispatcher.
#
# The taxonomy is exhaustive over three origins.  ``transport`` is the client
# socket; ``filesystem`` is an authority path below a route; and
# ``commit-cleanup`` is the post-commit release of a commit source, marked by
# the cleanup owner that produced it.  A commit-source cleanup fault is not an
# authority the caller asked about, so it must not be published as the typed
# filesystem family -- it escapes the dispatcher exactly as a transport fault
# does, after the request loop has already accounted the drained ledger.
TRANSPORT_ORIGIN_ATTRIBUTE = "codefire_transport_origin"
FILESYSTEM_ORIGIN_ATTRIBUTE = "codefire_filesystem_origin"
COMMIT_CLEANUP_ORIGIN_ATTRIBUTE = "codefire_commit_cleanup_origin"


def mark_transport_origin(exc: OSError) -> OSError:
    """Record that one ``OSError`` was raised at the client socket boundary."""
    setattr(exc, TRANSPORT_ORIGIN_ATTRIBUTE, True)
    return exc


def mark_commit_cleanup_origin(exc: OSError) -> OSError:
    """Record that one ``OSError`` was raised releasing a commit source.

    Only the cleanup owner that drained the fault calls this, at the point the
    drain produced the error.  No route, dispatcher, errno test, message test
    or exception-subclass test may infer this origin.
    """
    setattr(exc, COMMIT_CLEANUP_ORIGIN_ATTRIBUTE, True)
    return exc


def mark_filesystem_origin(exc: OSError) -> OSError:
    """Record that one ``OSError`` was raised below a filesystem boundary."""
    if not getattr(exc, TRANSPORT_ORIGIN_ATTRIBUTE, False):
        setattr(exc, FILESYSTEM_ORIGIN_ATTRIBUTE, True)
    return exc


def is_transport_os_error(exc: OSError) -> bool:
    """True only when the client socket boundary raised this ``OSError``."""
    return bool(getattr(exc, TRANSPORT_ORIGIN_ATTRIBUTE, False))


def is_commit_cleanup_os_error(exc: OSError) -> bool:
    """True only when a commit-source cleanup owner raised this ``OSError``."""
    return bool(
        getattr(exc, COMMIT_CLEANUP_ORIGIN_ATTRIBUTE, False)
    ) and not is_transport_os_error(exc)


def is_filesystem_os_error(exc: OSError) -> bool:
    """True only when a filesystem boundary raised this ``OSError``."""
    return bool(
        getattr(exc, FILESYSTEM_ORIGIN_ATTRIBUTE, False)
    ) and not is_transport_os_error(exc)


def os_error_origin(exc: OSError) -> str:
    """Name the boundary that produced one ``OSError``."""
    if is_transport_os_error(exc):
        return "transport"
    if is_commit_cleanup_os_error(exc):
        return "commit-cleanup"
    if is_filesystem_os_error(exc):
        return "filesystem"
    return "unclassified"


@contextlib.contextmanager
def transport_boundary():
    """Attribute every ``OSError`` raised by one real socket read or write.

    Only the handler's request-line, header, body, and response-byte transfers
    run inside this boundary, so an abandoned connection is proved by where the
    failure was raised instead of by which ``OSError`` subclass Python chose.
    """
    try:
        yield
    except OSError as exc:
        mark_transport_origin(exc)
        raise


@contextlib.contextmanager
def route_filesystem_boundary():
    """Attribute every unmarked ``OSError`` escaping one route to the filesystem.

    A route body never touches the client socket, so an ``OSError`` that leaves
    it without a transport mark came from an authority path and must publish the
    typed filesystem-authority family instead of abandoning the connection.
    """
    try:
        yield
    except OSError as exc:
        mark_filesystem_origin(exc)
        raise


def filesystem_authority_error(target: Any, exc: OSError) -> CFError:
    """Map one unusable filesystem authority into the stable typed family.

    Every no-follow rejection, symlinked or directory authority, unavailable
    path, permission denial, metadata failure, and short/failed read shares one
    diagnostic family so no route can answer a filesystem fault with a
    zero-byte reply.
    """
    detail = exc.strerror or type(exc).__name__
    return CFError(f"{FILESYSTEM_AUTHORITY_DIAGNOSTIC}: {target}: {detail}")


def pinned_authority_changed_error(target: Any, reason: str) -> CFError:
    """Reject one pinned authority record replaced during a read request."""
    return CFError(f"{PINNED_AUTHORITY_CHANGED_DIAGNOSTIC}: {target} ({reason})")


def _open_authority_parent(path: Path) -> tuple[int, tuple[int, int]]:
    """Pin the authoritative parent directory capability of one leaf authority.

    A leaf may be reported absent only through an available, no-follow parent
    directory whose identity is pinned here.  A missing, replaced, symlinked,
    denied, unreadable, or I/O-failing parent is a filesystem-authority failure
    and never evidence that the leaf does not exist.
    """
    try:
        directory_fd = _open_directory_nofollow(path.parent)
    except OSError as exc:
        raise filesystem_authority_error(
            path.parent, mark_filesystem_origin(exc)
        ) from exc
    try:
        return directory_fd, _fd_identity(directory_fd)
    except OSError as exc:
        os.close(directory_fd)
        raise filesystem_authority_error(
            path.parent, mark_filesystem_origin(exc)
        ) from exc


def _same_pinned_metadata(
    before: os.stat_result, observed: os.stat_result, size: int
) -> bool:
    """True when one open descriptor still shows every pinned metadata field."""
    return (
        (before.st_dev, before.st_ino) == (observed.st_dev, observed.st_ino)
        and stat.S_ISREG(observed.st_mode)
        and observed.st_size == size
        and observed.st_mode == before.st_mode
        and observed.st_nlink == before.st_nlink
    )


def _require_pinned_authority_metadata(
    path: Path, observed: os.stat_result, capture: dict[str, Any]
) -> None:
    """Reprove every contractually captured metadata field of one authority.

    Device, inode, regular-file type, mode, link count, and physical size are
    all reproved together, so no mode or link-count change can escape between
    the capture, the final byte read, the EOF probe, and the content digest.
    """
    if (observed.st_dev, observed.st_ino) != capture["identity"]:
        raise pinned_authority_changed_error(path, "identity_changed")
    if not stat.S_ISREG(observed.st_mode):
        raise pinned_authority_changed_error(path, "identity_changed")
    if observed.st_mode != capture["mode"]:
        raise pinned_authority_changed_error(path, "mode_changed")
    if observed.st_nlink != capture["nlink"]:
        raise pinned_authority_changed_error(path, "link_count_changed")
    if observed.st_size != capture["size"]:
        raise pinned_authority_changed_error(path, "size_changed")


def read_json_accounted(
    path: Path,
    ledger: DecisionWorkLedger,
    *,
    default: Any = None,
    limit: int = 16 * 1024 * 1024,
    poll: Any | None = None,
    capture: dict[str, Any] | None = None,
) -> tuple[Any, int]:
    """Read one bounded JSON file with pre-effect scratch and retained charging.

    When ``capture`` is supplied it is filled with the pinned parent-directory
    identity, the pinned descriptor identity, exact physical size, link count,
    mode, and a content digest of the owned bytes, so a later fence can reject a
    same-metadata replacement of the exact authority this read consumed.  An
    absent authority is recorded as ``absent`` — only ever through an available
    pinned parent directory — and is fenced against appearing.
    """
    directory_fd, parent_identity = _open_authority_parent(path)
    file_fd = -1
    scratch_bytes = 0
    retained_bytes = 0
    buffer: bytearray | None = None
    try:
        try:
            file_fd = os.open(
                path.name,
                os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0),
                dir_fd=directory_fd,
            )
        except FileNotFoundError:
            # The pinned parent above is a proved, no-follow directory, so this
            # is the supported leaf-absence result and not a parent failure.
            if capture is not None:
                capture["path"] = path
                capture["absent"] = True
                capture["parent_identity"] = parent_identity
            return default, 0
        before = os.fstat(file_fd)
        if not stat.S_ISREG(before.st_mode) or before.st_size > limit:
            raise CFError(f"bounded JSON file is invalid: {path}")
        size = before.st_size
        requested_scratch = size * 2
        ledger.apply(
            "record_read",
            charges={"aggregate_bytes": size},
            acquires={"temporary_bytes": requested_scratch},
            counters={"files_read": 1, "file_bytes_read": size},
        )
        scratch_bytes = requested_scratch
        buffer = bytearray()
        while len(buffer) < size:
            if poll is not None:
                poll()
            chunk = os.read(file_fd, min(64 * 1024, size - len(buffer)))
            if not chunk:
                break
            buffer.extend(chunk)
        extension = os.read(file_fd, 1)
        after = os.fstat(file_fd)
        if (
            len(buffer) != size
            or extension
            or not _same_pinned_metadata(before, after, size)
        ):
            raise CFError(f"bounded JSON file changed while reading: {path}")
        if capture is not None:
            digest = _sha256_hexdigest_polling(buffer, poll)
            ledger.count("bytes_hashed", size, "record_read")
            # The terminal observation binds the digest to the same descriptor
            # state: no mode or link-count change during the interruptible
            # digest may reach the capture the final fence will reprove.
            terminal = os.fstat(file_fd)
            if not _same_pinned_metadata(before, terminal, size):
                raise CFError(f"bounded JSON file changed while reading: {path}")
            capture["path"] = path
            capture["absent"] = False
            capture["parent_identity"] = parent_identity
            capture["identity"] = (before.st_dev, before.st_ino)
            capture["size"] = size
            capture["nlink"] = before.st_nlink
            capture["mode"] = before.st_mode
            capture["digest"] = digest
        try:
            value = json.loads(buffer)
        except (UnicodeDecodeError, json.JSONDecodeError) as exc:
            raise CFError(f"invalid JSON: {path}: {exc}") from exc
        retained_bytes = canonical_json_size_up_to(value, U64_MAX, poll)
        ledger.acquire("retained_bytes", retained_bytes, "record_read")
        buffer = None
        return value, retained_bytes
    finally:
        buffer = None
        if scratch_bytes:
            ledger.release("temporary_bytes", scratch_bytes)
        if file_fd >= 0:
            os.close(file_fd)
        os.close(directory_fd)


def accounted_sorted_json_paths(
    directory: Path, ledger: DecisionWorkLedger, poll: Any | None = None
) -> tuple[list[Path], int]:
    """Return a deterministic directory snapshot with retained ownership charged."""
    if not directory.is_dir():
        return [], 0
    try:
        directory_fd = _open_directory_nofollow(directory)
    except OSError as exc:
        # A replaced, symlinked, denied, or I/O-failing authority directory joins
        # the one typed filesystem-authority family every route publishes.
        raise filesystem_authority_error(
            directory, mark_filesystem_origin(exc)
        ) from exc
    names: list[str] = []
    retained_bytes = 0
    try:
        with os.scandir(directory_fd) as entries:
            for entry in entries:
                if poll is not None:
                    poll()
                if not entry.name.endswith(".json"):
                    continue
                path_bytes = (
                    len(str(directory).encode("utf-8"))
                    + len(entry.name.encode("utf-8"))
                    + 128
                )
                ledger.acquire("retained_bytes", path_bytes, "graph_discovery")
                retained_bytes += path_bytes
                names.append(entry.name)
        sort_scratch = retained_bytes + 8 * len(names)
        ledger.acquire("temporary_bytes", sort_scratch, "query")
        try:
            if poll is not None:
                poll()
            names.sort()
        finally:
            ledger.release("temporary_bytes", sort_scratch)
        paths = [directory / name for name in names]
        names.clear()
        return paths, retained_bytes
    except Exception:
        names.clear()
        if retained_bytes:
            ledger.release("retained_bytes", retained_bytes)
        raise
    finally:
        os.close(directory_fd)


def revalidate_json_authority_capture(
    capture: dict[str, Any],
    ledger: DecisionWorkLedger,
    poll: Any | None = None,
) -> None:
    """Fence one pinned JSON authority against same-metadata replacement.

    The pinned parent-directory capability is reproved first, then the capture's
    exact descriptor identity, regular-file type, mode, link count, physical
    size, and content digest are all reproved from a fresh no-follow read, so a
    replacement that preserves path, inode, size, and mtime is still rejected.
    Every captured field is reproved again after the final byte read, the EOF
    probe, and the interruptible digest, so no mode or link-count change can
    escape between the last observation and publication.  An authority captured
    as absent is fenced against appearing, and an unreadable, replaced, or
    unavailable parent is never accepted as evidence of continued absence.
    """
    path = Path(capture["path"])
    absent = bool(capture.get("absent"))
    pinned_parent = capture.get("parent_identity")

    def charge_absent() -> None:
        ledger.apply(
            "snapshot_revalidation",
            charges={
                "snapshot_revalidation_records": 1,
                "snapshot_revalidation_bytes": 0,
            },
            counters={"snapshot_revalidation_records": 1},
        )

    directory_fd, parent_identity = _open_authority_parent(path)
    file_fd = -1
    scratch_bytes = 0
    buffer: bytearray | None = None
    try:
        if pinned_parent is not None and parent_identity != pinned_parent:
            raise pinned_authority_changed_error(path, "parent_changed")
        try:
            file_fd = os.open(
                path.name,
                os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0),
                dir_fd=directory_fd,
            )
        except FileNotFoundError as exc:
            if absent:
                charge_absent()
                return
            raise pinned_authority_changed_error(path, "unreadable") from exc
        except OSError as exc:
            raise pinned_authority_changed_error(path, "unreadable") from exc
        if absent:
            raise pinned_authority_changed_error(path, "appeared")
        observed = os.fstat(file_fd)
        actual_size = observed.st_size
        ledger.apply(
            "snapshot_revalidation",
            charges={
                "snapshot_revalidation_records": 1,
                "snapshot_revalidation_bytes": actual_size,
            },
            acquires={"temporary_bytes": actual_size * 2},
            counters={
                "snapshot_revalidation_records": 1,
                "snapshot_revalidation_bytes": actual_size,
                "files_read": 1,
                "file_bytes_read": actual_size,
                "bytes_hashed": actual_size,
            },
        )
        scratch_bytes = actual_size * 2
        _require_pinned_authority_metadata(path, observed, capture)
        size = capture["size"]
        buffer = bytearray()
        while len(buffer) < size:
            if poll is not None:
                poll()
            chunk = os.read(file_fd, min(64 * 1024, size - len(buffer)))
            if not chunk:
                break
            buffer.extend(chunk)
        if len(buffer) != size or os.read(file_fd, 1):
            raise pinned_authority_changed_error(path, "size_changed")
        _require_pinned_authority_metadata(path, os.fstat(file_fd), capture)
        digest = _sha256_hexdigest_polling(buffer, poll)
        # One terminal observation binds the digest, the metadata, and the pinned
        # parent: nothing observed before the digest may change during it.
        _require_pinned_authority_metadata(path, os.fstat(file_fd), capture)
        if pinned_parent is not None and _fd_identity(directory_fd) != pinned_parent:
            raise pinned_authority_changed_error(path, "parent_changed")
        if digest != capture["digest"]:
            raise pinned_authority_changed_error(path, "digest_changed")
    finally:
        buffer = None
        if scratch_bytes:
            ledger.release("temporary_bytes", scratch_bytes)
        if file_fd >= 0:
            os.close(file_fd)
        os.close(directory_fd)


def write_json(path: Path, value: Any) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(path.suffix + ".tmp")
    tmp.write_text(json.dumps(value, ensure_ascii=False, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    os.replace(tmp, path)


def append_jsonl(path: Path, value: Any) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open("a", encoding="utf-8") as f:
        f.write(json.dumps(value, ensure_ascii=False, sort_keys=True, separators=(",", ":")) + "\n")


def is_empty_dir(path: Path) -> bool:
    return path.is_dir() and not any(path.iterdir())


def find_repo_root(start: Path) -> Path:
    current = start.resolve()
    if current.is_file():
        current = current.parent
    for candidate in [current, *current.parents]:
        if (candidate / ".codefire").is_dir():
            return candidate
    marker = find_open_marker(current)
    if marker:
        data = read_json(marker)
        return Path(data["repository"]["path"]).resolve().parent
    raise CFError("not inside a CodeFire repository; run 'codefire init' first")


def find_open_marker(start: Path) -> Path | None:
    current = start.resolve()
    if current.is_file():
        current = current.parent
    for candidate in [current, *current.parents]:
        marker = candidate / ".codefire-open"
        if marker.is_file():
            return marker
    return None


def open_context(start: Path) -> tuple[Path, Path, dict[str, Any], dict[str, Any]]:
    marker = find_open_marker(start)
    if not marker:
        raise CFError("not inside an open CodeFire branch directory")
    identity = read_json(marker)
    open_dir = marker.parent.resolve()
    repo_dir = Path(identity["repository"]["path"]).resolve()
    repo_root = repo_dir.parent
    branch = identity["branch"]["name"]
    registry_path = opened_registry_path(repo_root, branch)
    registry = read_json(registry_path)
    if not registry:
        raise CFError(f"open registry is missing for branch: {branch}")
    if registry.get("branch", {}).get("name") != branch:
        raise CFError("open registry branch does not match open directory marker")
    if Path(registry["open"]["path"]).resolve() != open_dir:
        raise CFError("copied open directory detected; opened_path does not match registry")
    if registry["open"]["open_instance_id"] != identity["open"]["open_instance_id"]:
        raise CFError("copied open directory detected; open_instance_id does not match registry")
    objects_root = repo_dirs(repo_root)["objects"]
    current_base_commit = registry["open"].get("current_base_commit")
    if not isinstance(current_base_commit, str) or not current_base_commit.startswith("CF-COMMIT-"):
        raise CFError("open registry current_base_commit must be a commit object id")
    try:
        validate_sealed_commit(objects_root, current_base_commit)
    except CFError as exc:
        raise CFError(f"open registry current_base_commit is invalid: {exc}") from exc
    branch_record = load_branch(repo_root, branch)
    branch_head = branch_record.get("head")
    if not isinstance(branch_head, str) or not branch_head.startswith("CF-COMMIT-"):
        raise CFError("open branch head must be a commit object id")
    try:
        validate_sealed_commit(objects_root, branch_head)
    except CFError as exc:
        raise CFError(f"open branch head is invalid: {exc}") from exc
    return repo_root, open_dir, identity, registry


def repo_dirs(repo_root: Path) -> dict[str, Path]:
    cf = repo_root / ".codefire"
    return {
        "repo": cf,
        "objects": cf / "objects",
        "branches": cf / "branches",
        "opened": cf / "opened",
        "active": cf / "active",
        "cache": cf / "cache",
        "locks": cf / "locks",
        "remotes": cf / "remotes",
    }


REMOTE_COMPONENT_BYTE_LIMIT = 255
REMOTE_INTERNAL_HASH_PREFIX = "CF-INTERNAL-HASH-"


def decode_remote_component(value: str, kind: str) -> str:
    if re.search(r"%(?![0-9A-Fa-f]{2})", value):
        raise CFError(f"invalid percent escape in remote {kind}: {value}")
    try:
        decoded = urllib.parse.unquote_to_bytes(value).decode("utf-8", errors="strict")
    except UnicodeDecodeError as exc:
        raise CFError(f"remote {kind} component is not UTF-8: {value}") from exc
    validate_remote_component(decoded, kind)
    return decoded


def validate_remote_component(value: str, kind: str) -> None:
    invalid = (
        not value
        or value in {".", ".."}
        or len(value.encode("utf-8")) > REMOTE_COMPONENT_BYTE_LIMIT
        or value.startswith(("/", "\\"))
        or "/" in value
        or "\\" in value
        or ":" in value
        or value.startswith(REMOTE_INTERNAL_HASH_PREFIX)
        or any(unicodedata.category(character) == "Cc" for character in value)
        or Path(value).is_absolute()
        or len(Path(value).parts) != 1
    )
    if invalid:
        raise CFError(f"invalid remote {kind} component: {value!r}")


def parse_cf_url(url: str) -> dict[str, Any]:
    if not url.startswith("cf://"):
        raise CFError(f"not a CodeFire remote URL: {url}")
    raw = url[len("cf://") :]
    if not raw:
        raise CFError("remote URL is empty")
    parts = [p for p in raw.split("/") if p]
    if len(parts) < 4:
        raise CFError("remote URL must be cf://<server-path>/<org>/<app>/<branch>")
    branch_part = parts[-1]
    app_part = parts[-2]
    org_part = parts[-3]
    branch = decode_remote_component(branch_part, "branch")
    app = decode_remote_component(app_part, "application")
    org = decode_remote_component(org_part, "organization")
    server_raw = raw[: -len(f"/{org_part}/{app_part}/{branch_part}")].rstrip("/")
    if not server_raw:
        server_raw = "."
    server_root = Path(server_raw).expanduser().resolve()
    project_root = server_root / ".codefire-server" / "projects" / org / app
    return {
        "server_root": server_root,
        "project_root": project_root,
        "org": org,
        "app": app,
        "branch": branch,
        "url": url,
    }


def parse_cf_project_url(url: str) -> dict[str, Any]:
    if not url.startswith("cf://"):
        raise CFError(f"not a CodeFire remote URL: {url}")
    raw = url[len("cf://") :]
    parts = [p for p in raw.split("/") if p]
    if len(parts) < 3:
        raise CFError("remote project URL must be cf://<server-path>/<org>/<app>")
    app_part = parts[-1]
    org_part = parts[-2]
    app = decode_remote_component(app_part, "application")
    org = decode_remote_component(org_part, "organization")
    server_raw = raw[: -len(f"/{org_part}/{app_part}")].rstrip("/")
    if not server_raw:
        server_raw = "."
    server_root = Path(server_raw).expanduser().resolve()
    project_root = server_root / ".codefire-server" / "projects" / org / app
    return {
        "server_root": server_root,
        "project_root": project_root,
        "org": org,
        "app": app,
        "url": url,
    }


def is_http_remote_url(url: str) -> bool:
    return url.startswith("cf+http://") or url.startswith("cf+https://")


def is_remote_url(url: str) -> bool:
    return url.startswith("cf://") or is_http_remote_url(url)


def parse_cf_http_url(url: str) -> dict[str, Any]:
    parsed = urllib.parse.urlparse(url)
    if parsed.scheme not in {"cf+http", "cf+https"} or not parsed.netloc:
        raise CFError(f"not a CodeFire HTTP remote URL: {url}")
    parts = [decode_remote_component(p, "HTTP path") for p in parsed.path.split("/") if p]
    if len(parts) < 3:
        raise CFError("HTTP remote URL must be cf+http://<host>/<org>/<app>/<branch>")
    endpoint_scheme = "https" if parsed.scheme == "cf+https" else "http"
    return {
        "endpoint": f"{endpoint_scheme}://{parsed.netloc}",
        "remote_scheme": parsed.scheme,
        "netloc": parsed.netloc,
        "org": parts[0],
        "app": parts[1],
        "branch": parts[2],
        "url": url,
    }


def parse_cf_http_project_url(url: str) -> dict[str, Any]:
    parsed = urllib.parse.urlparse(url)
    if parsed.scheme not in {"cf+http", "cf+https"} or not parsed.netloc:
        raise CFError(f"not a CodeFire HTTP remote URL: {url}")
    parts = [decode_remote_component(p, "HTTP path") for p in parsed.path.split("/") if p]
    if len(parts) < 2:
        raise CFError("HTTP remote project URL must be cf+http://<host>/<org>/<app>")
    endpoint_scheme = "https" if parsed.scheme == "cf+https" else "http"
    return {
        "endpoint": f"{endpoint_scheme}://{parsed.netloc}",
        "remote_scheme": parsed.scheme,
        "netloc": parsed.netloc,
        "org": parts[0],
        "app": parts[1],
        "url": url,
    }


def http_remote_path(info: dict[str, Any], *parts: str) -> str:
    quoted = [urllib.parse.quote(str(part), safe="") for part in [info["org"], info["app"], *parts]]
    return f"{info['endpoint']}/v1/projects/" + "/".join(quoted)


def http_json(method: str, url: str, payload: dict[str, Any] | None = None) -> dict[str, Any]:
    data = None if payload is None else canonical_json(payload)
    request = urllib.request.Request(url, data=data, method=method)
    request.add_header("Content-Type", "application/json")
    context = None
    if url.startswith("https://") and os.environ.get("CODEFIRE_TLS_INSECURE") in {"1", "true", "yes"}:
        context = ssl._create_unverified_context()
    try:
        with urllib.request.urlopen(request, timeout=10, context=context) as response:
            body = response.read().decode("utf-8")
    except urllib.error.HTTPError as exc:
        body = exc.read().decode("utf-8", errors="replace")
        try:
            detail = json.loads(body).get("error", body)
        except json.JSONDecodeError:
            detail = body
        raise CFError(f"HTTP remote error: {detail}") from exc
    if not body:
        return {}
    return json.loads(body)


