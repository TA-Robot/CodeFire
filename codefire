def bash_completion_script() -> str:
    commands = " ".join(COMPLETION_COMMANDS)
    return f"""# bash completion for codefire
_codefire_complete()
{{
  local cur prev cmd
  COMPREPLY=()
  cur="${{COMP_WORDS[COMP_CWORD]}}"
  prev="${{COMP_WORDS[COMP_CWORD-1]}}"
  cmd="${{COMP_WORDS[1]}}"
  local commands="{commands}"

  if [[ $COMP_CWORD -eq 1 ]]; then
    COMPREPLY=( $(compgen -W "$commands" -- "$cur") )
    return 0
  fi

  case "$cmd" in
    branch)
      if [[ $COMP_CWORD -eq 2 ]]; then COMPREPLY=( $(compgen -W "list" -- "$cur") ); fi
      ;;
    close)
      COMPREPLY=( $(compgen -W "--discard" -- "$cur") )
      ;;
    upload|request-merge|request-review|request-apply|gc)
      COMPREPLY=( $(compgen -W "--actor --token --request-key-id --dry-run --reviewer --decision --comment" -- "$cur") )
      ;;
    fire)
      COMPREPLY=( $(compgen -W "--reason" -- "$cur") )
      ;;
    extinguish)
      COMPREPLY=( $(compgen -W "--resolution --rationale --evidence --refresh" -- "$cur") )
      ;;
    verify)
      COMPREPLY=( $(compgen -W "--details" -- "$cur") )
      ;;
    commit)
      COMPREPLY=( $(compgen -W "-m --message --signer --key-id" -- "$cur") )
      ;;
    merge)
      COMPREPLY=( $(compgen -W "--into" -- "$cur") )
      ;;
    completion)
      COMPREPLY=( $(compgen -W "bash zsh" -- "$cur") )
      ;;
    token-hash)
      COMPREPLY=( $(compgen -W "--salt --stdin" -- "$cur") )
      ;;
  esac
  return 0
}}
complete -F _codefire_complete codefire
"""


def zsh_completion_script() -> str:
    command_entries = " ".join(f"{cmd}\\:{cmd}" for cmd in COMPLETION_COMMANDS)
    return f"""#compdef codefire
# zsh completion for codefire
_codefire()
{{
  local -a commands
  commands=({command_entries})

  if (( CURRENT == 2 )); then
    _describe 'command' commands
    return
  fi

  case $words[2] in
    branch)
      _arguments '1:branch command:(list)'
      ;;
    close)
      _arguments '--discard[discard uncommitted work]'
      ;;
    upload|request-merge|request-review|request-apply|gc)
      _arguments '--actor[remote actor]' '--token[remote token]' '--request-key-id[remote request signing key id]' '--dry-run[dry run]' '--reviewer[reviewer]' '--decision[decision]:decision:(approve reject)' '--comment[comment]'
      ;;
    fire)
      _arguments '--reason[fire reason]'
      ;;
    extinguish)
      _arguments '--resolution[resolution]:resolution:(changed verified no-change-required invalid-fire)' '--rationale[rationale]' '--evidence[evidence]' '--refresh[refresh an extinguished fire resolution basis]'
      ;;
    verify)
      _arguments '--details[show failed verification diagnostic details]'
      ;;
    commit)
      _arguments '-m[message]' '--message[message]' '--signer[commit signer]' '--key-id[commit signing key id]'
      ;;
    merge)
      _arguments '--into[target branch]'
      ;;
    completion)
      _arguments '1:shell:(bash zsh)'
      ;;
    token-hash)
      _arguments '--salt[salt]' '--stdin[read token from stdin]'
      ;;
  esac
}}
_codefire "$@"
"""


def cmd_completion(args: argparse.Namespace) -> int:
    if args.shell == "bash":
        print(bash_completion_script(), end="")
    elif args.shell == "zsh":
        print(zsh_completion_script(), end="")
    else:
        raise CFError(f"unsupported completion shell: {args.shell}")
    return 0


def cmd_token_hash(args: argparse.Namespace) -> int:
    if args.stdin:
        token = sys.stdin.read().rstrip("\n")
    else:
        token = args.token
    if not token:
        raise CFError("token is required; pass TOKEN or use --stdin")
    value = token_hash_policy_value(token, args.salt or "")
    print(json.dumps(value, ensure_ascii=False, sort_keys=True))
    return 0


