class DecisionWorkProfile:
    """Immutable CFR-168 budget profile shared with the Rust implementation."""

    def __init__(
        self,
        limits: dict[str, tuple[str, int]],
        *,
        profile_id: str = DECISION_WORK_PROFILE_V1,
        request_deadline_ms: int | None = None,
        max_active_connections: int | None = None,
        max_queued_connections: int | None = None,
        applicable_commands: tuple[str, ...] = ("local_graph", "object_transfer"),
        applicable_phases: tuple[str, ...] = DECISION_WORK_PHASES,
    ) -> None:
        if not isinstance(profile_id, str) or not profile_id:
            raise CFError("decision-work profile id must be a non-empty string")
        for dimension, configured in limits.items():
            if dimension not in _DIMENSION_ORDER:
                raise CFError(f"unknown decision-work dimension: {dimension}")
            if (
                not isinstance(configured, tuple)
                or len(configured) != 2
                or configured[0] not in {"cumulative", "maximum", "concurrent"}
                or isinstance(configured[1], bool)
                or not isinstance(configured[1], int)
                or configured[1] < 0
                or configured[1] > U64_MAX
            ):
                raise CFError(f"invalid decision-work limit for {dimension}")
        if any(command not in DECISION_WORK_COMMANDS for command in applicable_commands):
            raise CFError("decision-work profile contains an unknown command kind")
        if any(phase not in DECISION_WORK_PHASES for phase in applicable_phases):
            raise CFError("decision-work profile contains an unknown phase")
        for value, label in [
            (request_deadline_ms, "request deadline"),
            (max_active_connections, "active connection limit"),
            (max_queued_connections, "queued connection limit"),
        ]:
            if value is not None and (
                isinstance(value, bool)
                or not isinstance(value, int)
                or value < 0
                or value > U64_MAX
            ):
                raise CFError(f"decision-work {label} must fit u64")
        self.profile_id = profile_id
        self.limits = MappingProxyType(dict(limits))
        self.request_deadline_ms = request_deadline_ms
        self.max_active_connections = max_active_connections
        self.max_queued_connections = max_queued_connections
        self.applicable_commands = frozenset(applicable_commands)
        self.applicable_phases = frozenset(applicable_phases)
        self._frozen = True

    def __setattr__(self, name: str, value: Any) -> None:
        if getattr(self, "_frozen", False):
            raise AttributeError("DecisionWorkProfile is immutable")
        object.__setattr__(self, name, value)

    @classmethod
    def local_v1(
        cls, overrides: dict[str, tuple[str, int] | int] | None = None
    ) -> "DecisionWorkProfile":
        gib = 1024 * 1024 * 1024
        limits: dict[str, tuple[str, int]] = {
            "graph_nodes": ("cumulative", 100_000),
            "graph_edges": ("cumulative", 400_000),
            "logical_depth": ("maximum", 100_000),
            "aggregate_bytes": ("cumulative", gib),
            "retained_bytes": ("concurrent", gib),
            "temporary_bytes": ("concurrent", gib),
            "object_records": ("cumulative", 100_000),
            "snapshot_revalidation_records": ("cumulative", 100_000),
            "snapshot_revalidation_bytes": ("cumulative", gib),
            "maximum_frontier": ("maximum", 100_000),
            "counter_values": ("maximum", U64_MAX - 1),
        }
        for dimension, value in (overrides or {}).items():
            measurement = limits.get(dimension, ("cumulative", 0))[0]
            limits[dimension] = value if isinstance(value, tuple) else (measurement, value)
        return cls(limits, applicable_phases=LOCAL_DECISION_WORK_PHASES)

    @classmethod
    def http_v1(
        cls, overrides: dict[str, tuple[str, int] | int] | None = None
    ) -> "DecisionWorkProfile":
        local = cls.local_v1()
        limits = dict(local.limits)
        limits.update(
            {
                "request_header_bytes": ("cumulative", 64 * 1024),
                "response_header_bytes": ("cumulative", 64 * 1024),
                "request_body_bytes": ("cumulative", 16 * 1024 * 1024),
                "response_bytes": ("cumulative", 16 * 1024 * 1024),
                "retained_bytes": ("concurrent", 32 * 1024 * 1024),
                "temporary_bytes": ("concurrent", 16 * 1024 * 1024),
            }
        )
        for dimension, value in (overrides or {}).items():
            measurement = limits.get(dimension, ("cumulative", 0))[0]
            limits[dimension] = (
                value if isinstance(value, tuple) else (measurement, value)
            )
        return cls(
            limits,
            request_deadline_ms=30_000,
            max_active_connections=32,
            max_queued_connections=0,
            applicable_commands=DECISION_WORK_COMMANDS,
        )

    def limit(self, dimension: str) -> int:
        try:
            return self.limits[dimension][1]
        except KeyError as exc:
            raise CFError(f"decision-work profile has no {dimension} limit") from exc


class ResourceBudgetExceeded(CFError):
    exit_code = RESOURCE_BUDGET_EXIT_CODE

    def __init__(
        self,
        *,
        profile: str,
        dimension: str,
        observed: int,
        limit: int,
        phase: str,
        command: str,
        continuation_supported: bool,
    ) -> None:
        self._diagnostic = {
            "kind": "resource_budget_exceeded",
            "exit_code": RESOURCE_BUDGET_EXIT_CODE,
            "profile": profile,
            "dimension": dimension,
            "observed": observed,
            "limit": limit,
            "phase": phase,
            "command": command,
            "continuation_supported": continuation_supported,
        }
        super().__init__(
            f"resource budget exceeded for {command} during {phase}: "
            f"{observed} observed, limit {limit}"
        )

    def diagnostic(self) -> dict[str, Any]:
        return dict(self._diagnostic)


class SealedValidationSubjectChanged(CFError):
    """Typed failure raised when a provisionally validated document changes."""

    def __init__(
        self,
        object_id: str,
        path: Path,
        change_kind: str,
        expected_size: int,
        actual_size: int | None,
    ) -> None:
        self.object_id = object_id
        self.path = path
        self.change_kind = change_kind
        self.expected_size = expected_size
        self.actual_size = actual_size
        actual = "unavailable" if actual_size is None else str(actual_size)
        super().__init__(
            "sealed validation subject changed: "
            f"object {object_id} at {path} ({change_kind}; "
            f"expected {expected_size} bytes, actual {actual})"
        )


class DecisionWorkPermit:
    def __init__(self) -> None:
        object.__setattr__(self, "_frozen", True)

    def __setattr__(self, name: str, value: Any) -> None:
        if getattr(self, "_frozen", False):
            raise AttributeError("DecisionWorkPermit is immutable")
        object.__setattr__(self, name, value)


class DecisionWorkLedger:
    """Checked, pre-effect accounting for one Python command or request."""

    def __init__(
        self,
        profile: DecisionWorkProfile,
        command: str,
        command_kind: str = "local_graph",
    ) -> None:
        if command_kind not in DECISION_WORK_COMMANDS:
            raise CFError(f"unknown decision-work command kind: {command_kind}")
        if command_kind not in profile.applicable_commands:
            raise CFError(
                f"decision-work command kind {command_kind} is not applicable to this profile"
            )
        self._profile = profile
        self._command = command
        self._command_kind = command_kind
        self._reserved: dict[DecisionWorkPermit, dict[str, Any]] = {}
        self._prepublication_sealed = False
        self._cumulative: dict[str, int] = {}
        self._maximum: dict[str, int] = {}
        self._current: dict[str, int] = {}
        self._peak: dict[str, int] = {}
        self._counters: dict[str, int] = {}
        self._phases: dict[str, dict[str, int]] = {}
        self._phase_counters: dict[str, dict[str, int]] = {}
        self._terminal_reason: str | None = None

    @property
    def profile(self) -> DecisionWorkProfile:
        return self._profile

    @property
    def command(self) -> str:
        return self._command

    @property
    def command_kind(self) -> str:
        return self._command_kind

    @property
    def terminal_reason(self) -> str | None:
        return self._terminal_reason

    @property
    def cumulative(self) -> MappingProxyType:
        return MappingProxyType(self._cumulative)

    @property
    def maximum(self) -> MappingProxyType:
        return MappingProxyType(self._maximum)

    @property
    def current(self) -> MappingProxyType:
        return MappingProxyType(self._current)

    @property
    def peak(self) -> MappingProxyType:
        return MappingProxyType(self._peak)

    @property
    def counters(self) -> MappingProxyType:
        return MappingProxyType(self._counters)

    @staticmethod
    def _amount(value: int) -> int:
        if isinstance(value, bool) or not isinstance(value, int) or value < 0:
            raise CFError("decision-work charge must be a non-negative integer")
        return value

    @staticmethod
    def _checked_add(current: int, amount: int) -> int | None:
        if current > U64_MAX - amount:
            return None
        return current + amount

    def _ensure_active(self) -> None:
        if self._terminal_reason is not None:
            raise CFError(
                f"decision-work ledger is already terminal: {self._terminal_reason}"
            )

    def _exceeded(
        self,
        dimension: str,
        observed: int,
        phase: str,
        surface: str,
    ) -> ResourceBudgetExceeded:
        self._terminal_reason = "budget_exceeded"
        return ResourceBudgetExceeded(
            profile=self._profile.profile_id,
            dimension=dimension,
            observed=observed,
            limit=self._profile.limit(dimension),
            phase=phase,
            command=self._command,
            continuation_supported=surface == "snapshot_paged",
        )

    def _candidate(
        self, current: int, amount: int, dimension: str
    ) -> tuple[int, bool]:
        candidate = self._checked_add(current, self._amount(amount))
        if candidate is None:
            return min(U64_MAX, self._profile.limit(dimension) + 1), True
        return candidate, False

    def apply(
        self,
        phase: str,
        *,
        charges: dict[str, int] | None = None,
        maxima: dict[str, int] | None = None,
        acquires: dict[str, int] | None = None,
        counters: dict[str, int] | None = None,
        surface: str = "atomic",
    ) -> None:
        """Preflight and commit one Rust-style reservation atomically."""
        if self._prepublication_sealed:
            raise CFError("decision-work ledger is sealed for publication")
        reservation = self._reservation(
            phase, charges, maxima, acquires, counters, surface
        )
        actual = self._accounting_clone()
        try:
            self._apply_reservation(actual, reservation)
            capacity = actual._accounting_clone()
            for existing in self._reserved.values():
                self._apply_reservation(capacity, existing)
        except ResourceBudgetExceeded:
            self._terminal_reason = "budget_exceeded"
            raise
        self._cumulative = dict(actual._cumulative)
        self._maximum = dict(actual._maximum)
        self._current = dict(actual._current)
        self._peak = dict(actual._peak)
        self._counters = dict(actual._counters)
        self._phases = {key: dict(value) for key, value in actual._phases.items()}
        self._phase_counters = {
            key: dict(value) for key, value in actual._phase_counters.items()
        }

    def _apply_unsealed(
        self,
        phase: str,
        *,
        charges: dict[str, int] | None = None,
        maxima: dict[str, int] | None = None,
        acquires: dict[str, int] | None = None,
        counters: dict[str, int] | None = None,
        surface: str = "atomic",
    ) -> None:
        self._ensure_active()
        if phase not in DECISION_WORK_PHASES:
            raise CFError(f"unknown decision-work phase: {phase}")
        if phase not in self._profile.applicable_phases:
            raise CFError(
                f"decision-work phase {phase} is not applicable to this profile"
            )
        if surface not in {"atomic", "snapshot_paged"}:
            raise CFError(f"unknown decision-work surface: {surface}")
        for dimension in [
            *(charges or {}),
            *(maxima or {}),
            *(acquires or {}),
        ]:
            if dimension not in _DIMENSION_ORDER:
                raise CFError(f"unknown decision-work dimension: {dimension}")
        for counter in counters or {}:
            if counter not in _COUNTER_ORDER:
                raise CFError(f"unknown decision-work counter: {counter}")
        next_cumulative = dict(self._cumulative)
        next_maximum = dict(self._maximum)
        next_current = dict(self._current)
        next_peak = dict(self._peak)
        next_counters = dict(self._counters)

        for dimension, amount in sorted(
            (charges or {}).items(), key=lambda item: _DIMENSION_ORDER[item[0]]
        ):
            measurement, limit = self._profile.limits.get(dimension, (None, None))
            if measurement != "cumulative":
                raise CFError(f"decision-work measurement mismatch for {dimension}")
            observed, overflow = self._candidate(
                next_cumulative.get(dimension, 0), amount, dimension
            )
            if overflow or observed > limit:
                raise self._exceeded(dimension, observed, phase, surface)
            next_cumulative[dimension] = observed
        maximum_deltas: dict[str, int] = {}
        for dimension, value in sorted(
            (maxima or {}).items(), key=lambda item: _DIMENSION_ORDER[item[0]]
        ):
            measurement, limit = self._profile.limits.get(dimension, (None, None))
            if measurement != "maximum":
                raise CFError(f"decision-work measurement mismatch for {dimension}")
            requested = self._amount(value)
            domain_overflow = requested > U64_MAX
            observed = min(U64_MAX, requested)
            if domain_overflow or observed > limit:
                raise self._exceeded(dimension, observed, phase, surface)
            previous = next_maximum.get(dimension, 0)
            next_maximum[dimension] = max(previous, observed)
            maximum_deltas[dimension] = max(0, observed - previous)
        for dimension, amount in sorted(
            (acquires or {}).items(), key=lambda item: _DIMENSION_ORDER[item[0]]
        ):
            measurement, limit = self._profile.limits.get(dimension, (None, None))
            if measurement != "concurrent":
                raise CFError(f"decision-work measurement mismatch for {dimension}")
            observed, overflow = self._candidate(
                next_current.get(dimension, 0), amount, dimension
            )
            if overflow or observed > limit:
                raise self._exceeded(dimension, observed, phase, surface)
            next_current[dimension] = observed
            next_peak[dimension] = max(next_peak.get(dimension, 0), observed)
        counter_limit = self._profile.limit("counter_values")
        for counter, amount in sorted(
            (counters or {}).items(), key=lambda item: _COUNTER_ORDER[item[0]]
        ):
            observed, overflow = self._candidate(
                next_counters.get(counter, 0), amount, "counter_values"
            )
            if overflow or observed > counter_limit:
                raise self._exceeded("counter_values", observed, phase, surface)
            next_counters[counter] = observed

        next_phases = {key: dict(value) for key, value in self._phases.items()}
        phase_values = next_phases.setdefault(phase, {})
        for dimension, amount in (charges or {}).items():
            value = self._checked_add(phase_values.get(dimension, 0), amount)
            if value is None:
                raise CFError("decision-work phase accounting overflow")
            phase_values[dimension] = value
        for dimension, delta in maximum_deltas.items():
            if delta:
                value = self._checked_add(phase_values.get(dimension, 0), delta)
                if value is None:
                    raise CFError("decision-work phase accounting overflow")
                phase_values[dimension] = value
        for dimension, amount in (acquires or {}).items():
            value = self._checked_add(phase_values.get(dimension, 0), amount)
            if value is None:
                raise CFError("decision-work phase accounting overflow")
            phase_values[dimension] = value
        next_phase_counters = {
            key: dict(value) for key, value in self._phase_counters.items()
        }
        phase_counter_values = next_phase_counters.setdefault(phase, {})
        for counter, amount in (counters or {}).items():
            value = self._checked_add(phase_counter_values.get(counter, 0), amount)
            if value is None:
                raise CFError("decision-work phase counter accounting overflow")
            phase_counter_values[counter] = value

        self._cumulative = next_cumulative
        self._maximum = next_maximum
        self._current = next_current
        self._peak = next_peak
        self._counters = next_counters
        self._phases = next_phases
        self._phase_counters = next_phase_counters

    def _accounting_clone(self) -> "DecisionWorkLedger":
        clone = object.__new__(type(self))
        clone._profile = self._profile
        clone._command = self._command
        clone._command_kind = self._command_kind
        clone._reserved = {}
        clone._prepublication_sealed = False
        clone._cumulative = dict(self._cumulative)
        clone._maximum = dict(self._maximum)
        clone._current = dict(self._current)
        clone._peak = dict(self._peak)
        clone._counters = dict(self._counters)
        clone._phases = {key: dict(value) for key, value in self._phases.items()}
        clone._phase_counters = {
            key: dict(value) for key, value in self._phase_counters.items()
        }
        clone._terminal_reason = self._terminal_reason
        return clone

    @staticmethod
    def _reservation(
        phase: str,
        charges: dict[str, int] | None,
        maxima: dict[str, int] | None,
        acquires: dict[str, int] | None,
        counters: dict[str, int] | None,
        surface: str,
    ) -> dict[str, Any]:
        return {
            "phase": phase,
            "charges": dict(charges or {}),
            "maxima": dict(maxima or {}),
            "acquires": dict(acquires or {}),
            "counters": dict(counters or {}),
            "surface": surface,
        }

    @staticmethod
    def _apply_reservation(
        ledger: "DecisionWorkLedger", reservation: dict[str, Any]
    ) -> None:
        ledger._apply_unsealed(**reservation)

    def reserve(
        self,
        phase: str,
        *,
        charges: dict[str, int] | None = None,
        maxima: dict[str, int] | None = None,
        acquires: dict[str, int] | None = None,
        counters: dict[str, int] | None = None,
        surface: str = "atomic",
    ) -> DecisionWorkPermit:
        if self._prepublication_sealed:
            raise CFError("decision-work ledger is sealed for publication")
        reservation = self._reservation(
            phase, charges, maxima, acquires, counters, surface
        )
        capacity = self._accounting_clone()
        try:
            for existing in self._reserved.values():
                self._apply_reservation(capacity, existing)
            self._apply_reservation(capacity, reservation)
        except ResourceBudgetExceeded:
            self._terminal_reason = "budget_exceeded"
            raise
        permit = DecisionWorkPermit()
        self._reserved[permit] = reservation
        return permit

    def consume_reserved(
        self,
        permit: DecisionWorkPermit,
        *,
        phase: str,
        charges: dict[str, int] | None = None,
        maxima: dict[str, int] | None = None,
        acquires: dict[str, int] | None = None,
        counters: dict[str, int] | None = None,
        surface: str = "atomic",
    ) -> None:
        if (
            not isinstance(permit, DecisionWorkPermit) or permit not in self._reserved
        ):
            raise CFError("decision-work permit does not belong to this ledger")
        actual = self._reservation(phase, charges, maxima, acquires, counters, surface)
        upper = self._reserved[permit]
        if actual["phase"] != upper["phase"] or actual["surface"] != upper["surface"]:
            raise CFError("decision-work permit consumption exceeds its reserved upper bound")
        remaining = self._reservation(
            upper["phase"], {}, dict(upper["maxima"]), {}, {}, upper["surface"]
        )
        for field in ["charges", "acquires", "counters"]:
            remaining[field] = dict(upper[field])
            for key, amount in actual[field].items():
                if key not in remaining[field] or amount > remaining[field][key]:
                    raise CFError(
                        "decision-work permit consumption exceeds its reserved upper bound"
                    )
                left = remaining[field][key] - amount
                if left:
                    remaining[field][key] = left
                else:
                    del remaining[field][key]
        for key, value in actual["maxima"].items():
            if key not in upper["maxima"] or value > upper["maxima"][key]:
                raise CFError(
                    "decision-work permit consumption exceeds its reserved upper bound"
                )
        actual_ledger = self._accounting_clone()
        try:
            self._apply_reservation(actual_ledger, actual)
            capacity = actual_ledger._accounting_clone()
            for reserved_permit, reservation in self._reserved.items():
                self._apply_reservation(
                    capacity,
                    remaining if reserved_permit is permit else reservation,
                )
        except ResourceBudgetExceeded:
            self._terminal_reason = "budget_exceeded"
            raise
        self._cumulative = dict(actual_ledger._cumulative)
        self._maximum = dict(actual_ledger._maximum)
        self._current = dict(actual_ledger._current)
        self._peak = dict(actual_ledger._peak)
        self._counters = dict(actual_ledger._counters)
        self._phases = {
            key: dict(value) for key, value in actual_ledger._phases.items()
        }
        self._phase_counters = {
            key: dict(value) for key, value in actual_ledger._phase_counters.items()
        }
        if any(remaining[field] for field in ["charges", "maxima", "acquires", "counters"]):
            self._reserved[permit] = remaining
        else:
            del self._reserved[permit]

    def cancel_permit(self, permit: DecisionWorkPermit) -> None:
        if (
            not isinstance(permit, DecisionWorkPermit) or permit not in self._reserved
        ):
            raise CFError("decision-work permit does not belong to this ledger")
        del self._reserved[permit]

    def has_open_permits(self) -> bool:
        return bool(self._reserved)

    def permit_is_open(self, permit: DecisionWorkPermit) -> bool:
        return permit in self._reserved

    def seal_prepublication(self) -> None:
        self._ensure_active()
        self._prepublication_sealed = True

    def charge(
        self, dimension: str, amount: int, phase: str, surface: str = "atomic"
    ) -> None:
        self.apply(phase, charges={dimension: amount}, surface=surface)

    def observe_maximum(
        self, dimension: str, value: int, phase: str, surface: str = "atomic"
    ) -> None:
        self.apply(phase, maxima={dimension: value}, surface=surface)

    def acquire(
        self, dimension: str, amount: int, phase: str, surface: str = "atomic"
    ) -> None:
        self.apply(phase, acquires={dimension: amount}, surface=surface)

    def release(self, dimension: str, amount: int) -> None:
        amount = self._amount(amount)
        measurement, _ = self._profile.limits.get(dimension, (None, None))
        if measurement != "concurrent":
            raise CFError(f"decision-work measurement mismatch for {dimension}")
        current = self._current.get(dimension, 0)
        if amount > current:
            raise CFError(f"decision-work release underflow for {dimension}")
        self._current[dimension] = current - amount

    def count(self, counter: str, amount: int, phase: str) -> None:
        self.apply(phase, counters={counter: amount})

    def terminate(self, reason: str) -> None:
        if self._reserved:
            raise CFError("decision-work ledger still has open publication permits")
        if self._terminal_reason is not None:
            raise CFError(
                f"decision-work ledger is already terminal: {self._terminal_reason}"
            )
        self._terminal_reason = reason

    def snapshot(self) -> dict[str, Any]:
        return {
            "cumulative": dict(self._cumulative),
            "maximum": dict(self._maximum),
            "current": dict(self._current),
            "peak": dict(self._peak),
            "counters": dict(self._counters),
            "phases": {key: dict(value) for key, value in self._phases.items()},
            "phase_counters": {
                key: dict(value) for key, value in self._phase_counters.items()
            },
            "terminal_reason": self._terminal_reason,
        }


@contextlib.contextmanager
def file_lock(lock_path: Path):
    lock_path.parent.mkdir(parents=True, exist_ok=True)
    try:
        fd = os.open(lock_path, os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o600)
    except FileExistsError as exc:
        raise CFError(f"lock is already held: {lock_path}") from exc
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write(f"pid={os.getpid()}\ncreated_at={now_iso()}\n")
        yield
    finally:
        try:
            lock_path.unlink()
        except FileNotFoundError:
            pass


def _open_directory_nofollow(path: Path) -> int:
    """Open an absolute directory one component at a time without following links."""
    if not hasattr(os, "O_NOFOLLOW"):
        raise CFError("no-follow directory capabilities are unsupported on this platform")
    absolute = Path(os.path.abspath(path))
    flags = os.O_RDONLY | getattr(os, "O_DIRECTORY", 0) | os.O_NOFOLLOW
    fd = os.open(os.sep, flags)
    try:
        for component in absolute.parts[1:]:
            next_fd = os.open(component, flags, dir_fd=fd)
            os.close(fd)
            fd = next_fd
        return fd
    except Exception:
        os.close(fd)
        raise


def _open_or_create_directory_nofollow(path: Path) -> int:
    """Create missing components relative to already-open parents; reject every link."""
    if not hasattr(os, "O_NOFOLLOW"):
        raise CFError("no-follow directory capabilities are unsupported on this platform")
    absolute = Path(os.path.abspath(path))
    flags = os.O_RDONLY | getattr(os, "O_DIRECTORY", 0) | os.O_NOFOLLOW
    fd = os.open(os.sep, flags)
    try:
        for component in absolute.parts[1:]:
            try:
                next_fd = os.open(component, flags, dir_fd=fd)
            except FileNotFoundError:
                os.mkdir(component, 0o700, dir_fd=fd)
                next_fd = os.open(component, flags, dir_fd=fd)
            os.close(fd)
            fd = next_fd
        return fd
    except Exception:
        os.close(fd)
        raise


def _open_or_create_directory_at(parent_fd: int, name: str) -> int:
    validate_remote_component(name, "directory")
    try:
        os.mkdir(name, 0o700, dir_fd=parent_fd)
    except FileExistsError:
        pass
    flags = os.O_RDONLY | getattr(os, "O_DIRECTORY", 0) | os.O_NOFOLLOW
    return os.open(name, flags, dir_fd=parent_fd)


@contextlib.contextmanager
def stable_remote_lock(
    lock_path: Path, *, shared: bool = False, directory_fd: int | None = None
):
    """Hold a persistent, no-follow remote lock inode with Unix flock."""
    if fcntl is None or not hasattr(os, "O_NOFOLLOW"):
        raise CFError("persistent remote locking is unsupported on this platform")
    owned_directory_fd = (
        _open_directory_nofollow(lock_path.parent)
        if directory_fd is None
        else os.dup(directory_fd)
    )
    fd = -1
    try:
        fd = os.open(
            lock_path.name,
            os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW,
            0o600,
            dir_fd=owned_directory_fd,
        )
        before = os.stat(lock_path.name, dir_fd=owned_directory_fd, follow_symlinks=False)
        opened = os.fstat(fd)
        if (
            not stat.S_ISREG(before.st_mode)
            or not stat.S_ISREG(opened.st_mode)
            or before.st_nlink != 1
            or opened.st_nlink != 1
            or (before.st_dev, before.st_ino) != (opened.st_dev, opened.st_ino)
        ):
            raise CFError(f"remote lock identity is invalid: {lock_path}")
        operation = fcntl.LOCK_SH if shared else fcntl.LOCK_EX
        try:
            fcntl.flock(fd, operation | fcntl.LOCK_NB)
        except BlockingIOError as exc:
            raise CFError(f"lock is already held: {lock_path}") from exc
        after = os.stat(lock_path.name, dir_fd=owned_directory_fd, follow_symlinks=False)
        if (
            not stat.S_ISREG(after.st_mode)
            or after.st_nlink != 1
            or (after.st_dev, after.st_ino) != (opened.st_dev, opened.st_ino)
        ):
            raise CFError(f"remote lock identity changed: {lock_path}")
        _publish_remote_lock_owner(owned_directory_fd, lock_path.name, shared)
        yield
    finally:
        if fd >= 0:
            try:
                fcntl.flock(fd, fcntl.LOCK_UN)
            finally:
                os.close(fd)
        os.close(owned_directory_fd)


def _publish_remote_lock_owner(directory_fd: int, lock_name: str, shared: bool) -> None:
    owner_name = f"{lock_name}.owner.json"
    temp_name = f".{owner_name}.tmp-{os.getpid()}-{time.time_ns()}"
    payload = canonical_json(
        {
            "version": 1,
            "pid": os.getpid(),
            "mode": "shared" if shared else "exclusive",
            "created_at": now_iso(),
        }
    ) + b"\n"
    temp_fd = -1
    try:
        temp_fd = os.open(
            temp_name,
            os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW,
            0o600,
            dir_fd=directory_fd,
        )
        os.write(temp_fd, payload)
        os.fsync(temp_fd)
        os.close(temp_fd)
        temp_fd = -1
        os.replace(temp_name, owner_name, src_dir_fd=directory_fd, dst_dir_fd=directory_fd)
        os.fsync(directory_fd)
    except OSError:
        # Owner metadata is diagnostic and never authoritative.
        if temp_fd >= 0:
            os.close(temp_fd)
        try:
            os.unlink(temp_name, dir_fd=directory_fd)
        except OSError:
            pass


def now_iso() -> str:
    return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())


def canonical_json(value: Any) -> bytes:
    return json.dumps(value, ensure_ascii=False, sort_keys=True, separators=(",", ":")).encode("utf-8")


def canonical_json_size(value: Any) -> int:
    """Return canonical_json's byte length without materializing the document."""
    if value is None:
        return 4
    if value is True:
        return 4
    if value is False:
        return 5
    if isinstance(value, str):
        size = 2
        for character in value:
            point = ord(character)
            if character in {'"', "\\"} or character in "\b\f\n\r\t":
                size += 2
            elif point < 0x20:
                size += 6
            else:
                size += len(character.encode("utf-8"))
        return size
    if isinstance(value, int) and not isinstance(value, bool):
        if value == 0:
            return 1
        return (1 if value < 0 else 0) + int(math.log10(abs(value))) + 1
    if isinstance(value, list) or isinstance(value, tuple):
        return 2 + max(0, len(value) - 1) + sum(
            canonical_json_size(item) for item in value
        )
    if isinstance(value, dict) or isinstance(value, MappingProxyType):
        return 2 + max(0, len(value) - 1) + sum(
            canonical_json_size(str(key)) + 1 + canonical_json_size(item)
            for key, item in value.items()
        )
    # This helper is used for resource-sized JSON structures; retain exact
    # compatibility for uncommon scalar types through the canonical encoder.
    return len(canonical_json(value))


def digest_bytes(data: bytes) -> str:
    return "sha256:" + hashlib.sha256(data).hexdigest()


def object_digest(type_tag: str, payload: Any) -> str:
    h = hashlib.sha256()
    h.update(type_tag.encode("utf-8"))
    h.update(b"\0")
    h.update(canonical_json(payload))
    return h.hexdigest()


OBJECT_PREFIXES = {
    "blob": "CF-BLOB",
    "content_manifest": "CF-MANIFEST",
    "atom_index": "CF-ATOMINDEX",
    "trace_graph": "CF-TRACE",
    "fire_ledger": "CF-FIRELEDGER",
    "resolution_ledger": "CF-RESOLUTION",
    "verification": "CF-VERIFY",
    "policy": "CF-POLICY",
    "commit": "CF-COMMIT",
    "branch": "CF-BRANCH",
}


def object_id(type_tag: str, payload: Any) -> str:
    return f"{OBJECT_PREFIXES.get(type_tag, 'CF-OBJECT')}-{object_digest(type_tag, payload)[:24]}"


def object_id_matches_digest(object_id_value: str, type_tag: str, digest: str) -> bool:
    prefix = OBJECT_PREFIXES.get(type_tag, "CF-OBJECT") + "-"
    suffix = object_id_value.removeprefix(prefix)
    return (
        object_id_value.startswith(prefix)
        and len(suffix) in {12, 24}
        and all(character in "0123456789abcdef" for character in suffix)
        and digest.startswith(suffix)
    )


def read_json(path: Path, default: Any = None) -> Any:
    if not path.exists():
        return default
    return json.loads(path.read_text(encoding="utf-8"))


def read_json_accounted(
    path: Path,
    ledger: DecisionWorkLedger,
    *,
    default: Any = None,
    limit: int = 16 * 1024 * 1024,
) -> tuple[Any, int]:
    """Read one bounded JSON file with pre-effect scratch and retained charging."""
    try:
        directory_fd = _open_directory_nofollow(path.parent)
    except OSError:
        return default, 0
    file_fd = -1
    scratch_bytes = 0
    retained_bytes = 0
    buffer: bytearray | None = None
    try:
        try:
            file_fd = os.open(
                path.name,
                os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0),
                dir_fd=directory_fd,
            )
        except FileNotFoundError:
            return default, 0
        before = os.fstat(file_fd)
        if not stat.S_ISREG(before.st_mode) or before.st_size > limit:
            raise CFError(f"bounded JSON file is invalid: {path}")
        size = before.st_size
        requested_scratch = size * 2
        ledger.apply(
            "record_read",
            charges={"aggregate_bytes": size},
            acquires={"temporary_bytes": requested_scratch},
            counters={"files_read": 1, "file_bytes_read": size},
        )
        scratch_bytes = requested_scratch
        buffer = bytearray()
        while len(buffer) < size:
            chunk = os.read(file_fd, min(64 * 1024, size - len(buffer)))
            if not chunk:
                break
            buffer.extend(chunk)
        extension = os.read(file_fd, 1)
        after = os.fstat(file_fd)
        if (
            len(buffer) != size
            or extension
            or (before.st_dev, before.st_ino) != (after.st_dev, after.st_ino)
            or after.st_size != size
        ):
            raise CFError(f"bounded JSON file changed while reading: {path}")
        try:
            value = json.loads(bytes(buffer))
        except (UnicodeDecodeError, json.JSONDecodeError) as exc:
            raise CFError(f"invalid JSON: {path}: {exc}") from exc
        retained_bytes = canonical_json_size(value)
        ledger.acquire("retained_bytes", retained_bytes, "record_read")
        buffer = None
        return value, retained_bytes
    finally:
        buffer = None
        if scratch_bytes:
            ledger.release("temporary_bytes", scratch_bytes)
        if file_fd >= 0:
            os.close(file_fd)
        os.close(directory_fd)


def accounted_sorted_json_paths(
    directory: Path, ledger: DecisionWorkLedger
) -> tuple[list[Path], int]:
    """Return a deterministic directory snapshot with retained ownership charged."""
    if not directory.is_dir():
        return [], 0
    try:
        directory_fd = _open_directory_nofollow(directory)
    except OSError as exc:
        raise CFError(f"authority directory is unavailable: {directory}") from exc
    names: list[str] = []
    retained_bytes = 0
    try:
        with os.scandir(directory_fd) as entries:
            for entry in entries:
                if not entry.name.endswith(".json"):
                    continue
                path_bytes = (
                    len(str(directory).encode("utf-8"))
                    + len(entry.name.encode("utf-8"))
                    + 128
                )
                ledger.acquire("retained_bytes", path_bytes, "graph_discovery")
                retained_bytes += path_bytes
                names.append(entry.name)
        sort_scratch = retained_bytes + 8 * len(names)
        ledger.acquire("temporary_bytes", sort_scratch, "query")
        try:
            names.sort()
        finally:
            ledger.release("temporary_bytes", sort_scratch)
        paths = [directory / name for name in names]
        names.clear()
        return paths, retained_bytes
    except Exception:
        names.clear()
        if retained_bytes:
            ledger.release("retained_bytes", retained_bytes)
        raise
    finally:
        os.close(directory_fd)


def write_json(path: Path, value: Any) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(path.suffix + ".tmp")
    tmp.write_text(json.dumps(value, ensure_ascii=False, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    os.replace(tmp, path)


def append_jsonl(path: Path, value: Any) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open("a", encoding="utf-8") as f:
        f.write(json.dumps(value, ensure_ascii=False, sort_keys=True, separators=(",", ":")) + "\n")


def is_empty_dir(path: Path) -> bool:
    return path.is_dir() and not any(path.iterdir())


def find_repo_root(start: Path) -> Path:
    current = start.resolve()
    if current.is_file():
        current = current.parent
    for candidate in [current, *current.parents]:
        if (candidate / ".codefire").is_dir():
            return candidate
    marker = find_open_marker(current)
    if marker:
        data = read_json(marker)
        return Path(data["repository"]["path"]).resolve().parent
    raise CFError("not inside a CodeFire repository; run 'codefire init' first")


def find_open_marker(start: Path) -> Path | None:
    current = start.resolve()
    if current.is_file():
        current = current.parent
    for candidate in [current, *current.parents]:
        marker = candidate / ".codefire-open"
        if marker.is_file():
            return marker
    return None


def open_context(start: Path) -> tuple[Path, Path, dict[str, Any], dict[str, Any]]:
    marker = find_open_marker(start)
    if not marker:
        raise CFError("not inside an open CodeFire branch directory")
    identity = read_json(marker)
    open_dir = marker.parent.resolve()
    repo_dir = Path(identity["repository"]["path"]).resolve()
    repo_root = repo_dir.parent
    branch = identity["branch"]["name"]
    registry_path = opened_registry_path(repo_root, branch)
    registry = read_json(registry_path)
    if not registry:
        raise CFError(f"open registry is missing for branch: {branch}")
    if registry.get("branch", {}).get("name") != branch:
        raise CFError("open registry branch does not match open directory marker")
    if Path(registry["open"]["path"]).resolve() != open_dir:
        raise CFError("copied open directory detected; opened_path does not match registry")
    if registry["open"]["open_instance_id"] != identity["open"]["open_instance_id"]:
        raise CFError("copied open directory detected; open_instance_id does not match registry")
    objects_root = repo_dirs(repo_root)["objects"]
    current_base_commit = registry["open"].get("current_base_commit")
    if not isinstance(current_base_commit, str) or not current_base_commit.startswith("CF-COMMIT-"):
        raise CFError("open registry current_base_commit must be a commit object id")
    try:
        validate_sealed_commit(objects_root, current_base_commit)
    except CFError as exc:
        raise CFError(f"open registry current_base_commit is invalid: {exc}") from exc
    branch_record = load_branch(repo_root, branch)
    branch_head = branch_record.get("head")
    if not isinstance(branch_head, str) or not branch_head.startswith("CF-COMMIT-"):
        raise CFError("open branch head must be a commit object id")
    try:
        validate_sealed_commit(objects_root, branch_head)
    except CFError as exc:
        raise CFError(f"open branch head is invalid: {exc}") from exc
    return repo_root, open_dir, identity, registry


def repo_dirs(repo_root: Path) -> dict[str, Path]:
    cf = repo_root / ".codefire"
    return {
        "repo": cf,
        "objects": cf / "objects",
        "branches": cf / "branches",
        "opened": cf / "opened",
        "active": cf / "active",
        "cache": cf / "cache",
        "locks": cf / "locks",
        "remotes": cf / "remotes",
    }


REMOTE_COMPONENT_BYTE_LIMIT = 255
REMOTE_INTERNAL_HASH_PREFIX = "CF-INTERNAL-HASH-"


def decode_remote_component(value: str, kind: str) -> str:
    if re.search(r"%(?![0-9A-Fa-f]{2})", value):
        raise CFError(f"invalid percent escape in remote {kind}: {value}")
    try:
        decoded = urllib.parse.unquote_to_bytes(value).decode("utf-8", errors="strict")
    except UnicodeDecodeError as exc:
        raise CFError(f"remote {kind} component is not UTF-8: {value}") from exc
    validate_remote_component(decoded, kind)
    return decoded


def validate_remote_component(value: str, kind: str) -> None:
    invalid = (
        not value
        or value in {".", ".."}
        or len(value.encode("utf-8")) > REMOTE_COMPONENT_BYTE_LIMIT
        or value.startswith(("/", "\\"))
        or "/" in value
        or "\\" in value
        or ":" in value
        or value.startswith(REMOTE_INTERNAL_HASH_PREFIX)
        or any(unicodedata.category(character) == "Cc" for character in value)
        or Path(value).is_absolute()
        or len(Path(value).parts) != 1
    )
    if invalid:
        raise CFError(f"invalid remote {kind} component: {value!r}")


def parse_cf_url(url: str) -> dict[str, Any]:
    if not url.startswith("cf://"):
        raise CFError(f"not a CodeFire remote URL: {url}")
    raw = url[len("cf://") :]
    if not raw:
        raise CFError("remote URL is empty")
    parts = [p for p in raw.split("/") if p]
    if len(parts) < 4:
        raise CFError("remote URL must be cf://<server-path>/<org>/<app>/<branch>")
    branch_part = parts[-1]
    app_part = parts[-2]
    org_part = parts[-3]
    branch = decode_remote_component(branch_part, "branch")
    app = decode_remote_component(app_part, "application")
    org = decode_remote_component(org_part, "organization")
    server_raw = raw[: -len(f"/{org_part}/{app_part}/{branch_part}")].rstrip("/")
    if not server_raw:
        server_raw = "."
    server_root = Path(server_raw).expanduser().resolve()
    project_root = server_root / ".codefire-server" / "projects" / org / app
    return {
        "server_root": server_root,
        "project_root": project_root,
        "org": org,
        "app": app,
        "branch": branch,
        "url": url,
    }


def parse_cf_project_url(url: str) -> dict[str, Any]:
    if not url.startswith("cf://"):
        raise CFError(f"not a CodeFire remote URL: {url}")
    raw = url[len("cf://") :]
    parts = [p for p in raw.split("/") if p]
    if len(parts) < 3:
        raise CFError("remote project URL must be cf://<server-path>/<org>/<app>")
    app_part = parts[-1]
    org_part = parts[-2]
    app = decode_remote_component(app_part, "application")
    org = decode_remote_component(org_part, "organization")
    server_raw = raw[: -len(f"/{org_part}/{app_part}")].rstrip("/")
    if not server_raw:
        server_raw = "."
    server_root = Path(server_raw).expanduser().resolve()
    project_root = server_root / ".codefire-server" / "projects" / org / app
    return {
        "server_root": server_root,
        "project_root": project_root,
        "org": org,
        "app": app,
        "url": url,
    }


def is_http_remote_url(url: str) -> bool:
    return url.startswith("cf+http://") or url.startswith("cf+https://")


def is_remote_url(url: str) -> bool:
    return url.startswith("cf://") or is_http_remote_url(url)


def parse_cf_http_url(url: str) -> dict[str, Any]:
    parsed = urllib.parse.urlparse(url)
    if parsed.scheme not in {"cf+http", "cf+https"} or not parsed.netloc:
        raise CFError(f"not a CodeFire HTTP remote URL: {url}")
    parts = [decode_remote_component(p, "HTTP path") for p in parsed.path.split("/") if p]
    if len(parts) < 3:
        raise CFError("HTTP remote URL must be cf+http://<host>/<org>/<app>/<branch>")
    endpoint_scheme = "https" if parsed.scheme == "cf+https" else "http"
    return {
        "endpoint": f"{endpoint_scheme}://{parsed.netloc}",
        "remote_scheme": parsed.scheme,
        "netloc": parsed.netloc,
        "org": parts[0],
        "app": parts[1],
        "branch": parts[2],
        "url": url,
    }


def parse_cf_http_project_url(url: str) -> dict[str, Any]:
    parsed = urllib.parse.urlparse(url)
    if parsed.scheme not in {"cf+http", "cf+https"} or not parsed.netloc:
        raise CFError(f"not a CodeFire HTTP remote URL: {url}")
    parts = [decode_remote_component(p, "HTTP path") for p in parsed.path.split("/") if p]
    if len(parts) < 2:
        raise CFError("HTTP remote project URL must be cf+http://<host>/<org>/<app>")
    endpoint_scheme = "https" if parsed.scheme == "cf+https" else "http"
    return {
        "endpoint": f"{endpoint_scheme}://{parsed.netloc}",
        "remote_scheme": parsed.scheme,
        "netloc": parsed.netloc,
        "org": parts[0],
        "app": parts[1],
        "url": url,
    }


def http_remote_path(info: dict[str, Any], *parts: str) -> str:
    quoted = [urllib.parse.quote(str(part), safe="") for part in [info["org"], info["app"], *parts]]
    return f"{info['endpoint']}/v1/projects/" + "/".join(quoted)


def http_json(method: str, url: str, payload: dict[str, Any] | None = None) -> dict[str, Any]:
    data = None if payload is None else canonical_json(payload)
    request = urllib.request.Request(url, data=data, method=method)
    request.add_header("Content-Type", "application/json")
    context = None
    if url.startswith("https://") and os.environ.get("CODEFIRE_TLS_INSECURE") in {"1", "true", "yes"}:
        context = ssl._create_unverified_context()
    try:
        with urllib.request.urlopen(request, timeout=10, context=context) as response:
            body = response.read().decode("utf-8")
    except urllib.error.HTTPError as exc:
        body = exc.read().decode("utf-8", errors="replace")
        try:
            detail = json.loads(body).get("error", body)
        except json.JSONDecodeError:
            detail = body
        raise CFError(f"HTTP remote error: {detail}") from exc
    if not body:
        return {}
    return json.loads(body)


def remote_dirs(project_root: Path) -> dict[str, Path]:
    return {
        "project": project_root,
        "objects": project_root / "objects",
        "branches": project_root / "branches",
        "merge_requests": project_root / "merge_requests",
        "locks": project_root / "locks",
        "idempotency": project_root / "idempotency",
        "audit": project_root / "audit",
        "transactions": project_root / "transactions",
        "gc": project_root / "gc",
    }


def ensure_remote_layout(project_root: Path) -> None:
    app = project_root.name
    org = project_root.parent.name
    validate_remote_component(org, "organization")
    validate_remote_component(app, "application")
    projects_root = project_root.parent.parent
    projects_parent_fd = _open_or_create_directory_nofollow(projects_root.parent)
    projects_fd = bootstrap_fd = org_fd = -1
    try:
        projects_fd = _open_or_create_directory_at(projects_parent_fd, projects_root.name)
        bootstrap_fd = _open_or_create_directory_at(projects_fd, ".bootstrap-locks")
        lock_hash = hashlib.sha256(
            f"codefire-remote-project\0{org}\0{app}".encode("utf-8")
        ).hexdigest()
        lock_name = f"project-{lock_hash}.lock"
        with stable_remote_lock(
            projects_root / ".bootstrap-locks" / lock_name,
            directory_fd=bootstrap_fd,
        ):
            org_fd = _open_or_create_directory_at(projects_fd, org)
            try:
                project_fd = _open_directory_at(org_fd, app)
            except FileNotFoundError:
                stage_name = f".bootstrap-CF-PROJECT-{secrets.token_hex(16)}"
                stage_fd = _open_or_create_directory_at(org_fd, stage_name)
                try:
                    _write_remote_project_descriptor_at(
                        stage_fd, project_root, org, app, "authenticated_bootstrap"
                    )
                    _create_remote_base_layout_at(stage_fd)
                    os.fsync(stage_fd)
                finally:
                    os.close(stage_fd)
                _rename_directory_noreplace_at(org_fd, stage_name, app)
                os.fsync(org_fd)
                project_fd = _open_directory_at(org_fd, app)
            try:
                _initialize_or_validate_remote_project_at(project_fd, project_root, org, app)
            finally:
                os.close(project_fd)
    finally:
        for fd in [org_fd, bootstrap_fd, projects_fd, projects_parent_fd]:
            if fd >= 0:
                os.close(fd)


