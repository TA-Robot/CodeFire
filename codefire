def remote_publication_authority_path(project_root: Path, authority: dict[str, Any]) -> Path:
    kind = authority.get("kind")
    if kind == "branch" and set(authority) == {"kind", "name"}:
        return remote_branch_path(project_root, str(authority["name"]))
    if kind == "merge_request" and set(authority) == {"kind", "id"}:
        return remote_merge_request_path(project_root, str(authority["id"]))
    if kind == "generation" and set(authority) == {"kind"}:
        return remote_generation_path(project_root)
    if kind == "request_nonce_cache" and set(authority) == {"kind"}:
        return remote_request_nonce_cache_path(project_root)
    raise CFError(f"unsupported remote publication authority: {kind}")


def remote_publication_request_hash(
    operation: str,
    actor: str,
    semantic: dict[str, Any],
    idempotency_key: str | None = None,
    object_roots: list[str] | None = None,
) -> str:
    return hashlib.sha256(
        canonical_json(
            {
                "type": "codefire_remote_publication_request",
                "version": VERSION,
                "operation": operation,
                "actor": actor,
                "idempotency_key": idempotency_key,
                "object_roots": object_roots or [],
                "semantic": semantic,
            }
        )
    ).hexdigest()


def _remote_json_hash(value: Any) -> str:
    return hashlib.sha256(canonical_json(value)).hexdigest()


def remote_publication_receipt_path(
    project_root: Path, operation: str, actor: str, idempotency_key: str
) -> Path:
    validate_remote_component(operation, "operation")
    digest = hashlib.sha256(
        f"codefire-remote-idempotency-v2\0{actor}\0{operation}\0{idempotency_key}".encode(
            "utf-8"
        )
    ).hexdigest()
    return project_root / "idempotency" / "v2" / operation / f"{digest}.json"


def validate_remote_publication_receipt(
    project_root: Path,
    receipt: Any,
    operation: str,
    actor: str,
    idempotency_key: str,
    request_hash: str,
) -> dict[str, Any]:
    fields = {
        "type",
        "version",
        "status",
        "operation",
        "actor",
        "key",
        "request_hash",
        "effects",
        "result",
        "result_hash",
        "completed_at",
    }
    if (
        not isinstance(receipt, dict)
        or set(receipt) != fields
        or receipt.get("type") != "remote_idempotency_receipt"
        or receipt.get("version") != 2
        or receipt.get("status") != "completed"
        or receipt.get("operation") != operation
        or receipt.get("actor") != actor
        or receipt.get("key") != idempotency_key
        or receipt.get("request_hash") != request_hash
        or not isinstance(receipt.get("result"), dict)
        or receipt.get("result_hash") != _remote_json_hash(receipt.get("result"))
        or not isinstance(receipt.get("completed_at"), str)
        or not receipt.get("completed_at")
    ):
        raise CFError("remote v2 idempotency receipt is malformed or diverged")
    effects = receipt.get("effects")
    if not isinstance(effects, list) or not effects or len(effects) > 64:
        raise CFError("remote v2 idempotency receipt effects are invalid")
    seen: set[Path] = set()
    for effect in effects:
        if not isinstance(effect, dict) or set(effect) != {"authority", "after_hash"}:
            raise CFError("remote v2 idempotency receipt effect is malformed")
        path = remote_publication_authority_path(project_root, effect["authority"])
        if path in seen:
            raise CFError("remote v2 idempotency receipt has duplicate effects")
        seen.add(path)
        after_hash = effect.get("after_hash")
        if (
            not isinstance(after_hash, str)
            or len(after_hash) != 64
            or any(character not in "0123456789abcdef" for character in after_hash)
        ):
            raise CFError("remote v2 idempotency receipt effect hash is malformed")
    return dict(receipt["result"])


def write_remote_publication_receipt_create_noreplace(
    project_root: Path, operation: str, receipt: dict[str, Any]
) -> None:
    idempotency_fd = _open_directory_nofollow(project_root / "idempotency")
    v2_fd = operation_fd = -1
    try:
        v2_fd = _open_or_create_directory_at(idempotency_fd, "v2")
        os.fsync(idempotency_fd)
        operation_fd = _open_or_create_directory_at(v2_fd, operation)
        os.fsync(v2_fd)
        digest = remote_publication_receipt_path(
            project_root, operation, str(receipt["actor"]), str(receipt["key"])
        ).stem
        _write_create_noreplace_at(
            operation_fd, f"{digest}.json", canonical_json(receipt)
        )
        os.fsync(operation_fd)
    finally:
        for fd in [operation_fd, v2_fd, idempotency_fd]:
            if fd >= 0:
                os.close(fd)


def remote_publication_recovery_exists(
    project_root: Path,
    operation: str,
    actor: str,
    idempotency_key: str | None,
) -> bool:
    if (project_root / "pending_transaction.json").exists():
        return True
    return bool(
        idempotency_key
        and remote_publication_receipt_path(
            project_root, operation, actor, idempotency_key
        ).exists()
    )


def preflight_remote_publication_recovery(
    project_root: Path,
    operation: str,
    actor: str,
    semantic: dict[str, Any],
    expected_result: dict[str, Any],
    idempotency_key: str | None,
    object_roots: list[str] | None = None,
) -> bool:
    """Reject a foreign retry before a caller permits publication effects."""
    roots = object_roots or []
    request_hash = remote_publication_request_hash(
        operation, actor, semantic, idempotency_key, roots
    )
    pending = read_json(project_root / "pending_transaction.json")
    if pending is not None:
        if (
            not isinstance(pending, dict)
            or pending.get("type") != "remote_publication_transaction"
            or pending.get("version") != VERSION
            or pending.get("operation") != operation
            or pending.get("actor") != actor
            or pending.get("idempotency_key") != idempotency_key
            or pending.get("request_hash") != request_hash
            or pending.get("object_roots")
            != [{"kind": "sealed_commit", "id": root} for root in roots]
            or pending.get("result") != expected_result
            or (pending.get("status"), pending.get("phase"))
            not in {("pending", "applying"), ("completed", "completed")}
        ):
            raise CFError(
                "foreign or malformed remote pending transaction is preserved"
            )
        return True
    if idempotency_key is None:
        return False
    receipt = read_json(
        remote_publication_receipt_path(
            project_root, operation, actor, idempotency_key
        )
    )
    if receipt is None:
        return False
    replayed = validate_remote_publication_receipt(
        project_root,
        receipt,
        operation,
        actor,
        idempotency_key,
        request_hash,
    )
    if replayed != expected_result:
        raise CFError("remote v2 idempotency receipt result diverged")
    return True


def remote_transaction_entry_names(
    project_root: Path, transaction_id: str
) -> set[str] | None:
    transactions_fd = _open_directory_nofollow(remote_dirs(project_root)["transactions"])
    transaction_fd = -1
    try:
        try:
            transaction_fd = _open_directory_at(transactions_fd, transaction_id)
        except FileNotFoundError:
            return None
        names: set[str] = set()
        with os.scandir(transaction_fd) as entries:
            for entry in entries:
                if len(names) >= 128:
                    raise CFError(
                        "remote transaction staging exceeds the bounded entry limit"
                    )
                name = entry.name
                if not name.isascii() or any(ord(character) < 32 for character in name):
                    raise CFError(
                        "remote transaction staging contains a noncanonical filename"
                    )
                names.add(name)
        return names
    finally:
        if transaction_fd >= 0:
            os.close(transaction_fd)
        os.close(transactions_fd)


def read_remote_transaction_stage(
    project_root: Path, transaction_id: str, stage_name: str
) -> bytes:
    transactions_fd = _open_directory_nofollow(remote_dirs(project_root)["transactions"])
    transaction_fd = -1
    try:
        transaction_fd = _open_directory_at(transactions_fd, transaction_id)
        return _read_regular_bounded_at(
            transaction_fd, stage_name, 64 * 1024 * 1024
        )
    finally:
        if transaction_fd >= 0:
            os.close(transaction_fd)
        os.close(transactions_fd)


def remove_remote_transaction_stage(
    project_root: Path,
    transaction_id: str,
    stage_name: str,
    expected: bytes,
) -> None:
    transactions_fd = _open_directory_nofollow(remote_dirs(project_root)["transactions"])
    transaction_fd = -1
    try:
        transaction_fd = _open_directory_at(transactions_fd, transaction_id)
        if _read_regular_bounded_at(
            transaction_fd, stage_name, 64 * 1024 * 1024
        ) != expected:
            raise CFError("remote transaction cleanup content diverged")
        os.unlink(stage_name, dir_fd=transaction_fd)
        os.fsync(transaction_fd)
    finally:
        if transaction_fd >= 0:
            os.close(transaction_fd)
        os.close(transactions_fd)


def remove_empty_remote_transaction_dir(
    project_root: Path, transaction_id: str
) -> None:
    transactions_fd = _open_directory_nofollow(remote_dirs(project_root)["transactions"])
    try:
        transaction_fd = _open_directory_at(transactions_fd, transaction_id)
        try:
            with os.scandir(transaction_fd) as entries:
                if next(entries, None) is not None:
                    raise CFError("remote transaction staging is not empty after cleanup")
        finally:
            os.close(transaction_fd)
        os.rmdir(transaction_id, dir_fd=transactions_fd)
        os.fsync(transactions_fd)
    finally:
        os.close(transactions_fd)


def remove_remote_transaction_dir_quarantine(
    project_root: Path, transaction_id: str
) -> bool:
    transactions_fd = _open_directory_nofollow(remote_dirs(project_root)["transactions"])
    quarantine_name = f".removing-{transaction_id}"
    quarantine_fd = -1
    try:
        flags = os.O_RDONLY | getattr(os, "O_DIRECTORY", 0) | os.O_NOFOLLOW
        try:
            quarantine_fd = os.open(
                quarantine_name, flags, dir_fd=transactions_fd
            )
        except FileNotFoundError:
            return False
        with os.scandir(quarantine_fd) as entries:
            if next(entries, None) is not None:
                raise CFError(
                    "quarantined remote transaction directory is not empty"
                )
        os.close(quarantine_fd)
        quarantine_fd = -1
        os.rmdir(quarantine_name, dir_fd=transactions_fd)
        os.fsync(transactions_fd)
        return True
    finally:
        if quarantine_fd >= 0:
            os.close(quarantine_fd)
        os.close(transactions_fd)


def recover_remote_pending_quarantine(
    project_root: Path,
    operation: str | None = None,
    actor: str | None = None,
    request_hash: str | None = None,
    idempotency_key: str | None = None,
) -> dict[str, Any] | None:
    project_fd = _open_directory_nofollow(project_root)
    try:
        names = sorted(
            name
            for name in os.listdir(project_fd)
            if name.startswith(".pending_transaction.removing-")
            and name.endswith(".json")
        )
        if not names:
            return None
        if len(names) != 1:
            raise CFError("multiple remote pending quarantines are preserved")
        name = names[0]
        payload = _read_regular_bounded_at(project_fd, name, 1024 * 1024)
        try:
            pending = json.loads(payload)
        except (UnicodeDecodeError, json.JSONDecodeError) as exc:
            raise CFError("remote pending quarantine is malformed") from exc
        transaction_id = pending.get("transaction_id") if isinstance(pending, dict) else None
        expected_name = (
            f".pending_transaction.removing-{transaction_id}.json"
            if isinstance(transaction_id, str)
            else ""
        )
        if (
            not isinstance(pending, dict)
            or pending.get("type") != "remote_publication_transaction"
            or pending.get("version") != VERSION
            or (pending.get("status"), pending.get("phase"))
            != ("completed", "completed")
            or not isinstance(transaction_id, str)
            or name != expected_name
        ):
            raise CFError("foreign remote pending quarantine is preserved")
        expected_fields = {
            "type", "version", "status", "phase", "transaction_id",
            "operation", "actor", "idempotency_key", "request_hash",
            "object_roots", "writes", "published_count", "result",
            "created_at", "completed_at",
        }
        if (
            set(pending) != expected_fields
            or operation is None
            or actor is None
            or request_hash is None
            or pending.get("operation") != operation
            or pending.get("actor") != actor
            or pending.get("request_hash") != request_hash
            or pending.get("idempotency_key") != idempotency_key
        ):
            raise CFError(
                "a completed remote pending quarantine requires its exact owning retry"
            )
        writes = pending.get("writes")
        result = pending.get("result")
        object_roots = pending.get("object_roots")
        if (
            not isinstance(writes, list)
            or not writes
            or len(writes) > 64
            or not isinstance(result, dict)
            or pending.get("published_count") != len(writes)
            or not isinstance(pending.get("created_at"), str)
            or not isinstance(pending.get("completed_at"), str)
            or not isinstance(object_roots, list)
            or len(object_roots) > 64
        ):
            raise CFError("completed remote pending quarantine is malformed")
        root_ids: list[str] = []
        for root in object_roots:
            if (
                not isinstance(root, dict)
                or set(root) != {"kind", "id"}
                or root.get("kind") != "sealed_commit"
                or not isinstance(root.get("id"), str)
            ):
                raise CFError("completed remote pending quarantine root is malformed")
            root_ids.append(root["id"])
        if len(root_ids) != len(set(root_ids)):
            raise CFError("completed remote pending quarantine roots are duplicated")
        for root_id in root_ids:
            validate_sealed_commit(remote_dirs(project_root)["objects"], root_id)
        effects: list[dict[str, Any]] = []
        authority_paths: set[Path] = set()
        for index, record in enumerate(writes):
            before_hash = record.get("before_hash") if isinstance(record, dict) else None
            if (
                not isinstance(record, dict)
                or set(record)
                != {
                    "authority", "before_absent", "before_hash",
                    "after_hash", "postimage_index",
                }
                or record.get("postimage_index") != index
                or not isinstance(record.get("authority"), dict)
                or not isinstance(record.get("after_hash"), str)
                or len(record.get("after_hash")) != 64
                or any(
                    character not in "0123456789abcdef"
                    for character in record.get("after_hash")
                )
                or not isinstance(record.get("before_absent"), bool)
                or (
                    record.get("before_absent")
                    and record.get("before_hash") is not None
                )
                or (
                    not record.get("before_absent")
                    and (
                        not isinstance(before_hash, str)
                        or len(before_hash) != 64
                        or any(
                            character not in "0123456789abcdef"
                            for character in before_hash
                        )
                    )
                )
            ):
                raise CFError("completed remote pending quarantine write is malformed")
            authority_path = remote_publication_authority_path(
                project_root, record["authority"]
            )
            if authority_path in authority_paths:
                raise CFError(
                    "completed remote pending quarantine authorities are duplicated"
                )
            authority_paths.add(authority_path)
            current = read_json(authority_path)
            if current is None or _remote_json_hash(current) != record["after_hash"]:
                raise CFError(
                    "completed remote pending quarantine authority diverged"
                )
            effects.append(
                {
                    "authority": record["authority"],
                    "after_hash": record["after_hash"],
                }
            )
        if idempotency_key is not None:
            receipt = read_json(
                remote_publication_receipt_path(
                    project_root, operation, actor, idempotency_key
                )
            )
            replayed = validate_remote_publication_receipt(
                project_root,
                receipt,
                operation,
                actor,
                idempotency_key,
                request_hash,
            )
            if replayed != result or receipt.get("effects") != effects:
                raise CFError(
                    "completed remote pending quarantine receipt diverged"
                )
        validate_remote_component(transaction_id, "transaction ID")
        if remote_transaction_entry_names(project_root, transaction_id) is not None:
            raise CFError(
                "completed pending quarantine still has a live transaction directory"
            )
        remove_remote_transaction_dir_quarantine(project_root, transaction_id)
        os.unlink(name, dir_fd=project_fd)
        os.fsync(project_fd)
        return dict(result)
    finally:
        os.close(project_fd)


class RemoteJSONPublicationWritePreflight:
    """Single-use proof that canonical authority writes passed pure validation."""

    __slots__ = (
        "project_root",
        "write_count",
        "writes_digest",
        "_write_plan",
        "_consumed",
    )

    def __init__(
        self,
        project_root: Path,
        write_count: int,
        writes_digest: str,
        write_plan: tuple[
            tuple[Path, dict[str, Any], Any, bytes, bool, str | None, str],
            ...,
        ],
    ) -> None:
        object.__setattr__(self, "project_root", project_root)
        object.__setattr__(self, "write_count", write_count)
        object.__setattr__(self, "writes_digest", writes_digest)
        object.__setattr__(self, "_write_plan", write_plan)
        object.__setattr__(self, "_consumed", False)

    def __setattr__(self, name: str, value: Any) -> None:
        del name, value
        raise CFError("remote publication write preflight is immutable")

    def validate_fresh_preimages(self) -> None:
        for path, _authority, before, _after_bytes, _, _, _ in self._write_plan:
            if read_json(path) != before:
                raise CFError(f"remote authority preimage diverged: {path}")

    def consume_for_publication(
        self,
        project_root: Path,
        writes: list[tuple[dict[str, Any], Any, Any]],
        *,
        validate_preimages: bool,
    ) -> tuple[
        tuple[Path, dict[str, Any], Any, bytes, bool, str | None, str],
        ...,
    ]:
        if self._consumed:
            raise CFError("remote publication write preflight is not available")
        if (
            project_root != self.project_root
            or len(writes) != self.write_count
            or _remote_publication_writes_digest(writes) != self.writes_digest
        ):
            raise CFError("remote publication write preflight does not match its publication")
        if validate_preimages:
            self.validate_fresh_preimages()
        object.__setattr__(self, "_consumed", True)
        return self._write_plan


class RemoteJSONPublicationPreflight:
    """Single-use proof that an exact publication plan passed validation."""

    __slots__ = (
        "project_root",
        "operation",
        "actor",
        "idempotency_key",
        "object_roots",
        "write_count",
        "request_hash",
        "intent_digest",
        "_write_plan",
        "_result",
        "_sealed",
        "_consumed",
        "_semantic_owner",
        "_writes_owner",
        "_result_owner",
    )

    def __init__(
        self,
        project_root: Path,
        operation: str,
        actor: str,
        idempotency_key: str | None,
        object_roots: tuple[str, ...],
        write_count: int,
        request_hash: str,
        intent_digest: str,
        write_plan: tuple[
            tuple[Path, dict[str, Any], Any, bytes, bool, str | None, str],
            ...,
        ],
        result: dict[str, Any],
    ) -> None:
        object.__setattr__(self, "project_root", project_root)
        object.__setattr__(self, "operation", operation)
        object.__setattr__(self, "actor", actor)
        object.__setattr__(self, "idempotency_key", idempotency_key)
        object.__setattr__(self, "object_roots", object_roots)
        object.__setattr__(self, "write_count", write_count)
        object.__setattr__(self, "request_hash", request_hash)
        object.__setattr__(self, "intent_digest", intent_digest)
        object.__setattr__(self, "_write_plan", write_plan)
        object.__setattr__(self, "_result", result)
        object.__setattr__(self, "_sealed", False)
        object.__setattr__(self, "_consumed", False)
        object.__setattr__(self, "_semantic_owner", None)
        object.__setattr__(self, "_writes_owner", None)
        object.__setattr__(self, "_result_owner", None)

    def __setattr__(self, name: str, value: Any) -> None:
        del name, value
        raise CFError("remote publication preflight is immutable")

    def seal_for_effect(
        self,
        project_root: Path,
        operation: str,
        actor: str,
        semantic: dict[str, Any],
        writes: list[tuple[dict[str, Any], Any, Any]],
        result: dict[str, Any],
        idempotency_key: str | None,
        object_roots: tuple[str, ...],
    ) -> None:
        if self._sealed or self._consumed:
            raise CFError("remote publication preflight is already sealed")
        if (
            project_root != self.project_root
            or operation != self.operation
            or actor != self.actor
            or idempotency_key != self.idempotency_key
            or object_roots != self.object_roots
            or len(writes) != self.write_count
            or _remote_publication_intent_digest(
                operation,
                actor,
                semantic,
                writes,
                result,
                idempotency_key,
                object_roots,
            )
            != self.intent_digest
        ):
            raise CFError("remote publication preflight does not match its effect")

        object.__setattr__(self, "_semantic_owner", semantic)
        object.__setattr__(self, "_writes_owner", writes)
        object.__setattr__(self, "_result_owner", result)
        object.__setattr__(self, "_sealed", True)

    def consume_for_effect(
        self,
        project_root: Path,
        operation: str,
        actor: str,
        semantic: dict[str, Any],
        writes: list[tuple[dict[str, Any], Any, Any]],
        result: dict[str, Any],
        idempotency_key: str | None,
        object_roots: tuple[str, ...],
    ) -> None:
        if not self._sealed or self._consumed:
            raise CFError("remote publication preflight is not available")
        if (
            project_root != self.project_root
            or operation != self.operation
            or actor != self.actor
            or idempotency_key != self.idempotency_key
            or object_roots != self.object_roots
            or semantic is not self._semantic_owner
            or writes is not self._writes_owner
            or result is not self._result_owner
        ):
            raise CFError("remote publication preflight owner changed before effect")
        object.__setattr__(self, "_consumed", True)

    def validate_fresh_preimages(self) -> None:
        for path, _authority, before, _after_bytes, _, _, _ in self._write_plan:
            if read_json(path) != before:
                raise CFError(f"remote authority preimage diverged: {path}")


def _remote_publication_intent_digest(
    operation: str,
    actor: str,
    semantic: dict[str, Any],
    writes: list[tuple[dict[str, Any], Any, Any]],
    result: dict[str, Any],
    idempotency_key: str | None,
    object_roots: tuple[str, ...],
) -> str:
    """Bind every caller-controlled publication-plan value without ambiguity."""
    digest = hashlib.sha256()

    def update(value: Any) -> None:
        encoded = canonical_json(value)
        digest.update(len(encoded).to_bytes(8, "big"))
        digest.update(encoded)

    update(operation)
    update(actor)
    update(semantic)
    update(idempotency_key)
    update(list(object_roots))
    update(result)
    digest.update(len(writes).to_bytes(8, "big"))
    for authority, before, after in writes:
        update(authority)
        update(before)
        update(after)
    return digest.hexdigest()


def _remote_publication_writes_digest(
    writes: list[tuple[dict[str, Any], Any, Any]],
) -> str:
    """Bind one ordered authority write set independently of publication identity."""
    digest = hashlib.sha256()
    digest.update(len(writes).to_bytes(8, "big"))
    for authority, before, after in writes:
        for value in (authority, before, after):
            encoded = canonical_json(value)
            digest.update(len(encoded).to_bytes(8, "big"))
            digest.update(encoded)
    return digest.hexdigest()


def _remote_publication_text_is_invalid(value: Any, byte_limit: int) -> bool:
    """Reject non-text and values that cannot be represented as UTF-8."""
    if not isinstance(value, str) or not value:
        return True
    try:
        encoded = value.encode("utf-8")
    except UnicodeEncodeError:
        return True
    return len(encoded) > byte_limit or any(
        unicodedata.category(character) == "Cc" for character in value
    )


def validate_remote_json_publication_subject(
    operation: str,
    actor: str,
    idempotency_key: str | None = None,
) -> None:
    """Validate publication identity values without reading or changing state."""
    validate_remote_component(operation, "operation")
    if _remote_publication_text_is_invalid(actor, 255):
        raise CFError("remote publication actor is invalid")
    if idempotency_key is not None and _remote_publication_text_is_invalid(
        idempotency_key, 1024
    ):
        raise CFError("remote idempotency key is invalid")


def validate_remote_json_publication_identity(
    operation: str,
    actor: str,
    idempotency_key: str | None = None,
    object_roots: list[str] | None = None,
    *,
    objects_root: Path,
) -> tuple[str, ...]:
    """Validate publication identity and roots without changing durable state."""
    roots = tuple(object_roots or ())
    validate_remote_json_publication_subject(operation, actor, idempotency_key)
    if len(roots) > 64 or len(set(roots)) != len(roots):
        raise CFError(
            "remote publication object roots are duplicated or exceed the bounded limit"
        )
    for root in roots:
        validate_sealed_commit(objects_root, root)
    return roots


def preflight_remote_json_publication_writes(
    project_root: Path,
    writes: list[tuple[dict[str, Any], Any, Any]],
    *,
    validate_preimages: bool = True,
) -> RemoteJSONPublicationWritePreflight:
    """Freeze and validate authority writes without requiring a project layout."""
    if not writes or len(writes) > 64:
        raise CFError("remote publication write count must be 1..=64")
    write_plan = []
    seen_paths: set[Path] = set()
    for authority, before, after in writes:
        path = remote_publication_authority_path(project_root, authority)
        if path in seen_paths:
            raise CFError("remote publication contains duplicate authority writes")
        seen_paths.add(path)
        authority_bytes = canonical_json(authority)
        before_bytes = canonical_json(before)
        after_bytes = canonical_json(after)
        if len(after_bytes) > 64 * 1024 * 1024:
            raise CFError(
                "remote publication postimage exceeds the bounded record limit"
            )
        write_plan.append(
            (
                path,
                json.loads(authority_bytes),
                json.loads(before_bytes),
                after_bytes,
                before is None,
                None if before is None else hashlib.sha256(before_bytes).hexdigest(),
                hashlib.sha256(after_bytes).hexdigest(),
            )
        )
    preflight = RemoteJSONPublicationWritePreflight(
        project_root,
        len(writes),
        _remote_publication_writes_digest(writes),
        tuple(write_plan),
    )
    if validate_preimages:
        preflight.validate_fresh_preimages()
    return preflight


def preflight_remote_json_publication(
    project_root: Path,
    operation: str,
    actor: str,
    semantic: dict[str, Any],
    writes: list[tuple[dict[str, Any], Any, Any]],
    result: dict[str, Any],
    idempotency_key: str | None = None,
    object_roots: list[str] | None = None,
    *,
    validation_objects_root: Path | None = None,
    validate_preimages: bool = True,
    write_preflight: RemoteJSONPublicationWritePreflight | None = None,
) -> RemoteJSONPublicationPreflight:
    """Validate one publication without creating or changing durable state."""
    if not writes or len(writes) > 64:
        raise CFError("remote publication write count must be 1..=64")
    roots = validate_remote_json_publication_identity(
        operation,
        actor,
        idempotency_key,
        object_roots,
        objects_root=(
            validation_objects_root or remote_dirs(project_root)["objects"]
        ),
    )
    request_hash = remote_publication_request_hash(
        operation, actor, semantic, idempotency_key, list(roots)
    )
    intent_digest = _remote_publication_intent_digest(
        operation,
        actor,
        semantic,
        writes,
        result,
        idempotency_key,
        roots,
    )
    if write_preflight is None:
        write_preflight = preflight_remote_json_publication_writes(
            project_root,
            writes,
            validate_preimages=False,
        )
    result_bytes = canonical_json(result)
    write_plan = write_preflight.consume_for_publication(
        project_root,
        writes,
        validate_preimages=validate_preimages,
    )
    preflight = RemoteJSONPublicationPreflight(
        project_root,
        operation,
        actor,
        idempotency_key,
        roots,
        len(writes),
        request_hash,
        intent_digest,
        write_plan,
        json.loads(result_bytes),
    )
    return preflight


def execute_remote_json_publication(
    project_root: Path,
    operation: str,
    actor: str,
    semantic: dict[str, Any],
    writes: list[tuple[dict[str, Any], Any, Any]],
    result: dict[str, Any],
    idempotency_key: str | None = None,
    object_roots: list[str] | None = None,
    *,
    preflight: RemoteJSONPublicationPreflight | None = None,
) -> dict[str, Any]:
    """Publish a bounded JSON authority set under an already-held exclusive project gate."""
    roots = tuple(object_roots or ())
    if preflight is None:
        preflight = preflight_remote_json_publication(
            project_root,
            operation,
            actor,
            semantic,
            writes,
            result,
            idempotency_key,
            list(roots),
            validate_preimages=False,
        )
        preflight.seal_for_effect(
            project_root,
            operation,
            actor,
            semantic,
            writes,
            result,
            idempotency_key,
            roots,
        )
    preflight.consume_for_effect(
        project_root,
        operation,
        actor,
        semantic,
        writes,
        result,
        idempotency_key,
        roots,
    )
    request_hash = preflight.request_hash
    quarantined_result = recover_remote_pending_quarantine(
        project_root,
        operation,
        actor,
        request_hash,
        idempotency_key,
    )
    if quarantined_result is not None:
        return quarantined_result
    pending_path = project_root / "pending_transaction.json"
    pending = read_json(pending_path)
    loaded_pending = pending is not None
    receipt_path = (
        remote_publication_receipt_path(
            project_root, operation, actor, idempotency_key
        )
        if idempotency_key is not None
        else None
    )
    if pending is None and receipt_path is not None:
        receipt = read_json(receipt_path)
        if receipt is not None:
            return validate_remote_publication_receipt(
                project_root,
                receipt,
                operation,
                actor,
                idempotency_key,
                request_hash,
            )
    if pending is None:
        preflight.validate_fresh_preimages()
        transaction_id = f"TX-{secrets.token_hex(16)}"
        transaction_dir = remote_dirs(project_root)["transactions"] / transaction_id
        transaction_dir.mkdir(mode=0o700)
        _sync_directory(transaction_dir.parent)
        records: list[dict[str, Any]] = []
        try:
            for index, (
                _path,
                authority,
                _before,
                after_bytes,
                before_absent,
                before_hash,
                after_hash,
            ) in enumerate(preflight._write_plan):
                stage = transaction_dir / f"write-{index}.json"
                fd = os.open(stage, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
                try:
                    _write_all_fd(fd, after_bytes)
                    os.fsync(fd)
                finally:
                    os.close(fd)
                records.append(
                    {
                        "authority": authority,
                        "before_absent": before_absent,
                        "before_hash": before_hash,
                        "after_hash": after_hash,
                        "postimage_index": index,
                    }
                )
            _sync_directory(transaction_dir)
            pending = {
                "type": "remote_publication_transaction",
                "version": VERSION,
                "status": "pending",
                "phase": "applying",
                "transaction_id": transaction_id,
                "operation": operation,
                "actor": actor,
                "idempotency_key": idempotency_key,
                "request_hash": request_hash,
                "object_roots": [
                    {"kind": "sealed_commit", "id": root} for root in roots
                ],
                "writes": records,
                "published_count": 0,
                "result": preflight._result,
                "created_at": now_iso(),
            }
            project_fd = _open_directory_nofollow(project_root)
            try:
                _write_create_noreplace_at(
                    project_fd, "pending_transaction.json", canonical_json(pending)
                )
            finally:
                os.close(project_fd)
        except Exception:
            if not pending_path.exists():
                shutil.rmtree(transaction_dir, ignore_errors=True)
            raise
    if not isinstance(pending, dict):
        raise CFError("foreign or malformed remote pending transaction is preserved")
    expected_pending_fields = {
        "type",
        "version",
        "status",
        "phase",
        "transaction_id",
        "operation",
        "actor",
        "idempotency_key",
        "request_hash",
        "object_roots",
        "writes",
        "published_count",
        "result",
        "created_at",
    }
    if pending.get("status") == "completed":
        expected_pending_fields.add("completed_at")
    if (
        set(pending) != expected_pending_fields
        or pending.get("type") != "remote_publication_transaction"
        or pending.get("version") != VERSION
        or pending.get("operation") != operation
        or pending.get("actor") != actor
        or pending.get("idempotency_key") != idempotency_key
        or pending.get("request_hash") != request_hash
        or pending.get("object_roots")
        != [{"kind": "sealed_commit", "id": root} for root in roots]
        or (pending.get("status"), pending.get("phase"))
        not in {("pending", "applying"), ("completed", "completed")}
    ):
        raise CFError("foreign or malformed remote pending transaction is preserved")
    records = pending.get("writes")
    if (
        not isinstance(records, list)
        or not records
        or len(records) > 64
        or (not loaded_pending and len(records) != preflight.write_count)
    ):
        raise CFError("remote pending write set diverged")
    transaction_id = pending.get("transaction_id")
    if not isinstance(transaction_id, str):
        raise CFError("remote pending transaction ID is missing")
    validate_remote_component(transaction_id, "transaction ID")
    published = pending.get("published_count")
    if not isinstance(published, int) or published < 0 or published > len(records):
        raise CFError("remote pending progress is invalid")
    recovered: list[tuple[Path, Any, bytes | None, str, bool, bool]] = []
    expected_stage_names = {f"write-{index}.json" for index in range(len(records))}
    quarantine_stage_names = {
        f".{name}.removing-{transaction_id}" for name in expected_stage_names
    }
    actual_stage_names = remote_transaction_entry_names(project_root, transaction_id)
    actual_stage_names = actual_stage_names if actual_stage_names is not None else set()
    if not actual_stage_names.issubset(
        expected_stage_names | quarantine_stage_names
    ) or (
        pending.get("status") == "pending" and actual_stage_names != expected_stage_names
    ):
        raise CFError("remote transaction staging set diverged")
    for index, record in enumerate(records):
        authority = record.get("authority") if isinstance(record, dict) else None
        if (
            not isinstance(record, dict)
            or set(record) != {"authority", "before_absent", "before_hash", "after_hash", "postimage_index"}
            or not isinstance(authority, dict)
            or (
                not loaded_pending
                and authority != preflight._write_plan[index][1]
            )
            or record.get("postimage_index") != index
            or not isinstance(record.get("before_absent"), bool)
            or (
                record.get("before_absent")
                and record.get("before_hash") is not None
            )
            or (
                not record.get("before_absent")
                and not isinstance(record.get("before_hash"), str)
            )
            or not isinstance(record.get("after_hash"), str)
        ):
            raise CFError("remote pending authority record diverged")
        original_stage_name = f"write-{index}.json"
        quarantine_stage_name = (
            f".{original_stage_name}.removing-{transaction_id}"
        )
        if (
            original_stage_name in actual_stage_names
            and quarantine_stage_name in actual_stage_names
        ):
            raise CFError(
                "remote transaction staging contains both original and quarantine entries"
            )
        stage_name = (
            original_stage_name
            if original_stage_name in actual_stage_names
            else quarantine_stage_name
        )
        stage_bytes = (
            read_remote_transaction_stage(project_root, transaction_id, stage_name)
            if stage_name in actual_stage_names
            else None
        )
        after_hash = str(record["after_hash"])
        if stage_bytes is not None:
            try:
                after = json.loads(stage_bytes)
            except (UnicodeDecodeError, json.JSONDecodeError) as exc:
                raise CFError("remote staged postimage is not JSON") from exc
            if (
                hashlib.sha256(stage_bytes).hexdigest() != after_hash
                or stage_bytes != canonical_json(after)
            ):
                raise CFError("remote staged postimage diverged")
        elif pending.get("status") != "completed":
            raise CFError("remote staged postimage is missing")
        path = remote_publication_authority_path(project_root, authority)
        current = read_json(path)
        current_hash = None if current is None else _remote_json_hash(current)
        is_before = (
            current_hash is None
            if record["before_absent"]
            else current_hash == record["before_hash"]
        )
        is_after = current_hash == after_hash
        if index < published and not is_after:
            raise CFError(f"remote authority diverged during recovery: {path}")
        if index > published and not is_before:
            raise CFError(f"remote authority diverged before publication: {path}")
        if index == published and not (is_before or is_after):
            raise CFError(f"remote authority diverged at publication boundary: {path}")
        if stage_bytes is None:
            after = current
        recovered.append((path, after, stage_bytes, after_hash, is_before, is_after))
    for index, (path, after, _, _, is_before, is_after) in enumerate(recovered[published:], start=published):
        if is_before:
            write_remote_publication_json_durable(path, after)
            if read_json(path) != after:
                raise CFError(f"remote authority write did not persist: {path}")
        elif not is_after:
            raise CFError(f"remote authority diverged during publication: {path}")
        pending["published_count"] = index + 1
        write_remote_publication_json_durable(pending_path, pending)
    if idempotency_key is not None:
        effects = [
            {"authority": record["authority"], "after_hash": record["after_hash"]}
            for record in records
        ]
        receipt = {
            "type": "remote_idempotency_receipt",
            "version": 2,
            "status": "completed",
            "operation": operation,
            "actor": actor,
            "key": idempotency_key,
            "request_hash": request_hash,
            "effects": effects,
            "result": pending["result"],
            "result_hash": _remote_json_hash(pending["result"]),
            "completed_at": now_iso(),
        }
        try:
            write_remote_publication_receipt_create_noreplace(
                project_root, operation, receipt
            )
        except FileExistsError:
            existing = read_json(receipt_path)
            replayed = validate_remote_publication_receipt(
                project_root,
                existing,
                operation,
                actor,
                idempotency_key,
                request_hash,
            )
            if replayed != pending["result"]:
                raise CFError("remote v2 idempotency receipt result diverged")
    if pending.get("status") != "completed":
        pending["status"] = "completed"
        pending["phase"] = "completed"
        pending["completed_at"] = now_iso()
        write_remote_publication_json_durable(pending_path, pending)
    for index, (_, _, stage_bytes, _, _, _) in enumerate(recovered):
        original_stage_name = f"write-{index}.json"
        quarantine_stage_name = (
            f".{original_stage_name}.removing-{transaction_id}"
        )
        stage_name = (
            original_stage_name
            if original_stage_name in actual_stage_names
            else quarantine_stage_name
        )
        if stage_name not in actual_stage_names:
            continue
        if stage_bytes is None:
            raise CFError("remote transaction cleanup content diverged")
        remove_remote_transaction_stage(
            project_root, transaction_id, stage_name, stage_bytes
        )
    if remote_transaction_entry_names(project_root, transaction_id) is not None:
        remove_empty_remote_transaction_dir(project_root, transaction_id)
    else:
        remove_remote_transaction_dir_quarantine(project_root, transaction_id)
    current_pending = read_json(pending_path)
    if current_pending != pending:
        raise CFError("remote pending transaction changed before release")
    pending_path.unlink()
    _sync_directory(project_root)
    return dict(pending["result"])


def actor_from_args(args: argparse.Namespace) -> str:
    return getattr(args, "actor", None) or os.environ.get("CODEFIRE_ACTOR") or os.environ.get("USER") or "anonymous"


def token_from_args(args: argparse.Namespace) -> str:
    return getattr(args, "token", None) or os.environ.get("CODEFIRE_TOKEN") or ""


def request_key_id_from_args(args: argparse.Namespace, actor: str) -> str:
    return getattr(args, "request_key_id", None) or os.environ.get("CODEFIRE_REQUEST_KEY_ID") or actor


def token_sha256(token: str, salt: str = "") -> str:
    return hashlib.sha256((salt + token).encode("utf-8")).hexdigest()


def token_hash_policy_value(token: str, salt: str = "") -> str | dict[str, str]:
    digest = token_sha256(token, salt)
    if salt:
        return {
            "algorithm": "sha256",
            "salt": salt,
            "hash": digest,
        }
    return f"sha256:{digest}"


def check_token_value(token: str, expected: Any) -> bool:
    if isinstance(expected, str):
        if expected.startswith("sha256:"):
            return hmac.compare_digest(token_hash_policy_value(token), expected)
        return hmac.compare_digest(token, expected)
    if isinstance(expected, dict):
        algorithm = str(expected.get("algorithm", "sha256")).lower()
        if algorithm != "sha256":
            raise CFError(f"authentication failed: unsupported token hash algorithm: {algorithm}")
        digest = expected.get("hash") or expected.get("sha256")
        if not isinstance(digest, str) or not digest:
            raise CFError("authentication failed: token hash is missing")
        salt = expected.get("salt", "")
        if not isinstance(salt, str):
            raise CFError("authentication failed: token hash salt must be a string")
        return hmac.compare_digest(token_sha256(token, salt), digest)
    raise CFError("authentication failed: token policy entry must be a string or object")


def parse_iso_seconds(value: str) -> float:
    try:
        return float(calendar.timegm(time.strptime(value, "%Y-%m-%dT%H:%M:%SZ")))
    except (TypeError, ValueError) as exc:
        raise CFError("request signature validation failed: timestamp is invalid") from exc


def hmac_policy_secret(entry: Any, signer: str, error_prefix: str) -> str:
    if isinstance(entry, str):
        return entry
    if not isinstance(entry, dict):
        raise CFError(f"{error_prefix}: no key for signer '{signer}'")
    status = str(entry.get("status", "active")).lower()
    if status in {"revoked", "disabled"} or entry.get("revoked") is True:
        raise CFError(f"{error_prefix}: key is revoked")
    if entry.get("active") is False:
        raise CFError(f"{error_prefix}: key is inactive")
    allowed_signers = entry.get("signers")
    if isinstance(allowed_signers, str):
        allowed_signers = [allowed_signers]
    if allowed_signers is not None and not ("*" in allowed_signers or signer in allowed_signers):
        raise CFError(f"{error_prefix}: key is not allowed for signer '{signer}'")
    secret = entry.get("secret") or entry.get("key")
    if not isinstance(secret, str) or not secret:
        raise CFError(f"{error_prefix}: key secret is missing")
    return secret


def request_signature_metadata(signature: dict[str, Any]) -> dict[str, Any]:
    return {k: v for k, v in signature.items() if k != "signature"}


def request_signature_input(signature: dict[str, Any]) -> bytes:
    return canonical_json(request_signature_metadata(signature))


def request_signature_digest(signature: dict[str, Any], key: str) -> str:
    return hmac.new(key.encode("utf-8"), request_signature_input(signature), hashlib.sha256).hexdigest()


def remote_request_payload_digest(payload: dict[str, Any]) -> str:
    unsigned = dict(payload)
    unsigned.pop("request_signature", None)
    return "sha256:" + hashlib.sha256(canonical_json(unsigned)).hexdigest()


def remote_request_subject_digest(signature: dict[str, Any]) -> str:
    subject = {
        "type": signature.get("subject_type"),
        "version": signature.get("subject_version"),
        "operation": signature.get("operation"),
        "actor": signature.get("actor"),
        "target": signature.get("target"),
        "payload_digest": signature.get("payload_digest"),
        "idempotency_key": signature.get("idempotency_key"),
        "key_id": signature.get("key_id"),
        "timestamp": signature.get("timestamp"),
        "nonce": signature.get("nonce"),
    }
    return "sha256:" + hashlib.sha256(canonical_json(subject)).hexdigest()


def request_nonce_cache_key(signature: dict[str, Any]) -> str:
    return hashlib.sha256(
        canonical_json(
            {
                "actor": signature.get("actor"),
                "key_id": signature.get("key_id"),
                "nonce": signature.get("nonce"),
            }
        )
    ).hexdigest()


def record_request_nonce(
    project_root: Path,
    signature: dict[str, Any],
    ttl_seconds: float,
    max_entries: int,
) -> None:
    now = time.time()
    ensure_remote_layout(project_root)
    cache_path = remote_request_nonce_cache_path(project_root)
    lock_path = remote_dirs(project_root)["locks"] / "request-nonce-cache.lock"
    with stable_remote_lock(lock_path):
        postimage = request_nonce_cache_postimage(
            project_root, signature, ttl_seconds, max_entries, now
        )
        write_json(cache_path, postimage)


def request_nonce_cache_postimage(
    project_root: Path,
    signature: dict[str, Any],
    ttl_seconds: float,
    max_entries: int,
    now: float,
) -> dict[str, Any]:
    """Plan the exact nonce-cache postimage without publishing it."""
    cache = read_json(
        remote_request_nonce_cache_path(project_root),
        {"version": VERSION, "entries": {}},
    )
    if (
        not isinstance(cache, dict)
        or cache.get("version") != VERSION
        or not isinstance(cache.get("entries"), dict)
    ):
        raise CFError(
            "request signature validation failed: nonce cache is malformed; replay memory was preserved"
        )
    cutoff = now - ttl_seconds
    entries: dict[str, Any] = {}
    for cache_key, value in cache["entries"].items():
        seen_at = value.get("seen_at") if isinstance(value, dict) else None
        if (
            not isinstance(value, dict)
            or isinstance(seen_at, bool)
            or not isinstance(seen_at, (int, float))
            or not math.isfinite(float(seen_at))
            or not isinstance(value.get("actor"), str)
            or not isinstance(value.get("nonce"), str)
        ):
            raise CFError(
                "request signature validation failed: nonce cache entry is malformed; replay memory was preserved"
            )
        if float(seen_at) >= cutoff:
            entries[cache_key] = value
    actor = signature.get("actor")
    key_id = signature.get("key_id") or actor
    nonce = signature.get("nonce")
    if any(
        value.get("actor") == actor
        and value.get("nonce") == nonce
        and (value.get("key_id") is None or value.get("key_id") == key_id)
        for value in entries.values()
    ):
        raise CFError("request signature validation failed: nonce has already been used")
    cache_key = request_nonce_cache_key(signature)
    if cache_key in entries:
        raise CFError("request signature validation failed: nonce has already been used")
    if len(entries) >= max_entries:
        raise CFError(
            "request signature validation failed: nonce cache capacity reached; live entries were preserved"
        )
    entries[cache_key] = {
        "actor": actor,
        "key_id": signature.get("key_id"),
        "operation": signature.get("operation"),
        "target": signature.get("target"),
        "timestamp": signature.get("timestamp"),
        "nonce": nonce,
        "seen_at": now,
    }
    return {
        "version": VERSION,
        "entries": entries,
        "updated_at": now_iso(),
        "ttl_seconds": int(ttl_seconds) if ttl_seconds.is_integer() else ttl_seconds,
        "max_entries": max_entries,
        "entry_count": len(entries),
    }


def sign_remote_request(
    operation: str,
    actor: str,
    target: str,
    payload: dict[str, Any],
    key_id: str,
    key: str,
    *,
    timestamp: str | None = None,
    nonce: str | None = None,
) -> dict[str, Any]:
    signature = {
        "type": "remote_request_signature",
        "version": 2,
        "algorithm": "hmac-sha256",
        "subject_type": "codefire_remote_mutation_subject",
        "subject_version": 1,
        "actor": actor,
        "operation": operation,
        "target": target,
        "key_id": key_id,
        "timestamp": timestamp or now_iso(),
        "nonce": nonce or base64.urlsafe_b64encode(os.urandom(12)).decode("ascii").rstrip("="),
        "payload_digest": remote_request_payload_digest(payload),
        "idempotency_key": payload.get("idempotency_key") or None,
    }
    signature["subject_digest"] = remote_request_subject_digest(signature)
    signature["signature"] = request_signature_digest(signature, key)
    return signature


def request_signature_for_args(
    args: argparse.Namespace,
    operation: str,
    actor: str,
    target: str,
    payload: dict[str, Any],
) -> dict[str, Any] | None:
    existing = getattr(args, "request_signature", None)
    if existing is not None:
        return existing
    key = os.environ.get("CODEFIRE_REQUEST_SIGNING_KEY", "")
    if not key:
        return None
    return sign_remote_request(
        operation,
        actor,
        target,
        payload,
        request_key_id_from_args(args, actor),
        key,
    )


def attach_request_signature(payload: dict[str, Any], args: argparse.Namespace, operation: str, target: str) -> None:
    actor = str(payload.get("actor") or actor_from_args(args))
    signature = request_signature_for_args(args, operation, actor, target, payload)
    if signature is not None:
        payload["request_signature"] = signature


def remote_request_target(info: dict[str, Any], operation: str, branch: str | None = None, mr_id: str | None = None) -> str:
    if operation == "upload":
        return f"{info['org']}/{info['app']}/branches/{branch or info.get('branch')}/upload"
    if operation == "request_merge":
        return f"{info['org']}/{info['app']}/merge-requests"
    if operation == "review":
        return f"{info['org']}/{info['app']}/merge-requests/{mr_id}/review"
    if operation == "apply":
        return f"{info['org']}/{info['app']}/merge-requests/{mr_id}/apply"
    if operation == "gc":
        return f"{info['org']}/{info['app']}/gc"
    return f"{info['org']}/{info['app']}/{operation}"


def verify_remote_request_signature(
    project_root: Path,
    operation: str,
    actor: str,
    target: str,
    payload: dict[str, Any],
    signature: Any,
    *,
    defer_nonce: bool = False,
) -> tuple[dict[str, Any], float, int] | None:
    policy = read_json(remote_policy_path(project_root), {})
    if not isinstance(policy, dict):
        raise CFError("request signature validation failed: server policy must be an object")
    request_policy = policy.get("request_signatures")
    if request_policy is None:
        if signature is None:
            return None
        raise CFError("request signature validation failed: request_signatures policy must be an object")
    if not isinstance(request_policy, dict):
        raise CFError("request signature validation failed: request_signatures policy must be an object")
    required_value = request_policy.get("required", False)
    if not isinstance(required_value, bool):
        raise CFError("request signature validation failed: request_signatures.required must be a boolean")
    required = required_value
    if signature is None:
        if required:
            raise CFError("request signature validation failed: signature is required")
        return None
    if not isinstance(signature, dict):
        raise CFError("request signature validation failed: signature must be an object")
    if signature.get("type") != "remote_request_signature":
        raise CFError("request signature validation failed: signature type is invalid")
    if signature.get("version") != 2:
        raise CFError("request signature validation failed: signature version must be 2 (payload-bound subject)")
    if signature.get("subject_type") != "codefire_remote_mutation_subject" or signature.get("subject_version") != 1:
        raise CFError("request signature validation failed: signature subject type/version is invalid")
    if signature.get("algorithm") != "hmac-sha256":
        raise CFError("request signature validation failed: unsupported signature algorithm")
    if signature.get("actor") != actor:
        raise CFError("request signature validation failed: actor mismatch")
    if signature.get("operation") != operation:
        raise CFError("request signature validation failed: operation mismatch")
    if signature.get("target") != target:
        raise CFError("request signature validation failed: target mismatch")
    timestamp = signature.get("timestamp")
    if not isinstance(timestamp, str):
        raise CFError("request signature validation failed: timestamp is required")
    nonce = signature.get("nonce")
    if not isinstance(nonce, str) or not nonce:
        raise CFError("request signature validation failed: nonce is required")
    max_skew = request_policy["max_skew_seconds"] if "max_skew_seconds" in request_policy else 300
    if isinstance(max_skew, bool) or not isinstance(max_skew, (int, float)):
        raise CFError("request signature validation failed: max_skew_seconds must be a number")
    skew_seconds = float(max_skew)
    if not math.isfinite(skew_seconds):
        raise CFError("request signature validation failed: max_skew_seconds must be a number")
    if skew_seconds < 0:
        raise CFError("request signature validation failed: max_skew_seconds must be non-negative")
    if abs(time.time() - parse_iso_seconds(timestamp)) > skew_seconds:
        raise CFError("request signature validation failed: timestamp is outside allowed skew")
    payload_digest = signature.get("payload_digest")
    if payload_digest != remote_request_payload_digest(payload):
        raise CFError("request signature validation failed: payload digest mismatch")
    if signature.get("idempotency_key") != (payload.get("idempotency_key") or None):
        raise CFError("request signature validation failed: idempotency key mismatch")
    subject_digest = signature.get("subject_digest")
    if subject_digest != remote_request_subject_digest(signature):
        raise CFError("request signature validation failed: subject digest is invalid")
    digest = signature.get("signature")
    if not isinstance(digest, str) or not re.fullmatch(r"[0-9a-f]{64}", digest):
        raise CFError("request signature validation failed: signature digest is invalid")
    keys = request_policy.get("keys", {})
    if not isinstance(keys, dict):
        raise CFError("request signature validation failed: request_signatures.keys must be an object")
    key_id = signature.get("key_id", actor)
    key_entry = keys.get(key_id) or keys.get(actor) or keys.get("*")
    key = hmac_policy_secret(key_entry, actor, "request signature validation failed")
    if isinstance(key_entry, dict):
        signed_at = parse_iso_seconds(timestamp)
        not_before = (
            key_entry.get("not_before")
            if "not_before" in key_entry
            else key_entry.get("valid_from")
        )
        not_after = (
            key_entry.get("not_after")
            if "not_after" in key_entry
            else key_entry.get("valid_until")
        )
        if not_before is not None:
            if not isinstance(not_before, str):
                raise CFError(
                    "request signature validation failed: not_before must be UTC seconds ending in Z"
                )
            if signed_at < parse_iso_seconds(not_before):
                raise CFError("request signature validation failed: key is not valid yet")
        if not_after is not None:
            if not isinstance(not_after, str):
                raise CFError(
                    "request signature validation failed: not_after must be UTC seconds ending in Z"
                )
            if signed_at > parse_iso_seconds(not_after):
                raise CFError("request signature validation failed: key is expired")
    expected = request_signature_digest(signature, key)
    if not hmac.compare_digest(expected, digest):
        raise CFError("request signature validation failed: invalid signature")
    if request_policy.get("nonce_cache", True) is not False:
        ttl_value = request_policy.get("nonce_ttl_seconds", skew_seconds)
        if isinstance(ttl_value, bool) or not isinstance(ttl_value, (int, float)):
            raise CFError("request signature validation failed: nonce_ttl_seconds must be a number")
        ttl_seconds = float(ttl_value)
        if not math.isfinite(ttl_seconds):
            raise CFError("request signature validation failed: nonce_ttl_seconds must be a number")
        if ttl_seconds <= 0:
            raise CFError("request signature validation failed: nonce_ttl_seconds must be positive")
        max_entries_value = request_policy.get("max_nonce_cache_entries", 10_000)
        if isinstance(max_entries_value, bool) or not isinstance(max_entries_value, int):
            raise CFError(
                "request signature validation failed: max_nonce_cache_entries must be a positive integer"
            )
        max_entries = max_entries_value
        if max_entries <= 0:
            raise CFError(
                "request signature validation failed: max_nonce_cache_entries must be a positive integer"
            )
        if defer_nonce:
            # Preserve replay/capacity/malformed-cache precedence without
            # publishing the nonce before mutation response preflight.
            try:
                request_nonce_cache_postimage(
                    project_root,
                    signature,
                    ttl_seconds,
                    max_entries,
                    time.time(),
                )
            except CFError as error:
                if not (
                    str(error)
                    == "request signature validation failed: nonce has already been used"
                    and operation == "upload"
                    and remote_publication_recovery_exists(
                        project_root,
                        "remote_upload",
                        actor,
                        payload.get("idempotency_key") or None,
                    )
                ):
                    raise
                # A matching pending transaction or receipt owns replay
                # precedence. Its stored request hash still rejects an
                # unrelated attempt before any new authority write.
                return None
            return signature, ttl_seconds, max_entries
        record_request_nonce(project_root, signature, ttl_seconds, max_entries)
    return None


def commit_signature_metadata(signature: dict[str, Any]) -> dict[str, Any]:
    return {k: v for k, v in signature.items() if k != "signature"}


def unsigned_commit_payload(commit: dict[str, Any]) -> dict[str, Any]:
    unsigned = json.loads(json.dumps(commit))
    unsigned.pop("signature", None)
    return unsigned


def commit_signature_input(commit: dict[str, Any], signature: dict[str, Any]) -> bytes:
    return canonical_json(
        {
            "commit": unsigned_commit_payload(commit),
            "signature": commit_signature_metadata(signature),
        }
    )


def commit_signature_digest(commit: dict[str, Any], signature: dict[str, Any], key: str) -> str:
    return hmac.new(key.encode("utf-8"), commit_signature_input(commit, signature), hashlib.sha256).hexdigest()


def sign_commit_payload(commit: dict[str, Any], signer: str, key: str, key_id: str | None = None) -> dict[str, Any]:
    signed = json.loads(json.dumps(commit))
    signature = {
        "type": "commit_signature",
        "version": VERSION,
        "algorithm": "hmac-sha256",
        "signer": signer,
        "key_id": key_id or signer,
        "signed_at": now_iso(),
    }
    signature["signature"] = commit_signature_digest(signed, signature, key)
    signed["signature"] = signature
    return signed


def validate_commit_signature_structure(commit: dict[str, Any], required: bool = False) -> dict[str, Any] | None:
    signature = commit.get("signature")
    if signature is None:
        if required:
            raise CFError("commit signature validation failed: signature is required")
        return None
    if not isinstance(signature, dict):
        raise CFError("commit signature validation failed: signature must be an object")
    if signature.get("type") != "commit_signature":
        raise CFError("commit signature validation failed: signature type is invalid")
    if signature.get("algorithm") != "hmac-sha256":
        raise CFError("commit signature validation failed: unsupported signature algorithm")
    signer = signature.get("signer")
    key_id = signature.get("key_id", signer)
    digest = signature.get("signature")
    if not isinstance(signer, str) or not signer:
        raise CFError("commit signature validation failed: signer is required")
    if not isinstance(key_id, str) or not key_id:
        raise CFError("commit signature validation failed: key_id is required")
    if not isinstance(digest, str) or not re.fullmatch(r"[0-9a-f]{64}", digest):
        raise CFError("commit signature validation failed: signature digest is invalid")
    return signature


def signature_time_in_range(signed_at: Any, key_entry: dict[str, Any]) -> None:
    if not isinstance(signed_at, str) or not signed_at:
        raise CFError("commit signature validation failed: signed_at is required")
    not_before = key_entry.get("not_before") or key_entry.get("valid_from")
    not_after = key_entry.get("not_after") or key_entry.get("valid_until")
    if isinstance(not_before, str) and signed_at < not_before:
        raise CFError("commit signature validation failed: key is not valid yet")
    if isinstance(not_after, str) and signed_at > not_after:
        raise CFError("commit signature validation failed: key is expired")


def signature_key_secret(signature: dict[str, Any], keys: dict[str, Any]) -> str:
    signer = signature.get("signer")
    key_id = signature.get("key_id", signer)
    key_entry = keys.get(key_id) or keys.get(signer) or keys.get("*")
    if isinstance(key_entry, str):
        return key_entry
    if not isinstance(key_entry, dict):
        raise CFError(f"commit signature validation failed: no key for signer '{signer}'")
    status = str(key_entry.get("status", "active")).lower()
    if status in {"revoked", "disabled"} or key_entry.get("revoked") is True:
        raise CFError("commit signature validation failed: key is revoked")
    if key_entry.get("active") is False:
        raise CFError("commit signature validation failed: key is inactive")
    allowed_signers = key_entry.get("signers")
    if isinstance(allowed_signers, str):
        allowed_signers = [allowed_signers]
    if allowed_signers is not None and not ("*" in allowed_signers or signer in allowed_signers):
        raise CFError(f"commit signature validation failed: key is not allowed for signer '{signer}'")
    signature_time_in_range(signature.get("signed_at"), key_entry)
    secret = key_entry.get("secret") or key_entry.get("key")
    if not isinstance(secret, str) or not secret:
        raise CFError("commit signature validation failed: key secret is missing")
    return secret


def verify_commit_signature(commit: dict[str, Any], keys: dict[str, Any], required: bool = False) -> None:
    signature = validate_commit_signature_structure(commit, required=required)
    if signature is None:
        return
    key = signature_key_secret(signature, keys)
    expected = commit_signature_digest(commit, signature, key)
    if not hmac.compare_digest(expected, signature["signature"]):
        raise CFError("commit signature validation failed: invalid signature")


def _detach_exception_chain(error: BaseException) -> None:
    """Destructively drop every traceback/cause/context without side storage."""
    current: BaseException | None = error
    while current is not None:
        next_error = current.__cause__ or current.__context__
        current.__traceback__ = None
        current.__cause__ = None
        current.__context__ = None
        current = next_error


class _StablePermitTransition:
    """Durably own permit acquisitions across post-commit Python faults."""

    __slots__ = (
        "_ledger",
        "_permit",
        "_prev",
        "_next",
        "_linked",
        "_baseline_retained",
        "_baseline_temporary",
        "_expected_retained",
        "_expected_temporary",
        "_retained_primary",
        "_retained_secondary",
        "_retained_total",
        "_temporary",
        "_retained_acquired",
        "_temporary_acquired",
        "_acquires_resolved",
        "_retained_primary_released",
        "_retained_secondary_released",
        "_temporary_released",
    )

    def __init__(
        self,
        ledger: DecisionWorkLedger,
        *,
        retained_primary: int = 0,
        retained_secondary: int = 0,
        temporary: int = 0,
    ) -> None:
        self._ledger = ledger
        self._permit: DecisionWorkPermit | None = None
        self._prev: _StablePermitTransition | None = None
        self._next: _StablePermitTransition | None = None
        self._linked = False
        self._baseline_retained = ledger._current.get("retained_bytes", 0)
        self._baseline_temporary = ledger._current.get("temporary_bytes", 0)
        self._retained_primary = retained_primary
        self._retained_secondary = retained_secondary
        self._retained_total = retained_primary + retained_secondary
        self._temporary = temporary
        self._expected_retained = self._baseline_retained + self._retained_total
        self._expected_temporary = self._baseline_temporary + temporary
        self._retained_acquired = False
        self._temporary_acquired = False
        self._acquires_resolved = False
        self._retained_primary_released = retained_primary == 0
        self._retained_secondary_released = retained_secondary == 0
        self._temporary_released = temporary == 0

    def bind(self, permit: DecisionWorkPermit) -> None:
        if self._permit is not None:
            raise CFError("decision-work transition already owns a permit")
        self._permit = permit

    def reserve(self, phase: str, **upper: Any) -> None:
        """Publish ownership before asking the ledger to register the permit."""
        permit = DecisionWorkPermit()
        self.bind(permit)
        failure = None
        try:
            self._ledger.reserve_into(permit, phase, **upper)
        except BaseException as error:
            failure = error
        if permit in self._ledger._reserved:
            if failure is not None:
                _detach_exception_chain(failure)
            return
        self._permit = None
        self._acquires_resolved = True
        self._retained_primary_released = True
        self._retained_secondary_released = True
        self._temporary_released = True
        if failure is not None:
            raise failure
        raise CFError("decision-work reserve_into did not register its caller-owned permit")

    @property
    def permit(self) -> DecisionWorkPermit:
        if self._permit is None:
            raise CFError("decision-work transition has no permit")
        return self._permit

    def _open_reservation(self) -> dict[str, Any] | None:
        if self._permit is None:
            return None
        return self._ledger._reserved.get(self._permit)

    def _reconcile_acquires(self) -> bool:
        if self._acquires_resolved:
            return self._retained_acquired or self._temporary_acquired
        committed = False
        if self._retained_total and not self._retained_acquired:
            observed = self._ledger._current.get("retained_bytes", 0)
            if observed == self._expected_retained:
                self._retained_acquired = True
                committed = True
            elif observed != self._baseline_retained:
                raise CFError(
                    "decision-work retained transition changed outside its upper bound"
                )
        if self._temporary and not self._temporary_acquired:
            observed = self._ledger._current.get("temporary_bytes", 0)
            if observed == self._expected_temporary:
                self._temporary_acquired = True
                committed = True
            elif observed != self._baseline_temporary:
                raise CFError(
                    "decision-work temporary transition changed outside its upper bound"
                )
        if not self._retained_acquired:
            self._retained_primary_released = True
            self._retained_secondary_released = True
        if not self._temporary_acquired:
            self._temporary_released = True
        self._acquires_resolved = True
        return committed

    def consume(self, **actual: Any) -> None:
        permit = self.permit
        before = self._open_reservation()
        before_snapshot = None if before is None else {
            field: dict(before[field])
            if field in {"charges", "maxima", "acquires", "counters"}
            else before[field]
            for field in before
        }
        failure = None
        try:
            self._ledger.consume_reserved(permit, **actual)
        except BaseException as error:
            failure = error
        acquired = self._reconcile_acquires()
        after = self._open_reservation()
        committed = acquired or after is not before or after != before_snapshot
        if after is None:
            self._permit = None
        if failure is not None:
            if not committed:
                raise failure
            _detach_exception_chain(failure)

    def _release_component(
        self,
        dimension: str,
        amount: int,
        acquired_attribute: str,
        released_attribute: str,
    ) -> None:
        if getattr(self, released_attribute):
            return
        if not getattr(self, acquired_attribute):
            self._reconcile_acquires()
        if not getattr(self, acquired_attribute):
            return
        before = self._ledger._current.get(dimension, 0)
        expected_after = before - amount
        failure = None
        try:
            self._ledger.release(dimension, amount)
        except BaseException as error:
            failure = error
        after = self._ledger._current.get(dimension, 0)
        committed = after == expected_after
        if committed:
            object.__setattr__(self, released_attribute, True)
        if failure is not None:
            if not committed:
                raise failure
            _detach_exception_chain(failure)
        elif not committed:
            raise CFError(
                f"decision-work {dimension} release returned without committing"
            )

    def release_retained_primary(self) -> None:
        self._release_component(
            "retained_bytes",
            self._retained_primary,
            "_retained_acquired",
            "_retained_primary_released",
        )

    def shrink_retained_primary(self, retained_primary: int) -> None:
        """Reconcile a preflight retained upper to one exact owned scalar."""
        if (
            isinstance(retained_primary, bool)
            or not isinstance(retained_primary, int)
            or retained_primary < 0
            or retained_primary > self._retained_primary
        ):
            raise CFError("decision-work retained reconciliation is invalid")
        if self._retained_secondary:
            raise CFError(
                "decision-work retained reconciliation requires one scalar"
            )
        if self._retained_primary_released:
            raise CFError("decision-work retained scalar is already released")
        if not self._retained_acquired:
            self._reconcile_acquires()
        if not self._retained_acquired:
            raise CFError("decision-work retained scalar was not acquired")
        difference = self._retained_primary - retained_primary
        if difference:
            before = self._ledger._current.get("retained_bytes", 0)
            expected_after = before - difference
            failure = None
            try:
                self._ledger.release("retained_bytes", difference)
            except BaseException as error:
                failure = error
            after = self._ledger._current.get("retained_bytes", 0)
            committed = after == expected_after
            if not committed:
                if failure is not None:
                    raise failure
                raise CFError(
                    "decision-work retained reconciliation did not commit"
                )
            if failure is not None:
                _detach_exception_chain(failure)
        self._retained_primary = retained_primary
        self._retained_total = retained_primary
        self._expected_retained = self._baseline_retained + retained_primary
        self._retained_primary_released = retained_primary == 0

    def release_temporary(self) -> None:
        self._release_component(
            "temporary_bytes",
            self._temporary,
            "_temporary_acquired",
            "_temporary_released",
        )

    def release_all(self) -> None:
        self.cancel()
        self.release_temporary()
        self.release_retained_primary()
        self._release_component(
            "retained_bytes",
            self._retained_secondary,
            "_retained_acquired",
            "_retained_secondary_released",
        )

    def cancel(self) -> None:
        if self._permit is None:
            return
        permit = self._permit
        if permit not in self._ledger._reserved:
            self._reconcile_acquires()
            self._permit = None
            return
        failure = None
        try:
            self._ledger.cancel_permit(permit)
        except BaseException as error:
            failure = error
        if permit not in self._ledger._reserved:
            self._reconcile_acquires()
            self._permit = None
            if failure is not None:
                _detach_exception_chain(failure)
            return
        if failure is not None:
            raise failure


class SignaturePolicySubjectChanged(CFError):
    """The pinned remote signature-policy authority no longer matches."""

    def __init__(self, path: Path, reason: str) -> None:
        self.path = path
        self.reason = reason
        super().__init__(
            f"commit signature policy authority changed: {path}: {reason}"
        )


class AccountedRemoteSignaturePolicyAuthority:
    """Own one pinned raw remote signature-policy subject.

    Raw policy bytes never leave this owner directly.  ``prepare_policy``
    constructs exactly one child ``AccountedCommitSignaturePolicy`` that
    borrows the immutable bytes.  Closing this authority closes that child
    before dropping the raw subject or releasing this owner's accounting.
    """

    CAPABILITY_RETAINED_BASE_BYTES = 4096
    CAPABILITY_RETAINED_COMPONENT_BYTES = 512
    CAPABILITY_TEMPORARY_BASE_BYTES = 64 * 1024
    POLICY_RETAINED_BASE_BYTES = 4096
    POLICY_TEMPORARY_BASE_BYTES = 64 * 1024
    READ_CHUNK_BYTES = 64 * 1024
    PATH_PREFLIGHT_TEMPORARY_BYTES = 64 * 1024
    EMPTY_POLICY_RAW = b"{}"
    CLOSE_CAPABILITY = staticmethod(os.close)

    def __init__(
        self,
        project_root: Path,
        ledger: DecisionWorkLedger,
        deadline: HTTPRequestDeadline | None = None,
    ) -> None:
        self._ledger = ledger
        self._ledger_identity = id(ledger)
        self._deadline = deadline
        self._project_root: Path | None = None
        self._prefix_path: Path | None = None
        self._prefix_fd = -1
        self._prefix_fingerprint: tuple[int, ...] | None = None
        self._missing_parts: tuple[str, ...] = ()
        self._project_fd = -1
        self._project_fingerprint: tuple[int, ...] | None = None
        self._policy_fd = -1
        self._policy_fingerprint: tuple[int, ...] | None = None
        self._policy_raw: bytes | None = None
        self._policy_digest: bytes | None = None
        self._policy_missing = False
        self._policy_bound = False
        self._policy_owner: AccountedCommitSignaturePolicy | None = None
        self._verification_bound = False
        self._verification_handoff_open = False
        self._verification_constructing = False
        self._verification_owner: AccountedServerVerification | None = None
        self._upload_terminal_owner: Any | None = None
        self._revalidated = False
        self._closed = False
        self._walk_fd = -1
        self._next_fd = -1
        self._path_transition: _StablePermitTransition | None = None
        self._capability_transition: _StablePermitTransition | None = None
        self._policy_transition: _StablePermitTransition | None = None
        failure: BaseException | None = None
        try:
            path_transition = _StablePermitTransition(
                ledger, temporary=self.PATH_PREFLIGHT_TEMPORARY_BYTES
            )
            self._path_transition = path_transition
            path_transition.reserve(
                "record_read",
                acquires={
                    "temporary_bytes": self.PATH_PREFLIGHT_TEMPORARY_BYTES
                },
            )
            path_transition.consume(
                phase="record_read",
                acquires={
                    "temporary_bytes": self.PATH_PREFLIGHT_TEMPORARY_BYTES
                },
            )
            self._project_root = Path(os.path.abspath(project_root))
            self._prepare()
        except BaseException as error:
            _detach_exception_chain(error)
            failure = error
        if failure is not None:
            cleanup_failure: BaseException | None = None
            try:
                self.close()
            except BaseException as error:
                _detach_exception_chain(error)
                cleanup_failure = error
            if cleanup_failure is not None:
                raise cleanup_failure from failure
            raise failure from None

    @staticmethod
    def _fingerprint(metadata: os.stat_result) -> tuple[int, ...]:
        return (
            metadata.st_mode,
            metadata.st_dev,
            metadata.st_ino,
            metadata.st_nlink,
            metadata.st_size,
            metadata.st_mtime_ns,
            metadata.st_ctime_ns,
        )

    @classmethod
    def capability_upper(cls, project_root: Path) -> tuple[int, int]:
        absolute = Path(os.path.abspath(project_root))
        path_bytes = len(os.fsencode(absolute))
        components = max(len(absolute.parts) - 1, 1)
        retained = (
            cls.CAPABILITY_RETAINED_BASE_BYTES
            + cls.CAPABILITY_RETAINED_COMPONENT_BYTES * (components + 2)
            + path_bytes
        )
        capability_temporary = (
            cls.CAPABILITY_TEMPORARY_BASE_BYTES + 4 * path_bytes
        )
        # Path normalization remains live until the exact component-walk
        # capability reservation has committed.
        temporary = cls.PATH_PREFLIGHT_TEMPORARY_BYTES + capability_temporary
        return retained, temporary

    @classmethod
    def policy_upper(cls, physical_bytes: int) -> tuple[int, int]:
        if (
            isinstance(physical_bytes, bool)
            or not isinstance(physical_bytes, int)
            or physical_bytes < 0
        ):
            raise CFError("commit signature policy byte upper must be nonnegative")
        retained = cls.POLICY_RETAINED_BASE_BYTES + physical_bytes
        temporary = cls.POLICY_TEMPORARY_BASE_BYTES + 2 * physical_bytes
        if retained > U64_MAX or temporary > U64_MAX:
            raise CFError("commit signature policy authority upper overflows u64")
        return retained, temporary

    def _ensure_open(self, ledger: DecisionWorkLedger | None = None) -> None:
        selected = self._ledger if ledger is None else ledger
        if id(selected) != self._ledger_identity:
            raise CFError(
                "commit signature policy authority belongs to a different ledger"
            )
        if self._closed:
            raise CFError("commit signature policy authority is closed")

    def _poll(self, phase: str) -> None:
        if self._deadline is not None:
            self._deadline.check(phase)

    def _open_subject(self) -> None:
        absolute = self._project_root
        if absolute is None:
            raise CFError("commit signature project authority is unavailable")
        parts = absolute.parts[1:]
        flags = os.O_RDONLY | getattr(os, "O_DIRECTORY", 0) | getattr(
            os, "O_NOFOLLOW", 0
        )
        current_path = Path(os.sep)
        try:
            self._walk_fd = os.open(os.sep, flags)
            for index, component in enumerate(parts):
                self._poll("commit signature policy authority")
                try:
                    self._next_fd = os.open(
                        component, flags, dir_fd=self._walk_fd
                    )
                except FileNotFoundError:
                    self._prefix_fd = self._walk_fd
                    self._walk_fd = -1
                    self._prefix_path = current_path
                    self._prefix_fingerprint = self._fingerprint(
                        os.fstat(self._prefix_fd)
                    )
                    self._missing_parts = tuple(parts[index:])
                    return
                if index + 1 == len(parts):
                    self._prefix_fd = self._walk_fd
                    self._walk_fd = -1
                    self._prefix_path = current_path
                    self._prefix_fingerprint = self._fingerprint(
                        os.fstat(self._prefix_fd)
                    )
                    self._project_fd = self._next_fd
                    self._next_fd = -1
                    named = os.stat(
                        component,
                        dir_fd=self._prefix_fd,
                        follow_symlinks=False,
                    )
                    opened = os.fstat(self._project_fd)
                    if (
                        not stat.S_ISDIR(opened.st_mode)
                        or self._fingerprint(named) != self._fingerprint(opened)
                    ):
                        raise SignaturePolicySubjectChanged(
                            absolute, "project_identity"
                        )
                    self._project_fingerprint = self._fingerprint(opened)
                    return
                descriptor = self._walk_fd
                self._walk_fd = -1
                self.CLOSE_CAPABILITY(descriptor)
                self._walk_fd = self._next_fd
                self._next_fd = -1
                current_path /= component
            raise CFError("commit signature policy project root cannot be filesystem root")
        finally:
            first_failure: BaseException | None = None
            for attribute in ("_walk_fd", "_next_fd"):
                try:
                    self._close_capability(attribute)
                except BaseException as error:
                    if first_failure is None:
                        first_failure = error
            if first_failure is not None:
                raise first_failure

    def _open_absolute_directory(self, path: Path) -> int:
        """Open one absolute directory without retrying detached FD numbers."""
        flags = os.O_RDONLY | getattr(os, "O_DIRECTORY", 0) | getattr(
            os, "O_NOFOLLOW", 0
        )
        walk_fd = -1
        next_fd = -1
        try:
            walk_fd = os.open(os.sep, flags)
            for component in path.parts[1:]:
                next_fd = os.open(component, flags, dir_fd=walk_fd)
                descriptor = walk_fd
                walk_fd = -1
                self.CLOSE_CAPABILITY(descriptor)
                walk_fd = next_fd
                next_fd = -1
            result = walk_fd
            walk_fd = -1
            return result
        finally:
            first_failure: BaseException | None = None
            for descriptor in (walk_fd, next_fd):
                if descriptor < 0:
                    continue
                try:
                    self.CLOSE_CAPABILITY(descriptor)
                except BaseException as error:
                    if first_failure is None:
                        first_failure = error
            if first_failure is not None:
                raise first_failure

    @staticmethod
    def _safe_policy_metadata(metadata: os.stat_result) -> bool:
        return (
            stat.S_ISREG(metadata.st_mode)
            and metadata.st_nlink == 1
            and 0 <= metadata.st_size <= MAX_OBJECT_RECORD_BYTES
        )

    def _adopt_empty_policy(self) -> None:
        retained, _ = self.policy_upper(len(self.EMPTY_POLICY_RAW))
        transition = _StablePermitTransition(
            self._ledger, retained_primary=retained
        )
        self._policy_transition = transition
        transition.reserve(
            "record_read", acquires={"retained_bytes": retained}
        )
        transition.consume(
            phase="record_read", acquires={"retained_bytes": retained}
        )
        self._policy_raw = self.EMPTY_POLICY_RAW

    def _read_exact_policy(self, descriptor: int, physical_bytes: int) -> bytes:
        raw = bytearray()
        try:
            while len(raw) < physical_bytes:
                self._poll("commit signature policy authority read")
                chunk = os.read(
                    descriptor,
                    min(self.READ_CHUNK_BYTES, physical_bytes - len(raw)),
                )
                if not chunk:
                    break
                raw.extend(chunk)
            extension = os.read(descriptor, 1)
            if len(raw) != physical_bytes or extension:
                raise SignaturePolicySubjectChanged(
                    remote_policy_path(self._project_root), "size_changed"
                )
            return bytes(raw)
        finally:
            raw.clear()

    def _read_policy(self) -> None:
        project_root = self._project_root
        if project_root is None:
            raise CFError("commit signature project authority is unavailable")
        if self._project_fd < 0:
            self._policy_missing = True
            self._adopt_empty_policy()
            return
        policy_path = remote_policy_path(project_root)
        try:
            initial = os.stat(
                policy_path.name,
                dir_fd=self._project_fd,
                follow_symlinks=False,
            )
        except FileNotFoundError:
            self._policy_missing = True
            self._adopt_empty_policy()
            return
        if not self._safe_policy_metadata(initial):
            raise CFError(
                f"commit signature policy authority is unsafe: {policy_path}"
            )
        physical_bytes = initial.st_size
        retained, temporary = self.policy_upper(physical_bytes)
        transition = _StablePermitTransition(
            self._ledger,
            retained_primary=retained,
            temporary=temporary,
        )
        self._policy_transition = transition
        transition.reserve(
            "record_read",
            charges={"aggregate_bytes": 2 * physical_bytes},
            acquires={
                "retained_bytes": retained,
                "temporary_bytes": temporary,
            },
            counters={
                "files_read": 2,
                "file_bytes_read": 2 * physical_bytes,
            },
        )
        transition.consume(
            phase="record_read",
            charges={"aggregate_bytes": physical_bytes},
            acquires={
                "retained_bytes": retained,
                "temporary_bytes": temporary,
            },
            counters={"files_read": 1, "file_bytes_read": physical_bytes},
        )
        descriptor = -1
        try:
            descriptor = os.open(
                policy_path.name,
                os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0),
                dir_fd=self._project_fd,
            )
            opened = os.fstat(descriptor)
            expected = self._fingerprint(initial)
            if (
                not self._safe_policy_metadata(opened)
                or self._fingerprint(opened) != expected
            ):
                raise SignaturePolicySubjectChanged(
                    policy_path, "initial_identity"
                )
            raw = self._read_exact_policy(descriptor, physical_bytes)
            after = os.fstat(descriptor)
            named = os.stat(
                policy_path.name,
                dir_fd=self._project_fd,
                follow_symlinks=False,
            )
            if any(
                not self._safe_policy_metadata(metadata)
                or self._fingerprint(metadata) != expected
                for metadata in (after, named)
            ):
                raise SignaturePolicySubjectChanged(
                    policy_path, "initial_final_identity"
                )
            self._policy_fd = descriptor
            descriptor = -1
            self._policy_fingerprint = expected
            self._policy_raw = raw
            self._policy_digest = hashlib.sha256(raw).digest()
        finally:
            if descriptor >= 0:
                self.CLOSE_CAPABILITY(descriptor)

    def _prepare(self) -> None:
        project_root = self._project_root
        if project_root is None:
            raise CFError("commit signature project authority is unavailable")
        retained, total_temporary = self.capability_upper(project_root)
        temporary = total_temporary - self.PATH_PREFLIGHT_TEMPORARY_BYTES
        transition = _StablePermitTransition(
            self._ledger,
            retained_primary=retained,
            temporary=temporary,
        )
        self._capability_transition = transition
        transition.reserve(
            "record_read",
            acquires={
                "retained_bytes": retained,
                "temporary_bytes": temporary,
            },
        )
        transition.consume(
            phase="record_read",
            acquires={
                "retained_bytes": retained,
                "temporary_bytes": temporary,
            },
        )
        if self._path_transition is not None:
            self._path_transition.release_temporary()
        self._open_subject()
        self._read_policy()

    def _ensure_upload_terminal_access(self, owner: Any | None) -> None:
        ledger_bound = self._ledger._upload_terminal_owner
        bound = self._upload_terminal_owner
        if (
            ledger_bound is not None
            and ledger_bound is not owner
            and getattr(ledger_bound, "_policy_authority", None) is self
        ):
            raise CFError("upload terminal composite owns policy authority")
        if bound is not None and bound is not owner:
            raise CFError("upload terminal composite owns policy authority")

    def prepare_policy(
        self,
        loader: Any,
        ledger: DecisionWorkLedger | None = None,
        *,
        _upload_terminal_owner: Any | None = None,
    ) -> "AccountedCommitSignaturePolicy":
        self._ensure_open(ledger)
        self._ensure_upload_terminal_access(_upload_terminal_owner)
        if self._policy_bound:
            raise CFError("commit signature policy authority is single-use")
        raw = self._policy_raw
        if raw is None:
            raise CFError("commit signature policy authority has no raw policy")
        self._policy_bound = True
        failure: BaseException | None = None
        try:
            owner = AccountedCommitSignaturePolicy(
                raw, self._ledger, loader, self._deadline
            )
        except json.JSONDecodeError as error:
            message = (
                "commit signature policy JSON is invalid: "
                f"{error.msg}: line {error.lineno} column {error.colno}"
            )
            _detach_exception_chain(error)
            raw = None
            failure = CFError(message)
        except UnicodeDecodeError as error:
            message = (
                "commit signature policy UTF-8 is invalid: "
                f"byte {error.start}: {error.reason}"
            )
            _detach_exception_chain(error)
            raw = None
            failure = CFError(message)
        except BaseException as error:
            _detach_exception_chain(error)
            raw = None
            failure = error
        if failure is not None:
            raise failure.with_traceback(None) from None
        self._policy_owner = owner
        raw = None
        return owner

    def prepare_verified_server_verification(
        self,
        loader: Any,
        branch: str,
        commit_id: str,
        ledger: DecisionWorkLedger | None = None,
        *,
        output_limit_bytes: int = 1024 * 1024,
        allow_missing_project: bool = False,
    ) -> "AccountedServerVerification":
        """Verify the signature, then lend the exact snapshot to verification.

        This production-unwired handoff deliberately makes the two child
        lifetimes non-overlapping.  Signature parsing and verification retain
        their legacy first-error position; only after that child closes may a
        server-verification plan be derived from the already pinned raw bytes
        and duplicated project/policy capabilities.
        """
        owns_begin_cleanup = not (
            self._policy_bound or self._verification_bound
        )
        try:
            self._begin_verified_server_verification(branch, commit_id, ledger)
            return self._prepare_verified_server_verification_core(
                loader,
                branch,
                commit_id,
                output_limit_bytes=output_limit_bytes,
                allow_missing_project=allow_missing_project,
            )
        finally:
            if owns_begin_cleanup:
                object.__setattr__(
                    self, "_verification_handoff_open", False
                )
                object.__setattr__(
                    self, "_verification_constructing", False
                )

    def _begin_verified_server_verification(
        self,
        branch: str,
        commit_id: str,
        ledger: DecisionWorkLedger | None,
        *,
        _upload_terminal_owner: Any | None = None,
    ) -> None:
        self._ensure_open(ledger)
        self._ensure_upload_terminal_access(_upload_terminal_owner)
        if self._policy_bound or self._verification_bound:
            raise CFError("commit signature policy authority is single-use")
        if not isinstance(branch, str) or not isinstance(commit_id, str):
            raise CFError("server verification branch and commit must be strings")
        self._verification_bound = True
        self._verification_constructing = True

    def _prepare_verified_server_verification_core(
        self,
        loader: Any,
        branch: str,
        commit_id: str,
        *,
        output_limit_bytes: int,
        allow_missing_project: bool,
        close_loader: bool = False,
        _upload_terminal_owner: Any | None = None,
    ) -> "AccountedServerVerification":
        signature_owner = self.prepare_policy(
            loader,
            self._ledger,
            _upload_terminal_owner=_upload_terminal_owner,
        )
        signature_owner.verify(commit_id)
        signature_owner.close(self._ledger)
        self._policy_owner = None
        if close_loader:
            loader.close(self._ledger)
            if not isinstance(loader, _HTTPUploadSealedCommitBorrow):
                raise CFError(
                    "sealed signature handoff closed a foreign loader"
                )
            borrow_owner = object.__getattribute__(loader, "_owner")
            if (
                not isinstance(
                    borrow_owner, AccountedHTTPUploadSealedValidation
                )
                or object.__getattribute__(loader, "_token") != 0
                or object.__getattribute__(
                    borrow_owner, "_active_borrow_token"
                )
                != 0
            ):
                raise CFError(
                    "sealed signature handoff borrow release is incomplete"
                )
        project_root = self._project_root
        if project_root is None:
            raise CFError("commit signature project authority is unavailable")
        self._verification_handoff_open = True
        verification_owner = AccountedServerVerification(
            project_root,
            branch,
            commit_id,
            self._ledger,
            self._deadline,
            output_limit_bytes=output_limit_bytes,
            allow_missing_project=allow_missing_project,
            _signature_policy_authority=self,
        )
        self._verification_owner = verification_owner
        return verification_owner

    def _publish_verification_child(
        self, owner: "AccountedServerVerification"
    ) -> None:
        """Publish a partial child before its first fallible acquisition."""
        self._ensure_open(owner._ledger)
        if (
            not self._verification_bound
            or not self._verification_handoff_open
            or not self._verification_constructing
            or self._policy_owner is not None
            or self._verification_owner is not None
        ):
            raise CFError("server verification policy handoff is unavailable")
        terminal_owner = self._upload_terminal_owner
        if terminal_owner is not None and hasattr(
            terminal_owner, "_verification"
        ):
            if object.__getattribute__(terminal_owner, "_verification") is not None:
                raise CFError("upload terminal verification slot is occupied")
            # The top-level consumer owns cleanup before the child's first
            # fallible acquisition.  This survives constructor wrappers that
            # raise after publication but before returning the child.
            object.__setattr__(terminal_owner, "_verification", owner)
        self._verification_handoff_open = False
        self._verification_owner = owner

    def _revalidate_project(self) -> None:
        project_root = self._project_root
        if project_root is None:
            raise CFError("commit signature project authority is unavailable")
        prefix_path = self._prefix_path
        prefix_expected = self._prefix_fingerprint
        if prefix_path is None or prefix_expected is None or self._prefix_fd < 0:
            raise CFError("commit signature project authority is unavailable")
        ambient_prefix = -1
        ambient_project = -1
        try:
            ambient_prefix = self._open_absolute_directory(prefix_path)
            if (
                self._fingerprint(os.fstat(self._prefix_fd)) != prefix_expected
                or self._fingerprint(os.fstat(ambient_prefix)) != prefix_expected
            ):
                raise SignaturePolicySubjectChanged(
                    self._project_root, "project_parent"
                )
            if self._missing_parts:
                try:
                    os.stat(
                        self._missing_parts[0],
                        dir_fd=ambient_prefix,
                        follow_symlinks=False,
                    )
                except FileNotFoundError:
                    return
                raise SignaturePolicySubjectChanged(
                    self._project_root, "missing_project_appeared"
                )
            expected = self._project_fingerprint
            if expected is None or self._project_fd < 0:
                raise CFError("commit signature project authority is unavailable")
            leaf = project_root.name
            named = os.stat(leaf, dir_fd=ambient_prefix, follow_symlinks=False)
            flags = os.O_RDONLY | getattr(os, "O_DIRECTORY", 0) | getattr(
                os, "O_NOFOLLOW", 0
            )
            ambient_project = os.open(leaf, flags, dir_fd=ambient_prefix)
            if any(
                self._fingerprint(metadata) != expected
                for metadata in (
                    os.fstat(self._project_fd),
                    named,
                    os.fstat(ambient_project),
                )
            ):
                raise SignaturePolicySubjectChanged(
                    self._project_root, "project_identity"
                )
        except SignaturePolicySubjectChanged:
            raise
        except OSError as error:
            raise SignaturePolicySubjectChanged(
                self._project_root, "project_unavailable"
            ) from error
        finally:
            first_failure: BaseException | None = None
            for descriptor in (ambient_project, ambient_prefix):
                if descriptor < 0:
                    continue
                try:
                    self.CLOSE_CAPABILITY(descriptor)
                except BaseException as error:
                    if first_failure is None:
                        first_failure = error
            if first_failure is not None:
                raise first_failure

    def _revalidate_policy(self) -> None:
        project_root = self._project_root
        if project_root is None:
            raise CFError("commit signature project authority is unavailable")
        policy_path = remote_policy_path(project_root)
        if self._project_fd < 0:
            return
        if self._policy_missing:
            try:
                os.stat(
                    policy_path.name,
                    dir_fd=self._project_fd,
                    follow_symlinks=False,
                )
            except FileNotFoundError:
                return
            except OSError as error:
                raise SignaturePolicySubjectChanged(
                    policy_path, "missing_policy_unavailable"
                ) from error
            raise SignaturePolicySubjectChanged(
                policy_path, "missing_policy_appeared"
            )
        expected = self._policy_fingerprint
        raw_expected = self._policy_raw
        digest_expected = self._policy_digest
        transition = self._policy_transition
        if (
            expected is None
            or raw_expected is None
            or digest_expected is None
            or transition is None
            or self._policy_fd < 0
        ):
            raise CFError("commit signature policy fence is unavailable")
        descriptor = -1
        raw: bytes | None = None
        try:
            initial = os.stat(
                policy_path.name,
                dir_fd=self._project_fd,
                follow_symlinks=False,
            )
            descriptor = os.open(
                policy_path.name,
                os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0),
                dir_fd=self._project_fd,
            )
            opened = os.fstat(descriptor)
            if any(
                not self._safe_policy_metadata(metadata)
                or self._fingerprint(metadata) != expected
                for metadata in (
                    os.fstat(self._policy_fd),
                    initial,
                    opened,
                )
            ):
                raise SignaturePolicySubjectChanged(
                    policy_path, "final_identity"
                )
            physical_bytes = expected[4]
            transition.consume(
                phase="record_read",
                charges={"aggregate_bytes": physical_bytes},
                counters={
                    "files_read": 1,
                    "file_bytes_read": physical_bytes,
                },
            )
            raw = self._read_exact_policy(descriptor, physical_bytes)
            after = os.fstat(descriptor)
            named = os.stat(
                policy_path.name,
                dir_fd=self._project_fd,
                follow_symlinks=False,
            )
            if (
                any(
                    not self._safe_policy_metadata(metadata)
                    or self._fingerprint(metadata) != expected
                    for metadata in (after, named)
                )
                or hashlib.sha256(raw).digest() != digest_expected
                or raw != raw_expected
            ):
                raise SignaturePolicySubjectChanged(
                    policy_path, "final_content"
                )
            raw = None
            transition.release_temporary()
        except SignaturePolicySubjectChanged:
            raise
        except OSError as error:
            raise SignaturePolicySubjectChanged(
                policy_path, "final_unavailable"
            ) from error
        finally:
            raw = None
            raw_expected = None
            digest_expected = None
            if descriptor >= 0:
                self.CLOSE_CAPABILITY(descriptor)

    def revalidate(self, ledger: DecisionWorkLedger | None = None) -> None:
        self._ensure_open(ledger)
        self._ensure_upload_terminal_access(None)
        if self._verification_constructing:
            raise CFError("server verification child construction is in progress")
        if not self._policy_bound:
            raise CFError("commit signature policy authority has no bound policy")
        if self._revalidated:
            raise CFError("commit signature policy authority is single-use")
        verification_owner = self._verification_owner
        if verification_owner is not None and (
            not verification_owner._completed or not verification_owner._closed
        ):
            raise CFError(
                "server verification child must complete and close before "
                "the signature policy final fence"
            )
        self._poll("commit signature policy final fence")
        self._revalidate_project()
        self._revalidate_policy()
        # The policy read uses the retained project descriptor.  Repeat the
        # ambient project fence afterward so a path replacement during that
        # read cannot leave publication pointed at a different directory.
        self._revalidate_project()
        self._poll("commit signature policy final fence")
        if self._capability_transition is not None:
            self._capability_transition.release_temporary()
        self._revalidated = True

    @staticmethod
    def _transition_done(transition: _StablePermitTransition | None) -> bool:
        return transition is None or (
            transition._permit is None
            and transition._retained_primary_released
            and transition._retained_secondary_released
            and transition._temporary_released
        )

    def _close_capability(self, attribute: str) -> None:
        descriptor = getattr(self, attribute)
        if descriptor < 0:
            return
        setattr(self, attribute, -1)
        self.CLOSE_CAPABILITY(descriptor)

    def close(
        self,
        ledger: DecisionWorkLedger | None = None,
        *,
        _upload_terminal_owner: Any | None = None,
    ) -> None:
        self._ensure_upload_terminal_access(_upload_terminal_owner)
        if self._closed:
            selected = self._ledger if ledger is None else ledger
            if id(selected) != self._ledger_identity:
                raise CFError(
                    "commit signature policy authority belongs to a different ledger"
                )
            return
        self._ensure_open(ledger)
        if self._verification_constructing:
            raise CFError("server verification child construction is in progress")
        if self._verification_owner is not None:
            self._verification_owner.close()
        self._verification_owner = None
        if self._policy_owner is not None:
            self._policy_owner.close(self._ledger)
        self._policy_owner = None
        self._policy_raw = None
        self._policy_digest = None
        first_failure: BaseException | None = None
        for attribute in (
            "_policy_fd",
            "_project_fd",
            "_prefix_fd",
            "_next_fd",
            "_walk_fd",
        ):
            try:
                self._close_capability(attribute)
            except BaseException as error:
                if first_failure is None:
                    first_failure = error
        for transition in (
            self._policy_transition,
            self._capability_transition,
            self._path_transition,
        ):
            if transition is None:
                continue
            try:
                transition.release_all()
            except BaseException as error:
                if first_failure is None:
                    first_failure = error
        complete = self._transition_done(
            self._policy_transition
        ) and self._transition_done(
            self._capability_transition
        ) and self._transition_done(self._path_transition)
        if complete:
            self._policy_transition = None
            self._capability_transition = None
            self._path_transition = None
            self._deadline = None
            self._project_root = None
            self._prefix_path = None
            self._prefix_fingerprint = None
            self._project_fingerprint = None
            self._policy_fingerprint = None
            self._missing_parts = ()
            self._closed = True
        if first_failure is not None:
            raise first_failure
        if not complete:
            raise CFError("commit signature policy authority cleanup is incomplete")

    def __del__(self) -> None:
        try:
            self.close()
        except BaseException:
            pass


class AccountedCommitSignaturePolicy:
    """Own a provisional, ledger-accounted commit-signature policy walk.

    This pure helper deliberately has no remote/HTTP wiring yet.  ``loader``
    returns ``(borrowed_commit, canonical_size_upper)``; that contract lets a
    later production caller borrow ``SealedCommitValidationSession`` payloads
    instead of cloning their retained JSON documents.
    """

    POLICY_BASE_BYTES = 512
    # Adversarial CPython probes cover dense empty-object collections and
    # depth-500 containers.  Retained AST peaks stay below 128P and parser
    # scratch is admitted as a separate 16P Temporary upper.
    POLICY_AST_MULTIPLIER = 128
    POLICY_PARSE_TEMP_MULTIPLIER = 16
    COLLECTION_BASE_BYTES = sys.getsizeof([]) + sys.getsizeof(set())
    FRONTIER_FRAME_BASE_BYTES = 96
    FRONTIER_SLOT_BYTES = 16
    SEEN_ENTRY_BASE_BYTES = 96
    SEEN_SLOT_BYTES = 64
    INITIAL_CAPACITY = 4
    HMAC_CHUNK_BYTES = 64 * 1024
    HMAC_BASE_TEMP_BYTES = HMAC_CHUNK_BYTES + 4096
    HMAC_TEMP_MULTIPLIER = 128
    HMAC_INPUT_OVERHEAD_BYTES = 64

    def __init__(
        self,
        policy_raw: bytes,
        ledger: DecisionWorkLedger,
        loader: Any,
        deadline: HTTPRequestDeadline | None = None,
    ) -> None:
        if not isinstance(policy_raw, bytes):
            raise CFError("commit signature policy input must be bytes")
        if not callable(loader):
            raise CFError("commit signature payload loader must be callable")
        self._ledger = ledger
        self._ledger_identity = id(ledger)
        self._loader = loader
        self._deadline = deadline
        self._policy_raw: bytes | None = None
        self._policy: dict[str, Any] | None = None
        self._keys: dict[str, Any] | None = None
        self._seen: set[str] | None = None
        self._frontier: list[
            tuple[str, bool, _StablePermitTransition]
        ] | None = None
        self._seen_capacity = 0
        self._frontier_capacity = 0
        self._active_frame_transition: _StablePermitTransition | None = None
        self._transition_head: _StablePermitTransition | None = None
        self._policy_permit: _StablePermitTransition | None = None
        self._collection_permit: _StablePermitTransition | None = None
        self._hmac_storage_permit: _StablePermitTransition | None = None
        self._hmac_work_permit: _StablePermitTransition | None = None
        self._closed = False
        raw_bytes = len(policy_raw)
        policy_ast_upper = (
            self.POLICY_BASE_BYTES
            + self.POLICY_AST_MULTIPLIER * raw_bytes
        )
        retained_upper = raw_bytes + policy_ast_upper + self.COLLECTION_BASE_BYTES
        parse_temporary = (
            self.POLICY_BASE_BYTES
            + self.POLICY_PARSE_TEMP_MULTIPLIER * raw_bytes
        )
        policy_acquires = {
            "retained_bytes": retained_upper,
            "temporary_bytes": parse_temporary,
        }
        transition = _StablePermitTransition(
            ledger,
            retained_primary=retained_upper,
            temporary=parse_temporary,
        )
        self._reserve_owned_permit(
            "_policy_permit",
            transition,
            "validation",
            acquires=policy_acquires,
        )
        parsed = None
        failure = None
        try:
            transition.consume(
                phase="validation",
                acquires=policy_acquires,
            )
            # Adopt the raw policy and the complete AST/collection upper before
            # json.loads can materialize the parsed tree.
            self._policy_raw = policy_raw
            self._check_deadline("commit signature policy parse")
            parsed = json.loads(policy_raw)
            self._check_deadline("commit signature policy parse")
            if not isinstance(parsed, dict):
                raise CFError("remote policy must be an object")
            ast_bytes = canonical_json_size_up_to(
                parsed,
                policy_ast_upper,
                self._policy_poll,
            )
            if ast_bytes > policy_ast_upper:
                raise CFError("commit signature policy exceeds its parsed-size upper bound")
            self._policy = parsed
            self._seen = set()
            self._frontier = []
            self._cancel_owned_permit("_policy_permit")
            permit = None
            signature_policy = parsed.get("commit_signatures", {})
            if not isinstance(signature_policy, dict) or not signature_policy.get(
                "required"
            ):
                self.required = False
                self.require_history = False
                self._keys = {}
            else:
                keys = signature_policy.get("keys", {})
                if not isinstance(keys, dict):
                    raise CFError(
                        "commit signature validation failed: "
                        "commit_signatures.keys must be an object"
                    )
                self.required = True
                self.require_history = bool(
                    signature_policy.get("require_history")
                )
                self._keys = keys
            transition.release_temporary()
        except BaseException as error:
            failure = error
            _detach_exception_chain(error)
            parsed = None
        if failure is not None:
            cleanup_failure = None
            try:
                self.close()
            except BaseException as cleanup_error:
                cleanup_failure = cleanup_error
                _detach_exception_chain(cleanup_error)
            if cleanup_failure is not None:
                failure = cleanup_failure
            raise failure.with_traceback(None)

    @classmethod
    def policy_retained_upper(cls, policy_raw_bytes: int) -> int:
        return (
            policy_raw_bytes
            + cls.POLICY_BASE_BYTES
            + cls.POLICY_AST_MULTIPLIER * policy_raw_bytes
            + cls.COLLECTION_BASE_BYTES
        )

    @classmethod
    def policy_temporary_upper(cls, policy_raw_bytes: int) -> int:
        return cls.POLICY_BASE_BYTES + cls.POLICY_PARSE_TEMP_MULTIPLIER * policy_raw_bytes

    @classmethod
    def hmac_input_upper(cls, commit_upper: int) -> int:
        return 2 * commit_upper + cls.HMAC_INPUT_OVERHEAD_BYTES

    @classmethod
    def hmac_temporary_upper(cls, commit_upper: int, key_utf8_bytes: int) -> int:
        return (
            cls.HMAC_BASE_TEMP_BYTES
            + cls.HMAC_TEMP_MULTIPLIER * cls.hmac_input_upper(commit_upper)
            + key_utf8_bytes
        )

    @classmethod
    def frontier_frame_bytes(cls, object_id: str) -> int:
        return cls.FRONTIER_FRAME_BASE_BYTES + cls._utf8_size(object_id)

    @classmethod
    def seen_entry_bytes(cls, object_id: str) -> int:
        return cls.SEEN_ENTRY_BASE_BYTES + cls._utf8_size(object_id)

    @staticmethod
    def _utf8_size(value: str) -> int:
        size = 0
        for character in value:
            point = ord(character)
            if point < 0x80:
                size += 1
            elif point < 0x800:
                size += 2
            elif point < 0x10000:
                size += 3
            else:
                size += 4
        return size

    @staticmethod
    def _growth_plan(
        capacity: int, count: int, slot_bytes: int
    ) -> tuple[int, int, int]:
        if count < capacity:
            next_capacity = capacity
        else:
            next_capacity = max(
                AccountedCommitSignaturePolicy.INITIAL_CAPACITY,
                capacity * 2,
            )
        retained = (next_capacity - capacity) * slot_bytes
        # Runtime growth thresholds differ from this logical schedule.  Hold
        # old+possible-new backing storage before every insertion.
        scratch = (capacity + next_capacity) * slot_bytes
        return retained, next_capacity, scratch

    @staticmethod
    def _append_frontier(
        frontier: list[tuple[str, bool, _StablePermitTransition]],
        object_id: str,
        is_head: bool,
        transition: _StablePermitTransition,
    ) -> None:
        frontier.append((object_id, is_head, transition))

    @staticmethod
    def _insert_seen(seen: set[str], object_id: str) -> None:
        seen.add(object_id)

    def _check_deadline(self, phase: str) -> None:
        if self._deadline is not None:
            self._deadline.check(phase)

    def _policy_poll(self) -> None:
        self._check_deadline("commit signature policy parse")

    def _ensure_open(self) -> None:
        if self._closed:
            raise CFError("commit signature policy owner is closed")
        if id(self._ledger) != self._ledger_identity:
            raise CFError("commit signature policy owner belongs to a different ledger")
        if self._active_frame_transition is not None:
            raise CFError("commit signature policy owner has unreleased node ownership")
        if any(
            permit is not None
            for permit in (
                self._policy_permit,
                self._collection_permit,
                self._hmac_storage_permit,
                self._hmac_work_permit,
            )
        ):
            raise CFError("commit signature policy owner has an unreleased permit")

    def _cancel_owned_permit(self, attribute: str) -> None:
        transition = getattr(self, attribute)
        if transition is None:
            return
        transition.cancel()
        if transition._permit is None:
            setattr(self, attribute, None)
            self._retire_released_transition(transition)

    def _reserve_owned_permit(
        self,
        attribute: str,
        transition: _StablePermitTransition,
        phase: str,
        **upper: Any,
    ) -> None:
        if getattr(self, attribute) is not None:
            raise CFError("decision-work permit ownership overlaps")
        if (
            (transition._retained_total or transition._temporary)
            and not transition._linked
        ):
            transition._prev = None
            transition._next = self._transition_head
            if self._transition_head is not None:
                self._transition_head._prev = transition
            self._transition_head = transition
            transition._linked = True
        setattr(self, attribute, transition)
        try:
            transition.reserve(phase, **upper)
        except BaseException:
            if transition._permit is None:
                setattr(self, attribute, None)
                self._retire_released_transition(transition)
            raise

    def _retire_released_transition(
        self,
        transition: _StablePermitTransition,
    ) -> None:
        if (
            transition._linked
            and transition._permit is None
            and transition._retained_primary_released
            and transition._retained_secondary_released
            and transition._temporary_released
        ):
            previous = transition._prev
            following = transition._next
            if previous is None:
                self._transition_head = following
            else:
                previous._next = following
            if following is not None:
                following._prev = previous
            transition._prev = None
            transition._next = None
            transition._linked = False

    def _rollback_collection_charge(
        self,
        transition: _StablePermitTransition,
    ) -> None:
        # The failed collection payload has already been removed.
        transition.release_all()
        self._retire_released_transition(transition)

    def _push_frontier(self, object_id: str, is_head: bool, *, edge: bool) -> None:
        assert self._frontier is not None
        if self._collection_permit is not None:
            raise CFError("commit signature collection permit overlaps")
        frame_bytes = self.frontier_frame_bytes(object_id)
        growth, next_capacity, scratch = self._growth_plan(
            self._frontier_capacity,
            len(self._frontier),
            self.FRONTIER_SLOT_BYTES,
        )
        retained = frame_bytes + growth
        acquires = {"retained_bytes": retained}
        if scratch:
            acquires["temporary_bytes"] = scratch
        charges = {"graph_edges": 1} if edge else {}
        counters = {"frontier_insertion_attempts": 1}
        if edge:
            counters["edge_occurrences"] = 1
        transition = _StablePermitTransition(
            self._ledger,
            retained_primary=frame_bytes,
            retained_secondary=growth,
            temporary=scratch,
        )
        self._reserve_owned_permit(
            "_collection_permit",
            transition,
            "graph_discovery",
            charges=charges,
            maxima={"maximum_frontier": len(self._frontier) + 1},
            acquires=acquires,
            counters=counters,
        )
        count_before = len(self._frontier)
        try:
            self._check_deadline("commit signature history")
            transition.consume(
                phase="graph_discovery",
                charges=charges,
                maxima={"maximum_frontier": len(self._frontier) + 1},
                acquires=acquires,
                counters=counters,
            )
            allocation_failure = None
            try:
                self._append_frontier(
                    self._frontier,
                    object_id,
                    is_head,
                    transition,
                )
            except BaseException as error:
                allocation_failure = error
                _detach_exception_chain(error)
            if allocation_failure is not None:
                while len(self._frontier) > count_before:
                    self._frontier.pop()
                self._rollback_collection_charge(transition)
                raise allocation_failure.with_traceback(None)
            self._frontier_capacity = next_capacity
            if scratch:
                transition.release_temporary()
        finally:
            # Maximum reservations intentionally remain reusable after an
            # exact consume; this one-shot collection permit is not.
            self._cancel_owned_permit("_collection_permit")

    def _pop_frontier(self) -> tuple[str, bool]:
        assert self._frontier is not None
        if self._active_frame_transition is not None:
            raise CFError("commit signature node ownership overlaps")
        object_id, is_head, transition = self._frontier.pop()
        self._active_frame_transition = transition
        return object_id, is_head

    def _release_active_frame(self) -> None:
        transition = self._active_frame_transition
        if transition is None:
            return
        transition.release_retained_primary()
        if transition._retained_primary_released:
            self._active_frame_transition = None
            self._retire_released_transition(transition)

    def _mark_seen(self, object_id: str) -> bool:
        assert self._seen is not None
        if self._collection_permit is not None:
            raise CFError("commit signature collection permit overlaps")
        if object_id in self._seen:
            self._ledger.count("revisits", 1, "graph_discovery")
            return False
        entry_bytes = self.seen_entry_bytes(object_id)
        growth, next_capacity, scratch = self._growth_plan(
            self._seen_capacity,
            len(self._seen),
            self.SEEN_SLOT_BYTES,
        )
        retained = entry_bytes + growth
        acquires = {"retained_bytes": retained}
        if scratch:
            acquires["temporary_bytes"] = scratch
        transition = _StablePermitTransition(
            self._ledger,
            retained_primary=entry_bytes,
            retained_secondary=growth,
            temporary=scratch,
        )
        self._reserve_owned_permit(
            "_collection_permit",
            transition,
            "graph_discovery",
            charges={"graph_nodes": 1},
            acquires=acquires,
            counters={"unique_nodes_discovered": 1},
        )
        try:
            transition.consume(
                phase="graph_discovery",
                charges={"graph_nodes": 1},
                acquires=acquires,
                counters={"unique_nodes_discovered": 1},
            )
            allocation_failure = None
            try:
                self._insert_seen(self._seen, object_id)
            except BaseException as error:
                allocation_failure = error
                _detach_exception_chain(error)
            if allocation_failure is not None:
                if object_id in self._seen:
                    self._seen.remove(object_id)
                self._rollback_collection_charge(transition)
                raise allocation_failure.with_traceback(None)
            self._seen_capacity = next_capacity
            if scratch:
                transition.release_temporary()
            return True
        finally:
            self._cancel_owned_permit("_collection_permit")

    def _feed_accounted(
        self,
        digest: Any,
        transition: _StablePermitTransition,
        data: bytes | bytearray,
    ) -> None:
        if not data:
            return
        size = len(data)
        transition.consume(
            phase="semantic_validation",
            charges={"aggregate_bytes": size},
            counters={"bytes_hashed": size},
        )
        digest.update(data)

    def _stream_signature_input(
        self,
        digest: Any,
        transition: _StablePermitTransition,
        commit: dict[str, Any],
        signature: dict[str, Any],
    ) -> None:
        chunk_limit = self.HMAC_CHUNK_BYTES

        def feed(data: bytes | bytearray) -> None:
            for offset in range(0, len(data), chunk_limit):
                self._check_deadline("commit signature HMAC")
                self._feed_accounted(
                    digest,
                    transition,
                    data[offset : offset + chunk_limit],
                )

        def feed_string(value: str) -> None:
            buffer = bytearray(b'"')
            escapes = {
                '"': b'\\"',
                "\\": b"\\\\",
                "\b": b"\\b",
                "\f": b"\\f",
                "\n": b"\\n",
                "\r": b"\\r",
                "\t": b"\\t",
            }
            for index, character in enumerate(value):
                if index % 1024 == 0:
                    self._check_deadline("commit signature HMAC")
                encoded = escapes.get(character)
                if encoded is None:
                    if ord(character) < 0x20:
                        encoded = f"\\u{ord(character):04x}".encode("ascii")
                    else:
                        encoded = character.encode("utf-8")
                buffer.extend(encoded)
                if len(buffer) >= chunk_limit:
                    feed(buffer)
                    buffer.clear()
            buffer.extend(b'"')
            feed(buffer)
            buffer.clear()

        def sort_mapping_keys(keys: list[str]) -> None:
            def sift_down(root: int, end: int) -> None:
                while root * 2 + 1 <= end:
                    self._check_deadline("commit signature HMAC")
                    child = root * 2 + 1
                    if child + 1 <= end and keys[child] < keys[child + 1]:
                        child += 1
                    if keys[child] <= keys[root]:
                        return
                    keys[root], keys[child] = keys[child], keys[root]
                    root = child

            for root in range((len(keys) - 2) // 2, -1, -1):
                sift_down(root, len(keys) - 1)
            for end in range(len(keys) - 1, 0, -1):
                self._check_deadline("commit signature HMAC")
                keys[0], keys[end] = keys[end], keys[0]
                sift_down(0, end - 1)

        stack: list[tuple[str, Any, Any]] = [
            ("bytes", b"}", None),
            ("mapping", signature, "signature"),
            ("bytes", b'\"signature\":', None),
            ("bytes", b",", None),
            ("mapping", commit, "signature"),
            ("bytes", b'\"commit\":', None),
            ("bytes", b"{", None),
        ]
        while stack:
            self._check_deadline("commit signature HMAC")
            action, value, extra = stack.pop()
            if action == "bytes":
                feed(value)
                continue
            if action == "string":
                feed_string(value)
                continue
            if action == "sequence":
                index = extra
                if index >= len(value):
                    feed(b"]")
                    continue
                stack.append(("sequence", value, index + 1))
                if index + 1 < len(value):
                    stack.append(("bytes", b",", None))
                stack.append(("value", value[index], None))
                continue
            if action == "mapping_items":
                mapping, keys = value
                index = extra
                if index >= len(keys):
                    feed(b"}")
                    keys.clear()
                    continue
                key = keys[index]
                stack.append(("mapping_items", (mapping, keys), index + 1))
                if index + 1 < len(keys):
                    stack.append(("bytes", b",", None))
                stack.append(("value", mapping[key], None))
                stack.append(("bytes", b":", None))
                stack.append(("string", key, None))
                continue
            if action == "mapping":
                keys = []
                for key in value:
                    self._check_deadline("commit signature HMAC")
                    if not isinstance(key, str):
                        raise TypeError("commit signature JSON object keys must be strings")
                    if key != extra:
                        keys.append(key)
                sort_mapping_keys(keys)
                feed(b"{")
                stack.append(("mapping_items", (value, keys), 0))
                continue
            item = value
            if item is None:
                feed(b"null")
            elif item is True:
                feed(b"true")
            elif item is False:
                feed(b"false")
            elif isinstance(item, str):
                feed_string(item)
            elif isinstance(item, int) and not isinstance(item, bool):
                feed(str(item).encode("ascii"))
            elif isinstance(item, float):
                feed(canonical_json(item))
            elif isinstance(item, (list, tuple)):
                feed(b"[")
                stack.append(("sequence", item, 0))
            elif isinstance(item, (dict, MappingProxyType)):
                stack.append(("mapping", item, None))
            else:
                feed(canonical_json(item))
        stack.clear()

    def _verify_signature(
        self, commit: dict[str, Any], commit_upper: int, required: bool
    ) -> None:
        assert self._keys is not None
        assert self._policy_raw is not None
        if self._hmac_storage_permit is not None or self._hmac_work_permit is not None:
            raise CFError("commit signature HMAC permit overlaps")
        input_upper = self.hmac_input_upper(commit_upper)
        # A decoded JSON string cannot contain more UTF-8 bytes than the raw
        # policy document that owns it.  Reserve this upper before key policy
        # validation too: allowed-signer normalization may allocate a list.
        key_bytes_upper = len(self._policy_raw)
        temporary_upper = self.hmac_temporary_upper(commit_upper, key_bytes_upper)
        storage_acquires = {"temporary_bytes": temporary_upper}
        storage_transition = _StablePermitTransition(
            self._ledger,
            temporary=temporary_upper,
        )
        self._reserve_owned_permit(
            "_hmac_storage_permit",
            storage_transition,
            "semantic_validation",
            acquires=storage_acquires,
        )
        work_transition = _StablePermitTransition(self._ledger)
        try:
            self._reserve_owned_permit(
                "_hmac_work_permit",
                work_transition,
                "semantic_validation",
                charges={"aggregate_bytes": input_upper},
                counters={"bytes_hashed": input_upper, "semantic_validations": 1},
            )
        except BaseException:
            self._cancel_owned_permit("_hmac_storage_permit")
            raise
        signature = None
        key = None
        key_bytes = None
        digest = None
        expected = None
        failure = None
        try:
            storage_transition.consume(
                phase="semantic_validation",
                acquires=storage_acquires,
            )
            work_transition.consume(
                phase="semantic_validation",
                counters={"semantic_validations": 1},
            )
            self._check_deadline("commit signature HMAC")
            signature = validate_commit_signature_structure(commit, required=required)
            if signature is not None:
                key = signature_key_secret(signature, self._keys)
                if self._utf8_size(key) > key_bytes_upper:
                    raise CFError("commit signature key exceeds its policy size upper bound")
                measured_commit = canonical_json_size_up_to(
                    commit,
                    commit_upper,
                    lambda: self._check_deadline("commit signature HMAC"),
                )
                if measured_commit > commit_upper:
                    raise CFError(
                        "commit signature payload loader understated its "
                        "canonical size upper"
                    )
                key_bytes = key.encode("utf-8")
                digest = hmac.new(key_bytes, digestmod=hashlib.sha256)
                self._stream_signature_input(digest, work_transition, commit, signature)
                expected = digest.hexdigest()
                if not hmac.compare_digest(expected, signature["signature"]):
                    raise CFError("commit signature validation failed: invalid signature")
        except BaseException as error:
            failure = error
            _detach_exception_chain(error)
        expected = None
        digest = None
        key_bytes = None
        key = None
        signature = None
        cleanup_failure = None
        try:
            self._cancel_owned_permit("_hmac_work_permit")
            self._cancel_owned_permit("_hmac_storage_permit")
        except BaseException as cleanup_error:
            cleanup_failure = cleanup_error
            _detach_exception_chain(cleanup_error)
        if cleanup_failure is None:
            # The detached serializer traceback and all HMAC locals are gone
            # before the first release callback can observe this scalar.
            storage_transition.release_temporary()
            self._retire_released_transition(storage_transition)
        if cleanup_failure is not None:
            raise cleanup_failure.with_traceback(None)
        if failure is not None:
            raise failure.with_traceback(None)

    def verify(self, commit_id: str, is_head: bool = True) -> None:
        self._ensure_open()
        if not self.required:
            return
        if not isinstance(commit_id, str):
            raise CFError("commit signature root must be a string")
        try:
            self._push_frontier(commit_id, is_head, edge=False)
            while self._frontier:
                self._check_deadline("commit signature history")
                current, current_is_head = self._pop_frontier()
                loaded = None
                commit = None
                parents = None
                parent = None
                try:
                    if not self._mark_seen(current):
                        continue
                    self._check_deadline("commit signature history load")
                    loaded = self._loader(current)
                    self._check_deadline("commit signature history load")
                    if (
                        not isinstance(loaded, tuple)
                        or len(loaded) != 2
                        or not isinstance(loaded[0], dict)
                        or isinstance(loaded[1], bool)
                        or not isinstance(loaded[1], int)
                        or loaded[1] < 0
                    ):
                        raise CFError(
                            "commit signature payload loader must return "
                            "(object, canonical size upper)"
                        )
                    commit, commit_upper = loaded
                    loaded = None
                    parents = commit.get("parents", [])
                    if current_is_head or commit.get("signature") is not None or parents:
                        self._verify_signature(commit, commit_upper, required=True)
                    if self.require_history:
                        for index in range(len(parents) - 1, -1, -1):
                            self._check_deadline("commit signature history")
                            parent = parents[index]
                            if isinstance(parent, str) and parent.startswith("CF-COMMIT-"):
                                self._push_frontier(parent, False, edge=True)
                finally:
                    # The popped tuple's scalar covers current through loader,
                    # verification, and parent expansion, including revisits.
                    parent = None
                    parents = None
                    commit = None
                    loaded = None
                    current = None
                    self._release_active_frame()
        finally:
            self._clear_frontier()

    def _clear_frontier(self) -> None:
        if self._frontier is None:
            return
        while self._frontier:
            object_id, _, transition = self._frontier.pop()
            object_id = None
            transition.release_retained_primary()
            self._retire_released_transition(transition)

    def _drop_payloads(self) -> None:
        self._clear_frontier()
        if self._frontier is not None:
            self._frontier.clear()
            self._frontier = None
        if self._seen is not None:
            self._seen.clear()
            self._seen = None
        self._keys = None
        self._policy = None
        self._policy_raw = None
        self._loader = None
        self._deadline = None
        # A failed active-frame release remains in the durable transition chain.
        self._active_frame_transition = None

    def close(self, ledger: DecisionWorkLedger | None = None) -> None:
        if self._closed:
            return
        selected = self._ledger if ledger is None else ledger
        if id(selected) != self._ledger_identity or id(self._ledger) != self._ledger_identity:
            raise CFError("commit signature policy owner belongs to a different ledger")
        self._drop_payloads()
        self._cancel_owned_permit("_hmac_work_permit")
        self._cancel_owned_permit("_hmac_storage_permit")
        self._cancel_owned_permit("_collection_permit")
        self._cancel_owned_permit("_policy_permit")
        transition = self._transition_head
        while transition is not None:
            following = transition._next
            transition.release_all()
            self._retire_released_transition(transition)
            transition = following
        self._hmac_work_permit = None
        self._hmac_storage_permit = None
        self._collection_permit = None
        self._policy_permit = None
        if self._transition_head is not None:
            raise CFError("commit signature scalar transition cleanup is incomplete")
        self._closed = True

    def __enter__(self) -> "AccountedCommitSignaturePolicy":
        self._ensure_open()
        return self

    def __exit__(self, exc_type: Any, exc: Any, traceback: Any) -> None:
        self.close()

    def __del__(self) -> None:
        try:
            self.close()
        except BaseException:
            pass


def borrowed_sealed_commit_signature_payload(
    session: Any,
    object_id: str,
    deadline: HTTPRequestDeadline | None = None,
) -> tuple[dict[str, Any], int]:
    """Borrow one session payload and its already-accounted retained upper."""
    poll = None
    if deadline is not None:
        poll = lambda: deadline.check("commit signature history load")
    payload = session.load_payload(object_id, poll)
    document = session.documents.get(object_id)
    if document is None:
        raise CFError("sealed commit signature payload is not retained by its session")
    return payload, document.retained_bytes


def enforce_remote_commit_signature_policy(project_root: Path, objects_root: Path, commit_id: str, seen: set[str] | None = None, is_head: bool = True) -> None:
    policy = read_json(remote_policy_path(project_root), {})
    signature_policy = policy.get("commit_signatures", {})
    if not isinstance(signature_policy, dict) or not signature_policy.get("required"):
        return
    keys = signature_policy.get("keys", {})
    if not isinstance(keys, dict):
        raise CFError("commit signature validation failed: commit_signatures.keys must be an object")
    if seen is None:
        seen = set()
    require_history = bool(signature_policy.get("require_history"))
    stack = [(commit_id, is_head)]
    while stack:
        current, current_is_head = stack.pop()
        if current in seen:
            continue
        seen.add(current)
        commit = load_object_from_root(objects_root, current)
        parents = commit.get("parents", [])
        if current_is_head or commit.get("signature") is not None or parents:
            verify_commit_signature(commit, keys, required=True)
        if require_history:
            eligible_parents = [
                parent
                for parent in parents
                if isinstance(parent, str) and parent.startswith("CF-COMMIT-")
            ]
            # The recursive implementation visited parents in record order. Reverse the
            # push order so the explicit LIFO stack preserves the same first-error result.
            stack.extend((parent, False) for parent in reversed(eligible_parents))


def remote_commit_signature_errors(
    project_root: Path,
    refs: list[tuple[str, str]],
    *,
    session: Any = None,
    policy: dict[str, Any] | None = None,
) -> list[str]:
    errors = []
    error_output_bytes = 0
    policy = read_json(remote_policy_path(project_root), {}) if policy is None else policy
    signature_policy = policy.get("commit_signatures", {})
    if not isinstance(signature_policy, dict) or not signature_policy.get("required"):
        return errors
    dirs = remote_dirs(project_root)
    keys = signature_policy.get("keys", {})
    require_history = bool(signature_policy.get("require_history"))

    def validate_session_signature_history(commit_id: str) -> None:
        validated: set[str] = set()
        validated_bytes = 0
        stack: list[tuple[str, bool, int]] = []
        stack_bytes = 0
        initial_bytes = session._frame_size(commit_id)
        session.ledger.apply(
            "graph_discovery",
            maxima={"logical_depth": 0, "maximum_frontier": 1},
            acquires={"retained_bytes": initial_bytes},
            counters={"frontier_insertion_attempts": 1},
        )
        stack_bytes += initial_bytes
        stack.append((commit_id, True, 0))
        try:
            while stack:
                current, is_head, depth = stack.pop()
                frame_bytes = session._frame_size(current)
                stack_bytes -= frame_bytes
                session.ledger.release("retained_bytes", frame_bytes)
                if current in validated:
                    session.ledger.count("revisits", 1, "query")
                    continue
                seen_bytes = len(current.encode("utf-8")) + 64
                session.ledger.acquire("retained_bytes", seen_bytes, "query")
                validated_bytes += seen_bytes
                validated.add(current)
                commit = session.load_payload(current)
                parents = commit.get("parents", [])
                session.ledger.count("rules_evaluated", 1, "query")
                if is_head or commit.get("signature") is not None or parents:
                    verify_commit_signature(commit, keys, required=True)
                if require_history:
                    for parent in reversed(parents):
                        if not (
                            isinstance(parent, str)
                            and parent.startswith("CF-COMMIT-")
                        ):
                            continue
                        parent_depth = depth + 1
                        parent_bytes = session._frame_size(parent)
                        session.ledger.apply(
                            "graph_discovery",
                            charges={"graph_edges": 1},
                            maxima={
                                "logical_depth": parent_depth,
                                "maximum_frontier": len(stack) + 1,
                            },
                            acquires={"retained_bytes": parent_bytes},
                            counters={
                                "edge_occurrences": 1,
                                "frontier_insertion_attempts": 1,
                            },
                        )
                        stack_bytes += parent_bytes
                        stack.append((parent, False, parent_depth))
        finally:
            stack.clear()
            validated.clear()
            if stack_bytes:
                session.ledger.release("retained_bytes", stack_bytes)
            if validated_bytes:
                session.ledger.release("retained_bytes", validated_bytes)

    for label, commit_id in refs:
        try:
            if not isinstance(keys, dict):
                raise CFError(
                    "commit signature validation failed: "
                    "commit_signatures.keys must be an object"
                )
            if session is None:
                enforce_remote_commit_signature_policy(
                    project_root, dirs["objects"], commit_id
                )
                continue
            validate_session_signature_history(commit_id)
        except (ResourceBudgetExceeded, SealedValidationSubjectChanged):
            raise
        except CFError as exc:
            if session is not None:
                error_bytes = (
                    len(label.encode("utf-8"))
                    + len(commit_id.encode("utf-8"))
                    + len(str(exc).encode("utf-8"))
                    + 68
                )
                session.ledger.acquire("retained_bytes", error_bytes, "query")
                session.adopt_aux_retained(error_bytes)
                error_output_bytes += error_bytes
            errors.append(f"{label}: {commit_id}: {exc}")
    if session is None:
        return sorted(errors)
    sort_scratch = error_output_bytes + 8 * len(errors)
    session.ledger.acquire("temporary_bytes", sort_scratch, "query")
    try:
        return sorted(errors)
    finally:
        session.ledger.release("temporary_bytes", sort_scratch)


def check_remote_permission(project_root: Path, operation: str, actor: str) -> None:
    policy = read_json(remote_policy_path(project_root), {})
    permissions = policy.get("permissions", {})
    allowed = permissions.get(operation)
    if allowed is None:
        return
    if isinstance(allowed, str):
        allowed = [allowed]
    if "*" in allowed or actor in allowed:
        return
    raise CFError(f"permission denied: actor '{actor}' cannot perform '{operation}'")


def check_remote_branch_protection(project_root: Path, branch: str, operation: str, actor: str) -> None:
    policy = read_json(remote_policy_path(project_root), {})
    rules = policy.get("branch_protection", {})
    if not isinstance(rules, dict):
        return
    for pattern, rule in rules.items():
        if not fnmatch.fnmatchcase(branch, pattern):
            continue
        if not isinstance(rule, dict):
            continue
        allowed = rule.get(operation)
        if allowed is None:
            allowed = rule.get("*")
        if allowed is None:
            continue
        if isinstance(allowed, str):
            allowed = [allowed]
        if "*" in allowed or actor in allowed:
            continue
        raise CFError(f"branch protection denied: actor '{actor}' cannot {operation} branch '{branch}'")


def check_remote_auth(project_root: Path, actor: str, token: str) -> None:
    policy = read_json(remote_policy_path(project_root), {})
    auth = policy.get("auth", {})
    if not auth.get("required"):
        return
    tokens = auth.get("tokens", {})
    expected = tokens.get(actor) or tokens.get("*")
    if not expected:
        raise CFError(f"authentication failed: actor '{actor}' has no configured token")
    if not token:
        raise CFError("authentication failed: token is required")
    if not check_token_value(token, expected):
        raise CFError("authentication failed: invalid token")


def authorize_remote(
    project_root: Path,
    operation: str,
    args: argparse.Namespace,
    target: str | None = None,
    payload: dict[str, Any] | None = None,
) -> str:
    actor = actor_from_args(args)
    check_remote_permission(project_root, operation, actor)
    check_remote_auth(project_root, actor, token_from_args(args))
    if target is not None:
        if payload is None:
            raise CFError("request signature validation failed: mutation payload is required")
        verify_remote_request_signature(
            project_root,
            operation,
            actor,
            target,
            payload,
            request_signature_for_args(args, operation, actor, target, payload),
        )
    return actor


def authorize_remote_without_nonce(
    project_root: Path,
    operation: str,
    args: argparse.Namespace,
    target: str,
    payload: dict[str, Any],
) -> tuple[str, tuple[dict[str, Any], float, int] | None]:
    """Authenticate one mutation and return an unpublished nonce plan."""
    actor = actor_from_args(args)
    check_remote_permission(project_root, operation, actor)
    check_remote_auth(project_root, actor, token_from_args(args))
    nonce_plan = verify_remote_request_signature(
        project_root,
        operation,
        actor,
        target,
        payload,
        request_signature_for_args(args, operation, actor, target, payload),
        defer_nonce=True,
    )
    return actor, nonce_plan


def current_remote_generation(project_root: Path) -> int:
    state = read_json(remote_generation_path(project_root), {})
    try:
        return int(state.get("current_generation", 0))
    except (TypeError, ValueError):
        return 0


def next_remote_generation(project_root: Path) -> int:
    with stable_remote_lock(remote_dirs(project_root)["locks"] / "generation.lock"):
        generation = current_remote_generation(project_root) + 1
        write_json(
            remote_generation_path(project_root),
            {
                "version": VERSION,
                "current_generation": generation,
                "updated_at": now_iso(),
            },
        )
        return generation


class AccountedServerVerification:
    """Single-use owner for bounded server-side verification processes.

    Preparing this owner is effect-free: policy/configuration payloads and the
    maximum captured process output are reserved before the first process is
    spawned. Spawning an arbitrary configured command is itself an external
    effect; cancellation can kill and reap that process but cannot roll back
    effects performed by the command before it was stopped.
    """

    DEFAULT_OUTPUT_LIMIT_BYTES = 1024 * 1024
    OUTPUT_READ_CHUNK_BYTES = 64 * 1024
    OUTPUT_MEMORY_BASE_BYTES = 4096
    OUTPUT_MEMORY_MULTIPLIER = 8
    FAILURE_SAMPLE_LIMIT_BYTES = 4096
    FAILURE_CONTROL_LIMIT_BYTES = 16 * 1024
    CHECK_ID_LIMIT_BYTES = 1024
    PLAN_TEXT_LIMIT_BYTES = 4096
    # For CPython JSON values, even the densest nested empty container needs
    # at least two input bytes for a <=64-byte object header; 128 bytes per
    # input byte also covers parent slots, dict tables, scalar objects, and
    # alignment. Parse scratch separately covers raw/decoded input, chunk,
    # tokenizer, and bounded-depth parser state before json.loads runs.
    POLICY_AST_BASE_BYTES = 4096
    POLICY_AST_BYTES_PER_INPUT_BYTE = 128
    POLICY_PARSE_BASE_BYTES = 64 * 1024
    POLICY_PARSE_BYTES_PER_INPUT_BYTE = 16
    CONFIG_BASE_BYTES = sys.getsizeof([]) + 512
    CONFIG_LIST_SLOT_BYTES = 16
    CONFIG_PLAN_BASE_BYTES = (
        sys.getsizeof((None, None, 0, 0.0, None))
        + sys.getsizeof({})
        + sys.getsizeof(0.0)
        + 256
    )
    CONFIG_ENV_ENTRY_BYTES = 128
    CONFIG_TEXT_OWNER_BYTES = 64 + 4 * PLAN_TEXT_LIMIT_BYTES
    CAPABILITY_FRAME_BYTES = 4096
    CAPABILITY_TEMP_BASE_BYTES = 64 * 1024
    CAPABILITY_PATH_COMPONENT_BYTES = 4096
    POLICY_FENCE_BASE_BYTES = 4096
    POLICY_FENCE_BYTES_PER_INPUT_BYTE = 2
    PROCESS_POLL_SECONDS = 0.05
    PROCESS_REAP_SECONDS = 5.0

    def __init__(
        self,
        project_root: Path,
        branch: str,
        commit_id: str,
        ledger: DecisionWorkLedger,
        deadline: HTTPRequestDeadline | None = None,
        *,
        output_limit_bytes: int = DEFAULT_OUTPUT_LIMIT_BYTES,
        allow_missing_project: bool = False,
        _signature_policy_authority: (
            AccountedRemoteSignaturePolicyAuthority | None
        ) = None,
    ) -> None:
        if (
            isinstance(output_limit_bytes, bool)
            or not isinstance(output_limit_bytes, int)
            or output_limit_bytes < 0
        ):
            raise CFError("server verification output limit must be nonnegative")
        if not isinstance(allow_missing_project, bool):
            raise CFError("server verification missing-project mode must be boolean")
        self._ledger = ledger
        self._ledger_identity = id(ledger)
        self._deadline = deadline
        self._output_limit_bytes = output_limit_bytes
        self._policy: dict[str, Any] | None = None
        self._plans: list[tuple[str, str, int, float, dict[str, str]]] | None = None
        self._orphaned_plans: (
            list[tuple[str, str, int, float, dict[str, str]]] | None
        ) = None
        self._orphaned_cwd_fd = -1
        self._project_root: Path | None = project_root
        self._project_identity: tuple[int, int] | None = None
        self._project_fingerprint: tuple[int, ...] | None = None
        self._project_fd = -1
        self._policy_fd = -1
        self._policy_identity: tuple[int, int] | None = None
        self._policy_fingerprint: tuple[int, ...] | None = None
        self._policy_size: int | None = None
        self._policy_raw: bytearray | bytes | None = None
        self._policy_digest: bytes | None = None
        self._process: subprocess.Popen[bytes] | None = None
        self._capability_permit: DecisionWorkPermit | None = None
        self._policy_permit: DecisionWorkPermit | None = None
        self._policy_read_permit: DecisionWorkPermit | None = None
        self._config_permit: DecisionWorkPermit | None = None
        self._output_permit: DecisionWorkPermit | None = None
        self._output_storage_permit: DecisionWorkPermit | None = None
        self._policy_fence_permit: DecisionWorkPermit | None = None
        self._policy_fence_storage_permit: DecisionWorkPermit | None = None
        self._pending_acquisition: (
            tuple[DecisionWorkPermit, int, int] | None
        ) = None
        self._pending_release: (
            tuple[str, int, int, int, int, int] | None
        ) = None
        self._retained_bytes = 0
        self._temporary_bytes = 0
        self._failure_message: str | None = None
        self._requires_missing_project = allow_missing_project
        self._started = False
        self._completed = False
        self._closed = False
        self._constructing = True
        construction_error: BaseException | None = None
        try:
            if _signature_policy_authority is not None:
                _signature_policy_authority._publish_verification_child(self)
            self._acquire_capability_owner(project_root)
            self._prepare(
                project_root,
                branch,
                commit_id,
                allow_missing_project=allow_missing_project,
                signature_policy_authority=_signature_policy_authority,
            )
        except BaseException as exc:
            # Constructor frames can retain the parsed policy, raw bytes, and
            # partial plans through an active exception traceback.  Drop those
            # frames, then leave the active exception handler before close
            # releases their accounted storage.
            self._detach_exception_tracebacks(exc)
            construction_error = exc
        self._constructing = False
        if construction_error is not None:
            try:
                self.close()
            except BaseException as cleanup_exc:
                self._detach_exception_tracebacks(cleanup_exc)
                raise cleanup_exc from construction_error
            raise construction_error from None

    @staticmethod
    def _detach_exception_tracebacks(exc: BaseException) -> None:
        current: BaseException | None = exc
        while current is not None:
            next_exception = current.__cause__
            if next_exception is None:
                next_exception = current.__context__
            current.__traceback__ = None
            current.__cause__ = None
            current.__context__ = None
            current = next_exception

    def _cancel_owned_permit(self, attribute: str) -> None:
        permit = getattr(self, attribute)
        if permit is None:
            return
        if self._ledger.permit_is_open(permit):
            try:
                self._ledger.cancel_permit(permit)
            finally:
                if not self._ledger.permit_is_open(permit):
                    pending = self._pending_acquisition
                    if pending is not None and pending[0] is permit:
                        self._pending_acquisition = None
                    setattr(self, attribute, None)
            return
        self._finish_pending_acquisition(permit)
        setattr(self, attribute, None)

    def _finish_pending_acquisition(
        self, permit: DecisionWorkPermit
    ) -> None:
        pending = self._pending_acquisition
        if pending is None or pending[0] is not permit:
            return
        if self._ledger.permit_is_open(permit):
            return
        self._retained_bytes = pending[1]
        self._temporary_bytes = pending[2]
        self._pending_acquisition = None

    def _consume_owned_acquisition(
        self,
        permit: DecisionWorkPermit,
        *,
        phase: str,
        retained_bytes: int = 0,
        temporary_bytes: int = 0,
    ) -> None:
        if self._pending_acquisition is not None:
            raise CFError("server verification acquisition transition is pending")
        reservation = self._ledger._reserved.get(permit)
        if (
            reservation is None
            or reservation["charges"]
            or reservation["maxima"]
            or reservation["counters"]
            or len(reservation["acquires"])
            != int(bool(retained_bytes)) + int(bool(temporary_bytes))
            or reservation["acquires"].get("retained_bytes", 0)
            != retained_bytes
            or reservation["acquires"].get("temporary_bytes", 0)
            != temporary_bytes
        ):
            raise CFError(
                "server verification acquisition permit must close exactly"
            )
        retained_after = self._retained_bytes + retained_bytes
        temporary_after = self._temporary_bytes + temporary_bytes
        self._pending_acquisition = (
            permit,
            retained_after,
            temporary_after,
        )
        try:
            self._ledger.consume_reserved(
                permit,
                phase=phase,
                acquires={
                    key: value
                    for key, value in {
                        "retained_bytes": retained_bytes,
                        "temporary_bytes": temporary_bytes,
                    }.items()
                    if value
                },
            )
        finally:
            self._finish_pending_acquisition(permit)

    def _finish_pending_release(self) -> None:
        pending = self._pending_release
        if pending is None:
            return
        dimension, _amount, before, after, retained_after, temporary_after = pending
        current = self._ledger._current.get(dimension, 0)
        if current == before:
            return
        if current != after:
            raise CFError(
                "server verification release transition diverged"
            )
        self._retained_bytes = retained_after
        self._temporary_bytes = temporary_after
        self._pending_release = None

    def _resume_pending_release(self) -> None:
        pending = self._pending_release
        if pending is None:
            return
        self._finish_pending_release()
        pending = self._pending_release
        if pending is None:
            return
        dimension, amount, _before, _after, _retained, _temporary = pending
        try:
            self._ledger.release(dimension, amount)
        finally:
            self._finish_pending_release()

    def _release_owned(self, dimension: str, amount: int) -> None:
        self._resume_pending_release()
        if self._pending_release is not None:
            raise CFError("server verification release transition is pending")
        before = self._ledger._current.get(dimension, 0)
        if amount > before:
            raise CFError(
                f"decision-work release underflow for {dimension}"
            )
        retained_after = self._retained_bytes
        temporary_after = self._temporary_bytes
        if dimension == "retained_bytes":
            if amount > retained_after:
                raise CFError(
                    "server verification retained release underflow"
                )
            retained_after -= amount
        elif dimension == "temporary_bytes":
            if amount > temporary_after:
                raise CFError(
                    "server verification temporary release underflow"
                )
            temporary_after -= amount
        else:
            raise CFError(
                f"server verification cannot release {dimension}"
            )
        self._pending_release = (
            dimension,
            amount,
            before,
            before - amount,
            retained_after,
            temporary_after,
        )
        try:
            self._ledger.release(dimension, amount)
        finally:
            self._finish_pending_release()

    def _close_owned_capability(self, attribute: str) -> None:
        file_descriptor = getattr(self, attribute)
        if file_descriptor < 0:
            return
        # Linux may reuse a successfully closed descriptor before a wrapper
        # reports an exception.  Consume numeric ownership before the one close
        # attempt and never retry that number; otherwise cleanup can close an
        # unrelated descriptor acquired through an ABA reopen.
        setattr(self, attribute, -1)
        self._close_capability(file_descriptor)

    def _poll(self, phase: str) -> None:
        if self._deadline is not None:
            self._deadline.check(phase)

    @classmethod
    def _capability_upper(cls, project_root: Path) -> tuple[int, int]:
        path_characters = len(os.fspath(project_root))
        retained = (
            cls.CAPABILITY_FRAME_BYTES * 2
            + 128
            + 4 * path_characters
        )
        temporary = (
            cls.CAPABILITY_TEMP_BASE_BYTES
            + (cls.CAPABILITY_PATH_COMPONENT_BYTES + 16)
            * (path_characters + 2)
            + 4 * path_characters
        )
        return retained, temporary

    def _acquire_capability_owner(self, project_root: Path) -> None:
        retained, temporary = self._capability_upper(project_root)
        permit = DecisionWorkPermit()
        self._capability_permit = permit
        self._ledger.reserve_into(
            permit,
            "record_read",
            acquires={
                "retained_bytes": retained,
                "temporary_bytes": temporary,
            },
        )
        try:
            self._consume_owned_acquisition(
                permit,
                phase="record_read",
                retained_bytes=retained,
                temporary_bytes=temporary,
            )
            self._capability_permit = None
        finally:
            self._cancel_owned_permit("_capability_permit")

    @staticmethod
    def _text_upper(value: str) -> int:
        return 64 + 4 * len(value)

    @classmethod
    def _bounded_plan_text(
        cls,
        value: Any,
        field: str,
        limit: int | None = None,
    ) -> str:
        if isinstance(value, (dict, list, tuple, set)):
            raise CFError(f"server verification {field} must be a scalar")
        text = str(value)
        byte_limit = cls.PLAN_TEXT_LIMIT_BYTES if limit is None else limit
        encoded_size = 0
        try:
            for character in text:
                encoded_size += len(character.encode("utf-8"))
                if encoded_size > byte_limit:
                    break
        except UnicodeEncodeError as exc:
            raise CFError(
                f"server verification {field} must be valid UTF-8"
            ) from exc
        if encoded_size > byte_limit:
            raise CFError(
                f"server verification {field} exceeds the "
                f"{byte_limit}-byte limit"
            )
        return text

    @staticmethod
    def _policy_metadata_matches(
        metadata: os.stat_result,
        identity: tuple[int, int],
        physical_bytes: int,
    ) -> bool:
        return (
            stat.S_ISREG(metadata.st_mode)
            and metadata.st_nlink == 1
            and (metadata.st_dev, metadata.st_ino) == identity
            and metadata.st_size == physical_bytes
        )

    def _retain_empty_policy(self) -> tuple[dict[str, Any], int]:
        retained_bytes = self.POLICY_AST_BASE_BYTES
        permit = DecisionWorkPermit()
        self._policy_permit = permit
        self._ledger.reserve_into(
            permit,
            "record_read",
            acquires={"retained_bytes": retained_bytes},
        )
        try:
            self._consume_owned_acquisition(
                permit,
                phase="record_read",
                retained_bytes=retained_bytes,
            )
            self._policy_permit = None
            return {}, retained_bytes
        finally:
            self._cancel_owned_permit("_policy_permit")

    def _read_policy(self, path: Path) -> tuple[dict[str, Any], int]:
        if self._project_fd < 0:
            raise CFError("server verification project capability is unavailable")
        file_descriptor = -1
        raw: bytearray | None = None
        policy: dict[str, Any] | None = None
        temporary_bytes = 0
        permit: DecisionWorkPermit | None = None
        try:
            try:
                initial = os.stat(
                    path.name,
                    dir_fd=self._project_fd,
                    follow_symlinks=False,
                )
            except FileNotFoundError:
                return self._retain_empty_policy()
            if (
                not stat.S_ISREG(initial.st_mode)
                or initial.st_nlink != 1
                or initial.st_size > MAX_OBJECT_RECORD_BYTES
            ):
                raise CFError(f"bounded JSON file is invalid: {path}")
            physical_bytes = initial.st_size
            retained_bytes = (
                self.POLICY_AST_BASE_BYTES
                + self.POLICY_AST_BYTES_PER_INPUT_BYTE * physical_bytes
            )
            temporary_bytes = (
                self.POLICY_PARSE_BASE_BYTES
                + self.POLICY_PARSE_BYTES_PER_INPUT_BYTE * physical_bytes
            )
            read_permit = DecisionWorkPermit()
            self._policy_read_permit = read_permit
            self._ledger.reserve_into(
                read_permit,
                "record_read",
                charges={"aggregate_bytes": physical_bytes},
                counters={
                    "files_read": 1,
                    "file_bytes_read": physical_bytes,
                },
            )
            permit = DecisionWorkPermit()
            self._policy_permit = permit
            self._ledger.reserve_into(
                permit,
                "record_read",
                acquires={
                    "retained_bytes": retained_bytes,
                    "temporary_bytes": temporary_bytes,
                },
            )
            self._poll("upload server verification policy")
            self._consume_owned_acquisition(
                permit,
                phase="record_read",
                retained_bytes=retained_bytes,
                temporary_bytes=temporary_bytes,
            )
            self._policy_permit = None
            self._ledger.consume_reserved(
                read_permit,
                phase="record_read",
                charges={"aggregate_bytes": physical_bytes},
                counters={
                    "files_read": 1,
                    "file_bytes_read": physical_bytes,
                },
            )
            self._policy_read_permit = None
            file_descriptor = os.open(
                path.name,
                os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0),
                dir_fd=self._project_fd,
            )
            opened = os.fstat(file_descriptor)
            identity = (initial.st_dev, initial.st_ino)
            if (
                not self._policy_metadata_matches(
                    initial, identity, physical_bytes
                )
                or not self._policy_metadata_matches(
                    opened, identity, physical_bytes
                )
            ):
                raise CFError(f"bounded JSON file changed while reading: {path}")
            raw = bytearray()
            while len(raw) < physical_bytes:
                self._poll("upload server verification policy")
                chunk = os.read(
                    file_descriptor,
                    min(64 * 1024, physical_bytes - len(raw)),
                )
                if not chunk:
                    break
                raw.extend(chunk)
            extension = os.read(file_descriptor, 1)
            after = os.fstat(file_descriptor)
            try:
                named = os.stat(
                    path.name,
                    dir_fd=self._project_fd,
                    follow_symlinks=False,
                )
            except OSError as exc:
                raise CFError(
                    f"bounded JSON file changed while reading: {path}"
                ) from exc
            if (
                len(raw) != physical_bytes
                or extension
                or not self._policy_metadata_matches(
                    after, identity, physical_bytes
                )
                or not self._policy_metadata_matches(
                    named, identity, physical_bytes
                )
            ):
                raise CFError(f"bounded JSON file changed while reading: {path}")
            self._poll("upload server verification policy")
            try:
                loaded = json.loads(raw)
            except (UnicodeDecodeError, json.JSONDecodeError) as exc:
                raise CFError(f"invalid JSON: {path}: {exc}") from exc
            if not isinstance(loaded, dict):
                raise CFError("server verification policy must be an object")
            policy = loaded
            loaded = None
            self._policy = policy
            self._policy_fd = file_descriptor
            file_descriptor = -1
            self._policy_identity = identity
            self._policy_size = physical_bytes
            self._policy_digest = hashlib.sha256(raw).digest()
            self._policy_raw = raw
            raw = None
            self._release_owned("temporary_bytes", temporary_bytes)
            temporary_bytes = 0
            return policy, retained_bytes
        finally:
            raw = None
            self._cancel_owned_permit("_policy_read_permit")
            self._cancel_owned_permit("_policy_permit")
            if file_descriptor >= 0:
                os.close(file_descriptor)

    def _revalidate_project_identity(self) -> None:
        self._ensure_open()
        project_root = self._project_root
        project_identity = self._project_identity
        if project_root is None or project_identity is None or self._project_fd < 0:
            raise CFError("server verification project capability is unavailable")
        ambient_fd = -1
        try:
            ambient_fd = _open_directory_nofollow(project_root)
            pinned = os.fstat(self._project_fd)
            ambient = os.fstat(ambient_fd)
            expected_fingerprint = self._project_fingerprint
            if (
                not stat.S_ISDIR(pinned.st_mode)
                or not stat.S_ISDIR(ambient.st_mode)
                or (pinned.st_dev, pinned.st_ino) != project_identity
                or (ambient.st_dev, ambient.st_ino) != project_identity
                or (
                    expected_fingerprint is not None
                    and (
                        AccountedRemoteSignaturePolicyAuthority._fingerprint(
                            pinned
                        )
                        != expected_fingerprint
                        or AccountedRemoteSignaturePolicyAuthority._fingerprint(
                            ambient
                        )
                        != expected_fingerprint
                    )
                )
            ):
                raise CFError(
                    "server verification project changed before execution"
                )
        except OSError as exc:
            raise CFError(
                "server verification project changed before execution"
            ) from exc
        finally:
            if ambient_fd >= 0:
                os.close(ambient_fd)

    def _revalidate_missing_project(self) -> None:
        self._ensure_open()
        project_root = self._project_root
        if project_root is None or not self._requires_missing_project:
            raise CFError("server verification missing-project fence is unavailable")
        try:
            os.stat(project_root, follow_symlinks=False)
        except FileNotFoundError:
            return
        except OSError as exc:
            raise CFError(
                "server verification project changed before execution"
            ) from exc
        raise CFError("server verification project changed before execution")

    def _consume_policy_fence(self) -> None:
        permit = self._policy_fence_permit
        physical_bytes = self._policy_size
        if permit is None or physical_bytes is None:
            raise CFError("server verification policy fence is unavailable")
        self._ledger.consume_reserved(
            permit,
            phase="record_read",
            charges={"aggregate_bytes": physical_bytes},
            counters={
                "files_read": 1,
                "file_bytes_read": physical_bytes,
            },
        )
        if not self._ledger.permit_is_open(permit):
            self._policy_fence_permit = None

    def _revalidate_policy(self) -> None:
        self._ensure_open()
        if (
            self._project_fd < 0
            or self._policy_fd < 0
            or self._policy_identity is None
            or self._policy_size is None
            or self._policy_raw is None
            or self._policy_digest is None
        ):
            raise CFError("server verification policy fence is unavailable")
        self._consume_policy_fence()
        file_descriptor = -1
        raw: bytearray | None = None
        try:
            try:
                initial = os.stat(
                    "server_policy.json",
                    dir_fd=self._project_fd,
                    follow_symlinks=False,
                )
                file_descriptor = os.open(
                    "server_policy.json",
                    os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0),
                    dir_fd=self._project_fd,
                )
            except OSError as exc:
                raise CFError(
                    "server verification policy changed before execution"
                ) from exc
            pinned = os.fstat(self._policy_fd)
            opened = os.fstat(file_descriptor)
            if any(
                not self._policy_metadata_matches(
                    metadata, self._policy_identity, self._policy_size
                )
                for metadata in (pinned, initial, opened)
            ):
                raise CFError(
                    "server verification policy changed before execution"
                )
            raw = bytearray()
            while len(raw) < self._policy_size:
                self._poll("upload server verification policy fence")
                chunk = os.read(
                    file_descriptor,
                    min(64 * 1024, self._policy_size - len(raw)),
                )
                if not chunk:
                    break
                raw.extend(chunk)
            extension = os.read(file_descriptor, 1)
            after = os.fstat(file_descriptor)
            try:
                named = os.stat(
                    "server_policy.json",
                    dir_fd=self._project_fd,
                    follow_symlinks=False,
                )
            except OSError as exc:
                raise CFError(
                    "server verification policy changed before execution"
                ) from exc
            expected_fingerprint = self._policy_fingerprint
            if (
                len(raw) != self._policy_size
                or extension
                or not self._policy_metadata_matches(
                    after, self._policy_identity, self._policy_size
                )
                or not self._policy_metadata_matches(
                    named, self._policy_identity, self._policy_size
                )
                or hashlib.sha256(raw).digest() != self._policy_digest
                or raw != self._policy_raw
                or (
                    expected_fingerprint is not None
                    and any(
                        AccountedRemoteSignaturePolicyAuthority._fingerprint(
                            metadata
                        )
                        != expected_fingerprint
                        for metadata in (pinned, initial, opened, after, named)
                    )
                )
            ):
                raise CFError(
                    "server verification policy changed before execution"
                )
        finally:
            if raw is not None:
                raw.clear()
            if file_descriptor >= 0:
                os.close(file_descriptor)

    def _revalidate_subject(self) -> None:
        self._revalidate_project_identity()
        self._revalidate_policy()

    def _adopt_borrowed_policy(
        self, raw: bytes
    ) -> tuple[dict[str, Any], int]:
        """Parse one authority-owned immutable snapshot without copying it."""
        physical_bytes = len(raw)
        retained_bytes = (
            self.POLICY_AST_BASE_BYTES
            + self.POLICY_AST_BYTES_PER_INPUT_BYTE * physical_bytes
        )
        temporary_bytes = (
            self.POLICY_PARSE_BASE_BYTES
            + self.POLICY_PARSE_BYTES_PER_INPUT_BYTE * physical_bytes
        )
        permit = DecisionWorkPermit()
        self._policy_permit = permit
        self._ledger.reserve_into(
            permit,
            "record_read",
            acquires={
                "retained_bytes": retained_bytes,
                "temporary_bytes": temporary_bytes,
            },
        )
        parsed: Any = None
        try:
            self._consume_owned_acquisition(
                permit,
                phase="record_read",
                retained_bytes=retained_bytes,
                temporary_bytes=temporary_bytes,
            )
            self._policy_permit = None
            self._policy_raw = raw
            try:
                parsed = json.loads(raw)
            except json.JSONDecodeError as error:
                message = (
                    "server verification policy JSON is invalid: "
                    f"{error.msg}: line {error.lineno} column {error.colno}"
                )
                _detach_exception_chain(error)
                raise CFError(message) from None
            except UnicodeDecodeError as error:
                message = (
                    "server verification policy UTF-8 is invalid: "
                    f"byte {error.start}: {error.reason}"
                )
                _detach_exception_chain(error)
                raise CFError(message) from None
            if not isinstance(parsed, dict):
                raise CFError("server verification policy must be an object")
            policy = parsed
            parsed = None
            self._policy = policy
            self._policy_digest = hashlib.sha256(raw).digest()
            self._release_owned("temporary_bytes", temporary_bytes)
            return policy, retained_bytes
        finally:
            parsed = None
            self._cancel_owned_permit("_policy_permit")

    def _adopt_signature_policy_authority(
        self,
        authority: AccountedRemoteSignaturePolicyAuthority,
        project_root: Path,
        *,
        allow_missing_project: bool,
    ) -> tuple[bool, dict[str, Any], int]:
        """Duplicate capabilities and borrow P0 directly from its authority."""
        authority._ensure_open(self._ledger)
        if (
            not authority._verification_bound
            or not authority._verification_constructing
            or authority._policy_owner is not None
            or authority._verification_owner is not self
        ):
            raise CFError("server verification policy handoff is unavailable")
        if authority._project_root != Path(os.path.abspath(project_root)):
            raise CFError("server verification policy authority project differs")
        raw = authority._policy_raw
        if raw is None:
            raise CFError("server verification policy authority has no raw policy")
        project_missing = bool(authority._missing_parts)
        if project_missing:
            if not allow_missing_project:
                raise CFError(
                    f"server verification project is unavailable: {project_root}"
                )
        else:
            if allow_missing_project:
                raise CFError(
                    "server verification project changed before execution"
                )
            if authority._project_fd < 0:
                raise CFError(
                    "server verification project capability is unavailable"
                )
            self._project_fd = os.dup(authority._project_fd)
            expected_project = authority._project_fingerprint
            opened_project = os.fstat(self._project_fd)
            if (
                expected_project is None
                or authority._fingerprint(opened_project) != expected_project
            ):
                raise SignaturePolicySubjectChanged(
                    project_root, "verification_project_identity"
                )
            self._project_fingerprint = expected_project
            self._project_identity = (
                opened_project.st_dev,
                opened_project.st_ino,
            )
            if not authority._policy_missing:
                if authority._policy_fd < 0:
                    raise CFError(
                        "server verification policy capability is unavailable"
                    )
                self._policy_fd = os.dup(authority._policy_fd)
                expected_policy = authority._policy_fingerprint
                opened_policy = os.fstat(self._policy_fd)
                if (
                    expected_policy is None
                    or authority._fingerprint(opened_policy) != expected_policy
                ):
                    raise SignaturePolicySubjectChanged(
                        remote_policy_path(project_root),
                        "verification_policy_identity",
                    )
                self._policy_fingerprint = expected_policy
                self._policy_identity = (
                    opened_policy.st_dev,
                    opened_policy.st_ino,
                )
                self._policy_size = opened_policy.st_size
        policy, retained = self._adopt_borrowed_policy(raw)
        return project_missing, policy, retained

    def _prepare(
        self,
        project_root: Path,
        branch: str,
        commit_id: str,
        *,
        allow_missing_project: bool,
        signature_policy_authority: (
            AccountedRemoteSignaturePolicyAuthority | None
        ) = None,
    ) -> None:
        if (
            sys.implementation.name != "cpython"
            or not sys.platform.startswith("linux")
            or not Path("/proc/self/fd").is_dir()
        ):
            raise CFError(
                "server verification requires CPython on Linux with "
                "directory capabilities"
            )
        project_missing = False
        if signature_policy_authority is not None:
            project_missing, policy, policy_retained = (
                self._adopt_signature_policy_authority(
                    signature_policy_authority,
                    project_root,
                    allow_missing_project=allow_missing_project,
                )
            )
        else:
            try:
                self._project_fd = _open_directory_nofollow(project_root)
            except FileNotFoundError as exc:
                if not allow_missing_project:
                    raise CFError(
                        f"server verification project is unavailable: {project_root}"
                    ) from exc
                project_missing = True
            except OSError as exc:
                raise CFError(
                    f"server verification project is unavailable: {project_root}"
                ) from exc
            if allow_missing_project and not project_missing:
                self._close_owned_capability("_project_fd")
                raise CFError(
                    "server verification project changed before execution"
                )
            if project_missing:
                policy, policy_retained = self._retain_empty_policy()
            else:
                project_metadata = os.fstat(self._project_fd)
                if not stat.S_ISDIR(project_metadata.st_mode):
                    raise CFError(
                        f"server verification project is unavailable: {project_root}"
                    )
                self._project_identity = (
                    project_metadata.st_dev,
                    project_metadata.st_ino,
                )
                self._poll("upload server verification policy")
                policy, policy_retained = self._read_policy(
                    remote_policy_path(project_root)
                )
        self._policy = policy
        verification = policy.get("verification", {})
        if not isinstance(verification, dict):
            raise CFError("server verification policy must be an object")
        checks = verification.get("required", [])
        if not isinstance(checks, list):
            raise CFError("server verification required checks must be an array")
        active_count = 0
        custom_env_entries = 0
        project_text = (
            os.fspath(project_root)
            if project_missing
            else f"/proc/self/fd/{self._project_fd}"
        )
        path_text = os.environ.get("PATH", "")
        home_text = os.environ.get("HOME", "")
        for check in checks:
            if not isinstance(check, dict):
                raise CFError("server verification check must be an object")
            if check.get("command"):
                active_count += 1
                custom_env = check.get("env", {})
                if isinstance(custom_env, dict):
                    custom_env_entries += len(custom_env)
        config_retained = (
            self.CONFIG_BASE_BYTES
            + active_count
            * (
                self.CONFIG_LIST_SLOT_BYTES
                + self.CONFIG_PLAN_BASE_BYTES
                + self.CAPABILITY_FRAME_BYTES
                + self.CONFIG_TEXT_OWNER_BYTES * 2
                + self.CONFIG_ENV_ENTRY_BYTES * 5
            )
            + custom_env_entries
            * (
                self.CONFIG_ENV_ENTRY_BYTES
                + self.CONFIG_TEXT_OWNER_BYTES * 2
            )
            + self._text_upper(project_text)
            + self._text_upper(path_text)
            + self._text_upper(home_text)
        )
        config_permit = DecisionWorkPermit()
        self._config_permit = config_permit
        self._ledger.reserve_into(
            config_permit,
            "semantic_validation",
            acquires={"retained_bytes": config_retained},
        )
        plans: list[tuple[str, str, int, float, dict[str, str]]] | None = None
        env: dict[str, str] | None = None
        cwd_fd = -1
        try:
            self._poll("upload server verification planning")
            self._consume_owned_acquisition(
                config_permit,
                phase="semantic_validation",
                retained_bytes=config_retained,
            )
            self._config_permit = None
            plans = []
            for check in checks:
                self._poll("upload server verification planning")
                command_value = check.get("command")
                if not command_value:
                    continue
                if not isinstance(command_value, str):
                    raise CFError(
                        "server verification failed: command must be a string"
                    )
                check_id = self._bounded_plan_text(
                    check.get("id", "server-verification"),
                    "check ID",
                    self.CHECK_ID_LIMIT_BYTES,
                )
                cwd_value = self._bounded_plan_text(
                    check.get("cwd", "."), "cwd"
                )
                cwd_fd = self._open_cwd_capability(
                    self._project_fd, cwd_value, check_id
                )
                try:
                    timeout = float(check.get("timeout_seconds", 30))
                except (OverflowError, TypeError, ValueError) as exc:
                    raise CFError(
                        f"server verification failed: {check_id}: "
                        "timeout_seconds must be a number"
                    ) from exc
                if not math.isfinite(timeout) or timeout <= 0:
                    raise CFError(
                        f"server verification failed: {check_id}: "
                        "timeout_seconds must be positive"
                    )
                env = {
                    "PATH": path_text,
                    "HOME": home_text,
                }
                custom_env = check.get("env", {})
                if custom_env:
                    if not isinstance(custom_env, dict):
                        raise CFError(
                            f"server verification failed: {check_id}: "
                            "env must be an object"
                        )
                    for key, value in custom_env.items():
                        env[
                            self._bounded_plan_text(key, "environment key")
                        ] = self._bounded_plan_text(
                            value, "environment value"
                        )
                env.update(
                    {
                        "CODEFIRE_REMOTE_PROJECT": project_text,
                        "CODEFIRE_REMOTE_BRANCH": branch,
                        "CODEFIRE_REMOTE_COMMIT": commit_id,
                    }
                )
                plans.append((check_id, command_value, cwd_fd, timeout, env))
                cwd_fd = -1
                env = None
            self._plans = plans
            plans = None
            config_acquired = False
        except BaseException:
            if plans is not None:
                self._orphaned_plans = plans
                plans = None
            env = None
            if cwd_fd >= 0:
                self._orphaned_cwd_fd = cwd_fd
                cwd_fd = -1
            raise
        finally:
            self._cancel_owned_permit("_config_permit")

        if active_count:
            if self._policy_size is None:
                raise CFError("server verification policy fence is unavailable")
            fence_temporary = (
                self.POLICY_FENCE_BASE_BYTES
                + self.POLICY_FENCE_BYTES_PER_INPUT_BYTE * self._policy_size
            )
            self._policy_fence_permit = DecisionWorkPermit()
            self._ledger.reserve_into(
                self._policy_fence_permit,
                "record_read",
                charges={
                    "aggregate_bytes": self._policy_size * active_count,
                },
                counters={
                    "files_read": active_count,
                    "file_bytes_read": self._policy_size * active_count,
                },
            )
            self._policy_fence_storage_permit = DecisionWorkPermit()
            self._ledger.reserve_into(
                self._policy_fence_storage_permit,
                "record_read",
                acquires={"temporary_bytes": fence_temporary},
            )
            maximum_read = self._output_limit_bytes + 1
            output_temporary = (
                self.OUTPUT_MEMORY_BASE_BYTES
                + self.OUTPUT_MEMORY_MULTIPLIER * maximum_read
                + self.OUTPUT_READ_CHUNK_BYTES
            )
            self._output_permit = DecisionWorkPermit()
            self._ledger.reserve_into(
                self._output_permit,
                "semantic_validation",
                charges={
                    "aggregate_bytes": (
                        maximum_read + self.FAILURE_CONTROL_LIMIT_BYTES
                    )
                    * active_count
                },
            )
            self._output_storage_permit = DecisionWorkPermit()
            self._ledger.reserve_into(
                self._output_storage_permit,
                "semantic_validation",
                acquires={"temporary_bytes": output_temporary},
            )
        if project_missing:
            self._revalidate_missing_project()
        else:
            self._revalidate_project_identity()

    def _ensure_open(self) -> None:
        if self._closed:
            raise CFError("server verification owner is closed")
        if id(self._ledger) != self._ledger_identity:
            raise CFError("server verification owner belongs to a different ledger")

    @staticmethod
    def _open_cwd_capability(
        project_fd: int, cwd_value: str, check_id: str
    ) -> int:
        relative = Path(cwd_value)
        if relative.is_absolute() or any(
            component == ".." for component in relative.parts
        ):
            raise CFError(
                f"server verification failed: {check_id}: "
                "cwd escapes remote project"
            )
        current_fd = os.dup(project_fd)
        try:
            for component in relative.parts:
                if component in {"", "."}:
                    continue
                next_fd = os.open(
                    component,
                    os.O_RDONLY
                    | getattr(os, "O_DIRECTORY", 0)
                    | getattr(os, "O_NOFOLLOW", 0),
                    dir_fd=current_fd,
                )
                os.close(current_fd)
                current_fd = next_fd
            return current_fd
        except FileNotFoundError as exc:
            os.close(current_fd)
            raise CFError(
                f"server verification failed: {check_id}: "
                f"cwd does not exist: {cwd_value}"
            ) from exc
        except OSError as exc:
            os.close(current_fd)
            raise CFError(
                f"server verification failed: {check_id}: "
                f"cwd is not a stable directory: {cwd_value}"
            ) from exc

    _close_capability = staticmethod(_CLOSE_FILE_DESCRIPTOR)

    def _close_plan_capabilities(
        self,
        plans: list[tuple[str, str, int, float, dict[str, str]]],
    ) -> None:
        while plans:
            # Do not retain the popped payload in an exception traceback if
            # the builtin close reports a failure.
            cwd_fd = plans.pop()[2]
            self._close_capability(cwd_fd)

    @staticmethod
    def _spawn_process(
        command: str,
        cwd_fd: int,
        project_fd: int,
        env: dict[str, str],
    ) -> subprocess.Popen[bytes]:
        return subprocess.Popen(
            command,
            shell=True,
            cwd=f"/proc/self/fd/{cwd_fd}",
            env=env,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            start_new_session=True,
            pass_fds=(cwd_fd, project_fd),
        )

    @staticmethod
    def _read_pipe(file_descriptor: int, size: int) -> bytes:
        return os.read(file_descriptor, size)

    @staticmethod
    def _kill_process(process: subprocess.Popen[bytes]) -> None:
        try:
            os.killpg(process.pid, signal.SIGKILL)
        except ProcessLookupError:
            pass

    @staticmethod
    def _wait_process(
        process: subprocess.Popen[bytes], timeout: float
    ) -> int:
        return process.wait(timeout=timeout)

    def _stop_process(self) -> None:
        process = self._process
        if process is None:
            return
        cleanup_error: BaseException | None = None
        if process.poll() is None:
            try:
                self._kill_process(process)
            except BaseException as exc:
                cleanup_error = exc
                try:
                    os.killpg(process.pid, signal.SIGKILL)
                except ProcessLookupError:
                    pass
                except BaseException as fallback_exc:
                    if cleanup_error is None:
                        cleanup_error = fallback_exc
        reaped = False
        try:
            self._wait_process(process, self.PROCESS_REAP_SECONDS)
            reaped = True
        except BaseException as exc:
            if cleanup_error is None:
                cleanup_error = exc
            try:
                process.kill()
            except BaseException:
                pass
            try:
                process.wait(timeout=self.PROCESS_REAP_SECONDS)
                reaped = True
            except BaseException:
                pass
        if reaped:
            if process.stdout is not None:
                process.stdout.close()
            self._process = None
        if cleanup_error is not None:
            detail = cleanup_error.args[0] if cleanup_error.args else "cleanup fault"
            if not isinstance(detail, str):
                detail = type(cleanup_error).__name__
            detail = self._truncate_failure_text(detail, 1024)
            raise CFError(
                f"server verification process cleanup failed: {detail}"
            ) from cleanup_error

    def _request_remaining_seconds(self) -> float | None:
        deadline = self._deadline
        if deadline is None or deadline.limit_ms is None:
            return None
        return max(
            0.0,
            deadline.limit_ms / 1000 - (deadline.last_observed - deadline.started_at),
        )

    def _consume_output_bytes(self, amount: int) -> None:
        permit = self._output_permit
        if permit is None:
            raise CFError("server verification output reservation is unavailable")
        self._ledger.consume_reserved(
            permit,
            phase="semantic_validation",
            charges={"aggregate_bytes": amount},
        )

    @classmethod
    def _truncate_failure_text(cls, value: str, limit: int) -> str:
        encoded = value.encode("utf-8", errors="replace")
        if len(encoded) <= limit:
            return value
        return encoded[:limit].decode("utf-8", errors="ignore")

    def _failure(self, message: str) -> CFError:
        bounded = self._truncate_failure_text(
            message, self.FAILURE_CONTROL_LIMIT_BYTES
        )
        encoded_size = len(bounded.encode("utf-8"))
        permit = self._output_permit
        if permit is not None:
            self._ledger.consume_reserved(
                permit,
                phase="semantic_validation",
                charges={"aggregate_bytes": encoded_size},
            )
        self._failure_message = bounded
        return CFError(bounded)

    def _format_failure(self, prefix: str, output: bytearray) -> CFError:
        total_bytes = len(output)
        digest = hashlib.sha256(output).hexdigest()
        sample = bytes(output[: self.FAILURE_SAMPLE_LIMIT_BYTES])
        rendered = sample.decode("utf-8", errors="replace").strip()
        if total_bytes <= self.FAILURE_SAMPLE_LIMIT_BYTES:
            message = f"{prefix}: {rendered}"
        else:
            message = (
                f"{prefix}: {rendered} "
                f"[output truncated; total_bytes={total_bytes}; sha256={digest}]"
            )
        sample = b""
        rendered = ""
        return self._failure(message)

    def _run_plan(
        self, plan: tuple[str, str, int, float, dict[str, str]]
    ) -> None:
        check_id, command, cwd_fd, timeout, env = plan
        self._revalidate_subject()
        self._poll("upload server verification execution")
        started = time.monotonic()
        process = self._spawn_process(
            command, cwd_fd, self._project_fd, env
        )
        self._process = process
        if process.stdout is None:
            self._stop_process()
            raise CFError(
                f"server verification failed: {check_id}: output pipe is unavailable"
            )
        output = bytearray()
        selector = selectors.DefaultSelector()
        try:
            file_descriptor = process.stdout.fileno()
            os.set_blocking(file_descriptor, False)
            selector.register(file_descriptor, selectors.EVENT_READ)
            while True:
                self._poll("upload server verification execution")
                elapsed = time.monotonic() - started
                if elapsed >= timeout:
                    self._stop_process()
                    raise self._format_failure(
                        "server verification failed: "
                        f"{check_id}: timed out after {timeout:g}s",
                        output,
                    )
                request_remaining = self._request_remaining_seconds()
                wait_seconds = min(
                    self.PROCESS_POLL_SECONDS,
                    max(0.0, timeout - elapsed),
                )
                if request_remaining is not None:
                    wait_seconds = min(wait_seconds, request_remaining)
                events = selector.select(wait_seconds)
                for _key, _mask in events:
                    remaining = self._output_limit_bytes + 1 - len(output)
                    if remaining <= 0:
                        break
                    try:
                        chunk = self._read_pipe(
                            file_descriptor,
                            min(self.OUTPUT_READ_CHUNK_BYTES, remaining),
                        )
                    except BlockingIOError:
                        continue
                    if chunk:
                        self._consume_output_bytes(len(chunk))
                        output.extend(chunk)
                if len(output) > self._output_limit_bytes:
                    self._stop_process()
                    raise self._format_failure(
                        f"server verification failed: {check_id}: output exceeds "
                        f"the {self._output_limit_bytes}-byte limit",
                        output,
                    )
                return_code = process.poll()
                if return_code is None:
                    continue
                while len(output) <= self._output_limit_bytes:
                    remaining = self._output_limit_bytes + 1 - len(output)
                    if remaining <= 0:
                        break
                    try:
                        chunk = self._read_pipe(
                            file_descriptor,
                            min(self.OUTPUT_READ_CHUNK_BYTES, remaining),
                        )
                    except BlockingIOError:
                        break
                    if not chunk:
                        break
                    self._consume_output_bytes(len(chunk))
                    output.extend(chunk)
                if len(output) > self._output_limit_bytes:
                    self._stop_process()
                    raise self._format_failure(
                        f"server verification failed: {check_id}: output exceeds "
                        f"the {self._output_limit_bytes}-byte limit",
                        output,
                    )
                self._wait_process(process, self.PROCESS_REAP_SECONDS)
                process.stdout.close()
                self._process = None
                if return_code != 0:
                    raise self._format_failure(
                        f"server verification failed: {check_id}", output
                    )
                return
        except BaseException:
            if self._process is not None:
                self._stop_process()
            raise
        finally:
            selector.close()
            output.clear()

    def run(self) -> None:
        if self._constructing:
            raise CFError("server verification child construction is in progress")
        self._ensure_open()
        if self._started:
            raise CFError("server verification owner is single-use")
        self._started = True
        self._poll("upload server verification execution")
        if self._requires_missing_project:
            self._revalidate_missing_project()
        policy_storage_permit = self._policy_fence_storage_permit
        if policy_storage_permit is not None:
            if self._policy_size is None:
                raise CFError("server verification policy fence is unavailable")
            fence_temporary = (
                self.POLICY_FENCE_BASE_BYTES
                + self.POLICY_FENCE_BYTES_PER_INPUT_BYTE * self._policy_size
            )
            self._consume_owned_acquisition(
                policy_storage_permit,
                phase="record_read",
                temporary_bytes=fence_temporary,
            )
            self._policy_fence_storage_permit = None
        output_storage_permit = self._output_storage_permit
        if output_storage_permit is not None:
            output_temporary = (
                self.OUTPUT_MEMORY_BASE_BYTES
                + self.OUTPUT_MEMORY_MULTIPLIER
                * (self._output_limit_bytes + 1)
                + self.OUTPUT_READ_CHUNK_BYTES
            )
            self._consume_owned_acquisition(
                output_storage_permit,
                phase="semantic_validation",
                temporary_bytes=output_temporary,
            )
            self._output_storage_permit = None
        try:
            for plan in self._plans or ():
                self._run_plan(plan)
        finally:
            self._cancel_owned_permit("_policy_fence_storage_permit")
            policy_permit = self._policy_fence_permit
            if policy_permit is not None and self._ledger.permit_is_open(
                policy_permit
            ):
                self._ledger.cancel_permit(policy_permit)
            self._policy_fence_permit = None
            self._cancel_owned_permit("_output_storage_permit")
            permit = self._output_permit
            if permit is not None and self._ledger.permit_is_open(permit):
                self._ledger.cancel_permit(permit)
            self._output_permit = None
        self._completed = True

    def close(self) -> None:
        if self._constructing:
            raise CFError("server verification child construction is in progress")
        if self._closed:
            return
        if id(self._ledger) != self._ledger_identity:
            raise CFError("server verification owner belongs to a different ledger")
        if self._process is not None:
            self._stop_process()
        self._cancel_owned_permit("_config_permit")
        self._cancel_owned_permit("_policy_read_permit")
        self._cancel_owned_permit("_policy_permit")
        self._cancel_owned_permit("_capability_permit")
        self._cancel_owned_permit("_policy_fence_storage_permit")
        policy_permit = self._policy_fence_permit
        if policy_permit is not None and self._ledger.permit_is_open(
            policy_permit
        ):
            self._ledger.cancel_permit(policy_permit)
        self._policy_fence_permit = None
        self._cancel_owned_permit("_output_storage_permit")
        permit = self._output_permit
        if permit is not None and self._ledger.permit_is_open(permit):
            self._ledger.cancel_permit(permit)
        self._output_permit = None
        if self._orphaned_plans is not None:
            self._close_plan_capabilities(self._orphaned_plans)
            self._orphaned_plans.clear()
            self._orphaned_plans = None
        self._close_owned_capability("_orphaned_cwd_fd")
        if self._plans is not None:
            self._close_plan_capabilities(self._plans)
            self._plans.clear()
            self._plans = None
        self._close_owned_capability("_policy_fd")
        self._close_owned_capability("_project_fd")
        if self._policy is not None:
            self._policy.clear()
            self._policy = None
        if isinstance(self._policy_raw, bytearray):
            self._policy_raw.clear()
        self._policy_raw = None
        self._policy_digest = None
        self._policy_identity = None
        self._policy_fingerprint = None
        self._policy_size = None
        self._project_identity = None
        self._project_fingerprint = None
        self._project_root = None
        self._failure_message = None
        self._resume_pending_release()
        if self._pending_acquisition is not None:
            raise CFError(
                "server verification acquisition transition is pending"
            )
        if self._temporary_bytes:
            self._release_owned("temporary_bytes", self._temporary_bytes)
        if self._retained_bytes:
            self._release_owned("retained_bytes", self._retained_bytes)
        self._closed = True

    def __del__(self) -> None:
        try:
            self.close()
        except BaseException:
            pass


def prepare_server_verification(
    project_root: Path,
    branch: str,
    commit_id: str,
    ledger: DecisionWorkLedger,
    deadline: HTTPRequestDeadline | None = None,
    *,
    output_limit_bytes: int = AccountedServerVerification.DEFAULT_OUTPUT_LIMIT_BYTES,
    allow_missing_project: bool = False,
) -> AccountedServerVerification:
    """Prepare an effect-free, single-use server verification owner."""
    return AccountedServerVerification(
        project_root,
        branch,
        commit_id,
        ledger,
        deadline,
        output_limit_bytes=output_limit_bytes,
        allow_missing_project=allow_missing_project,
    )


def run_server_verification(
    project_root: Path,
    branch: str,
    commit_id: str,
    ledger: DecisionWorkLedger | None = None,
    deadline: HTTPRequestDeadline | None = None,
    *,
    output_limit_bytes: int = AccountedServerVerification.DEFAULT_OUTPUT_LIMIT_BYTES,
    allow_missing_project: bool = False,
) -> None:
    active_ledger = ledger or DecisionWorkLedger(
        DecisionWorkProfile.local_v1(), "server verification"
    )
    owner = prepare_server_verification(
        project_root,
        branch,
        commit_id,
        active_ledger,
        deadline,
        output_limit_bytes=output_limit_bytes,
        allow_missing_project=allow_missing_project,
    )
    run_error: BaseException | None = None
    try:
        owner.run()
    except BaseException as exc:
        owner._detach_exception_tracebacks(exc)
        run_error = exc
    cleanup_error: BaseException | None = None
    try:
        owner.close()
    except BaseException as exc:
        owner._detach_exception_tracebacks(exc)
        cleanup_error = exc
    if cleanup_error is not None:
        if run_error is not None:
            raise cleanup_error from run_error
        raise cleanup_error
    if run_error is not None:
        raise run_error from None


def ensure_repo_layout(repo_root: Path) -> None:
    dirs = repo_dirs(repo_root)
    for path in dirs.values():
        path.mkdir(parents=True, exist_ok=True)
    for typ in [
        "blobs",
        "content_manifests",
        "atom_indexes",
        "trace_graphs",
        "fire_ledgers",
        "resolution_ledgers",
        "verifications",
        "policies",
        "commits",
        "branches",
    ]:
        (dirs["objects"] / typ).mkdir(parents=True, exist_ok=True)


def object_subdir(type_tag: str) -> str:
    return {
        "blob": "blobs",
        "content_manifest": "content_manifests",
        "atom_index": "atom_indexes",
        "trace_graph": "trace_graphs",
        "fire_ledger": "fire_ledgers",
        "resolution_ledger": "resolution_ledgers",
        "verification": "verifications",
        "policy": "policies",
        "commit": "commits",
        "branch": "branches",
    }[type_tag]


def store_object(repo_root: Path, type_tag: str, payload: Any) -> str:
    oid = object_id(type_tag, payload)
    path = repo_dirs(repo_root)["objects"] / object_subdir(type_tag) / f"{oid}.json"
    with file_lock(repo_dirs(repo_root)["locks"] / "object-store.lock"):
        if path.exists():
            existing = read_json(path)
            if object_id(type_tag, existing["payload"]) != oid:
                raise CFError(f"object hash mismatch for existing object: {oid}")
            return oid
        record = {
            "object_id": oid,
            "type": type_tag,
            "hash": object_digest(type_tag, payload),
            "payload": payload,
        }
        write_json(path, record)
        return oid


def validate_object_record(
    record: dict[str, Any],
    expected_oid: str | None = None,
    path: Path | None = None,
    poll: Any | None = None,
) -> None:
    version = record.get("version", 1)
    if isinstance(version, bool) or version != 1:
        raise CFError(f"unsupported object_record.version {version}; readable version is 1")
    extensions = record.get("extensions", [])
    if not isinstance(extensions, list) or len(extensions) > 128:
        raise CFError("object extensions must be an array with at most 128 descriptors")
    for extension in extensions:
        if poll is not None:
            poll()
        if (
            not isinstance(extension, dict)
            or not isinstance(extension.get("namespace"), str)
            or not extension.get("namespace")
            or not isinstance(extension.get("name"), str)
            or not extension.get("name")
            or not isinstance(extension.get("version"), int)
            or isinstance(extension.get("version"), bool)
            or not isinstance(extension.get("critical"), bool)
        ):
            raise CFError("object extension descriptor is malformed")
        if extension["critical"]:
            raise CFError(
                "unsupported critical object extension: "
                f"{extension['namespace']}/{extension['name']}"
            )
        references = extension.get("references", [])
        if not isinstance(references, list):
            raise CFError("object extension references must be a string array")
        for reference in references:
            if poll is not None:
                poll()
            if not isinstance(reference, str):
                raise CFError("object extension references must be a string array")
    type_tag = record.get("type")
    payload = record.get("payload")
    if not type_tag or payload is None:
        raise CFError(f"object record is incomplete: {path or expected_oid or '(unknown)'}")
    computed_hash = object_digest(type_tag, payload, poll)
    record_oid = record.get("object_id")
    if not isinstance(record_oid, str) or not object_id_matches_digest(
        record_oid, type_tag, computed_hash
    ):
        raise CFError(f"object hash mismatch: {expected_oid or record.get('object_id') or path}")
    if record.get("hash") != computed_hash:
        raise CFError(f"object record hash mismatch: {expected_oid or record_oid}")
    if expected_oid and expected_oid != record_oid:
        raise CFError(f"object filename/id mismatch: {expected_oid}")
    if path is not None and path.stem != record_oid:
        raise CFError(f"object filename/id mismatch: {path}")


def load_object(repo_root: Path, oid: str) -> Any:
    return load_object_from_root(repo_dirs(repo_root)["objects"], oid)


def exact_object_record_location(oid: str) -> tuple[str, str]:
    for type_tag, prefix in OBJECT_PREFIXES.items():
        marker = prefix + "-"
        if not oid.startswith(marker):
            continue
        suffix = oid[len(marker) :]
        if len(suffix) in {12, 24} and all(
            character in "0123456789abcdef" for character in suffix
        ):
            return object_subdir(type_tag), f"{oid}.json"
        break
    raise CFError(f"invalid object id: {oid}")


def object_record_path(objects_root: Path, oid: str) -> Path | None:
    """Resolve one exact object path without store enumeration or glob syntax."""
    try:
        subdir, file_name = exact_object_record_location(oid)
    except CFError:
        return None
    path = objects_root / subdir / file_name
    try:
        metadata = path.lstat()
    except FileNotFoundError:
        return None
    return path if stat.S_ISREG(metadata.st_mode) else None


def load_object_from_root(objects_root: Path, oid: str) -> Any:
    return load_object_record_from_root(objects_root, oid)["payload"]


def load_object_record_from_root(objects_root: Path, oid: str) -> dict[str, Any]:
    try:
        subdir, file_name = exact_object_record_location(oid)
    except CFError as exc:
        raise CFError(f"object not found: {oid}") from exc
    path = objects_root / subdir / file_name
    try:
        root_fd = _open_directory_nofollow(objects_root)
    except OSError as exc:
        raise CFError(f"object not found: {oid}")
    subdir_fd = -1
    try:
        subdir_fd = os.open(
            subdir,
            os.O_RDONLY
            | getattr(os, "O_DIRECTORY", 0)
            | getattr(os, "O_NOFOLLOW", 0),
            dir_fd=root_fd,
        )
        raw = _read_regular_bounded_at(
            subdir_fd, file_name, MAX_OBJECT_RECORD_BYTES
        )
    except (OSError, CFError) as exc:
        raise CFError(f"object not found: {oid}") from exc
    finally:
        if subdir_fd >= 0:
            os.close(subdir_fd)
        os.close(root_fd)
    try:
        record = json.loads(raw)
    except (UnicodeDecodeError, json.JSONDecodeError) as exc:
        raise CFError(f"invalid object JSON: {path}: {exc}") from exc
    validate_object_record(record, expected_oid=oid, path=path)
    return record


_DEFAULT_LOAD_OBJECT_FROM_ROOT = load_object_from_root


def object_record_core(record: dict[str, Any]) -> dict[str, Any]:
    return {key: value for key, value in record.items() if key != "remote"}


def record_with_generation(record: dict[str, Any], generation: int) -> dict[str, Any]:
    copied = object_record_core(record)
    remote = record.get("remote", {}) if isinstance(record.get("remote"), dict) else {}
    first_seen = remote.get("first_seen_generation", generation)
    copied["remote"] = {
        "first_seen_generation": int(first_seen),
        "last_seen_generation": generation,
    }
    return copied


def copy_object_record(
    src_objects: Path,
    dest_objects: Path,
    oid: str,
    generation: int | None = None,
    *,
    stage: Any | None = None,
    deadline: HTTPRequestDeadline | None = None,
) -> None:
    src = object_record_path(src_objects, oid)
    if not src:
        raise CFError(f"object not found while copying: {oid}")
    record = (
        _read_http_upload_stage_record(
            src,
            oid,
            stage.checked_existing_size(src, oid),
            deadline,
            stage,
        )
        if stage is not None
        else read_json(src)
    )
    validate_object_record(record, expected_oid=oid, path=src)
    dest = dest_objects / src.parent.name / src.name
    if dest.exists():
        existing = read_json(dest)
        validate_object_record(existing, expected_oid=oid, path=dest)
        if object_record_core(existing) != object_record_core(record):
            raise CFError(f"remote object collision: {oid}")
        if generation is not None:
            write_json(dest, record_with_generation(existing, generation))
        return
    if stage is not None and generation is None:
        stage._ensure_open()
        serialized_size = _object_record_core_json_size(
            record,
            None
            if deadline is None
            else lambda: deadline.check("upload staging serialization"),
        ) + 1
        stage.consume_serialization(serialized_size)
        serialized = _serialize_object_record_core(record)
        record.clear()
        record = None
        if len(serialized) > MAX_OBJECT_RECORD_BYTES:
            raise CFError(
                "object record exceeds the "
                f"{MAX_OBJECT_RECORD_BYTES}-byte serialization limit"
            )
        if deadline is not None:
            deadline.check("upload staging serialization")
        _write_serialized_json(dest, serialized, deadline)
        serialized = None
    elif generation is not None:
        write_json(dest, record_with_generation(record, generation))
    else:
        write_json(dest, object_record_core(record))


def object_references(payload: Any) -> list[str]:
    typ = payload.get("type") if isinstance(payload, dict) else None
    if typ == "commit":
        roots = payload.get("roots", {})
        parents = payload.get("parents", [])
        refs = [parent for parent in parents if isinstance(parent, str) and parent.startswith("CF-")] if isinstance(parents, list) else []
        if not isinstance(roots, dict):
            return refs
        refs.extend(v for v in roots.values() if isinstance(v, str) and v.startswith("CF-"))
        return refs
    if typ == "content_manifest":
        entries = payload.get("entries", [])
        if not isinstance(entries, list):
            return []
        return [entry["blob"] for entry in entries if isinstance(entry, dict) and entry.get("blob")]
    return []


def object_record_references(record: dict[str, Any]) -> list[str]:
    refs: list[str] = []
    visit_object_record_references(record, refs.append)
    return refs


def visit_object_record_references(
    record: dict[str, Any], visit: Any, poll: Any | None = None
) -> None:
    """Visit references in the legacy source order without a full refs allocation."""
    def check() -> None:
        if poll is not None:
            poll()

    payload = record.get("payload")
    typ = payload.get("type") if isinstance(payload, dict) else None
    if typ == "commit":
        parents = payload.get("parents", [])
        if isinstance(parents, list):
            for parent in parents:
                check()
                if isinstance(parent, str) and parent.startswith("CF-"):
                    visit(parent)
        roots = payload.get("roots", {})
        if isinstance(roots, dict):
            for root in roots.values():
                check()
                if isinstance(root, str) and root.startswith("CF-"):
                    visit(root)
    elif typ == "content_manifest":
        entries = payload.get("entries", [])
        if isinstance(entries, list):
            for entry in entries:
                check()
                if isinstance(entry, dict):
                    blob = entry.get("blob")
                    if isinstance(blob, str) and blob.startswith("CF-"):
                        visit(blob)
    extensions = record.get("extensions", [])
    if isinstance(extensions, list):
        for extension in extensions:
            check()
            if not isinstance(extension, dict):
                continue
            references = extension.get("references", [])
            if not isinstance(references, list):
                continue
            for reference in references:
                check()
                if isinstance(reference, str) and reference.startswith("CF-"):
                    visit(reference)


def copy_object_graph(src_objects: Path, dest_objects: Path, root_oid: str, generation: int | None = None) -> None:
    seen: set[str] = set()
    stack = [root_oid]
    while stack:
        oid = stack.pop()
        if oid in seen:
            continue
        seen.add(oid)
        copy_object_record(src_objects, dest_objects, oid, generation)
        record = load_object_record_from_root(src_objects, oid)
        stack.extend(object_record_references(record))


def collect_object_records(objects_root: Path, root_oid: str) -> list[dict[str, Any]]:
    records: list[dict[str, Any]] = []
    seen: set[str] = set()
    stack = [root_oid]
    while stack:
        oid = stack.pop()
        if oid in seen:
            continue
        seen.add(oid)
        path = object_record_path(objects_root, oid)
        if not path:
            raise CFError(f"object not found while bundling: {oid}")
        record = read_json(path)
        validate_object_record(record, expected_oid=oid, path=path)
        records.append(object_record_core(record))
        stack.extend(object_record_references(record))
    records.sort(key=lambda record: record["object_id"])
    return records


class AccountedHTTPUploadPlanner:
    """Own upload lookup, seen, and frontier collections while planning."""

    INCOMING_BASE_BYTES = sys.getsizeof({})
    SEEN_BASE_BYTES = sys.getsizeof(set())
    FRONTIER_BASE_BYTES = sys.getsizeof([])
    INCOMING_SLOT_BYTES = 64
    SEEN_SLOT_BYTES = 64
    FRONTIER_SLOT_BYTES = 16
    ENTRY_BASE_BYTES = sys.getsizeof("")
    INDEX_BYTES = sys.getsizeof(0)
    INITIAL_CAPACITY = 4
    BASE_RETAINED_BYTES = (
        INCOMING_BASE_BYTES + SEEN_BASE_BYTES + FRONTIER_BASE_BYTES
    )

    def __init__(
        self, ledger: DecisionWorkLedger, incoming_index_count: int
    ) -> None:
        if (
            isinstance(incoming_index_count, bool)
            or not isinstance(incoming_index_count, int)
            or incoming_index_count < 0
        ):
            raise CFError("HTTP upload planner index count must be nonnegative")
        self._ledger = ledger
        self._ledger_identity = id(ledger)
        self._incoming: dict[str, int] | None = None
        self._seen: set[str] | None = None
        self._frontier: list[str] | None = None
        self._incoming_capacity = 0
        self._seen_capacity = 0
        self._frontier_capacity = 0
        self._retained_bytes = 0
        self._temporary_bytes = 0
        self._closed = False
        index_retained_bytes = incoming_index_count * self.INDEX_BYTES
        base_retained_bytes = self.BASE_RETAINED_BYTES + index_retained_bytes
        permit = ledger.reserve(
            "graph_discovery",
            acquires={"retained_bytes": base_retained_bytes},
        )
        acquired = False
        try:
            ledger.consume_reserved(
                permit,
                phase="graph_discovery",
                acquires={"retained_bytes": base_retained_bytes},
            )
            permit = None
            acquired = True
            self._retained_bytes = base_retained_bytes
            self._incoming = self._allocate_collection("incoming")
            self._seen = self._allocate_collection("seen")
            self._frontier = self._allocate_collection("frontier")
            acquired = False
        finally:
            if permit is not None and ledger.permit_is_open(permit):
                ledger.cancel_permit(permit)
            if acquired:
                self._drop_payloads()
                ledger.release("retained_bytes", base_retained_bytes)
                self._retained_bytes = 0
                self._closed = True

    @staticmethod
    def _allocate_collection(kind: str) -> Any:
        if kind == "incoming":
            return {}
        if kind == "seen":
            return set()
        if kind == "frontier":
            return []
        raise CFError(f"unknown HTTP upload planner collection: {kind}")

    @staticmethod
    def _mapping_insert(
        mapping: dict[str, int], object_id: str, index: int
    ) -> None:
        mapping[object_id] = index

    @staticmethod
    def _set_insert(values: set[str], object_id: str) -> None:
        values.add(object_id)

    @staticmethod
    def _frontier_append(values: list[str], object_id: str) -> None:
        values.append(object_id)

    @classmethod
    def first_growth_scratch_bytes(cls) -> int:
        return cls.INITIAL_CAPACITY * cls.INCOMING_SLOT_BYTES

    @classmethod
    def _growth_plan(
        cls, capacity: int, count: int, slot_bytes: int
    ) -> tuple[int, int, int]:
        if count < capacity:
            next_capacity = capacity
        else:
            next_capacity = (
                cls.INITIAL_CAPACITY if capacity == 0 else capacity * 2
            )
        retained = (next_capacity - capacity) * slot_bytes
        # CPython dict/set/list reallocate at implementation-specific counts
        # that do not match the logical capacity schedule above. Reserve the
        # old+possible-new backing tables before every insertion. The
        # collection object itself remains the already-retained base.
        scratch = (capacity + next_capacity) * slot_bytes
        return next_capacity, retained, scratch

    def _ensure_open(self) -> None:
        if (
            self._closed
            or self._incoming is None
            or self._seen is None
            or self._frontier is None
        ):
            raise CFError("HTTP upload planner owner is closed")

    def _insert(
        self,
        *,
        capacity: int,
        count: int,
        slot_bytes: int,
        entry_bytes: int,
        allocate: Any,
        deadline: HTTPRequestDeadline | None,
    ) -> int:
        self._ensure_open()
        next_capacity, growth_retained, scratch = self._growth_plan(
            capacity, count, slot_bytes
        )
        retained = entry_bytes + growth_retained
        acquires = {"retained_bytes": retained}
        if scratch:
            acquires["temporary_bytes"] = scratch
        permit = None
        try:
            permit = self._ledger.reserve(
                "graph_discovery",
                acquires=acquires,
            )
            if deadline is not None:
                deadline.check("upload closure collection")
            self._ledger.consume_reserved(
                permit,
                phase="graph_discovery",
                acquires=acquires,
            )
            permit = None
            self._retained_bytes += retained
            self._temporary_bytes += scratch
            allocate()
            self._ledger.release("temporary_bytes", scratch)
            self._temporary_bytes -= scratch
            return next_capacity
        except BaseException:
            if permit is not None and self._ledger.permit_is_open(permit):
                self._ledger.cancel_permit(permit)
            self.close()
            raise

    @classmethod
    def _entry_bytes(cls, object_id: str) -> int:
        if not object_id.isascii():
            raise CFError("remote object set contains an invalid object ID")
        return cls.ENTRY_BASE_BYTES + len(object_id)

    def add_incoming(
        self,
        object_id: str,
        index: int,
        deadline: HTTPRequestDeadline | None,
    ) -> None:
        self._ensure_open()
        assert self._incoming is not None
        if object_id in self._incoming:
            raise CFError("remote object set contains a duplicate object ID")
        self._incoming_capacity = self._insert(
            capacity=self._incoming_capacity,
            count=len(self._incoming),
            slot_bytes=self.INCOMING_SLOT_BYTES,
            entry_bytes=self._entry_bytes(object_id),
            allocate=lambda: self._mapping_insert(
                self._incoming, object_id, index
            ),
            deadline=deadline,
        )

    def incoming_index(self, object_id: str) -> int | None:
        self._ensure_open()
        assert self._incoming is not None
        return self._incoming.get(object_id)

    def mark_seen(
        self,
        object_id: str,
        deadline: HTTPRequestDeadline | None,
    ) -> bool:
        self._ensure_open()
        assert self._seen is not None
        if object_id in self._seen:
            return False
        self._seen_capacity = self._insert(
            capacity=self._seen_capacity,
            count=len(self._seen),
            slot_bytes=self.SEEN_SLOT_BYTES,
            entry_bytes=self._entry_bytes(object_id),
            allocate=lambda: self._set_insert(self._seen, object_id),
            deadline=deadline,
        )
        return True

    def push_frontier(
        self,
        object_id: str,
        deadline: HTTPRequestDeadline | None,
    ) -> None:
        self._ensure_open()
        assert self._frontier is not None
        self._frontier_capacity = self._insert(
            capacity=self._frontier_capacity,
            count=len(self._frontier),
            slot_bytes=self.FRONTIER_SLOT_BYTES,
            entry_bytes=self._entry_bytes(object_id),
            allocate=lambda: self._frontier_append(
                self._frontier, object_id
            ),
            deadline=deadline,
        )

    def has_frontier(self) -> bool:
        self._ensure_open()
        assert self._frontier is not None
        return bool(self._frontier)

    def pop_frontier(self) -> str:
        self._ensure_open()
        assert self._frontier is not None
        # Keep the scalar through planner close: the returned string remains
        # live while the caller validates and expands this node.
        return self._frontier.pop()

    def _drop_payloads(self) -> None:
        if self._incoming is not None:
            self._incoming.clear()
            self._incoming = None
        if self._seen is not None:
            self._seen.clear()
            self._seen = None
        if self._frontier is not None:
            self._frontier.clear()
            self._frontier = None

    def close(self) -> None:
        if self._closed:
            return
        if id(self._ledger) != self._ledger_identity:
            raise CFError("HTTP upload planner belongs to a different ledger")
        self._drop_payloads()
        if self._temporary_bytes:
            self._ledger.release("temporary_bytes", self._temporary_bytes)
            self._temporary_bytes = 0
        if self._retained_bytes:
            self._ledger.release("retained_bytes", self._retained_bytes)
            self._retained_bytes = 0
        self._closed = True

    def __del__(self) -> None:
        try:
            self.close()
        except BaseException:
            pass


class AccountedHTTPUploadClosure:
    """Own one upload closure projection on the HTTP request ledger."""

    LIST_BASE_BYTES = 64
    ENTRY_BASE_BYTES = 16
    SORT_BASE_BYTES = 64
    SORT_ENTRY_BYTES = 16

    def __init__(self, ledger: DecisionWorkLedger) -> None:
        self._ledger = ledger
        self._ledger_identity = id(ledger)
        self._incoming: list[int] | None = None
        self._existing: list[str] | None = None
        self._retained_bytes = 0
        self._temporary_bytes = 0
        self._closed = False
        base_retained = self.LIST_BASE_BYTES * 2
        permit = ledger.reserve(
            "graph_discovery",
            acquires={"retained_bytes": base_retained},
        )
        acquired = False
        try:
            ledger.consume_reserved(
                permit,
                phase="graph_discovery",
                acquires={"retained_bytes": base_retained},
            )
            permit = None
            acquired = True
            self._retained_bytes = base_retained
            self._incoming = self._allocate_list()
            self._existing = self._allocate_list()
            acquired = False
        finally:
            if permit is not None and ledger.permit_is_open(permit):
                ledger.cancel_permit(permit)
            if acquired:
                if self._incoming is not None:
                    self._incoming.clear()
                    self._incoming = None
                ledger.release("retained_bytes", base_retained)
                self._retained_bytes = 0
                self._closed = True

    @staticmethod
    def _allocate_list() -> list[Any]:
        return []

    @classmethod
    def entry_bytes(cls, object_id: str) -> int:
        if not object_id.isascii():
            raise CFError("remote object set contains an invalid object ID")
        return cls.ENTRY_BASE_BYTES + len(object_id)

    def _append(
        self,
        collection: list[Any],
        value: Any,
        object_id: str,
        deadline: HTTPRequestDeadline | None,
    ) -> None:
        if self._closed:
            raise CFError("HTTP upload closure owner is closed")
        if self._incoming is None or self._existing is None:
            raise CFError("HTTP upload closure owner is unavailable")
        retained = self.entry_bytes(object_id)
        permit = self._ledger.reserve(
            "graph_discovery",
            acquires={"retained_bytes": retained},
        )
        acquired = False
        try:
            if deadline is not None:
                deadline.check("upload closure collection")
            self._ledger.consume_reserved(
                permit,
                phase="graph_discovery",
                acquires={"retained_bytes": retained},
            )
            permit = None
            acquired = True
            collection.append(value)
            self._retained_bytes += retained
            acquired = False
        finally:
            if permit is not None and self._ledger.permit_is_open(permit):
                self._ledger.cancel_permit(permit)
            if acquired:
                self._ledger.release("retained_bytes", retained)

    def append_incoming(
        self,
        index: int,
        object_id: str,
        deadline: HTTPRequestDeadline | None,
    ) -> None:
        self._append(self._incoming, index, object_id, deadline)

    def append_existing(
        self,
        object_id: str,
        deadline: HTTPRequestDeadline | None,
    ) -> None:
        self._append(self._existing, object_id, object_id, deadline)

    def sort(self, deadline: HTTPRequestDeadline | None) -> None:
        if self._incoming is None or self._existing is None:
            raise CFError("HTTP upload closure owner is unavailable")
        count = len(self._incoming) + len(self._existing)
        temporary = self.SORT_BASE_BYTES + self.SORT_ENTRY_BYTES * count
        permit = self._ledger.reserve(
            "query", acquires={"temporary_bytes": temporary}
        )
        acquired = False
        try:
            if deadline is not None:
                deadline.check("upload closure sorting")
            self._ledger.consume_reserved(
                permit,
                phase="query",
                acquires={"temporary_bytes": temporary},
            )
            permit = None
            acquired = True
            self._temporary_bytes = temporary
            self._incoming.sort()
            self._existing.sort()
            if deadline is not None:
                deadline.check("upload closure sorting")
        finally:
            if permit is not None and self._ledger.permit_is_open(permit):
                self._ledger.cancel_permit(permit)
            if acquired:
                self._ledger.release("temporary_bytes", self._temporary_bytes)
                self._temporary_bytes = 0

    def __iter__(self) -> Any:
        if self._closed or self._incoming is None or self._existing is None:
            raise CFError("HTTP upload closure owner is closed")
        return iter((self._incoming, self._existing))

    def close(self) -> None:
        if self._closed:
            return
        if id(self._ledger) != self._ledger_identity:
            raise CFError("HTTP upload closure belongs to a different ledger")
        retained = self._retained_bytes
        if self._incoming is not None:
            self._incoming.clear()
            self._incoming = None
        if self._existing is not None:
            self._existing.clear()
            self._existing = None
        if self._temporary_bytes:
            self._ledger.release("temporary_bytes", self._temporary_bytes)
            self._temporary_bytes = 0
        if retained:
            self._ledger.release("retained_bytes", retained)
        self._retained_bytes = 0
        self._closed = True

    def __del__(self) -> None:
        try:
            self.close()
        except BaseException:
            pass


def plan_http_upload_closure(
    existing_objects: Path,
    root_oid: str,
    records: list[dict[str, Any]],
    ledger: DecisionWorkLedger | None = None,
    deadline: HTTPRequestDeadline | None = None,
) -> tuple[list[int], list[str]] | AccountedHTTPUploadClosure:
    """Resolve one upload closure without copying or mutating either store.

    Incoming records shadow identical existing records. Every incoming collision
    is checked even when the record is unreachable, matching bundle import
    immutability. Traversal itself follows only references reachable from the
    requested head, so unrelated existing objects cannot amplify staging work.
    """
    planner = (
        AccountedHTTPUploadPlanner(ledger, len(records))
        if ledger is not None
        else None
    )
    incoming: dict[str, int] | None = {} if planner is None else None
    owner: AccountedHTTPUploadClosure | None = None
    try:
        for index, record in enumerate(records):
            if deadline is not None:
                deadline.check("upload closure collection")
            if not isinstance(record, dict):
                raise CFError("object bundle contains a non-object record")
            object_id = record.get("object_id")
            if not isinstance(object_id, str) or not object_id:
                raise CFError(
                    "remote object set contains a record without an object ID"
                )
            validate_object_record(record, expected_oid=object_id)
            if planner is None:
                assert incoming is not None
                if object_id in incoming:
                    raise CFError(
                        "remote object set contains a duplicate object ID"
                    )
                incoming[object_id] = index
            else:
                planner.add_incoming(object_id, index, deadline)

            existing_path = object_record_path(existing_objects, object_id)
            if existing_path is None:
                continue
            existing = read_json(existing_path)
            validate_object_record(
                existing, expected_oid=object_id, path=existing_path
            )
            if object_record_core(existing) != object_record_core(record):
                raise CFError(
                    f"immutable object document diverges at {existing_path}"
                )

        owner = AccountedHTTPUploadClosure(ledger) if ledger is not None else None
        incoming_closure: list[int] | None = [] if owner is None else None
        existing_closure: list[str] | None = [] if owner is None else None
        seen: set[str] | None = set() if planner is None else None
        stack: list[str] | None = [root_oid] if planner is None else None
        if planner is not None:
            planner.push_frontier(root_oid, deadline)

        while planner.has_frontier() if planner is not None else bool(stack):
            if deadline is not None:
                deadline.check("upload closure collection")
            if planner is None:
                assert stack is not None
                assert seen is not None
                assert incoming is not None
                object_id = stack.pop()
                if object_id in seen:
                    continue
                seen.add(object_id)
                incoming_index = incoming.get(object_id)
            else:
                object_id = planner.pop_frontier()
                if not planner.mark_seen(object_id, deadline):
                    continue
                incoming_index = planner.incoming_index(object_id)
            if incoming_index is not None:
                record = records[incoming_index]
                if owner is None:
                    assert incoming_closure is not None
                    incoming_closure.append(incoming_index)
                else:
                    owner.append_incoming(incoming_index, object_id, deadline)
            else:
                record = load_object_record_from_root(existing_objects, object_id)
                if owner is None:
                    assert existing_closure is not None
                    existing_closure.append(object_id)
                else:
                    owner.append_existing(object_id, deadline)
            # Appending in source order preserves the existing LIFO walk's
            # last-reference-first scheduling and first-error behavior.
            visit_object_record_references(
                record,
                (
                    stack.append
                    if planner is None
                    else lambda reference: planner.push_frontier(
                        reference, deadline
                    )
                ),
                (
                    None
                    if deadline is None
                    else lambda: deadline.check("upload closure collection")
                ),
            )

        if planner is not None:
            object_id = None
            record = None
            index = None
            incoming_index = None
            existing = None
            planner.close()
        if owner is not None:
            owner.sort(deadline)
            return owner
        assert incoming_closure is not None
        assert existing_closure is not None
        incoming_closure.sort()
        existing_closure.sort()
        return incoming_closure, existing_closure
    except BaseException:
        object_id = None
        record = None
        index = None
        incoming_index = None
        existing = None
        if owner is not None:
            owner.close()
        if planner is not None:
            planner.close()
        raise


def stage_http_upload_closure(
    existing_objects: Path,
    staging_objects: Path,
    records: list[dict[str, Any]],
    closure: tuple[list[int], list[str]] | AccountedHTTPUploadClosure,
    ledger: DecisionWorkLedger | None = None,
    deadline: HTTPRequestDeadline | None = None,
    *,
    prepared_stage: AccountedHTTPUploadStage | None = None,
) -> None:
    incoming_closure, existing_closure = closure
    if ledger is not None or prepared_stage is not None:
        if ledger is not None and prepared_stage is not None:
            raise CFError("HTTP upload stage received two accounting owners")
        stage = (
            prepared_stage
            if prepared_stage is not None
            else AccountedHTTPUploadStage(
                ledger,
                existing_objects,
                records,
                incoming_closure,
                existing_closure,
                deadline,
            )
        )
        failure: BaseException | None = None
        try:
            stage.transfer_to(
                existing_objects,
                records,
                incoming_closure,
                existing_closure,
                deadline,
            )
            stage.seal_pre_effect()
            stage._write_staging(staging_objects)
        except BaseException as exc:
            # A traceback retains the write callee's payload argument. Detach
            # it before close drops the private plan and releases Retained.
            exc.__traceback__ = None
            failure = exc
        stage.close()
        if failure is not None:
            raise failure
        return
    ensure_object_dirs(staging_objects)
    write_object_records(
        staging_objects,
        [records[index] for index in incoming_closure],
    )
    for object_id in existing_closure:
        copy_object_record(existing_objects, staging_objects, object_id)


def ensure_object_dirs(objects_root: Path) -> None:
    for typ in [
        "blobs",
        "content_manifests",
        "atom_indexes",
        "trace_graphs",
        "fire_ledgers",
        "resolution_ledgers",
        "verifications",
        "policies",
        "commits",
        "branches",
    ]:
        (objects_root / typ).mkdir(parents=True, exist_ok=True)


class AccountedHTTPUploadStage:
    """Own the transient projection/serialization upper for upload staging."""

    PREFLIGHT_TEMP_BYTES = 256 * 1024
    PROJECTION_BASE_BYTES = sys.getsizeof({})
    PROJECTION_FIELD_BYTES = 64
    SERIALIZATION_MULTIPLIER = 5
    SERIALIZATION_BASE_BYTES = 256
    EXISTING_PARSE_MULTIPLIER = 128
    EXISTING_PARSE_BASE_BYTES = 1024
    PLAN_BASE_BYTES = 4096
    PLAN_ENTRY_BYTES = 1024

    def __init__(
        self,
        ledger: DecisionWorkLedger,
        existing_objects: Path,
        records: list[dict[str, Any]],
        incoming_indices: list[int],
        existing_ids: list[str],
        deadline: HTTPRequestDeadline | None,
    ) -> None:
        self._ledger = ledger
        self._ledger_identity = id(ledger)
        self._temporary_bytes = 0
        self._retained_bytes = 0
        self._closed = False
        self._transferred = False
        self._sealed = False
        self._write_started = False
        self._staging_permit: DecisionWorkPermit | None = None
        self._read_permit: DecisionWorkPermit | None = None
        self._existing_objects: Path | None = existing_objects
        self._records: list[dict[str, Any]] | None = records
        self._incoming_indices: list[int] | None = incoming_indices
        self._existing_ids: list[str] | None = existing_ids
        self._records_length = len(records)
        self._incoming_subject: tuple[int, ...] | None = None
        self._existing_subject: tuple[str, ...] | None = None
        self._incoming_frozen: tuple[
            tuple[int, str, str, int, str, memoryview], ...
        ] | None = None
        self._existing_frozen: tuple[
            tuple[
                str,
                tuple[int, int, int, int, str],
                str,
                int,
                str,
                memoryview,
            ],
            ...,
        ] | None = None
        self._sealed_validation_bounds: tuple[int, int, int] | None = None
        self._deadline: HTTPRequestDeadline | None = deadline
        preflight_permit = ledger.reserve(
            "staging",
            acquires={"temporary_bytes": self.PREFLIGHT_TEMP_BYTES},
        )
        try:
            ledger.consume_reserved(
                preflight_permit,
                phase="staging",
                acquires={"temporary_bytes": self.PREFLIGHT_TEMP_BYTES},
            )
            preflight_permit = None
            self._temporary_bytes = self.PREFLIGHT_TEMP_BYTES
        finally:
            if (
                preflight_permit is not None
                and ledger.permit_is_open(preflight_permit)
            ):
                ledger.cancel_permit(preflight_permit)
        incoming_bytes = 0
        maximum_temporary = 0
        existing_bytes = 0
        existing_serialization_bytes = 0
        subject_permit = None
        staging_permit = None
        read_permit = None
        initialized = False
        try:
            incoming_count = len(incoming_indices)
            existing_count = len(existing_ids)
            subject_retained_bytes = (
                self.PLAN_BASE_BYTES
                + self.PLAN_ENTRY_BYTES * (incoming_count + existing_count)
            )
            subject_permit = ledger.reserve(
                "staging",
                acquires={"retained_bytes": subject_retained_bytes},
            )
            ledger.consume_reserved(
                subject_permit,
                phase="staging",
                acquires={"retained_bytes": subject_retained_bytes},
            )
            subject_permit = None
            self._retained_bytes = subject_retained_bytes
            self._incoming_subject = tuple(incoming_indices)
            self._existing_subject = tuple(existing_ids)
            if (
                len(self._incoming_subject) != incoming_count
                or len(self._existing_subject) != existing_count
            ):
                raise CFError("HTTP upload stage caller plan changed")
            for incoming_index in self._incoming_subject:
                if deadline is not None:
                    deadline.check("upload staging preflight")
                record = records[incoming_index]
                if not isinstance(record, dict):
                    raise CFError("object bundle contains a non-object record")
                serialized_size = _object_record_core_json_size(
                    record,
                    None
                    if deadline is None
                    else lambda: deadline.check("upload staging preflight"),
                ) + 1
                if serialized_size > MAX_OBJECT_RECORD_BYTES:
                    raise CFError(
                        "object record exceeds the "
                        f"{MAX_OBJECT_RECORD_BYTES}-byte serialization limit"
                    )
                incoming_bytes += serialized_size
                maximum_temporary = max(
                    maximum_temporary,
                    self.serialization_upper(record, serialized_size),
                )
            for object_id in self._existing_subject:
                if deadline is not None:
                    deadline.check("upload staging preflight")
                src = object_record_path(existing_objects, object_id)
                if src is None:
                    raise CFError(f"object not found while copying: {object_id}")
                try:
                    metadata = src.stat(follow_symlinks=False)
                except OSError as exc:
                    raise CFError(
                        f"object not found while copying: {object_id}"
                    ) from exc
                if not stat.S_ISREG(metadata.st_mode) or metadata.st_nlink != 1:
                    raise CFError(f"object changed while copying: {object_id}")
                physical_bytes = metadata.st_size
                if physical_bytes > MAX_OBJECT_RECORD_BYTES:
                    raise CFError(
                        "object record exceeds the "
                        f"{MAX_OBJECT_RECORD_BYTES}-byte limit at {src}: "
                        f"{physical_bytes} bytes"
                    )
                existing_bytes += physical_bytes
                existing_serialization_bytes += physical_bytes * 8 + 1024
                maximum_temporary = max(
                    maximum_temporary,
                    self.existing_upper(physical_bytes),
                )
            staging_bytes = incoming_bytes * 2 + existing_serialization_bytes
            payload_retained_bytes = (
                incoming_bytes + existing_bytes + len(self._existing_subject)
            )
            peak_temporary = max(
                self.PREFLIGHT_TEMP_BYTES, maximum_temporary
            )
            additional_temporary = peak_temporary - self.PREFLIGHT_TEMP_BYTES
            staging_acquires = {
                **(
                    {"temporary_bytes": additional_temporary}
                    if additional_temporary
                    else {}
                ),
                **(
                    {"retained_bytes": payload_retained_bytes}
                    if payload_retained_bytes
                    else {}
                ),
            }
            staging_permit = ledger.reserve(
                "staging",
                charges={
                    "aggregate_bytes": staging_bytes,
                    "object_records": len(self._incoming_subject) + len(self._existing_subject),
                },
                acquires=staging_acquires,
                counters={
                    "object_records": len(self._incoming_subject) + len(self._existing_subject)
                },
            )
            if self._existing_subject:
                read_permit = ledger.reserve(
                    "record_read",
                    charges={"aggregate_bytes": existing_bytes * 2},
                    counters={
                        "files_read": len(self._existing_subject) * 2,
                        "file_bytes_read": existing_bytes * 2,
                        "record_reads": len(self._existing_subject) * 2,
                    },
                )
            if deadline is not None:
                deadline.check("upload staging preflight")
            ledger.consume_reserved(
                staging_permit,
                phase="staging",
                acquires=staging_acquires,
            )
            self._temporary_bytes = peak_temporary
            self._retained_bytes += payload_retained_bytes
            self._staging_permit = staging_permit
            self._read_permit = read_permit
            staging_permit = None
            read_permit = None
            initialized = True
        finally:
            for permit in (read_permit, staging_permit, subject_permit):
                if permit is not None and ledger.permit_is_open(permit):
                    ledger.cancel_permit(permit)
            if not initialized:
                self.close()
        try:
            self._freeze_private_plan()
        except BaseException:
            self.close()
            raise

    @classmethod
    def serialization_upper(
        cls, record: dict[str, Any], serialized_size: int
    ) -> int:
        return (
            cls.SERIALIZATION_BASE_BYTES
            + cls.PROJECTION_BASE_BYTES
            + cls.PROJECTION_FIELD_BYTES * len(record)
            + cls.SERIALIZATION_MULTIPLIER * serialized_size
        )

    @classmethod
    def existing_upper(cls, physical_bytes: int) -> int:
        return (
            cls.EXISTING_PARSE_BASE_BYTES
            + cls.EXISTING_PARSE_MULTIPLIER * physical_bytes
        )

    def _ensure_open(self) -> None:
        if self._closed:
            raise CFError("HTTP upload stage owner is closed")
        if id(self._ledger) != self._ledger_identity:
            raise CFError("HTTP upload stage belongs to a different ledger")

    def transfer_to(
        self,
        existing_objects: Path,
        records: list[dict[str, Any]],
        incoming_indices: list[int],
        existing_ids: list[str],
        deadline: HTTPRequestDeadline | None,
    ) -> None:
        self._ensure_open()
        if self._transferred:
            raise CFError("HTTP upload stage owner is single-use")
        if (
            existing_objects != self._existing_objects
            or records is not self._records
            or incoming_indices is not self._incoming_indices
            or existing_ids is not self._existing_ids
            or deadline is not self._deadline
        ):
            raise CFError("HTTP upload stage plan changed before transfer")
        self._transferred = True

    def _freeze_private_plan(self) -> None:
        self._ensure_open()
        records = self._records
        existing_objects = self._existing_objects
        incoming_subject = self._incoming_subject
        existing_subject = self._existing_subject
        if (
            records is None
            or existing_objects is None
            or incoming_subject is None
            or existing_subject is None
        ):
            raise CFError("HTTP upload stage plan is unavailable")
        incoming_frozen: list[
            tuple[int, str, str, int, str, memoryview]
        ] = []
        existing_frozen: list[
            tuple[
                str,
                tuple[int, int, int, int, str],
                str,
                int,
                str,
                memoryview,
            ]
        ] = []
        validation_record_count = 0
        validation_aggregate_bytes = 0
        validation_maximum_record_bytes = 0
        record = None
        serialized = None
        try:
            for incoming_index in incoming_subject:
                if self._deadline is not None:
                    self._deadline.check("upload staging preflight")
                if incoming_index < 0 or incoming_index >= len(records):
                    raise CFError("HTTP upload stage incoming index changed")
                record = records[incoming_index]
                if not isinstance(record, dict):
                    raise CFError("object bundle contains a non-object record")
                validate_object_record(record)
                serialized_size = _object_record_core_json_size(
                    record,
                    None
                    if self._deadline is None
                    else lambda: self._deadline.check("upload staging preflight"),
                ) + 1
                if (
                    self.serialization_upper(record, serialized_size)
                    > self._temporary_bytes
                ):
                    raise CFError("HTTP upload stage incoming record changed")
                self.consume_serialization(serialized_size)
                serialized = _serialize_object_record_core(record)
                if len(serialized) != serialized_size:
                    raise CFError("HTTP upload stage incoming record changed")
                object_id = record["object_id"]
                type_tag = record["type"]
                try:
                    subdir = object_subdir(type_tag)
                except KeyError as exc:
                    raise CFError(
                        f"unsupported object type in bundle: {type_tag}"
                    ) from exc
                incoming_frozen.append(
                    (
                        incoming_index,
                        object_id,
                        subdir,
                        serialized_size,
                        hashlib.sha256(serialized).hexdigest(),
                        memoryview(serialized),
                    )
                )
                if validation_aggregate_bytes > U64_MAX - serialized_size:
                    raise CFError(
                        "HTTP upload sealed-validation aggregate upper overflows u64"
                    )
                validation_record_count += 1
                validation_aggregate_bytes += serialized_size
                validation_maximum_record_bytes = max(
                    validation_maximum_record_bytes, serialized_size
                )
                record = None
                serialized = None
            for object_id in existing_subject:
                if self._deadline is not None:
                    self._deadline.check("upload staging preflight")
                src = object_record_path(existing_objects, object_id)
                if src is None:
                    raise CFError(f"object not found while copying: {object_id}")
                record, evidence = _read_http_upload_stage_record_snapshot(
                    src,
                    object_id,
                    self.checked_existing_size(src, object_id),
                    self._deadline,
                    self,
                    None,
                )
                serialized_size = _object_record_core_json_size(
                    record,
                    None
                    if self._deadline is None
                    else lambda: self._deadline.check("upload staging preflight"),
                ) + 1
                if (
                    self.serialization_upper(record, serialized_size)
                    > self._temporary_bytes
                ):
                    raise CFError(f"object changed while copying: {object_id}")
                self.consume_serialization(serialized_size)
                serialized = _serialize_object_record_core(record)
                if len(serialized) != serialized_size:
                    raise CFError(f"object changed while copying: {object_id}")
                try:
                    subdir = object_subdir(record["type"])
                except KeyError as exc:
                    raise CFError(
                        f"unsupported object type in bundle: {record['type']}"
                    ) from exc
                record = None
                existing_frozen.append(
                    (
                        object_id,
                        evidence,
                        subdir,
                        serialized_size,
                        hashlib.sha256(serialized).hexdigest(),
                        memoryview(serialized),
                    )
                )
                if validation_aggregate_bytes > U64_MAX - serialized_size:
                    raise CFError(
                        "HTTP upload sealed-validation aggregate upper overflows u64"
                    )
                validation_record_count += 1
                validation_aggregate_bytes += serialized_size
                validation_maximum_record_bytes = max(
                    validation_maximum_record_bytes, serialized_size
                )
                serialized = None
            self._incoming_frozen = tuple(incoming_frozen)
            self._existing_frozen = tuple(existing_frozen)
            self._sealed_validation_bounds = (
                validation_record_count,
                validation_aggregate_bytes,
                validation_maximum_record_bytes,
            )
        finally:
            record = None
            serialized = None
            incoming_frozen.clear()
            existing_frozen.clear()

    def seal_pre_effect(self) -> None:
        self._ensure_open()
        if self._sealed:
            return
        records = self._records
        incoming_indices = self._incoming_indices
        existing_ids = self._existing_ids
        incoming_subject = self._incoming_subject
        existing_subject = self._existing_subject
        incoming_frozen = self._incoming_frozen
        existing_frozen = self._existing_frozen
        if (
            records is None
            or incoming_indices is None
            or existing_ids is None
            or incoming_subject is None
            or existing_subject is None
            or incoming_frozen is None
            or existing_frozen is None
        ):
            raise CFError("HTTP upload stage plan is unavailable")
        if (
            len(records) != self._records_length
            or tuple(incoming_indices) != incoming_subject
            or tuple(existing_ids) != existing_subject
        ):
            raise CFError("HTTP upload stage caller plan changed")
        candidate = None
        record = None
        try:
            for (
                incoming_index,
                object_id,
                _subdir,
                serialized_size,
                serialized_digest,
                _serialized,
            ) in incoming_frozen:
                if self._deadline is not None:
                    self._deadline.check("upload staging preflight")
                if incoming_index < 0 or incoming_index >= len(records):
                    raise CFError("HTTP upload stage caller plan changed")
                record = records[incoming_index]
                if not isinstance(record, dict) or record.get("object_id") != object_id:
                    raise CFError("HTTP upload stage caller record changed")
                candidate_size = _object_record_core_json_size(
                    record,
                    None
                    if self._deadline is None
                    else lambda: self._deadline.check("upload staging preflight"),
                ) + 1
                if candidate_size != serialized_size:
                    raise CFError("HTTP upload stage caller record changed")
                self.consume_incoming_revalidation(serialized_size)
                candidate = _serialize_object_record_core(record)
                if hashlib.sha256(candidate).hexdigest() != serialized_digest:
                    raise CFError("HTTP upload stage caller record changed")
                candidate = None
                record = None
            for (
                object_id,
                evidence,
                _subdir,
                _serialized_size,
                _serialized_digest,
                _serialized,
            ) in existing_frozen:
                if self._deadline is not None:
                    self._deadline.check("upload staging preflight")
                existing_objects = self._existing_objects
                if existing_objects is None:
                    raise CFError("HTTP upload stage plan is unavailable")
                src = object_record_path(existing_objects, object_id)
                if src is None:
                    raise CFError(f"object not found while copying: {object_id}")
                record, observed = _read_http_upload_stage_record_snapshot(
                    src,
                    object_id,
                    evidence[3],
                    self._deadline,
                    self,
                    evidence,
                )
                record = None
                if observed != evidence:
                    raise CFError(f"object changed while copying: {object_id}")
            self._sealed = True
        finally:
            candidate = None
            record = None

    def take_sealed_validation_bounds(self) -> tuple[int, int, int]:
        """Move the frozen staged-file scalar bounds to one validation caller."""
        self._ensure_open()
        if not self._sealed:
            raise CFError("HTTP upload stage is not sealed for validation")
        bounds = self._sealed_validation_bounds
        if bounds is None:
            raise CFError("HTTP upload sealed-validation bounds are unavailable")
        self._sealed_validation_bounds = None
        return bounds

    def _write_staging(self, staging_objects: Path) -> None:
        self._ensure_open()
        if (
            not self._transferred
            or not self._sealed
            or self._incoming_frozen is None
            or self._existing_frozen is None
        ):
            raise CFError("HTTP upload stage owner is not ready")
        if self._write_started:
            raise CFError("HTTP upload stage owner is single-use")
        self._write_started = True
        incoming_frozen = self._incoming_frozen
        existing_frozen = self._existing_frozen
        entry = None
        payload_owner = None
        try:
            ensure_object_dirs(staging_objects)
            for entry in incoming_frozen:
                (
                    _incoming_index,
                    object_id,
                    subdir,
                    _serialized_size,
                    _serialized_digest,
                    payload_owner,
                ) = entry
                if self._deadline is not None:
                    self._deadline.check("upload staging")
                _write_serialized_json(
                    staging_objects / subdir / f"{object_id}.json",
                    payload_owner,
                    self._deadline,
                )
                entry = None
                payload_owner = None
            for entry in existing_frozen:
                (
                    object_id,
                    _expected_source,
                    subdir,
                    _serialized_size,
                    _serialized_digest,
                    payload_owner,
                ) = entry
                if self._deadline is not None:
                    self._deadline.check("upload staging")
                _write_serialized_json(
                    staging_objects / subdir / f"{object_id}.json",
                    payload_owner,
                    self._deadline,
                )
                entry = None
                payload_owner = None
        finally:
            entry = None
            payload_owner = None
            incoming_frozen = None
            existing_frozen = None

    def checked_existing_size(self, path: Path, object_id: str) -> int:
        self._ensure_open()
        try:
            metadata = path.stat(follow_symlinks=False)
        except OSError as exc:
            raise CFError(f"object not found while copying: {object_id}") from exc
        if not stat.S_ISREG(metadata.st_mode) or metadata.st_nlink != 1:
            raise CFError(f"object changed while copying: {object_id}")
        physical_bytes = metadata.st_size
        if self.existing_upper(physical_bytes) > self._temporary_bytes:
            raise CFError(f"object changed while copying: {object_id}")
        return physical_bytes

    def consume_existing_read(self, physical_bytes: int) -> None:
        self._ensure_open()
        if self._read_permit is None:
            raise CFError("HTTP upload stage read reservation is unavailable")
        permit = self._read_permit
        self._ledger.consume_reserved(
            permit,
            phase="record_read",
            charges={"aggregate_bytes": physical_bytes},
            counters={
                "files_read": 1,
                "file_bytes_read": physical_bytes,
                "record_reads": 1,
            },
        )
        if not self._ledger.permit_is_open(permit):
            self._read_permit = None

    def consume_serialization(self, serialized_size: int) -> None:
        self._ensure_open()
        if self._staging_permit is None:
            raise CFError("HTTP upload stage serialization reservation is unavailable")
        permit = self._staging_permit
        self._ledger.consume_reserved(
            permit,
            phase="staging",
            charges={
                "aggregate_bytes": serialized_size,
                "object_records": 1,
            },
            counters={"object_records": 1},
        )
        if not self._ledger.permit_is_open(permit):
            self._staging_permit = None

    def consume_incoming_revalidation(self, serialized_size: int) -> None:
        self._ensure_open()
        if self._staging_permit is None:
            raise CFError("HTTP upload stage validation reservation is unavailable")
        permit = self._staging_permit
        self._ledger.consume_reserved(
            permit,
            phase="staging",
            charges={"aggregate_bytes": serialized_size},
        )
        if not self._ledger.permit_is_open(permit):
            self._staging_permit = None

    def close(self) -> None:
        if self._closed:
            return
        self._ensure_open()
        self._existing_objects = None
        self._existing_ids = None
        self._records = None
        self._incoming_indices = None
        self._incoming_subject = None
        self._existing_subject = None
        self._incoming_frozen = None
        self._existing_frozen = None
        self._sealed_validation_bounds = None
        self._deadline = None
        for attribute in ("_read_permit", "_staging_permit"):
            permit = getattr(self, attribute)
            if permit is not None and self._ledger.permit_is_open(permit):
                self._ledger.cancel_permit(permit)
            setattr(self, attribute, None)
        if self._temporary_bytes:
            self._ledger.release("temporary_bytes", self._temporary_bytes)
            self._temporary_bytes = 0
        if self._retained_bytes:
            self._ledger.release("retained_bytes", self._retained_bytes)
            self._retained_bytes = 0
        self._closed = True

    def __del__(self) -> None:
        try:
            self.close()
        except BaseException:
            pass


def prepare_http_upload_stage(
    ledger: DecisionWorkLedger,
    existing_objects: Path,
    records: list[dict[str, Any]],
    closure: tuple[list[int], list[str]] | AccountedHTTPUploadClosure,
    deadline: HTTPRequestDeadline | None,
) -> AccountedHTTPUploadStage:
    """Reserve and validate one staging owner before temporary-tree effects."""
    incoming_indices, existing_ids = closure
    stage = AccountedHTTPUploadStage(
        ledger,
        existing_objects,
        records,
        incoming_indices,
        existing_ids,
        deadline,
    )
    return stage


def _serialize_object_record_core(record: dict[str, Any]) -> bytes:
    return canonical_json(object_record_core(record)) + b"\n"


def _write_serialized_json(
    path: Path,
    payload: bytes | memoryview,
    deadline: HTTPRequestDeadline | None,
) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(path.suffix + ".tmp")
    file_descriptor = -1
    view: memoryview | None = None
    try:
        file_descriptor = os.open(
            tmp,
            os.O_WRONLY | os.O_CREAT | os.O_TRUNC,
            0o666,
        )
        view = memoryview(payload)
        offset = 0
        while offset < len(view):
            if deadline is not None:
                deadline.check("upload staging write")
            written = os.write(
                file_descriptor,
                view[offset : offset + 64 * 1024],
            )
            if written <= 0:
                raise CFError(f"object staging write made no progress: {path}")
            offset += written
        os.close(file_descriptor)
        file_descriptor = -1
        view.release()
        view = None
        os.replace(tmp, path)
    except BaseException:
        if view is not None:
            view.release()
        if file_descriptor >= 0:
            os.close(file_descriptor)
        try:
            tmp.unlink()
        except FileNotFoundError:
            pass
        raise


def _read_http_upload_stage_record(
    path: Path,
    expected_oid: str,
    expected_size: int,
    deadline: HTTPRequestDeadline | None,
    stage: AccountedHTTPUploadStage,
    expected_source: tuple[int, int, int, int, str] | None = None,
) -> dict[str, Any]:
    record, _evidence = _read_http_upload_stage_record_snapshot(
        path,
        expected_oid,
        expected_size,
        deadline,
        stage,
        expected_source,
    )
    return record


def _read_http_upload_stage_record_snapshot(
    path: Path,
    expected_oid: str,
    expected_size: int,
    deadline: HTTPRequestDeadline | None,
    stage: AccountedHTTPUploadStage,
    expected_source: tuple[int, int, int, int, str] | None,
) -> tuple[dict[str, Any], tuple[int, int, int, int, str]]:
    raw: bytearray | None = None
    file_descriptor = -1
    try:
        stage.consume_existing_read(expected_size)
        try:
            initial = path.stat(follow_symlinks=False)
        except OSError as exc:
            raise CFError(f"object not found while copying: {expected_oid}") from exc
        file_descriptor = os.open(
            path,
            os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0),
        )
        before = os.fstat(file_descriptor)
        expected_identity = (
            None
            if expected_source is None
            else (expected_source[0], expected_source[1])
        )
        if (
            not stat.S_ISREG(initial.st_mode)
            or not stat.S_ISREG(before.st_mode)
            or initial.st_nlink != 1
            or before.st_nlink != 1
            or (initial.st_dev, initial.st_ino) != (before.st_dev, before.st_ino)
            or (
                expected_identity is not None
                and (before.st_dev, before.st_ino) != expected_identity
            )
            or initial.st_size != expected_size
            or before.st_size != expected_size
        ):
            raise CFError(f"object changed while copying: {expected_oid}")
        raw = bytearray()
        while len(raw) < expected_size:
            if deadline is not None:
                deadline.check("upload staging existing read")
            chunk = os.read(
                file_descriptor,
                min(64 * 1024, expected_size - len(raw)),
            )
            if not chunk:
                break
            raw.extend(chunk)
        extension = os.read(file_descriptor, 1)
        after = os.fstat(file_descriptor)
        try:
            named = path.stat(follow_symlinks=False)
        except OSError as exc:
            raise CFError(f"object changed while copying: {expected_oid}") from exc
        if (
            len(raw) != expected_size
            or extension
            or not stat.S_ISREG(after.st_mode)
            or after.st_nlink != 1
            or (before.st_dev, before.st_ino) != (after.st_dev, after.st_ino)
            or not stat.S_ISREG(named.st_mode)
            or named.st_nlink != 1
            or (after.st_dev, after.st_ino) != (named.st_dev, named.st_ino)
            or after.st_size != expected_size
            or named.st_size != expected_size
        ):
            raise CFError(f"object changed while copying: {expected_oid}")
        content_hash = hashlib.sha256(raw).hexdigest()
        evidence = (
            before.st_dev,
            before.st_ino,
            before.st_nlink,
            expected_size,
            content_hash,
        )
        if expected_source is not None and evidence != expected_source:
            raise CFError(f"object changed while copying: {expected_oid}")
        if deadline is not None:
            deadline.check("upload staging existing parse")
        try:
            record = json.loads(raw)
        except (UnicodeDecodeError, json.JSONDecodeError) as exc:
            raise CFError(f"invalid object JSON: {path}: {exc}") from exc
        raw = None
        validate_object_record(record, expected_oid=expected_oid, path=path)
        if deadline is not None:
            deadline.check("upload staging existing validation")
        return record, evidence
    finally:
        raw = None
        if file_descriptor >= 0:
            os.close(file_descriptor)


def write_object_records(
    objects_root: Path,
    records: list[dict[str, Any]],
    generation: int | None = None,
    *,
    indices: Any | None = None,
    stage: AccountedHTTPUploadStage | None = None,
    deadline: HTTPRequestDeadline | None = None,
    directories_ready: bool = False,
) -> None:
    if not directories_ready:
        ensure_object_dirs(objects_root)
    selected = range(len(records)) if indices is None else indices
    record = None
    serialized = None
    for index in selected:
        record = records[index]
        if deadline is not None:
            deadline.check("upload staging serialization")
        if not isinstance(record, dict):
            raise CFError("object bundle contains a non-object record")
        validate_object_record(record)
        if stage is not None and generation is None:
            stage._ensure_open()
            serialized_size = _object_record_core_json_size(
                record,
                None
                if deadline is None
                else lambda: deadline.check("upload staging serialization"),
            ) + 1
            stage.consume_serialization(serialized_size)
        type_tag = record["type"]
        try:
            subdir = object_subdir(type_tag)
        except KeyError as exc:
            raise CFError(f"unsupported object type in bundle: {type_tag}") from exc
        dest = objects_root / subdir / f"{record['object_id']}.json"
        if dest.exists():
            existing = read_json(dest)
            validate_object_record(existing, expected_oid=record["object_id"], path=dest)
            if object_record_core(existing) != object_record_core(record):
                raise CFError(f"object collision while importing bundle: {record['object_id']}")
            if generation is not None:
                write_json(dest, record_with_generation(existing, generation))
            continue
        if stage is not None and generation is None:
            serialized = _serialize_object_record_core(record)
            if len(serialized) > MAX_OBJECT_RECORD_BYTES:
                raise CFError(
                    "object record exceeds the "
                    f"{MAX_OBJECT_RECORD_BYTES}-byte serialization limit"
                )
            if deadline is not None:
                deadline.check("upload staging serialization")
            _write_serialized_json(dest, serialized, deadline)
            serialized = None
        else:
            write_json(
                dest,
                record_with_generation(record, generation)
                if generation is not None
                else object_record_core(record),
            )
        record = None


def _detach_ancestry_exception_chain(error: BaseException) -> None:
    """Drop every payload-bearing traceback without allocating side storage."""
    current: BaseException | None = error
    while current is not None:
        following = current.__cause__
        if following is None:
            following = current.__context__
        current.__traceback__ = None
        current.__cause__ = None
        current.__context__ = None
        current = following


class _AncestryPermitTransition:
    """Own one ancestry reservation across post-commit Python faults."""

    __slots__ = (
        "_ledger",
        "_permit",
        "_prev",
        "_next",
        "_linked",
        "_baseline_retained",
        "_baseline_temporary",
        "_expected_retained",
        "_expected_temporary",
        "_retained_primary",
        "_retained_secondary",
        "_retained_total",
        "_temporary",
        "_retained_acquired",
        "_temporary_acquired",
        "_acquires_resolved",
        "_retained_primary_released",
        "_retained_secondary_released",
        "_temporary_released",
    )

    def __init__(
        self,
        ledger: DecisionWorkLedger,
        *,
        retained_primary: int = 0,
        retained_secondary: int = 0,
        temporary: int = 0,
    ) -> None:
        self._ledger = ledger
        self._permit: DecisionWorkPermit | None = None
        self._prev: _AncestryPermitTransition | None = None
        self._next: _AncestryPermitTransition | None = None
        self._linked = False
        self._baseline_retained = ledger._current.get("retained_bytes", 0)
        self._baseline_temporary = ledger._current.get("temporary_bytes", 0)
        self._retained_primary = retained_primary
        self._retained_secondary = retained_secondary
        self._retained_total = retained_primary + retained_secondary
        self._temporary = temporary
        self._expected_retained = self._baseline_retained + self._retained_total
        self._expected_temporary = self._baseline_temporary + temporary
        self._retained_acquired = False
        self._temporary_acquired = False
        self._acquires_resolved = self._retained_total == 0 and temporary == 0
        self._retained_primary_released = retained_primary == 0
        self._retained_secondary_released = retained_secondary == 0
        self._temporary_released = temporary == 0

    def reserve(self, phase: str, **upper: Any) -> None:
        permit = DecisionWorkPermit()
        self._permit = permit
        failure: BaseException | None = None
        try:
            self._ledger.reserve_into(permit, phase, **upper)
        except BaseException as error:
            failure = error
        if permit in self._ledger._reserved:
            if failure is not None:
                _detach_ancestry_exception_chain(failure)
            return
        self._permit = None
        self._acquires_resolved = True
        self._retained_primary_released = True
        self._retained_secondary_released = True
        self._temporary_released = True
        if failure is not None:
            raise failure
        raise CFError(
            "ancestry reserve_into did not register its caller-owned permit"
        )

    def _open_reservation(self) -> dict[str, Any] | None:
        if self._permit is None:
            return None
        return self._ledger._reserved.get(self._permit)

    def _reconcile_acquires(self) -> bool:
        if self._acquires_resolved:
            return self._retained_acquired or self._temporary_acquired
        committed = False
        if self._retained_total:
            retained = self._ledger._current.get("retained_bytes", 0)
            if retained == self._expected_retained:
                self._retained_acquired = True
                committed = True
            elif retained != self._baseline_retained:
                raise CFError(
                    "ancestry retained transition changed outside its upper bound"
                )
        if self._temporary:
            temporary = self._ledger._current.get("temporary_bytes", 0)
            if temporary == self._expected_temporary:
                self._temporary_acquired = True
                committed = True
            elif temporary != self._baseline_temporary:
                raise CFError(
                    "ancestry temporary transition changed outside its upper bound"
                )
        if not self._retained_acquired:
            self._retained_primary_released = True
            self._retained_secondary_released = True
        if not self._temporary_acquired:
            self._temporary_released = True
        self._acquires_resolved = True
        return committed

    def consume(self, **actual: Any) -> None:
        permit = self._permit
        if permit is None:
            raise CFError("ancestry transition has no permit")
        before = self._open_reservation()
        before_snapshot = None if before is None else {
            field: dict(before[field])
            if field in {"charges", "maxima", "acquires", "counters"}
            else before[field]
            for field in before
        }
        failure: BaseException | None = None
        try:
            self._ledger.consume_reserved(permit, **actual)
        except BaseException as error:
            failure = error
        acquired = self._reconcile_acquires()
        after = self._open_reservation()
        committed = acquired or after is not before or after != before_snapshot
        if after is None:
            self._permit = None
        if failure is not None:
            if not committed:
                raise failure
            _detach_ancestry_exception_chain(failure)

    def cancel(self) -> None:
        permit = self._permit
        if permit is None:
            return
        if permit not in self._ledger._reserved:
            self._reconcile_acquires()
            self._permit = None
            return
        failure: BaseException | None = None
        try:
            self._ledger.cancel_permit(permit)
        except BaseException as error:
            failure = error
        if permit not in self._ledger._reserved:
            self._reconcile_acquires()
            self._permit = None
            if failure is not None:
                _detach_ancestry_exception_chain(failure)
            return
        if failure is not None:
            raise failure

    def _release_component(
        self,
        dimension: str,
        amount: int,
        acquired_attribute: str,
        released_attribute: str,
    ) -> None:
        if getattr(self, released_attribute):
            return
        if not getattr(self, acquired_attribute):
            self._reconcile_acquires()
        if not getattr(self, acquired_attribute):
            return
        before = self._ledger._current.get(dimension, 0)
        expected_after = before - amount
        failure: BaseException | None = None
        try:
            self._ledger.release(dimension, amount)
        except BaseException as error:
            failure = error
        after = self._ledger._current.get(dimension, 0)
        committed = after == expected_after
        if committed:
            object.__setattr__(self, released_attribute, True)
        if failure is not None:
            if not committed:
                raise failure
            _detach_ancestry_exception_chain(failure)
        elif not committed:
            raise CFError(
                f"ancestry {dimension} release returned without committing"
            )

    def release_primary(self) -> None:
        self._release_component(
            "retained_bytes",
            self._retained_primary,
            "_retained_acquired",
            "_retained_primary_released",
        )

    def release_temporary(self) -> None:
        self._release_component(
            "temporary_bytes",
            self._temporary,
            "_temporary_acquired",
            "_temporary_released",
        )

    def release_all(self) -> None:
        self.cancel()
        self.release_temporary()
        self.release_primary()
        self._release_component(
            "retained_bytes",
            self._retained_secondary,
            "_retained_acquired",
            "_retained_secondary_released",
        )

    def adopt_acquired(
        self,
        ledger: DecisionWorkLedger,
        *,
        retained_primary: int = 0,
        retained_secondary: int = 0,
        temporary: int = 0,
    ) -> None:
        """Adopt scalars consumed by the owner's fixed allocation gate."""
        self.__init__(
            ledger,
            retained_primary=retained_primary,
            retained_secondary=retained_secondary,
            temporary=temporary,
        )
        self._retained_acquired = self._retained_total != 0
        self._temporary_acquired = temporary != 0
        self._acquires_resolved = True
        self._retained_primary_released = retained_primary == 0
        self._retained_secondary_released = retained_secondary == 0
        self._temporary_released = temporary == 0


class AccountedHTTPUploadAncestry:
    """Own one provisional BFS ancestry decision on a request ledger.

    ``loader`` must return a borrowed, already-validated commit mapping whose
    lifetime exceeds this owner. ``AccountedHTTPUploadSealedAncestry`` now
    provides that snapshot-bound handoff; handler/terminal wiring remains
    intentionally deferred.
    """

    TRANSITION_BYTES = sys.getsizeof(
        object.__new__(_AncestryPermitTransition)
    )
    SEEN_BASE_BYTES = sys.getsizeof(set())
    FRONTIER_BASE_BYTES = sys.getsizeof(deque())
    COLLECTION_BASE_BYTES = SEEN_BASE_BYTES + FRONTIER_BASE_BYTES
    FRAME_BASE_BYTES = (
        sys.getsizeof((None, 0))
        + sys.getsizeof(U64_MAX)
        + sys.getsizeof("")
    )
    SEEN_ENTRY_BASE_BYTES = sys.getsizeof("")
    FRONTIER_SLOT_BYTES = 32
    SEEN_SLOT_BYTES = 128

    def __init__(
        self,
        ledger: DecisionWorkLedger,
        loader: Any,
        deadline: HTTPRequestDeadline | None = None,
        *,
        _handoff_owner: Any | None = None,
    ) -> None:
        if not callable(loader):
            raise CFError("HTTP upload ancestry loader must be callable")
        self._ledger = ledger
        self._ledger_identity = id(ledger)
        self._loader = loader
        self._deadline = deadline
        self._seen: set[str] | None = None
        self._frontier: deque[tuple[str, int, _AncestryPermitTransition]] | None = None
        self._active_frame_transition: _AncestryPermitTransition | None = None
        self._transition_head: _AncestryPermitTransition | None = None
        # This single control-plane slot exists with the owner before any
        # ancestry allocation. It reserves and consumes the bytes for a
        # durable transition before that transition is constructed, avoiding
        # the otherwise circular requirement to allocate a reservation owner
        # in order to reserve the reservation owner's own bytes.
        self._allocation_gate = _AncestryPermitTransition(ledger)
        self._gate_handoff_transition: _AncestryPermitTransition | None = None
        self._used = False
        self._closed = False
        self._closing = False
        if _handoff_owner is not None:
            if object.__getattribute__(_handoff_owner, "_ancestry") is not None:
                raise CFError("HTTP upload ancestry handoff slot is occupied")
            # Publish before the collection reservation and allocators.  An
            # initialization/cleanup fault therefore remains reachable from
            # the destination composite instead of relying on __del__.
            object.__setattr__(_handoff_owner, "_ancestry", self)
        failure: BaseException | None = None
        try:
            self._prepare_transition(
                "graph_discovery",
                retained_primary=self.COLLECTION_BASE_BYTES,
                acquires={
                    "retained_bytes": (
                        self.COLLECTION_BASE_BYTES + self.TRANSITION_BYTES
                    )
                },
            )
            self._seen = self._allocate_seen()
            self._frontier = self._allocate_frontier()
        except BaseException as error:
            _detach_ancestry_exception_chain(error)
            failure = error
        if failure is not None:
            cleanup_failure: BaseException | None = None
            try:
                self.close()
            except BaseException as error:
                _detach_ancestry_exception_chain(error)
                cleanup_failure = error
            if cleanup_failure is not None:
                raise cleanup_failure from failure
            raise failure from None

    @staticmethod
    def _allocate_seen() -> set[str]:
        return set()

    @staticmethod
    def _allocate_frontier() -> deque[Any]:
        return deque()

    @staticmethod
    def _append_frontier(
        frontier: deque[tuple[str, int, _AncestryPermitTransition]],
        object_id: str,
        depth: int,
        transition: _AncestryPermitTransition,
    ) -> None:
        frontier.append((object_id, depth, transition))

    @staticmethod
    def _insert_seen(seen: set[str], object_id: str) -> None:
        seen.add(object_id)

    @staticmethod
    def _pop_frontier(
        frontier: deque[tuple[str, int, _AncestryPermitTransition]],
    ) -> tuple[str, int, _AncestryPermitTransition]:
        return frontier.popleft()

    @classmethod
    def _growth_plan(
        cls, count: int, slot_bytes: int
    ) -> tuple[int, int, int]:
        # CPython's set/deque resize thresholds do not line up with a logical
        # doubling schedule. Gate every insertion instead. The retained upper
        # covers the eventual collection allocation and the scratch upper
        # covers simultaneous old/new storage during an arbitrary resize.
        return count + 1, slot_bytes, (2 * count + 1) * slot_bytes

    @classmethod
    def _entry_bytes(cls, object_id: str, base: int) -> int:
        if not isinstance(object_id, str) or not object_id.isascii():
            raise CFError("HTTP upload ancestry requires an ASCII commit object ID")
        return base + len(object_id)

    def _poll(self) -> None:
        if self._deadline is not None:
            self._deadline.check("upload ancestry")

    def _ensure_ledger(self, ledger: DecisionWorkLedger) -> None:
        if id(ledger) != self._ledger_identity or id(self._ledger) != self._ledger_identity:
            raise CFError("HTTP upload ancestry belongs to a different ledger")

    def _ensure_open(self) -> None:
        self._ensure_ledger(self._ledger)
        if self._closed or self._seen is None or self._frontier is None:
            raise CFError("HTTP upload ancestry owner is closed")

    def _link_transition(self, transition: _AncestryPermitTransition) -> None:
        if getattr(transition, "_linked", False):
            raise CFError("HTTP upload ancestry transition is already linked")
        transition._prev = None
        transition._next = self._transition_head
        if self._transition_head is not None:
            self._transition_head._prev = transition
        self._transition_head = transition
        transition._linked = True

    def _retire_transition(self, transition: _AncestryPermitTransition) -> None:
        if not (
            transition._linked
            and transition._permit is None
            and transition._retained_primary_released
            and transition._retained_secondary_released
            and transition._temporary_released
        ):
            return
        previous = transition._prev
        following = transition._next
        if previous is None:
            self._transition_head = following
        else:
            previous._next = following
        if following is not None:
            following._prev = previous
        transition._prev = None
        transition._next = None
        transition._linked = False

    def _resolve_gate_handoff(self) -> None:
        transition = self._gate_handoff_transition
        if transition is None:
            return
        gate = self._allocation_gate
        # ``__new__`` publishes the handoff pointer before initialization so
        # allocation/adoption faults remain recoverable. Treat a missing slot
        # as an unlinked object still owned by the fixed gate.
        if getattr(transition, "_linked", False):
            gate._retained_acquired = False
            gate._temporary_acquired = False
            gate._retained_primary_released = True
            gate._retained_secondary_released = True
            gate._temporary_released = True
        else:
            transition._retained_acquired = False
            transition._temporary_acquired = False
            transition._retained_primary_released = True
            transition._retained_secondary_released = True
            transition._temporary_released = True
        self._gate_handoff_transition = None

    def _reset_allocation_gate(self) -> None:
        self._allocation_gate.__init__(self._ledger)

    def _prepare_transition(
        self,
        phase: str,
        *,
        retained_primary: int = 0,
        retained_secondary: int = 0,
        temporary: int = 0,
        **upper: Any,
    ) -> _AncestryPermitTransition:
        gate = self._allocation_gate
        if gate._permit is not None or not gate._acquires_resolved:
            raise CFError("HTTP upload ancestry allocation gate overlaps")
        retained_secondary += self.TRANSITION_BYTES
        gate.__init__(
            self._ledger,
            retained_primary=retained_primary,
            retained_secondary=retained_secondary,
            temporary=temporary,
        )
        transition: _AncestryPermitTransition | None = None
        try:
            gate.reserve(phase, **upper)
            self._poll()
            gate.consume(phase=phase, **upper)
            # Maxima leave a reusable residual reservation after exact
            # consumption. Each ancestry insertion is one-shot.
            gate.cancel()
            # The durable transition is created only after its own bytes were
            # acquired through the fixed owner-level gate above.
            transition = _AncestryPermitTransition.__new__(
                _AncestryPermitTransition
            )
            self._gate_handoff_transition = transition
            transition.adopt_acquired(
                self._ledger,
                retained_primary=retained_primary,
                retained_secondary=retained_secondary,
                temporary=temporary,
            )
            self._link_transition(transition)
            self._resolve_gate_handoff()
            self._reset_allocation_gate()
            return transition
        except BaseException:
            self._resolve_gate_handoff()
            gate.release_all()
            self._reset_allocation_gate()
            raise

    def _rollback_transition(self, transition: _AncestryPermitTransition) -> None:
        transition.release_all()
        self._retire_transition(transition)

    def _push_frontier(self, object_id: str, depth: int, *, edge: bool) -> None:
        self._ensure_open()
        assert self._frontier is not None
        frame_bytes = self._entry_bytes(object_id, self.FRAME_BASE_BYTES)
        # A deque may retain a partially consumed block after popleft, so its
        # backing upper follows this owner's historical insertion attempts,
        # not merely the current frontier length.
        frontier_insertions = self._ledger._counters.get(
            "frontier_insertion_attempts", 0
        )
        _next_count, growth, scratch = self._growth_plan(
            frontier_insertions, self.FRONTIER_SLOT_BYTES
        )
        retained = frame_bytes + growth + self.TRANSITION_BYTES
        acquires = {"retained_bytes": retained}
        if scratch:
            acquires["temporary_bytes"] = scratch
        charges = {"graph_edges": 1} if edge else {}
        counters = {"frontier_insertion_attempts": 1}
        if edge:
            counters["edge_occurrences"] = 1
        transition = self._prepare_transition(
            "graph_discovery",
            retained_primary=frame_bytes,
            retained_secondary=growth,
            temporary=scratch,
            acquires=acquires,
        )
        # For an edge, the child-depth PyLong is part of the retained frame.
        # Do not materialize it until the frame acquisition above commits.
        frame_depth = depth + 1 if edge else depth
        try:
            self._ledger.apply(
                "graph_discovery",
                charges=charges,
                maxima={
                    "logical_depth": frame_depth,
                    "maximum_frontier": len(self._frontier) + 1,
                },
                counters=counters,
            )
        except BaseException:
            frame_depth = None
            self._rollback_transition(transition)
            raise
        count_before = len(self._frontier)
        failure: BaseException | None = None
        try:
            self._append_frontier(
                self._frontier, object_id, frame_depth, transition
            )
        except BaseException as error:
            failure = error
        committed = len(self._frontier) == count_before + 1
        if failure is not None and committed:
            _detach_ancestry_exception_chain(failure)
        elif failure is not None:
            _detach_ancestry_exception_chain(failure)
            self._rollback_transition(transition)
            raise failure from None
        elif not committed:
            self._rollback_transition(transition)
            raise CFError("HTTP upload ancestry frontier append did not commit")
        transition.release_temporary()
        self._retire_transition(transition)

    def _mark_seen(self, object_id: str) -> bool:
        self._ensure_open()
        assert self._seen is not None
        if object_id in self._seen:
            self._poll()
            self._ledger.apply(
                "graph_discovery", counters={"revisits": 1, "memo_hits": 1}
            )
            return False
        entry_bytes = self._entry_bytes(object_id, self.SEEN_ENTRY_BASE_BYTES)
        _next_count, growth, scratch = self._growth_plan(
            len(self._seen), self.SEEN_SLOT_BYTES
        )
        retained = entry_bytes + growth + self.TRANSITION_BYTES
        acquires = {"retained_bytes": retained}
        if scratch:
            acquires["temporary_bytes"] = scratch
        transition = self._prepare_transition(
            "graph_discovery",
            retained_primary=entry_bytes,
            retained_secondary=growth,
            temporary=scratch,
            charges={"graph_nodes": 1},
            acquires=acquires,
            counters={"unique_nodes_discovered": 1, "memo_misses": 1},
        )
        count_before = len(self._seen)
        failure: BaseException | None = None
        try:
            self._insert_seen(self._seen, object_id)
        except BaseException as error:
            failure = error
        committed = len(self._seen) == count_before + 1 and object_id in self._seen
        if failure is not None and committed:
            _detach_ancestry_exception_chain(failure)
        elif failure is not None:
            _detach_ancestry_exception_chain(failure)
            self._rollback_transition(transition)
            raise failure from None
        elif not committed:
            self._rollback_transition(transition)
            raise CFError("HTTP upload ancestry seen insertion did not commit")
        transition.release_temporary()
        self._retire_transition(transition)
        return True

    def _take_frontier(self) -> tuple[str, int]:
        self._ensure_open()
        assert self._frontier is not None
        if self._active_frame_transition is not None:
            raise CFError("HTTP upload ancestry active frame overlaps")
        object_id, depth, transition = self._pop_frontier(self._frontier)
        self._active_frame_transition = transition
        return object_id, depth

    def _release_active_frame(self) -> None:
        transition = self._active_frame_transition
        if transition is None:
            return
        transition.release_primary()
        if transition._retained_primary_released:
            self._active_frame_transition = None
            self._retire_transition(transition)

    def contains(self, ancestor: str, head: str) -> bool:
        self._ensure_ledger(self._ledger)
        if self._used:
            raise CFError("HTTP upload ancestry owner is single-use")
        self._ensure_open()
        self._used = True
        found = False
        object_id: str | None = None
        depth: int | None = None
        commit: dict[str, Any] | None = None
        parents: list[Any] | None = None
        loaded: Any = None
        parents_value: Any = None
        parent: Any = None
        failure: BaseException | None = None
        try:
            self._entry_bytes(ancestor, self.FRAME_BASE_BYTES)
            self._entry_bytes(head, self.FRAME_BASE_BYTES)
            self._push_frontier(head, 0, edge=False)
            assert self._frontier is not None
            while self._frontier:
                self._poll()
                object_id, depth = self._take_frontier()
                if not self._mark_seen(object_id):
                    object_id = None
                    depth = None
                    self._release_active_frame()
                    continue
                if object_id == ancestor:
                    found = True
                self._poll()
                loaded = self._loader(object_id)
                self._poll()
                if not isinstance(loaded, dict):
                    raise CFError("HTTP upload ancestry loader returned a non-object commit")
                commit = loaded
                loaded = None
                parents_value = commit.get("parents", [])
                if not isinstance(parents_value, list):
                    raise CFError("HTTP upload ancestry commit parents must be a list")
                parents = parents_value
                for parent in parents:
                    self._poll()
                    self._entry_bytes(parent, self.FRAME_BASE_BYTES)
                    assert depth is not None
                    self._push_frontier(parent, depth, edge=True)
                parent = None
                parents = None
                parents_value = None
                commit = None
                loaded = None
                object_id = None
                depth = None
                self._release_active_frame()
        except BaseException as error:
            _detach_ancestry_exception_chain(error)
            failure = error
        parents = None
        parent = None
        parents_value = None
        commit = None
        loaded = None
        object_id = None
        depth = None
        if failure is not None:
            cleanup_failure: BaseException | None = None
            try:
                self.close()
            except BaseException as error:
                _detach_ancestry_exception_chain(error)
                cleanup_failure = error
            if cleanup_failure is not None:
                raise cleanup_failure from failure
            raise failure from None
        self.close()
        return found

    def _drop_payloads(self) -> None:
        if self._frontier is not None:
            self._frontier.clear()
            self._frontier = None
        if self._seen is not None:
            self._seen.clear()
            self._seen = None
        self._active_frame_transition = None
        self._loader = None
        self._deadline = None

    def close(self, ledger: DecisionWorkLedger | None = None) -> None:
        selected = self._ledger if ledger is None else ledger
        self._ensure_ledger(selected)
        if self._closed:
            return
        if self._closing:
            return
        self._closing = True
        completed = False
        try:
            self._drop_payloads()
            self._resolve_gate_handoff()
            self._allocation_gate.release_all()
            transition = self._transition_head
            while transition is not None:
                following = transition._next
                transition.release_all()
                self._retire_transition(transition)
                transition = following
            if self._transition_head is not None:
                raise CFError("HTTP upload ancestry scalar cleanup is incomplete")
            completed = True
        finally:
            if completed:
                self._closed = True
            self._closing = False

    def __del__(self) -> None:
        try:
            self.close()
        except BaseException:
            pass


def ancestor_distances_from_objects(objects_root: Path, commit_id: str) -> dict[str, int]:
    distances: dict[str, int] = {}
    queue = deque([(commit_id, 0)])
    while queue:
        current, dist = queue.popleft()
        if current in distances and distances[current] <= dist:
            continue
        distances[current] = dist
        commit = load_object_from_root(objects_root, current)
        for parent in commit.get("parents", []):
            queue.append((parent, dist + 1))
    return distances


def is_ancestor_from_objects(objects_root: Path, ancestor: str, commit_id: str) -> bool:
    return ancestor in ancestor_distances_from_objects(objects_root, commit_id)


def http_project_root(storage_root: Path, org: str, app: str) -> Path:
    return storage_root / ".codefire-server" / "projects" / org / app


def http_error(status: int, message: str) -> tuple[int, dict[str, Any]]:
    return status, {"error": message}

class AccountedHTTPBundle(dict):
    """Own one bundle projection until the response encoder drops the payload."""

    def __init__(
        self,
        ledger: DecisionWorkLedger,
        branch: dict[str, Any],
        records: list[dict[str, Any]],
        retained_bytes: int,
    ) -> None:
        super().__init__(branch=branch, objects=records)
        self._ledger = ledger
        self._ledger_identity = id(ledger)
        self._retained_bytes = retained_bytes
        self._closed = False

    def close(self) -> None:
        if self._closed:
            return
        if id(self._ledger) != self._ledger_identity:
            raise CFError("HTTP bundle belongs to a different decision-work ledger")
        retained = self._retained_bytes
        if retained:
            self._ledger.release("retained_bytes", retained)
        dict.clear(self)
        self._retained_bytes = 0
        self._closed = True

    def __del__(self) -> None:
        try:
            self.close()
        except BaseException:
            pass


def _object_record_core_json_size(
    record: dict[str, Any], poll: Any | None = None
) -> int:
    field_count = 0
    size = 2
    for key, value in record.items():
        if poll is not None:
            poll()
        if key == "remote":
            continue
        if field_count:
            size += 1
        size += (
            canonical_json_size_up_to(str(key), U64_MAX, poll)
            + 1
            + canonical_json_size_up_to(value, U64_MAX, poll)
        )
        field_count += 1
    return size


def _http_bundle_payload_json_size(
    branch: dict[str, Any],
    ordered_ids: list[str],
    documents: dict[str, Any],
    poll: Any | None = None,
) -> int:
    records_size = 2 + max(0, len(ordered_ids) - 1)
    for object_id in ordered_ids:
        if poll is not None:
            poll()
        records_size += _object_record_core_json_size(
            documents[object_id].record, poll
        )
    return (
        2
        + 1
        + canonical_json_size("branch")
        + 1
        + canonical_json_size_up_to(branch, U64_MAX, poll)
        + canonical_json_size("objects")
        + 1
        + records_size
    )


def collect_http_bundle_payload(
    objects_root: Path,
    branch: dict[str, Any],
    branch_retained: int,
    ledger: DecisionWorkLedger,
    deadline: HTTPRequestDeadline | None = None,
) -> AccountedHTTPBundle:
    """Validate and collect one deterministic bundle under one request ledger."""
    head = branch.get("head")
    if not isinstance(head, str):
        if branch_retained:
            head = None
            branch.clear()
            ledger.release("retained_bytes", branch_retained)
        raise CFError("remote branch head is not a commit object ID")

    validation: SealedCommitValidationSession | None = None
    collection: SealedCommitValidationSession | None = None
    stack: list[tuple[str, int]] = []
    seen: set[str] = set()
    seen_retained = 0
    sort_temporary = 0
    payload_retained = 0
    ordered_ids: list[str] | None = None
    records: list[dict[str, Any]] | None = None
    payload: AccountedHTTPBundle | None = None
    record: dict[str, Any] | None = None

    def poll(phase: str) -> None:
        if deadline is not None:
            deadline.check(phase)

    def push(reference: str, depth: int, *, edge: bool) -> None:
        poll("bundle object collection")
        frame_bytes = SealedCommitValidationSession._frame_size(reference)
        counters = {"frontier_insertion_attempts": 1}
        charges = None
        if edge:
            charges = {"graph_edges": 1}
            counters["edge_occurrences"] = 1
        ledger.apply(
            "graph_discovery",
            charges=charges,
            maxima={
                "logical_depth": depth,
                "maximum_frontier": len(stack) + 1,
            },
            acquires={"retained_bytes": frame_bytes},
            counters=counters,
        )
        stack.append((reference, depth))

    try:
        poll("bundle sealed validation")
        validation = SealedCommitValidationSession(objects_root, ledger)
        validation.validate_commit(
            head, poll=lambda: poll("bundle sealed validation")
        )
        validation.finalize(
            terminate=False,
            poll=lambda: poll("bundle snapshot revalidation"),
        )
        validation = None

        poll("bundle object collection")
        collection = SealedCommitValidationSession(objects_root, ledger)
        push(head, 0, edge=False)
        while stack:
            poll("bundle object collection")
            object_id, depth = stack[-1]
            frame_bytes = SealedCommitValidationSession._frame_size(object_id)
            if object_id in seen:
                stack.pop()
                ledger.count("revisits", 1, "graph_discovery")
                object_id = None
                ledger.release("retained_bytes", frame_bytes)
                continue
            ledger.apply(
                "graph_discovery",
                charges={"graph_nodes": 1},
                counters={"unique_nodes_discovered": 1},
            )
            stack.pop()
            seen.add(object_id)
            seen_retained += frame_bytes
            collection.load_payload(
                object_id, poll=lambda: poll("bundle object collection")
            )
            record = collection.documents[object_id].record

            def push_reference(reference: str) -> None:
                push(reference, depth + 1, edge=True)

            visit_object_record_references(
                record,
                push_reference,
                lambda: poll("bundle object collection"),
            )
            record = None
            push_reference = None
            object_id = None

        poll("bundle response planning")
        sort_temporary = seen_retained + 8 * len(seen)
        ledger.acquire("temporary_bytes", sort_temporary, "query")
        ordered_ids = sorted(seen)
        poll("bundle response planning")

        payload_retained = _http_bundle_payload_json_size(
            branch,
            ordered_ids,
            collection.documents,
            lambda: poll("bundle response planning"),
        )
        ledger.acquire("retained_bytes", payload_retained, "encoding")
        records = []
        for object_id in ordered_ids:
            poll("bundle response planning")
            records.append(
                object_record_core(collection.documents[object_id].record)
            )
        ordered_ids = None
        ledger.release("temporary_bytes", sort_temporary)
        sort_temporary = 0
        payload = AccountedHTTPBundle(
            ledger, branch, records, payload_retained
        )
        records = None
        collection.finalize(
            terminate=False,
            poll=lambda: poll("bundle snapshot revalidation"),
        )
        collection = None
        seen.clear()
        if seen_retained:
            ledger.release("retained_bytes", seen_retained)
            seen_retained = 0
        if branch_retained:
            ledger.release("retained_bytes", branch_retained)
            branch_retained = 0
        poll("bundle response planning")
        return payload
    except BaseException:
        if payload is not None:
            try:
                payload.close()
            except BaseException:
                pass
            payload_retained = 0
        else:
            records = None
            if payload_retained:
                try:
                    ledger.release("retained_bytes", payload_retained)
                except BaseException:
                    pass
                payload_retained = 0
        raise
    finally:
        record = None
        head = None
        ordered_ids = None
        if sort_temporary:
            try:
                ledger.release("temporary_bytes", sort_temporary)
            except BaseException:
                pass
        while stack:
            object_id, _ = stack.pop()
            frame_bytes = SealedCommitValidationSession._frame_size(object_id)
            object_id = None
            try:
                ledger.release(
                    "retained_bytes",
                    frame_bytes,
                )
            except BaseException:
                pass
        seen.clear()
        if seen_retained:
            try:
                ledger.release("retained_bytes", seen_retained)
            except BaseException:
                pass
        if collection is not None:
            collection.close(None)
        if validation is not None:
            validation.close(None)
        if branch_retained:
            branch.clear()
            try:
                ledger.release("retained_bytes", branch_retained)
            except BaseException:
                pass


def handle_http_list(storage_root: Path, org: str, app: str) -> tuple[int, dict[str, Any]]:
    project_root = http_project_root(storage_root, org, app)
    dirs = remote_dirs(project_root)
    if not dirs["branches"].exists():
        return http_error(404, "remote project not found")
    with remote_project_gate(project_root, shared=True):
        branches = []
        for path in sorted(dirs["branches"].glob("*.json")):
            branch = validate_remote_branch_record(read_json(path))
            validate_sealed_commit(dirs["objects"], branch["head"])
            branches.append({"version": 1, "name": branch["name"], "head": branch["head"]})
    return 200, {"branches": branches}


def handle_http_doctor(
    storage_root: Path, org: str, app: str, quick: bool = False
) -> tuple[int, dict[str, Any]]:
    project_root = http_project_root(storage_root, org, app)
    url = f"cf+http://{org}/{app}"
    if not project_root.exists():
        return 200, remote_doctor_payload(project_root, url, quick=quick)
    with remote_project_gate(project_root, shared=True):
        return 200, remote_doctor_payload(project_root, url, quick=quick)


def handle_http_gc(storage_root: Path, org: str, app: str, request: dict[str, Any]) -> tuple[int, dict[str, Any]]:
    project_root = http_project_root(storage_root, org, app)
    if not remote_dirs(project_root)["project"].exists():
        return http_error(404, "remote project not found")
    info = {"org": org, "app": app}
    args = argparse.Namespace(actor=request.get("actor"), token=request.get("token"), request_signature=request.get("request_signature"))
    actor = authorize_remote(
        project_root,
        "gc",
        args,
        target=remote_request_target(info, "gc"),
        payload=request,
    )
    payload = remote_gc_payload(
        project_root,
        {"org": org, "app": app, "url": f"cf+http://{org}/{app}"},
        actor,
        bool(request.get("dry_run")),
    )
    return 200, payload


def handle_http_bundle(
    storage_root: Path,
    org: str,
    app: str,
    branch_name: str,
    ledger: DecisionWorkLedger,
    *,
    deadline: HTTPRequestDeadline | None = None,
) -> tuple[int, dict[str, Any]]:
    def poll(phase: str) -> None:
        if deadline is not None:
            deadline.check(phase)

    project_root = http_project_root(storage_root, org, app)
    dirs = remote_dirs(project_root)
    branch: dict[str, Any] | None = None
    branch_retained = 0
    poll("bundle project gate")
    with remote_project_gate(project_root, shared=True):
        try:
            poll("bundle branch authority")
            branch, branch_retained = read_json_accounted(
                remote_branch_path(project_root, branch_name),
                ledger,
                poll=lambda: poll("bundle branch authority"),
            )
            poll("bundle branch authority")
            if branch is None:
                return http_error(404, "remote branch not found")
            validate_remote_branch_record(branch)
            poll("bundle branch authority")
            transferred_branch = branch
            transferred_retained = branch_retained
            branch = None
            branch_retained = 0
            return 200, collect_http_bundle_payload(
                dirs["objects"],
                transferred_branch,
                transferred_retained,
                ledger,
                deadline,
            )
        finally:
            if branch_retained:
                if branch is not None:
                    branch.clear()
                ledger.release("retained_bytes", branch_retained)


def http_remote_branch(storage_root: Path, url: str) -> tuple[dict[str, Any], Path, dict[str, Any]]:
    info = parse_cf_http_url(url)
    project_root = http_project_root(storage_root, info["org"], info["app"])
    branch = read_remote_branch_record(project_root, info["branch"])
    if not branch:
        raise CFError(f"remote branch not found: {url}")
    validate_sealed_commit(remote_dirs(project_root)["objects"], branch["head"])
    return info, project_root, branch


def validate_http_merge_request_record(storage_root: Path, mr: dict[str, Any]) -> None:
    validate_persisted_record_version(mr, "remote_merge_request")
    validate_remote_component(str(mr.get("id", "")), "merge-request ID")
    source_info = parse_cf_http_url(mr["source_url"])
    source_root = http_project_root(storage_root, source_info["org"], source_info["app"])
    target_info = parse_cf_http_url(mr["target_url"])
    target_root = http_project_root(storage_root, target_info["org"], target_info["app"])
    source = {**source_info, "project_root": source_root}
    target = {**target_info, "project_root": target_root}
    source_objects = (
        remote_dirs(target_root)["objects"]
        if "subject" in mr
        else remote_dirs(source_root)["objects"]
    )
    refs = [
        ("source_head", source_objects, mr.get("source_head")),
        ("target_head_at_request", remote_dirs(target_root)["objects"], mr.get("target_head_at_request")),
    ]
    if mr.get("applied_head"):
        refs.append(("applied_head", remote_dirs(target_root)["objects"], mr.get("applied_head")))
    for key, objects_root, commit_id in refs:
        if not isinstance(commit_id, str):
            raise CFError(f"merge request validation failed: {key} must be a commit object id")
        try:
            validate_sealed_commit(objects_root, commit_id)
        except CFError as exc:
            raise CFError(f"merge request validation failed: {key}: {exc}") from exc
    if source_info["endpoint"] != target_info["endpoint"]:
        raise CFError("HTTP merge requests across different remote endpoints are not supported")
    if "subject" in mr:
        validate_merge_request_subject(mr, source, target)


def handle_http_request_merge(storage_root: Path, org: str, app: str, request: dict[str, Any]) -> tuple[int, dict[str, Any]]:
    project_root = http_project_root(storage_root, org, app)
    source_url = request.get("source_url")
    target_url = request.get("target_url")
    if not isinstance(source_url, str) or not isinstance(target_url, str):
        return http_error(400, "request-merge requires source_url and target_url")
    source_info = parse_cf_http_url(source_url)
    source_root = http_project_root(storage_root, source_info["org"], source_info["app"])
    target_info = parse_cf_http_url(target_url)
    target_root = http_project_root(storage_root, target_info["org"], target_info["app"])
    if target_root != project_root or target_info["org"] != org or target_info["app"] != app:
        return http_error(400, "target_url must belong to this project")
    info = {"org": org, "app": app}
    args = argparse.Namespace(actor=request.get("actor"), token=request.get("token"), request_signature=request.get("request_signature"))
    actor = authorize_remote(
        project_root,
        "request_merge",
        args,
        target=remote_request_target(info, "request_merge"),
        payload=request,
    )
    ensure_remote_layout(project_root)
    _, _, source_branch = http_remote_branch(storage_root, source_url)
    _, _, target_branch = http_remote_branch(storage_root, target_url)
    source_records = collect_object_records(remote_dirs(source_root)["objects"], source_branch["head"])
    object_set_digest = merge_request_object_set_digest(source_records)
    mr_payload = {
        "version": VERSION,
        "source_url": source_url,
        "source_head": source_branch["head"],
        "target_url": target_url,
        "target_head_at_request": target_branch["head"],
        "status": "open",
        "created_by": actor,
        "created_at": now_iso(),
    }
    mr_id = "MR-" + hashlib.sha256(canonical_json(mr_payload)).hexdigest()[:12]
    mr_payload["id"] = mr_id
    source_subject = {**source_info, "project_root": source_root}
    target_subject = {**target_info, "project_root": target_root}
    subject = build_merge_request_subject(
        mr_id,
        source_subject,
        target_subject,
        source_branch["head"],
        target_branch["head"],
        object_set_digest,
    )
    mr_payload["subject"] = subject
    mr_payload["subject_digest"] = merge_request_subject_digest(subject)
    with ordered_remote_merge_gates(source_root, target_root):
        _, _, locked_source = http_remote_branch(storage_root, source_url)
        _, locked_target_root, locked_target = http_remote_branch(storage_root, target_url)
        if locked_target_root != project_root:
            return http_error(400, "target_url must belong to this project")
        if locked_source["head"] != source_branch["head"] or locked_target["head"] != target_branch["head"]:
            return http_error(409, "request-merge source or target changed while acquiring project gate")
        copy_object_graph(remote_dirs(source_root)["objects"], remote_dirs(target_root)["objects"], source_branch["head"])
        result = execute_remote_json_publication(
            project_root,
            "remote_request_merge",
            actor,
            {
                "source_project_id": remote_project_stable_id(source_root),
                "target_project_id": remote_project_stable_id(target_root),
                "source_branch": source_info["branch"],
                "target_branch": target_info["branch"],
                "source_head": source_branch["head"],
                "target_head_at_request": target_branch["head"],
                "source_object_set_digest": object_set_digest,
            },
            [
                (
                    {"kind": "merge_request", "id": mr_id},
                    None,
                    mr_payload,
                )
            ],
            {
                "id": mr_id,
                "source_head": source_branch["head"],
                "target_head": target_branch["head"],
            },
            idempotency_key=request.get("idempotency_key") or None,
            object_roots=[source_branch["head"]],
        )
    return 200, result


def handle_http_request_list(storage_root: Path, org: str, app: str) -> tuple[int, dict[str, Any]]:
    project_root = http_project_root(storage_root, org, app)
    dirs = remote_dirs(project_root)
    if not dirs["merge_requests"].exists():
        return http_error(404, "remote project not found")
    with remote_project_gate(project_root, shared=True):
        requests = []
        for path in sorted(dirs["merge_requests"].glob("*.json")):
            mr = read_remote_merge_request_path(path)
            source_info = parse_cf_http_url(mr["source_url"])
            source_root = http_project_root(
                storage_root, source_info["org"], source_info["app"]
            )
            target_info = parse_cf_http_url(mr["target_url"])
            target_root = http_project_root(
                storage_root, target_info["org"], target_info["app"]
            )
            if target_root != project_root:
                raise CFError(
                    "merge request target does not belong to the listed project"
                )
            reject_legacy_cross_project_merge_request_read(
                mr, source_root, target_root
            )
            validate_http_merge_request_record(storage_root, mr)
            current_target = read_remote_branch_record(
                target_root, target_info["branch"]
            )
            status = mr.get("status", "open")
            if current_target and current_target["head"] != mr["target_head_at_request"]:
                status = "stale"
            requests.append({"id": mr["id"], "status": status, "source_url": mr["source_url"], "target_url": mr["target_url"]})
    return 200, {"merge_requests": requests}


def handle_http_request_review(storage_root: Path, org: str, app: str, mr_id: str, request: dict[str, Any]) -> tuple[int, dict[str, Any]]:
    project_root = http_project_root(storage_root, org, app)
    dirs = remote_dirs(project_root)
    info = {"org": org, "app": app}
    args = argparse.Namespace(actor=request.get("actor"), token=request.get("token"), request_signature=request.get("request_signature"))
    actor = authorize_remote(
        project_root,
        "review",
        args,
        target=remote_request_target(info, "review", mr_id=mr_id),
        payload=request,
    )
    mr_path = remote_merge_request_path(project_root, mr_id)
    mr = read_remote_merge_request_path(mr_path)
    if not mr:
        return http_error(404, "merge request not found")
    initial_source_url = mr.get("source_url")
    initial_target_url = mr.get("target_url")
    target_info = parse_cf_http_url(mr["target_url"])
    target_root = http_project_root(storage_root, target_info["org"], target_info["app"])
    if target_root != project_root:
        return http_error(400, "merge request target does not belong to this project")
    decision = request.get("decision")
    if decision not in {"approve", "reject"}:
        return http_error(400, "review decision must be approve or reject")
    reviewer = request.get("reviewer")
    if not isinstance(reviewer, str) or not reviewer:
        return http_error(400, "reviewer is required")
    source_info = parse_cf_http_url(mr["source_url"])
    source_root = http_project_root(storage_root, source_info["org"], source_info["app"])
    review_gate = (
        remote_project_gate(target_root)
        if "subject" in mr
        else ordered_remote_merge_gates(source_root, target_root)
    )
    with review_gate:
        mr = read_remote_merge_request_path(mr_path)
        if not mr:
            return http_error(404, "merge request not found")
        if (
            mr.get("source_url") != initial_source_url
            or mr.get("target_url") != initial_target_url
        ):
            raise CFError(
                "merge request endpoints changed while acquiring project gates"
            )
        validate_http_merge_request_record(storage_root, mr)
        target_info = parse_cf_http_url(mr["target_url"])
        target_root = http_project_root(storage_root, target_info["org"], target_info["app"])
        current_target = read_remote_branch_record(target_root, target_info["branch"])
        subject_is_materialized = "subject" in mr
        if (
            not subject_is_materialized
            and current_target
            and current_target["head"] != mr["target_head_at_request"]
        ):
            return http_error(409, f"merge request is stale: {mr_id}")
        mr_before = dict(mr)
        subject_digest = materialize_merge_request_subject(
            mr,
            {**source_info, "project_root": source_root},
            {**target_info, "project_root": target_root},
        )
        comment = request.get("comment") if isinstance(request.get("comment"), str) else ""
        review = {
            "reviewer": reviewer,
            "decision": decision,
            "comment": comment,
            "subject_digest": subject_digest,
            "reviewed_at": now_iso(),
        }
        reviews = list(mr.get("reviews", []))
        reviews.append(review)
        mr["reviews"] = reviews
        mr["status"] = "approved" if decision == "approve" else "rejected"
        semantic = {
            "stable_project_id": remote_project_stable_id(project_root),
            "merge_request_id": mr_id,
            "reviewer": reviewer,
            "decision": decision,
            "comment": comment,
            "subject_digest": subject_digest,
        }
        writes = [
            (
                {"kind": "merge_request", "id": mr_id},
                mr_before,
                mr,
            )
        ]
        result = {"id": mr_id, "reviewer": reviewer, "decision": decision}
        idempotency_key = request.get("idempotency_key") or None
        if remote_publication_recovery_exists(
            project_root,
            "remote_request_review",
            actor,
            idempotency_key,
        ):
            return 200, execute_remote_json_publication(
                project_root,
                "remote_request_review",
                actor,
                semantic,
                writes,
                result,
                idempotency_key=idempotency_key,
                object_roots=[str(mr["source_head"])],
            )
        if (
            subject_is_materialized
            and current_target
            and current_target["head"] != mr["target_head_at_request"]
        ):
            return http_error(409, f"merge request is stale: {mr_id}")
        result = execute_remote_json_publication(
            project_root,
            "remote_request_review",
            actor,
            semantic,
            writes,
            result,
            idempotency_key=idempotency_key,
            object_roots=[str(mr["source_head"])],
        )
    return 200, result


def handle_http_request_apply(storage_root: Path, org: str, app: str, mr_id: str, request: dict[str, Any]) -> tuple[int, dict[str, Any]]:
    project_root = http_project_root(storage_root, org, app)
    dirs = remote_dirs(project_root)
    info = {"org": org, "app": app}
    args = argparse.Namespace(actor=request.get("actor"), token=request.get("token"), request_signature=request.get("request_signature"))
    actor = authorize_remote(
        project_root,
        "apply",
        args,
        target=remote_request_target(info, "apply", mr_id=mr_id),
        payload=request,
    )
    mr_path = remote_merge_request_path(project_root, mr_id)
    mr = read_remote_merge_request_path(mr_path)
    if not mr:
        return http_error(404, "merge request not found")
    validate_http_merge_request_record(storage_root, mr)
    source_info = parse_cf_http_url(mr["source_url"])
    source_root = http_project_root(storage_root, source_info["org"], source_info["app"])
    target_info = parse_cf_http_url(mr["target_url"])
    target_root = http_project_root(storage_root, target_info["org"], target_info["app"])
    if target_root != project_root or target_info["org"] != org or target_info["app"] != app:
        return http_error(400, "target_url must belong to this project")
    subject_digest = validate_merge_request_subject(
        mr,
        {**source_info, "project_root": source_root},
        {**target_info, "project_root": target_root},
    )
    source_head = str(mr["source_head"])
    semantic = {
        "stable_project_id": remote_project_stable_id(target_root),
        "merge_request_id": mr_id,
        "subject_digest": subject_digest,
        "target_branch": target_info["branch"],
        "source_head": source_head,
        "target_head_at_request": mr["target_head_at_request"],
    }
    result = {
        "id": mr_id,
        "target_branch": target_info["branch"],
        "head": source_head,
    }
    idempotency_key = request.get("idempotency_key") or None
    if remote_publication_recovery_exists(
        target_root, "remote_request_apply", actor, idempotency_key
    ):
        with remote_project_gate(target_root):
            current_generation = read_json(remote_generation_path(target_root))
            current_target = read_remote_branch_record(
                target_root, target_info["branch"]
            )
            current_mr = read_remote_merge_request_path(mr_path)
            recovered = execute_remote_json_publication(
                target_root,
                "remote_request_apply",
                actor,
                semantic,
                [
                    ({"kind": "generation"}, current_generation, current_generation),
                    (
                        {"kind": "branch", "name": target_info["branch"]},
                        current_target,
                        current_target,
                    ),
                    (
                        {"kind": "merge_request", "id": mr_id},
                        current_mr,
                        current_mr,
                    ),
                ],
                result,
                idempotency_key=idempotency_key,
                object_roots=list(
                    dict.fromkeys([source_head, str(mr["target_head_at_request"])])
                ),
            )
        return 200, recovered
    if mr.get("status") != "approved":
        return http_error(409, f"merge request must be approved before apply: {mr_id}")
    target_info, target_root, target_branch = http_remote_branch(storage_root, mr["target_url"])
    if target_root != project_root or target_info["org"] != org or target_info["app"] != app:
        return http_error(400, "target_url must belong to this project")
    if not merge_request_has_effective_approval(mr, subject_digest):
        return http_error(409, f"merge request approval is not bound to its current subject: {mr_id}")
    check_remote_branch_protection(target_root, target_info["branch"], "apply", actor)
    if target_branch["head"] != mr["target_head_at_request"]:
        return http_error(409, f"merge request is stale: {mr_id}")
    escrow_objects = remote_dirs(target_root)["objects"]
    enforce_remote_commit_signature_policy(target_root, escrow_objects, source_head)
    if not remote_is_ancestor(target_root, target_branch["head"], source_head):
        return http_error(409, "request apply rejected: source is not a fast-forward of target")
    with remote_project_gate(target_root):
        current_mr = read_remote_merge_request_path(mr_path)
        if current_mr != mr:
            return http_error(409, f"merge request changed while acquiring project gate: {mr_id}")
        current_target = read_remote_branch_record(target_root, target_info["branch"])
        if current_target["head"] != mr["target_head_at_request"]:
            return http_error(409, f"merge request is stale: {mr_id}")
        generation_before = read_json(remote_generation_path(target_root))
        generation = (
            generation_before.get("current_generation", 0)
            if isinstance(generation_before, dict)
            else 0
        ) + 1
        branch_after = {
            "version": VERSION,
            "name": target_info["branch"],
            "head": source_head,
            "generation": generation,
            "applied_from": mr["source_url"],
            "applied_by": actor,
            "transport": "http",
            "updated_at": now_iso(),
        }
        mr_after = dict(mr)
        mr_after["status"] = "applied"
        mr_after["applied_at"] = now_iso()
        mr_after["applied_by"] = actor
        mr_after["applied_head"] = source_head
        result = execute_remote_json_publication(
            target_root,
            "remote_request_apply",
            actor,
            semantic,
            [
                (
                    {"kind": "generation"},
                    generation_before,
                    {"current_generation": generation},
                ),
                (
                    {"kind": "branch", "name": target_info["branch"]},
                    current_target,
                    branch_after,
                ),
                (
                    {"kind": "merge_request", "id": mr_id},
                    mr,
                    mr_after,
                ),
            ],
            result,
            idempotency_key=idempotency_key,
            object_roots=list(
                dict.fromkeys([source_head, str(mr["target_head_at_request"])])
            ),
        )
    return 200, result


def handle_http_upload(
    storage_root: Path,
    org: str,
    app: str,
    branch_name: str,
    request: dict[str, Any],
    *,
    response_slot: Any | None = None,
    decision_work: DecisionWorkLedger | None = None,
    deadline: HTTPRequestDeadline | None = None,
) -> tuple[int, dict[str, Any]]:
    project_root = http_project_root(storage_root, org, app)
    dirs = remote_dirs(project_root)
    local_branch = str(request.get("branch", ""))
    head = request.get("head")
    records = request.get("objects", [])
    if not local_branch or not isinstance(head, str) or not head.startswith("CF-COMMIT-") or not isinstance(records, list):
        return http_error(400, "upload request must include branch, head, and objects")
    records = canonical_remote_object_records(records)
    info = {"org": org, "app": app}
    args = argparse.Namespace(actor=request.get("actor"), token=request.get("token"), request_signature=request.get("request_signature"))
    actor = actor_from_args(args)
    idempotency_key = request.get("idempotency_key")
    validate_remote_json_publication_subject(
        "remote_upload", actor, idempotency_key
    )
    actor, nonce_plan = authorize_remote_without_nonce(
        project_root,
        "upload",
        args,
        remote_request_target(info, "upload", branch=branch_name),
        request,
    )
    check_remote_branch_protection(project_root, branch_name, "upload", actor)
    closure = plan_http_upload_closure(
        dirs["objects"], head, records, decision_work, deadline
    )
    result = {"branch": branch_name, "head": head}
    project_existed = (project_root / "remote_project.json").is_file()
    stage_owner: AccountedHTTPUploadStage | None = None
    sealed_validation_owner: AccountedHTTPUploadSealedValidation | None = None
    sealed_validation_bounds: tuple[int, int, int] | None = None
    tmp_root: Path | None = None
    tmp_objects: Path | None = None
    publication_succeeded = False
    try:
        if decision_work is not None:
            stage_owner = prepare_http_upload_stage(
                decision_work,
                dirs["objects"],
                records,
                closure,
                deadline,
            )
            stage_owner.seal_pre_effect()
            sealed_validation_bounds = stage_owner.take_sealed_validation_bounds()
        tmp_root = Path(tempfile.mkdtemp(prefix="codefire-http-upload-"))
        tmp_objects = tmp_root / "objects"
        try:
            stage_http_upload_closure(
                dirs["objects"],
                tmp_objects,
                records,
                closure,
                None if stage_owner is not None else decision_work,
                deadline,
                prepared_stage=stage_owner,
            )
        finally:
            close_closure = getattr(closure, "close", None)
            if close_closure is not None:
                close_closure()
        if decision_work is None:
            validate_sealed_commit(tmp_objects, head)
        else:
            if sealed_validation_bounds is None:
                raise CFError("HTTP upload sealed-validation bounds are unavailable")
            (
                record_count_upper,
                aggregate_bytes_upper,
                maximum_record_bytes_upper,
            ) = sealed_validation_bounds
            sealed_validation_bounds = None
            sealed_validation_owner = prepare_http_upload_sealed_validation(
                decision_work,
                tmp_objects,
                head,
                record_count_upper=record_count_upper,
                aggregate_bytes_upper=aggregate_bytes_upper,
                maximum_record_bytes_upper=maximum_record_bytes_upper,
                deadline=deadline,
            )
            sealed_validation_owner.validate(decision_work)
            sealed_validation_owner.finish(decision_work)
        enforce_remote_commit_signature_policy(project_root, tmp_objects, head)
        # A project may have a server policy before its durable remote layout is
        # bootstrapped.  Only an actually absent path uses the continued-absence
        # verification fence; a seeded policy directory is an existing authority.
        run_server_verification(
            project_root,
            branch_name,
            head,
            ledger=decision_work,
            deadline=deadline,
            allow_missing_project=not project_root.exists(),
        )
        validate_remote_json_publication_identity(
            "remote_upload",
            actor,
            idempotency_key,
            [head],
            objects_root=tmp_objects,
        )
        missing_writes: list[tuple[dict[str, Any], Any, Any]] | None = None
        missing_write_preflight: RemoteJSONPublicationWritePreflight | None = None
        if not project_existed:
            missing_nonce_after = (
                request_nonce_cache_postimage(
                    project_root,
                    nonce_plan[0],
                    nonce_plan[1],
                    nonce_plan[2],
                    time.time(),
                )
                if nonce_plan is not None
                else None
            )
            missing_writes = [
                (
                    {"kind": "generation"},
                    None,
                    {"current_generation": 1},
                ),
                (
                    {"kind": "branch", "name": branch_name},
                    None,
                    {
                        "version": VERSION,
                        "name": branch_name,
                        "head": head,
                        "generation": 1,
                        "uploaded_from": local_branch,
                        "uploaded_by": actor,
                        "transport": "http",
                        "updated_at": now_iso(),
                    },
                ),
            ]
            if missing_nonce_after is not None:
                missing_writes.append(
                    (
                        {"kind": "request_nonce_cache"},
                        None,
                        missing_nonce_after,
                    )
                )
            missing_write_preflight = preflight_remote_json_publication_writes(
                project_root,
                missing_writes,
            )
            if response_slot is not None:
                response_slot.prepare(200, result)
        if not project_existed or response_slot is None:
            if response_slot is not None:
                response_slot.seal_for_effect()
                response_slot.mark_effect_started()
            ensure_remote_layout(project_root)
        with remote_project_gate(project_root):
            semantic = {
                "stable_project_id": remote_project_stable_id(project_root),
                "remote_branch": branch_name,
                "local_branch": local_branch,
                "head": head,
                "object_set_digest": merge_request_object_set_digest(records),
            }
            recovering = preflight_remote_publication_recovery(
                project_root,
                "remote_upload",
                actor,
                semantic,
                result,
                idempotency_key,
                [head],
            )
            current = read_remote_branch_record(project_root, branch_name)
            if (
                not recovering
                and current
                and not is_ancestor_from_objects(
                    tmp_objects, current["head"], head
                )
            ):
                if response_slot is not None and response_slot.is_prepared:
                    raise CFError(
                        "upload authority changed after response preflight"
                    )
                return http_error(
                    409,
                    "upload rejected: remote branch is not an ancestor of local branch head",
                )
            if response_slot is not None and not response_slot.is_prepared:
                response_slot.prepare(200, result)
            nonce_context = (
                stable_remote_lock(
                    dirs["locks"] / "request-nonce-cache.lock"
                )
                if nonce_plan is not None
                else contextlib.nullcontext()
            )
            with nonce_context:
                nonce_before = None
                nonce_after = None
                if nonce_plan is not None:
                    nonce_before = read_json(
                        remote_request_nonce_cache_path(project_root)
                    )
                    nonce_after = request_nonce_cache_postimage(
                        project_root,
                        nonce_plan[0],
                        nonce_plan[1],
                        nonce_plan[2],
                        time.time(),
                    )
                selected_write_preflight = None
                if recovering:
                    generation_current = read_json(
                        remote_generation_path(project_root)
                    )
                    branch_current = read_remote_branch_record(
                        project_root, branch_name
                    )
                    writes = [
                        (
                            {"kind": "generation"},
                            generation_current,
                            generation_current,
                        ),
                        (
                            {"kind": "branch", "name": branch_name},
                            branch_current,
                            branch_current,
                        ),
                    ]
                else:
                    generation_before = read_json(
                        remote_generation_path(project_root)
                    )
                    if (
                        missing_writes is not None
                        and missing_write_preflight is not None
                        and generation_before is None
                        and current is None
                        and nonce_before is None
                    ):
                        writes = missing_writes
                        selected_write_preflight = missing_write_preflight
                    else:
                        generation = (
                            generation_before.get("current_generation", 0)
                            if isinstance(generation_before, dict)
                            else 0
                        ) + 1
                        branch_after = {
                            "version": VERSION,
                            "name": branch_name,
                            "head": head,
                            "generation": generation,
                            "uploaded_from": local_branch,
                            "uploaded_by": actor,
                            "transport": "http",
                            "updated_at": now_iso(),
                        }
                        writes = [
                            (
                                {"kind": "generation"},
                                generation_before,
                                {"current_generation": generation},
                            ),
                            (
                                {"kind": "branch", "name": branch_name},
                                current,
                                branch_after,
                            ),
                        ]
                        if nonce_after is not None:
                            writes.append(
                                (
                                    {"kind": "request_nonce_cache"},
                                    nonce_before,
                                    nonce_after,
                                )
                            )
                publication_preflight = preflight_remote_json_publication(
                    project_root,
                    "remote_upload",
                    actor,
                    semantic,
                    writes,
                    result,
                    idempotency_key,
                    [head],
                    validation_objects_root=tmp_objects,
                    validate_preimages=not recovering,
                    write_preflight=selected_write_preflight,
                )
                publication_preflight.seal_for_effect(
                    project_root,
                    "remote_upload",
                    actor,
                    semantic,
                    writes,
                    result,
                    idempotency_key,
                    (head,),
                )
                if response_slot is not None and not response_slot.effect_started:
                    response_slot.seal_for_effect()
                    response_slot.mark_effect_started()
                # Recovery may be completing a publication whose object copy
                # was durable before its authorities became visible.
                write_object_records(dirs["objects"], records)
                published = execute_remote_json_publication(
                    project_root,
                    "remote_upload",
                    actor,
                    semantic,
                    writes,
                    result,
                    idempotency_key=idempotency_key,
                    object_roots=[head],
                    preflight=publication_preflight,
                )
                if recovering:
                    recovered = published
                    if recovered != result:
                        raise CFError(
                            "upload recovery result changed after response preflight"
                        )
                else:
                    if published != result:
                        raise CFError(
                            "upload publication result changed after response preflight"
                        )
        publication_succeeded = True
        if response_slot is not None:
            response_slot.select_success()
        return 200, result
    except BaseException:
        if (
            response_slot is not None
            and response_slot.is_prepared
            and response_slot.effect_started
        ):
            if publication_succeeded:
                response_slot.select_success()
                return 200, result
            response_slot.select_durable()
            return 503, HTTP_MUTATION_RETRY_PAYLOAD
        if response_slot is not None:
            response_slot.close()
        raise
    finally:
        cleanup_error: BaseException | None = None
        if sealed_validation_owner is not None:
            try:
                assert decision_work is not None
                sealed_validation_owner.close(decision_work)
            except BaseException as exc:
                cleanup_error = exc
                try:
                    sealed_validation_owner.close(decision_work)
                except BaseException:
                    pass
        for owner in (stage_owner, closure):
            close_owner = getattr(owner, "close", None)
            if close_owner is None:
                continue
            try:
                close_owner()
            except BaseException as exc:
                if cleanup_error is None:
                    cleanup_error = exc
                try:
                    close_owner()
                except BaseException:
                    pass
        if tmp_root is not None:
            shutil.rmtree(tmp_root, ignore_errors=True)
        if cleanup_error is not None:
            raise cleanup_error


_HTTP_ADMISSION_REJECT_BODY = (
    b'{"error":"CodeFire HTTP server connection limit reached",'
    b'"kind":"http_connection_admission_rejected","retryable":true}'
)
_HTTP_ADMISSION_REJECT_RESPONSE = (
    b"HTTP/1.1 503 Service Unavailable\r\n"
    b"Content-Type: application/json\r\n"
    + f"Content-Length: {len(_HTTP_ADMISSION_REJECT_BODY)}\r\n".encode("ascii")
    + b"Connection: close\r\n\r\n"
    + _HTTP_ADMISSION_REJECT_BODY
)


class _HTTPConnectionPermit:
    """Idempotent ownership of one process-global admitted connection."""

    def __init__(self, admission: Any, token: object) -> None:
        self._admission = admission
        self._token = token

    def close(self) -> None:
        admission = self._admission
        if admission is not None:
            admission.release(self._token)
            self._admission = None

    def replace_request(self, request: Any) -> None:
        admission = self._admission
        if admission is None:
            raise CFError("HTTP connection permit is already closed")
        if admission.replace_request(self._token, request):
            try:
                request.shutdown(socket.SHUT_RDWR)
            except BaseException:
                pass

    def __del__(self) -> None:
        admission = self._admission
        if admission is None:
            return
        try:
            self.close()
        except BaseException:
            try:
                admission.release_dropped(self._token)
            except BaseException:
                pass


class _HTTPServerRegistration:
    """Transactional ownership of one process-global live-server entry."""

    def __init__(self, admission: Any, server_token: object) -> None:
        self._admission = admission
        self._server_token = server_token

    def publish(self, limit: int) -> None:
        admission = self._admission
        if admission is None:
            raise CFError("HTTP server registration owner is already closed")
        try:
            admission.register_server(self._server_token, limit)
        except BaseException:
            self.close_noexcept()
            raise

    def close(self) -> None:
        admission = self._admission
        if admission is not None:
            admission.unregister_server(self._server_token)
            self._admission = None

    def close_noexcept(self) -> None:
        admission = self._admission
        if admission is None:
            return
        try:
            self.close()
        except BaseException:
            if admission.unregister_server_dropped(self._server_token):
                self._admission = None

    def __del__(self) -> None:
        self.close_noexcept()


class _ProcessHTTPConnectionAdmission:
    """One zero-queue active-connection gate shared by all Python servers."""

    def __init__(self) -> None:
        self._lock = threading.Lock()
        self._active: dict[object, tuple[object, Any]] = {}
        self._active_by_server: dict[object, set[object]] = {}
        self._server_limits: dict[object, int] = {}
        self._effective_limit: int | None = None
        self._closing_servers: set[object] = set()

    def register_server(self, server_token: object, limit: int) -> None:
        with self._lock:
            if server_token in self._server_limits:
                raise CFError("HTTP connection admission server is already registered")
            self._server_limits[server_token] = limit
            if self._effective_limit is None or limit < self._effective_limit:
                self._effective_limit = limit

    def _unregister_server_locked(self, server_token: object) -> None:
        self._server_limits.pop(server_token, None)
        self._effective_limit = min(self._server_limits.values(), default=None)
        if not self._active_by_server.get(server_token):
            self._closing_servers.discard(server_token)

    def unregister_server(self, server_token: object) -> None:
        with self._lock:
            self._unregister_server_locked(server_token)

    def unregister_server_dropped(self, server_token: object) -> bool:
        """Destructor fallback that bypasses an injected public unregister fault."""
        try:
            _ProcessHTTPConnectionAdmission.unregister_server(self, server_token)
            return True
        except BaseException:
            return False

    def try_acquire(
        self, server_token: object, request: Any
    ) -> _HTTPConnectionPermit | None:
        token = object()
        permit = _HTTPConnectionPermit(self, token)
        with self._lock:
            limit = self._effective_limit
            if (
                server_token not in self._server_limits
                or server_token in self._closing_servers
                or limit is None
                or len(self._active) >= limit
            ):
                return None
            self._active[token] = (server_token, request)
            self._active_by_server.setdefault(server_token, set()).add(token)
        return permit

    def release(self, token: object) -> None:
        with self._lock:
            active = self._active.get(token)
            if active is None:
                return
            server_token, _request = active
            server_active = self._active_by_server.get(server_token)
            if server_active is not None:
                server_active.discard(token)
            if not server_active:
                self._active_by_server.pop(server_token, None)
                self._closing_servers.discard(server_token)
            self._active.pop(token, None)

    def release_dropped(self, token: object) -> None:
        """Destructor fallback that bypasses an injected public release fault."""
        try:
            _ProcessHTTPConnectionAdmission.release(self, token)
        except BaseException:
            pass

    def replace_request(self, token: object, request: Any) -> bool:
        with self._lock:
            try:
                server_token, _old_request = self._active[token]
            except KeyError as error:
                raise CFError("HTTP connection admission permit is not active") from error
            self._active[token] = (server_token, request)
            return server_token in self._closing_servers

    def count(self, server_token: object | None = None) -> int:
        with self._lock:
            if server_token is None:
                return len(self._active)
            return len(self._active_by_server.get(server_token, ()))

    def effective_limit(self) -> int | None:
        with self._lock:
            return self._effective_limit

    def close_server_connections(
        self, server_token: object, *, unregister: bool = False
    ) -> None:
        with self._lock:
            if unregister:
                self._unregister_server_locked(server_token)
            if not self._active_by_server.get(server_token):
                self._closing_servers.discard(server_token)
            else:
                self._closing_servers.add(server_token)
            requests = [
                request
                for owner, request in self._active.values()
                if owner is server_token
            ]
        for request in requests:
            try:
                request.shutdown(socket.SHUT_RDWR)
            except BaseException:
                pass

    def finish_server_close(self, server_token: object) -> None:
        with self._lock:
            self._unregister_server_locked(server_token)
            if not self._active_by_server.get(server_token):
                self._closing_servers.discard(server_token)


_PROCESS_HTTP_CONNECTION_ADMISSION = _ProcessHTTPConnectionAdmission()


class ReusableThreadingHTTPServer(http.server.ThreadingHTTPServer):
    allow_reuse_address = True
    daemon_threads = False

    def __init__(
        self,
        server_address: Any,
        request_handler_class: Any,
        bind_and_activate: bool = True,
        *,
        decision_work_profile: DecisionWorkProfile | None = None,
        tls_context: ssl.SSLContext | None = None,
    ) -> None:
        profile = decision_work_profile or getattr(
            request_handler_class, "decision_work_profile", None
        )
        if profile is None:
            profile = DecisionWorkProfile.http_v1()
        if profile.max_active_connections is None:
            raise CFError("HTTP server profile requires an active connection limit")
        if profile.max_queued_connections != 0:
            raise CFError("Python HTTP server supports exactly zero queued connections")
        self.decision_work_profile = profile
        self.tls_context = tls_context
        self._connection_server_token = object()
        registration = _HTTPServerRegistration(
            _PROCESS_HTTP_CONNECTION_ADMISSION,
            self._connection_server_token,
        )
        self._connection_registration = registration
        self._connection_permits_lock = threading.Lock()
        self._connection_permits: dict[int, _HTTPConnectionPermit] = {}
        self._rejected_connections = 0
        try:
            super().__init__(
                server_address, request_handler_class, bind_and_activate
            )
            registration.publish(profile.max_active_connections)
        except BaseException:
            registration.close_noexcept()
            try:
                super().server_close()
            except BaseException:
                pass
            raise

    def active_connection_count(self) -> int:
        return _PROCESS_HTTP_CONNECTION_ADMISSION.count(
            self._connection_server_token
        )

    def process_active_connection_count(self) -> int:
        return _PROCESS_HTTP_CONNECTION_ADMISSION.count()

    def rejected_connection_count(self) -> int:
        with self._connection_permits_lock:
            return self._rejected_connections

    def _take_connection_permit(
        self, request: Any
    ) -> _HTTPConnectionPermit | None:
        with self._connection_permits_lock:
            return self._connection_permits.pop(id(request), None)

    def shutdown_request(self, request: Any) -> None:
        """Close one dispatch-owned socket without leaking BaseException."""
        try:
            super().shutdown_request(request)
        except BaseException:
            try:
                super().close_request(request)
            except BaseException:
                pass

    def _shutdown_request_noexcept(
        self, request: Any, client_address: Any | None = None
    ) -> None:
        try:
            self.shutdown_request(request)
            return
        except BaseException:
            try:
                self.close_request(request)
            except BaseException:
                pass
            if client_address is not None:
                try:
                    self.handle_error(request, client_address)
                except BaseException:
                    pass

    def _write_rejection(self, request: Any) -> None:
        try:
            with self._connection_permits_lock:
                self._rejected_connections += 1
            if self.tls_context is None:
                request.settimeout(1.0)
                request.sendall(_HTTP_ADMISSION_REJECT_RESPONSE)
        except BaseException:
            pass

    def verify_request(self, request: Any, client_address: Any) -> bool:
        del client_address
        permit = _PROCESS_HTTP_CONNECTION_ADMISSION.try_acquire(
            self._connection_server_token,
            request,
        )
        if permit is None:
            self._write_rejection(request)
            return False
        try:
            with self._connection_permits_lock:
                self._connection_permits[id(request)] = permit
        except BaseException:
            permit.close()
            raise
        return True

    def process_request(self, request: Any, client_address: Any) -> None:
        with self._connection_permits_lock:
            admitted = id(request) in self._connection_permits
        if not admitted:
            permit = _PROCESS_HTTP_CONNECTION_ADMISSION.try_acquire(
                self._connection_server_token,
                request,
            )
            if permit is None:
                self._write_rejection(request)
                self._shutdown_request_noexcept(request, client_address)
                return
            try:
                with self._connection_permits_lock:
                    self._connection_permits[id(request)] = permit
            except BaseException:
                permit.close()
                self._shutdown_request_noexcept(request, client_address)
                raise
        try:
            super().process_request(request, client_address)
        except BaseException:
            owned = self._take_connection_permit(request)
            if owned is not None:
                owned.close()
            try:
                reap = getattr(self._threads, "reap", None)
                if reap is not None:
                    reap()
            except BaseException:
                pass
            self._shutdown_request_noexcept(request, client_address)
            raise

    def process_request_thread(self, request: Any, client_address: Any) -> None:
        permit = self._take_connection_permit(request)
        if permit is None:
            self._shutdown_request_noexcept(request, client_address)
            return
        handled_request = request
        try:
            try:
                if self.tls_context is not None:
                    handled_request = self.tls_context.wrap_socket(
                        request,
                        server_side=True,
                        do_handshake_on_connect=False,
                    )
                    permit.replace_request(handled_request)
                    handled_request.do_handshake()
                self.finish_request(handled_request, client_address)
            except BaseException:
                try:
                    self.handle_error(handled_request, client_address)
                except BaseException:
                    pass
        finally:
            try:
                self._shutdown_request_noexcept(
                    handled_request, client_address
                )
            finally:
                permit.close()

    def shutdown(self) -> None:
        super().shutdown()
        _PROCESS_HTTP_CONNECTION_ADMISSION.close_server_connections(
            self._connection_server_token
        )

    def server_close(self) -> None:
        self._connection_registration.close_noexcept()
        _PROCESS_HTTP_CONNECTION_ADMISSION.close_server_connections(
            self._connection_server_token
        )
        try:
            super().server_close()
        finally:
            _PROCESS_HTTP_CONNECTION_ADMISSION.finish_server_close(
                self._connection_server_token
            )


class _BoundedHTTPHeaderReader:
    """Count request-head bytes without allocating an unreserved lookahead byte."""

    def __init__(
        self,
        source: Any,
        limit: int,
        budget_error: Any,
    ) -> None:
        self.source = source
        self.limit = limit
        self.budget_error = budget_error
        self.bytes_read = 0

    def readline(self, size: int = -1) -> bytes:
        remaining = max(0, self.limit - self.bytes_read)
        if remaining == 0:
            raise self.budget_error(self.limit + 1)
        bounded = remaining
        if size >= 0:
            bounded = min(size, bounded)
        data = self.source.readline(bounded)
        self.bytes_read += len(data)
        if (
            bounded == remaining
            and len(data) == bounded
            and data
            and not data.endswith(b"\n")
        ):
            raise self.budget_error(self.limit + 1)
        return data

    def __getattr__(self, name: str) -> Any:
        return getattr(self.source, name)


class _BoundedCanonicalJSONFreezer:
    """Iteratively freeze compact JSON while bounding every owned work buffer."""

    STACK_BASE = 64
    TOKEN_BYTES = 128
    SORT_BASE = 64
    SORT_ENTRY_BYTES = 16
    FRAGMENT_BASE = 64
    FRAGMENT_SLOT_BYTES = 16
    CHUNK_BASE = 64
    CHUNK_BYTES = 256

    def __init__(
        self,
        ledger: DecisionWorkLedger,
        profile: DecisionWorkProfile,
        budget_error: Any,
        limit: int,
        poll: Any | None = None,
    ) -> None:
        self.ledger = ledger
        self.profile = profile
        self.budget_error = budget_error
        self.limit = limit
        self.poll = poll
        self.stack: list[tuple[str, Any]] | None = None
        self.fragments: list[bytes] | None = None
        self.chunk: bytearray | None = None
        self.stack_bytes = 0
        self.fragment_bytes = 0
        self.fragment_slots = 0
        self.fragment_base = 0
        self.chunk_bytes = 0
        self.chunk_owner = 0
        self.size = 0
        self.overflow = False

    def _poll(self) -> None:
        if self.poll is not None:
            self.poll()

    def _acquire(self, dimension: str, amount: int) -> None:
        if amount == 0:
            return
        observed = self.ledger.current.get(dimension, 0) + amount
        if observed > self.profile.limit(dimension):
            raise self.budget_error(dimension, observed, "response_body")
        permit = self.ledger.reserve(
            "response_body", acquires={dimension: amount}
        )
        try:
            self.ledger.consume_reserved(
                permit,
                phase="response_body",
                acquires={dimension: amount},
            )
        finally:
            if self.ledger.permit_is_open(permit):
                self.ledger.cancel_permit(permit)

    def _release(self, dimension: str, amount: int) -> None:
        if amount:
            self.ledger.release(dimension, amount)

    def _new_fragment_list(self) -> list[bytes]:
        return []

    def _push(self, kind: str, value: Any) -> None:
        self._acquire("temporary_bytes", self.TOKEN_BYTES)
        self.stack_bytes += self.TOKEN_BYTES
        assert self.stack is not None
        self.stack.append((kind, value))

    def _emit_byte(self, value: int) -> None:
        if self.overflow:
            return
        assert self.chunk is not None
        self.chunk.append(value)
        self.size += 1
        if self.size > self.limit:
            self.size = self.limit + 1
            self.overflow = True
        if len(self.chunk) == self.chunk_bytes:
            self._flush_chunk()

    def _emit_ascii(self, value: bytes) -> None:
        for index, byte in enumerate(value):
            if index % self.CHUNK_BYTES == 0:
                self._poll()
            self._emit_byte(byte)
            if self.overflow:
                return

    def _emit_codepoint(self, codepoint: int) -> None:
        if codepoint <= 0x7F:
            self._emit_byte(codepoint)
        elif codepoint <= 0x7FF:
            self._emit_byte(0xC0 | (codepoint >> 6))
            self._emit_byte(0x80 | (codepoint & 0x3F))
        elif 0xD800 <= codepoint <= 0xDFFF:
            raise CFError("HTTP JSON response contains an unpaired surrogate")
        elif codepoint <= 0xFFFF:
            self._emit_byte(0xE0 | (codepoint >> 12))
            self._emit_byte(0x80 | ((codepoint >> 6) & 0x3F))
            self._emit_byte(0x80 | (codepoint & 0x3F))
        else:
            self._emit_byte(0xF0 | (codepoint >> 18))
            self._emit_byte(0x80 | ((codepoint >> 12) & 0x3F))
            self._emit_byte(0x80 | ((codepoint >> 6) & 0x3F))
            self._emit_byte(0x80 | (codepoint & 0x3F))

    def _emit_string(self, value: str) -> None:
        self._emit_byte(ord('"'))
        for index, character in enumerate(value):
            if index % self.CHUNK_BYTES == 0:
                self._poll()
            if self.overflow:
                return
            codepoint = ord(character)
            if character == '"':
                self._emit_ascii(b'\\"')
            elif character == "\\":
                self._emit_ascii(b"\\\\")
            elif character == "\b":
                self._emit_ascii(b"\\b")
            elif character == "\f":
                self._emit_ascii(b"\\f")
            elif character == "\n":
                self._emit_ascii(b"\\n")
            elif character == "\r":
                self._emit_ascii(b"\\r")
            elif character == "\t":
                self._emit_ascii(b"\\t")
            elif codepoint < 0x20:
                self._emit_ascii(b"\\u00")
                digits = b"0123456789abcdef"
                self._emit_byte(digits[(codepoint >> 4) & 0xF])
                self._emit_byte(digits[codepoint & 0xF])
            else:
                self._emit_codepoint(codepoint)
        self._emit_byte(ord('"'))

    def _emit_scalar_bytes(self, value: Any) -> None:
        if value is None:
            self._emit_ascii(b"null")
            return
        if value is True:
            self._emit_ascii(b"true")
            return
        if value is False:
            self._emit_ascii(b"false")
            return
        if type(value) is str:
            self._emit_string(value)
            return
        if type(value) is int:
            bits = int.bit_length(value)
            upper = max(1, (bits * 30103) // 100000 + 3)
            remaining = self.limit + 1 - self.size
            if upper > remaining + 2:
                self.size = self.limit + 1
                self.overflow = True
                return
            scratch = (upper * 2) + 64
            self._acquire("temporary_bytes", scratch)
            encoded: bytes | None = None
            text_value: str | None = None
            try:
                text_value = int.__str__(value)
                encoded = text_value.encode("ascii")
                self._emit_ascii(encoded)
            finally:
                encoded = None
                text_value = None
                self._release("temporary_bytes", scratch)
            return
        if isinstance(value, int):
            raise CFError("HTTP JSON response rejects integer subclasses")
        if type(value) is float:
            scratch = 128
            self._acquire("temporary_bytes", scratch)
            encoded = None
            text_value = None
            try:
                text_value = json.dumps(value, separators=(",", ":"))
                encoded = text_value.encode("ascii")
                self._emit_ascii(encoded)
            finally:
                encoded = None
                text_value = None
                self._release("temporary_bytes", scratch)
            return
        raise CFError(
            f"HTTP JSON response contains unsupported {type(value).__name__}"
        )

    def _expand(self, value: Any) -> None:
        self._poll()
        if type(value) in {dict, AccountedDoctorPayload, AccountedHTTPBundle}:
            count = dict.__len__(value)
            sort_bytes = self.SORT_BASE + (self.SORT_ENTRY_BYTES * count)
            self._acquire("temporary_bytes", sort_bytes)
            keys: list[str] | None = None
            try:
                try:
                    keys = sorted(dict.keys(value))
                except TypeError as error:
                    raise CFError("HTTP JSON response keys must be strings") from error
                if any(type(key) is not str for key in keys):
                    raise CFError("HTTP JSON response keys must be strings")
                self._poll()
                self._push("raw", b"}")
                for index in range(count - 1, -1, -1):
                    self._poll()
                    key = keys[index]
                    self._push("value", dict.__getitem__(value, key))
                    self._push("raw", b":")
                    self._push("string", key)
                    if index:
                        self._push("raw", b",")
                self._push("raw", b"{")
            finally:
                keys = None
                self._release("temporary_bytes", sort_bytes)
            return
        if type(value) is list or type(value) is tuple:
            self._push("raw", b"]")
            for index in range(len(value) - 1, -1, -1):
                self._poll()
                self._push("value", value[index])
                if index:
                    self._push("raw", b",")
            self._push("raw", b"[")
            return
        self._emit_scalar_bytes(value)

    def _flush_chunk(self) -> None:
        assert self.chunk is not None
        if not self.chunk:
            return
        amount = len(self.chunk)
        ownership = amount + self.FRAGMENT_SLOT_BYTES
        self._acquire("retained_bytes", ownership)
        try:
            frozen = bytes(self.chunk)
            assert self.fragments is not None
            self.fragments.append(frozen)
        except BaseException:
            frozen = None
            try:
                self._release("retained_bytes", ownership)
            except BaseException:
                pass
            raise
        self.fragment_bytes += amount
        self.fragment_slots += self.FRAGMENT_SLOT_BYTES
        self.chunk.clear()

    def _cleanup(self) -> None:
        self.stack = None
        self.fragments = None
        self.chunk = None
        self._release("temporary_bytes", self.stack_bytes)
        self._release("temporary_bytes", self.chunk_owner)
        self._release(
            "retained_bytes",
            self.fragment_base + self.fragment_slots + self.fragment_bytes,
        )
        self.stack_bytes = 0
        self.chunk_bytes = 0
        self.chunk_owner = 0
        self.fragment_base = 0
        self.fragment_slots = 0
        self.fragment_bytes = 0

    def freeze(self, payload: Any) -> tuple[bytes, int]:
        try:
            self._poll()
            self._acquire("temporary_bytes", self.STACK_BASE)
            self.stack_bytes = self.STACK_BASE
            self.stack = []
            self._acquire("retained_bytes", self.FRAGMENT_BASE)
            self.fragment_base = self.FRAGMENT_BASE
            self.fragments = self._new_fragment_list()
            chunk_capacity = min(self.CHUNK_BYTES, self.limit + 1)
            chunk_capacity = max(1, chunk_capacity)
            self._acquire(
                "temporary_bytes", self.CHUNK_BASE + chunk_capacity
            )
            self.chunk_bytes = chunk_capacity
            self.chunk_owner = self.CHUNK_BASE + chunk_capacity
            self.chunk = bytearray()
            self._push("value", payload)
            while self.stack and not self.overflow:
                self._poll()
                kind, value = self.stack.pop()
                try:
                    if kind == "raw":
                        self._emit_ascii(value)
                    elif kind == "string":
                        self._emit_string(value)
                    else:
                        self._expand(value)
                finally:
                    kind = None
                    value = None
                    self.stack_bytes -= self.TOKEN_BYTES
                    self._release("temporary_bytes", self.TOKEN_BYTES)
            if self.overflow:
                raise self.budget_error(
                    "response_bytes", self.limit + 1, "response_body"
                )
            self._flush_chunk()
            self.stack = None
            self._release("temporary_bytes", self.stack_bytes)
            self.stack_bytes = 0
            self.chunk = None
            self._release(
                "temporary_bytes", self.chunk_owner
            )
            self.chunk_bytes = 0
            self.chunk_owner = 0
            final_size = self.size
            self._acquire("retained_bytes", final_size)
            try:
                assert self.fragments is not None
                self._poll()
                body = b"".join(self.fragments)
                self._poll()
            except BaseException:
                body = None
                try:
                    self._release("retained_bytes", final_size)
                except BaseException:
                    pass
                raise
            self.fragments = None
            intermediate = (
                self.fragment_base + self.fragment_slots + self.fragment_bytes
            )
            self._release("retained_bytes", intermediate)
            self.fragment_base = 0
            self.fragment_slots = 0
            self.fragment_bytes = 0
            return body, final_size
        except BaseException:
            try:
                self._cleanup()
            except BaseException:
                pass
            raise


class _PreparedHTTPResponseOwner:
    """Own frozen response bytes until publication or explicit cancellation.

    Close drops payload references before ledger release. If release fails, the
    byte counts remain owned so a later close can retry accounting cleanup
    without reviving or releasing the payload twice.
    """

    def __init__(
        self,
        ledger: DecisionWorkLedger,
        header: bytes,
        header_retained: int,
        body: bytes,
        body_retained: int,
    ) -> None:
        self.ledger = ledger
        self.header: bytes | None = header
        self.body: bytes | None = body
        self.header_retained = header_retained
        self.body_retained = body_retained

    @property
    def retained_bytes(self) -> int:
        return self.header_retained + self.body_retained

    def close(self) -> None:
        retained = self.retained_bytes
        self.header = None
        self.body = None
        if retained:
            self.ledger.release("retained_bytes", retained)
        self.header_retained = 0
        self.body_retained = 0

    def publish(self, destination: Any) -> None:
        if self.header is None or self.body is None:
            raise CFError("prepared HTTP response owner is already closed")
        try:
            destination.write(self.header)
            destination.write(self.body)
        finally:
            self.close()

    def __del__(self) -> None:
        try:
            self.close()
        except BaseException:
            pass


class _PreparedHTTPMutationResponses:
    """Own success and fixed durable-retry responses until one is selected.

    Selection retains both pointers until the rejected owner's drop-before-
    release cleanup succeeds. A release fault therefore leaves an exact retry
    state instead of losing either the selected payload or accounting owner.
    """

    def __init__(
        self,
        ledger: DecisionWorkLedger,
        success: _PreparedHTTPResponseOwner,
        durable: _PreparedHTTPResponseOwner,
        response_permit: DecisionWorkPermit,
        header_permit: DecisionWorkPermit,
        success_body_bytes: int,
        durable_body_bytes: int,
        success_header_bytes: int,
        durable_header_bytes: int,
    ) -> None:
        self.ledger = ledger
        self.success: _PreparedHTTPResponseOwner | None = success
        self.durable: _PreparedHTTPResponseOwner | None = durable
        self.response_permit: DecisionWorkPermit | None = response_permit
        self.header_permit: DecisionWorkPermit | None = header_permit
        self.success_body_bytes = success_body_bytes
        self.durable_body_bytes = durable_body_bytes
        self.success_header_bytes = success_header_bytes
        self.durable_header_bytes = durable_header_bytes
        self.selection: str | None = None

    def _select(
        self, ledger: DecisionWorkLedger, durable: bool
    ) -> _PreparedHTTPResponseOwner:
        if ledger is not self.ledger:
            raise CFError(
                "prepared HTTP mutation responses belong to a different decision-work ledger"
            )
        selected = self.durable if durable else self.success
        rejected = self.success if durable else self.durable
        if selected is None or rejected is None:
            raise CFError("prepared HTTP mutation responses are already closed")
        if self.response_permit is not None or self.header_permit is not None:
            raise CFError(
                "prepared HTTP mutation response work is not sealed for effect"
            )
        requested_selection = "durable" if durable else "success"
        if self.selection is not None and self.selection != requested_selection:
            raise CFError(
                "prepared HTTP mutation response selection cannot be changed"
            )
        self.selection = requested_selection
        rejected.close()
        self.success = None
        self.durable = None
        return selected

    def seal_for_effect(self, ledger: DecisionWorkLedger) -> None:
        if ledger is not self.ledger:
            raise CFError(
                "prepared HTTP mutation responses belong to a different decision-work ledger"
            )
        response_permit = self.response_permit
        header_permit = self.header_permit
        if response_permit is None or header_permit is None:
            raise CFError("prepared HTTP mutation response work is already sealed")
        self.ledger.consume_reserved(
            response_permit,
            phase="response_body",
            charges={
                "response_bytes": max(
                    self.success_body_bytes, self.durable_body_bytes
                )
            },
        )
        if self.ledger.permit_is_open(response_permit):
            self.ledger.cancel_permit(response_permit)
        self.response_permit = None
        self.ledger.consume_reserved(
            header_permit,
            phase="response_headers",
            charges={
                "response_header_bytes": max(
                    self.success_header_bytes, self.durable_header_bytes
                )
            },
        )
        if self.ledger.permit_is_open(header_permit):
            self.ledger.cancel_permit(header_permit)
        self.header_permit = None

    def select_success(
        self, ledger: DecisionWorkLedger
    ) -> _PreparedHTTPResponseOwner:
        return self._select(ledger, False)

    def select_durable(
        self, ledger: DecisionWorkLedger
    ) -> _PreparedHTTPResponseOwner:
        return self._select(ledger, True)

    def close(self) -> None:
        first_error: BaseException | None = None
        success = self.success
        durable = self.durable
        response_permit = self.response_permit
        header_permit = self.header_permit
        if success is not None:
            try:
                success.close()
                self.success = None
            except BaseException as error:
                first_error = error
        if durable is not None:
            try:
                durable.close()
                self.durable = None
            except BaseException as error:
                if first_error is None:
                    first_error = error
        if (
            response_permit is not None
            and self.ledger.permit_is_open(response_permit)
        ):
            try:
                self.ledger.cancel_permit(response_permit)
                self.response_permit = None
            except BaseException as error:
                if first_error is None:
                    first_error = error
        else:
            self.response_permit = None
        if (
            header_permit is not None
            and self.ledger.permit_is_open(header_permit)
        ):
            try:
                self.ledger.cancel_permit(header_permit)
                self.header_permit = None
            except BaseException as error:
                if first_error is None:
                    first_error = error
        else:
            self.header_permit = None
        if first_error is not None:
            raise first_error

    def __del__(self) -> None:
        try:
            self.close()
        except BaseException:
            pass


HTTP_MUTATION_RETRY_PAYLOAD = {
    "error": (
        "the durable mutation completed without a confirmed response; "
        "retry the same request"
    ),
    "kind": "retry_same_request",
    "retry_same_request": True,
}


class _HTTPMutationResponseSlot:
    """Transfer one prepared mutation response from a route to the handler."""

    def __init__(self, handler: Any) -> None:
        self.handler = handler
        self.responses: _PreparedHTTPMutationResponses | None = None
        self.selected: _PreparedHTTPResponseOwner | None = None
        self.effect_started = False

    @property
    def is_prepared(self) -> bool:
        return self.responses is not None

    def prepare(self, status: int, payload: Any) -> None:
        if self.responses is not None or self.selected is not None:
            raise CFError("upload mutation response is already prepared")
        self.responses = self.handler.prepare_mutation_json(status, payload)

    def select_success(self) -> None:
        if self.responses is None:
            raise CFError("upload success response was not prepared")
        responses = self.responses
        selected = responses.select_success(self.handler.decision_work)
        self.responses = None
        self.selected = selected

    def select_durable(self) -> None:
        if self.responses is None:
            raise CFError("upload durable response was not prepared")
        responses = self.responses
        selected = responses.select_durable(self.handler.decision_work)
        self.responses = None
        self.selected = selected

    def seal_for_effect(self) -> None:
        if self.responses is None or self.selected is not None:
            raise CFError("upload mutation response is not available to seal")
        self.responses.seal_for_effect(self.handler.decision_work)

    def mark_effect_started(self) -> None:
        if self.responses is None or self.selected is not None:
            raise CFError("upload response must be prepared before its effect")
        if (
            self.responses.response_permit is not None
            or self.responses.header_permit is not None
        ):
            raise CFError("upload response work must be sealed before its effect")
        self.effect_started = True

    def take(self) -> _PreparedHTTPResponseOwner | None:
        selected = self.selected
        self.selected = None
        return selected

    def close(self) -> None:
        responses = self.responses
        selected = self.selected
        if responses is not None:
            responses.close()
            self.responses = None
        if selected is not None:
            selected.close()
            self.selected = None
        self.effect_started = False

    def __del__(self) -> None:
        try:
            self.close()
        except BaseException:
            pass


def http_resource_budget_error(
    error: ResourceBudgetExceeded,
) -> tuple[int, dict[str, Any]]:
    diagnostic = error.diagnostic()
    return (
        413,
        {
            "error": str(error),
            "exit_code": RESOURCE_BUDGET_EXIT_CODE,
            "kind": diagnostic["kind"],
            "diagnostics": [diagnostic],
        },
    )


def http_request_deadline_error(
    error: RequestDeadlineExceeded,
) -> tuple[int, dict[str, Any]]:
    diagnostic = error.diagnostic()
    return (
        503,
        {
            "error": str(error),
            "exit_code": RESOURCE_BUDGET_EXIT_CODE,
            "kind": diagnostic["kind"],
            "diagnostics": [diagnostic],
        },
    )


def make_http_handler(
    storage_root: Path,
    decision_work_profile: DecisionWorkProfile | None = None,
    *,
    _decision_work_observer: Any | None = None,
    _monotonic_clock: Any = time.monotonic,
):
    profile = decision_work_profile or DecisionWorkProfile.http_v1()

    class CodeFireHTTPHandler(http.server.BaseHTTPRequestHandler):
        server_version = "CodeFireHTTP/0.2"
        decision_work_profile = profile

        def log_message(self, format: str, *args: Any) -> None:
            return

        def budget_error(
            self, dimension: str, observed: int, phase: str
        ) -> ResourceBudgetExceeded:
            return ResourceBudgetExceeded(
                profile=profile.profile_id,
                dimension=dimension,
                observed=min(U64_MAX, observed),
                limit=profile.limit(dimension),
                phase=phase,
                command="http request",
                continuation_supported=False,
            )

        def cancel_if_open(self, permit: DecisionWorkPermit | None) -> None:
            if permit is not None and self.decision_work.permit_is_open(permit):
                self.decision_work.cancel_permit(permit)

        def finish_permit(
            self,
            permit: DecisionWorkPermit,
            *,
            phase: str,
            charges: dict[str, int] | None = None,
            acquires: dict[str, int] | None = None,
        ) -> None:
            self.decision_work.consume_reserved(
                permit,
                phase=phase,
                charges=charges,
                acquires=acquires,
            )
            self.cancel_if_open(permit)

        def concurrent_observed(self, dimension: str, amount: int) -> int:
            return self.decision_work.current.get(dimension, 0) + amount

        def ensure_concurrent_capacity(
            self, dimension: str, amount: int, phase: str
        ) -> None:
            observed = self.concurrent_observed(dimension, amount)
            if observed > profile.limit(dimension):
                raise self.budget_error(dimension, observed, phase)

        def release_request_header_storage(self) -> None:
            retained = self._request_header_retained
            if retained:
                self.raw_requestline = b""
                self.requestline = ""
                self.command = None
                self.path = ""
                self.request_version = ""
                self.headers = None
                self.decision_work.release("retained_bytes", retained)
                self._request_header_retained = 0

        @staticmethod
        def json_codepoint_bytes(codepoint: int) -> int:
            if codepoint in {8, 9, 10, 12, 13}:
                return 2
            if codepoint < 0x20:
                return 6
            if codepoint in {ord('"'), ord("\\")}:
                return 2
            if codepoint <= 0x7F:
                return 1
            if codepoint <= 0x7FF:
                return 2
            if 0xD800 <= codepoint <= 0xDFFF:
                raise CFError("HTTP JSON request contains an unpaired surrogate")
            if codepoint <= 0xFFFF:
                return 3
            return 4

        @classmethod
        def request_canonical_upper(cls, source: str) -> int:
            """Bound compact JSON bytes directly from the still-owned source text."""
            size = 0
            index = 0
            length = len(source)

            while index < length:
                character = source[index]
                if character in " \t\r\n":
                    index += 1
                    continue
                if character != '"':
                    if character == "-" or character.isdigit():
                        end = index + 1
                        while end < length and source[end] not in " \t\r\n,]}":
                            end += 1
                        token_size = end - index
                        token_has_float_marker = False
                        cursor = index
                        while cursor < end:
                            if source[cursor] in ".eE":
                                token_has_float_marker = True
                                break
                            cursor += 1
                        if token_has_float_marker:
                            size += max(token_size + 3, 24)
                        elif (
                            token_size == 2
                            and source[index] == "-"
                            and source[index + 1] == "0"
                        ):
                            size += 1
                        else:
                            size += token_size
                        index = end
                        continue
                    size += 1
                    index += 1
                    continue

                size += 2
                index += 1
                while index < length:
                    character = source[index]
                    if character == '"':
                        index += 1
                        break
                    if character != "\\":
                        size += cls.json_codepoint_bytes(ord(character))
                        index += 1
                        continue
                    index += 1
                    if index >= length:
                        break
                    escape = source[index]
                    if escape != "u":
                        if escape == '"':
                            decoded = ord('"')
                        elif escape == "\\":
                            decoded = ord("\\")
                        elif escape == "/":
                            decoded = ord("/")
                        elif escape == "b":
                            decoded = 8
                        elif escape == "f":
                            decoded = 12
                        elif escape == "n":
                            decoded = 10
                        elif escape == "r":
                            decoded = 13
                        elif escape == "t":
                            decoded = 9
                        else:
                            decoded = None
                        if decoded is None:
                            size += 6
                        else:
                            size += cls.json_codepoint_bytes(decoded)
                        index += 1
                        continue
                    if index + 4 >= length:
                        size += 6
                        index += 1
                        continue
                    codepoint = 0
                    valid = True
                    for offset in range(1, 5):
                        digit = source[index + offset]
                        if "0" <= digit <= "9":
                            value = ord(digit) - ord("0")
                        elif "a" <= digit <= "f":
                            value = ord(digit) - ord("a") + 10
                        elif "A" <= digit <= "F":
                            value = ord(digit) - ord("A") + 10
                        else:
                            valid = False
                            value = 0
                        codepoint = (codepoint << 4) | value
                    index += 5
                    if not valid:
                        size += 6
                        continue
                    if 0xD800 <= codepoint <= 0xDBFF and (
                        index + 5 < length
                        and source[index] == "\\"
                        and source[index + 1] == "u"
                    ):
                        low = 0
                        low_valid = True
                        for offset in range(2, 6):
                            digit = source[index + offset]
                            if "0" <= digit <= "9":
                                value = ord(digit) - ord("0")
                            elif "a" <= digit <= "f":
                                value = ord(digit) - ord("a") + 10
                            elif "A" <= digit <= "F":
                                value = ord(digit) - ord("A") + 10
                            else:
                                low_valid = False
                                value = 0
                            low = (low << 4) | value
                        if low_valid and 0xDC00 <= low <= 0xDFFF:
                            codepoint = (
                                0x10000
                                + ((codepoint - 0xD800) << 10)
                                + (low - 0xDC00)
                            )
                            index += 6
                    size += cls.json_codepoint_bytes(codepoint)
            return size

        @staticmethod
        def decimal_digits(value: int) -> int:
            digits = 1
            while value >= 10:
                value //= 10
                digits += 1
            return digits

        def response_header_size(self, status: int, body_size: int) -> int:
            reason = self.responses.get(status, ("",))[0]
            server_size = len(self.server_version) + 1 + len(self.sys_version)
            return (
                len(self.protocol_version)
                + 1
                + self.decimal_digits(status)
                + 1
                + len(reason)
                + 2
                + len("Server: ")
                + server_size
                + 2
                + len("Date: ")
                + 29
                + 2
                + len("Content-Type: application/json\r\n")
                + len("Content-Length: ")
                + self.decimal_digits(body_size)
                + 2
                + 2
            )

        def send_error(
            self,
            code: int,
            message: str | None = None,
            explain: str | None = None,
        ) -> None:
            del explain
            payload = {"error": message or self.responses.get(code, ("error",))[0]}
            if getattr(self, "_parsing_request", False):
                self._pending_parse_error = (code, payload)
                return
            self.send_json(code, payload)

        def freeze_response_body(self, payload: Any) -> tuple[bytes, int]:
            deadline_poll = None
            if self._bundle_deadline_active or self._mutation_deadline_active:
                deadline_poll = lambda: self.request_deadline.check(
                    (
                        "bundle response encoding"
                        if self._bundle_deadline_active
                        else "upload response encoding"
                    )
                )
            freezer = _BoundedCanonicalJSONFreezer(
                self.decision_work,
                profile,
                self.budget_error,
                profile.limit("response_bytes"),
                deadline_poll,
            )
            return freezer.freeze(payload)

        def freeze_response_header(
            self, status: int, body_size: int, *, charge_work: bool = True
        ) -> tuple[bytes, int]:
            header_size = self.response_header_size(status, body_size)
            if header_size > profile.limit("response_header_bytes"):
                raise self.budget_error(
                    "response_header_bytes", header_size, "response_headers"
                )
            header_temporary = header_size * 2
            self.ensure_concurrent_capacity(
                "temporary_bytes", header_temporary, "response_headers"
            )
            self.ensure_concurrent_capacity(
                "retained_bytes", header_size, "response_headers"
            )
            permit = self.decision_work.reserve(
                "response_headers",
                charges=(
                    {"response_header_bytes": header_size}
                    if charge_work
                    else {}
                ),
                acquires={
                    "retained_bytes": header_size,
                    "temporary_bytes": header_temporary,
                },
            )
            retained = 0
            temporary = 0
            header: bytes | None = None
            header_text: str | None = None
            date_value: str | None = None
            try:
                self.finish_permit(
                    permit,
                    phase="response_headers",
                    charges=(
                        {"response_header_bytes": header_size}
                        if charge_work
                        else {}
                    ),
                    acquires={
                        "retained_bytes": header_size,
                        "temporary_bytes": header_temporary,
                    },
                )
                permit = None
                retained = header_size
                temporary = header_temporary
                reason = self.responses.get(status, ("",))[0]
                date_value = self.date_time_string()
                header_text = (
                    f"{self.protocol_version} {status} {reason}\r\n"
                    f"Server: {self.server_version} {self.sys_version}\r\n"
                    f"Date: {date_value}\r\n"
                    "Content-Type: application/json\r\n"
                    f"Content-Length: {body_size}\r\n"
                    "\r\n"
                )
                header = header_text.encode("latin-1", "strict")
                if len(header) != header_size:
                    raise CFError("HTTP response header size changed after preflight")
                header_text = None
                date_value = None
                self.decision_work.release("temporary_bytes", temporary)
                temporary = 0
                return header, retained
            except BaseException:
                header = None
                header_text = None
                date_value = None
                try:
                    self.cancel_if_open(permit)
                except BaseException:
                    pass
                try:
                    if temporary:
                        self.decision_work.release("temporary_bytes", temporary)
                except BaseException:
                    pass
                try:
                    if retained:
                        self.decision_work.release("retained_bytes", retained)
                except BaseException:
                    pass
                raise

        def prepare_mutation_json(
            self, status: int, payload: Any
        ) -> _PreparedHTTPMutationResponses:
            """Freeze normal and durable responses before an upload effect."""
            response_permit = self.decision_work.reserve(
                "response_body",
                charges={
                    "response_bytes": profile.limit("response_bytes")
                },
            )
            header_permit = None
            success_body: bytes | None = None
            durable_body: bytes | None = None
            success_header: bytes | None = None
            durable_header: bytes | None = None
            success_body_retained = 0
            durable_body_retained = 0
            success_header_retained = 0
            durable_header_retained = 0
            try:
                success_body, success_body_retained = self.freeze_response_body(
                    payload
                )
                durable_body, durable_body_retained = self.freeze_response_body(
                    HTTP_MUTATION_RETRY_PAYLOAD
                )
                success_header_size = self.response_header_size(
                    status, len(success_body)
                )
                durable_header_size = self.response_header_size(
                    503, len(durable_body)
                )
                header_actual = max(success_header_size, durable_header_size)
                if header_actual > profile.limit("response_header_bytes"):
                    raise self.budget_error(
                        "response_header_bytes",
                        header_actual,
                        "response_headers",
                    )
                header_permit = self.decision_work.reserve(
                    "response_headers",
                    charges={"response_header_bytes": header_actual},
                )
                success_header, success_header_retained = (
                    self.freeze_response_header(
                        status, len(success_body), charge_work=False
                    )
                )
                durable_header, durable_header_retained = (
                    self.freeze_response_header(
                        503, len(durable_body), charge_work=False
                    )
                )
                self.request_deadline.check("upload mutation publication")
                success = _PreparedHTTPResponseOwner(
                    self.decision_work,
                    success_header,
                    success_header_retained,
                    success_body,
                    success_body_retained,
                )
                durable = _PreparedHTTPResponseOwner(
                    self.decision_work,
                    durable_header,
                    durable_header_retained,
                    durable_body,
                    durable_body_retained,
                )
                success_header = None
                success_body = None
                durable_header = None
                durable_body = None
                success_header_retained = 0
                success_body_retained = 0
                durable_header_retained = 0
                durable_body_retained = 0
                responses = _PreparedHTTPMutationResponses(
                    self.decision_work,
                    success,
                    durable,
                    response_permit,
                    header_permit,
                    len(success.body or b""),
                    len(durable.body or b""),
                    success_header_size,
                    durable_header_size,
                )
                response_permit = None
                header_permit = None
                return responses
            except BaseException:
                success_header = None
                success_body = None
                durable_header = None
                durable_body = None
                try:
                    self.cancel_if_open(response_permit)
                except BaseException:
                    pass
                try:
                    self.cancel_if_open(header_permit)
                except BaseException:
                    pass
                for retained in (
                    success_header_retained,
                    success_body_retained,
                    durable_header_retained,
                    durable_body_retained,
                ):
                    try:
                        if retained:
                            self.decision_work.release(
                                "retained_bytes", retained
                            )
                    except BaseException:
                        pass
                raise

        def prepare_json_owned(
            self, status: int, payload: Any
        ) -> _PreparedHTTPResponseOwner | None:
            if self._response_owner_observation is None:
                self._response_owner_observation = {
                    "request_header_retained": self._request_header_retained,
                    "request_ast_retained": self._request_ast_retained,
                    "raw_requestline_live": bool(
                        getattr(self, "raw_requestline", b"")
                    ),
                    "headers_live": getattr(self, "headers", None) is not None,
                }
            if self.decision_work.terminal_reason is not None:
                return self.prepare_terminal_json(status, payload)
            if self._bundle_deadline_active:
                self.request_deadline.check("bundle response encoding")
            for attempt in range(2):
                body: bytes | None = None
                header: bytes | None = None
                body_retained = 0
                header_retained = 0
                response_permit = None
                try:
                    response_permit = self.decision_work.reserve(
                        "response_body",
                        charges={
                            "response_bytes": profile.limit("response_bytes")
                        },
                    )
                    body, body_retained = self.freeze_response_body(payload)
                    if self._bundle_deadline_active:
                        self.request_deadline.check("bundle response headers")
                    header, header_retained = self.freeze_response_header(
                        status, len(body)
                    )
                    self.finish_permit(
                        response_permit,
                        phase="response_body",
                        charges={"response_bytes": len(body)},
                    )
                    response_permit = None
                    if self._bundle_deadline_active:
                        self.request_deadline.check(
                            "bundle response publication"
                        )
                    prepared = _PreparedHTTPResponseOwner(
                        self.decision_work,
                        header,
                        header_retained,
                        body,
                        body_retained,
                    )
                    header = None
                    body = None
                    header_retained = 0
                    body_retained = 0
                    return prepared
                except ResourceBudgetExceeded as error:
                    header = None
                    body = None
                    try:
                        self.cancel_if_open(response_permit)
                    except BaseException:
                        pass
                    try:
                        if header_retained:
                            self.decision_work.release(
                                "retained_bytes", header_retained
                            )
                    except BaseException:
                        pass
                    try:
                        if body_retained:
                            self.decision_work.release(
                                "retained_bytes", body_retained
                            )
                    except BaseException:
                        pass
                    if attempt or self._budget_error is not None:
                        self.close_connection = True
                        return None
                    self._budget_error = error
                    status, payload = http_resource_budget_error(error)
                except BaseException:
                    header = None
                    body = None
                    try:
                        self.cancel_if_open(response_permit)
                    except BaseException:
                        pass
                    try:
                        if header_retained:
                            self.decision_work.release(
                                "retained_bytes", header_retained
                            )
                    except BaseException:
                        pass
                    try:
                        if body_retained:
                            self.decision_work.release(
                                "retained_bytes", body_retained
                            )
                    except BaseException:
                        pass
                    raise
            return None

        def prepare_terminal_json(
            self, status: int, payload: Any
        ) -> _PreparedHTTPResponseOwner | None:
            """Encode one bounded error without reopening a terminal ledger."""
            current = self.decision_work.current
            if (
                current.get("retained_bytes", 0)
                != self._request_header_retained
                or any(
                    value
                    for dimension, value in current.items()
                    if dimension != "retained_bytes"
                )
                or self.decision_work.has_open_permits()
            ):
                self.close_connection = True
                return None
            control_limit = 64 * 1024
            control_payload = payload
            if canonical_json_size_up_to(control_payload, control_limit) > control_limit:
                bounded = {
                    "error": (
                        "terminal HTTP diagnostic exceeded the bounded "
                        "control-plane limit"
                    )
                }
                if type(payload) is dict:
                    kind = dict.get(payload, "kind")
                    if (
                        type(kind) is str
                        and canonical_json_size_up_to(kind, 256) <= 256
                    ):
                        bounded["kind"] = kind
                    exit_code = dict.get(payload, "exit_code")
                    if (
                        type(exit_code) is int
                        and 0 <= exit_code <= RESOURCE_BUDGET_EXIT_CODE
                    ):
                        bounded["exit_code"] = exit_code
                control_payload = bounded
            body = canonical_json(control_payload)
            if len(body) > control_limit:
                self.close_connection = True
                return None
            reason = self.responses.get(status, ("",))[0]
            header_size = self.response_header_size(status, len(body))
            if header_size > control_limit:
                self.close_connection = True
                return None
            header = (
                f"{self.protocol_version} {status} {reason}\r\n"
                f"Server: {self.server_version} {self.sys_version}\r\n"
                f"Date: {self.date_time_string()}\r\n"
                "Content-Type: application/json\r\n"
                f"Content-Length: {len(body)}\r\n"
                "\r\n"
            ).encode("latin-1", "strict")
            if len(header) != header_size:
                raise CFError("terminal HTTP response header size changed")
            return _PreparedHTTPResponseOwner(
                self.decision_work, header, 0, body, 0
            )

        def prepare_json(
            self, status: int, payload: Any
        ) -> _PreparedHTTPResponseOwner | None:
            payload_owner = payload
            try:
                prepared = self.prepare_json_owned(status, payload)
            except BaseException:
                try:
                    close = getattr(payload_owner, "close", None)
                    if close is not None:
                        close()
                except BaseException:
                    pass
                raise
            try:
                close = getattr(payload_owner, "close", None)
                if close is not None:
                    close()
            except BaseException:
                if prepared is not None:
                    try:
                        prepared.close()
                    except BaseException:
                        pass
                raise
            return prepared

        def publish_prepared(
            self, prepared: _PreparedHTTPResponseOwner | None
        ) -> None:
            if prepared is None:
                return
            try:
                prepared.publish(self.wfile)
            finally:
                self._response_body_dropped_before_release = True

        def send_json(self, status: int, payload: Any) -> None:
            self.publish_prepared(self.prepare_json(status, payload))

        def finish_request_headers(
            self,
            permit: DecisionWorkPermit,
            bytes_read: int,
        ) -> None:
            physical_bytes = bytes_read * 2
            self.finish_permit(
                permit,
                phase="request_headers",
                charges={"request_header_bytes": bytes_read},
                acquires={"retained_bytes": physical_bytes},
            )
            self._request_header_retained = physical_bytes

        def handle_one_request(self) -> None:
            self.decision_work = DecisionWorkLedger(
                profile, "http request", command_kind="http_request"
            )
            self.request_deadline = HTTPRequestDeadline(
                profile.request_deadline_ms, _monotonic_clock
            )
            self._budget_error: ResourceBudgetExceeded | None = None
            self._deadline_error: RequestDeadlineExceeded | None = None
            self._bundle_deadline_active = False
            self._mutation_deadline_active = False
            self._pending_parse_error: tuple[int, dict[str, Any]] | None = None
            self._parsing_request = True
            self._request_header_retained = 0
            self._request_ast_retained = 0
            self._request_body_bytes_read = 0
            self._request_raw_dropped_before_temp_release = False
            self._request_ast_dropped_before_release = False
            self._response_body_dropped_before_release = False
            self._response_owner_observation: dict[str, Any] | None = None
            header_permit = None
            reader: _BoundedHTTPHeaderReader | None = None
            raw_reader = self.rfile
            try:
                header_limit = profile.limit("request_header_bytes")
                header_allocation_limit = min(
                    header_limit,
                    profile.limit("retained_bytes") // 2,
                )
                header_permit = self.decision_work.reserve(
                    "request_headers",
                    charges={"request_header_bytes": header_limit},
                    acquires={"retained_bytes": header_allocation_limit * 2},
                )
                reader = _BoundedHTTPHeaderReader(
                    raw_reader,
                    header_allocation_limit,
                    lambda observed: self.budget_error(
                        (
                            "request_header_bytes"
                            if header_allocation_limit == header_limit
                            else "retained_bytes"
                        ),
                        (
                            observed
                            if header_allocation_limit == header_limit
                            else observed * 2
                        ),
                        "request_headers",
                    ),
                )
                self.rfile = reader
                self.raw_requestline = self.rfile.readline(65537)
                if not self.raw_requestline:
                    self.close_connection = True
                    self.finish_request_headers(header_permit, reader.bytes_read)
                    header_permit = None
                    return
                parsed = self.parse_request()
                self.rfile = raw_reader
                self._parsing_request = False
                self.finish_request_headers(header_permit, reader.bytes_read)
                header_permit = None
                if not parsed:
                    if self._pending_parse_error is not None:
                        status, payload = self._pending_parse_error
                        self.send_json(status, payload)
                    return
                method_name = "do_" + self.command
                if not hasattr(self, method_name):
                    self.send_json(501, {"error": f"Unsupported method ({self.command!r})"})
                    return
                getattr(self, method_name)()
                self.wfile.flush()
            except ResourceBudgetExceeded as error:
                self._budget_error = error
                self.rfile = raw_reader
                self._parsing_request = False
                if header_permit is not None and reader is not None:
                    self.finish_request_headers(
                        header_permit, reader.bytes_read
                    )
                    header_permit = None
                else:
                    self.cancel_if_open(header_permit)
                    header_permit = None
                status, payload = http_resource_budget_error(error)
                self.send_json(status, payload)
            except TimeoutError as error:
                self.log_error("Request timed out: %r", error)
                self.close_connection = True
            finally:
                self.rfile = raw_reader
                self._parsing_request = False
                self.cancel_if_open(header_permit)
                self.release_request_header_storage()
                if self.decision_work.has_open_permits():
                    self.close_connection = True
                elif any(self.decision_work.current.values()):
                    self.close_connection = True
                elif self._deadline_error is not None:
                    self.close_connection = True
                elif self.decision_work.terminal_reason is None:
                    reason = (
                        "budget_exceeded"
                        if self._budget_error is not None
                        else "complete"
                    )
                    self.decision_work.terminate(reason)
                if _decision_work_observer is not None:
                    _decision_work_observer(
                        {
                            "snapshot": self.decision_work.snapshot(),
                            "open_permit_count": len(
                                self.decision_work._reserved
                            ),
                            "request_body_bytes_read": self._request_body_bytes_read,
                            "budget_diagnostic": (
                                None
                                if self._budget_error is None
                                else self._budget_error.diagnostic()
                            ),
                            "deadline_diagnostic": (
                                None
                                if self._deadline_error is None
                                else self._deadline_error.diagnostic()
                            ),
                            "deadline": self.request_deadline.snapshot(),
                            "request_raw_dropped_before_temp_release": (
                                self._request_raw_dropped_before_temp_release
                            ),
                            "request_ast_dropped_before_release": (
                                self._request_ast_dropped_before_release
                            ),
                            "response_body_dropped_before_release": (
                                self._response_body_dropped_before_release
                            ),
                            "response_owner": self._response_owner_observation,
                        }
                    )

        def project_parts(self) -> tuple[str, str, list[str]]:
            parsed = urllib.parse.urlparse(self.path)
            parts = [decode_remote_component(p, "HTTP path") for p in parsed.path.split("/") if p]
            if len(parts) < 4 or parts[:2] != ["v1", "projects"]:
                raise CFError("unknown endpoint")
            org = parts[2]
            app = parts[3]
            return org, app, parts[4:]

        def do_GET(self) -> None:
            payload: Any = None
            try:
                try:
                    org, app, rest = self.project_parts()
                    if rest == ["branches"]:
                        status, payload = handle_http_list(storage_root, org, app)
                    elif rest == ["doctor"]:
                        query = urllib.parse.urlparse(self.path).query
                        if query not in {"", "quick=1"}:
                            raise CFError("unsupported remote doctor query; expected quick=1")
                        status, payload = handle_http_doctor(
                            storage_root, org, app, quick=query == "quick=1"
                        )
                    elif (
                        len(rest) == 3
                        and rest[0] == "branches"
                        and rest[2] == "bundle"
                    ):
                        self._bundle_deadline_active = True
                        status, payload = handle_http_bundle(
                            storage_root,
                            org,
                            app,
                            rest[1],
                            self.decision_work,
                            deadline=self.request_deadline,
                        )
                    elif rest == ["merge-requests"]:
                        status, payload = handle_http_request_list(
                            storage_root, org, app
                        )
                    else:
                        status, payload = http_error(404, "unknown endpoint")
                except ResourceBudgetExceeded as exc:
                    self._budget_error = exc
                    status, payload = http_resource_budget_error(exc)
                except RequestDeadlineExceeded:
                    raise
                except CFError as exc:
                    status, payload = http_error(400, str(exc))
                self.send_json(status, payload)
                payload = None
            except RequestDeadlineExceeded as exc:
                deadline_error = RequestDeadlineExceeded(exc.phase, exc.limit_ms)
                self._deadline_error = deadline_error
                exc.__traceback__ = None
                try:
                    close = getattr(payload, "close", None)
                    if close is not None:
                        close()
                except BaseException:
                    self.close_connection = True
                    return
                payload = None
                current = self.decision_work.current
                route_memory_released = (
                    current.get("retained_bytes", 0)
                    == self._request_header_retained
                    and not any(
                        value
                        for dimension, value in current.items()
                        if dimension != "retained_bytes"
                    )
                    and not self.decision_work.has_open_permits()
                )
                if not route_memory_released:
                    self.close_connection = True
                    return
                if self.decision_work.terminal_reason is None:
                    self.decision_work.terminate("deadline_exceeded")
                elif self.decision_work.terminal_reason != "deadline_exceeded":
                    self.close_connection = True
                    return
                status, terminal_payload = http_request_deadline_error(
                    deadline_error
                )
                self.send_json(status, terminal_payload)

        def do_POST(self) -> None:
            request: Any = None
            payload: dict[str, Any] | None = None
            request_retained = 0
            prepared: _PreparedHTTPResponseOwner | None = None
            mutation_slot: _HTTPMutationResponseSlot | None = None
            deadline_failed = False
            try:
                org, app, rest = self.project_parts()
                transfer_encodings = self.headers.get_all("Transfer-Encoding", [])
                if transfer_encodings:
                    raise CFError("Transfer-Encoding is unsupported")
                content_lengths = self.headers.get_all("Content-Length", [])
                if len(content_lengths) > 1:
                    raise CFError("duplicate Content-Length header")
                raw_length = content_lengths[0] if content_lengths else "0"
                if not raw_length or not raw_length.isascii() or not raw_length.isdigit():
                    raise CFError("malformed Content-Length header")
                maximum_length = str(U64_MAX)
                if len(raw_length) > len(maximum_length) or (
                    len(raw_length) == len(maximum_length)
                    and raw_length > maximum_length
                ):
                    raise CFError("Content-Length header exceeds u64")
                length = int(raw_length, 10)
                body_limit = profile.limit("request_body_bytes")
                if length > body_limit:
                    raise self.budget_error(
                        "request_body_bytes", length, "request_body"
                    )
                raw_temporary_upper = length * 2
                self.ensure_concurrent_capacity(
                    "temporary_bytes", raw_temporary_upper, "request_body"
                )
                body_permit = self.decision_work.reserve(
                    "request_body",
                    charges={"request_body_bytes": length},
                    acquires={"temporary_bytes": raw_temporary_upper},
                )
                raw_temporary = 0
                ast_retained = 0
                ast_permit = None
                body_bytes: bytes | None = None
                body: str | None = None
                try:
                    self.finish_permit(
                        body_permit,
                        phase="request_body",
                        charges={"request_body_bytes": length},
                        acquires={"temporary_bytes": raw_temporary_upper},
                    )
                    body_permit = None
                    raw_temporary = raw_temporary_upper
                    if length:
                        body_bytes = self.rfile.read(length)
                        self._request_body_bytes_read = len(body_bytes)
                        if len(body_bytes) != length:
                            raise CFError("incomplete HTTP request body")
                        body = body_bytes.decode("utf-8")
                    else:
                        body = "{}"
                    ast_retained_upper = self.request_canonical_upper(body)
                    self.ensure_concurrent_capacity(
                        "retained_bytes", ast_retained_upper, "request_body"
                    )
                    ast_permit = self.decision_work.reserve(
                        "request_body",
                        acquires={"retained_bytes": ast_retained_upper},
                    )
                    self.finish_permit(
                        ast_permit,
                        phase="request_body",
                        acquires={"retained_bytes": ast_retained_upper},
                    )
                    ast_permit = None
                    ast_retained = ast_retained_upper
                    request = json.loads(body)
                    body = None
                    body_bytes = None
                    self._request_raw_dropped_before_temp_release = True
                    if raw_temporary:
                        self.decision_work.release(
                            "temporary_bytes", raw_temporary
                        )
                        raw_temporary = 0
                    canonical_size = canonical_json_size(request)
                    if canonical_size > ast_retained_upper:
                        raise CFError(
                            "parsed HTTP JSON exceeds its preflight ownership bound"
                        )
                    if ast_retained_upper > canonical_size:
                        self.decision_work.release(
                            "retained_bytes",
                            ast_retained_upper - canonical_size,
                        )
                    ast_retained = canonical_size
                    request_retained = canonical_size
                    self._request_ast_retained = canonical_size
                except BaseException:
                    body = None
                    body_bytes = None
                    request = None
                    try:
                        self.cancel_if_open(body_permit)
                    except BaseException:
                        pass
                    try:
                        self.cancel_if_open(ast_permit)
                    except BaseException:
                        pass
                    if raw_temporary:
                        self._request_raw_dropped_before_temp_release = True
                        try:
                            self.decision_work.release(
                                "temporary_bytes", raw_temporary
                            )
                        except BaseException:
                            pass
                    if ast_retained:
                        try:
                            self.decision_work.release(
                                "retained_bytes", ast_retained
                            )
                        except BaseException:
                            pass
                    raise
                self.cancel_if_open(body_permit)
                self.cancel_if_open(ast_permit)
                if len(rest) == 3 and rest[0] == "branches" and rest[2] == "upload":
                    self._mutation_deadline_active = True
                    mutation_slot = _HTTPMutationResponseSlot(self)
                    status, payload = handle_http_upload(
                        storage_root,
                        org,
                        app,
                        rest[1],
                        request,
                        response_slot=mutation_slot,
                        decision_work=self.decision_work,
                        deadline=self.request_deadline,
                    )
                    prepared = mutation_slot.take()
                elif rest == ["gc"]:
                    status, payload = handle_http_gc(storage_root, org, app, request)
                elif rest == ["merge-requests"]:
                    status, payload = handle_http_request_merge(storage_root, org, app, request)
                elif len(rest) == 3 and rest[0] == "merge-requests" and rest[2] == "review":
                    status, payload = handle_http_request_review(storage_root, org, app, rest[1], request)
                elif len(rest) == 3 and rest[0] == "merge-requests" and rest[2] == "apply":
                    status, payload = handle_http_request_apply(storage_root, org, app, rest[1], request)
                else:
                    status, payload = http_error(404, "unknown endpoint")
            except (UnicodeDecodeError, json.JSONDecodeError):
                status, payload = http_error(400, "invalid JSON request")
            except ResourceBudgetExceeded as exc:
                self._budget_error = exc
                status, payload = http_resource_budget_error(exc)
            except RequestDeadlineExceeded as exc:
                self._deadline_error = RequestDeadlineExceeded(
                    exc.phase, exc.limit_ms
                )
                self._mutation_deadline_active = False
                deadline_failed = True
                status, payload = http_request_deadline_error(
                    self._deadline_error
                )
            except CFError as exc:
                status, payload = http_error(400, str(exc))
            except BaseException:
                payload = None
                request = None
                if mutation_slot is not None:
                    try:
                        mutation_slot.close()
                    except BaseException:
                        pass
                if prepared is not None:
                    try:
                        prepared.close()
                    except BaseException:
                        pass
                if request_retained:
                    self._request_ast_retained = 0
                    self._request_ast_dropped_before_release = True
                    try:
                        self.decision_work.release(
                            "retained_bytes", request_retained
                        )
                    except BaseException:
                        pass
                raise
            if self.decision_work.terminal_reason is not None:
                request = None
                if mutation_slot is not None:
                    mutation_slot.close()
                    mutation_slot = None
                if request_retained:
                    self._request_ast_retained = 0
                    self._request_ast_dropped_before_release = True
                    self.decision_work.release(
                        "retained_bytes", request_retained
                    )
                    request_retained = 0
            try:
                if prepared is None:
                    prepared = self.prepare_json(status, payload)
            finally:
                payload = None
                request = None
                if mutation_slot is not None:
                    mutation_slot.close()
                    mutation_slot = None
                if request_retained:
                    self._request_ast_dropped_before_release = True
                    self.decision_work.release(
                        "retained_bytes", request_retained
                    )
                    request_retained = 0
                    self._request_ast_retained = 0
            self.publish_prepared(prepared)
            if deadline_failed and self.decision_work.terminal_reason is None:
                self.decision_work.terminate("deadline_exceeded")

    return CodeFireHTTPHandler


def is_ancestor(repo_root: Path, ancestor: str, commit_id: str) -> bool:
    return ancestor in ancestor_distances(repo_root, commit_id)


def remote_commit_parents(project_root: Path, commit_id: str) -> list[str]:
    return list(load_object_from_root(remote_dirs(project_root)["objects"], commit_id).get("parents", []))


def remote_ancestor_distances(project_root: Path, commit_id: str) -> dict[str, int]:
    distances: dict[str, int] = {}
    queue = deque([(commit_id, 0)])
    while queue:
        current, dist = queue.popleft()
        if current in distances and distances[current] <= dist:
            continue
        distances[current] = dist
        for parent in remote_commit_parents(project_root, current):
            queue.append((parent, dist + 1))
    return distances


def remote_is_ancestor(project_root: Path, ancestor: str, commit_id: str) -> bool:
    return ancestor in remote_ancestor_distances(project_root, commit_id)


def remote_pending_object_roots(project_root: Path) -> list[str]:
    pending = read_json(project_root / "pending_transaction.json")
    if pending is None:
        return []
    known_operations = {
        "remote_upload",
        "remote_request_merge",
        "remote_request_review",
        "remote_request_apply",
    }
    if (
        not isinstance(pending, dict)
        or pending.get("type") != "remote_publication_transaction"
        or pending.get("version") != VERSION
        or pending.get("operation") not in known_operations
        or (pending.get("status"), pending.get("phase"))
        not in {("pending", "applying"), ("completed", "completed")}
    ):
        raise CFError(
            "foreign or future remote pending transaction blocks root discovery"
        )
    roots = pending.get("object_roots") if isinstance(pending, dict) else None
    if not isinstance(roots, list) or len(roots) > 64:
        raise CFError("remote pending transaction object roots are malformed")
    result: list[str] = []
    for root in roots:
        if (
            not isinstance(root, dict)
            or set(root) != {"kind", "id"}
            or root.get("kind") != "sealed_commit"
            or not isinstance(root.get("id"), str)
        ):
            raise CFError("remote pending transaction object root is malformed")
        result.append(root["id"])
    if len(set(result)) != len(result):
        raise CFError("remote pending transaction object roots are duplicated")
    return result


def reachable_remote_objects(project_root: Path) -> set[str]:
    dirs = remote_dirs(project_root)
    roots: list[str] = []
    for path in dirs["branches"].glob("*.json"):
        branch = validate_remote_branch_record(read_json(path))
        if branch and branch.get("head"):
            roots.append(branch["head"])
    for path in dirs["merge_requests"].glob("*.json"):
        mr = read_remote_merge_request_path(path)
        for key in ["source_head", "target_head_at_request", "applied_head"]:
            if mr and mr.get(key):
                roots.append(mr[key])
    roots.extend(remote_pending_object_roots(project_root))
    reachable: set[str] = set()
    stack = roots[:]
    objects_root = dirs["objects"]
    while stack:
        oid = stack.pop()
        if oid in reachable:
            continue
        if object_record_path(objects_root, oid) is None:
            continue
        reachable.add(oid)
        stack.extend(
            object_record_references(load_object_record_from_root(objects_root, oid))
        )
    return reachable


def all_remote_object_records(project_root: Path) -> list[Path]:
    return sorted(remote_dirs(project_root)["objects"].glob("*/*.json"))


def object_hash_error_paths(objects_root: Path) -> list[Path]:
    bad = []
    for path in objects_root.glob("*/*.json"):
        record = read_json(path)
        try:
            validate_object_record(record, path=path)
        except CFError:
            bad.append(path)
    return bad


def object_graph_missing_references(objects_root: Path, roots: list[str]) -> list[str]:
    missing: set[str] = set()
    seen: set[str] = set()
    stack = roots[:]
    while stack:
        oid = stack.pop()
        if oid in seen:
            continue
        seen.add(oid)
        path = object_record_path(objects_root, oid)
        if path is None:
            missing.add(oid)
            continue
        record = read_json(path)
        try:
            validate_object_record(record, expected_oid=oid, path=path)
        except CFError:
            continue
        stack.extend(object_record_references(record))
    return sorted(missing)


