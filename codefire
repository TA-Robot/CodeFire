def csharp_blocks(lines: list[str]) -> list[tuple[int, int, str, str]]:
    blocks: list[tuple[int, int, str, str]] = []
    type_pattern = re.compile(
        r"^\s*(?:public|protected|private|internal|abstract|sealed|static|partial|readonly|unsafe|\s)+(?:(record)\s+)?(class|interface|struct|record|enum)\s+([A-Za-z_][A-Za-z0-9_]*)\b"
    )
