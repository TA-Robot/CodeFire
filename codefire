        )
        print(f"applied {args.mr_id}")
        print(f"target: {response['target_branch']}@{response['head']}")
        return 0
    info = parse_cf_project_url(args.server_url)
    dirs = remote_dirs(info["project_root"])
    actor = actor_from_args(args)
    request_payload = {
        "actor": actor,
        "token": token_from_args(args),
        "idempotency_key": args.idempotency_key,
    }
    actor = authorize_remote(
        info["project_root"],
        "apply",
        args,
        target=remote_request_target(info, "apply", mr_id=args.mr_id),
        payload=request_payload,
    )
    mr_path = remote_merge_request_path(info["project_root"], args.mr_id)
    mr = read_remote_merge_request_path(mr_path)
    if not mr:
        raise CFError(f"merge request not found: {args.mr_id}")
    validate_merge_request_record(mr)
    source = parse_cf_url(mr["source_url"])
    target = parse_cf_url(mr["target_url"])
    subject_digest = validate_merge_request_subject(mr, source, target)
    source_head = str(mr["source_head"])
    semantic = {
        "stable_project_id": remote_project_stable_id(target["project_root"]),
        "merge_request_id": args.mr_id,
        "subject_digest": subject_digest,
        "target_branch": target["branch"],
        "source_head": source_head,
        "target_head_at_request": mr["target_head_at_request"],
    }
    result = {
        "id": args.mr_id,
        "target_branch": target["branch"],
        "head": source_head,
    }
    if remote_publication_recovery_exists(
        target["project_root"],
        "remote_request_apply",
        actor,
        args.idempotency_key,
    ):
        with remote_project_gate(target["project_root"]):
            current_generation = read_json(
                remote_generation_path(target["project_root"])
            )
            current_target = read_remote_branch_record(
                target["project_root"], target["branch"]
            )
            current_mr = read_remote_merge_request_path(mr_path)
            execute_remote_json_publication(
                target["project_root"],
                "remote_request_apply",
                actor,
                semantic,
                [
                    ({"kind": "generation"}, current_generation, current_generation),
                    (
                        {"kind": "branch", "name": target["branch"]},
                        current_target,
                        current_target,
                    ),
                    (
                        {"kind": "merge_request", "id": args.mr_id},
                        current_mr,
                        current_mr,
                    ),
                ],
                result,
                idempotency_key=args.idempotency_key,
                object_roots=list(
                    dict.fromkeys([source_head, str(mr["target_head_at_request"])])
                ),
            )
        print(f"applied {args.mr_id}")
        print(f"target: {target['branch']}@{source_head}")
        return 0
    if mr.get("status") != "approved":
        raise CFError(f"merge request must be approved before apply: {args.mr_id}")
    if not merge_request_has_effective_approval(mr, subject_digest):
        raise CFError(f"merge request approval is not bound to its current subject: {args.mr_id}")
    target_branch = read_remote_branch_record(target["project_root"], target["branch"])
    if not target_branch:
        raise CFError(f"target remote branch not found: {mr['target_url']}")
    check_remote_branch_protection(target["project_root"], target["branch"], "apply", actor)
    if target_branch["head"] != mr["target_head_at_request"]:
        raise CFError(f"merge request is stale: {args.mr_id}")
    escrow_objects = remote_dirs(target["project_root"])["objects"]
    validate_sealed_commit(escrow_objects, source_head)
    validate_sealed_commit(escrow_objects, target_branch["head"])
    enforce_remote_commit_signature_policy(target["project_root"], escrow_objects, source_head)
    if not remote_is_ancestor(target["project_root"], target_branch["head"], source_head):
        raise CFError("request apply rejected: source is not a fast-forward of target")
    with remote_project_gate(target["project_root"]):
        current_mr = read_remote_merge_request_path(mr_path)
        if current_mr != mr:
            raise CFError(f"merge request changed while acquiring project gate: {args.mr_id}")
        current_target = read_remote_branch_record(target["project_root"], target["branch"])
        if current_target["head"] != mr["target_head_at_request"]:
            raise CFError(f"merge request is stale: {args.mr_id}")
        generation_before = read_json(remote_generation_path(target["project_root"]))
        generation = (
            generation_before.get("current_generation", 0)
            if isinstance(generation_before, dict)
            else 0
        ) + 1
        branch_after = {
            "version": VERSION,
            "name": target["branch"],
            "head": source_head,
            "generation": generation,
            "applied_from": mr["source_url"],
            "applied_by": actor,
            "updated_at": now_iso(),
        }
        mr_after = dict(mr)
        mr_after["status"] = "applied"
        mr_after["applied_at"] = now_iso()
        mr_after["applied_by"] = actor
        mr_after["applied_head"] = source_head
        execute_remote_json_publication(
            target["project_root"],
            "remote_request_apply",
            actor,
            semantic,
            [
                ({"kind": "generation"}, generation_before, {"current_generation": generation}),
                ({"kind": "branch", "name": target["branch"]}, current_target, branch_after),
                ({"kind": "merge_request", "id": args.mr_id}, mr, mr_after),
            ],
            result,
            idempotency_key=args.idempotency_key,
            object_roots=list(
                dict.fromkeys([source_head, str(mr["target_head_at_request"])])
            ),
        )
    print(f"applied {args.mr_id}")
    print(f"target: {target['branch']}@{source_head}")
    return 0


