        response = http_json(
            "POST",
            http_remote_path(info, "merge-requests", args.mr_id, "review"),
            payload,
        )
        print(f"{response['decision']}d {args.mr_id} by {response['reviewer']}")
        return 0
    info = parse_cf_project_url(args.server_url)
    dirs = remote_dirs(info["project_root"])
    actor = actor_from_args(args)
    request_payload = {
        "reviewer": args.reviewer,
        "decision": args.decision,
        "comment": args.comment,
        "actor": actor,
        "token": token_from_args(args),
        "idempotency_key": args.idempotency_key,
    }
    actor = authorize_remote(
        info["project_root"],
        "review",
        args,
        target=remote_request_target(info, "review", mr_id=args.mr_id),
        payload=request_payload,
    )
    mr_path = remote_merge_request_path(info["project_root"], args.mr_id)
    mr = read_remote_merge_request_path(mr_path)
    if not mr:
        raise CFError(f"merge request not found: {args.mr_id}")
    initial_source_url = mr.get("source_url")
    initial_target_url = mr.get("target_url")
    target = parse_cf_url(mr["target_url"])
    source = parse_cf_url(mr["source_url"])
    if target["project_root"] != info["project_root"]:
        raise CFError("merge request target does not belong to the reviewed project")
    review_gate = (
        remote_project_gate(target["project_root"])
        if "subject" in mr
        else ordered_remote_merge_gates(source["project_root"], target["project_root"])
    )
    with review_gate:
        mr = read_remote_merge_request_path(mr_path)
        if not mr:
            raise CFError(f"merge request not found: {args.mr_id}")
        if (
            mr.get("source_url") != initial_source_url
            or mr.get("target_url") != initial_target_url
        ):
            raise CFError(
                "merge request endpoints changed while acquiring project gates"
            )
        validate_merge_request_record(mr)
        target = parse_cf_url(mr["target_url"])
        current_target = read_remote_branch_record(target["project_root"], target["branch"])
        subject_is_materialized = "subject" in mr
        if (
            not subject_is_materialized
            and current_target
            and current_target["head"] != mr["target_head_at_request"]
        ):
            raise CFError(f"merge request is stale: {args.mr_id}")
        mr_before = dict(mr)
        subject_digest = materialize_merge_request_subject(mr, source, target)
        comment = args.comment if isinstance(args.comment, str) else ""
        review = {
            "reviewer": args.reviewer,
            "decision": args.decision,
            "comment": comment,
            "subject_digest": subject_digest,
            "reviewed_at": now_iso(),
        }
        reviews = list(mr.get("reviews", []))
        reviews.append(review)
        mr["reviews"] = reviews
        if args.decision == "approve":
            mr["status"] = "approved"
        elif args.decision == "reject":
            mr["status"] = "rejected"
        semantic = {
            "stable_project_id": remote_project_stable_id(target["project_root"]),
            "merge_request_id": args.mr_id,
            "reviewer": args.reviewer,
            "decision": args.decision,
            "comment": comment,
            "subject_digest": subject_digest,
        }
        writes = [
            (
                {"kind": "merge_request", "id": args.mr_id},
                mr_before,
                mr,
            )
        ]
        result = {
            "id": args.mr_id,
            "reviewer": args.reviewer,
            "decision": args.decision,
        }
        if remote_publication_recovery_exists(
            target["project_root"],
            "remote_request_review",
            actor,
            args.idempotency_key,
        ):
            execute_remote_json_publication(
                target["project_root"],
                "remote_request_review",
                actor,
                semantic,
                writes,
                result,
                idempotency_key=args.idempotency_key,
                object_roots=[str(mr["source_head"])],
            )
        else:
            if (
                subject_is_materialized
                and current_target
                and current_target["head"] != mr["target_head_at_request"]
            ):
                raise CFError(f"merge request is stale: {args.mr_id}")
            execute_remote_json_publication(
                target["project_root"],
                "remote_request_review",
                actor,
                semantic,
                writes,
                result,
                idempotency_key=args.idempotency_key,
                object_roots=[str(mr["source_head"])],
            )
    print(f"{args.decision}d {args.mr_id} by {args.reviewer}")
    return 0


