def remote_authority_file_name(
    domain: str, value: str, *, percent_encode: bool = False
) -> str:
    direct = ref_file_name(value) if percent_encode else value
    if len(direct.encode("utf-8")) <= 160:
        return f"{direct}.json"
    digest = hashlib.sha256(
        f"codefire-remote-authority-v1\0{domain}\0{value}".encode("utf-8")
    ).hexdigest()
    return f"{REMOTE_INTERNAL_HASH_PREFIX}{digest}.json"


