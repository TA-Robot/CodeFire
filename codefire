REMOTE_COMPONENT_BYTE_LIMIT = 255
REMOTE_INTERNAL_HASH_PREFIX = "CF-INTERNAL-HASH-"


def decode_remote_component(value: str, kind: str) -> str:
    if re.search(r"%(?![0-9A-Fa-f]{2})", value):
        raise CFError(f"invalid percent escape in remote {kind}: {value}")
    try:
        decoded = urllib.parse.unquote_to_bytes(value).decode("utf-8", errors="strict")
    except UnicodeDecodeError as exc:
        raise CFError(f"remote {kind} component is not UTF-8: {value}") from exc
    validate_remote_component(decoded, kind)
    return decoded


def validate_remote_component(value: str, kind: str) -> None:
    invalid = (
        not value
        or value in {".", ".."}
        or len(value.encode("utf-8")) > REMOTE_COMPONENT_BYTE_LIMIT
        or value.startswith(("/", "\\"))
        or "/" in value
        or "\\" in value
        or ":" in value
        or value.startswith(REMOTE_INTERNAL_HASH_PREFIX)
        or any(unicodedata.category(character) == "Cc" for character in value)
        or Path(value).is_absolute()
        or len(Path(value).parts) != 1
    )
    if invalid:
        raise CFError(f"invalid remote {kind} component: {value!r}")


def parse_cf_url(url: str) -> dict[str, Any]:
    if not url.startswith("cf://"):
        raise CFError(f"not a CodeFire remote URL: {url}")
    raw = url[len("cf://") :]
    if not raw:
        raise CFError("remote URL is empty")
    parts = [p for p in raw.split("/") if p]
    if len(parts) < 4:
        raise CFError("remote URL must be cf://<server-path>/<org>/<app>/<branch>")
    branch_part = parts[-1]
    app_part = parts[-2]
    org_part = parts[-3]
    branch = decode_remote_component(branch_part, "branch")
    app = decode_remote_component(app_part, "application")
    org = decode_remote_component(org_part, "organization")
    server_raw = raw[: -len(f"/{org_part}/{app_part}/{branch_part}")].rstrip("/")
    if not server_raw:
        server_raw = "."
    server_root = Path(server_raw).expanduser().resolve()
    project_root = server_root / ".codefire-server" / "projects" / org / app
    return {
        "server_root": server_root,
        "project_root": project_root,
        "org": org,
        "app": app,
        "branch": branch,
        "url": url,
    }


def parse_cf_project_url(url: str) -> dict[str, Any]:
    if not url.startswith("cf://"):
        raise CFError(f"not a CodeFire remote URL: {url}")
    raw = url[len("cf://") :]
    parts = [p for p in raw.split("/") if p]
    if len(parts) < 3:
        raise CFError("remote project URL must be cf://<server-path>/<org>/<app>")
    app_part = parts[-1]
    org_part = parts[-2]
    app = decode_remote_component(app_part, "application")
    org = decode_remote_component(org_part, "organization")
    server_raw = raw[: -len(f"/{org_part}/{app_part}")].rstrip("/")
    if not server_raw:
        server_raw = "."
    server_root = Path(server_raw).expanduser().resolve()
    project_root = server_root / ".codefire-server" / "projects" / org / app
    return {
        "server_root": server_root,
        "project_root": project_root,
        "org": org,
        "app": app,
        "url": url,
    }


def is_http_remote_url(url: str) -> bool:
    return url.startswith("cf+http://") or url.startswith("cf+https://")


def is_remote_url(url: str) -> bool:
    return url.startswith("cf://") or is_http_remote_url(url)


def parse_cf_http_url(url: str) -> dict[str, Any]:
    parsed = urllib.parse.urlparse(url)
    if parsed.scheme not in {"cf+http", "cf+https"} or not parsed.netloc:
        raise CFError(f"not a CodeFire HTTP remote URL: {url}")
    parts = [decode_remote_component(p, "HTTP path") for p in parsed.path.split("/") if p]
    if len(parts) < 3:
        raise CFError("HTTP remote URL must be cf+http://<host>/<org>/<app>/<branch>")
    endpoint_scheme = "https" if parsed.scheme == "cf+https" else "http"
    return {
        "endpoint": f"{endpoint_scheme}://{parsed.netloc}",
        "remote_scheme": parsed.scheme,
        "netloc": parsed.netloc,
        "org": parts[0],
        "app": parts[1],
        "branch": parts[2],
        "url": url,
    }


def parse_cf_http_project_url(url: str) -> dict[str, Any]:
    parsed = urllib.parse.urlparse(url)
    if parsed.scheme not in {"cf+http", "cf+https"} or not parsed.netloc:
        raise CFError(f"not a CodeFire HTTP remote URL: {url}")
    parts = [decode_remote_component(p, "HTTP path") for p in parsed.path.split("/") if p]
    if len(parts) < 2:
        raise CFError("HTTP remote project URL must be cf+http://<host>/<org>/<app>")
    endpoint_scheme = "https" if parsed.scheme == "cf+https" else "http"
    return {
        "endpoint": f"{endpoint_scheme}://{parsed.netloc}",
        "remote_scheme": parsed.scheme,
        "netloc": parsed.netloc,
        "org": parts[0],
        "app": parts[1],
        "url": url,
    }


def http_remote_path(info: dict[str, Any], *parts: str) -> str:
    quoted = [urllib.parse.quote(str(part), safe="") for part in [info["org"], info["app"], *parts]]
    return f"{info['endpoint']}/v1/projects/" + "/".join(quoted)


def http_json(method: str, url: str, payload: dict[str, Any] | None = None) -> dict[str, Any]:
    data = None if payload is None else canonical_json(payload)
    request = urllib.request.Request(url, data=data, method=method)
    request.add_header("Content-Type", "application/json")
    context = None
    if url.startswith("https://") and os.environ.get("CODEFIRE_TLS_INSECURE") in {"1", "true", "yes"}:
        context = ssl._create_unverified_context()
    try:
        with urllib.request.urlopen(request, timeout=10, context=context) as response:
            body = response.read().decode("utf-8")
    except urllib.error.HTTPError as exc:
        body = exc.read().decode("utf-8", errors="replace")
        try:
            detail = json.loads(body).get("error", body)
        except json.JSONDecodeError:
            detail = body
        raise CFError(f"HTTP remote error: {detail}") from exc
    if not body:
        return {}
    return json.loads(body)


