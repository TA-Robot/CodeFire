def ruby_block_delta(line: str) -> int:
    stripped = line.strip()
    if not stripped or stripped.startswith("#"):
        return 0
    opens = 0
    if re.match(r"^(class|module|def|if|unless|case|while|until|for|begin)\b", stripped):
        opens += 1
    if re.search(r"\bdo\b(?:\s*\|[^|]*\|)?\s*(?:#.*)?$", stripped):
        opens += 1
    closes = 1 if re.match(r"^end\b", stripped) else 0
    return opens - closes


def ruby_block_end(lines: list[str], start: int) -> int:
    depth = 0
    for j in range(start, len(lines)):
        depth += ruby_block_delta(lines[j])
        if j > start and depth <= 0:
            return j + 1
    return len(lines)


