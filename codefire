    refs.extend(
        (f"pending_transaction object_root {index}", root)
        for index, root in enumerate(remote_pending_object_roots(project_root))
    )
    return refs


class AccountedDoctorPayload(dict[str, Any]):
    """A doctor result whose retained-byte ownership follows its lifetime."""

    def __init__(
        self,
        payload: dict[str, Any],
        ledger: DecisionWorkLedger,
        retained_bytes: int,
    ) -> None:
        super().__init__(payload)
        self._ledger = ledger
        self._retained_bytes = retained_bytes
        self._closed = False

    def close(self) -> None:
        if self._closed:
            return
        self._closed = True
        dict.clear(self)
        if self._retained_bytes:
            self._ledger.release("retained_bytes", self._retained_bytes)
            self._retained_bytes = 0
        if self._ledger.terminal_reason is None:
            self._ledger.terminate("complete")

    def __del__(self) -> None:
        try:
            self.close()
        except Exception:
            pass


def _account_doctor_payload(
    payload: dict[str, Any], ledger: DecisionWorkLedger
) -> AccountedDoctorPayload:
    retained_bytes = canonical_json_size(payload)
    ledger.apply(
        "query",
        acquires={
            "retained_bytes": retained_bytes,
            "temporary_bytes": retained_bytes,
        },
    )
    try:
        accounted = AccountedDoctorPayload(payload, ledger, retained_bytes)
        payload.clear()
    except Exception:
        _clear_doctor_payload_tree(payload)
        ledger.release("retained_bytes", retained_bytes)
        raise
    finally:
        ledger.release("temporary_bytes", retained_bytes)
    return accounted


def _clear_doctor_payload_tree(value: Any) -> None:
    """Clear a failed output graph before releasing its reserved live bytes."""
    if isinstance(value, dict):
        while value:
            _, child = value.popitem()
            _clear_doctor_payload_tree(child)
    elif isinstance(value, list):
        while value:
            _clear_doctor_payload_tree(value.pop())
    elif isinstance(value, tuple):
        for child in value:
            _clear_doctor_payload_tree(child)


def remote_doctor_payload(
    project_root: Path, url: str, *, quick: bool = False
) -> dict[str, Any]:
    doctor_ledger = DecisionWorkLedger(
        DecisionWorkProfile.local_v1(), "remote doctor"
    )
    cleanup: dict[str, Any] = {"session": None}
    transferred = False
    try:
        payload = _remote_doctor_payload(
            project_root,
            url,
            quick=quick,
            doctor_ledger=doctor_ledger,
            cleanup=cleanup,
        )
        transferred = True
        return payload
    finally:
        if not transferred:
            session = cleanup.get("session")
            if session is not None:
                session.close(None)
            retained = doctor_ledger.current.get("retained_bytes", 0)
            if retained:
                doctor_ledger.release("retained_bytes", retained)
            temporary = doctor_ledger.current.get("temporary_bytes", 0)
            if temporary:
                doctor_ledger.release("temporary_bytes", temporary)
            if doctor_ledger.terminal_reason is None:
                doctor_ledger.terminate("corrupt_subject")


class _RemoteDoctorInputOwnership:
    """Drop Doctor input values before releasing their aggregate accounting."""

    def __init__(self, ledger: DecisionWorkLedger) -> None:
        self.ledger = ledger
        self.retained_bytes = 0
        self.values: list[Any] = []
        self.session: Any = None
        self.closed = False

    def adopt(self, value: Any, retained_bytes: int) -> Any:
        self.retained_bytes += retained_bytes
        self.values.append(value)
        return value

    def transfer(self, value: Any) -> None:
        for index, owned in enumerate(self.values):
            if owned is value:
                del self.values[index]
                return
        raise CFError("remote Doctor input ownership is not active")

    def close(self) -> None:
        if self.closed:
            return
        self.closed = True
        for value in reversed(self.values):
            clear = getattr(value, "clear", None)
            if clear is not None:
                clear()
        self.values.clear()
        if self.session is not None:
            self.session.close(None)
            self.session = None
        retained_bytes = self.retained_bytes
        self.retained_bytes = 0
        if retained_bytes:
            self.ledger.release("retained_bytes", retained_bytes)


def _remote_doctor_payload(
    project_root: Path,
    url: str,
    *,
    quick: bool,
    doctor_ledger: DecisionWorkLedger,
    cleanup: dict[str, Any],
) -> AccountedDoctorPayload:
    ownership = _RemoteDoctorInputOwnership(doctor_ledger)
    try:
        return _remote_doctor_payload_owned(
            project_root,
            url,
            quick=quick,
            doctor_ledger=doctor_ledger,
            cleanup=cleanup,
            ownership=ownership,
        )
    finally:
        ownership.close()
        cleanup["session"] = None


def _remote_doctor_payload_owned(
    project_root: Path,
    url: str,
    *,
    quick: bool,
    doctor_ledger: DecisionWorkLedger,
    cleanup: dict[str, Any],
    ownership: _RemoteDoctorInputOwnership,
) -> AccountedDoctorPayload:
    dirs = remote_dirs(project_root)
    project_exists = dirs["project"].exists()
    layout = {
        name: dirs[name].exists()
        for name in ["objects", "branches", "merge_requests", "locks", "idempotency"]
    }
    transport = (
        "https"
        if url.startswith("cf+https://")
        else "http"
        if url.startswith("cf+http://")
        else "file"
    )
    common = {
        "type": "codefire_remote_doctor_report",
        "version": 1,
        "schema": "codefire.remote_doctor.v1",
        "project": url,
        "transport": transport,
        "semantic_profile": CURRENT_SEMANTIC_PROFILE,
        "project_exists": project_exists,
        "layout": layout,
        "checked_objects": 0,
        "branch_count": 0,
        "merge_request_count": 0,
        "object_hash_errors": 0,
        "missing_object_references": 0,
        "invalid_sealed_commit_references": 0,
        "invalid_record_versions": 0,
        "diagnostics_truncated": False,
        "quick": quick,
        "skipped_checks": ["object_hash_and_reference_graph"] if quick else [],
        "issues": [],
    }
    ownership.adopt(common, 0)
    ownership.adopt(layout, 0)
    if not project_exists:
        accounted = _account_doctor_payload(common | {
            "bad_objects": [],
            "missing_objects": [],
            "invalid_sealed_refs": [],
            "invalid_commit_signatures": [],
            "invalid_commit_signature_references": 0,
            "issues": [
                {
                    "kind": "remote_project_missing",
                    "message": "remote project does not exist",
                    "subject": url,
                }
            ],
            "ok": False,
        }, doctor_ledger)
        ownership.transfer(layout)
        return accounted
    issues: list[dict[str, Any]] = []
    ownership.adopt(issues, 0)
    invalid_record_versions = 0
    branch_records: list[tuple[Path, dict[str, Any]]] = []
    merge_request_records: list[tuple[Path, dict[str, Any]]] = []
    ownership.adopt(branch_records, 0)
    ownership.adopt(merge_request_records, 0)
    doctor_session = (
        SealedCommitValidationSession(dirs["objects"], doctor_ledger)
        if dirs["objects"].is_dir()
        else None
    )
    cleanup["session"] = doctor_session
    ownership.session = doctor_session
    branch_paths, branch_paths_retained = accounted_sorted_json_paths(
        dirs["branches"], doctor_ledger
    )
    ownership.adopt(branch_paths, branch_paths_retained)
    merge_request_paths, merge_request_paths_retained = accounted_sorted_json_paths(
        dirs["merge_requests"], doctor_ledger
    )
    ownership.adopt(merge_request_paths, merge_request_paths_retained)
    for path in branch_paths:
        record = None
        try:
            doctor_ledger.apply(
                "graph_discovery",
                charges={"graph_nodes": 1},
                maxima={"maximum_frontier": 1},
                counters={
                    "unique_nodes_discovered": 1,
                    "frontier_insertion_attempts": 1,
                },
            )
            record, retained = read_json_accounted(path, doctor_ledger)
            ownership.adopt(record, retained)
            try:
                validate_persisted_record_version(record, "remote_branch")
            except CFError as exc:
                invalid_record_versions += 1
                issues.append(
                    {
                        "kind": "remote_record_version_unsupported",
                        "message": str(exc),
                        "subject": str(path),
                    }
                )
                continue
            branch_records.append((path, record))
        finally:
            record = None
            path = None
    for path in merge_request_paths:
        record = None
        try:
            doctor_ledger.apply(
                "graph_discovery",
                charges={"graph_nodes": 1},
                maxima={"maximum_frontier": 1},
                counters={
                    "unique_nodes_discovered": 1,
                    "frontier_insertion_attempts": 1,
                },
            )
            record, retained = read_json_accounted(path, doctor_ledger)
            ownership.adopt(record, retained)
            try:
                validate_persisted_record_version(record, "remote_merge_request")
            except CFError as exc:
                invalid_record_versions += 1
                issues.append(
                    {
                        "kind": "remote_record_version_unsupported",
                        "message": str(exc),
                        "subject": str(path),
                    }
                )
                continue
            merge_request_records.append((path, record))
        finally:
            record = None
            path = None
    sealed_refs: list[tuple[str, str]] = []
    for path, branch in branch_records:
        head = branch.get("head")
        if isinstance(head, str):
            sealed_refs.append((f"branch {branch.get('name', path.stem)}", head))
    for path, mr in merge_request_records:
        label = mr.get("mr_id", path.stem)
        for key in ["source_head", "target_head_at_request", "applied_head"]:
            head = mr.get(key)
            if isinstance(head, str):
                sealed_refs.append((f"merge_request {label} {key}", head))
    try:
        pending_roots = remote_pending_object_roots(project_root)
        pending_retained = canonical_json_size(pending_roots)
        doctor_ledger.acquire("retained_bytes", pending_retained, "query")
        ownership.adopt(pending_roots, pending_retained)
        sealed_refs.extend(
            (f"pending_transaction object_root {index}", root)
            for index, root in enumerate(pending_roots)
        )
        refs_retained = canonical_json_size(sealed_refs)
        doctor_ledger.acquire("retained_bytes", refs_retained, "query")
        ownership.adopt(sealed_refs, refs_retained)
        if quick:
            bad_paths = []
            ownership.adopt(bad_paths, 0)
            missing_refs = []
            ownership.adopt(missing_refs, 0)
            invalid_sealed_refs = []
            ownership.adopt(invalid_sealed_refs, 0)
            invalid_signatures = []
            ownership.adopt(invalid_signatures, 0)
        else:
            if doctor_session is None:
                raise CFError("remote object store is unavailable")
            bad_paths = doctor_session.scan_object_hash_errors()
            ownership.adopt(bad_paths, 0)
            missing_refs = doctor_session.missing_references(
                [reference for _, reference in sealed_refs]
            )
            ownership.adopt(missing_refs, 0)
            invalid_sealed_refs = sealed_commit_reference_errors(
                dirs["objects"], sealed_refs, session=doctor_session
            )
            ownership.adopt(invalid_sealed_refs, 0)
            signature_policy, policy_retained = read_json_accounted(
                remote_policy_path(project_root), doctor_ledger, default={}
            )
            ownership.adopt(signature_policy, policy_retained)
            invalid_signatures = remote_commit_signature_errors(
                project_root,
                sealed_refs,
                session=doctor_session,
                policy=signature_policy,
            )
            ownership.adopt(invalid_signatures, 0)
    except (ResourceBudgetExceeded, SealedValidationSubjectChanged):
        raise
    except CFError as exc:
        bad_paths = []
        missing_refs = []
        invalid_sealed_refs = []
        invalid_signatures = []
        issues.append({"kind": "remote_semantic_profile_invalid", "message": str(exc)})
        ownership.adopt(bad_paths, 0)
        ownership.adopt(missing_refs, 0)
        ownership.adopt(invalid_sealed_refs, 0)
        ownership.adopt(invalid_signatures, 0)
    branch_count = len(branch_paths)
    mr_count = len(merge_request_paths)
    checked_objects = (
        0
        if quick or doctor_session is None
        else doctor_session.scanned_object_records
    )
    diagnostics_retained = canonical_json_size(
        [bad_paths, missing_refs, invalid_sealed_refs, invalid_signatures]
    )
    doctor_ledger.acquire("retained_bytes", diagnostics_retained, "query")
    ownership.retained_bytes += diagnostics_retained
    for name, present in layout.items():
        if not present:
            issues.append(
                {
                    "kind": "remote_layout_missing",
                    "message": f"remote layout component is missing: {name}",
                    "subject": name,
                }
            )
    issues.extend(
        {
            "kind": "remote_object_invalid",
            "message": f"invalid object record: {path}",
            "subject": str(path),
        }
        for path in bad_paths
    )
    issues.extend(
        {
            "kind": "remote_object_reference_missing",
            "message": f"missing object reference: {object_id}",
            "subject": object_id,
        }
        for object_id in missing_refs
    )
    issues.extend(
        {
            "kind": "remote_sealed_commit_invalid",
            "message": error,
        }
        for error in invalid_sealed_refs
    )
    issues.extend(
        {
            "kind": "remote_commit_signature_invalid",
            "message": error,
        }
        for error in invalid_signatures
    )
    ok = not (
        bad_paths
        or missing_refs
        or invalid_sealed_refs
        or invalid_signatures
        or issues
    )
    payload = common | {
        "bad_objects": [str(path) for path in bad_paths],
        "missing_objects": missing_refs,
        "invalid_sealed_refs": invalid_sealed_refs,
        "invalid_commit_signatures": invalid_signatures,
        "checked_objects": checked_objects,
        "branch_count": branch_count,
        "merge_request_count": mr_count,
        "object_hash_errors": len(bad_paths),
        "missing_object_references": len(missing_refs),
        "invalid_sealed_commit_references": len(invalid_sealed_refs),
        "invalid_record_versions": invalid_record_versions,
        "invalid_commit_signature_references": len(invalid_signatures),
        "issues": issues[:128],
        "diagnostics_truncated": len(issues) > 128,
        "ok": ok,
    }
    if doctor_session is not None:
        doctor_session.finalize(terminate=False)
    accounted_payload = _account_doctor_payload(payload, doctor_ledger)
    ownership.transfer(layout)
    ownership.transfer(missing_refs)
    ownership.transfer(invalid_sealed_refs)
    ownership.transfer(invalid_signatures)
    return accounted_payload


def print_remote_doctor_payload(payload: dict[str, Any]) -> int:
    try:
        return _print_remote_doctor_payload(payload)
    finally:
        close = getattr(payload, "close", None)
        if close is not None:
            close()


def _print_remote_doctor_payload(payload: dict[str, Any]) -> int:
    print("CodeFire remote doctor")
    print(f"project: {payload['project']}")
    if not payload.get("project_exists"):
        print("project: missing")
        return 1
    for name in ["objects", "branches", "merge_requests"]:
        print(f"{name}: {'ok' if payload.get('layout', {}).get(name) else 'missing'}")
    for path in payload.get("bad_objects", []):
        print(f"bad object: {path}")
    for oid in payload.get("missing_objects", []):
        print(f"missing object: {oid}")
    for err in payload.get("invalid_sealed_refs", []):
        print(f"invalid sealed ref: {err}")
    for err in payload.get("invalid_commit_signatures", []):
        print(f"invalid commit signature: {err}")
    print(f"branches: {payload.get('branch_count', 0)}")
    print(f"merge_requests: {payload.get('merge_request_count', 0)}")
    print(f"object hash errors: {payload.get('object_hash_errors', 0)}")
    print(f"missing object references: {payload.get('missing_object_references', 0)}")
    print(f"invalid sealed commit references: {payload.get('invalid_sealed_commit_references', 0)}")
    print(f"invalid commit signature references: {payload.get('invalid_commit_signature_references', 0)}")
    return 0 if payload.get("ok") else 1


REMOTE_GC_MAX_OBJECTS = 31_744
REMOTE_GC_MANIFEST_RECORDS = 256


def _remote_gc_policy(project_root: Path) -> tuple[dict[str, Any], int, int]:
    policy = read_json(remote_policy_path(project_root), {})
    if not isinstance(policy, dict) or (
        "version" in policy and policy.get("version") != VERSION
    ):
        raise CFError("gc blocked: unknown or malformed policy version")
    gc_policy = policy.get("gc", {})
    if not isinstance(gc_policy, dict):
        raise CFError("gc blocked: malformed gc policy")
    values = []
    for name in ["retention_seconds", "retention_generations"]:
        value = gc_policy.get(name, 0) or 0
        if isinstance(value, bool) or not isinstance(value, int) or value < 0:
            raise CFError(f"gc blocked: {name} must be a non-negative integer")
        values.append(value)
    return policy, values[0], values[1]


def _remote_gc_roots(project_root: Path) -> list[dict[str, str]]:
    roots: list[dict[str, str]] = []
    for kind, directory in [
        ("branch", remote_dirs(project_root)["branches"]),
        ("merge_request", remote_dirs(project_root)["merge_requests"]),
    ]:
        directory_fd = _open_directory_nofollow(directory)
        try:
            names = sorted(os.listdir(directory_fd))
            if len(names) > 10_000:
                raise CFError(f"gc blocked: {kind} authority count exceeds limit")
            for name in names:
                if not name.isascii() or not name.endswith(".json"):
                    raise CFError(f"gc blocked: foreign {kind} authority entry")
                raw = _read_regular_bounded_at(directory_fd, name, 16 * 1024 * 1024)
                try:
                    value = json.loads(raw)
                except (UnicodeDecodeError, json.JSONDecodeError) as exc:
                    raise CFError(f"gc blocked: malformed {kind} authority") from exc
                if not isinstance(value, dict) or value.get("version") != VERSION:
                    raise CFError(f"gc blocked: unknown {kind} authority version")
                if kind == "branch":
                    head = value.get("head")
                    if not isinstance(head, str):
                        raise CFError("gc blocked: branch head is malformed")
                    roots.append(
                        {
                            "kind": "sealed_commit",
                            "id": head,
                            "reason": f"branch:{value.get('name', name[:-5])}",
                        }
                    )
                else:
                    label = str(value.get("mr_id", name[:-5]))
                    for field in ["source_head", "target_head_at_request", "applied_head"]:
                        head = value.get(field)
                        if head is not None:
                            if not isinstance(head, str):
                                raise CFError("gc blocked: merge-request root is malformed")
                            roots.append(
                                {
                                    "kind": "sealed_commit",
                                    "id": head,
                                    "reason": f"merge_request:{label}:{field}",
                                }
                            )
        finally:
            os.close(directory_fd)
    return sorted(roots, key=lambda item: (item["reason"], item["id"]))


def _remote_gc_inventory(
    project_root: Path, allowed_quarantines: set[str] | None = None
) -> list[dict[str, Any]]:
    objects_fd = _open_directory_nofollow(remote_dirs(project_root)["objects"])
    inventory: list[dict[str, Any]] = []
    try:
        actual_subdirs = set(os.listdir(objects_fd))
        if actual_subdirs != set(REMOTE_OBJECT_SUBDIRS):
            raise CFError("gc blocked: unknown or missing object directory")
        for subdir in sorted(REMOTE_OBJECT_SUBDIRS):
            subdir_fd = _open_directory_at(objects_fd, subdir)
            try:
                for name in sorted(os.listdir(subdir_fd)):
                    relative = f"objects/{subdir}/{name}"
                    if allowed_quarantines is not None and relative in allowed_quarantines:
                        continue
                    if len(inventory) >= REMOTE_GC_MAX_OBJECTS:
                        raise CFError("gc blocked: object inventory exceeds bounded limit")
                    if not name.isascii() or not name.endswith(".json"):
                        raise CFError("gc blocked: foreign object-store entry")
                    raw = _read_regular_bounded_at(
                        subdir_fd, name, 64 * 1024 * 1024
                    )
                    metadata = os.stat(
                        name, dir_fd=subdir_fd, follow_symlinks=False
                    )
                    try:
                        record = json.loads(raw)
                    except (UnicodeDecodeError, json.JSONDecodeError) as exc:
                        raise CFError("gc blocked: malformed object JSON") from exc
                    path = project_root / "objects" / subdir / name
                    validate_object_record(record, expected_oid=name[:-5], path=path)
                    payload = record.get("payload")
                    if isinstance(payload, dict) and (
                        "version" in payload and payload.get("version") != VERSION
                    ):
                        raise CFError("gc blocked: unknown object payload version")
                    inventory.append(
                        {
                            "object_id": record["object_id"],
                            "type": record["type"],
                            "path": f"objects/{subdir}/{name}",
                            "record_hash": hashlib.sha256(raw).hexdigest(),
                            "identity": {
                                "device": metadata.st_dev,
                                "inode": metadata.st_ino,
                                "size": metadata.st_size,
                                "mtime_ns": metadata.st_mtime_ns,
                            },
                        }
                    )
            finally:
                os.close(subdir_fd)
    finally:
        os.close(objects_fd)
    return inventory


def _remote_gc_retention_index(
    project_root: Path, current_generation: int | None = None
) -> dict[str, Any] | None:
    project_fd = _open_directory_nofollow(project_root)
    try:
        try:
            raw = _read_regular_bounded_at(
                project_fd, "retention_index.json", 16 * 1024 * 1024
            )
        except FileNotFoundError:
            return None
    finally:
        os.close(project_fd)
    try:
        index = json.loads(raw)
    except (UnicodeDecodeError, json.JSONDecodeError) as exc:
        raise CFError("gc blocked: malformed retention index JSON") from exc
    if (
        not isinstance(index, dict)
        or set(index) != {"type", "version", "objects", "updated_generation"}
        or index.get("type") != "remote_retention_index"
        or index.get("version") != VERSION
        or not isinstance(index.get("objects"), dict)
        or not isinstance(index.get("updated_generation"), int)
        or index.get("updated_generation") < 0
        or len(index.get("objects")) > REMOTE_GC_MAX_OBJECTS
        or (
            current_generation is not None
            and index.get("updated_generation") > current_generation
        )
    ):
        raise CFError("gc blocked: unknown or malformed retention index")
    for oid, entry in index["objects"].items():
        if (
            not isinstance(oid, str)
            or not oid.startswith("CF-")
            or not isinstance(entry, dict)
            or set(entry) != {
                "first_unreachable_generation",
                "last_unreachable_generation",
            }
            or not all(isinstance(value, int) and value >= 0 for value in entry.values())
            or entry["first_unreachable_generation"]
            > entry["last_unreachable_generation"]
            or entry["last_unreachable_generation"]
            > index["updated_generation"]
        ):
            raise CFError("gc blocked: malformed retention index entry")
    return index


def _remote_gc_decide_inventory(
    base_inventory: list[dict[str, Any]],
    reachable: set[str],
    retention_before: dict[str, Any] | None,
    generation: int,
    retention_seconds: int,
    retention_generations: int,
    planned_at_ns: int,
) -> tuple[list[dict[str, Any]], dict[str, Any], list[dict[str, Any]], list[dict[str, Any]]]:
    inventory = [dict(item) for item in base_inventory]
    old_entries = retention_before["objects"] if retention_before else {}
    new_entries: dict[str, Any] = {}
    protected_objects: list[dict[str, Any]] = []
    removed_objects: list[dict[str, Any]] = []
    delete_index = 0
    for item in inventory:
        oid = item["object_id"]
        if oid in reachable:
            item.update(
                decision="reachable", reason="root_reachable", delete_index=None
            )
            continue
        entry = old_entries.get(oid)
        first_generation = (
            entry.get("first_unreachable_generation")
            if isinstance(entry, dict)
            else generation
        )
        age_protected = retention_seconds > 0 and (
            planned_at_ns - item["identity"]["mtime_ns"]
        ) < retention_seconds * 1_000_000_000
        generation_protected = retention_generations > 0 and (
            generation - first_generation <= retention_generations
        )
        summary = {
            "object_id": oid,
            "type": item["type"],
            "path": item["path"],
            "first_unreachable_generation": first_generation,
        }
        if age_protected or generation_protected:
            item.update(
                decision="protected",
                reason=(
                    "retention_seconds"
                    if age_protected
                    else "retention_generations"
                ),
                delete_index=None,
            )
            new_entries[oid] = {
                "first_unreachable_generation": first_generation,
                "last_unreachable_generation": generation,
            }
            protected_objects.append(summary)
        else:
            item.update(
                decision="delete",
                reason="unreachable_retention_expired",
                delete_index=delete_index,
            )
            delete_index += 1
            removed_objects.append(summary)
    retention_after = {
        "type": "remote_retention_index",
        "version": VERSION,
        "objects": dict(sorted(new_entries.items())),
        "updated_generation": generation,
    }
    return inventory, retention_after, protected_objects, removed_objects


def _remote_gc_prepare_plan(
    project_root: Path,
    project: dict[str, Any],
    actor: str,
    dry_run: bool,
) -> dict[str, Any]:
    policy, retention_seconds, retention_generations = _remote_gc_policy(project_root)
    roots = _remote_gc_roots(project_root)
    root_ids = [root["id"] for root in roots]
    missing_refs = object_graph_missing_references(
        remote_dirs(project_root)["objects"], root_ids
    )
    if missing_refs:
        raise CFError(f"gc blocked: missing object references: {len(missing_refs)}")
    invalid_sealed_refs = sealed_commit_reference_errors(
        remote_dirs(project_root)["objects"],
        [(root["reason"], root["id"]) for root in roots],
    )
    if invalid_sealed_refs:
        raise CFError(
            f"gc blocked: invalid sealed commit references: {len(invalid_sealed_refs)}"
        )
    invalid_signatures = remote_commit_signature_errors(
        project_root, [(root["reason"], root["id"]) for root in roots]
    )
    if invalid_signatures:
        raise CFError(f"gc blocked: invalid commit signatures: {len(invalid_signatures)}")
    reachable: set[str] = set()
    stack = root_ids[:]
    objects_root = remote_dirs(project_root)["objects"]
    while stack:
        oid = stack.pop()
        if oid in reachable:
            continue
        reachable.add(oid)
        stack.extend(object_record_references(load_object_record_from_root(objects_root, oid)))
    base_inventory = _remote_gc_inventory(project_root)
    generation = current_remote_generation(project_root)
    retention_before = _remote_gc_retention_index(project_root, generation)
    now_ns = time.time_ns()
    inventory, retention_after, protected_objects, removed_objects = (
        _remote_gc_decide_inventory(
            base_inventory,
            reachable,
            retention_before,
            generation,
            retention_seconds,
            retention_generations,
            now_ns,
        )
    )
    plan_id = f"GC-{secrets.token_hex(16)}"
    created_at = now_iso()
    audit = {
        "type": "gc_audit",
        "version": VERSION,
        "plan_id": plan_id,
        "stable_project_id": remote_project_stable_id(project_root),
        "project": project,
        "actor": actor,
        "dry_run": bool(dry_run),
        "policy_digest": _remote_json_hash(policy),
        "retention_seconds": retention_seconds,
        "retention_generations": retention_generations,
        "current_generation": generation,
        "root_fingerprint": _remote_json_hash(roots),
        "inventory_fingerprint": _remote_json_hash(inventory),
        "reachable_objects": len(reachable),
        "objects_protected": len(protected_objects),
        "objects_removed": len(removed_objects),
        "removed_objects": removed_objects,
        "protected_objects": protected_objects,
        "created_at": created_at,
        "created_at_ns": now_ns,
    }
    return {
        "plan_id": plan_id,
        "created_at": created_at,
        "planned_at_ns": now_ns,
        "policy": policy,
        "roots": roots,
        "inventory": inventory,
        "retention_before": retention_before,
        "retention_after": retention_after,
        "audit": audit,
    }


def _remote_gc_stage_plan(
    project_root: Path, actor: str, dry_run: bool, plan: dict[str, Any]
) -> dict[str, Any]:
    transaction_id = f"GC-TX-{secrets.token_hex(16)}"
    transaction_dir = remote_dirs(project_root)["transactions"] / transaction_id
    transaction_dir.mkdir(mode=0o700)
    _sync_directory(transaction_dir.parent)
    stages: list[dict[str, Any]] = []
    chunks = [
        plan["inventory"][index : index + REMOTE_GC_MANIFEST_RECORDS]
        for index in range(0, len(plan["inventory"]), REMOTE_GC_MANIFEST_RECORDS)
    ] or [[]]
    payloads = [
        (
            f"manifest-{index:04d}.json",
            {
                "type": "remote_gc_inventory_manifest",
                "version": VERSION,
                "index": index,
                "records": chunk,
            },
        )
        for index, chunk in enumerate(chunks)
    ]
    payloads.extend(
        [
            ("roots.json", {"type": "remote_gc_roots", "version": VERSION, "roots": plan["roots"]}),
            (
                "retention-before.json",
                {
                    "type": "remote_gc_retention_preimage",
                    "version": VERSION,
                    "value": plan["retention_before"],
                },
            ),
            ("retention.json", plan["retention_after"]),
            ("audit.json", plan["audit"]),
        ]
    )
    try:
        for name, value in payloads:
            raw = canonical_json(value)
            fd = os.open(
                transaction_dir / name,
                os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW,
                0o600,
            )
            try:
                _write_all_fd(fd, raw)
                os.fsync(fd)
            finally:
                os.close(fd)
            stages.append(
                {"name": name, "hash": hashlib.sha256(raw).hexdigest(), "size": len(raw)}
            )
        _sync_directory(transaction_dir)
        request_hash = _remote_json_hash(
            {
                "type": "remote_gc_request",
                "version": VERSION,
                "stable_project_id": remote_project_stable_id(project_root),
                "actor": actor,
                "dry_run": bool(dry_run),
            }
        )
        plan_fingerprint = _remote_json_hash(
            {
                "policy": plan["policy"],
                "roots": plan["roots"],
                "inventory": plan["inventory"],
                "retention_before": plan["retention_before"],
                "retention_after": plan["retention_after"],
                "audit": plan["audit"],
            }
        )
        retention_before_hash = (
            None
            if plan["retention_before"] is None
            else _remote_json_hash(plan["retention_before"])
        )
        pending = {
            "type": "remote_gc_transaction",
            "version": VERSION,
            "status": "pending",
            "phase": "deleting",
            "operation": "remote_gc",
            "transaction_id": transaction_id,
            "plan_id": plan["plan_id"],
            "actor": actor,
            "dry_run": bool(dry_run),
            "request_hash": request_hash,
            "plan_fingerprint": plan_fingerprint,
            "policy_digest": _remote_json_hash(plan["policy"]),
            "generation": plan["audit"]["current_generation"],
            "root_fingerprint": plan["audit"]["root_fingerprint"],
            "inventory_fingerprint": plan["audit"]["inventory_fingerprint"],
            "retention_before_hash": retention_before_hash,
            "retention_plan_hash": _remote_json_hash(plan["retention_after"]),
            "retention_after_hash": retention_before_hash
            if dry_run
            else _remote_json_hash(plan["retention_after"]),
            "retention_published": False,
            "candidate_count": plan["audit"]["objects_removed"],
            "deleted_count": 0,
            "audit_published": False,
            "stages": stages,
            "created_at": plan["created_at"],
            "planned_at_ns": plan["planned_at_ns"],
        }
        project_fd = _open_directory_nofollow(project_root)
        try:
            _write_create_noreplace_at(
                project_fd, "pending_transaction.json", canonical_json(pending)
            )
        finally:
            os.close(project_fd)
        return pending
    except Exception:
        if not (project_root / "pending_transaction.json").exists():
            shutil.rmtree(transaction_dir, ignore_errors=True)
        raise


def _remote_gc_load_stages(
    project_root: Path, pending: dict[str, Any]
) -> tuple[
    list[dict[str, Any]],
    list[dict[str, str]],
    dict[str, Any] | None,
    dict[str, Any],
    dict[str, Any],
]:
    transaction_id = pending["transaction_id"]
    expected = pending.get("stages")
    if not isinstance(expected, list) or not expected or len(expected) > 128:
        raise CFError("gc pending stage set is malformed")
    names = remote_transaction_entry_names(project_root, transaction_id)
    if names is None or names != {stage.get("name") for stage in expected if isinstance(stage, dict)}:
        raise CFError("gc pending staging set diverged")
    inventory: list[dict[str, Any]] = []
    roots = retention_before_marker = retention = audit = None
    for stage in expected:
        if (
            not isinstance(stage, dict)
            or set(stage) != {"name", "hash", "size"}
            or not isinstance(stage.get("name"), str)
            or not isinstance(stage.get("hash"), str)
            or not isinstance(stage.get("size"), int)
        ):
            raise CFError("gc pending stage descriptor is malformed")
        raw = read_remote_transaction_stage(project_root, transaction_id, stage["name"])
        if len(raw) != stage["size"] or hashlib.sha256(raw).hexdigest() != stage["hash"]:
            raise CFError("gc staged manifest diverged")
        value = json.loads(raw)
        if stage["name"].startswith("manifest-"):
            if value.get("type") != "remote_gc_inventory_manifest" or value.get("version") != VERSION:
                raise CFError("gc inventory manifest is malformed or future")
            inventory.extend(value.get("records", []))
        elif stage["name"] == "roots.json":
            roots = value.get("roots") if value.get("type") == "remote_gc_roots" and value.get("version") == VERSION else None
        elif stage["name"] == "retention-before.json":
            retention_before_marker = value
        elif stage["name"] == "retention.json":
            retention = value
        elif stage["name"] == "audit.json":
            audit = value
        else:
            raise CFError("gc pending contains a foreign stage")
    if (
        not isinstance(roots, list)
        or not isinstance(retention_before_marker, dict)
        or set(retention_before_marker) != {"type", "version", "value"}
        or retention_before_marker.get("type") != "remote_gc_retention_preimage"
        or retention_before_marker.get("version") != VERSION
        or (
            retention_before_marker.get("value") is not None
            and not isinstance(retention_before_marker.get("value"), dict)
        )
        or not isinstance(retention, dict)
        or not isinstance(audit, dict)
    ):
        raise CFError("gc staged plan is incomplete")
    return inventory, roots, retention_before_marker["value"], retention, audit


def _remote_gc_delete_candidate(
    project_root: Path, plan_id: str, item: dict[str, Any]
) -> bool:
    parts = Path(item["path"]).parts
    if len(parts) != 3 or parts[0] != "objects" or parts[1] not in REMOTE_OBJECT_SUBDIRS:
        raise CFError("gc candidate path is not contained")
    objects_fd = _open_directory_nofollow(remote_dirs(project_root)["objects"])
    subdir_fd = -1
    try:
        subdir_fd = _open_directory_at(objects_fd, parts[1])
        quarantine = f".{parts[2]}.gc-removing-{plan_id}"
        original_exists = _entry_exists_at(subdir_fd, parts[2])
        quarantine_exists = _entry_exists_at(subdir_fd, quarantine)
        if original_exists and quarantine_exists:
            raise CFError("gc candidate and quarantine both exist")
        if not original_exists and not quarantine_exists:
            return False
        name = quarantine if quarantine_exists else parts[2]
        raw = _read_regular_bounded_at(subdir_fd, name, 64 * 1024 * 1024)
        metadata = os.stat(name, dir_fd=subdir_fd, follow_symlinks=False)
        identity = item["identity"]
        actual_identity = {
            "device": metadata.st_dev,
            "inode": metadata.st_ino,
            "size": metadata.st_size,
            "mtime_ns": metadata.st_mtime_ns,
        }
        if actual_identity != identity or hashlib.sha256(raw).hexdigest() != item["record_hash"]:
            raise CFError("gc candidate identity or record hash diverged")
        if original_exists:
            _rename_directory_noreplace_at(subdir_fd, parts[2], quarantine)
            os.fsync(subdir_fd)
            quarantined_raw = _read_regular_bounded_at(
                subdir_fd, quarantine, 64 * 1024 * 1024
            )
            quarantined_metadata = os.stat(
                quarantine, dir_fd=subdir_fd, follow_symlinks=False
            )
            quarantined_identity = {
                "device": quarantined_metadata.st_dev,
                "inode": quarantined_metadata.st_ino,
                "size": quarantined_metadata.st_size,
                "mtime_ns": quarantined_metadata.st_mtime_ns,
            }
            if (
                quarantined_identity != identity
                or hashlib.sha256(quarantined_raw).hexdigest()
                != item["record_hash"]
            ):
                raise CFError("gc quarantined candidate identity diverged")
        os.unlink(quarantine, dir_fd=subdir_fd)
        os.fsync(subdir_fd)
        return True
    finally:
        if subdir_fd >= 0:
            os.close(subdir_fd)
        os.close(objects_fd)


def _remote_gc_refresh_jsonl(project_root: Path) -> None:
    gc_fd = _open_directory_nofollow(remote_dirs(project_root)["gc"])
    audit_fd = _open_directory_nofollow(remote_dirs(project_root)["audit"])
    try:
        records: list[dict[str, Any]] = []
        for name in sorted(os.listdir(gc_fd)):
            if not name.endswith(".json"):
                raise CFError("foreign exact GC audit entry is preserved")
            value = json.loads(_read_regular_bounded_at(gc_fd, name, 64 * 1024 * 1024))
            if value.get("type") != "gc_audit" or value.get("version") != VERSION:
                raise CFError("unknown exact GC audit version")
            records.append(value)
        records.sort(
            key=lambda value: (
                int(value.get("created_at_ns", 0)),
                str(value.get("plan_id", "")),
            )
        )
        lines = [canonical_json(value).decode("utf-8") for value in records]
        payload = ("\n".join(lines) + ("\n" if lines else "")).encode("utf-8")
        _write_atomic_durable_at(audit_fd, "gc.jsonl", payload)
    finally:
        os.close(audit_fd)
        os.close(gc_fd)


def _remote_gc_completed_cleanup(
    project_root: Path, pending: dict[str, Any]
) -> dict[str, Any]:
    expected_deleted = 0 if pending.get("dry_run") is True else pending.get("candidate_count")
    if (
        pending.get("deleted_count") != expected_deleted
        or pending.get("retention_published") is not True
        or pending.get("audit_published") is not True
    ):
        raise CFError("completed GC transaction has incomplete durable progress")
    plan_id = pending["plan_id"]
    audit_name = f"{plan_id}.json"
    gc_fd = _open_directory_nofollow(remote_dirs(project_root)["gc"])
    try:
        audit_raw = _read_regular_bounded_at(
            gc_fd, audit_name, 64 * 1024 * 1024
        )
    finally:
        os.close(gc_fd)
    audit_stage = next(
        (
            stage
            for stage in pending["stages"]
            if isinstance(stage, dict) and stage.get("name") == "audit.json"
        ),
        None,
    )
    if (
        not isinstance(audit_stage, dict)
        or hashlib.sha256(audit_raw).hexdigest() != audit_stage.get("hash")
    ):
        raise CFError("completed GC exact audit diverged from its staged hash")
    audit = json.loads(audit_raw)
    if (
        audit.get("type") != "gc_audit"
        or audit.get("version") != VERSION
        or audit.get("plan_id") != plan_id
    ):
        raise CFError("completed GC exact audit is malformed or future")
    retention = _remote_gc_retention_index(project_root, pending.get("generation"))
    retention_hash = None if retention is None else _remote_json_hash(retention)
    if retention_hash != pending["retention_after_hash"]:
        raise CFError("completed GC retention authority diverged")
    transaction_id = pending["transaction_id"]
    expected = {
        stage.get("name"): stage
        for stage in pending["stages"]
        if isinstance(stage, dict) and isinstance(stage.get("name"), str)
    }
    if len(expected) != len(pending["stages"]):
        raise CFError("completed GC stage descriptors are malformed")
    actual = remote_transaction_entry_names(project_root, transaction_id)
    if actual is not None:
        if not actual.issubset(set(expected)):
            raise CFError("completed GC staging contains foreign entries")
        for name in sorted(actual):
            raw = read_remote_transaction_stage(project_root, transaction_id, name)
            stage = expected[name]
            if (
                len(raw) != stage.get("size")
                or hashlib.sha256(raw).hexdigest() != stage.get("hash")
            ):
                raise CFError("completed GC staged cleanup content diverged")
            remove_remote_transaction_stage(
                project_root, transaction_id, name, raw
            )
        remove_empty_remote_transaction_dir(project_root, transaction_id)
    else:
        remove_remote_transaction_dir_quarantine(project_root, transaction_id)
    pending_path = project_root / "pending_transaction.json"
    if read_json(pending_path) != pending:
        raise CFError("completed GC pending marker changed before release")
    pending_path.unlink()
    _sync_directory(project_root)
    _remote_gc_refresh_jsonl(project_root)
    return {
        "reachable_objects": audit["reachable_objects"],
        "objects_protected": audit["objects_protected"],
        "objects_removed": audit["objects_removed"],
        "audit_log": "audit/gc.jsonl",
        "would_remove": [item["object_id"] for item in audit["removed_objects"]]
        if audit["dry_run"]
        else [],
    }


def _remote_gc_resume(
    project_root: Path, actor: str, dry_run: bool, pending: dict[str, Any]
) -> dict[str, Any]:
    expected_fields = {
        "type", "version", "status", "phase", "operation", "transaction_id",
        "plan_id", "actor", "dry_run", "request_hash", "policy_digest", "generation",
        "plan_fingerprint", "root_fingerprint", "inventory_fingerprint",
        "retention_before_hash", "retention_plan_hash", "retention_after_hash",
        "retention_published", "candidate_count", "deleted_count",
        "audit_published", "stages", "created_at", "planned_at_ns",
    }
    if pending.get("status") == "completed":
        expected_fields.add("completed_at")
    request_hash = _remote_json_hash(
        {
            "type": "remote_gc_request", "version": VERSION,
            "stable_project_id": remote_project_stable_id(project_root),
            "actor": actor, "dry_run": bool(dry_run),
        }
    )
    if (
        set(pending) != expected_fields
        or pending.get("type") != "remote_gc_transaction"
        or pending.get("version") != VERSION
        or pending.get("operation") != "remote_gc"
        or pending.get("actor") != actor
        or pending.get("dry_run") is not bool(dry_run)
        or pending.get("request_hash") != request_hash
        or (pending.get("status"), pending.get("phase"))
        not in {("pending", "deleting"), ("completed", "completed")}
    ):
        raise CFError("foreign, future, or different GC transaction is preserved")
    transaction_id = pending.get("transaction_id")
    plan_id = pending.get("plan_id")
    planned_at_ns = pending.get("planned_at_ns")
    if (
        not isinstance(transaction_id, str)
        or not isinstance(plan_id, str)
        or isinstance(planned_at_ns, bool)
        or not isinstance(planned_at_ns, int)
        or planned_at_ns < 0
        or planned_at_ns > time.time_ns()
    ):
        raise CFError("gc pending identity is malformed")
    validate_remote_component(transaction_id, "transaction ID")
    validate_remote_component(plan_id, "GC plan ID")
    if pending.get("status") == "completed":
        return _remote_gc_completed_cleanup(project_root, pending)
    inventory, roots, retention_before, retention_after, audit = (
        _remote_gc_load_stages(project_root, pending)
    )
    if len(inventory) > REMOTE_GC_MAX_OBJECTS or _remote_json_hash(inventory) != pending["inventory_fingerprint"]:
        raise CFError("gc inventory manifest fingerprint diverged")
    if _remote_json_hash(roots) != pending["root_fingerprint"]:
        raise CFError("gc root manifest fingerprint diverged")
    policy, retention_seconds, retention_generations = _remote_gc_policy(
        project_root
    )
    if _remote_json_hash(policy) != pending["policy_digest"]:
        raise CFError("gc policy changed while a plan is pending")
    if current_remote_generation(project_root) != pending["generation"]:
        raise CFError("gc generation changed while a plan is pending")
    if _remote_json_hash(_remote_gc_roots(project_root)) != pending["root_fingerprint"]:
        raise CFError("gc roots changed while a plan is pending")
    if _remote_json_hash(retention_after) != pending["retention_plan_hash"]:
        raise CFError("gc retention postimage diverged")
    retention_before_hash = (
        None
        if retention_before is None
        else _remote_json_hash(retention_before)
    )
    if retention_before_hash != pending["retention_before_hash"]:
        raise CFError("gc retention preimage manifest diverged")
    current_roots = _remote_gc_roots(project_root)
    reachable: set[str] = set()
    stack = [root["id"] for root in current_roots]
    objects_root = remote_dirs(project_root)["objects"]
    while stack:
        oid = stack.pop()
        if oid in reachable:
            continue
        reachable.add(oid)
        stack.extend(object_record_references(load_object_record_from_root(objects_root, oid)))
    base_fields = {"object_id", "type", "path", "record_hash", "identity"}
    decision_fields = base_fields | {"decision", "reason", "delete_index"}
    if any(not isinstance(item, dict) or set(item) != decision_fields for item in inventory):
        raise CFError("gc inventory decision record is malformed")
    expected_inventory, expected_retention, protected_objects, removed_objects = (
        _remote_gc_decide_inventory(
            [{key: item[key] for key in base_fields} for item in inventory],
            reachable,
            retention_before,
            pending["generation"],
            retention_seconds,
            retention_generations,
            pending["planned_at_ns"],
        )
    )
    if inventory != expected_inventory or retention_after != expected_retention:
        raise CFError("gc staged decisions do not match the canonical planner")
    audit_fields = {
        "type", "version", "plan_id", "stable_project_id", "project", "actor",
        "dry_run", "policy_digest", "retention_seconds", "retention_generations",
        "current_generation", "root_fingerprint", "inventory_fingerprint",
        "reachable_objects", "objects_protected", "objects_removed",
        "removed_objects", "protected_objects", "created_at", "created_at_ns",
    }
    expected_audit_values = {
        "type": "gc_audit",
        "version": VERSION,
        "plan_id": plan_id,
        "stable_project_id": remote_project_stable_id(project_root),
        "actor": actor,
        "dry_run": bool(dry_run),
        "policy_digest": pending["policy_digest"],
        "retention_seconds": retention_seconds,
        "retention_generations": retention_generations,
        "current_generation": pending["generation"],
        "root_fingerprint": pending["root_fingerprint"],
        "inventory_fingerprint": pending["inventory_fingerprint"],
        "reachable_objects": len(reachable),
        "objects_protected": len(protected_objects),
        "objects_removed": len(removed_objects),
        "removed_objects": removed_objects,
        "protected_objects": protected_objects,
        "created_at": pending["created_at"],
        "created_at_ns": pending["planned_at_ns"],
    }
    if (
        not isinstance(audit, dict)
        or set(audit) != audit_fields
        or not isinstance(audit.get("project"), dict)
        or any(audit.get(key) != value for key, value in expected_audit_values.items())
    ):
        raise CFError("gc staged audit does not match the canonical planner")
    recomputed_plan_fingerprint = _remote_json_hash(
        {
            "policy": policy,
            "roots": roots,
            "inventory": inventory,
            "retention_before": retention_before,
            "retention_after": retention_after,
            "audit": audit,
        }
    )
    if recomputed_plan_fingerprint != pending["plan_fingerprint"]:
        raise CFError("gc plan fingerprint diverged")
    allowed_quarantines = {
        f"objects/{Path(item['path']).parts[1]}/.{Path(item['path']).name}.gc-removing-{plan_id}"
        for item in expected_inventory
        if item["decision"] == "delete"
    }
    current_inventory = {
        item["path"]: item
        for item in _remote_gc_inventory(project_root, allowed_quarantines)
    }
    initial_paths = {item["path"] for item in inventory}
    if not set(current_inventory).issubset(initial_paths):
        raise CFError("gc object inventory gained a foreign entry")
    deleted_count = pending.get("deleted_count")
    candidate_count = pending.get("candidate_count")
    if (
        not isinstance(deleted_count, int) or not isinstance(candidate_count, int)
        or deleted_count < 0 or deleted_count > candidate_count
    ):
        raise CFError("gc deletion progress is malformed")
    candidates = sorted(
        (item for item in inventory if item.get("decision") == "delete"),
        key=lambda item: item.get("delete_index", -1),
    )
    if len(candidates) != candidate_count or [item.get("delete_index") for item in candidates] != list(range(candidate_count)):
        raise CFError("gc candidate order is malformed")
    for item in inventory:
        current = current_inventory.get(item["path"])
        index = item.get("delete_index")
        may_be_absent = (
            not dry_run and item.get("decision") == "delete"
            and isinstance(index, int) and index <= deleted_count
        )
        if current is None and not may_be_absent:
            raise CFError("gc inventory entry disappeared outside recorded progress")
        if current is not None and (
            current["record_hash"] != item.get("record_hash")
            or current["identity"] != item.get("identity")
        ):
            raise CFError("gc inventory identity diverged")
        if isinstance(index, int) and index < deleted_count and current is not None:
            raise CFError("gc recorded deletion is still present")
    retention_path = project_root / "retention_index.json"
    current_retention = _remote_gc_retention_index(
        project_root, pending["generation"]
    )
    current_retention_hash = None if current_retention is None else _remote_json_hash(current_retention)
    if not pending["retention_published"]:
        if dry_run:
            if current_retention_hash != pending["retention_before_hash"]:
                raise CFError("dry-run GC retention authority changed")
        elif current_retention_hash == pending["retention_before_hash"]:
            write_remote_publication_json_durable(retention_path, retention_after)
        elif current_retention_hash != pending["retention_after_hash"]:
            raise CFError("gc retention authority diverged at publication boundary")
        pending["retention_published"] = True
        write_remote_publication_json_durable(project_root / "pending_transaction.json", pending)
    elif current_retention_hash != pending["retention_after_hash"]:
        raise CFError("gc retention authority diverged after publication")
    if not dry_run:
        for item in candidates[deleted_count:]:
            _remote_gc_delete_candidate(project_root, plan_id, item)
            deleted_count += 1
            pending["deleted_count"] = deleted_count
            write_remote_publication_json_durable(project_root / "pending_transaction.json", pending)
    elif deleted_count != 0:
        raise CFError("dry-run GC recorded deletion progress")
    audit_path = remote_dirs(project_root)["gc"] / f"{plan_id}.json"
    audit_raw = canonical_json(audit)
    gc_fd = _open_directory_nofollow(remote_dirs(project_root)["gc"])
    try:
        try:
            _write_create_noreplace_at(gc_fd, f"{plan_id}.json", audit_raw)
        except FileExistsError:
            if _read_regular_bounded_at(gc_fd, f"{plan_id}.json", 64 * 1024 * 1024) != audit_raw:
                raise CFError("exact GC audit authority diverged")
    finally:
        os.close(gc_fd)
    if not pending["audit_published"]:
        pending["audit_published"] = True
        write_remote_publication_json_durable(project_root / "pending_transaction.json", pending)
    if pending["status"] != "completed":
        pending["status"] = "completed"
        pending["phase"] = "completed"
        pending["completed_at"] = now_iso()
        write_remote_publication_json_durable(project_root / "pending_transaction.json", pending)
    for stage in pending["stages"]:
        raw = read_remote_transaction_stage(project_root, transaction_id, stage["name"])
        remove_remote_transaction_stage(project_root, transaction_id, stage["name"], raw)
    remove_empty_remote_transaction_dir(project_root, transaction_id)
    current_pending = read_json(project_root / "pending_transaction.json")
    if current_pending != pending:
        raise CFError("gc pending transaction changed before release")
    os.unlink(project_root / "pending_transaction.json")
    _sync_directory(project_root)
    _remote_gc_refresh_jsonl(project_root)
    return {
        "reachable_objects": audit["reachable_objects"],
        "objects_protected": audit["objects_protected"],
        "objects_removed": audit["objects_removed"],
        "audit_log": (remote_dirs(project_root)["audit"] / "gc.jsonl")
        .relative_to(project_root)
        .as_posix(),
        "would_remove": [item["object_id"] for item in audit["removed_objects"]] if dry_run else [],
    }


def remote_gc_payload(project_root: Path, project: dict[str, Any], actor: str, dry_run: bool) -> dict[str, Any]:
    dirs = remote_dirs(project_root)
    with remote_project_gate(project_root), stable_remote_lock(dirs["locks"] / "gc.lock"):
        recover_remote_pending_quarantine(project_root)
        pending = read_json(project_root / "pending_transaction.json")
        if pending is None:
            plan = _remote_gc_prepare_plan(project_root, project, actor, dry_run)
            pending = _remote_gc_stage_plan(project_root, actor, dry_run, plan)
        if not isinstance(pending, dict):
            raise CFError("foreign or malformed remote pending transaction is preserved")
        return _remote_gc_resume(project_root, actor, dry_run, pending)


def sealed_commit_reference_errors(
    objects_root: Path,
    refs: list[tuple[str, str]],
    *,
    session: Any = None,
) -> list[str]:
    errors = []
    owns_session = session is None
    if session is None:
        ledger = DecisionWorkLedger(
            DecisionWorkProfile.local_v1(), "sealed reference validation"
        )
        session = SealedCommitValidationSession(objects_root, ledger)
    else:
        ledger = session.ledger
    error_output_bytes = 0
    try:
        for label, commit_id in refs:
            try:
                session.validate_commit(commit_id)
            except (ResourceBudgetExceeded, SealedValidationSubjectChanged):
                raise
            except CFError as exc:
                error_bytes = (
                    len(label.encode("utf-8"))
                    + len(commit_id.encode("utf-8"))
                    + len(str(exc).encode("utf-8"))
                    + 68
                )
                ledger.acquire("retained_bytes", error_bytes, "query")
                session.adopt_aux_retained(error_bytes)
                error_output_bytes += error_bytes
                errors.append(f"{label}: {commit_id}: {exc}")
        if owns_session:
            session.finalize(terminate=False)
        sort_scratch = error_output_bytes + 8 * len(errors)
        ledger.acquire("temporary_bytes", sort_scratch, "query")
        try:
            result = sorted(errors)
        finally:
            ledger.release("temporary_bytes", sort_scratch)
        if owns_session:
            ledger.terminate("complete")
        return result
    finally:
        if owns_session:
            session.close(None)


