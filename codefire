def _fd_identity(fd: int) -> tuple[int, int]:
    metadata = os.fstat(fd)
    return metadata.st_dev, metadata.st_ino


@contextlib.contextmanager
def remote_project_gate(project_root: Path, *, shared: bool = False):
    """Lock and revalidate one pinned project/descriptor/locks capability set."""
    project_fd = _open_directory_nofollow(project_root)
    locks_fd = rebound_fd = rebound_locks_fd = -1
    try:
        project_identity = _fd_identity(project_fd)
        descriptor = _read_regular_bounded_at(project_fd, "remote_project.json", 16 * 1024)
        descriptor_identity = os.stat(
            "remote_project.json", dir_fd=project_fd, follow_symlinks=False
        )
        descriptor_key = (descriptor_identity.st_dev, descriptor_identity.st_ino)
        locks_fd = _open_directory_at(project_fd, "locks")
        locks_identity = _fd_identity(locks_fd)
        with stable_remote_lock(
            project_root / "locks" / "project-gate.lock",
            shared=shared,
            directory_fd=locks_fd,
        ):
            rebound_fd = _open_directory_nofollow(project_root)
            if _fd_identity(rebound_fd) != project_identity:
                raise CFError(f"remote project root changed while acquiring its gate: {project_root}")
            rebound_locks_fd = _open_directory_at(project_fd, "locks")
            if _fd_identity(rebound_locks_fd) != locks_identity:
                raise CFError(f"remote project locks directory changed: {project_root}")
            current_descriptor = _read_regular_bounded_at(
                project_fd, "remote_project.json", 16 * 1024
            )
            current_metadata = os.stat(
                "remote_project.json", dir_fd=project_fd, follow_symlinks=False
            )
            if (
                (current_metadata.st_dev, current_metadata.st_ino) != descriptor_key
                or current_descriptor != descriptor
            ):
                raise CFError(f"remote project descriptor changed: {project_root}")
            if shared:
                try:
                    pending_raw = _read_regular_bounded_at(
                        project_fd, "pending_transaction.json", 1024 * 1024
                    )
                except FileNotFoundError:
                    pending_raw = None
                if pending_raw is not None:
                    try:
                        pending = json.loads(pending_raw)
                    except (UnicodeDecodeError, json.JSONDecodeError) as exc:
                        raise CFError(
                            "remote read blocked by a malformed pending transaction"
                        ) from exc
                    known = (
                        isinstance(pending, dict)
                        and pending.get("version") == VERSION
                        and pending.get("type")
                        in {
                            "remote_publication_transaction",
                            "remote_gc_transaction",
                        }
                    )
                    if not known:
                        raise CFError(
                            "remote read blocked by a foreign or future pending transaction"
                        )
                    raise CFError(
                        "remote read blocked by pending transaction "
                        f"{pending.get('transaction_id', '(unknown)')}"
                    )
            os.close(rebound_locks_fd)
            rebound_locks_fd = -1
            os.close(rebound_fd)
            rebound_fd = -1
            try:
                yield
            finally:
                rebound_fd = _open_directory_nofollow(project_root)
                if _fd_identity(rebound_fd) != project_identity:
                    raise CFError(
                        f"remote project root changed while holding its gate: {project_root}"
                    )
                rebound_locks_fd = _open_directory_at(project_fd, "locks")
                if _fd_identity(rebound_locks_fd) != locks_identity:
                    raise CFError(f"remote project locks directory changed: {project_root}")
                current_descriptor = _read_regular_bounded_at(
                    project_fd, "remote_project.json", 16 * 1024
                )
                current_metadata = os.stat(
                    "remote_project.json", dir_fd=project_fd, follow_symlinks=False
                )
                if (
                    (current_metadata.st_dev, current_metadata.st_ino) != descriptor_key
                    or current_descriptor != descriptor
                ):
                    raise CFError(f"remote project descriptor changed: {project_root}")
    finally:
        for fd in [rebound_locks_fd, rebound_fd, locks_fd, project_fd]:
            if fd >= 0:
                os.close(fd)


@contextlib.contextmanager
def ordered_remote_merge_gates(source_root: Path, target_root: Path):
    requested: dict[str, tuple[Path, bool]] = {}
    for root, shared in [(source_root, True), (target_root, False)]:
        stable_id = remote_project_stable_id(root)
        canonical_root = root.resolve(strict=True)
        prior = requested.get(stable_id)
        if prior is not None and prior[0].resolve(strict=True) != canonical_root:
            raise CFError(
                f"distinct remote project roots claim the same stable identity {stable_id}: {prior[0]} and {canonical_root}"
            )
        if prior is None or not shared:
            requested[stable_id] = (canonical_root, shared)
    with contextlib.ExitStack() as stack:
        for expected_id, (root, shared) in sorted(requested.items()):
            stack.enter_context(remote_project_gate(root, shared=shared))
            actual_id = remote_project_stable_id(root)
            if actual_id != expected_id:
                raise CFError(
                    f"remote project identity changed while acquiring ordered gates: expected {expected_id}, found {actual_id}"
                )
        yield


def _sync_directory(path: Path) -> None:
    flags = os.O_RDONLY | getattr(os, "O_DIRECTORY", 0) | getattr(os, "O_NOFOLLOW", 0)
    fd = os.open(path, flags)
    try:
        os.fsync(fd)
    except OSError:
        pass
    finally:
        os.close(fd)


