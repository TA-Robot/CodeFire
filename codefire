      ;;
    token-hash)
      _arguments '--salt[salt]' '--stdin[read token from stdin]'
      ;;
  esac
}}
_codefire "$@"
"""


def cmd_completion(args: argparse.Namespace) -> int:
    if args.shell == "bash":
        print(bash_completion_script(), end="")
    elif args.shell == "zsh":
        print(zsh_completion_script(), end="")
    else:
        raise CFError(f"unsupported completion shell: {args.shell}")
    return 0


def cmd_token_hash(args: argparse.Namespace) -> int:
    if args.stdin:
        token = sys.stdin.read().rstrip("\n")
    else:
        token = args.token
    if not token:
        raise CFError("token is required; pass TOKEN or use --stdin")
    value = token_hash_policy_value(token, args.salt or "")
    print(json.dumps(value, ensure_ascii=False, sort_keys=True))
    return 0


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="codefire")
    sub = parser.add_subparsers(dest="cmd", required=True)
    p = sub.add_parser("init")
    p.add_argument("path", nargs="?", default=".")
    p.add_argument("--force", action="store_true")
    p.set_defaults(func=cmd_init)
    p = sub.add_parser("branch")
    bsub = p.add_subparsers(dest="branch_cmd", required=True)
    bl = bsub.add_parser("list")
    bl.set_defaults(func=cmd_branch_list)
    p = sub.add_parser("open")
    p.add_argument("branch")
    p.add_argument("path")
    p.set_defaults(func=cmd_open)
    p = sub.add_parser("close")
    p.add_argument("branch")
    p.add_argument("--discard", action="store_true")
    p.set_defaults(func=cmd_close)
    p = sub.add_parser("discard")
    p.add_argument("branch")
    p.set_defaults(func=cmd_discard)
    p = sub.add_parser("clone")
    p.add_argument("source")
    p.add_argument("new_branch")
    p.set_defaults(func=cmd_clone)
    p = sub.add_parser("upload")
    p.add_argument("branch")
    p.add_argument("remote_url")
    p.add_argument("--actor")
    p.add_argument("--token")
    p.add_argument("--request-key-id")
    p.add_argument("--idempotency-key")
    p.set_defaults(func=cmd_upload)
    p = sub.add_parser("list")
    p.add_argument("server_url")
    p.set_defaults(func=cmd_list)
    p = sub.add_parser("status")
    p.set_defaults(func=cmd_status)
    p = sub.add_parser("scan")
    p.set_defaults(func=cmd_scan)
    p = sub.add_parser("fire")
    p.add_argument("atom_id")
    p.add_argument("--reason", required=True)
    p.set_defaults(func=cmd_fire)
    p = sub.add_parser("extinguish")
    p.add_argument("fire_id")
    p.add_argument("--resolution", required=True, choices=["changed", "verified", "no-change-required", "invalid-fire"])
    p.add_argument("--rationale")
    p.add_argument("--evidence")
    p.add_argument("--refresh", action="store_true", help="refresh resolution basis for an already extinguished fire")
    p.set_defaults(func=cmd_extinguish)
    p = sub.add_parser("verify")
    p.add_argument("--details", action="store_true", help="show details for failed verification diagnostics")
    p.set_defaults(func=cmd_verify)
    p = sub.add_parser("commit")
    p.add_argument("-m", "--message", required=True)
    p.add_argument("--signer")
    p.add_argument("--key-id")
    p.set_defaults(func=cmd_commit)
    p = sub.add_parser("merge")
    p.add_argument("source_branch")
    p.add_argument("--into", required=True)
    p.set_defaults(func=cmd_merge)
    p = sub.add_parser("request-merge")
    p.add_argument("source_url")
    p.add_argument("target_url")
    p.add_argument("--actor")
    p.add_argument("--token")
    p.add_argument("--request-key-id")
    p.add_argument("--idempotency-key")
    p.set_defaults(func=cmd_request_merge)
    p = sub.add_parser("request-list")
    p.add_argument("server_url")
    p.set_defaults(func=cmd_request_list)
    p = sub.add_parser("request-review")
    p.add_argument("server_url")
    p.add_argument("mr_id")
    p.add_argument("--reviewer", required=True)
    p.add_argument("--decision", choices=["approve", "reject"], required=True)
    p.add_argument("--comment")
    p.add_argument("--actor")
    p.add_argument("--token")
    p.add_argument("--request-key-id")
    p.add_argument("--idempotency-key")
    p.set_defaults(func=cmd_request_review)
    p = sub.add_parser("request-apply")
    p.add_argument("server_url")
    p.add_argument("mr_id")
    p.add_argument("--actor")
    p.add_argument("--token")
    p.add_argument("--request-key-id")
    p.add_argument("--idempotency-key")
    p.set_defaults(func=cmd_request_apply)
    p = sub.add_parser("gc")
    p.add_argument("server_url")
    p.add_argument("--actor")
    p.add_argument("--token")
    p.add_argument("--request-key-id")
    p.add_argument("--dry-run", action="store_true")
    p.set_defaults(func=cmd_gc)
    p = sub.add_parser("show")
    p.add_argument("branch_or_url")
    p.set_defaults(func=cmd_show)
    p = sub.add_parser("diff")
    p.add_argument("left")
    p.add_argument("right")
    p.set_defaults(func=cmd_diff)
    p = sub.add_parser("doctor")
    p.add_argument("target", nargs="?")
    p.set_defaults(func=cmd_doctor)
    p = sub.add_parser("serve")
    p.add_argument("storage_root")
    p.add_argument("--host", default="127.0.0.1")
    p.add_argument("--port", type=int, default=8080)
    p.add_argument("--tls-cert")
    p.add_argument("--tls-key")
    p.set_defaults(func=cmd_serve)
    p = sub.add_parser("completion")
    p.add_argument("shell", choices=["bash", "zsh"])
    p.set_defaults(func=cmd_completion)
    p = sub.add_parser("token-hash")
    p.add_argument("token", nargs="?")
    p.add_argument("--salt", default="")
    p.add_argument("--stdin", action="store_true")
    p.set_defaults(func=cmd_token_hash)
    return parser


def main(argv: list[str] | None = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    try:
        return args.func(args)
    except ResourceBudgetExceeded as exc:
        print(canonical_json(exc.diagnostic()).decode("utf-8"), file=sys.stderr)
        return RESOURCE_BUDGET_EXIT_CODE
    except CFError as exc:
        print(f"error: {exc}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
