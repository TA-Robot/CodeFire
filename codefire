def fire_key(source: str, target: str, reason: str, trace_path: list[str], base: str) -> str:
    data = {
        "source_atom_id": source,
        "target_atom_id": target,
        "reason": reason,
        "trace_path_hash": digest_bytes(canonical_json(trace_path)),
        "base_commit": base,
    }
    return digest_bytes(canonical_json(data))


def changed_atoms(current: dict[str, Any], base: dict[str, Any]) -> list[str]:
    cur = atom_map(current)
    old = atom_map(base)
    changed = []
    for atom_id, atom in cur.items():
        if atom_id not in old or old[atom_id]["content_hash"] != atom["content_hash"]:
            changed.append(atom_id)
    return sorted(changed)


def adjacent_atoms(atom_id: str, trace_graph: dict[str, Any]) -> list[tuple[str, list[str]]]:
    out = []
    for link in trace_graph.get("links", []):
        if link["from"] == atom_id:
            out.append((link["to"], [link["from"], link["to"]]))
        elif link["to"] == atom_id:
            out.append((link["from"], [link["to"], link["from"]]))
    return out


def run_scan() -> dict[str, Any]:
    repo_root, open_dir, identity, registry = open_context(Path.cwd())
    state_data = active_state(repo_root, registry)
    current = build_atom_index(open_dir)
    base_index = base_atom_index(repo_root, registry)
    trace_graph = current_trace_graph(open_dir)
    changed = changed_atoms(current, base_index)
    fires = load_fires(repo_root, registry)
    existing_keys = {f.get("key") for f in fires if f.get("status") != "obsolete"}
    base = base_commit(registry)
    reason = "merge_changed" if state_data.get("pending_merge_parent") else "atom_changed"
    fire_no = len(fires) + 1
    for source in changed:
        for target, trace_path in adjacent_atoms(source, trace_graph):
            if target == source:
                continue
            key = fire_key(source, target, reason, trace_path, base)
            if key in existing_keys:
                continue
            fires.append(
                {
                    "type": "fire",
                    "version": VERSION,
                    "fire_uid": f"fire_{hashlib.sha1(key.encode()).hexdigest()[:12]}",
                    "display_id": f"FIRE-{fire_no:03d}",
                    "status": "open",
                    "severity": "required",
                    "source": {"atom_id": source, "content_hash_at_fire": atom_map(current)[source]["content_hash"]},
                    "target": {"atom_id": target, "content_hash_at_fire": atom_map(current).get(target, {}).get("content_hash")},
                    "reason": reason,
                    "trace_path": trace_path,
                    "created_by": "scan",
                    "created_at": now_iso(),
                    "key": key,
                }
            )
            existing_keys.add(key)
            fire_no += 1
    current_changed = set(changed)
    for fire in fires:
        if fire.get("created_by") == "scan" and fire.get("status") == "open":
            if fire["source"]["atom_id"] not in current_changed:
                fire["status"] = "obsolete"
                fire["obsolete_at"] = now_iso()
    save_fires(repo_root, registry, fires)
    scan_result = {
        "type": "scan",
        "version": VERSION,
        "base_commit": base,
        "atom_index": current,
        "trace_graph": trace_graph,
        "changed_atoms": changed,
        "open_fires": [f for f in fires if f["status"] == "open" and f["severity"] == "required"],
    }
    adir = active_dir(repo_root, registry["open"]["open_instance_id"])
    write_json(adir / "scan.json", scan_result)
    state = "open-burning" if changed or scan_result["open_fires"] else "open-clean"
    set_open_state(repo_root, identity["branch"]["name"], identity["open"]["open_instance_id"], state)
    return scan_result


def stale_resolutions(repo_root: Path, open_dir: Path, registry: dict[str, Any], atom_index: dict[str, Any], trace_graph: dict[str, Any]) -> list[dict[str, Any]]:
    atoms = atom_map(atom_index)
    link_hashes = {l["link_id"]: l["link_hash"] for l in trace_graph.get("links", [])}
    policy_hash = digest_bytes(canonical_json(parse_policy(open_dir)))
    stale = []
    for res in load_resolutions(repo_root, registry):
        if res.get("status") != "active":
            continue
        basis = res.get("basis", {})
        source = basis.get("source_atom", {})
        target = basis.get("target_atom", {})
        if atoms.get(source.get("atom_id"), {}).get("content_hash") != source.get("content_hash"):
            stale.append({"resolution_uid": res["resolution_uid"], "reason": "source atom changed"})
            continue
        if atoms.get(target.get("atom_id"), {}).get("content_hash") != target.get("content_hash"):
            stale.append({"resolution_uid": res["resolution_uid"], "reason": "target atom changed"})
            continue
        if policy_hash != basis.get("policy_hash"):
            stale.append({"resolution_uid": res["resolution_uid"], "reason": "policy changed"})
            continue
        for link in basis.get("trace_links", []):
            if link_hashes.get(link["link_id"]) != link["link_hash"]:
                stale.append({"resolution_uid": res["resolution_uid"], "reason": "trace link changed"})
                break
    return stale


def run_verify() -> dict[str, Any]:
    repo_root, open_dir, identity, registry = open_context(Path.cwd())
    scan = run_scan()
    atom_index = scan["atom_index"]
    trace_graph = scan["trace_graph"]
    policy = parse_policy(open_dir)
    state_data = active_state(repo_root, registry)
    missing = required_link_missing(atom_index, trace_graph, policy.get("required_links", {}))
    stale = stale_resolutions(repo_root, open_dir, registry, atom_index, trace_graph)
    failures = []
    if state_data.get("merge_conflicts"):
        failures.append(
            {
                "id": "merge-conflicts",
                "command": "internal",
                "output": "unresolved merge conflicts: " + ", ".join(state_data["merge_conflicts"]),
            }
        )
    for check in policy.get("verification", []):
        proc = subprocess.run(
            check["command"],
            shell=True,
            cwd=open_dir / check.get("cwd", "."),
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
        )
        if proc.returncode != 0:
            failures.append({"id": check.get("id", "verification"), "command": check["command"], "output": proc.stdout})
    duplicate_atom_ids = atom_index.get("duplicate_atom_ids", [])
    open_fires = scan["open_fires"]
    merge_conflicts_present = any(f.get("id") == "merge-conflicts" for f in failures)
    passed = not merge_conflicts_present
    if policy_enabled(policy, "require_no_required_fires") and open_fires:
        passed = False
    if policy_enabled(policy, "require_trace_completeness") and missing:
        passed = False
    if policy_enabled(policy, "require_no_stale_resolutions") and stale:
        passed = False
    if policy_enabled(policy, "require_verification_success") and failures:
        passed = False
    if policy_enabled(policy, "reject_duplicate_atom_ids") and duplicate_atom_ids:
        passed = False
    verification = {
        "type": "verification",
        "version": VERSION,
        "result": "passed" if passed else "failed",
        "open_required_fires": len(open_fires),
        "failed_checks": failures,
        "missing_required_links": missing,
        "stale_resolutions": stale,
        "duplicate_atom_ids": duplicate_atom_ids,
        "verified_at": now_iso(),
    }
    adir = active_dir(repo_root, registry["open"]["open_instance_id"])
    write_json(adir / "verification.json", verification)
    if passed:
        set_open_state(repo_root, identity["branch"]["name"], identity["open"]["open_instance_id"], "open-consistent")
    else:
        set_open_state(repo_root, identity["branch"]["name"], identity["open"]["open_instance_id"], "open-burning")
    return verification


def build_manifest(repo_root: Path, open_dir: Path) -> dict[str, Any]:
    entries = []
    for rel in rel_files(open_dir):
        data = (open_dir / rel).read_bytes()
        blob_payload = {
            "type": "blob",
            "version": VERSION,
            "encoding": "base64",
            "content": base64.b64encode(data).decode("ascii"),
        }
        blob_id = store_object(repo_root, "blob", blob_payload)
        entries.append({"path": rel.as_posix(), "kind": "file", "mode": "100644", "blob": blob_id})
    return {"type": "content_manifest", "version": VERSION, "entries": entries}


def materialize_commit(repo_root: Path, commit_id: str, target: Path) -> None:
    commit = commit_payload(repo_root, commit_id)
    manifest_id = commit.get("roots", {}).get("content_manifest")
    if not manifest_id:
        return
    manifest = load_object(repo_root, manifest_id)
    for entry in manifest.get("entries", []):
        blob = load_object(repo_root, entry["blob"])
        data = base64.b64decode(blob["content"].encode("ascii"))
        out = target / entry["path"]
        out.parent.mkdir(parents=True, exist_ok=True)
        out.write_bytes(data)


def manifest_contents(repo_root: Path, commit_id: str) -> dict[str, bytes | None]:
    return manifest_contents_from_root(repo_dirs(repo_root)["objects"], commit_id)


def manifest_contents_from_root(objects_root: Path, commit_id: str) -> dict[str, bytes | None]:
    commit = load_object_from_root(objects_root, commit_id)
    manifest_id = commit.get("roots", {}).get("content_manifest")
    if not manifest_id:
        return {}
    manifest = load_object_from_root(objects_root, manifest_id)
    contents: dict[str, bytes | None] = {}
    for entry in manifest.get("entries", []):
        blob = load_object_from_root(objects_root, entry["blob"])
        contents[entry["path"]] = base64.b64decode(blob["content"].encode("ascii"))
    return contents


def resolve_commitish(repo_root: Path, value: str) -> tuple[str, str]:
    if is_remote_url(value):
        raise CFError("remote URLs are not implemented in this local MVP")
    if value.startswith("CF-COMMIT-"):
        validate_sealed_commit(repo_dirs(repo_root)["objects"], value)
        return value, value
    branch = load_branch(repo_root, value)
    validate_sealed_commit(repo_dirs(repo_root)["objects"], branch["head"])
    return branch["head"], f"{value}@{branch['head']}"


def resolve_commitish_any(repo_root: Path | None, value: str, temp_dirs: list[tempfile.TemporaryDirectory] | None = None) -> tuple[Path, str, str]:
    if is_http_remote_url(value):
        if temp_dirs is None:
            raise CFError("HTTP remote resolution requires a temporary object store")
        info = parse_cf_http_url(value)
        bundle = http_json("GET", http_remote_path(info, "branches", info["branch"], "bundle"))
        branch = bundle.get("branch")
        records = bundle.get("objects")
        if not isinstance(branch, dict) or not isinstance(records, list):
            raise CFError("HTTP remote returned an invalid branch bundle")
        temp_dir = tempfile.TemporaryDirectory()
        temp_dirs.append(temp_dir)
        objects_root = Path(temp_dir.name) / "objects"
        write_object_records(objects_root, records)
        validate_sealed_commit(objects_root, branch["head"])
        return objects_root, branch["head"], f"{value}@{branch['head']}"
    if value.startswith("cf://"):
        info = parse_cf_url(value)
        branch = read_json(remote_branch_path(info["project_root"], info["branch"]))
        if not branch:
            raise CFError(f"remote branch not found: {value}")
        objects_root = remote_dirs(info["project_root"])["objects"]
        validate_sealed_commit(objects_root, branch["head"])
        return objects_root, branch["head"], f"{value}@{branch['head']}"
    if repo_root is None:
        raise CFError("local branch or commit requires running inside a CodeFire repository")
    commit_id, label = resolve_commitish(repo_root, value)
    return repo_dirs(repo_root)["objects"], commit_id, label


def root_object_from_root(objects_root: Path, commit_id: str, root_name: str) -> Any:
    commit = load_object_from_root(objects_root, commit_id)
    oid = commit.get("roots", {}).get(root_name)
    if not oid:
        return {"type": root_name, "version": VERSION}
    return load_object_from_root(objects_root, oid)


def commit_parents(repo_root: Path, commit_id: str) -> list[str]:
    return list(commit_payload(repo_root, commit_id).get("parents", []))


def ancestor_distances(repo_root: Path, commit_id: str) -> dict[str, int]:
    distances: dict[str, int] = {}
    queue: list[tuple[str, int]] = [(commit_id, 0)]
    while queue:
        current, dist = queue.pop(0)
        if current in distances and distances[current] <= dist:
            continue
        distances[current] = dist
        for parent in commit_parents(repo_root, current):
            queue.append((parent, dist + 1))
    return distances


def common_ancestor(repo_root: Path, left: str, right: str) -> str | None:
    left_dist = ancestor_distances(repo_root, left)
    right_dist = ancestor_distances(repo_root, right)
    common = set(left_dist) & set(right_dist)
    if not common:
        return None
    return min(common, key=lambda cid: (left_dist[cid] + right_dist[cid], max(left_dist[cid], right_dist[cid]), cid))


def write_merged_file(path: Path, data: bytes | None) -> None:
    if data is None:
        if path.exists():
            path.unlink()
        return
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_bytes(data)


def conflict_content(target_data: bytes | None, source_data: bytes | None) -> bytes:
    def text(data: bytes | None) -> str:
        if data is None:
            return "<deleted>\n"
        return data.decode("utf-8", errors="replace")

    return (
        "<<<<<<< target\n"
        f"{text(target_data)}"
        "=======\n"
        f"{text(source_data)}"
        ">>>>>>> source\n"
    ).encode("utf-8")


