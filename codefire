def java_blocks(lines: list[str]) -> list[tuple[int, int, str, str]]:
    blocks: list[tuple[int, int, str, str]] = []
    type_pattern = re.compile(
        r"^\s*(?:public|protected|private|abstract|final|static|sealed|non-sealed\s+)*\s*(class|interface|record|enum)\s+([A-Za-z_][A-Za-z0-9_]*)\b"
    )
    method_pattern = re.compile(
        r"^\s*(?:@\w+(?:\([^)]*\))?\s*)*(?:public|protected|private|static|final|abstract|synchronized|native|strictfp|default|\s)+[\w<>\[\], ?&.]+\s+([A-Za-z_][A-Za-z0-9_]*)\s*\([^;]*\)\s*(?:throws\s+[^{]+)?\{"
    )
    current_type = ""
    type_stack: list[tuple[str, int]] = []
    depth = 0
    for i, line in enumerate(lines):
        while type_stack and depth < type_stack[-1][1]:
            type_stack.pop()
        current_type = type_stack[-1][0] if type_stack else current_type
        type_match = type_pattern.match(line)
        if type_match:
            symbol_type = "type" if type_match.group(1) != "enum" else "enum"
            name = type_match.group(2)
            end = len(lines)
            brace_balance = line.count("{") - line.count("}")
            if brace_balance > 0:
                type_stack.append((name, depth + brace_balance))
                for j in range(i + 1, len(lines)):
                    brace_balance += lines[j].count("{") - lines[j].count("}")
                    if brace_balance <= 0:
                        end = j + 1
                        break
            else:
                for j in range(i + 1, len(lines)):
                    if lines[j].strip() and type_pattern.match(lines[j]):
                        end = j
                        break
            blocks.append((i, end, symbol_type, name))
        else:
            method_match = method_pattern.match(line)
            if method_match:
                method_name = method_match.group(1)
                owner = type_stack[-1][0] if type_stack else current_type
                name = f"{owner}.{method_name}" if owner else method_name
                end = len(lines)
                brace_balance = line.count("{") - line.count("}")
                if brace_balance > 0:
                    for j in range(i + 1, len(lines)):
                        brace_balance += lines[j].count("{") - lines[j].count("}")
                        if brace_balance <= 0:
                            end = j + 1
                            break
                blocks.append((i, end, "method", name))
        depth += line.count("{") - line.count("}")
    return blocks


