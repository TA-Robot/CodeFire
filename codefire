def cmd_extinguish(args: argparse.Namespace) -> int:
    repo_root, open_dir, identity, registry = open_context(Path.cwd())
    policy = parse_policy(open_dir)
    if args.resolution == "no-change-required" and policy.get("no_change_required_requires_rationale", True) and not args.rationale:
        raise CFError("no-change-required requires --rationale")
    if not args.rationale and not args.evidence:
        raise CFError("extinguish requires --rationale or --evidence")
    scan = run_scan()
    atoms = atom_map(scan["atom_index"])
    trace_graph = scan["trace_graph"]
    fires = load_fires(repo_root, registry)
    fire = next((f for f in fires if f["display_id"] == args.fire_id or f["fire_uid"] == args.fire_id), None)
    if not fire:
        raise CFError(f"unknown fire: {args.fire_id}")
    if fire["status"] != "open":
        raise CFError(f"fire is not open: {args.fire_id}")
    source_id = fire["source"]["atom_id"]
    target_id = fire["target"]["atom_id"]
    link_basis = []
    for link in trace_graph.get("links", []):
        if {link["from"], link["to"]} == {source_id, target_id}:
            link_basis.append({"link_id": link["link_id"], "link_hash": link["link_hash"]})
    resolution = {
        "type": "resolution",
        "version": VERSION,
        "resolution_uid": "res_" + hashlib.sha1(f"{args.fire_id}:{time.time()}".encode()).hexdigest()[:12],
        "fire_uid": fire["fire_uid"],
        "resolution_type": args.resolution,
        "rationale": args.rationale,
        "evidence": args.evidence,
        "basis": {
            "source_atom": {"atom_id": source_id, "content_hash": atoms.get(source_id, {}).get("content_hash")},
            "target_atom": {"atom_id": target_id, "content_hash": atoms.get(target_id, {}).get("content_hash")},
            "trace_links": link_basis,
            "policy_hash": digest_bytes(canonical_json(parse_policy(open_dir))),
        },
        "resolved_at": now_iso(),
        "status": "active",
    }
    fire["status"] = "extinguished"
    fire["resolution_uid"] = resolution["resolution_uid"]
    save_fires(repo_root, registry, fires)
    resolutions = load_resolutions(repo_root, registry)
    resolutions.append(resolution)
    save_resolutions(repo_root, registry, resolutions)
    print(f"extinguished {fire['display_id']}")
    return 0


