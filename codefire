    branch = {"type": "branch", "version": VERSION, "name": "main", "head": commit_id, "state": "closed", "created_at": now_iso()}
    save_branch(repo_root, branch)
    print(f"initialized CodeFire repository: {repo_root}")
    print(f"main: {commit_id}")
