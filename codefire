def _object_record_core_json_size(
    record: dict[str, Any], poll: Any | None = None
) -> int:
    field_count = 0
    size = 2
    for key, value in record.items():
        if poll is not None:
            poll()
        if key == "remote":
            continue
        if field_count:
            size += 1
        size += (
            canonical_json_size_up_to(str(key), U64_MAX, poll)
            + 1
            + canonical_json_size_up_to(value, U64_MAX, poll)
        )
        field_count += 1
    return size


def _http_bundle_payload_json_size(
    branch: dict[str, Any],
    ordered_ids: list[str],
    documents: dict[str, Any],
    poll: Any | None = None,
) -> int:
    records_size = 2 + max(0, len(ordered_ids) - 1)
    for object_id in ordered_ids:
        if poll is not None:
            poll()
        records_size += _object_record_core_json_size(
            documents[object_id].record, poll
        )
    return (
        2
        + 1
        + canonical_json_size("branch")
        + 1
        + canonical_json_size_up_to(branch, U64_MAX, poll)
        + canonical_json_size("objects")
        + 1
        + records_size
    )


def collect_http_bundle_payload(
    objects_root: Path,
    branch: dict[str, Any],
    branch_retained: int,
    ledger: DecisionWorkLedger,
    deadline: HTTPRequestDeadline | None = None,
) -> AccountedHTTPBundle:
    """Validate and collect one deterministic bundle under one request ledger."""
    head = branch.get("head")
    if not isinstance(head, str):
        if branch_retained:
            head = None
            branch.clear()
            ledger.release("retained_bytes", branch_retained)
        raise CFError("remote branch head is not a commit object ID")

    validation: SealedCommitValidationSession | None = None
    collection: SealedCommitValidationSession | None = None
    stack: list[tuple[str, int]] = []
    seen: set[str] = set()
    seen_retained = 0
    sort_temporary = 0
    payload_retained = 0
    ordered_ids: list[str] | None = None
    records: list[dict[str, Any]] | None = None
    payload: AccountedHTTPBundle | None = None
    record: dict[str, Any] | None = None

    def poll(phase: str) -> None:
        if deadline is not None:
            deadline.check(phase)

    def push(reference: str, depth: int, *, edge: bool) -> None:
        poll("bundle object collection")
        frame_bytes = SealedCommitValidationSession._frame_size(reference)
        counters = {"frontier_insertion_attempts": 1}
        charges = None
        if edge:
            charges = {"graph_edges": 1}
            counters["edge_occurrences"] = 1
        ledger.apply(
            "graph_discovery",
            charges=charges,
            maxima={
                "logical_depth": depth,
                "maximum_frontier": len(stack) + 1,
            },
            acquires={"retained_bytes": frame_bytes},
            counters=counters,
        )
        stack.append((reference, depth))

    try:
        poll("bundle sealed validation")
        validation = SealedCommitValidationSession(objects_root, ledger)
        validation.validate_commit(
            head, poll=lambda: poll("bundle sealed validation")
        )
        validation.finalize(
            terminate=False,
            poll=lambda: poll("bundle snapshot revalidation"),
        )
        validation = None

        poll("bundle object collection")
        collection = SealedCommitValidationSession(objects_root, ledger)
        push(head, 0, edge=False)
        while stack:
            poll("bundle object collection")
            object_id, depth = stack[-1]
            frame_bytes = SealedCommitValidationSession._frame_size(object_id)
            if object_id in seen:
                stack.pop()
                ledger.count("revisits", 1, "graph_discovery")
                object_id = None
                ledger.release("retained_bytes", frame_bytes)
                continue
            ledger.apply(
                "graph_discovery",
                charges={"graph_nodes": 1},
                counters={"unique_nodes_discovered": 1},
            )
            stack.pop()
            seen.add(object_id)
            seen_retained += frame_bytes
            collection.load_payload(
                object_id, poll=lambda: poll("bundle object collection")
            )
            record = collection.documents[object_id].record

            def push_reference(reference: str) -> None:
                push(reference, depth + 1, edge=True)

            visit_object_record_references(
                record,
                push_reference,
                lambda: poll("bundle object collection"),
            )
            record = None
            push_reference = None
            object_id = None

        poll("bundle response planning")
        sort_temporary = seen_retained + 8 * len(seen)
        ledger.acquire("temporary_bytes", sort_temporary, "query")
        ordered_ids = sorted(seen)
        poll("bundle response planning")

        payload_retained = _http_bundle_payload_json_size(
            branch,
            ordered_ids,
            collection.documents,
            lambda: poll("bundle response planning"),
        )
        ledger.acquire("retained_bytes", payload_retained, "encoding")
        records = []
        for object_id in ordered_ids:
            poll("bundle response planning")
            records.append(
                object_record_core(collection.documents[object_id].record)
            )
        ordered_ids = None
        ledger.release("temporary_bytes", sort_temporary)
        sort_temporary = 0
        payload = AccountedHTTPBundle(
            ledger, branch, records, payload_retained
        )
        records = None
        collection.finalize(
            terminate=False,
            poll=lambda: poll("bundle snapshot revalidation"),
        )
        collection = None
        seen.clear()
        if seen_retained:
            ledger.release("retained_bytes", seen_retained)
            seen_retained = 0
        if branch_retained:
            ledger.release("retained_bytes", branch_retained)
            branch_retained = 0
        poll("bundle response planning")
        return payload
    except BaseException:
        if payload is not None:
            try:
                payload.close()
            except BaseException:
                pass
            payload_retained = 0
        else:
            records = None
            if payload_retained:
                try:
                    ledger.release("retained_bytes", payload_retained)
                except BaseException:
                    pass
                payload_retained = 0
        raise
    finally:
        record = None
        head = None
        ordered_ids = None
        if sort_temporary:
            try:
                ledger.release("temporary_bytes", sort_temporary)
            except BaseException:
                pass
        while stack:
            object_id, _ = stack.pop()
            frame_bytes = SealedCommitValidationSession._frame_size(object_id)
            object_id = None
            try:
                ledger.release(
                    "retained_bytes",
                    frame_bytes,
                )
            except BaseException:
                pass
        seen.clear()
        if seen_retained:
            try:
                ledger.release("retained_bytes", seen_retained)
            except BaseException:
                pass
        if collection is not None:
            collection.close(None)
        if validation is not None:
            validation.close(None)
        if branch_retained:
            branch.clear()
            try:
                ledger.release("retained_bytes", branch_retained)
            except BaseException:
                pass


BRANCH_LIST_ENVELOPE_FIELD = "branches"


def collect_http_branch_list_payload(
    branches_root: Path,
    objects_root: Path,
    ledger: DecisionWorkLedger,
    deadline: HTTPRequestDeadline | None = None,
) -> AccountedHTTPBranchList:
    """Project every branch head from one pinned authority snapshot.

    One request-scoped ``SealedCommitValidationSession`` validates every head so
    an immutable shared ancestry is traversed once, and one final snapshot and
    digest revalidation fences the whole projection before publication.
    """

    def poll(phase: str) -> None:
        if deadline is not None:
            deadline.check(phase)

    def poll_authority() -> None:
        poll("branch list authority")

    def poll_validation() -> None:
        poll("branch list sealed validation")

    def poll_projection() -> None:
        poll("branch list projection")

    session: SealedCommitValidationSession | None = None
    paths: list[Path] = []
    paths_retained = 0
    records: list[Any] = []
    records_retained = 0
    head_frames = 0
    projection_retained = 0
    branches: list[dict[str, Any]] | None = None
    payload: AccountedHTTPBranchList | None = None
    try:
        poll_authority()
        paths, paths_retained = accounted_sorted_json_paths(
            branches_root, ledger, poll_authority
        )
        session = SealedCommitValidationSession(objects_root, ledger)
        for path in paths:
            poll_authority()
            branch, branch_retained = read_json_accounted(
                path, ledger, poll=poll_authority
            )
            if branch is None:
                raise CFError(f"remote branch record is unavailable: {path}")
            records_retained += branch_retained
            records.append([branch, branch_retained])
            poll_authority()
            validate_remote_branch_record(branch)
            frame_bytes = SealedCommitValidationSession._frame_size(
                branch["head"]
            )
            ledger.apply(
                "record_read",
                acquires={"retained_bytes": frame_bytes},
                counters={"frontier_insertion_attempts": 1},
            )
            head_frames += frame_bytes
        paths.clear()
        if paths_retained:
            ledger.release("retained_bytes", paths_retained)
            paths_retained = 0

        for record in records:
            poll_validation()
            session.validate_commit(record[0]["head"], poll=poll_validation)
        if head_frames:
            ledger.release("retained_bytes", head_frames)
            head_frames = 0

        poll_projection()
        branches = []
        projection_retained = canonical_json_size_up_to(
            {BRANCH_LIST_ENVELOPE_FIELD: branches}, U64_MAX, poll_projection
        )
        ledger.acquire("retained_bytes", projection_retained, "encoding")
        for position, record in enumerate(records):
            poll_projection()
            branch, branch_retained = record
            projection = {
                "version": 1,
                "name": branch["name"],
                "head": branch["head"],
            }
            entry_bytes = canonical_json_size_up_to(
                projection, U64_MAX, poll_projection
            )
            if branches:
                entry_bytes += 1
            ledger.acquire("retained_bytes", entry_bytes, "encoding")
            projection_retained += entry_bytes
            branches.append(projection)
            projection = None
            records[position] = None
            record[0] = None
            branch.clear()
            branch = None
            ledger.release("retained_bytes", branch_retained)
            records_retained -= branch_retained
        records.clear()

        payload = AccountedHTTPBranchList(ledger, branches, projection_retained)
        branches = None
        projection_retained = 0
        session.finalize(
            terminate=False,
            poll=lambda: poll("branch list snapshot revalidation"),
        )
        session = None
        poll_projection()
        return payload
    except BaseException:
        if payload is not None:
            try:
                payload.close()
            except BaseException:
                pass
            payload = None
            projection_retained = 0
        raise
    finally:
        branches = None
        paths.clear()
        if paths_retained:
            try:
                ledger.release("retained_bytes", paths_retained)
            except BaseException:
                pass
        if head_frames:
            try:
                ledger.release("retained_bytes", head_frames)
            except BaseException:
                pass
        if projection_retained:
            try:
                ledger.release("retained_bytes", projection_retained)
            except BaseException:
                pass
        for record in records:
            if record is not None and record[0] is not None:
                record[0].clear()
                record[0] = None
        records.clear()
        if records_retained:
            try:
                ledger.release("retained_bytes", records_retained)
            except BaseException:
                pass
        if session is not None:
            session.close(None)


def handle_http_list(
    storage_root: Path,
    org: str,
    app: str,
    ledger: DecisionWorkLedger,
    deadline: HTTPRequestDeadline | None = None,
) -> tuple[int, dict[str, Any]]:
    """List every remote branch head under the caller's request ledger."""
    if deadline is not None:
        deadline.check("branch list planning")
    project_root = http_project_root(storage_root, org, app)
    dirs = remote_dirs(project_root)
    if not dirs["branches"].exists():
        return http_error(404, "remote project not found")
    if deadline is not None:
        deadline.check("branch list project gate")
    with remote_project_gate(project_root, shared=True):
        return 200, collect_http_branch_list_payload(
            dirs["branches"], dirs["objects"], ledger, deadline
        )


def handle_http_doctor(
    storage_root: Path,
    org: str,
    app: str,
    quick: bool = False,
    ledger: DecisionWorkLedger | None = None,
    *,
    deadline: HTTPRequestDeadline | None = None,
) -> tuple[int, dict[str, Any]]:
    """Run one Doctor route under the caller's request ledger and deadline."""
    project_root = http_project_root(storage_root, org, app)
    url = f"cf+http://{org}/{app}"
    if deadline is not None:
        deadline.check("doctor project gate")
    if not project_root.exists():
        return 200, remote_doctor_payload(
            project_root, url, quick=quick, ledger=ledger, deadline=deadline
        )
    with remote_project_gate(project_root, shared=True):
        return 200, remote_doctor_payload(
            project_root, url, quick=quick, ledger=ledger, deadline=deadline
        )


def handle_http_gc(storage_root: Path, org: str, app: str, request: dict[str, Any]) -> tuple[int, dict[str, Any]]:
    project_root = http_project_root(storage_root, org, app)
    if not remote_dirs(project_root)["project"].exists():
        return http_error(404, "remote project not found")
    info = {"org": org, "app": app}
    args = argparse.Namespace(actor=request.get("actor"), token=request.get("token"), request_signature=request.get("request_signature"))
    actor = authorize_remote(
        project_root,
        "gc",
        args,
        target=remote_request_target(info, "gc"),
        payload=request,
    )
    payload = remote_gc_payload(
        project_root,
        {"org": org, "app": app, "url": f"cf+http://{org}/{app}"},
        actor,
        bool(request.get("dry_run")),
    )
    return 200, payload


def handle_http_bundle(
    storage_root: Path,
    org: str,
    app: str,
    branch_name: str,
    ledger: DecisionWorkLedger,
    *,
    deadline: HTTPRequestDeadline | None = None,
) -> tuple[int, dict[str, Any]]:
    def poll(phase: str) -> None:
        if deadline is not None:
            deadline.check(phase)

    project_root = http_project_root(storage_root, org, app)
    dirs = remote_dirs(project_root)
    branch: dict[str, Any] | None = None
    branch_retained = 0
    poll("bundle project gate")
    with remote_project_gate(project_root, shared=True):
        try:
            poll("bundle branch authority")
            branch, branch_retained = read_json_accounted(
                remote_branch_path(project_root, branch_name),
                ledger,
                poll=lambda: poll("bundle branch authority"),
            )
            poll("bundle branch authority")
            if branch is None:
                return http_error(404, "remote branch not found")
            validate_remote_branch_record(branch)
            poll("bundle branch authority")
            transferred_branch = branch
            transferred_retained = branch_retained
            branch = None
            branch_retained = 0
            return 200, collect_http_bundle_payload(
                dirs["objects"],
                transferred_branch,
                transferred_retained,
                ledger,
                deadline,
            )
        finally:
            if branch_retained:
                if branch is not None:
                    branch.clear()
                ledger.release("retained_bytes", branch_retained)


def http_remote_branch(storage_root: Path, url: str) -> tuple[dict[str, Any], Path, dict[str, Any]]:
    info = parse_cf_http_url(url)
    project_root = http_project_root(storage_root, info["org"], info["app"])
    branch = read_remote_branch_record(project_root, info["branch"])
    if not branch:
        raise CFError(f"remote branch not found: {url}")
    validate_sealed_commit(remote_dirs(project_root)["objects"], branch["head"])
    return info, project_root, branch


def validate_http_merge_request_record(storage_root: Path, mr: dict[str, Any]) -> None:
    validate_persisted_record_version(mr, "remote_merge_request")
    validate_remote_component(str(mr.get("id", "")), "merge-request ID")
    source_info = parse_cf_http_url(mr["source_url"])
    source_root = http_project_root(storage_root, source_info["org"], source_info["app"])
    target_info = parse_cf_http_url(mr["target_url"])
    target_root = http_project_root(storage_root, target_info["org"], target_info["app"])
    source = {**source_info, "project_root": source_root}
    target = {**target_info, "project_root": target_root}
    source_objects = (
        remote_dirs(target_root)["objects"]
        if "subject" in mr
        else remote_dirs(source_root)["objects"]
    )
    refs = [
        ("source_head", source_objects, mr.get("source_head")),
        ("target_head_at_request", remote_dirs(target_root)["objects"], mr.get("target_head_at_request")),
    ]
    if mr.get("applied_head"):
        refs.append(("applied_head", remote_dirs(target_root)["objects"], mr.get("applied_head")))
    for key, objects_root, commit_id in refs:
        if not isinstance(commit_id, str):
            raise CFError(f"merge request validation failed: {key} must be a commit object id")
        try:
            validate_sealed_commit(objects_root, commit_id)
        except CFError as exc:
            raise CFError(f"merge request validation failed: {key}: {exc}") from exc
    if source_info["endpoint"] != target_info["endpoint"]:
        raise CFError("HTTP merge requests across different remote endpoints are not supported")
    if "subject" in mr:
        validate_merge_request_subject(mr, source, target)


def handle_http_request_merge(storage_root: Path, org: str, app: str, request: dict[str, Any]) -> tuple[int, dict[str, Any]]:
    project_root = http_project_root(storage_root, org, app)
    source_url = request.get("source_url")
    target_url = request.get("target_url")
    if not isinstance(source_url, str) or not isinstance(target_url, str):
        return http_error(400, "request-merge requires source_url and target_url")
    source_info = parse_cf_http_url(source_url)
    source_root = http_project_root(storage_root, source_info["org"], source_info["app"])
    target_info = parse_cf_http_url(target_url)
    target_root = http_project_root(storage_root, target_info["org"], target_info["app"])
    if target_root != project_root or target_info["org"] != org or target_info["app"] != app:
        return http_error(400, "target_url must belong to this project")
    info = {"org": org, "app": app}
    args = argparse.Namespace(actor=request.get("actor"), token=request.get("token"), request_signature=request.get("request_signature"))
    actor = authorize_remote(
        project_root,
        "request_merge",
        args,
        target=remote_request_target(info, "request_merge"),
        payload=request,
    )
    ensure_remote_layout(project_root)
    _, _, source_branch = http_remote_branch(storage_root, source_url)
    _, _, target_branch = http_remote_branch(storage_root, target_url)
    source_records = collect_object_records(remote_dirs(source_root)["objects"], source_branch["head"])
    object_set_digest = merge_request_object_set_digest(source_records)
    mr_payload = {
        "version": VERSION,
        "source_url": source_url,
        "source_head": source_branch["head"],
        "target_url": target_url,
        "target_head_at_request": target_branch["head"],
        "status": "open",
        "created_by": actor,
        "created_at": now_iso(),
    }
    mr_id = "MR-" + hashlib.sha256(canonical_json(mr_payload)).hexdigest()[:12]
    mr_payload["id"] = mr_id
    source_subject = {**source_info, "project_root": source_root}
    target_subject = {**target_info, "project_root": target_root}
    subject = build_merge_request_subject(
        mr_id,
        source_subject,
        target_subject,
        source_branch["head"],
        target_branch["head"],
        object_set_digest,
    )
    mr_payload["subject"] = subject
    mr_payload["subject_digest"] = merge_request_subject_digest(subject)
    with ordered_remote_merge_gates(source_root, target_root):
        _, _, locked_source = http_remote_branch(storage_root, source_url)
        _, locked_target_root, locked_target = http_remote_branch(storage_root, target_url)
        if locked_target_root != project_root:
            return http_error(400, "target_url must belong to this project")
        if locked_source["head"] != source_branch["head"] or locked_target["head"] != target_branch["head"]:
            return http_error(409, "request-merge source or target changed while acquiring project gate")
        copy_object_graph(remote_dirs(source_root)["objects"], remote_dirs(target_root)["objects"], source_branch["head"])
        result = execute_remote_json_publication(
            project_root,
            "remote_request_merge",
            actor,
            {
                "source_project_id": remote_project_stable_id(source_root),
                "target_project_id": remote_project_stable_id(target_root),
                "source_branch": source_info["branch"],
                "target_branch": target_info["branch"],
                "source_head": source_branch["head"],
                "target_head_at_request": target_branch["head"],
                "source_object_set_digest": object_set_digest,
            },
            [
                (
                    {"kind": "merge_request", "id": mr_id},
                    None,
                    mr_payload,
                )
            ],
            {
                "id": mr_id,
                "source_head": source_branch["head"],
                "target_head": target_branch["head"],
            },
            idempotency_key=request.get("idempotency_key") or None,
            object_roots=[source_branch["head"]],
        )
    return 200, result


MERGE_REQUEST_LIST_ENVELOPE_FIELD = "merge_requests"


class _HTTPMergeRequestListOperation:
    """Own one merge-request-list request's authority, sessions, and projection.

    Every retained path, parsed record, validation frontier, escrow digest byte,
    and projected field is charged to the caller's request ledger before it is
    allocated, and every deterministic boundary polls the caller's request
    deadline.  One ``SealedCommitValidationSession`` is reused per distinct
    pinned object-root subject so an immutable shared ancestry is read,
    validated, and revalidated once per request instead of once per reference.

    Capture never pre-empts a later record's fault.  Raw bytes, descriptor
    identity, and metadata ownership are pinned for every record in filename
    order, while each record's own read/parse/version outcome is retained and
    raised only when validation reaches that record — the exact point the
    pre-fix per-record route observed it.  Every consumed authority file is
    fenced by a final byte/metadata revalidation before publication.

    The deadline polling policy is one poll per bounded work quantum: one per
    directory entry, one per pinned record, one per deferred fault, one per
    validated record, one per sealed reference, one per frontier pop, one per
    visited reference, one per digested record pass, and one per revalidated
    authority — plus the per-chunk and per-item polls the shared byte, hash, and
    canonical-size helpers already perform.  No boundary is polled twice.
    """

    AUTHORITY_PHASE = "merge request list authority"
    VALIDATION_PHASE = "merge request list validation"
    PROJECTION_PHASE = "merge request list projection"
    REVALIDATION_PHASE = "merge request list snapshot revalidation"

    SESSION_INDEX_ENTRY_BYTES = 128
    BRANCH_INDEX_ENTRY_BYTES = 128
    PROJECT_IDENTITY_ENTRY_BYTES = 128
    RECORD_SLOT_BYTES = sys.getsizeof([None, None, None, None]) + 48
    AUTHORITY_CAPTURE_BYTES = sys.getsizeof({}) + 512
    ESCROW_MEMO_ENTRY_BYTES = 192
    ESCROW_ID_RETAINED_BYTES = 64
    ESCROW_SEEN_SLOT_BYTES = 64
    FRONTIER_FRAME_BYTES = 64
    CORE_VIEW_BASE_BYTES = sys.getsizeof({})
    CORE_VIEW_SLOT_BYTES = 64
    FIELD_SET_BASE_BYTES = sys.getsizeof(set())
    FIELD_SET_SLOT_BYTES = 64
    # One bounded envelope for the O(1) per-record endpoint views and the
    # sealed-reference plan built while validating a single merge request.
    RECORD_VALIDATION_SCRATCH_BYTES = 4096
    HASH_STREAM_TEMPORARY_BYTES = 128 * 1024
    # One bounded cleanup diagnostic: the log line stays fixed-size regardless of
    # how many owners a pathological cleanup faulted on.
    CLEANUP_FAULT_REPORT_LIMIT = 4

    def __init__(
        self,
        storage_root: Path,
        project_root: Path,
        dirs: dict[str, Path],
        ledger: DecisionWorkLedger,
        deadline: HTTPRequestDeadline | None = None,
    ) -> None:
        self.storage_root = storage_root
        self.project_root = project_root
        self.dirs = dirs
        self.ledger = ledger
        self.deadline = deadline
        self._sessions: dict[str, SealedCommitValidationSession] = {}
        # ``key -> exact index-entry bytes still owed`` so a retried cleanup
        # releases each session's ownership exactly once.
        self._session_entries: dict[str, int] = {}
        self._sessions_retained = 0
        self._paths: list[Path] = []
        self._paths_retained = 0
        # Each entry is ``[record, retained_bytes, status, deferred_fault]`` so
        # the projection can drop one pinned record's ownership as soon as it is
        # projected, and a capture-time fault is raised only in filename order.
        self._records: list[Any] = []
        self._records_retained = 0
        self._branches: dict[str, Any] = {}
        self._branches_retained = 0
        self._project_identities: dict[str, str] = {}
        self._project_identities_retained = 0
        # Ordered pinned-authority captures: every merge-request record in
        # filename order, then each consulted branch and project descriptor in
        # first-use order.  The final fence walks exactly this list.
        self._captures: list[dict[str, Any]] = []
        self._captures_retained = 0
        # ``(objects_root, source_head) -> (ordered_ids, digest)`` so many merge
        # requests sharing one pinned head reuse one traversal and one digest.
        self._escrow_sets: dict[str, tuple[list[str], str]] = {}
        self._escrow_memo_retained = 0
        self._escrow_ordered_retained = 0
        self._projection_retained = 0
        # Ownership handed back for release from an in-flight failure path.  Every
        # amount stays counted here until its exact ledger release succeeds, so a
        # retried cleanup releases only what is still owned.
        self._deferred_retained = 0
        self._deferred_temporary = 0
        # Every cleanup fault observed on this operation, newest last.  A fault is
        # recorded rather than swallowed even when a retry later succeeds.
        self._cleanup_faults: list[BaseException] = []
        self.cleanup_attempts = 0
        self.cleanup_recoveries = 0
        self._closed = False

    # ------------------------------------------------------------------
    # deadline boundaries
    # ------------------------------------------------------------------

    def poll(self, phase: str) -> None:
        if self.deadline is not None:
            self.deadline.check(phase)

    def _authority_poll(self) -> None:
        self.poll(self.AUTHORITY_PHASE)

    def _validation_poll(self) -> None:
        self.poll(self.VALIDATION_PHASE)

    def _projection_poll(self) -> None:
        self.poll(self.PROJECTION_PHASE)

    def _revalidation_poll(self) -> None:
        self.poll(self.REVALIDATION_PHASE)

    # ------------------------------------------------------------------
    # one sealed-validation session per distinct pinned object root
    # ------------------------------------------------------------------

    def session_for(self, objects_root: Path) -> "SealedCommitValidationSession":
        """Return this request's single session for one pinned object root."""
        key = os.path.abspath(objects_root)
        session = self._sessions.get(key)
        if session is not None:
            return session
        entry_bytes = (
            len(key.encode("utf-8")) + self.SESSION_INDEX_ENTRY_BYTES
        )
        self.ledger.acquire("retained_bytes", entry_bytes, "graph_discovery")
        self._sessions_retained += entry_bytes
        self._session_entries[key] = (
            self._session_entries.get(key, 0) + entry_bytes
        )
        # The index entry stays owned by this operation even when the session
        # cannot be constructed: cleanup releases it exactly once, with retry,
        # instead of dropping the amount on a failing release here.
        session = SealedCommitValidationSession(Path(key), self.ledger)
        self._sessions[key] = session
        return session

    # ------------------------------------------------------------------
    # pinned authority capture
    # ------------------------------------------------------------------

    # ------------------------------------------------------------------
    # deferred per-record capture outcomes
    # ------------------------------------------------------------------

    def _defer(self, entry: list[Any], exc: CFError) -> None:
        """Retain one record's capture fault without holding its frames."""
        exc.__traceback__ = None
        cause = exc.__cause__
        if cause is not None:
            cause.__traceback__ = None
        entry[3] = exc

    def _reserve_capture(self) -> dict[str, Any]:
        """Reserve one pinned-authority capture slot before it is filled."""
        self.ledger.acquire(
            "retained_bytes", self.AUTHORITY_CAPTURE_BYTES, "record_read"
        )
        self._captures_retained += self.AUTHORITY_CAPTURE_BYTES
        capture: dict[str, Any] = {}
        self._captures.append(capture)
        return capture

    def capture_authority(self) -> None:
        """Pin one deterministic merge-request authority snapshot.

        Raw bytes, descriptor identity, and metadata ownership are captured for
        every record in filename order.  A record's own read, no-follow, parse,
        or version fault is retained on its pinned entry instead of raised, so a
        later record can never pre-empt an earlier record's validation fault.
        """
        self._authority_poll()
        self._paths, self._paths_retained = accounted_sorted_json_paths(
            self.dirs["merge_requests"], self.ledger, self._authority_poll
        )
        for path in self._paths:
            self._authority_poll()
            # Reserve the pinned entry slot before the record it will own is
            # parsed, so no snapshot list grows on an unaccounted allocation.
            self.ledger.acquire(
                "retained_bytes", self.RECORD_SLOT_BYTES, "record_read"
            )
            self._records_retained += self.RECORD_SLOT_BYTES
            entry: list[Any] = [None, self.RECORD_SLOT_BYTES, None, None]
            self._records.append(entry)
            capture = self._reserve_capture()
            try:
                mr, retained = read_json_accounted(
                    path, self.ledger, poll=self._authority_poll, capture=capture
                )
            except (
                RequestDeadlineExceeded,
                ResourceBudgetExceeded,
                SealedValidationSubjectChanged,
            ):
                raise
            except OSError as exc:
                capture["absent"] = True
                capture["path"] = path
                self._defer(entry, filesystem_authority_error(path, exc))
                continue
            except CFError as exc:
                capture["absent"] = True
                capture["path"] = path
                self._defer(entry, exc)
                continue
            if mr is None:
                self._defer(
                    entry, CFError(f"merge request record is unavailable: {path}")
                )
                continue
            self._records_retained += retained
            entry[0] = mr
            entry[1] += retained
            try:
                validate_persisted_record_version(mr, "remote_merge_request")
            except CFError as exc:
                self._defer(entry, exc)
        self._paths.clear()
        if self._paths_retained:
            self.ledger.release("retained_bytes", self._paths_retained)
            self._paths_retained = 0

    def consulted_branch(self, target_root: Path, branch: str) -> Any:
        """Read one consulted branch head once per distinct pinned subject."""
        key = f"{os.path.abspath(target_root)}\x00{branch}"
        if key in self._branches:
            return self._branches[key]
        entry_bytes = (
            len(key.encode("utf-8")) + self.BRANCH_INDEX_ENTRY_BYTES
        )
        self.ledger.acquire("retained_bytes", entry_bytes, "record_read")
        self._branches_retained += entry_bytes
        path = remote_branch_path(target_root, branch)
        capture = self._reserve_capture()
        try:
            record, retained = read_json_accounted(
                path,
                self.ledger,
                poll=self._validation_poll,
                capture=capture,
            )
        except (
            RequestDeadlineExceeded,
            ResourceBudgetExceeded,
            SealedValidationSubjectChanged,
        ):
            raise
        except OSError as exc:
            capture["absent"] = True
            capture["path"] = path
            raise filesystem_authority_error(path, exc) from exc
        self._branches_retained += retained
        self._branches[key] = record
        if record is not None:
            validate_remote_branch_record(record)
        return record

    def stable_project_id(self, project_root: Path) -> str:
        """Own one accounted pinned descriptor read per request.

        The descriptor is opened once with no-follow, charged for exactly the
        bytes consumed, parsed from those owned bytes, and memoized; the pinned
        identity is fenced against same-metadata replacement by the final
        authority revalidation.
        """
        key = os.path.abspath(project_root)
        identity = self._project_identities.get(key)
        if identity is not None:
            return identity
        root = Path(key)
        path = root / "remote_project.json"
        capture = self._reserve_capture()
        try:
            descriptor, retained = read_json_accounted(
                path,
                self.ledger,
                limit=16 * 1024,
                poll=self._validation_poll,
                capture=capture,
            )
        except (
            RequestDeadlineExceeded,
            ResourceBudgetExceeded,
            SealedValidationSubjectChanged,
        ):
            raise
        except OSError as exc:
            capture["absent"] = True
            capture["path"] = path
            raise filesystem_authority_error(path, exc) from exc
        if descriptor is None:
            raise CFError(f"remote project descriptor is unavailable: {path}")
        try:
            # Stable pre-existing links are compatible authority: the capture
            # records the exact link count and the final fence rejects a change,
            # so a multi-link descriptor is not rejected on arrival.
            self.ledger.count("record_reads", 1, "record_read")
            identity = str(
                validate_remote_project_descriptor_value(
                    descriptor, root, root.parent.name, root.name
                )["stable_project_id"]
            )
        finally:
            if isinstance(descriptor, dict):
                descriptor.clear()
            descriptor = None
            self._defer_release("retained_bytes", "_deferred_retained", retained)
        entry_bytes = (
            len(key.encode("utf-8"))
            + len(identity.encode("utf-8"))
            + self.PROJECT_IDENTITY_ENTRY_BYTES
        )
        self.ledger.acquire("retained_bytes", entry_bytes, "record_read")
        self._project_identities_retained += entry_bytes
        self._project_identities[key] = identity
        return identity

    # ------------------------------------------------------------------
    # sealed-reference, URL, and subject validation
    # ------------------------------------------------------------------

    def validate_records(self) -> None:
        """Validate every pinned request in deterministic filename order.

        A record's retained capture fault is raised here, before any of its own
        URL, sealed-reference, or subject checks and after every earlier record
        has been fully validated, so first-error precedence is exactly the
        pre-fix per-record precedence.
        """
        for entry in self._records:
            self._validation_poll()
            fault = entry[3]
            if fault is not None:
                entry[3] = None
                raise fault
            mr = entry[0]
            source_info = parse_cf_http_url(mr["source_url"])
            source_root = http_project_root(
                self.storage_root, source_info["org"], source_info["app"]
            )
            target_info = parse_cf_http_url(mr["target_url"])
            target_root = http_project_root(
                self.storage_root, target_info["org"], target_info["app"]
            )
            if target_root != self.project_root:
                raise CFError(
                    "merge request target does not belong to the listed project"
                )
            reject_legacy_cross_project_merge_request_read(
                mr, source_root, target_root
            )
            self.validate_record(
                mr, source_info, source_root, target_info, target_root
            )
            current_target = self.consulted_branch(
                target_root, target_info["branch"]
            )
            status = mr.get("status", "open")
            if (
                current_target
                and current_target["head"] != mr["target_head_at_request"]
            ):
                status = "stale"
            entry[2] = status

    def validate_record(
        self,
        mr: dict[str, Any],
        source_info: dict[str, Any],
        source_root: Path,
        target_info: dict[str, Any],
        target_root: Path,
    ) -> None:
        """Validate one request's sealed references, URLs, and subject."""
        validate_remote_component(str(mr.get("id", "")), "merge-request ID")
        # Reserve the whole O(1) per-record scratch envelope before the endpoint
        # views and the sealed-reference plan are built.
        scratch = self.RECORD_VALIDATION_SCRATCH_BYTES
        self.ledger.acquire("temporary_bytes", scratch, "validation")
        refs: list[Any] = []
        try:
            source = {**source_info, "project_root": source_root}
            target = {**target_info, "project_root": target_root}
            source_objects = (
                remote_dirs(target_root)["objects"]
                if "subject" in mr
                else remote_dirs(source_root)["objects"]
            )
            refs = [
                ("source_head", source_objects, mr.get("source_head")),
                (
                    "target_head_at_request",
                    remote_dirs(target_root)["objects"],
                    mr.get("target_head_at_request"),
                ),
            ]
            if mr.get("applied_head"):
                refs.append(
                    (
                        "applied_head",
                        remote_dirs(target_root)["objects"],
                        mr.get("applied_head"),
                    )
                )
            for key, objects_root, commit_id in refs:
                self._validation_poll()
                if not isinstance(commit_id, str):
                    raise CFError(
                        f"merge request validation failed: {key} must be a commit object id"
                    )
                session = self.session_for(objects_root)
                try:
                    session.validate_commit(commit_id, self._validation_poll)
                except (
                    RequestDeadlineExceeded,
                    ResourceBudgetExceeded,
                    SealedValidationSubjectChanged,
                ):
                    raise
                except CFError as exc:
                    raise CFError(
                        f"merge request validation failed: {key}: {exc}"
                    ) from exc
            if source_info["endpoint"] != target_info["endpoint"]:
                raise CFError(
                    "HTTP merge requests across different remote endpoints are not supported"
                )
            refs.clear()
            if "subject" in mr:
                self.validate_subject(mr, source, target)
        finally:
            refs.clear()
            self.ledger.release("temporary_bytes", scratch)

    def validate_subject(
        self,
        mr: dict[str, Any],
        source: dict[str, Any],
        target: dict[str, Any],
    ) -> str:
        """Validate one materialized subject against the pinned escrow set."""
        subject = mr.get("subject")
        if not isinstance(subject, dict):
            raise CFError("merge request subject is malformed")
        source_head = mr.get("source_head")
        if not isinstance(source_head, str):
            raise CFError("merge request subject does not match the current request")
        objects_root = remote_dirs(target["project_root"])["objects"]
        session = self.session_for(objects_root)
        _, escrow_digest = self.escrow_object_set(session, source_head)
        source_project_id = subject.get("source_project_id")
        valid_source_project_id = (
            isinstance(source_project_id, str)
            and source_project_id.startswith("CF-PROJECT-")
            and len(source_project_id.removeprefix("CF-PROJECT-")) == 32
            and all(
                character in "0123456789abcdefABCDEF"
                for character in source_project_id.removeprefix("CF-PROJECT-")
            )
        )
        field_set_bytes = self.FIELD_SET_BASE_BYTES + (
            self.FIELD_SET_SLOT_BYTES * len(subject)
        )
        self.ledger.acquire("temporary_bytes", field_set_bytes, "query")
        try:
            observed_fields = set(subject)
            fields_match = observed_fields == MERGE_REQUEST_SUBJECT_FIELDS
            observed_fields = None
        finally:
            self.ledger.release("temporary_bytes", field_set_bytes)
        valid = (
            fields_match
            and subject.get("type") == "codefire_merge_request_subject"
            and subject.get("version") == VERSION
            and subject.get("merge_request_id") == mr.get("id")
            and valid_source_project_id
            and subject.get("target_project_id")
            == self.stable_project_id(target["project_root"])
            and subject.get("source_branch") == source.get("branch")
            and subject.get("target_branch") == target.get("branch")
            and subject.get("source_head") == source_head
            and subject.get("target_head_at_request")
            == mr.get("target_head_at_request")
            and subject.get("source_object_set_digest") == escrow_digest
        )
        if not valid:
            raise CFError("merge request subject does not match the current request")
        digest = self._digest_subject(subject)
        if mr.get("subject_digest") != digest:
            raise CFError("merge request subject digest diverged")
        return digest

    # ------------------------------------------------------------------
    # accounted escrow traversal and canonical digests
    # ------------------------------------------------------------------

    def _frontier_frame_bytes(self, object_id: str) -> int:
        return len(object_id.encode("utf-8")) + self.FRONTIER_FRAME_BYTES

    def escrow_object_set(
        self, session: "SealedCommitValidationSession", source_head: str
    ) -> tuple[list[str], str]:
        """Own one escrow traversal and digest per pinned ``(root, head)``.

        Many merge requests sharing one pinned source head reuse the same
        ordered object IDs and the same canonical set digest, so no physical
        read, traversal step, hash byte, or retained copy is repeated.  The
        session's final revalidation still fences every reused result.
        """
        key = f"{os.path.abspath(session.objects_root)}\x00{source_head}"
        memo = self._escrow_sets.get(key)
        if memo is not None:
            return memo
        entry_bytes = len(key.encode("utf-8")) + self.ESCROW_MEMO_ENTRY_BYTES
        self.ledger.acquire("retained_bytes", entry_bytes, "graph_discovery")
        self._escrow_memo_retained += entry_bytes
        ordered, ordered_retained = self._collect_escrow_object_ids(
            session, source_head
        )
        self._escrow_ordered_retained += ordered_retained
        try:
            digest = self._digest_escrow_records(session, ordered)
        except BaseException:
            # Ownership stays counted on the operation so cleanup releases it
            # exactly once, with retry, instead of losing it to a failing release.
            ordered.clear()
            raise
        memo = (ordered, digest)
        self._escrow_sets[key] = memo
        return memo

    def _collect_escrow_object_ids(
        self, session: "SealedCommitValidationSession", source_head: str
    ) -> tuple[list[str], int]:
        """Traverse one escrow object set through this session's memo."""
        ordered: list[str] = []
        ordered_retained = 0
        seen: set[str] = set()
        seen_retained = 0
        stack: list[str] = []
        stack_retained = [0]

        def push(reference: str) -> None:
            frame_bytes = self._frontier_frame_bytes(reference)
            self.ledger.apply(
                "graph_discovery",
                charges={"graph_edges": 1},
                maxima={"maximum_frontier": len(stack) + 1},
                acquires={"retained_bytes": frame_bytes},
                counters={
                    "edge_occurrences": 1,
                    "frontier_insertion_attempts": 1,
                },
            )
            stack_retained[0] += frame_bytes
            stack.append(reference)

        try:
            root_frame = self._frontier_frame_bytes(source_head)
            self.ledger.apply(
                "graph_discovery",
                maxima={"maximum_frontier": 1},
                acquires={"retained_bytes": root_frame},
                counters={"frontier_insertion_attempts": 1},
            )
            stack_retained[0] += root_frame
            stack.append(source_head)
            while stack:
                self._validation_poll()
                object_id = stack.pop()
                frame_bytes = self._frontier_frame_bytes(object_id)
                stack_retained[0] -= frame_bytes
                self.ledger.release("retained_bytes", frame_bytes)
                if object_id in seen:
                    self.ledger.count("revisits", 1, "graph_discovery")
                    continue
                seen_slot = (
                    len(object_id.encode("utf-8")) + self.ESCROW_SEEN_SLOT_BYTES
                )
                self.ledger.acquire(
                    "retained_bytes", seen_slot, "graph_discovery"
                )
                seen_retained += seen_slot
                seen.add(object_id)
                id_bytes = (
                    len(object_id.encode("utf-8")) + self.ESCROW_ID_RETAINED_BYTES
                )
                self.ledger.acquire("retained_bytes", id_bytes, "graph_discovery")
                ordered_retained += id_bytes
                ordered.append(object_id)
                try:
                    session.load_payload(object_id, self._validation_poll)
                except (
                    RequestDeadlineExceeded,
                    ResourceBudgetExceeded,
                    SealedValidationSubjectChanged,
                ):
                    raise
                except CFError:
                    if object_record_path(session.objects_root, object_id) is None:
                        raise CFError(
                            f"object not found while bundling: {object_id}"
                        ) from None
                    raise
                visit_object_record_references(
                    session.documents[object_id].record,
                    push,
                    self._validation_poll,
                )
            sort_scratch = ordered_retained + 8 * len(ordered)
            self.ledger.acquire("temporary_bytes", sort_scratch, "query")
            try:
                _sort_strings_polling(ordered, self._validation_poll)
            finally:
                self.ledger.release("temporary_bytes", sort_scratch)
            previous: str | None = None
            for object_id in ordered:
                self._validation_poll()
                if not object_id:
                    raise CFError(
                        "remote object set contains a record without an object ID"
                    )
                if object_id == previous:
                    raise CFError(
                        "remote object set contains a duplicate object ID"
                    )
                previous = object_id
            return ordered, ordered_retained
        except BaseException:
            ordered.clear()
            self._defer_release(
                "retained_bytes", "_deferred_retained", ordered_retained
            )
            raise
        finally:
            seen.clear()
            self._defer_release("retained_bytes", "_deferred_retained", seen_retained)
            stack.clear()
            self._defer_release(
                "retained_bytes", "_deferred_retained", stack_retained[0]
            )

    @contextlib.contextmanager
    def _hash_envelope(self, exact_bytes: int):
        """Charge one streaming canonical hash before its first byte."""
        self.ledger.apply(
            "semantic_validation",
            charges={"aggregate_bytes": exact_bytes},
            acquires={"temporary_bytes": self.HASH_STREAM_TEMPORARY_BYTES},
            counters={"bytes_hashed": exact_bytes},
        )
        try:
            yield hashlib.sha256()
        finally:
            self.ledger.release(
                "temporary_bytes", self.HASH_STREAM_TEMPORARY_BYTES
            )

    def _digest_escrow_records(
        self, session: "SealedCommitValidationSession", ordered: list[str]
    ) -> str:
        """Digest the exact canonical escrow set without one full encoding."""
        exact_bytes = 2 + max(0, len(ordered) - 1)
        for object_id in ordered:
            # ``_object_record_core_json_size`` polls once per record field, so
            # the sizing pass needs no second poll of its own.
            exact_bytes += _object_record_core_json_size(
                session.documents[object_id].record, self._validation_poll
            )
        with self._hash_envelope(exact_bytes) as digest:
            digest.update(b"[")
            for index, object_id in enumerate(ordered):
                if index:
                    digest.update(b",")
                record = session.documents[object_id].record
                view_bytes = self.CORE_VIEW_BASE_BYTES + (
                    self.CORE_VIEW_SLOT_BYTES * len(record)
                )
                self.ledger.acquire("temporary_bytes", view_bytes, "encoding")
                core: dict[str, Any] | None = None
                try:
                    core = object_record_core(record)
                    _hash_canonical_json_polling(
                        digest, core, self._validation_poll
                    )
                finally:
                    if core is not None:
                        core.clear()
                    core = None
                    self.ledger.release("temporary_bytes", view_bytes)
            digest.update(b"]")
            return "sha256:" + digest.hexdigest()

    def _digest_subject(self, subject: dict[str, Any]) -> str:
        """Digest one pinned subject with its exact canonical bytes charged."""
        exact_bytes = canonical_json_size_up_to(
            subject, U64_MAX, self._validation_poll
        )
        with self._hash_envelope(exact_bytes) as digest:
            _hash_canonical_json_polling(digest, subject, self._validation_poll)
            return "sha256:" + digest.hexdigest()

    # ------------------------------------------------------------------
    # projection and the final snapshot fence
    # ------------------------------------------------------------------

    def project(self) -> AccountedHTTPMergeRequestList:
        """Prepare the whole response projection before any final fence."""
        self._projection_poll()
        requests: list[dict[str, Any]] = []
        envelope_bytes = canonical_json_size_up_to(
            {MERGE_REQUEST_LIST_ENVELOPE_FIELD: requests},
            U64_MAX,
            self._projection_poll,
        )
        self.ledger.acquire("retained_bytes", envelope_bytes, "encoding")
        self._projection_retained = envelope_bytes
        for position, entry in enumerate(self._records):
            self._projection_poll()
            mr, retained, status, _ = entry
            projection = {
                "id": mr["id"],
                "status": status,
                "source_url": mr["source_url"],
                "target_url": mr["target_url"],
            }
            entry_bytes = canonical_json_size_up_to(
                projection, U64_MAX, self._projection_poll
            )
            if requests:
                entry_bytes += 1
            self.ledger.acquire("retained_bytes", entry_bytes, "encoding")
            self._projection_retained += entry_bytes
            requests.append(projection)
            projection = None
            self._records[position] = None
            entry[0] = None
            mr.clear()
            mr = None
            self.ledger.release("retained_bytes", retained)
            self._records_retained -= retained
        self._records.clear()
        payload = AccountedHTTPMergeRequestList(
            self.ledger, requests, self._projection_retained
        )
        self._projection_retained = 0
        return payload

    def finalize_authority(self) -> None:
        """Fence every consumed authority file after the response is prepared.

        Each pinned merge-request record, consulted branch record, and project
        descriptor is re-read no-follow and reproved against its captured parent
        identity, descriptor identity, mode, link count, size, and content
        digest, so a same-metadata replacement of any consumed authority is
        rejected instead of published.  Each proven capture's ownership is
        released inside this fence, so no capture-proportional work remains
        between the terminal fence and the first response byte.
        """
        for position, capture in enumerate(self._captures):
            if not capture:
                continue
            self._revalidation_poll()
            revalidate_json_authority_capture(
                capture, self.ledger, self._revalidation_poll
            )
            capture.clear()
            self._captures[position] = {}
            self._release_exact(
                "retained_bytes", "_captures_retained", self.AUTHORITY_CAPTURE_BYTES
            )

    def finalize_sessions(self) -> None:
        """Fence every pinned object-root subject after the projection exists."""
        for key in sorted(self._sessions):
            self._revalidation_poll()
            self._sessions[key].finalize(
                terminate=False, poll=self._revalidation_poll
            )

    # ------------------------------------------------------------------
    # retryable cleanup
    # ------------------------------------------------------------------

    def _release(self, dimension: str, attribute: str) -> BaseException | None:
        """Release one owner scalar, keeping retry ownership until it succeeds.

        The owner is zeroed only after its exact ledger release succeeds, so a
        failed release leaves the amount owned and retryable and can never be
        released twice.
        """
        amount = getattr(self, attribute)
        if not amount:
            return None
        try:
            self.ledger.release(dimension, amount)
        except BaseException as error:
            self._cleanup_faults.append(error)
            return error
        setattr(self, attribute, 0)
        return None

    def _release_exact(
        self, dimension: str, attribute: str, amount: int
    ) -> BaseException | None:
        """Release one exact portion of an owner scalar, never over-releasing.

        An amount larger than the owner still holds is an accounting defect, not
        a condition to absorb: it fails closed with a typed diagnostic so a future
        double-release can never be masked by defensive silence.
        """
        owned = getattr(self, attribute)
        if not amount:
            return None
        if amount > owned:
            error = CFError(
                f"{OWNER_OVER_RELEASE_DIAGNOSTIC}: {attribute} owns {owned}, "
                f"release requested {amount}"
            )
            self._cleanup_faults.append(error)
            return error
        try:
            self.ledger.release(dimension, amount)
        except BaseException as error:
            self._cleanup_faults.append(error)
            return error
        setattr(self, attribute, owned - amount)
        return None

    def _defer_release(self, dimension: str, attribute: str, amount: int) -> None:
        """Hand one in-flight amount to a retryable owner and try to release it."""
        if not amount:
            return
        setattr(self, attribute, getattr(self, attribute) + amount)
        self._release(dimension, attribute)

    def first_cleanup_fault(self) -> BaseException | None:
        """Return the first cleanup fault observed on this operation."""
        return self._cleanup_faults[0] if self._cleanup_faults else None

    def cleanup_diagnostic(self) -> dict[str, Any] | None:
        """Summarize the cleanup faults this operation observed, or ``None``.

        The result is consumed on the production path — as a note on a primary
        error, or through the handler's own error log — so no cleanup evidence is
        write-only state.
        """
        if not self._cleanup_faults:
            return None
        return {
            "attempts": self.cleanup_attempts,
            "recovered": self.cleanup_recoveries > 0 and self._closed,
            "faults": [
                f"{type(fault).__name__}: {fault}"
                for fault in self._cleanup_faults[: self.CLEANUP_FAULT_REPORT_LIMIT]
            ],
            "fault_count": len(self._cleanup_faults),
        }

    def close(self) -> BaseException | None:
        """Release every owner, returning the first still-unreleased fault.

        Nothing is zeroed, detached, or removed from a map before its exact
        ledger release or session close succeeds, so a second call after a
        partial cleanup releases only what is still owned and can never
        double-release.  ``None`` means every owner reached zero.
        """
        if self._closed:
            return None
        self.cleanup_attempts += 1
        first: BaseException | None = None

        def attempt(dimension: str, attribute: str) -> None:
            nonlocal first
            error = self._release(dimension, attribute)
            if error is not None and first is None:
                first = error

        self._paths.clear()
        attempt("retained_bytes", "_paths_retained")
        for entry in self._records:
            if entry is None:
                continue
            if entry[0] is not None:
                entry[0].clear()
                entry[0] = None
            entry[3] = None
        attempt("retained_bytes", "_records_retained")
        if not self._records_retained:
            self._records.clear()
        for position, capture in enumerate(self._captures):
            capture.clear()
            self._captures[position] = {}
        attempt("retained_bytes", "_captures_retained")
        if not self._captures_retained:
            self._captures.clear()
        for ordered, _ in self._escrow_sets.values():
            ordered.clear()
        attempt("retained_bytes", "_escrow_ordered_retained")
        attempt("retained_bytes", "_escrow_memo_retained")
        if not (self._escrow_ordered_retained or self._escrow_memo_retained):
            self._escrow_sets.clear()
        for record in self._branches.values():
            if isinstance(record, dict):
                record.clear()
        attempt("retained_bytes", "_branches_retained")
        if not self._branches_retained:
            self._branches.clear()
        attempt("retained_bytes", "_project_identities_retained")
        if not self._project_identities_retained:
            self._project_identities.clear()
        attempt("retained_bytes", "_projection_retained")
        attempt("temporary_bytes", "_deferred_temporary")
        attempt("retained_bytes", "_deferred_retained")
        for key in sorted(self._sessions):
            session = self._sessions[key]
            try:
                # ``SealedCommitValidationSession.close`` is itself idempotent and
                # keeps its own unreleased scalars, so a retry finishes exactly
                # the remaining part of a partial close.
                session.close(None)
            except BaseException as error:
                self._cleanup_faults.append(error)
                if first is None:
                    first = error
                continue
            error = self._release_exact(
                "retained_bytes",
                "_sessions_retained",
                self._session_entries.get(key, 0),
            )
            if error is not None:
                if first is None:
                    first = error
                continue
            self._session_entries.pop(key, None)
            del self._sessions[key]
        # Index ownership whose session was never constructed has no close step to
        # complete, so it is released here by its own exact amount.
        for key in sorted(self._session_entries):
            if key in self._sessions:
                continue
            error = self._release_exact(
                "retained_bytes", "_sessions_retained", self._session_entries[key]
            )
            if error is not None:
                if first is None:
                    first = error
                continue
            self._session_entries.pop(key, None)
        # Whatever remains belongs to a session whose close or exact release has
        # not succeeded yet.  Releasing the aggregate here would double-release it
        # on the next attempt, so only genuinely unaccounted ownership is released.
        outstanding = sum(self._session_entries.values())
        residual = self._sessions_retained - outstanding
        if residual > 0:
            error = self._release_exact(
                "retained_bytes", "_sessions_retained", residual
            )
            if error is not None and first is None:
                first = error
        if first is None:
            self._closed = True
            if self.cleanup_attempts > 1:
                self.cleanup_recoveries += 1
        return first


def collect_http_merge_request_list_payload(
    storage_root: Path,
    project_root: Path,
    dirs: dict[str, Path],
    ledger: DecisionWorkLedger,
    deadline: HTTPRequestDeadline | None = None,
    *,
    response_slot: "_HTTPReadResponseSlot | None" = None,
    gate: "_RemoteProjectGateFence | None" = None,
) -> AccountedHTTPMergeRequestList | None:
    """Project every merge request from one pinned authority snapshot.

    One request-ledger-bound ``SealedCommitValidationSession`` per distinct
    pinned object root validates every sealed reference and escrow record.

    With ``response_slot`` this function's part of the prepublication order is:
    project the whole payload, encode the complete accounted response into the
    caller's prepared owner, fence every pinned authority capture, fence every
    sealed session, fence the pinned project root/locks/descriptor, and release
    every operation owner with retry.  ``None`` is returned in that case because
    the response already exists as bytes.

    The authority, session, and project fences are the last *authority-dependent*
    boundaries: after the project fence no authority path is read and no pinned
    identity is compared again.  They are deliberately **not** the last fallible
    boundary — the pinned lock and gate descriptors are still unlocked and closed
    when this route's context managers unwind.  The final publishable proof is
    therefore owned by the handler and runs after those teardowns; see
    ``_HTTPReadResponseSlot.prove_and_take``.

    Without ``response_slot`` the pinned projection is returned for the caller to
    encode, which keeps the legacy read-route shape available.
    """
    operation = _HTTPMergeRequestListOperation(
        storage_root, project_root, dirs, ledger, deadline
    )
    payload: AccountedHTTPMergeRequestList | None = None
    primary: BaseException | None = None
    prepared_here = False
    try:
        operation.capture_authority()
        operation.validate_records()
        payload = operation.project()
        if response_slot is not None:
            # The prepared owner takes over the projection's ownership here, so
            # every terminal fence below runs with the response already encoded.
            response_slot.prepare(200, payload)
            payload = None
            prepared_here = True
        operation.finalize_authority()
        operation.finalize_sessions()
        operation.poll(_HTTPMergeRequestListOperation.PROJECTION_PHASE)
        if gate is not None and response_slot is not None:
            gate.fence()
    except BaseException as error:
        primary = error
    payload, primary = _finish_merge_request_list_operation(
        operation, payload, primary, response_slot=response_slot
    )
    if primary is not None:
        if prepared_here and response_slot is not None:
            try:
                response_slot.dispose()
            except BaseException as error:
                record_secondary_failure(primary, error)
        raise primary
    if response_slot is not None and prepared_here:
        # The handler proves the publishable state after this route and both of
        # its pinned context managers have finished unwinding.
        return None
    return payload


def record_secondary_failure(
    primary: BaseException, secondary: BaseException
) -> BaseException:
    """Record one cleanup failure without displacing the primary diagnostic.

    Cleanup faults are never swallowed: the selected primary error keeps its own
    diagnostic and carries every recorded cleanup failure with it, so the
    supported terminal protocol still observes both.
    """
    note = (
        "cleanup failed while completing this failure: "
        f"{type(secondary).__name__}: {secondary}"
    )
    recorded = getattr(primary, "codefire_cleanup_failures", None)
    if recorded is None:
        recorded = []
        try:
            setattr(primary, "codefire_cleanup_failures", recorded)
        except BaseException:
            recorded = None
    if recorded is not None:
        recorded.append(secondary)
    add_note = getattr(primary, "add_note", None)
    if add_note is not None:
        try:
            add_note(note)
        except BaseException:
            pass
    return primary


# One cleanup attempt plus one exact retry: the retry releases only the owners a
# partial cleanup still holds, so a single transient release fault still reaches
# zero retained bytes, zero temporary bytes, and zero permits.
CLEANUP_RELEASE_ATTEMPTS = 2


def close_with_retry(operation: Any) -> BaseException | None:
    """Complete one operation's cleanup, retrying only unreleased ownership."""
    error: BaseException | None = None
    for _ in range(CLEANUP_RELEASE_ATTEMPTS):
        error = operation.close()
        if error is None:
            return None
    return error


def _finish_merge_request_list_operation(
    operation: "_HTTPMergeRequestListOperation",
    payload: AccountedHTTPMergeRequestList | None,
    primary: BaseException | None,
    *,
    response_slot: "_HTTPReadResponseSlot | None" = None,
) -> tuple[AccountedHTTPMergeRequestList | None, BaseException | None]:
    """Release every operation owner before any response can be published.

    A success may not publish until cleanup proves that every retained scalar,
    temporary scalar, session, and escrow owner reached zero; an unrecoverable
    cleanup fault therefore becomes the request's failure instead of a published
    200 with hidden current work.  A fault a retry repaired is consumed instead of
    being written to unread state: it becomes a primary-error note when the
    request already failed, and otherwise reaches the handler's own error log.
    """
    if primary is not None and payload is not None:
        try:
            payload.close()
        except BaseException as error:
            record_secondary_failure(primary, error)
        payload = None
    cleanup_error = close_with_retry(operation)
    diagnostic = operation.cleanup_diagnostic()
    if cleanup_error is None:
        if diagnostic is not None:
            if primary is not None:
                record_secondary_failure(primary, operation.first_cleanup_fault())
            elif response_slot is not None:
                response_slot.report_cleanup_recovery(diagnostic)
        return payload, primary
    if primary is not None:
        record_secondary_failure(primary, cleanup_error)
        return payload, primary
    if payload is not None:
        try:
            payload.close()
        except BaseException:
            pass
        payload = None
    return None, cleanup_error


def handle_http_request_list(
    storage_root: Path,
    org: str,
    app: str,
    ledger: DecisionWorkLedger,
    deadline: HTTPRequestDeadline | None = None,
    *,
    response_slot: "_HTTPReadResponseSlot | None" = None,
) -> tuple[int, dict[str, Any] | None]:
    """List every merge request under the caller's request ledger.

    When ``response_slot`` is supplied the complete accounted response is encoded
    into it before the terminal authority/session/project fence, cleanup runs
    before publication, and the handler publishes the prepared bytes as the first
    fallible step after the fence.  The publication point is exactly
    ``_HTTPReadResponseSlot.take`` followed by ``prepared.publish``.
    """
    if deadline is not None:
        deadline.check("merge request list planning")
    project_root = http_project_root(storage_root, org, app)
    dirs = remote_dirs(project_root)
    if not dirs["merge_requests"].exists():
        return http_error(404, "remote project not found")
    if deadline is not None:
        deadline.check("merge request list project gate")
    with remote_project_gate(project_root, shared=True) as gate:
        return 200, collect_http_merge_request_list_payload(
            storage_root,
            project_root,
            dirs,
            ledger,
            deadline,
            response_slot=response_slot,
            gate=gate,
        )


def handle_http_request_review(storage_root: Path, org: str, app: str, mr_id: str, request: dict[str, Any]) -> tuple[int, dict[str, Any]]:
    project_root = http_project_root(storage_root, org, app)
    dirs = remote_dirs(project_root)
    info = {"org": org, "app": app}
    args = argparse.Namespace(actor=request.get("actor"), token=request.get("token"), request_signature=request.get("request_signature"))
    actor = authorize_remote(
        project_root,
        "review",
        args,
        target=remote_request_target(info, "review", mr_id=mr_id),
        payload=request,
    )
    mr_path = remote_merge_request_path(project_root, mr_id)
    mr = read_remote_merge_request_path(mr_path)
    if not mr:
        return http_error(404, "merge request not found")
    initial_source_url = mr.get("source_url")
    initial_target_url = mr.get("target_url")
    target_info = parse_cf_http_url(mr["target_url"])
    target_root = http_project_root(storage_root, target_info["org"], target_info["app"])
    if target_root != project_root:
        return http_error(400, "merge request target does not belong to this project")
    decision = request.get("decision")
    if decision not in {"approve", "reject"}:
        return http_error(400, "review decision must be approve or reject")
    reviewer = request.get("reviewer")
    if not isinstance(reviewer, str) or not reviewer:
        return http_error(400, "reviewer is required")
    source_info = parse_cf_http_url(mr["source_url"])
    source_root = http_project_root(storage_root, source_info["org"], source_info["app"])
    review_gate = (
        remote_project_gate(target_root)
        if "subject" in mr
        else ordered_remote_merge_gates(source_root, target_root)
    )
    with review_gate:
        mr = read_remote_merge_request_path(mr_path)
        if not mr:
            return http_error(404, "merge request not found")
        if (
            mr.get("source_url") != initial_source_url
            or mr.get("target_url") != initial_target_url
        ):
            raise CFError(
                "merge request endpoints changed while acquiring project gates"
            )
        validate_http_merge_request_record(storage_root, mr)
        target_info = parse_cf_http_url(mr["target_url"])
        target_root = http_project_root(storage_root, target_info["org"], target_info["app"])
        current_target = read_remote_branch_record(target_root, target_info["branch"])
        subject_is_materialized = "subject" in mr
        if (
            not subject_is_materialized
            and current_target
            and current_target["head"] != mr["target_head_at_request"]
        ):
            return http_error(409, f"merge request is stale: {mr_id}")
        mr_before = dict(mr)
        subject_digest = materialize_merge_request_subject(
            mr,
            {**source_info, "project_root": source_root},
            {**target_info, "project_root": target_root},
        )
        comment = request.get("comment") if isinstance(request.get("comment"), str) else ""
        review = {
            "reviewer": reviewer,
            "decision": decision,
            "comment": comment,
            "subject_digest": subject_digest,
            "reviewed_at": now_iso(),
        }
        reviews = list(mr.get("reviews", []))
        reviews.append(review)
        mr["reviews"] = reviews
        mr["status"] = "approved" if decision == "approve" else "rejected"
        semantic = {
            "stable_project_id": remote_project_stable_id(project_root),
            "merge_request_id": mr_id,
            "reviewer": reviewer,
            "decision": decision,
            "comment": comment,
            "subject_digest": subject_digest,
        }
        writes = [
            (
                {"kind": "merge_request", "id": mr_id},
                mr_before,
                mr,
            )
        ]
        result = {"id": mr_id, "reviewer": reviewer, "decision": decision}
        idempotency_key = request.get("idempotency_key") or None
        if remote_publication_recovery_exists(
            project_root,
            "remote_request_review",
            actor,
            idempotency_key,
        ):
            return 200, execute_remote_json_publication(
                project_root,
                "remote_request_review",
                actor,
                semantic,
                writes,
                result,
                idempotency_key=idempotency_key,
                object_roots=[str(mr["source_head"])],
            )
        if (
            subject_is_materialized
            and current_target
            and current_target["head"] != mr["target_head_at_request"]
        ):
            return http_error(409, f"merge request is stale: {mr_id}")
        result = execute_remote_json_publication(
            project_root,
            "remote_request_review",
            actor,
            semantic,
            writes,
            result,
            idempotency_key=idempotency_key,
            object_roots=[str(mr["source_head"])],
        )
    return 200, result


def handle_http_request_apply(storage_root: Path, org: str, app: str, mr_id: str, request: dict[str, Any]) -> tuple[int, dict[str, Any]]:
    project_root = http_project_root(storage_root, org, app)
    dirs = remote_dirs(project_root)
    info = {"org": org, "app": app}
    args = argparse.Namespace(actor=request.get("actor"), token=request.get("token"), request_signature=request.get("request_signature"))
    actor = authorize_remote(
        project_root,
        "apply",
        args,
        target=remote_request_target(info, "apply", mr_id=mr_id),
        payload=request,
    )
    mr_path = remote_merge_request_path(project_root, mr_id)
    mr = read_remote_merge_request_path(mr_path)
    if not mr:
        return http_error(404, "merge request not found")
    validate_http_merge_request_record(storage_root, mr)
    source_info = parse_cf_http_url(mr["source_url"])
    source_root = http_project_root(storage_root, source_info["org"], source_info["app"])
    target_info = parse_cf_http_url(mr["target_url"])
    target_root = http_project_root(storage_root, target_info["org"], target_info["app"])
    if target_root != project_root or target_info["org"] != org or target_info["app"] != app:
        return http_error(400, "target_url must belong to this project")
    subject_digest = validate_merge_request_subject(
        mr,
        {**source_info, "project_root": source_root},
        {**target_info, "project_root": target_root},
    )
    source_head = str(mr["source_head"])
    semantic = {
        "stable_project_id": remote_project_stable_id(target_root),
        "merge_request_id": mr_id,
        "subject_digest": subject_digest,
        "target_branch": target_info["branch"],
        "source_head": source_head,
        "target_head_at_request": mr["target_head_at_request"],
    }
    result = {
        "id": mr_id,
        "target_branch": target_info["branch"],
        "head": source_head,
    }
    idempotency_key = request.get("idempotency_key") or None
    if remote_publication_recovery_exists(
        target_root, "remote_request_apply", actor, idempotency_key
    ):
        with remote_project_gate(target_root):
            current_generation = read_json(remote_generation_path(target_root))
            current_target = read_remote_branch_record(
                target_root, target_info["branch"]
            )
            current_mr = read_remote_merge_request_path(mr_path)
            recovered = execute_remote_json_publication(
                target_root,
                "remote_request_apply",
                actor,
                semantic,
                [
                    ({"kind": "generation"}, current_generation, current_generation),
                    (
                        {"kind": "branch", "name": target_info["branch"]},
                        current_target,
                        current_target,
                    ),
                    (
                        {"kind": "merge_request", "id": mr_id},
                        current_mr,
                        current_mr,
                    ),
                ],
                result,
                idempotency_key=idempotency_key,
                object_roots=list(
                    dict.fromkeys([source_head, str(mr["target_head_at_request"])])
                ),
            )
        return 200, recovered
    if mr.get("status") != "approved":
        return http_error(409, f"merge request must be approved before apply: {mr_id}")
    target_info, target_root, target_branch = http_remote_branch(storage_root, mr["target_url"])
    if target_root != project_root or target_info["org"] != org or target_info["app"] != app:
        return http_error(400, "target_url must belong to this project")
    if not merge_request_has_effective_approval(mr, subject_digest):
        return http_error(409, f"merge request approval is not bound to its current subject: {mr_id}")
    check_remote_branch_protection(target_root, target_info["branch"], "apply", actor)
    if target_branch["head"] != mr["target_head_at_request"]:
        return http_error(409, f"merge request is stale: {mr_id}")
    escrow_objects = remote_dirs(target_root)["objects"]
    enforce_remote_commit_signature_policy(target_root, escrow_objects, source_head)
    if not remote_is_ancestor(target_root, target_branch["head"], source_head):
        return http_error(409, "request apply rejected: source is not a fast-forward of target")
    with remote_project_gate(target_root):
        current_mr = read_remote_merge_request_path(mr_path)
        if current_mr != mr:
            return http_error(409, f"merge request changed while acquiring project gate: {mr_id}")
        current_target = read_remote_branch_record(target_root, target_info["branch"])
        if current_target["head"] != mr["target_head_at_request"]:
            return http_error(409, f"merge request is stale: {mr_id}")
        generation_before = read_json(remote_generation_path(target_root))
        generation = (
            generation_before.get("current_generation", 0)
            if isinstance(generation_before, dict)
            else 0
        ) + 1
        branch_after = {
            "version": VERSION,
            "name": target_info["branch"],
            "head": source_head,
            "generation": generation,
            "applied_from": mr["source_url"],
            "applied_by": actor,
            "transport": "http",
            "updated_at": now_iso(),
        }
        mr_after = dict(mr)
        mr_after["status"] = "applied"
        mr_after["applied_at"] = now_iso()
        mr_after["applied_by"] = actor
        mr_after["applied_head"] = source_head
        result = execute_remote_json_publication(
            target_root,
            "remote_request_apply",
            actor,
            semantic,
            [
                (
                    {"kind": "generation"},
                    generation_before,
                    {"current_generation": generation},
                ),
                (
                    {"kind": "branch", "name": target_info["branch"]},
                    current_target,
                    branch_after,
                ),
                (
                    {"kind": "merge_request", "id": mr_id},
                    mr,
                    mr_after,
                ),
            ],
            result,
            idempotency_key=idempotency_key,
            object_roots=list(
                dict.fromkeys([source_head, str(mr["target_head_at_request"])])
            ),
        )
    return 200, result


def handle_http_upload(
    storage_root: Path,
    org: str,
    app: str,
    branch_name: str,
    request: dict[str, Any],
    *,
    response_slot: Any | None = None,
    decision_work: DecisionWorkLedger | None = None,
    deadline: HTTPRequestDeadline | None = None,
) -> tuple[int, dict[str, Any]]:
    project_root = http_project_root(storage_root, org, app)
    dirs = remote_dirs(project_root)
    local_branch = str(request.get("branch", ""))
    head = request.get("head")
    records = request.get("objects", [])
    if not local_branch or not isinstance(head, str) or not head.startswith("CF-COMMIT-") or not isinstance(records, list):
        return http_error(400, "upload request must include branch, head, and objects")
    records = canonical_remote_object_records(records)
    info = {"org": org, "app": app}
    args = argparse.Namespace(actor=request.get("actor"), token=request.get("token"), request_signature=request.get("request_signature"))
    actor = actor_from_args(args)
    idempotency_key = request.get("idempotency_key")
    validate_remote_json_publication_subject(
        "remote_upload", actor, idempotency_key
    )
    actor, nonce_plan = authorize_remote_without_nonce(
        project_root,
        "upload",
        args,
        remote_request_target(info, "upload", branch=branch_name),
        request,
    )
    check_remote_branch_protection(project_root, branch_name, "upload", actor)
    closure = plan_http_upload_closure(
        dirs["objects"], head, records, decision_work, deadline
    )
    result = {"branch": branch_name, "head": head}
    project_existed = (project_root / "remote_project.json").is_file()
    stage_owner: AccountedHTTPUploadStage | None = None
    sealed_validation_owner: AccountedHTTPUploadSealedValidation | None = None
    sealed_validation_bounds: tuple[int, int, int] | None = None
    publication_root_proof: RemoteJSONPublicationRootProof | None = None
    publication_identity: RemoteJSONPublicationIdentity | None = None
    tmp_root: Path | None = None
    tmp_objects: Path | None = None
    publication_succeeded = False

    def fence_first_effect(phase: str) -> None:
        """Poll the exact request deadline immediately before an effect.

        Every externally visible effect of this request -- the bootstrap layout,
        the object copy, the branch/generation publication, the nonce, the
        receipt -- is preceded by this poll, so an already-elapsed deadline
        raises the typed outcome with the authority still byte-identical
        instead of publishing and answering 200.
        """
        if deadline is not None:
            deadline.check(phase)

    def seal_validated_snapshot() -> None:
        """Revalidate the one validated snapshot before leaving validation.

        ``finish`` re-reads every retained document, re-checks the store identity
        and polls the request deadline, so the snapshot this request decided from
        is proven unchanged.  It runs exactly once, immediately before whichever
        exit comes first: the non-fast-forward refusal or the first effect.
        """
        nonlocal sealed_validation_owner
        owner = sealed_validation_owner
        if owner is None:
            return
        sealed_validation_owner = None
        try:
            owner.finish(decision_work)
        except BaseException:
            if not owner._closed:
                # ``finish`` refused before it took over cleanup, so the outer
                # handler keeps ownership of the release.
                sealed_validation_owner = owner
            raise

    try:
        if decision_work is not None:
            stage_owner = prepare_http_upload_stage(
                decision_work,
                dirs["objects"],
                records,
                closure,
                deadline,
            )
            stage_owner.seal_pre_effect()
            sealed_validation_bounds = stage_owner.take_sealed_validation_bounds()
        tmp_root = Path(tempfile.mkdtemp(prefix="codefire-http-upload-"))
        tmp_objects = tmp_root / "objects"
        try:
            stage_http_upload_closure(
                dirs["objects"],
                tmp_objects,
                records,
                closure,
                None if stage_owner is not None else decision_work,
                deadline,
                prepared_stage=stage_owner,
            )
        finally:
            close_closure = getattr(closure, "close", None)
            if close_closure is not None:
                close_closure()
        if decision_work is None:
            # No request budget exists to charge, so this keeps the legacy
            # command-scoped traversal verbatim.  Every effect below is still
            # fenced by ``fence_first_effect``, so an elapsed deadline cannot
            # publish on this path either.
            validate_sealed_commit(tmp_objects, head)
        else:
            if sealed_validation_bounds is None:
                raise CFError("HTTP upload sealed-validation bounds are unavailable")
            (
                record_count_upper,
                aggregate_bytes_upper,
                maximum_record_bytes_upper,
            ) = sealed_validation_bounds
            sealed_validation_bounds = None
            sealed_validation_owner = prepare_http_upload_sealed_validation(
                decision_work,
                tmp_objects,
                head,
                record_count_upper=record_count_upper,
                aggregate_bytes_upper=aggregate_bytes_upper,
                maximum_record_bytes_upper=maximum_record_bytes_upper,
                deadline=deadline,
            )
            sealed_validation_owner.validate(decision_work)
            # Certify the traversed closure, then run the final revalidation
            # fence: it re-proves every retained document and the store identity,
            # seals the proof and releases the reservation.  The sealed proof then
            # carries this one traversal through publication identity and the
            # publication preflight, which used to run two more closure
            # traversals on fresh local_v1 ledgers that were neither charged to
            # this request nor polled against its deadline.  Its bytes are
            # transferred onto the request ledger, not duplicated.
            publication_root_proof = (
                sealed_validation_owner.publication_root_proof(
                    decision_work, (head,)
                )
            )
            # Publication identity is a pure decision over the closure this owner
            # just validated, so it consumes that snapshot while the snapshot
            # still exists.  The publication preflight then reuses this one
            # decision.  Between them they used to run two more closure
            # traversals on fresh local_v1 ledgers, neither charged to this
            # request nor polled against its deadline.
            publication_identity = RemoteJSONPublicationIdentity(
                "remote_upload",
                actor,
                idempotency_key,
                validate_remote_json_publication_identity(
                    "remote_upload",
                    actor,
                    idempotency_key,
                    [head],
                    objects_root=tmp_objects,
                    root_proof=publication_root_proof,
                ),
                tmp_objects,
            )
            seal_validated_snapshot()
            publication_root_proof = None
        enforce_remote_commit_signature_policy_accounted(
            project_root,
            tmp_objects,
            head,
            decision_work,
            deadline,
        )
        # A project may have a server policy before its durable remote layout is
        # bootstrapped.  Only an actually absent path uses the continued-absence
        # verification fence; a seeded policy directory is an existing authority.
        run_server_verification(
            project_root,
            branch_name,
            head,
            ledger=decision_work,
            deadline=deadline,
            allow_missing_project=not project_root.exists(),
        )
        if publication_identity is None:
            # No request budget: identity still validates, on its own ledger, but
            # under this request's deadline.
            publication_identity = RemoteJSONPublicationIdentity(
                "remote_upload",
                actor,
                idempotency_key,
                validate_remote_json_publication_identity(
                    "remote_upload",
                    actor,
                    idempotency_key,
                    [head],
                    objects_root=tmp_objects,
                    deadline=deadline,
                ),
                tmp_objects,
            )
        # The deadline is polled again after every identity and final-subject
        # check, and before any externally visible effect of this request.
        fence_first_effect("upload final subject fence")
        missing_writes: list[tuple[dict[str, Any], Any, Any]] | None = None
        missing_write_preflight: RemoteJSONPublicationWritePreflight | None = None
        if not project_existed:
            missing_nonce_after = (
                request_nonce_cache_postimage(
                    project_root,
                    nonce_plan[0],
                    nonce_plan[1],
                    nonce_plan[2],
                    time.time(),
                )
                if nonce_plan is not None
                else None
            )
            missing_writes = [
                (
                    {"kind": "generation"},
                    None,
                    {"current_generation": 1},
                ),
                (
                    {"kind": "branch", "name": branch_name},
                    None,
                    {
                        "version": VERSION,
                        "name": branch_name,
                        "head": head,
                        "generation": 1,
                        "uploaded_from": local_branch,
                        "uploaded_by": actor,
                        "transport": "http",
                        "updated_at": now_iso(),
                    },
                ),
            ]
            if missing_nonce_after is not None:
                missing_writes.append(
                    (
                        {"kind": "request_nonce_cache"},
                        None,
                        missing_nonce_after,
                    )
                )
            missing_write_preflight = preflight_remote_json_publication_writes(
                project_root,
                missing_writes,
            )
            if response_slot is not None:
                response_slot.prepare(200, result)
        if not project_existed or response_slot is None:
            # Creating the durable layout of a project that had none is this
            # request's first externally visible effect, so it gets the same
            # fence as the object copy and the branch publication below.
            fence_first_effect("upload layout bootstrap")
            if response_slot is not None:
                response_slot.seal_for_effect()
                response_slot.mark_effect_started()
            ensure_remote_layout(project_root)
        with remote_project_gate(project_root):
            semantic = {
                "stable_project_id": remote_project_stable_id(project_root),
                "remote_branch": branch_name,
                "local_branch": local_branch,
                "head": head,
                "object_set_digest": merge_request_object_set_digest(records),
            }
            recovering = preflight_remote_publication_recovery(
                project_root,
                "remote_upload",
                actor,
                semantic,
                result,
                idempotency_key,
                [head],
            )
            current = read_remote_branch_record(project_root, branch_name)
            if (
                not recovering
                and current
                and not is_ancestor_from_objects_accounted(
                    tmp_objects,
                    current["head"],
                    head,
                    decision_work,
                    deadline,
                )
            ):
                if response_slot is not None and response_slot.is_prepared:
                    raise CFError(
                        "upload authority changed after response preflight"
                    )
                return http_error(
                    409,
                    "upload rejected: remote branch is not an ancestor of local branch head",
                )
            if response_slot is not None and not response_slot.is_prepared:
                response_slot.prepare(200, result)
            nonce_context = (
                stable_remote_lock(
                    dirs["locks"] / "request-nonce-cache.lock"
                )
                if nonce_plan is not None
                else contextlib.nullcontext()
            )
            with nonce_context:
                nonce_before = None
                nonce_after = None
                if nonce_plan is not None:
                    nonce_before = read_json(
                        remote_request_nonce_cache_path(project_root)
                    )
                    nonce_after = request_nonce_cache_postimage(
                        project_root,
                        nonce_plan[0],
                        nonce_plan[1],
                        nonce_plan[2],
                        time.time(),
                    )
                selected_write_preflight = None
                if recovering:
                    generation_current = read_json(
                        remote_generation_path(project_root)
                    )
                    branch_current = read_remote_branch_record(
                        project_root, branch_name
                    )
                    writes = [
                        (
                            {"kind": "generation"},
                            generation_current,
                            generation_current,
                        ),
                        (
                            {"kind": "branch", "name": branch_name},
                            branch_current,
                            branch_current,
                        ),
                    ]
                else:
                    generation_before = read_json(
                        remote_generation_path(project_root)
                    )
                    if (
                        missing_writes is not None
                        and missing_write_preflight is not None
                        and generation_before is None
                        and current is None
                        and nonce_before is None
                    ):
                        writes = missing_writes
                        selected_write_preflight = missing_write_preflight
                    else:
                        generation = (
                            generation_before.get("current_generation", 0)
                            if isinstance(generation_before, dict)
                            else 0
                        ) + 1
                        branch_after = {
                            "version": VERSION,
                            "name": branch_name,
                            "head": head,
                            "generation": generation,
                            "uploaded_from": local_branch,
                            "uploaded_by": actor,
                            "transport": "http",
                            "updated_at": now_iso(),
                        }
                        writes = [
                            (
                                {"kind": "generation"},
                                generation_before,
                                {"current_generation": generation},
                            ),
                            (
                                {"kind": "branch", "name": branch_name},
                                current,
                                branch_after,
                            ),
                        ]
                        if nonce_after is not None:
                            writes.append(
                                (
                                    {"kind": "request_nonce_cache"},
                                    nonce_before,
                                    nonce_after,
                                )
                            )
                publication_preflight = preflight_remote_json_publication(
                    project_root,
                    "remote_upload",
                    actor,
                    semantic,
                    writes,
                    result,
                    idempotency_key,
                    [head],
                    validation_objects_root=tmp_objects,
                    validate_preimages=not recovering,
                    write_preflight=selected_write_preflight,
                    identity=publication_identity,
                    ledger=decision_work,
                    deadline=deadline,
                )
                publication_preflight.seal_for_effect(
                    project_root,
                    "remote_upload",
                    actor,
                    semantic,
                    writes,
                    result,
                    idempotency_key,
                    (head,),
                )
                # The last poll before the object copy and the branch/generation
                # publication, and before the response slot's effect-started
                # transition, so an already-elapsed request returns its typed
                # deadline outcome instead of a 503 retry or a 200 over a moved
                # branch.
                fence_first_effect("upload publication effect")
                if response_slot is not None and not response_slot.effect_started:
                    response_slot.seal_for_effect()
                    response_slot.mark_effect_started()
                # Recovery may be completing a publication whose object copy
                # was durable before its authorities became visible.
                write_object_records(dirs["objects"], records)
                published = execute_remote_json_publication(
                    project_root,
                    "remote_upload",
                    actor,
                    semantic,
                    writes,
                    result,
                    idempotency_key=idempotency_key,
                    object_roots=[head],
                    preflight=publication_preflight,
                    # A retry may complete a quarantined publication here.  That
                    # recovery is this request's work: it validates its recovered
                    # roots on this ledger and polls this deadline before its own
                    # cleanup and response selection.
                    ledger=decision_work,
                    deadline=deadline,
                )
                if recovering:
                    recovered = published
                    if recovered != result:
                        raise CFError(
                            "upload recovery result changed after response preflight"
                        )
                else:
                    if published != result:
                        raise CFError(
                            "upload publication result changed after response preflight"
                        )
        publication_succeeded = True
        if response_slot is not None:
            response_slot.select_success()
        return 200, result
    except BaseException:
        if (
            response_slot is not None
            and response_slot.is_prepared
            and response_slot.effect_started
        ):
            if publication_succeeded:
                response_slot.select_success()
                return 200, result
            response_slot.select_durable()
            return 503, HTTP_MUTATION_RETRY_PAYLOAD
        if response_slot is not None:
            response_slot.close()
        raise
    finally:
        cleanup_error: BaseException | None = None
        if sealed_validation_owner is not None:
            try:
                assert decision_work is not None
                sealed_validation_owner.close(decision_work)
            except BaseException as exc:
                cleanup_error = exc
                try:
                    sealed_validation_owner.close(decision_work)
                except BaseException:
                    pass
        for owner in (stage_owner, closure):
            close_owner = getattr(owner, "close", None)
            if close_owner is None:
                continue
            try:
                close_owner()
            except BaseException as exc:
                if cleanup_error is None:
                    cleanup_error = exc
                try:
                    close_owner()
                except BaseException:
                    pass
        if tmp_root is not None:
            shutil.rmtree(tmp_root, ignore_errors=True)
        if cleanup_error is not None:
            raise cleanup_error


_HTTP_ADMISSION_REJECT_BODY = (
    b'{"error":"CodeFire HTTP server connection limit reached",'
    b'"kind":"http_connection_admission_rejected","retryable":true}'
)
_HTTP_ADMISSION_REJECT_RESPONSE = (
    b"HTTP/1.1 503 Service Unavailable\r\n"
    b"Content-Type: application/json\r\n"
    + f"Content-Length: {len(_HTTP_ADMISSION_REJECT_BODY)}\r\n".encode("ascii")
    + b"Connection: close\r\n\r\n"
    + _HTTP_ADMISSION_REJECT_BODY
)


class _HTTPConnectionPermit:
    """Idempotent ownership of one process-global admitted connection."""

    def __init__(self, admission: Any, token: object) -> None:
        self._admission = admission
        self._token = token

    def close(self) -> None:
        admission = self._admission
        if admission is not None:
            admission.release(self._token)
            self._admission = None

    def replace_request(self, request: Any) -> None:
        admission = self._admission
        if admission is None:
            raise CFError("HTTP connection permit is already closed")
        if admission.replace_request(self._token, request):
            try:
                request.shutdown(socket.SHUT_RDWR)
            except BaseException:
                pass

    def __del__(self) -> None:
        admission = self._admission
        if admission is None:
            return
        try:
            self.close()
        except BaseException:
            try:
                admission.release_dropped(self._token)
            except BaseException:
                pass


class _HTTPServerRegistration:
    """Transactional ownership of one process-global live-server entry."""

    def __init__(self, admission: Any, server_token: object) -> None:
        self._admission = admission
        self._server_token = server_token

    def publish(self, limit: int) -> None:
        admission = self._admission
        if admission is None:
            raise CFError("HTTP server registration owner is already closed")
        try:
            admission.register_server(self._server_token, limit)
        except BaseException:
            self.close_noexcept()
            raise

    def close(self) -> None:
        admission = self._admission
        if admission is not None:
            admission.unregister_server(self._server_token)
            self._admission = None

    def close_noexcept(self) -> None:
        admission = self._admission
        if admission is None:
            return
        try:
            self.close()
        except BaseException:
            if admission.unregister_server_dropped(self._server_token):
                self._admission = None

    def __del__(self) -> None:
        self.close_noexcept()


class _ProcessHTTPConnectionAdmission:
    """One zero-queue active-connection gate shared by all Python servers."""

    def __init__(self) -> None:
        self._lock = threading.Lock()
        self._active: dict[object, tuple[object, Any]] = {}
        self._active_by_server: dict[object, set[object]] = {}
        self._server_limits: dict[object, int] = {}
        self._effective_limit: int | None = None
        self._closing_servers: set[object] = set()

    def register_server(self, server_token: object, limit: int) -> None:
        with self._lock:
            if server_token in self._server_limits:
                raise CFError("HTTP connection admission server is already registered")
            self._server_limits[server_token] = limit
            if self._effective_limit is None or limit < self._effective_limit:
                self._effective_limit = limit

    def _unregister_server_locked(self, server_token: object) -> None:
        self._server_limits.pop(server_token, None)
        self._effective_limit = min(self._server_limits.values(), default=None)
        if not self._active_by_server.get(server_token):
            self._closing_servers.discard(server_token)

    def unregister_server(self, server_token: object) -> None:
        with self._lock:
            self._unregister_server_locked(server_token)

    def unregister_server_dropped(self, server_token: object) -> bool:
        """Destructor fallback that bypasses an injected public unregister fault."""
        try:
            _ProcessHTTPConnectionAdmission.unregister_server(self, server_token)
            return True
        except BaseException:
            return False

    def try_acquire(
        self, server_token: object, request: Any
    ) -> _HTTPConnectionPermit | None:
        token = object()
        permit = _HTTPConnectionPermit(self, token)
        with self._lock:
            limit = self._effective_limit
            if (
                server_token not in self._server_limits
                or server_token in self._closing_servers
                or limit is None
                or len(self._active) >= limit
            ):
                return None
            self._active[token] = (server_token, request)
            self._active_by_server.setdefault(server_token, set()).add(token)
        return permit

    def release(self, token: object) -> None:
        with self._lock:
            active = self._active.get(token)
            if active is None:
                return
            server_token, _request = active
            server_active = self._active_by_server.get(server_token)
            if server_active is not None:
                server_active.discard(token)
            if not server_active:
                self._active_by_server.pop(server_token, None)
                self._closing_servers.discard(server_token)
            self._active.pop(token, None)

    def release_dropped(self, token: object) -> None:
        """Destructor fallback that bypasses an injected public release fault."""
        try:
            _ProcessHTTPConnectionAdmission.release(self, token)
        except BaseException:
            pass

    def replace_request(self, token: object, request: Any) -> bool:
        with self._lock:
            try:
                server_token, _old_request = self._active[token]
            except KeyError as error:
                raise CFError("HTTP connection admission permit is not active") from error
            self._active[token] = (server_token, request)
            return server_token in self._closing_servers

    def count(self, server_token: object | None = None) -> int:
        with self._lock:
            if server_token is None:
                return len(self._active)
            return len(self._active_by_server.get(server_token, ()))

    def effective_limit(self) -> int | None:
        with self._lock:
            return self._effective_limit

    def close_server_connections(
        self, server_token: object, *, unregister: bool = False
    ) -> None:
        with self._lock:
            if unregister:
                self._unregister_server_locked(server_token)
            if not self._active_by_server.get(server_token):
                self._closing_servers.discard(server_token)
            else:
                self._closing_servers.add(server_token)
            requests = [
                request
                for owner, request in self._active.values()
                if owner is server_token
            ]
        for request in requests:
            try:
                request.shutdown(socket.SHUT_RDWR)
            except BaseException:
                pass

    def finish_server_close(self, server_token: object) -> None:
        with self._lock:
            self._unregister_server_locked(server_token)
            if not self._active_by_server.get(server_token):
                self._closing_servers.discard(server_token)


_PROCESS_HTTP_CONNECTION_ADMISSION = _ProcessHTTPConnectionAdmission()


class ReusableThreadingHTTPServer(http.server.ThreadingHTTPServer):
    allow_reuse_address = True
    daemon_threads = False

    def __init__(
        self,
        server_address: Any,
        request_handler_class: Any,
        bind_and_activate: bool = True,
        *,
        decision_work_profile: DecisionWorkProfile | None = None,
        tls_context: ssl.SSLContext | None = None,
    ) -> None:
        profile = decision_work_profile or getattr(
            request_handler_class, "decision_work_profile", None
        )
        if profile is None:
            profile = DecisionWorkProfile.http_v1()
        if profile.max_active_connections is None:
            raise CFError("HTTP server profile requires an active connection limit")
        if profile.max_queued_connections != 0:
            raise CFError("Python HTTP server supports exactly zero queued connections")
        self.decision_work_profile = profile
        self.tls_context = tls_context
        self._connection_server_token = object()
        registration = _HTTPServerRegistration(
            _PROCESS_HTTP_CONNECTION_ADMISSION,
            self._connection_server_token,
        )
        self._connection_registration = registration
        self._connection_permits_lock = threading.Lock()
        self._connection_permits: dict[int, _HTTPConnectionPermit] = {}
        self._rejected_connections = 0
        try:
            super().__init__(
                server_address, request_handler_class, bind_and_activate
            )
            registration.publish(profile.max_active_connections)
        except BaseException:
            registration.close_noexcept()
            try:
                super().server_close()
            except BaseException:
                pass
            raise

    def active_connection_count(self) -> int:
        return _PROCESS_HTTP_CONNECTION_ADMISSION.count(
            self._connection_server_token
        )

    def process_active_connection_count(self) -> int:
        return _PROCESS_HTTP_CONNECTION_ADMISSION.count()

    def rejected_connection_count(self) -> int:
        with self._connection_permits_lock:
            return self._rejected_connections

    def _take_connection_permit(
        self, request: Any
    ) -> _HTTPConnectionPermit | None:
        with self._connection_permits_lock:
            return self._connection_permits.pop(id(request), None)

    def shutdown_request(self, request: Any) -> None:
        """Close one dispatch-owned socket without leaking BaseException."""
        try:
            super().shutdown_request(request)
        except BaseException:
            try:
                super().close_request(request)
            except BaseException:
                pass

    def _shutdown_request_noexcept(
        self, request: Any, client_address: Any | None = None
    ) -> None:
        try:
            self.shutdown_request(request)
            return
        except BaseException:
            try:
                self.close_request(request)
            except BaseException:
                pass
            if client_address is not None:
                try:
                    self.handle_error(request, client_address)
                except BaseException:
                    pass

    def _write_rejection(self, request: Any) -> None:
        try:
            with self._connection_permits_lock:
                self._rejected_connections += 1
            if self.tls_context is None:
                request.settimeout(1.0)
                request.sendall(_HTTP_ADMISSION_REJECT_RESPONSE)
        except BaseException:
            pass

    def verify_request(self, request: Any, client_address: Any) -> bool:
        del client_address
        permit = _PROCESS_HTTP_CONNECTION_ADMISSION.try_acquire(
            self._connection_server_token,
            request,
        )
        if permit is None:
            self._write_rejection(request)
            return False
        try:
            with self._connection_permits_lock:
                self._connection_permits[id(request)] = permit
        except BaseException:
            permit.close()
            raise
        return True

    def process_request(self, request: Any, client_address: Any) -> None:
        with self._connection_permits_lock:
            admitted = id(request) in self._connection_permits
        if not admitted:
            permit = _PROCESS_HTTP_CONNECTION_ADMISSION.try_acquire(
                self._connection_server_token,
                request,
            )
            if permit is None:
                self._write_rejection(request)
                self._shutdown_request_noexcept(request, client_address)
                return
            try:
                with self._connection_permits_lock:
                    self._connection_permits[id(request)] = permit
            except BaseException:
                permit.close()
                self._shutdown_request_noexcept(request, client_address)
                raise
        try:
            super().process_request(request, client_address)
        except BaseException:
            owned = self._take_connection_permit(request)
            if owned is not None:
                owned.close()
            try:
                reap = getattr(self._threads, "reap", None)
                if reap is not None:
                    reap()
            except BaseException:
                pass
            self._shutdown_request_noexcept(request, client_address)
            raise

    def process_request_thread(self, request: Any, client_address: Any) -> None:
        permit = self._take_connection_permit(request)
        if permit is None:
            self._shutdown_request_noexcept(request, client_address)
            return
        handled_request = request
        try:
            try:
                if self.tls_context is not None:
                    handled_request = self.tls_context.wrap_socket(
                        request,
                        server_side=True,
                        do_handshake_on_connect=False,
                    )
                    permit.replace_request(handled_request)
                    handled_request.do_handshake()
                self.finish_request(handled_request, client_address)
            except BaseException:
                try:
                    self.handle_error(handled_request, client_address)
                except BaseException:
                    pass
        finally:
            try:
                self._shutdown_request_noexcept(
                    handled_request, client_address
                )
            finally:
                permit.close()

    def shutdown(self) -> None:
        super().shutdown()
        _PROCESS_HTTP_CONNECTION_ADMISSION.close_server_connections(
            self._connection_server_token
        )

    def server_close(self) -> None:
        self._connection_registration.close_noexcept()
        _PROCESS_HTTP_CONNECTION_ADMISSION.close_server_connections(
            self._connection_server_token
        )
        try:
            super().server_close()
        finally:
            _PROCESS_HTTP_CONNECTION_ADMISSION.finish_server_close(
                self._connection_server_token
            )


class _BoundedHTTPHeaderReader:
    """Count request-head bytes without allocating an unreserved lookahead byte."""

    def __init__(
        self,
        source: Any,
        limit: int,
        budget_error: Any,
    ) -> None:
        self.source = source
        self.limit = limit
        self.budget_error = budget_error
        self.bytes_read = 0

    def readline(self, size: int = -1) -> bytes:
        remaining = max(0, self.limit - self.bytes_read)
        if remaining == 0:
            raise self.budget_error(self.limit + 1)
        bounded = remaining
        if size >= 0:
            bounded = min(size, bounded)
        data = self.source.readline(bounded)
        self.bytes_read += len(data)
        if (
            bounded == remaining
            and len(data) == bounded
            and data
            and not data.endswith(b"\n")
        ):
            raise self.budget_error(self.limit + 1)
        return data

    def __getattr__(self, name: str) -> Any:
        return getattr(self.source, name)


class _BoundedCanonicalJSONFreezer:
    """Iteratively freeze compact JSON while bounding every owned work buffer."""

    STACK_BASE = 64
    TOKEN_BYTES = 128
    SORT_BASE = 64
    SORT_ENTRY_BYTES = 16
    FRAGMENT_BASE = 64
    FRAGMENT_SLOT_BYTES = 16
    CHUNK_BASE = 64
    CHUNK_BYTES = 256

    def __init__(
        self,
        ledger: DecisionWorkLedger,
        profile: DecisionWorkProfile,
        budget_error: Any,
        limit: int,
        poll: Any | None = None,
    ) -> None:
        self.ledger = ledger
        self.profile = profile
        self.budget_error = budget_error
        self.limit = limit
        self.poll = poll
        self.stack: list[tuple[str, Any]] | None = None
        self.fragments: list[bytes] | None = None
        self.chunk: bytearray | None = None
        self.stack_bytes = 0
        self.fragment_bytes = 0
        self.fragment_slots = 0
        self.fragment_base = 0
        self.chunk_bytes = 0
        self.chunk_owner = 0
        self.size = 0
        self.overflow = False

    def _poll(self) -> None:
        if self.poll is not None:
            self.poll()

    def _acquire(self, dimension: str, amount: int) -> None:
        if amount == 0:
            return
        observed = self.ledger.current.get(dimension, 0) + amount
        if observed > self.profile.limit(dimension):
            raise self.budget_error(dimension, observed, "response_body")
        permit = self.ledger.reserve(
            "response_body", acquires={dimension: amount}
        )
        try:
            self.ledger.consume_reserved(
                permit,
                phase="response_body",
                acquires={dimension: amount},
            )
        finally:
            if self.ledger.permit_is_open(permit):
                self.ledger.cancel_permit(permit)

    def _release(self, dimension: str, amount: int) -> None:
        if amount:
            self.ledger.release(dimension, amount)

    def _new_fragment_list(self) -> list[bytes]:
        return []

    def _push(self, kind: str, value: Any) -> None:
        self._acquire("temporary_bytes", self.TOKEN_BYTES)
        self.stack_bytes += self.TOKEN_BYTES
        assert self.stack is not None
        self.stack.append((kind, value))

    def _emit_byte(self, value: int) -> None:
        if self.overflow:
            return
        assert self.chunk is not None
        self.chunk.append(value)
        self.size += 1
        if self.size > self.limit:
            self.size = self.limit + 1
            self.overflow = True
        if len(self.chunk) == self.chunk_bytes:
            self._flush_chunk()

    def _emit_ascii(self, value: bytes) -> None:
        for index, byte in enumerate(value):
            if index % self.CHUNK_BYTES == 0:
                self._poll()
            self._emit_byte(byte)
            if self.overflow:
                return

    def _emit_codepoint(self, codepoint: int) -> None:
        if codepoint <= 0x7F:
            self._emit_byte(codepoint)
        elif codepoint <= 0x7FF:
            self._emit_byte(0xC0 | (codepoint >> 6))
            self._emit_byte(0x80 | (codepoint & 0x3F))
        elif 0xD800 <= codepoint <= 0xDFFF:
            raise CFError("HTTP JSON response contains an unpaired surrogate")
        elif codepoint <= 0xFFFF:
            self._emit_byte(0xE0 | (codepoint >> 12))
            self._emit_byte(0x80 | ((codepoint >> 6) & 0x3F))
            self._emit_byte(0x80 | (codepoint & 0x3F))
        else:
            self._emit_byte(0xF0 | (codepoint >> 18))
            self._emit_byte(0x80 | ((codepoint >> 12) & 0x3F))
            self._emit_byte(0x80 | ((codepoint >> 6) & 0x3F))
            self._emit_byte(0x80 | (codepoint & 0x3F))

    def _emit_string(self, value: str) -> None:
        self._emit_byte(ord('"'))
        for index, character in enumerate(value):
            if index % self.CHUNK_BYTES == 0:
                self._poll()
            if self.overflow:
                return
            codepoint = ord(character)
            if character == '"':
                self._emit_ascii(b'\\"')
            elif character == "\\":
                self._emit_ascii(b"\\\\")
            elif character == "\b":
                self._emit_ascii(b"\\b")
            elif character == "\f":
                self._emit_ascii(b"\\f")
            elif character == "\n":
                self._emit_ascii(b"\\n")
            elif character == "\r":
                self._emit_ascii(b"\\r")
            elif character == "\t":
                self._emit_ascii(b"\\t")
            elif codepoint < 0x20:
                self._emit_ascii(b"\\u00")
                digits = b"0123456789abcdef"
                self._emit_byte(digits[(codepoint >> 4) & 0xF])
                self._emit_byte(digits[codepoint & 0xF])
            else:
                self._emit_codepoint(codepoint)
        self._emit_byte(ord('"'))

    def _emit_scalar_bytes(self, value: Any) -> None:
        if value is None:
            self._emit_ascii(b"null")
            return
        if value is True:
            self._emit_ascii(b"true")
            return
        if value is False:
            self._emit_ascii(b"false")
            return
        if type(value) is str:
            self._emit_string(value)
            return
        if type(value) is int:
            bits = int.bit_length(value)
            upper = max(1, (bits * 30103) // 100000 + 3)
            remaining = self.limit + 1 - self.size
            if upper > remaining + 2:
                self.size = self.limit + 1
                self.overflow = True
                return
            scratch = (upper * 2) + 64
            self._acquire("temporary_bytes", scratch)
            encoded: bytes | None = None
            text_value: str | None = None
            try:
                text_value = int.__str__(value)
                encoded = text_value.encode("ascii")
                self._emit_ascii(encoded)
            finally:
                encoded = None
                text_value = None
                self._release("temporary_bytes", scratch)
            return
        if isinstance(value, int):
            raise CFError("HTTP JSON response rejects integer subclasses")
        if type(value) is float:
            scratch = 128
            self._acquire("temporary_bytes", scratch)
            encoded = None
            text_value = None
            try:
                text_value = json.dumps(value, separators=(",", ":"))
                encoded = text_value.encode("ascii")
                self._emit_ascii(encoded)
            finally:
                encoded = None
                text_value = None
                self._release("temporary_bytes", scratch)
            return
        raise CFError(
            f"HTTP JSON response contains unsupported {type(value).__name__}"
        )

    def _expand(self, value: Any) -> None:
        self._poll()
        if type(value) in {
            dict,
            AccountedDoctorPayload,
            AccountedHTTPBundle,
            AccountedHTTPBranchList,
            AccountedHTTPMergeRequestList,
        }:
            count = dict.__len__(value)
            sort_bytes = self.SORT_BASE + (self.SORT_ENTRY_BYTES * count)
            self._acquire("temporary_bytes", sort_bytes)
            keys: list[str] | None = None
            try:
                try:
                    keys = sorted(dict.keys(value))
                except TypeError as error:
                    raise CFError("HTTP JSON response keys must be strings") from error
                if any(type(key) is not str for key in keys):
                    raise CFError("HTTP JSON response keys must be strings")
                self._poll()
                self._push("raw", b"}")
                for index in range(count - 1, -1, -1):
                    self._poll()
                    key = keys[index]
                    self._push("value", dict.__getitem__(value, key))
                    self._push("raw", b":")
                    self._push("string", key)
                    if index:
                        self._push("raw", b",")
                self._push("raw", b"{")
            finally:
                keys = None
                self._release("temporary_bytes", sort_bytes)
            return
        if type(value) is list or type(value) is tuple:
            self._push("raw", b"]")
            for index in range(len(value) - 1, -1, -1):
                self._poll()
                self._push("value", value[index])
                if index:
                    self._push("raw", b",")
            self._push("raw", b"[")
            return
        self._emit_scalar_bytes(value)

    def _flush_chunk(self) -> None:
        assert self.chunk is not None
        if not self.chunk:
            return
        amount = len(self.chunk)
        ownership = amount + self.FRAGMENT_SLOT_BYTES
        self._acquire("retained_bytes", ownership)
        try:
            frozen = bytes(self.chunk)
            assert self.fragments is not None
            self.fragments.append(frozen)
        except BaseException:
            frozen = None
            try:
                self._release("retained_bytes", ownership)
            except BaseException:
                pass
            raise
        self.fragment_bytes += amount
        self.fragment_slots += self.FRAGMENT_SLOT_BYTES
        self.chunk.clear()

    def _cleanup(self) -> None:
        self.stack = None
        self.fragments = None
        self.chunk = None
        self._release("temporary_bytes", self.stack_bytes)
        self._release("temporary_bytes", self.chunk_owner)
        self._release(
            "retained_bytes",
            self.fragment_base + self.fragment_slots + self.fragment_bytes,
        )
        self.stack_bytes = 0
        self.chunk_bytes = 0
        self.chunk_owner = 0
        self.fragment_base = 0
        self.fragment_slots = 0
        self.fragment_bytes = 0

    def freeze(self, payload: Any) -> tuple[bytes, int]:
        try:
            self._poll()
            self._acquire("temporary_bytes", self.STACK_BASE)
            self.stack_bytes = self.STACK_BASE
            self.stack = []
            self._acquire("retained_bytes", self.FRAGMENT_BASE)
            self.fragment_base = self.FRAGMENT_BASE
            self.fragments = self._new_fragment_list()
            chunk_capacity = min(self.CHUNK_BYTES, self.limit + 1)
            chunk_capacity = max(1, chunk_capacity)
            self._acquire(
                "temporary_bytes", self.CHUNK_BASE + chunk_capacity
            )
            self.chunk_bytes = chunk_capacity
            self.chunk_owner = self.CHUNK_BASE + chunk_capacity
            self.chunk = bytearray()
            self._push("value", payload)
            while self.stack and not self.overflow:
                self._poll()
                kind, value = self.stack.pop()
                try:
                    if kind == "raw":
                        self._emit_ascii(value)
                    elif kind == "string":
                        self._emit_string(value)
                    else:
                        self._expand(value)
                finally:
                    kind = None
                    value = None
                    self.stack_bytes -= self.TOKEN_BYTES
                    self._release("temporary_bytes", self.TOKEN_BYTES)
            if self.overflow:
                raise self.budget_error(
                    "response_bytes", self.limit + 1, "response_body"
                )
            self._flush_chunk()
            self.stack = None
            self._release("temporary_bytes", self.stack_bytes)
            self.stack_bytes = 0
            self.chunk = None
            self._release(
                "temporary_bytes", self.chunk_owner
            )
            self.chunk_bytes = 0
            self.chunk_owner = 0
            final_size = self.size
            self._acquire("retained_bytes", final_size)
            try:
                assert self.fragments is not None
                self._poll()
                body = b"".join(self.fragments)
                self._poll()
            except BaseException:
                body = None
                try:
                    self._release("retained_bytes", final_size)
                except BaseException:
                    pass
                raise
            self.fragments = None
            intermediate = (
                self.fragment_base + self.fragment_slots + self.fragment_bytes
            )
            self._release("retained_bytes", intermediate)
            self.fragment_base = 0
            self.fragment_slots = 0
            self.fragment_bytes = 0
            return body, final_size
        except BaseException:
            try:
                self._cleanup()
            except BaseException:
                pass
            raise


class _PreparedHTTPResponseOwner:
    """Own frozen response bytes until publication or explicit cancellation.

    Close drops payload references before ledger release. If release fails, the
    byte counts remain owned so a later close can retry accounting cleanup
    without reviving or releasing the payload twice.
    """

    def __init__(
        self,
        ledger: DecisionWorkLedger,
        header: bytes,
        header_retained: int,
        body: bytes,
        body_retained: int,
    ) -> None:
        self.ledger = ledger
        self.header: bytes | None = header
        self.body: bytes | None = body
        self.header_retained = header_retained
        self.body_retained = body_retained
        # True only once every prepared byte reached the destination, so a later
        # accounting fault can be retried without hiding a transport failure.
        self.published = False

    @property
    def retained_bytes(self) -> int:
        return self.header_retained + self.body_retained

    def close(self) -> None:
        retained = self.retained_bytes
        self.header = None
        self.body = None
        if retained:
            self.ledger.release("retained_bytes", retained)
        self.header_retained = 0
        self.body_retained = 0

    def publish(self, destination: Any) -> None:
        if self.header is None or self.body is None:
            raise CFError("prepared HTTP response owner is already closed")
        try:
            destination.write(self.header)
            destination.write(self.body)
            self.published = True
        finally:
            self.close()

    def __del__(self) -> None:
        try:
            self.close()
        except BaseException:
            pass


class _PreparedHTTPMutationResponses:
    """Own success and fixed durable-retry responses until one is selected.

    Selection retains both pointers until the rejected owner's drop-before-
    release cleanup succeeds. A release fault therefore leaves an exact retry
    state instead of losing either the selected payload or accounting owner.
    """

    def __init__(
        self,
        ledger: DecisionWorkLedger,
        success: _PreparedHTTPResponseOwner,
        durable: _PreparedHTTPResponseOwner,
        response_permit: DecisionWorkPermit,
        header_permit: DecisionWorkPermit,
        success_body_bytes: int,
        durable_body_bytes: int,
        success_header_bytes: int,
        durable_header_bytes: int,
    ) -> None:
        self.ledger = ledger
        self.success: _PreparedHTTPResponseOwner | None = success
        self.durable: _PreparedHTTPResponseOwner | None = durable
        self.response_permit: DecisionWorkPermit | None = response_permit
        self.header_permit: DecisionWorkPermit | None = header_permit
        self.success_body_bytes = success_body_bytes
        self.durable_body_bytes = durable_body_bytes
        self.success_header_bytes = success_header_bytes
        self.durable_header_bytes = durable_header_bytes
        self.selection: str | None = None

    def _select(
        self, ledger: DecisionWorkLedger, durable: bool
    ) -> _PreparedHTTPResponseOwner:
        if ledger is not self.ledger:
            raise CFError(
                "prepared HTTP mutation responses belong to a different decision-work ledger"
            )
        selected = self.durable if durable else self.success
        rejected = self.success if durable else self.durable
        if selected is None or rejected is None:
            raise CFError("prepared HTTP mutation responses are already closed")
        if self.response_permit is not None or self.header_permit is not None:
            raise CFError(
                "prepared HTTP mutation response work is not sealed for effect"
            )
        requested_selection = "durable" if durable else "success"
        if self.selection is not None and self.selection != requested_selection:
            raise CFError(
                "prepared HTTP mutation response selection cannot be changed"
            )
        self.selection = requested_selection
        rejected.close()
        self.success = None
        self.durable = None
        return selected

    def seal_for_effect(self, ledger: DecisionWorkLedger) -> None:
        if ledger is not self.ledger:
            raise CFError(
                "prepared HTTP mutation responses belong to a different decision-work ledger"
            )
        response_permit = self.response_permit
        header_permit = self.header_permit
        if response_permit is None or header_permit is None:
            raise CFError("prepared HTTP mutation response work is already sealed")
        self.ledger.consume_reserved(
            response_permit,
            phase="response_body",
            charges={
                "response_bytes": max(
                    self.success_body_bytes, self.durable_body_bytes
                )
            },
        )
        if self.ledger.permit_is_open(response_permit):
            self.ledger.cancel_permit(response_permit)
        self.response_permit = None
        self.ledger.consume_reserved(
            header_permit,
            phase="response_headers",
            charges={
                "response_header_bytes": max(
                    self.success_header_bytes, self.durable_header_bytes
                )
            },
        )
        if self.ledger.permit_is_open(header_permit):
            self.ledger.cancel_permit(header_permit)
        self.header_permit = None

    def select_success(
        self, ledger: DecisionWorkLedger
    ) -> _PreparedHTTPResponseOwner:
        return self._select(ledger, False)

    def select_durable(
        self, ledger: DecisionWorkLedger
    ) -> _PreparedHTTPResponseOwner:
        return self._select(ledger, True)

    def close(self) -> None:
        first_error: BaseException | None = None
        success = self.success
        durable = self.durable
        response_permit = self.response_permit
        header_permit = self.header_permit
        if success is not None:
            try:
                success.close()
                self.success = None
            except BaseException as error:
                first_error = error
        if durable is not None:
            try:
                durable.close()
                self.durable = None
            except BaseException as error:
                if first_error is None:
                    first_error = error
        if (
            response_permit is not None
            and self.ledger.permit_is_open(response_permit)
        ):
            try:
                self.ledger.cancel_permit(response_permit)
                self.response_permit = None
            except BaseException as error:
                if first_error is None:
                    first_error = error
        else:
            self.response_permit = None
        if (
            header_permit is not None
            and self.ledger.permit_is_open(header_permit)
        ):
            try:
                self.ledger.cancel_permit(header_permit)
                self.header_permit = None
            except BaseException as error:
                if first_error is None:
                    first_error = error
        else:
            self.header_permit = None
        if first_error is not None:
            raise first_error

    def __del__(self) -> None:
        try:
            self.close()
        except BaseException:
            pass


HTTP_MUTATION_RETRY_PAYLOAD = {
    "error": (
        "the durable mutation completed without a confirmed response; "
        "retry the same request"
    ),
    "kind": "retry_same_request",
    "retry_same_request": True,
}


class _HTTPMutationResponseSlot:
    """Transfer one prepared mutation response from a route to the handler."""

    def __init__(self, handler: Any) -> None:
        self.handler = handler
        self.responses: _PreparedHTTPMutationResponses | None = None
        self.selected: _PreparedHTTPResponseOwner | None = None
        self.effect_started = False

    @property
    def is_prepared(self) -> bool:
        return self.responses is not None

    def prepare(self, status: int, payload: Any) -> None:
        if self.responses is not None or self.selected is not None:
            raise CFError("upload mutation response is already prepared")
        self.responses = self.handler.prepare_mutation_json(status, payload)

    def select_success(self) -> None:
        if self.responses is None:
            raise CFError("upload success response was not prepared")
        responses = self.responses
        selected = responses.select_success(self.handler.decision_work)
        self.responses = None
        self.selected = selected

    def select_durable(self) -> None:
        if self.responses is None:
            raise CFError("upload durable response was not prepared")
        responses = self.responses
        selected = responses.select_durable(self.handler.decision_work)
        self.responses = None
        self.selected = selected

    def seal_for_effect(self) -> None:
        if self.responses is None or self.selected is not None:
            raise CFError("upload mutation response is not available to seal")
        self.responses.seal_for_effect(self.handler.decision_work)

    def mark_effect_started(self) -> None:
        if self.responses is None or self.selected is not None:
            raise CFError("upload response must be prepared before its effect")
        if (
            self.responses.response_permit is not None
            or self.responses.header_permit is not None
        ):
            raise CFError("upload response work must be sealed before its effect")
        self.effect_started = True

    def take(self) -> _PreparedHTTPResponseOwner | None:
        selected = self.selected
        self.selected = None
        return selected

    def close(self) -> None:
        responses = self.responses
        selected = self.selected
        if responses is not None:
            responses.close()
            self.responses = None
        if selected is not None:
            selected.close()
            self.selected = None
        self.effect_started = False

    def __del__(self) -> None:
        try:
            self.close()
        except BaseException:
            pass


PREPARED_RESPONSE_UNPROVED_DIAGNOSTIC = (
    "prepared read response cannot publish with unaccounted current work"
)
PREPARED_RESPONSE_UNPROVED_STATE_DIAGNOSTIC = (
    "prepared read response was not proved publishable"
)


class _HTTPReadResponseSlot:
    """Transfer one prepared read response from a route to the handler.

    A read route encodes its complete accounted response into this slot *before*
    its terminal authority/session/project fence.  The handler then completes the
    route and both of its pinned context-manager teardowns, and only afterwards
    performs the final handler-owned publishable proof.  Publication is one
    production transition: ``prove_and_take`` proves the ledger state and hands
    the prepared owner over in the same step, and a slot that was never proved
    refuses to yield its bytes at all.  There is exactly one prepared-response
    owner, one encoding, and one publication point per request; no second ledger
    and no second encoding is used.

    ``state`` is the production publication state, not test-only evidence:

    * ``empty``     — nothing has been encoded;
    * ``prepared``  — bytes exist but may not be published;
    * ``closing``   — the encoder declined and the connection must close;
    * ``proved``    — the ledger state was proved and the bytes may publish;
    * ``published`` — the owner was transferred to the publication point;
    * ``disposed``  — the owner was released because another response won.
    """

    EMPTY = "empty"
    PREPARED = "prepared"
    CLOSING = "closing"
    PROVED = "proved"
    PUBLISHED = "published"
    DISPOSED = "disposed"

    def __init__(self, handler: Any) -> None:
        self.handler = handler
        self.prepared: _PreparedHTTPResponseOwner | None = None
        self.prepare_count = 0
        self.state = self.EMPTY
        self.cleanup_diagnostics: list[dict[str, Any]] = []

    @property
    def is_prepared(self) -> bool:
        return self.prepared is not None

    @property
    def state_proved(self) -> bool:
        return self.state in {self.PROVED, self.PUBLISHED}

    @property
    def closing(self) -> bool:
        return self.state == self.CLOSING

    def prepare(self, status: int, payload: Any) -> None:
        """Encode the whole response and take over the payload's ownership."""
        if self.prepare_count:
            raise CFError("read response is already prepared")
        self.prepare_count += 1
        self.prepared = self.handler.prepare_json(status, payload)
        self.state = self.CLOSING if self.prepared is None else self.PREPARED

    def report_cleanup_recovery(self, diagnostic: dict[str, Any]) -> None:
        """Consume one recovered-cleanup diagnostic on the production path.

        A cleanup fault that a retry repaired is not silently dropped: it reaches
        the handler's own error log, which is the route's stable production
        diagnostic channel, and is retained here for the request observation.
        """
        self.cleanup_diagnostics.append(diagnostic)
        self.handler.log_error(
            "recovered cleanup fault: %s",
            canonical_json(diagnostic).decode("utf-8", "replace"),
        )

    def require_publishable_state(self) -> None:
        """Prove only request headers and this prepared owner remain current.

        A success response may not publish while any route ownership, temporary
        byte, or open permit survives, so a cleanup that could not reach zero
        cannot hide behind a published 200.  The proof is the only transition
        into ``proved``, and only a ``proved`` slot can be published.
        """
        prepared = self.prepared
        if prepared is None:
            # ``prepare_json`` already decided to close the connection; there is
            # no prepared byte to publish and nothing to prove.
            return
        ledger = self.handler.decision_work
        expected = self.handler._request_header_retained + prepared.retained_bytes
        current = ledger.current
        if (
            current.get("retained_bytes", 0) != expected
            or any(
                value
                for dimension, value in current.items()
                if dimension != "retained_bytes"
            )
            or ledger.has_open_permits()
        ):
            raise CFError(PREPARED_RESPONSE_UNPROVED_DIAGNOSTIC)
        self.state = self.PROVED

    def prove_and_take(self) -> _PreparedHTTPResponseOwner | None:
        """Prove the publishable state, then transfer the prepared owner.

        This is the whole production publication transition.  Nothing fallible
        may run between the proof and the transfer, and the transfer itself only
        moves one reference.
        """
        self.require_publishable_state()
        return self.take()

    def take(self) -> _PreparedHTTPResponseOwner | None:
        """Hand over the prepared owner, refusing bytes that were never proved."""
        prepared = self.prepared
        if prepared is not None and self.state != self.PROVED:
            raise CFError(PREPARED_RESPONSE_UNPROVED_STATE_DIAGNOSTIC)
        self.prepared = None
        if prepared is not None:
            self.state = self.PUBLISHED
        return prepared

    def dispose(self) -> None:
        """Release the prepared owner because another response was selected.

        Every ``do_GET`` error arm reached while this slot owns bytes disposes of
        them here before selecting or publishing a different response, so an old
        prepared success can never replace a typed failure.
        """
        prepared = self.prepared
        if prepared is None:
            if self.state == self.PREPARED:
                self.state = self.DISPOSED
            return
        # ``_PreparedHTTPResponseOwner.close`` keeps its exact byte counts when a
        # release fails, so the owner stays owned here for an exact retry.  A
        # caller that cannot dispose of it must not select another response.
        prepared.close()
        self.prepared = None
        self.state = self.DISPOSED

    def close(self) -> None:
        self.dispose()

    def __del__(self) -> None:
        try:
            self.close()
        except BaseException:
            pass


def http_resource_budget_error(
    error: ResourceBudgetExceeded,
) -> tuple[int, dict[str, Any]]:
    diagnostic = error.diagnostic()
    return (
        413,
        {
            "error": str(error),
            "exit_code": RESOURCE_BUDGET_EXIT_CODE,
            "kind": diagnostic["kind"],
            "diagnostics": [diagnostic],
        },
    )


def http_request_deadline_error(
    error: RequestDeadlineExceeded,
) -> tuple[int, dict[str, Any]]:
    diagnostic = error.diagnostic()
    return (
        503,
        {
            "error": str(error),
            "exit_code": RESOURCE_BUDGET_EXIT_CODE,
            "kind": diagnostic["kind"],
            "diagnostics": [diagnostic],
        },
    )


def make_http_handler(
    storage_root: Path,
    decision_work_profile: DecisionWorkProfile | None = None,
    *,
    _decision_work_observer: Any | None = None,
    _monotonic_clock: Any = time.monotonic,
):
    profile = decision_work_profile or DecisionWorkProfile.http_v1()

    class CodeFireHTTPHandler(http.server.BaseHTTPRequestHandler):
        server_version = "CodeFireHTTP/0.2"
        decision_work_profile = profile

        def log_message(self, format: str, *args: Any) -> None:
            return

        def budget_error(
            self, dimension: str, observed: int, phase: str
        ) -> ResourceBudgetExceeded:
            return ResourceBudgetExceeded(
                profile=profile.profile_id,
                dimension=dimension,
                observed=min(U64_MAX, observed),
                limit=profile.limit(dimension),
                phase=phase,
                command="http request",
                continuation_supported=False,
            )

        def cancel_if_open(self, permit: DecisionWorkPermit | None) -> None:
            if permit is not None and self.decision_work.permit_is_open(permit):
                self.decision_work.cancel_permit(permit)

        def finish_permit(
            self,
            permit: DecisionWorkPermit,
            *,
            phase: str,
            charges: dict[str, int] | None = None,
            acquires: dict[str, int] | None = None,
        ) -> None:
            self.decision_work.consume_reserved(
                permit,
                phase=phase,
                charges=charges,
                acquires=acquires,
            )
            self.cancel_if_open(permit)

        def concurrent_observed(self, dimension: str, amount: int) -> int:
            return self.decision_work.current.get(dimension, 0) + amount

        def ensure_concurrent_capacity(
            self, dimension: str, amount: int, phase: str
        ) -> None:
            observed = self.concurrent_observed(dimension, amount)
            if observed > profile.limit(dimension):
                raise self.budget_error(dimension, observed, phase)

        def release_request_header_storage(self) -> None:
            retained = self._request_header_retained
            if retained:
                self.raw_requestline = b""
                self.requestline = ""
                self.command = None
                self.path = ""
                self.request_version = ""
                self.headers = None
                self.decision_work.release("retained_bytes", retained)
                self._request_header_retained = 0

        @staticmethod
        def json_codepoint_bytes(codepoint: int) -> int:
            if codepoint in {8, 9, 10, 12, 13}:
                return 2
            if codepoint < 0x20:
                return 6
            if codepoint in {ord('"'), ord("\\")}:
                return 2
            if codepoint <= 0x7F:
                return 1
            if codepoint <= 0x7FF:
                return 2
            if 0xD800 <= codepoint <= 0xDFFF:
                raise CFError("HTTP JSON request contains an unpaired surrogate")
            if codepoint <= 0xFFFF:
                return 3
            return 4

        @classmethod
        def request_canonical_upper(cls, source: str) -> int:
            """Bound compact JSON bytes directly from the still-owned source text."""
            size = 0
            index = 0
            length = len(source)

            while index < length:
                character = source[index]
                if character in " \t\r\n":
                    index += 1
                    continue
                if character != '"':
                    if character == "-" or character.isdigit():
                        end = index + 1
                        while end < length and source[end] not in " \t\r\n,]}":
                            end += 1
                        token_size = end - index
                        token_has_float_marker = False
                        cursor = index
                        while cursor < end:
                            if source[cursor] in ".eE":
                                token_has_float_marker = True
                                break
                            cursor += 1
                        if token_has_float_marker:
                            size += max(token_size + 3, 24)
                        elif (
                            token_size == 2
                            and source[index] == "-"
                            and source[index + 1] == "0"
                        ):
                            size += 1
                        else:
                            size += token_size
                        index = end
                        continue
                    size += 1
                    index += 1
                    continue

                size += 2
                index += 1
                while index < length:
                    character = source[index]
                    if character == '"':
                        index += 1
                        break
                    if character != "\\":
                        size += cls.json_codepoint_bytes(ord(character))
                        index += 1
                        continue
                    index += 1
                    if index >= length:
                        break
                    escape = source[index]
                    if escape != "u":
                        if escape == '"':
                            decoded = ord('"')
                        elif escape == "\\":
                            decoded = ord("\\")
                        elif escape == "/":
                            decoded = ord("/")
                        elif escape == "b":
                            decoded = 8
                        elif escape == "f":
                            decoded = 12
                        elif escape == "n":
                            decoded = 10
                        elif escape == "r":
                            decoded = 13
                        elif escape == "t":
                            decoded = 9
                        else:
                            decoded = None
                        if decoded is None:
                            size += 6
                        else:
                            size += cls.json_codepoint_bytes(decoded)
                        index += 1
                        continue
                    if index + 4 >= length:
                        size += 6
                        index += 1
                        continue
                    codepoint = 0
                    valid = True
                    for offset in range(1, 5):
                        digit = source[index + offset]
                        if "0" <= digit <= "9":
                            value = ord(digit) - ord("0")
                        elif "a" <= digit <= "f":
                            value = ord(digit) - ord("a") + 10
                        elif "A" <= digit <= "F":
                            value = ord(digit) - ord("A") + 10
                        else:
                            valid = False
                            value = 0
                        codepoint = (codepoint << 4) | value
                    index += 5
                    if not valid:
                        size += 6
                        continue
                    if 0xD800 <= codepoint <= 0xDBFF and (
                        index + 5 < length
                        and source[index] == "\\"
                        and source[index + 1] == "u"
                    ):
                        low = 0
                        low_valid = True
                        for offset in range(2, 6):
                            digit = source[index + offset]
                            if "0" <= digit <= "9":
                                value = ord(digit) - ord("0")
                            elif "a" <= digit <= "f":
                                value = ord(digit) - ord("a") + 10
                            elif "A" <= digit <= "F":
                                value = ord(digit) - ord("A") + 10
                            else:
                                low_valid = False
                                value = 0
                            low = (low << 4) | value
                        if low_valid and 0xDC00 <= low <= 0xDFFF:
                            codepoint = (
                                0x10000
                                + ((codepoint - 0xD800) << 10)
                                + (low - 0xDC00)
                            )
                            index += 6
                    size += cls.json_codepoint_bytes(codepoint)
            return size

        @staticmethod
        def decimal_digits(value: int) -> int:
            digits = 1
            while value >= 10:
                value //= 10
                digits += 1
            return digits

        def response_header_size(self, status: int, body_size: int) -> int:
            reason = self.responses.get(status, ("",))[0]
            server_size = len(self.server_version) + 1 + len(self.sys_version)
            return (
                len(self.protocol_version)
                + 1
                + self.decimal_digits(status)
                + 1
                + len(reason)
                + 2
                + len("Server: ")
                + server_size
                + 2
                + len("Date: ")
                + 29
                + 2
                + len("Content-Type: application/json\r\n")
                + len("Content-Length: ")
                + self.decimal_digits(body_size)
                + 2
                + 2
            )

        def send_error(
            self,
            code: int,
            message: str | None = None,
            explain: str | None = None,
        ) -> None:
            del explain
            payload = {"error": message or self.responses.get(code, ("error",))[0]}
            if getattr(self, "_parsing_request", False):
                self._pending_parse_error = (code, payload)
                return
            self.send_json(code, payload)

        def read_route_phase(self, suffix: str) -> str | None:
            """Name one read-route response boundary, or None when inactive."""
            if self._bundle_deadline_active:
                return f"bundle {suffix}"
            if self._doctor_deadline_active:
                return f"doctor {suffix}"
            if self._list_deadline_active:
                return f"branch list {suffix}"
            if self._mr_list_deadline_active:
                return f"merge request list {suffix}"
            return None

        def freeze_response_body(self, payload: Any) -> tuple[bytes, int]:
            phase = self.read_route_phase("response encoding")
            if phase is None and self._mutation_deadline_active:
                phase = "upload response encoding"
            deadline_poll = None
            if phase is not None:
                deadline_poll = lambda: self.request_deadline.check(phase)
            freezer = _BoundedCanonicalJSONFreezer(
                self.decision_work,
                profile,
                self.budget_error,
                profile.limit("response_bytes"),
                deadline_poll,
            )
            return freezer.freeze(payload)

        def freeze_response_header(
            self, status: int, body_size: int, *, charge_work: bool = True
        ) -> tuple[bytes, int]:
            header_size = self.response_header_size(status, body_size)
            if header_size > profile.limit("response_header_bytes"):
                raise self.budget_error(
                    "response_header_bytes", header_size, "response_headers"
                )
            header_temporary = header_size * 2
            self.ensure_concurrent_capacity(
                "temporary_bytes", header_temporary, "response_headers"
            )
            self.ensure_concurrent_capacity(
                "retained_bytes", header_size, "response_headers"
            )
            permit = self.decision_work.reserve(
                "response_headers",
                charges=(
                    {"response_header_bytes": header_size}
                    if charge_work
                    else {}
                ),
                acquires={
                    "retained_bytes": header_size,
                    "temporary_bytes": header_temporary,
                },
            )
            retained = 0
            temporary = 0
            header: bytes | None = None
            header_text: str | None = None
            date_value: str | None = None
            try:
                self.finish_permit(
                    permit,
                    phase="response_headers",
                    charges=(
                        {"response_header_bytes": header_size}
                        if charge_work
                        else {}
                    ),
                    acquires={
                        "retained_bytes": header_size,
                        "temporary_bytes": header_temporary,
                    },
                )
                permit = None
                retained = header_size
                temporary = header_temporary
                reason = self.responses.get(status, ("",))[0]
                date_value = self.date_time_string()
                header_text = (
                    f"{self.protocol_version} {status} {reason}\r\n"
                    f"Server: {self.server_version} {self.sys_version}\r\n"
                    f"Date: {date_value}\r\n"
                    "Content-Type: application/json\r\n"
                    f"Content-Length: {body_size}\r\n"
                    "\r\n"
                )
                header = header_text.encode("latin-1", "strict")
                if len(header) != header_size:
                    raise CFError("HTTP response header size changed after preflight")
                header_text = None
                date_value = None
                self.decision_work.release("temporary_bytes", temporary)
                temporary = 0
                return header, retained
            except BaseException:
                header = None
                header_text = None
                date_value = None
                try:
                    self.cancel_if_open(permit)
                except BaseException:
                    pass
                try:
                    if temporary:
                        self.decision_work.release("temporary_bytes", temporary)
                except BaseException:
                    pass
                try:
                    if retained:
                        self.decision_work.release("retained_bytes", retained)
                except BaseException:
                    pass
                raise

        def prepare_mutation_json(
            self, status: int, payload: Any
        ) -> _PreparedHTTPMutationResponses:
            """Freeze normal and durable responses before an upload effect."""
            response_permit = self.decision_work.reserve(
                "response_body",
                charges={
                    "response_bytes": profile.limit("response_bytes")
                },
            )
            header_permit = None
            success_body: bytes | None = None
            durable_body: bytes | None = None
            success_header: bytes | None = None
            durable_header: bytes | None = None
            success_body_retained = 0
            durable_body_retained = 0
            success_header_retained = 0
            durable_header_retained = 0
            try:
                success_body, success_body_retained = self.freeze_response_body(
                    payload
                )
                durable_body, durable_body_retained = self.freeze_response_body(
                    HTTP_MUTATION_RETRY_PAYLOAD
                )
                success_header_size = self.response_header_size(
                    status, len(success_body)
                )
                durable_header_size = self.response_header_size(
                    503, len(durable_body)
                )
                header_actual = max(success_header_size, durable_header_size)
                if header_actual > profile.limit("response_header_bytes"):
                    raise self.budget_error(
                        "response_header_bytes",
                        header_actual,
                        "response_headers",
                    )
                header_permit = self.decision_work.reserve(
                    "response_headers",
                    charges={"response_header_bytes": header_actual},
                )
                success_header, success_header_retained = (
                    self.freeze_response_header(
                        status, len(success_body), charge_work=False
                    )
                )
                durable_header, durable_header_retained = (
                    self.freeze_response_header(
                        503, len(durable_body), charge_work=False
                    )
                )
                self.request_deadline.check("upload mutation publication")
                success = _PreparedHTTPResponseOwner(
                    self.decision_work,
                    success_header,
                    success_header_retained,
                    success_body,
                    success_body_retained,
                )
                durable = _PreparedHTTPResponseOwner(
                    self.decision_work,
                    durable_header,
                    durable_header_retained,
                    durable_body,
                    durable_body_retained,
                )
                success_header = None
                success_body = None
                durable_header = None
                durable_body = None
                success_header_retained = 0
                success_body_retained = 0
                durable_header_retained = 0
                durable_body_retained = 0
                responses = _PreparedHTTPMutationResponses(
                    self.decision_work,
                    success,
                    durable,
                    response_permit,
                    header_permit,
                    len(success.body or b""),
                    len(durable.body or b""),
                    success_header_size,
                    durable_header_size,
                )
                response_permit = None
                header_permit = None
                return responses
            except BaseException:
                success_header = None
                success_body = None
                durable_header = None
                durable_body = None
                try:
                    self.cancel_if_open(response_permit)
                except BaseException:
                    pass
                try:
                    self.cancel_if_open(header_permit)
                except BaseException:
                    pass
                for retained in (
                    success_header_retained,
                    success_body_retained,
                    durable_header_retained,
                    durable_body_retained,
                ):
                    try:
                        if retained:
                            self.decision_work.release(
                                "retained_bytes", retained
                            )
                    except BaseException:
                        pass
                raise

        def remaining_response_bytes(self) -> int:
            """Bound one encoding by the response budget this request has left.

            A route that prepares its response before its terminal fence may have
            to discard that encoding and publish a typed failure instead.  The
            second encoding reserves only the unspent allowance, so the discarded
            bytes are neither released nor charged twice.
            """
            limit = profile.limit("response_bytes")
            spent = self.decision_work.cumulative.get("response_bytes", 0)
            return max(0, limit - spent)

        def prepare_json_owned(
            self, status: int, payload: Any
        ) -> _PreparedHTTPResponseOwner | None:
            if self._response_owner_observation is None:
                self._response_owner_observation = {
                    "request_header_retained": self._request_header_retained,
                    "request_ast_retained": self._request_ast_retained,
                    "raw_requestline_live": bool(
                        getattr(self, "raw_requestline", b"")
                    ),
                    "headers_live": getattr(self, "headers", None) is not None,
                }
            if self.decision_work.terminal_reason is not None:
                return self.prepare_terminal_json(status, payload)
            encoding_phase = self.read_route_phase("response encoding")
            header_phase = self.read_route_phase("response headers")
            publication_phase = self.read_route_phase("response publication")
            if encoding_phase is not None:
                self.request_deadline.check(encoding_phase)
            for attempt in range(2):
                body: bytes | None = None
                header: bytes | None = None
                body_retained = 0
                header_retained = 0
                response_permit = None
                try:
                    response_permit = self.decision_work.reserve(
                        "response_body",
                        charges={
                            "response_bytes": self.remaining_response_bytes()
                        },
                    )
                    body, body_retained = self.freeze_response_body(payload)
                    if header_phase is not None:
                        self.request_deadline.check(header_phase)
                    header, header_retained = self.freeze_response_header(
                        status, len(body)
                    )
                    self.finish_permit(
                        response_permit,
                        phase="response_body",
                        charges={"response_bytes": len(body)},
                    )
                    response_permit = None
                    if publication_phase is not None:
                        self.request_deadline.check(publication_phase)
                    prepared = _PreparedHTTPResponseOwner(
                        self.decision_work,
                        header,
                        header_retained,
                        body,
                        body_retained,
                    )
                    header = None
                    body = None
                    header_retained = 0
                    body_retained = 0
                    return prepared
                except ResourceBudgetExceeded as error:
                    header = None
                    body = None
                    try:
                        self.cancel_if_open(response_permit)
                    except BaseException:
                        pass
                    try:
                        if header_retained:
                            self.decision_work.release(
                                "retained_bytes", header_retained
                            )
                    except BaseException:
                        pass
                    try:
                        if body_retained:
                            self.decision_work.release(
                                "retained_bytes", body_retained
                            )
                    except BaseException:
                        pass
                    if attempt or self._budget_error is not None:
                        self.close_connection = True
                        return None
                    self._budget_error = error
                    status, payload = http_resource_budget_error(error)
                except BaseException:
                    header = None
                    body = None
                    try:
                        self.cancel_if_open(response_permit)
                    except BaseException:
                        pass
                    try:
                        if header_retained:
                            self.decision_work.release(
                                "retained_bytes", header_retained
                            )
                    except BaseException:
                        pass
                    try:
                        if body_retained:
                            self.decision_work.release(
                                "retained_bytes", body_retained
                            )
                    except BaseException:
                        pass
                    raise
            return None

        def prepare_terminal_json(
            self, status: int, payload: Any
        ) -> _PreparedHTTPResponseOwner | None:
            """Encode one bounded error without reopening a terminal ledger."""
            current = self.decision_work.current
            if (
                current.get("retained_bytes", 0)
                != self._request_header_retained
                or any(
                    value
                    for dimension, value in current.items()
                    if dimension != "retained_bytes"
                )
                or self.decision_work.has_open_permits()
            ):
                self.close_connection = True
                return None
            control_limit = 64 * 1024
            control_payload = payload
            if canonical_json_size_up_to(control_payload, control_limit) > control_limit:
                bounded = {
                    "error": (
                        "terminal HTTP diagnostic exceeded the bounded "
                        "control-plane limit"
                    )
                }
                if type(payload) is dict:
                    kind = dict.get(payload, "kind")
                    if (
                        type(kind) is str
                        and canonical_json_size_up_to(kind, 256) <= 256
                    ):
                        bounded["kind"] = kind
                    exit_code = dict.get(payload, "exit_code")
                    if (
                        type(exit_code) is int
                        and 0 <= exit_code <= RESOURCE_BUDGET_EXIT_CODE
                    ):
                        bounded["exit_code"] = exit_code
                control_payload = bounded
            body = canonical_json(control_payload)
            if len(body) > control_limit:
                self.close_connection = True
                return None
            reason = self.responses.get(status, ("",))[0]
            header_size = self.response_header_size(status, len(body))
            if header_size > control_limit:
                self.close_connection = True
                return None
            header = (
                f"{self.protocol_version} {status} {reason}\r\n"
                f"Server: {self.server_version} {self.sys_version}\r\n"
                f"Date: {self.date_time_string()}\r\n"
                "Content-Type: application/json\r\n"
                f"Content-Length: {len(body)}\r\n"
                "\r\n"
            ).encode("latin-1", "strict")
            if len(header) != header_size:
                raise CFError("terminal HTTP response header size changed")
            return _PreparedHTTPResponseOwner(
                self.decision_work, header, 0, body, 0
            )

        def prepare_json(
            self, status: int, payload: Any
        ) -> _PreparedHTTPResponseOwner | None:
            payload_owner = payload
            try:
                prepared = self.prepare_json_owned(status, payload)
            except BaseException:
                try:
                    close = getattr(payload_owner, "close", None)
                    if close is not None:
                        close()
                except BaseException:
                    pass
                raise
            try:
                close = getattr(payload_owner, "close", None)
                if close is not None:
                    close()
            except BaseException:
                if prepared is not None:
                    try:
                        prepared.close()
                    except BaseException:
                        pass
                raise
            return prepared

        def publish_prepared(
            self, prepared: _PreparedHTTPResponseOwner | None
        ) -> None:
            if prepared is None:
                return
            try:
                # Publication is the exact point the first response byte reaches
                # the client, and the only transport boundary a route can reach.
                with transport_boundary():
                    prepared.publish(self.wfile)
            except BaseException:
                # The prepared owner keeps its exact byte counts when a release
                # fails, so one retry finishes the accounting without publishing
                # twice or double-releasing.  A transport failure still abandons
                # the connection; only a post-publication accounting fault that
                # the retry repaired is absorbed here.
                published = prepared.published
                try:
                    prepared.close()
                except BaseException:
                    published = False
                if not published:
                    raise
            finally:
                self._response_body_dropped_before_release = True

        def send_json(self, status: int, payload: Any) -> None:
            self.publish_prepared(self.prepare_json(status, payload))

        def finish_request_headers(
            self,
            permit: DecisionWorkPermit,
            bytes_read: int,
        ) -> None:
            physical_bytes = bytes_read * 2
            self.finish_permit(
                permit,
                phase="request_headers",
                charges={"request_header_bytes": bytes_read},
                acquires={"retained_bytes": physical_bytes},
            )
            self._request_header_retained = physical_bytes

        def handle_one_request(self) -> None:
            self.decision_work = DecisionWorkLedger(
                profile, "http request", command_kind="http_request"
            )
            self.request_deadline = HTTPRequestDeadline(
                profile.request_deadline_ms, _monotonic_clock
            )
            self._budget_error: ResourceBudgetExceeded | None = None
            self._deadline_error: RequestDeadlineExceeded | None = None
            self._bundle_deadline_active = False
            self._doctor_deadline_active = False
            self._list_deadline_active = False
            self._mr_list_deadline_active = False
            self._mutation_deadline_active = False
            self._pending_parse_error: tuple[int, dict[str, Any]] | None = None
            self._parsing_request = True
            self._request_header_retained = 0
            self._request_ast_retained = 0
            self._request_body_bytes_read = 0
            self._request_raw_dropped_before_temp_release = False
            self._request_ast_dropped_before_release = False
            self._response_body_dropped_before_release = False
            self._response_owner_observation: dict[str, Any] | None = None
            header_permit = None
            reader: _BoundedHTTPHeaderReader | None = None
            raw_reader = self.rfile
            try:
                header_limit = profile.limit("request_header_bytes")
                header_allocation_limit = min(
                    header_limit,
                    profile.limit("retained_bytes") // 2,
                )
                header_permit = self.decision_work.reserve(
                    "request_headers",
                    charges={"request_header_bytes": header_limit},
                    acquires={"retained_bytes": header_allocation_limit * 2},
                )
                reader = _BoundedHTTPHeaderReader(
                    raw_reader,
                    header_allocation_limit,
                    lambda observed: self.budget_error(
                        (
                            "request_header_bytes"
                            if header_allocation_limit == header_limit
                            else "retained_bytes"
                        ),
                        (
                            observed
                            if header_allocation_limit == header_limit
                            else observed * 2
                        ),
                        "request_headers",
                    ),
                )
                self.rfile = reader
                with transport_boundary():
                    self.raw_requestline = self.rfile.readline(65537)
                if not self.raw_requestline:
                    self.close_connection = True
                    self.finish_request_headers(header_permit, reader.bytes_read)
                    header_permit = None
                    return
                with transport_boundary():
                    parsed = self.parse_request()
                self.rfile = raw_reader
                self._parsing_request = False
                self.finish_request_headers(header_permit, reader.bytes_read)
                header_permit = None
                if not parsed:
                    if self._pending_parse_error is not None:
                        status, payload = self._pending_parse_error
                        self.send_json(status, payload)
                    return
                method_name = "do_" + self.command
                if not hasattr(self, method_name):
                    self.send_json(501, {"error": f"Unsupported method ({self.command!r})"})
                    return
                getattr(self, method_name)()
                with transport_boundary():
                    self.wfile.flush()
            except ResourceBudgetExceeded as error:
                self._budget_error = error
                self.rfile = raw_reader
                self._parsing_request = False
                if header_permit is not None and reader is not None:
                    self.finish_request_headers(
                        header_permit, reader.bytes_read
                    )
                    header_permit = None
                else:
                    self.cancel_if_open(header_permit)
                    header_permit = None
                status, payload = http_resource_budget_error(error)
                self.send_json(status, payload)
            except OSError as error:
                # Only an error the socket boundary raised abandons the
                # connection; a filesystem-origin ``TimeoutError``/``ETIMEDOUT``
                # must already have published its typed authority response.
                if not is_transport_os_error(error):
                    raise
                self.log_error("Request transport failed: %r", error)
                self.close_connection = True
            finally:
                self.rfile = raw_reader
                self._parsing_request = False
                self.cancel_if_open(header_permit)
                self.release_request_header_storage()
                if self.decision_work.has_open_permits():
                    self.close_connection = True
                elif any(self.decision_work.current.values()):
                    # Unreleased current work is never reported as a completed
                    # request: a published response with residual ownership is
                    # terminal for an exact, named cleanup reason instead.
                    self.close_connection = True
                    if self.decision_work.terminal_reason is None:
                        self.decision_work.terminate("cleanup_incomplete")
                elif self._deadline_error is not None:
                    self.close_connection = True
                elif self.decision_work.terminal_reason is None:
                    reason = (
                        "budget_exceeded"
                        if self._budget_error is not None
                        else "complete"
                    )
                    self.decision_work.terminate(reason)
                if _decision_work_observer is not None:
                    _decision_work_observer(
                        {
                            "snapshot": self.decision_work.snapshot(),
                            "open_permit_count": len(
                                self.decision_work._reserved
                            ),
                            "request_body_bytes_read": self._request_body_bytes_read,
                            "budget_diagnostic": (
                                None
                                if self._budget_error is None
                                else self._budget_error.diagnostic()
                            ),
                            "deadline_diagnostic": (
                                None
                                if self._deadline_error is None
                                else self._deadline_error.diagnostic()
                            ),
                            "deadline": self.request_deadline.snapshot(),
                            "request_raw_dropped_before_temp_release": (
                                self._request_raw_dropped_before_temp_release
                            ),
                            "request_ast_dropped_before_release": (
                                self._request_ast_dropped_before_release
                            ),
                            "response_body_dropped_before_release": (
                                self._response_body_dropped_before_release
                            ),
                            "response_owner": self._response_owner_observation,
                        }
                    )

        def project_parts(self) -> tuple[str, str, list[str]]:
            parsed = urllib.parse.urlparse(self.path)
            parts = [decode_remote_component(p, "HTTP path") for p in parsed.path.split("/") if p]
            if len(parts) < 4 or parts[:2] != ["v1", "projects"]:
                raise CFError("unknown endpoint")
            org = parts[2]
            app = parts[3]
            return org, app, parts[4:]

        def dispatch_get(
            self, read_slot: _HTTPReadResponseSlot
        ) -> tuple[int, Any]:
            """Run one read route inside the filesystem-origin boundary.

            The route body never touches the client socket, so every ``OSError``
            leaving this call without a transport mark is proved to come from a
            filesystem authority.
            """
            with route_filesystem_boundary():
                org, app, rest = self.project_parts()
                if rest == ["branches"]:
                    self._list_deadline_active = True
                    return handle_http_list(
                        storage_root,
                        org,
                        app,
                        self.decision_work,
                        self.request_deadline,
                    )
                if rest == ["doctor"]:
                    query = urllib.parse.urlparse(self.path).query
                    if query not in {"", "quick=1"}:
                        raise CFError("unsupported remote doctor query; expected quick=1")
                    self._doctor_deadline_active = True
                    return handle_http_doctor(
                        storage_root,
                        org,
                        app,
                        query == "quick=1",
                        self.decision_work,
                        deadline=self.request_deadline,
                    )
                if len(rest) == 3 and rest[0] == "branches" and rest[2] == "bundle":
                    self._bundle_deadline_active = True
                    return handle_http_bundle(
                        storage_root,
                        org,
                        app,
                        rest[1],
                        self.decision_work,
                        deadline=self.request_deadline,
                    )
                if rest == ["merge-requests"]:
                    self._mr_list_deadline_active = True
                    return handle_http_request_list(
                        storage_root,
                        org,
                        app,
                        self.decision_work,
                        self.request_deadline,
                        response_slot=read_slot,
                    )
                return http_error(404, "unknown endpoint")

        def reject_unpublishable_response(
            self, read_slot: _HTTPReadResponseSlot, failure: CFError
        ) -> None:
            """Refuse to publish a success whose ledger state could not be proved.

            The prepared bytes are released, the ledger becomes terminal for the
            exact cleanup reason before any response can be selected, and the typed
            diagnostic stays observable in the handler's error log.  The typed
            failure is then published only if the terminal control-plane state
            allows it; residual debt closes the connection with no response
            instead, so no success byte can reach the wire.
            """
            self.log_error("%s: %r", PREPARED_RESPONSE_UNPROVED_DIAGNOSTIC, failure)
            try:
                read_slot.dispose()
            except BaseException as error:
                record_secondary_failure(failure, error)
                self.log_error(
                    "prepared response disposal failed while rejecting it: %r",
                    error,
                )
                self.close_connection = True
                return
            self.close_connection = True
            if self.decision_work.terminal_reason is None:
                if not self.decision_work.has_open_permits():
                    self.decision_work.terminate("cleanup_incomplete")
            self.send_json(*http_error(400, str(failure)))

        def displace_prepared_response(
            self, read_slot: _HTTPReadResponseSlot, primary: BaseException
        ) -> bool:
            """Release a prepared owner so a different response may be selected.

            Deterministic precedence: the selected primary diagnostic always wins
            over the displaced prepared response.  If disposal itself fails the
            ledger state is unknown, so nothing is published, the disposal fault is
            recorded on the primary diagnostic, and the connection closes — a
            partially released owner may never be followed by another response.
            """
            if not read_slot.is_prepared:
                return True
            try:
                read_slot.dispose()
            except BaseException as error:
                record_secondary_failure(primary, error)
                self.log_error(
                    "prepared response disposal failed while replacing it: %r",
                    error,
                )
                self.close_connection = True
                return False
            return True

        def do_GET(self) -> None:
            payload: Any = None
            read_slot = _HTTPReadResponseSlot(self)
            try:
                try:
                    status, payload = self.dispatch_get(read_slot)
                except ResourceBudgetExceeded as exc:
                    self._budget_error = exc
                    if not self.displace_prepared_response(read_slot, exc):
                        return
                    status, payload = http_resource_budget_error(exc)
                except RequestDeadlineExceeded:
                    raise
                except CFError as exc:
                    if not self.displace_prepared_response(read_slot, exc):
                        return
                    status, payload = http_error(400, str(exc))
                except OSError as exc:
                    # No read route may answer an unusable filesystem authority
                    # with a zero-byte reply: every no-follow rejection,
                    # symlinked or directory authority, unavailable path,
                    # permission denial, metadata failure, and failed read is
                    # published as one typed diagnostic family.  Only an error
                    # raised at the real socket boundary abandons the connection.
                    # This arm is also the one reached by a post-route unlock or
                    # descriptor-close fault, so the already-prepared success is
                    # displaced instead of replacing the typed diagnostic.
                    authority = classify_route_os_error(exc)
                    if authority is None:
                        raise
                    if not self.displace_prepared_response(read_slot, authority):
                        return
                    status, payload = http_filesystem_authority_error(authority)
                else:
                    if read_slot.is_prepared:
                        # The route and both of its pinned context managers have
                        # finished unwinding.  This is the final handler-owned
                        # proof: after it only the owner transfer and the actual
                        # wire publication remain.
                        payload = None
                        try:
                            prepared = read_slot.prove_and_take()
                        except CFError as exc:
                            self.reject_unpublishable_response(read_slot, exc)
                            return
                        self.publish_prepared(prepared)
                        return
                if read_slot.closing:
                    self.close_connection = True
                    return
                self.send_json(status, payload)
                payload = None
            except RequestDeadlineExceeded as exc:
                deadline_error = RequestDeadlineExceeded(exc.phase, exc.limit_ms)
                self._deadline_error = deadline_error
                exc.__traceback__ = None
                try:
                    read_slot.close()
                    close = getattr(payload, "close", None)
                    if close is not None:
                        close()
                except BaseException:
                    self.close_connection = True
                    return
                payload = None
                current = self.decision_work.current
                route_memory_released = (
                    current.get("retained_bytes", 0)
                    == self._request_header_retained
                    and not any(
                        value
                        for dimension, value in current.items()
                        if dimension != "retained_bytes"
                    )
                    and not self.decision_work.has_open_permits()
                )
                if not route_memory_released:
                    self.close_connection = True
                    return
                if self.decision_work.terminal_reason is None:
                    self.decision_work.terminate("deadline_exceeded")
                elif self.decision_work.terminal_reason != "deadline_exceeded":
                    self.close_connection = True
                    return
                status, terminal_payload = http_request_deadline_error(
                    deadline_error
                )
                self.send_json(status, terminal_payload)
            finally:
                # The slot is already empty on every published path; this only
                # reclaims a prepared owner that no path could publish.
                try:
                    read_slot.close()
                except BaseException:
                    self.close_connection = True

        def do_POST(self) -> None:
            request: Any = None
            payload: dict[str, Any] | None = None
            request_retained = 0
            prepared: _PreparedHTTPResponseOwner | None = None
            mutation_slot: _HTTPMutationResponseSlot | None = None
            deadline_failed = False
            try:
                org, app, rest = self.project_parts()
                transfer_encodings = self.headers.get_all("Transfer-Encoding", [])
                if transfer_encodings:
                    raise CFError("Transfer-Encoding is unsupported")
                content_lengths = self.headers.get_all("Content-Length", [])
                if len(content_lengths) > 1:
                    raise CFError("duplicate Content-Length header")
                raw_length = content_lengths[0] if content_lengths else "0"
                if not raw_length or not raw_length.isascii() or not raw_length.isdigit():
                    raise CFError("malformed Content-Length header")
                maximum_length = str(U64_MAX)
                if len(raw_length) > len(maximum_length) or (
                    len(raw_length) == len(maximum_length)
                    and raw_length > maximum_length
                ):
                    raise CFError("Content-Length header exceeds u64")
                length = int(raw_length, 10)
                body_limit = profile.limit("request_body_bytes")
                if length > body_limit:
                    raise self.budget_error(
                        "request_body_bytes", length, "request_body"
                    )
                raw_temporary_upper = length * 2
                self.ensure_concurrent_capacity(
                    "temporary_bytes", raw_temporary_upper, "request_body"
                )
                body_permit = self.decision_work.reserve(
                    "request_body",
                    charges={"request_body_bytes": length},
                    acquires={"temporary_bytes": raw_temporary_upper},
                )
                raw_temporary = 0
                ast_retained = 0
                ast_permit = None
                body_bytes: bytes | None = None
                body: str | None = None
                try:
                    self.finish_permit(
                        body_permit,
                        phase="request_body",
                        charges={"request_body_bytes": length},
                        acquires={"temporary_bytes": raw_temporary_upper},
                    )
                    body_permit = None
                    raw_temporary = raw_temporary_upper
                    if length:
                        with transport_boundary():
                            body_bytes = self.rfile.read(length)
                        self._request_body_bytes_read = len(body_bytes)
                        if len(body_bytes) != length:
                            raise CFError("incomplete HTTP request body")
                        body = body_bytes.decode("utf-8")
                    else:
                        body = "{}"
                    ast_retained_upper = self.request_canonical_upper(body)
                    self.ensure_concurrent_capacity(
                        "retained_bytes", ast_retained_upper, "request_body"
                    )
                    ast_permit = self.decision_work.reserve(
                        "request_body",
                        acquires={"retained_bytes": ast_retained_upper},
                    )
                    self.finish_permit(
                        ast_permit,
                        phase="request_body",
                        acquires={"retained_bytes": ast_retained_upper},
                    )
                    ast_permit = None
                    ast_retained = ast_retained_upper
                    request = json.loads(body)
                    body = None
                    body_bytes = None
                    self._request_raw_dropped_before_temp_release = True
                    if raw_temporary:
                        self.decision_work.release(
                            "temporary_bytes", raw_temporary
                        )
                        raw_temporary = 0
                    canonical_size = canonical_json_size(request)
                    if canonical_size > ast_retained_upper:
                        raise CFError(
                            "parsed HTTP JSON exceeds its preflight ownership bound"
                        )
                    if ast_retained_upper > canonical_size:
                        self.decision_work.release(
                            "retained_bytes",
                            ast_retained_upper - canonical_size,
                        )
                    ast_retained = canonical_size
                    request_retained = canonical_size
                    self._request_ast_retained = canonical_size
                except BaseException:
                    body = None
                    body_bytes = None
                    request = None
                    try:
                        self.cancel_if_open(body_permit)
                    except BaseException:
                        pass
                    try:
                        self.cancel_if_open(ast_permit)
                    except BaseException:
                        pass
                    if raw_temporary:
                        self._request_raw_dropped_before_temp_release = True
                        try:
                            self.decision_work.release(
                                "temporary_bytes", raw_temporary
                            )
                        except BaseException:
                            pass
                    if ast_retained:
                        try:
                            self.decision_work.release(
                                "retained_bytes", ast_retained
                            )
                        except BaseException:
                            pass
                    raise
                self.cancel_if_open(body_permit)
                self.cancel_if_open(ast_permit)
                if len(rest) == 3 and rest[0] == "branches" and rest[2] == "upload":
                    self._mutation_deadline_active = True
                    mutation_slot = _HTTPMutationResponseSlot(self)
                    status, payload = handle_http_upload(
                        storage_root,
                        org,
                        app,
                        rest[1],
                        request,
                        response_slot=mutation_slot,
                        decision_work=self.decision_work,
                        deadline=self.request_deadline,
                    )
                    prepared = mutation_slot.take()
                elif rest == ["gc"]:
                    status, payload = handle_http_gc(storage_root, org, app, request)
                elif rest == ["merge-requests"]:
                    status, payload = handle_http_request_merge(storage_root, org, app, request)
                elif len(rest) == 3 and rest[0] == "merge-requests" and rest[2] == "review":
                    status, payload = handle_http_request_review(storage_root, org, app, rest[1], request)
                elif len(rest) == 3 and rest[0] == "merge-requests" and rest[2] == "apply":
                    status, payload = handle_http_request_apply(storage_root, org, app, rest[1], request)
                else:
                    status, payload = http_error(404, "unknown endpoint")
            except (UnicodeDecodeError, json.JSONDecodeError):
                status, payload = http_error(400, "invalid JSON request")
            except ResourceBudgetExceeded as exc:
                self._budget_error = exc
                status, payload = http_resource_budget_error(exc)
            except RequestDeadlineExceeded as exc:
                self._deadline_error = RequestDeadlineExceeded(
                    exc.phase, exc.limit_ms
                )
                self._mutation_deadline_active = False
                deadline_failed = True
                status, payload = http_request_deadline_error(
                    self._deadline_error
                )
            except CFError as exc:
                status, payload = http_error(400, str(exc))
            except BaseException as exc:
                # An unusable filesystem authority is published as the same
                # typed diagnostic family every read route uses.  Only an error
                # raised at the real socket boundary abandons the connection, and
                # `MemoryError`/process-fatal conditions stay outside this arm.
                authority = classify_route_os_error(exc)
                payload = None
                request = None
                if mutation_slot is not None:
                    try:
                        mutation_slot.close()
                    except BaseException:
                        pass
                    mutation_slot = None
                if prepared is not None:
                    try:
                        prepared.close()
                    except BaseException:
                        pass
                    prepared = None
                if request_retained:
                    self._request_ast_retained = 0
                    self._request_ast_dropped_before_release = True
                    try:
                        self.decision_work.release(
                            "retained_bytes", request_retained
                        )
                    except BaseException:
                        pass
                    request_retained = 0
                if authority is None:
                    raise
                status, payload = http_filesystem_authority_error(authority)
            if self.decision_work.terminal_reason is not None:
                request = None
                if mutation_slot is not None:
                    mutation_slot.close()
                    mutation_slot = None
                if request_retained:
                    self._request_ast_retained = 0
                    self._request_ast_dropped_before_release = True
                    self.decision_work.release(
                        "retained_bytes", request_retained
                    )
                    request_retained = 0
            try:
                if prepared is None:
                    prepared = self.prepare_json(status, payload)
            finally:
                payload = None
                request = None
                if mutation_slot is not None:
                    mutation_slot.close()
                    mutation_slot = None
                if request_retained:
                    self._request_ast_dropped_before_release = True
                    self.decision_work.release(
                        "retained_bytes", request_retained
                    )
                    request_retained = 0
                    self._request_ast_retained = 0
            self.publish_prepared(prepared)
            if deadline_failed and self.decision_work.terminal_reason is None:
                self.decision_work.terminate("deadline_exceeded")

    return CodeFireHTTPHandler


def is_ancestor(repo_root: Path, ancestor: str, commit_id: str) -> bool:
    return ancestor in ancestor_distances(repo_root, commit_id)


def remote_commit_parents(project_root: Path, commit_id: str) -> list[str]:
    return list(load_object_from_root(remote_dirs(project_root)["objects"], commit_id).get("parents", []))


def remote_ancestor_distances(project_root: Path, commit_id: str) -> dict[str, int]:
    distances: dict[str, int] = {}
    queue = deque([(commit_id, 0)])
    while queue:
        current, dist = queue.popleft()
        if current in distances and distances[current] <= dist:
            continue
        distances[current] = dist
        for parent in remote_commit_parents(project_root, current):
            queue.append((parent, dist + 1))
    return distances


def remote_is_ancestor(project_root: Path, ancestor: str, commit_id: str) -> bool:
    return ancestor in remote_ancestor_distances(project_root, commit_id)


def remote_pending_object_roots(project_root: Path) -> list[str]:
    pending = read_json(project_root / "pending_transaction.json")
    if pending is None:
        return []
    known_operations = {
        "remote_upload",
        "remote_request_merge",
        "remote_request_review",
        "remote_request_apply",
    }
    if (
        not isinstance(pending, dict)
        or pending.get("type") != "remote_publication_transaction"
        or pending.get("version") != VERSION
        or pending.get("operation") not in known_operations
        or (pending.get("status"), pending.get("phase"))
        not in {("pending", "applying"), ("completed", "completed")}
    ):
        raise CFError(
            "foreign or future remote pending transaction blocks root discovery"
        )
    roots = pending.get("object_roots") if isinstance(pending, dict) else None
    if not isinstance(roots, list) or len(roots) > 64:
        raise CFError("remote pending transaction object roots are malformed")
    result: list[str] = []
    for root in roots:
        if (
            not isinstance(root, dict)
            or set(root) != {"kind", "id"}
            or root.get("kind") != "sealed_commit"
            or not isinstance(root.get("id"), str)
        ):
            raise CFError("remote pending transaction object root is malformed")
        result.append(root["id"])
    if len(set(result)) != len(result):
        raise CFError("remote pending transaction object roots are duplicated")
    return result


def reachable_remote_objects(project_root: Path) -> set[str]:
    dirs = remote_dirs(project_root)
    roots: list[str] = []
    for path in dirs["branches"].glob("*.json"):
        branch = validate_remote_branch_record(read_json(path))
        if branch and branch.get("head"):
            roots.append(branch["head"])
    for path in dirs["merge_requests"].glob("*.json"):
        mr = read_remote_merge_request_path(path)
        for key in ["source_head", "target_head_at_request", "applied_head"]:
            if mr and mr.get(key):
                roots.append(mr[key])
    roots.extend(remote_pending_object_roots(project_root))
    reachable: set[str] = set()
    stack = roots[:]
    objects_root = dirs["objects"]
    while stack:
        oid = stack.pop()
        if oid in reachable:
            continue
        if object_record_path(objects_root, oid) is None:
            continue
        reachable.add(oid)
        stack.extend(
            object_record_references(load_object_record_from_root(objects_root, oid))
        )
    return reachable


def all_remote_object_records(project_root: Path) -> list[Path]:
    return sorted(remote_dirs(project_root)["objects"].glob("*/*.json"))


def object_hash_error_paths(objects_root: Path) -> list[Path]:
    bad = []
    for path in objects_root.glob("*/*.json"):
        record = read_json(path)
        try:
            validate_object_record(record, path=path)
        except CFError:
            bad.append(path)
    return bad


def object_graph_missing_references(objects_root: Path, roots: list[str]) -> list[str]:
    missing: set[str] = set()
    seen: set[str] = set()
    stack = roots[:]
    while stack:
        oid = stack.pop()
        if oid in seen:
            continue
        seen.add(oid)
        path = object_record_path(objects_root, oid)
        if path is None:
            missing.add(oid)
            continue
        record = read_json(path)
        try:
            validate_object_record(record, expected_oid=oid, path=path)
        except CFError:
            continue
        stack.extend(object_record_references(record))
    return sorted(missing)


