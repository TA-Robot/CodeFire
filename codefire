        "branches",
]


def _open_directory_at(parent_fd: int, name: str) -> int:
    validate_remote_component(name, "directory")
    flags = os.O_RDONLY | getattr(os, "O_DIRECTORY", 0) | os.O_NOFOLLOW
    return os.open(name, flags, dir_fd=parent_fd)


def _initialize_or_validate_remote_project_at(
    project_fd: int, project_root: Path, org: str, app: str
) -> None:
    try:
        _validate_remote_project_descriptor_at(project_fd, project_root, org, app)
    except FileNotFoundError:
        if _remote_project_contains_legacy_authority_at(project_fd):
            raise CFError(
                f"legacy remote project requires administrative quiescence and explicit migration before mutation: {project_root}"
            )
        _write_remote_project_descriptor_at(
            project_fd, project_root, org, app, "configured_empty_root"
        )
    _create_remote_base_layout_at(project_fd)
    os.fsync(project_fd)
    _validate_remote_project_descriptor_at(project_fd, project_root, org, app)


def _entry_exists_at(directory_fd: int, name: str) -> bool:
    try:
        os.stat(name, dir_fd=directory_fd, follow_symlinks=False)
        return True
    except FileNotFoundError:
        return False


def _directory_has_entries_at(directory_fd: int, name: str) -> bool:
    try:
        child_fd = _open_directory_at(directory_fd, name)
    except FileNotFoundError:
        return False
    except OSError:
        return True
    try:
        return bool(os.listdir(child_fd))
    finally:
        os.close(child_fd)


def _directory_tree_contains_authority_at(directory_fd: int, name: str) -> bool:
    try:
        child_fd = _open_directory_at(directory_fd, name)
    except FileNotFoundError:
        return False
    except OSError:
        return True
    try:
        for entry in os.listdir(child_fd):
            metadata = os.stat(entry, dir_fd=child_fd, follow_symlinks=False)
            if not stat.S_ISDIR(metadata.st_mode):
                return True
            if _directory_tree_contains_authority_at(child_fd, entry):
                return True
        return False
    finally:
        os.close(child_fd)


def _remote_project_contains_legacy_authority_at(project_fd: int) -> bool:
    if any(
        _entry_exists_at(project_fd, name)
        for name in ["gc_state.json", "request_nonce_cache.json", "pending_transaction.json"]
    ):
        return True
    if _directory_tree_contains_authority_at(project_fd, "objects"):
        return True
    return any(
        _directory_has_entries_at(project_fd, name)
        for name in ["branches", "merge_requests", "idempotency", "transactions", "gc"]
    )


def _create_remote_base_layout_at(project_fd: int) -> None:
    child_fds: dict[str, int] = {}
    try:
        for name in [
            "objects",
            "branches",
            "merge_requests",
            "locks",
            "idempotency",
            "audit",
            "transactions",
            "gc",
        ]:
            child_fds[name] = _open_or_create_directory_at(project_fd, name)
        objects_fd = child_fds["objects"]
        for typ in REMOTE_OBJECT_SUBDIRS:
            child = _open_or_create_directory_at(objects_fd, typ)
            os.close(child)
        for fd in child_fds.values():
            os.fsync(fd)
    finally:
        for fd in child_fds.values():
            os.close(fd)


def _read_regular_bounded_at(directory_fd: int, name: str, limit: int) -> bytes:
    fd = os.open(name, os.O_RDONLY | os.O_NOFOLLOW, dir_fd=directory_fd)
    try:
        before = os.fstat(fd)
        linked = os.stat(name, dir_fd=directory_fd, follow_symlinks=False)
        if (
            not stat.S_ISREG(before.st_mode)
            or before.st_nlink != 1
            or before.st_size > limit
            or (before.st_dev, before.st_ino) != (linked.st_dev, linked.st_ino)
        ):
            raise CFError(f"bounded authority file is invalid: {name}")
        chunks: list[bytes] = []
        remaining = limit + 1
        while remaining:
            chunk = os.read(fd, min(64 * 1024, remaining))
            if not chunk:
                break
            chunks.append(chunk)
            remaining -= len(chunk)
        data = b"".join(chunks)
        after = os.fstat(fd)
        if len(data) > limit or (before.st_dev, before.st_ino) != (after.st_dev, after.st_ino):
            raise CFError(f"bounded authority file changed while reading: {name}")
        return data
    finally:
        os.close(fd)


def _write_all_fd(fd: int, payload: bytes) -> None:
    remaining = memoryview(payload)
    while remaining:
        try:
            written = os.write(fd, remaining)
        except InterruptedError:
            continue
        if written <= 0:
            raise OSError("durable authority write made no progress")
        remaining = remaining[written:]


def _write_create_noreplace_at(directory_fd: int, name: str, payload: bytes) -> None:
    temp_name = f".{name}.tmp-{os.getpid()}-{time.time_ns()}"
    temp_fd = os.open(
        temp_name,
        os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW,
        0o600,
        dir_fd=directory_fd,
    )
    try:
        _write_all_fd(temp_fd, payload)
        os.fsync(temp_fd)
    finally:
        os.close(temp_fd)
    try:
        os.link(
            temp_name,
            name,
            src_dir_fd=directory_fd,
            dst_dir_fd=directory_fd,
            follow_symlinks=False,
        )
        os.unlink(temp_name, dir_fd=directory_fd)
        os.fsync(directory_fd)
    except Exception:
        try:
            os.unlink(temp_name, dir_fd=directory_fd)
        except OSError:
            pass
        raise


def _write_atomic_durable_at(directory_fd: int, name: str, payload: bytes) -> None:
    if not name or name in {".", ".."} or "/" in name or "\\" in name or "\x00" in name:
        raise CFError("invalid remote publication authority filename")
    temp_name = f".{name}.tmp-{os.getpid()}-{time.time_ns()}"
    temp_fd = os.open(
        temp_name,
        os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW,
        0o600,
        dir_fd=directory_fd,
    )
    try:
        _write_all_fd(temp_fd, payload)
        os.fsync(temp_fd)
    finally:
        os.close(temp_fd)
    try:
        os.replace(
            temp_name,
            name,
            src_dir_fd=directory_fd,
            dst_dir_fd=directory_fd,
        )
        os.fsync(directory_fd)
    except Exception:
        try:
            os.unlink(temp_name, dir_fd=directory_fd)
        except FileNotFoundError:
            pass
        raise


