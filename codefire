def cmd_diff(args: argparse.Namespace) -> int:
    temp_dirs: list[tempfile.TemporaryDirectory] = []
    try:
        needs_repo = not is_remote_url(args.left) or not is_remote_url(args.right)
        repo_root = find_repo_root(Path.cwd()) if needs_repo else None
        left_objects, left_id, left_label = resolve_commitish_any(repo_root, args.left, temp_dirs)
        right_objects, right_id, right_label = resolve_commitish_any(repo_root, args.right, temp_dirs)
        left = manifest_contents_from_root(left_objects, left_id)
        right = manifest_contents_from_root(right_objects, right_id)
        changed = False
        for rel in sorted(set(left) | set(right)):
            ldata = left.get(rel)
            rdata = right.get(rel)
            if ldata == rdata:
                continue
            changed = True
            ltext = [] if ldata is None else ldata.decode("utf-8", errors="replace").splitlines(keepends=True)
            rtext = [] if rdata is None else rdata.decode("utf-8", errors="replace").splitlines(keepends=True)
            fromfile = f"{left_label}/{rel}" if ldata is not None else f"{left_label}/{rel} (missing)"
            tofile = f"{right_label}/{rel}" if rdata is not None else f"{right_label}/{rel} (missing)"
            for line in difflib.unified_diff(ltext, rtext, fromfile=fromfile, tofile=tofile):
                print(line, end="")
        if not changed:
            print("No differences.")
        return 0
    finally:
        for temp_dir in temp_dirs:
            temp_dir.cleanup()


def _run_local_doctor_accounted(repo_root: Path, dirs: dict[str, Path]) -> int:
    ledger = DecisionWorkLedger(DecisionWorkProfile.local_v1(), "local doctor")
    session = SealedCommitValidationSession(dirs["objects"], ledger)
    retained = 0
    branch_paths: list[Path] = []
    refs: list[tuple[str, str]] = []
    roots: list[str] = []
    lines: list[str] = []
    bad_paths: list[Path] = []
    missing_refs: list[str] = []
    invalid_sealed_refs: list[str] = []
    try:
        branch_paths, path_retained = accounted_sorted_json_paths(
            dirs["branches"], ledger
        )
        retained += path_retained
        for path in branch_paths:
            ledger.apply(
                "graph_discovery",
                charges={"graph_nodes": 1},
                maxima={"maximum_frontier": 1},
                counters={
                    "unique_nodes_discovered": 1,
                    "frontier_insertion_attempts": 1,
                },
            )
            branch, branch_retained = read_json_accounted(path, ledger)
            retained += branch_retained
            if branch and branch.get("head"):
                roots.append(branch["head"])
                refs.append(
                    (f"branch {branch.get('name', path.stem)}", branch["head"])
                )
        refs_retained = canonical_json_size([roots, refs])
        ledger.acquire("retained_bytes", refs_retained, "query")
        retained += refs_retained
        bad_paths = session.scan_object_hash_errors()
        missing_refs = session.missing_references(roots)
        invalid_sealed_refs = sealed_commit_reference_errors(
            dirs["objects"], refs, session=session
        )
        lines = [
            "CodeFire doctor",
            f"repo: {repo_root}",
            *[
                f"{name}: {'ok' if dirs[name].exists() else 'missing'}"
                for name in ["objects", "branches", "opened", "active"]
            ],
            *[f"bad object: {path}" for path in bad_paths],
            *[f"missing object: {oid}" for oid in missing_refs],
            *[
                f"invalid sealed ref: {error}"
                for error in invalid_sealed_refs
            ],
            f"object hash errors: {len(bad_paths)}",
            f"missing object references: {len(missing_refs)}",
            f"invalid sealed commit references: {len(invalid_sealed_refs)}",
        ]
        output_retained = canonical_json_size(lines)
        ledger.acquire("retained_bytes", output_retained, "query")
        retained += output_retained
        session.finalize(terminate=False)
        for line in lines:
            print(line)
        exit_code = 1 if bad_paths or missing_refs or invalid_sealed_refs else 0
        branch_paths.clear()
        refs.clear()
        roots.clear()
        lines.clear()
        bad_paths.clear()
        missing_refs.clear()
        invalid_sealed_refs.clear()
        ledger.release("retained_bytes", retained)
        retained = 0
        ledger.terminate("complete")
        return exit_code
    finally:
        branch_paths.clear()
        refs.clear()
        roots.clear()
        lines.clear()
        bad_paths.clear()
        missing_refs.clear()
        invalid_sealed_refs.clear()
        if retained:
            ledger.release("retained_bytes", retained)
        session.close(None)


def cmd_doctor(args: argparse.Namespace) -> int:
    if args.target and is_http_remote_url(args.target):
        info = parse_cf_http_project_url(args.target)
        payload = http_json("GET", http_remote_path(info, "doctor"))
        payload["project"] = args.target
        return print_remote_doctor_payload(payload)
    if args.target and args.target.startswith("cf://"):
        info = parse_cf_project_url(args.target)
        if not info["project_root"].is_dir():
            return print_remote_doctor_payload(
                remote_doctor_payload(info["project_root"], info["url"])
            )
        with remote_project_gate(info["project_root"], shared=True):
            return print_remote_doctor_payload(remote_doctor_payload(info["project_root"], info["url"]))
    if args.target:
        start = Path(args.target)
    else:
        start = Path.cwd()
    repo_root = find_repo_root(start)
    dirs = repo_dirs(repo_root)
    return _run_local_doctor_accounted(repo_root, dirs)


def cmd_serve(args: argparse.Namespace) -> int:
    storage_root = Path(args.storage_root).expanduser().resolve()
    storage_root.mkdir(parents=True, exist_ok=True)
    profile = DecisionWorkProfile.http_v1()
    context = None
    scheme = "cf+http"
    if args.tls_cert or args.tls_key:
        if not args.tls_cert or not args.tls_key:
            raise CFError("--tls-cert and --tls-key must be provided together")
        context = ssl.SSLContext(ssl.PROTOCOL_TLS_SERVER)
        context.load_cert_chain(certfile=args.tls_cert, keyfile=args.tls_key)
        scheme = "cf+https"
    server = ReusableThreadingHTTPServer(
        (args.host, args.port),
        make_http_handler(storage_root, profile),
        decision_work_profile=profile,
        tls_context=context,
    )
    host, port = server.server_address
    display_host = host if host not in {"0.0.0.0", "::"} else args.host
    print(f"serving CodeFire HTTP remote: {scheme}://{display_host}:{port}", flush=True)
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        pass
    finally:
        server.server_close()
    return 0


