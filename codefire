def reject_legacy_cross_project_merge_request_read(
    mr: dict[str, Any], source_project_root: Path, target_project_root: Path
) -> None:
    if "subject" not in mr and source_project_root != target_project_root:
        raise CFError(
            "legacy cross-project merge request cannot be read without holding both "
            "project gates; run request-review to materialize its target-local subject"
        )


def canonical_remote_object_records(
    records: list[dict[str, Any]],
) -> list[dict[str, Any]]:
    canonical = sorted(
        records,
        key=lambda record: str(record.get("object_id", ""))
        if isinstance(record, dict)
        else "",
    )
    seen: set[str] = set()
    for record in canonical:
        object_id = record.get("object_id") if isinstance(record, dict) else None
        if not isinstance(object_id, str) or not object_id:
            raise CFError("remote object set contains a record without an object ID")
        if object_id in seen:
            raise CFError("remote object set contains a duplicate object ID")
        seen.add(object_id)
    return canonical


class AccountedRemoteObjectSetDigest:
    """Own one canonical object-set digest on a decision-work ledger."""

    ORDERED_LIST_BASE_BYTES = sys.getsizeof([])
    ORDERED_LIST_SLOT_BYTES = 16
    DIGEST_RETAINED_BYTES = 256
    ENCODER_BASE_BYTES = 4096
    ENCODER_BYTES_PER_SOURCE_BYTE = 256

    def __init__(
        self,
        records: list[dict[str, Any]],
        ledger: DecisionWorkLedger,
        source_canonical_upper: int,
        deadline: HTTPRequestDeadline | None = None,
        *,
        _handoff_owner: Any | None = None,
    ) -> None:
        if (
            isinstance(source_canonical_upper, bool)
            or not isinstance(source_canonical_upper, int)
            or source_canonical_upper < 0
        ):
            raise CFError(
                "remote object-set source upper must be a non-negative integer"
            )
        if source_canonical_upper > (
            U64_MAX - self.ENCODER_BASE_BYTES
        ) // self.ENCODER_BYTES_PER_SOURCE_BYTE:
            raise CFError("remote object-set source upper exceeds the u64 domain")
        self._ledger = ledger
        self._ledger_identity = id(ledger)
        self._ordered: list[dict[str, Any]] | None = None
        self._digest: str | None = None
        self._retained_bytes = 0
        self._temporary_bytes = 0
        self._work_permit: DecisionWorkPermit | None = None
        self._closed = False
        if _handoff_owner is not None:
            if object.__getattribute__(_handoff_owner, "_digest_owner") is not None:
                raise CFError("remote object-set digest handoff slot is occupied")
            # Publish the exact child before its first reservation.  A
            # constructor/cleanup failure therefore remains caller-owned by
            # the already-returned semantic destination.
            object.__setattr__(_handoff_owner, "_digest_owner", self)
        initialized = False
        failure: BaseException | None = None
        work_permit: DecisionWorkPermit | None = None
        try:
            retained_bytes = (
                self.ORDERED_LIST_BASE_BYTES
                + self.ORDERED_LIST_SLOT_BYTES * len(records)
                + self.DIGEST_RETAINED_BYTES
            )
            temporary_bytes = (
                self.ENCODER_BASE_BYTES
                + self.ENCODER_BYTES_PER_SOURCE_BYTE * source_canonical_upper
            )
            acquires = {
                "retained_bytes": retained_bytes,
                "temporary_bytes": temporary_bytes,
            }
            # Publish a caller-created permit before reserve_into.  A
            # registered-then-raise reservation therefore cannot become an
            # unobservable constructor-local permit.
            work_permit = DecisionWorkPermit()
            self._work_permit = work_permit
            reserve_failure: BaseException | None = None
            try:
                ledger.reserve_into(
                    work_permit,
                    "query",
                    charges={
                        "aggregate_bytes": source_canonical_upper,
                        "object_records": len(records),
                    },
                    acquires=acquires,
                    counters={"object_records": len(records)},
                )
            except BaseException as error:
                reserve_failure = error
            if work_permit not in ledger._reserved:
                self._work_permit = None
                work_permit = None
                if reserve_failure is not None:
                    raise reserve_failure
                raise CFError(
                    "remote object-set digest reservation was not registered"
                )
            if reserve_failure is not None:
                self._detach_failure_chain(reserve_failure)

            # Reconcile acquisitions even if the ledger raises after commit.
            # The published owner can then release the exact scalars.
            retained_before = ledger._current.get("retained_bytes", 0)
            temporary_before = ledger._current.get("temporary_bytes", 0)
            consume_failure: BaseException | None = None
            try:
                ledger.consume_reserved(
                    work_permit,
                    phase="query",
                    acquires=acquires,
                )
            except BaseException as error:
                consume_failure = error
            retained_committed = (
                ledger._current.get("retained_bytes", 0)
                == retained_before + retained_bytes
            )
            temporary_committed = (
                ledger._current.get("temporary_bytes", 0)
                == temporary_before + temporary_bytes
            )
            if retained_committed and temporary_committed:
                self._retained_bytes = retained_bytes
                self._temporary_bytes = temporary_bytes
                if consume_failure is not None:
                    self._detach_failure_chain(consume_failure)
            elif consume_failure is not None:
                raise consume_failure
            else:
                raise CFError(
                    "remote object-set digest acquisition did not commit"
                )
            if work_permit not in ledger._reserved:
                self._work_permit = None
            work_permit = None
            self._ordered = list(records)
            self._heap_sort(deadline)
            self._validate_ordered(deadline)
            self._validate_source_upper(
                source_canonical_upper, deadline
            )
            self._digest = self._hash_ordered(deadline)
            permit = self._work_permit
            if permit is not None and self._ledger.permit_is_open(permit):
                self._ledger.cancel_permit(permit)
            self._work_permit = None
            initialized = True
        except BaseException as exc:
            # Streaming helpers may leave large local stacks/key lists in an
            # exception traceback. Detach those frames before ledger-owned
            # Temporary/Retained scalars are released by close().
            self._detach_failure_chain(exc)
            failure = exc
        finally:
            if work_permit is not None and ledger.permit_is_open(work_permit):
                ledger.cancel_permit(work_permit)
            if not initialized:
                self.close()
        if failure is not None:
            raise failure

    @staticmethod
    def _poll(deadline: HTTPRequestDeadline | None) -> None:
        if deadline is not None:
            deadline.check("remote object-set digest")

    @staticmethod
    def _detach_failure_chain(failure: BaseException) -> None:
        current: BaseException | None = failure
        while current is not None:
            next_failure = current.__cause__ or current.__context__
            current.__traceback__ = None
            current.__cause__ = None
            current.__context__ = None
            current = next_failure

    @staticmethod
    def _sort_key(record: Any) -> str:
        return (
            str(record.get("object_id", ""))
            if isinstance(record, dict)
            else ""
        )

    def _heap_sort(self, deadline: HTTPRequestDeadline | None) -> None:
        ordered = self._ordered
        if ordered is None:
            raise CFError("remote object-set digest owner is unavailable")

        def sift_down(root: int, end: int) -> None:
            while root * 2 + 1 <= end:
                self._poll(deadline)
                child = root * 2 + 1
                if (
                    child + 1 <= end
                    and self._sort_key(ordered[child])
                    < self._sort_key(ordered[child + 1])
                ):
                    child += 1
                if self._sort_key(ordered[root]) >= self._sort_key(
                    ordered[child]
                ):
                    return
                ordered[root], ordered[child] = ordered[child], ordered[root]
                root = child

        for root in range((len(ordered) - 2) // 2, -1, -1):
            sift_down(root, len(ordered) - 1)
        for end in range(len(ordered) - 1, 0, -1):
            self._poll(deadline)
            ordered[0], ordered[end] = ordered[end], ordered[0]
            sift_down(0, end - 1)

    def _validate_ordered(
        self, deadline: HTTPRequestDeadline | None
    ) -> None:
        ordered = self._ordered
        if ordered is None:
            raise CFError("remote object-set digest owner is unavailable")
        prior: str | None = None
        for record in ordered:
            self._poll(deadline)
            object_id = (
                record.get("object_id")
                if isinstance(record, dict)
                else None
            )
            if not isinstance(object_id, str) or not object_id:
                raise CFError(
                    "remote object set contains a record without an object ID"
                )
            if object_id == prior:
                raise CFError(
                    "remote object set contains a duplicate object ID"
                )
            prior = object_id

    def _validate_source_upper(
        self,
        source_canonical_upper: int,
        deadline: HTTPRequestDeadline | None,
    ) -> None:
        """Reject a false source bound before encoder-owned key allocations."""
        ordered = self._ordered
        if ordered is None:
            raise CFError("remote object-set digest owner is unavailable")
        remaining = source_canonical_upper
        framing = 2 + max(0, len(ordered) - 1)
        if framing > remaining:
            raise CFError(
                "remote object-set canonical bytes exceed the source upper"
            )
        remaining -= framing
        for record in ordered:
            self._poll(deadline)
            record_bytes = canonical_json_size_up_to(
                record,
                remaining,
                None if deadline is None else lambda: self._poll(deadline),
            )
            if record_bytes > remaining:
                raise CFError(
                    "remote object-set canonical bytes exceed the source upper"
                )
            remaining -= record_bytes

    def _consume_hash_work(self, amount: int, *, record: bool = False) -> None:
        permit = self._work_permit
        if permit is None:
            raise CFError("remote object-set digest reservation is unavailable")
        self._ledger.consume_reserved(
            permit,
            phase="query",
            charges={
                "aggregate_bytes": amount,
                **({"object_records": 1} if record else {}),
            },
            counters={"object_records": 1} if record else {},
        )
        if not self._ledger.permit_is_open(permit):
            self._work_permit = None

    class _AccountedDigest:
        def __init__(self, owner: "AccountedRemoteObjectSetDigest") -> None:
            self._owner = owner
            self._digest = hashlib.sha256()

        def update(self, data: Any) -> None:
            self._owner._consume_hash_work(len(data))
            self._digest.update(data)

        def hexdigest(self) -> str:
            return self._digest.hexdigest()

    def _hash_ordered(
        self, deadline: HTTPRequestDeadline | None
    ) -> str:
        ordered = self._ordered
        if ordered is None:
            raise CFError("remote object-set digest owner is unavailable")
        digest = self._AccountedDigest(self)
        digest.update(b"[")
        for index, record in enumerate(ordered):
            self._poll(deadline)
            if index:
                digest.update(b",")
            self._consume_hash_work(0, record=True)
            _hash_canonical_json_polling(
                digest,
                record,
                lambda: self._poll(deadline),
            )
        digest.update(b"]")
        return "sha256:" + digest.hexdigest()

    def matches_digest(self, expected: str) -> bool:
        if self._closed or self._digest is None:
            raise CFError("remote object-set digest owner is closed")
        if not isinstance(expected, str):
            return False
        return hmac.compare_digest(self._digest, expected)

    def close(self) -> None:
        if self._closed:
            return
        if id(self._ledger) != self._ledger_identity:
            raise CFError(
                "remote object-set digest belongs to a different ledger"
            )
        self._digest = None
        if self._ordered is not None:
            self._ordered.clear()
            self._ordered = None
        permit = self._work_permit
        if permit is not None and self._ledger.permit_is_open(permit):
            self._ledger.cancel_permit(permit)
        self._work_permit = None
        self._release_owned_dimension("temporary_bytes", "_temporary_bytes")
        self._release_owned_dimension("retained_bytes", "_retained_bytes")
        self._closed = True

    def _release_owned_dimension(self, dimension: str, attribute: str) -> None:
        amount = getattr(self, attribute)
        if not amount:
            return
        before = self._ledger._current.get(dimension, 0)
        expected_after = before - amount
        failure: BaseException | None = None
        try:
            self._ledger.release(dimension, amount)
        except BaseException as error:
            failure = error
        after = self._ledger._current.get(dimension, 0)
        committed = after == expected_after
        if committed:
            setattr(self, attribute, 0)
        if failure is not None:
            if not committed:
                raise failure
            self._detach_failure_chain(failure)
        elif not committed:
            raise CFError(
                f"remote object-set digest {dimension} release did not commit"
            )

    def __del__(self) -> None:
        try:
            self.close()
        except BaseException:
            pass


def prepare_remote_object_set_digest(
    records: list[dict[str, Any]],
    ledger: DecisionWorkLedger,
    source_canonical_upper: int,
    deadline: HTTPRequestDeadline | None = None,
) -> AccountedRemoteObjectSetDigest:
    """Prepare a non-escaping digest owner from an already-owned source upper."""
    return AccountedRemoteObjectSetDigest(
        records, ledger, source_canonical_upper, deadline
    )


class AccountedHTTPUploadParserScalar:
    """Own one parser Retained upper and reconcile it to the exact AST."""

    def __init__(
        self, ledger: DecisionWorkLedger, parser_canonical_upper: int
    ) -> None:
        if (
            isinstance(parser_canonical_upper, bool)
            or not isinstance(parser_canonical_upper, int)
            or parser_canonical_upper < 0
        ):
            raise CFError(
                "HTTP upload parser upper must be a non-negative integer"
            )
        self._ledger = ledger
        self._ledger_identity = id(ledger)
        self._parser_canonical_upper = parser_canonical_upper
        self._parser_canonical_bytes: int | None = None
        self._allocation = _StablePermitTransition(ledger)
        self._source: AccountedHTTPUploadRequestSource | None = None
        self._acquiring = False
        self._reconciling = False
        self._acquired = False
        self._acquire_used = False
        self._reconcile_target: int | None = None
        self._reconciled = False
        self._closing = False
        self._close_requested = False
        self._closed = False

    def _ensure_ledger(self, ledger: DecisionWorkLedger) -> None:
        if (
            id(ledger) != self._ledger_identity
            or id(self._ledger) != self._ledger_identity
        ):
            raise CFError("HTTP upload parser scalar belongs to a different ledger")

    def acquire(self, ledger: DecisionWorkLedger) -> None:
        """Acquire the exact scalar after the caller owns this token."""
        self._ensure_ledger(ledger)
        if self._closed:
            raise CFError("HTTP upload parser scalar is closed")
        if self._acquiring:
            raise CFError("HTTP upload parser scalar acquisition is already active")
        if self._acquire_used:
            raise CFError("HTTP upload parser scalar acquisition is single-use")
        self._acquire_used = True
        self._acquiring = True
        failure: BaseException | None = None
        amount = self._parser_canonical_upper
        try:
            self._allocation.__init__(ledger, retained_primary=amount)
            self._allocation.reserve(
                "request_body", acquires={"retained_bytes": amount}
            )
            self._allocation.consume(
                phase="request_body", acquires={"retained_bytes": amount}
            )
            self._allocation.cancel()
            self._acquired = True
        except BaseException as error:
            AccountedRemoteObjectSetDigest._detach_failure_chain(error)
            failure = error
        self._acquiring = False
        close_requested = self._close_requested
        cleanup_failure: BaseException | None = None
        if close_requested:
            try:
                self.close(ledger)
            except BaseException as error:
                AccountedRemoteObjectSetDigest._detach_failure_chain(error)
                cleanup_failure = error
        if cleanup_failure is not None:
            if failure is not None:
                raise cleanup_failure from failure
            raise cleanup_failure from None
        if failure is not None:
            raise failure from None
        if close_requested:
            raise CFError("HTTP upload parser scalar acquisition was cancelled by close")

    def reconcile_exact(
        self, ledger: DecisionWorkLedger, parser_canonical_bytes: int
    ) -> None:
        """Shrink the pre-parse upper to the parser's exact canonical size."""
        self._ensure_ledger(ledger)
        if self._closed or not self._acquired:
            raise CFError("HTTP upload parser scalar is not acquired")
        if (
            isinstance(parser_canonical_bytes, bool)
            or not isinstance(parser_canonical_bytes, int)
            or parser_canonical_bytes < 0
            or parser_canonical_bytes > self._parser_canonical_upper
        ):
            raise CFError("HTTP upload parser exact scalar exceeds its upper")
        if self._reconciling:
            raise CFError("HTTP upload parser reconciliation is already active")
        if self._reconciled:
            raise CFError("HTTP upload parser reconciliation is single-use")
        if self._reconcile_target is None:
            self._reconcile_target = parser_canonical_bytes
        elif self._reconcile_target != parser_canonical_bytes:
            raise CFError("HTTP upload parser reconciliation target changed")
        self._reconciling = True
        failure: BaseException | None = None
        try:
            self._allocation.shrink_retained_primary(parser_canonical_bytes)
            self._parser_canonical_bytes = parser_canonical_bytes
            self._reconciled = True
        except BaseException as error:
            AccountedRemoteObjectSetDigest._detach_failure_chain(error)
            failure = error
        self._reconciling = False
        close_requested = self._close_requested
        cleanup_failure: BaseException | None = None
        if close_requested:
            try:
                self.close(ledger)
            except BaseException as error:
                AccountedRemoteObjectSetDigest._detach_failure_chain(error)
                cleanup_failure = error
        if cleanup_failure is not None:
            if failure is not None:
                raise cleanup_failure from failure
            raise cleanup_failure from None
        if failure is not None:
            raise failure from None
        if close_requested:
            raise CFError(
                "HTTP upload parser reconciliation was cancelled by close"
            )

    def _ensure_reconciled(self, ledger: DecisionWorkLedger) -> None:
        self._ensure_ledger(ledger)
        if self._closed or not self._acquired or not self._reconciled:
            raise CFError("HTTP upload parser scalar is not reconciled")

    def _close_from_source(
        self, source: "AccountedHTTPUploadRequestSource"
    ) -> None:
        if self._source is not source:
            raise CFError("HTTP upload parser scalar has a foreign source")
        self._close(source)

    def _close(
        self, source: "AccountedHTTPUploadRequestSource" | None
    ) -> None:
        if self._closed:
            return
        if self._source is not source:
            if self._source is not None:
                raise CFError("HTTP upload parser scalar was adopted")
            raise CFError("HTTP upload parser scalar has a foreign source")
        if self._acquiring or self._reconciling:
            self._close_requested = True
            return
        if self._closing:
            return
        self._closing = True
        completed = False
        try:
            self._allocation.release_all()
            self._source = None
            self._parser_canonical_upper = 0
            self._parser_canonical_bytes = None
            self._acquired = False
            self._reconciled = False
            self._close_requested = False
            completed = True
        finally:
            if completed:
                self._closed = True
            self._closing = False

    def close(self, ledger: DecisionWorkLedger) -> None:
        self._ensure_ledger(ledger)
        self._close(None)

    def __del__(self) -> None:
        try:
            if self._source is None:
                self._close(None)
        except BaseException:
            pass


def prepare_http_upload_parser_scalar(
    ledger: DecisionWorkLedger, parser_canonical_upper: int
) -> AccountedHTTPUploadParserScalar:
    """Allocate one parser token before acquiring its pre-parse upper."""
    return AccountedHTTPUploadParserScalar(ledger, parser_canonical_upper)


class AccountedHTTPUploadRequestSource:
    """Bind one exactly reconciled parser AST scalar to its request.

    This production-unwired source does not acquire memory.  The HTTP parser
    token has already acquired its pre-parse upper and shrunk it in-place to
    ``parser_canonical_bytes`` for ``request``; the source merely makes that
    exact scalar transferable without a release/reacquire gap.  Only
    ``AccountedHTTPUploadSemantic`` may adopt it.
    """

    def __init__(
        self,
        request: dict[str, Any],
        ledger: DecisionWorkLedger,
        scalar: AccountedHTTPUploadParserScalar,
    ) -> None:
        if type(request) is not dict:
            raise CFError("HTTP upload request source requires a parser mapping")
        records = dict.get(request, "objects")
        if type(records) is not list:
            raise CFError("HTTP upload request source requires the exact objects list")
        if not isinstance(scalar, AccountedHTTPUploadParserScalar):
            raise CFError("HTTP upload request source requires a parser scalar token")
        scalar._ensure_reconciled(ledger)
        if scalar._source is not None:
            raise CFError("HTTP upload parser scalar is already adopted")
        self._ledger = ledger
        self._ledger_identity = id(ledger)
        self._request: dict[str, Any] | None = request
        self._records: list[dict[str, Any]] | None = records
        self._scalar: AccountedHTTPUploadParserScalar | None = scalar
        parser_canonical_bytes = scalar._parser_canonical_bytes
        if parser_canonical_bytes is None:
            raise CFError("HTTP upload parser scalar is not reconciled")
        self._parser_canonical_bytes = parser_canonical_bytes
        self._destination: AccountedHTTPUploadSemantic | None = None
        self._closing = False
        self._closed = False
        # Destination-first at the source boundary as well: the exact token
        # is reachable from this source before its public alias is marked.
        scalar._source = self

    def _ensure_ledger(self, ledger: DecisionWorkLedger) -> None:
        if (
            id(ledger) != self._ledger_identity
            or id(self._ledger) != self._ledger_identity
        ):
            raise CFError("HTTP upload request source belongs to a different ledger")

    def _ensure_open(self, ledger: DecisionWorkLedger) -> None:
        self._ensure_ledger(ledger)
        if self._closed or self._request is None or self._records is None:
            raise CFError("HTTP upload request source is closed")

    def _close_from_destination(
        self, destination: "AccountedHTTPUploadSemantic"
    ) -> None:
        if self._destination is not destination:
            raise CFError("HTTP upload request source has a foreign destination")
        self._close(destination)

    def _close(
        self, destination: "AccountedHTTPUploadSemantic" | None
    ) -> None:
        if self._closed:
            return
        if self._destination is not destination:
            if self._destination is not None:
                raise CFError("HTTP upload request source was adopted")
            raise CFError("HTTP upload request source has a foreign destination")
        if self._closing:
            return
        self._closing = True
        completed = False
        try:
            # The complete parser AST and exact objects list die before their
            # scalar. A pre-effect release failure retains only the scalar for
            # the same destination-owned retry.
            self._request = None
            self._records = None
            scalar = self._scalar
            if scalar is not None:
                scalar._close_from_source(self)
                self._scalar = None
            self._parser_canonical_bytes = 0
            self._destination = None
            completed = True
        finally:
            if completed:
                self._closed = True
            self._closing = False

    def close(self, ledger: DecisionWorkLedger) -> None:
        self._ensure_ledger(ledger)
        self._close(None)

    def __del__(self) -> None:
        try:
            if self._destination is None:
                self._close(None)
        except BaseException:
            pass


def bind_http_upload_request_source(
    request: dict[str, Any],
    ledger: DecisionWorkLedger,
    scalar: AccountedHTTPUploadParserScalar,
) -> AccountedHTTPUploadRequestSource:
    """Move one exact acquired parser token into its request source."""
    return AccountedHTTPUploadRequestSource(request, ledger, scalar)


class AccountedHTTPUploadSemantic:
    """Own one unwired upload semantic and immutable object-copy input.

    The caller receives this destination before explicit ``prepare`` performs
    digest/copy work.  The digest and future effect inputs remain private;
    this type deliberately has no digest or payload getter.
    """

    SEMANTIC_RETAINED_BYTES = 8192
    REFERENCE_TUPLE_BASE_BYTES = sys.getsizeof(())
    REFERENCE_SLOT_BYTES = 16
    COPY_LIST_BASE_BYTES = sys.getsizeof([])
    COPY_LIST_SLOT_BYTES = 16
    COPY_BYTES_BASE_BYTES = sys.getsizeof(b"")
    SEMANTIC_TEMPORARY_BASE_BYTES = 4096
    # Full-request fingerprinting and terminal canonical revalidation build
    # encoder stacks/key lists as well as output bytes.  Reuse the digest
    # owner's conservative per-source-byte scratch envelope; these semantic
    # walks are sequential with the separately accounted digest child.
    SEMANTIC_TEMPORARY_BYTES_PER_SOURCE_BYTE = 256
    # Full-request size + fingerprint, object validation + core serialization,
    # then the same four source-sized walks at the terminal fence.
    SEMANTIC_WORK_PASSES = 8

    def __init__(
        self,
        source: AccountedHTTPUploadRequestSource,
        ledger: DecisionWorkLedger,
        stable_project_id: str,
        remote_branch: str,
        deadline: HTTPRequestDeadline | None,
    ) -> None:
        self._ledger = ledger
        self._ledger_identity = id(ledger)
        self._deadline = deadline
        self._source: AccountedHTTPUploadRequestSource | None = None
        self._digest_owner: AccountedRemoteObjectSetDigest | None = None
        self._allocation = _StablePermitTransition(ledger)
        self._record_refs: tuple[dict[str, Any], ...] | None = None
        self._sorted_refs: tuple[dict[str, Any], ...] | None = None
        self._copy_build: list[bytes] | None = None
        self._copy_bytes: tuple[bytes, ...] | None = None
        self._request_digest: str | None = None
        self._semantic: dict[str, Any] | None = None
        self._semantic_view: MappingProxyType | None = None
        self._effect_copy_bytes: tuple[bytes, ...] | None = None
        self._effect_semantic: MappingProxyType | None = None
        self._stable_project_id = stable_project_id
        self._remote_branch = remote_branch
        self._preparing = False
        self._prepared = False
        self._prepare_used = False
        self._terminal_active = False
        self._terminal_started = False
        self._terminal_revalidated = False
        self._terminal_failed = False
        self._terminal_complete = False
        self._closing = False
        self._close_requested = False
        self._closed = False

        if not isinstance(source, AccountedHTTPUploadRequestSource):
            raise CFError("HTTP upload semantic requires a request source")
        source._ensure_open(ledger)
        if source._destination is not None:
            raise CFError("HTTP upload request source is already adopted")
        if type(stable_project_id) is not str or not stable_project_id:
            raise CFError("HTTP upload semantic requires a stable project ID")
        if type(remote_branch) is not str or not remote_branch:
            raise CFError("HTTP upload semantic requires a remote branch")
        request = source._request
        if request is None:
            raise CFError("HTTP upload request source is unavailable")
        local_branch = dict.get(request, "branch")
        head = dict.get(request, "head")
        if type(local_branch) is not str or not local_branch:
            raise CFError("HTTP upload semantic requires a local branch")
        if (
            type(head) is not str
            or not head.startswith("CF-COMMIT-")
        ):
            raise CFError("HTTP upload semantic requires a commit head")
        if any(
            len(value) > 255
            for value in (
                stable_project_id,
                remote_branch,
                local_branch,
                head,
            )
        ):
            raise CFError("HTTP upload semantic identity exceeds 255 characters")
        # Destination-first adoption: the exact source owner is reachable
        # from this caller-owned object before its public alias is marked as
        # transferred. There is no scalar release/reacquire operation.
        self._source = source
        source._destination = self

    def _ensure_ledger(self, ledger: DecisionWorkLedger) -> None:
        if (
            id(ledger) != self._ledger_identity
            or id(self._ledger) != self._ledger_identity
        ):
            raise CFError("HTTP upload semantic belongs to a different ledger")

    def _ensure_bound(self) -> None:
        self._ensure_ledger(self._ledger)
        if self._closed:
            raise CFError("HTTP upload semantic owner is closed")

    @staticmethod
    def _checked_product(value: int, multiplier: int, label: str) -> int:
        if value > U64_MAX // multiplier:
            raise CFError(f"HTTP upload semantic {label} exceeds the u64 domain")
        return value * multiplier

    def _allocation_upper(
        self, source_bytes: int, record_count: int
    ) -> tuple[int, int, int]:
        reference_slots = self._checked_product(
            record_count, self.REFERENCE_SLOT_BYTES * 2, "reference storage"
        )
        copy_slots = self._checked_product(
            record_count,
            self.COPY_LIST_SLOT_BYTES + self.COPY_BYTES_BASE_BYTES,
            "copy storage",
        )
        retained = (
            self.SEMANTIC_RETAINED_BYTES
            + 2 * self.REFERENCE_TUPLE_BASE_BYTES
            + self.COPY_LIST_BASE_BYTES
            + reference_slots
            + copy_slots
            + source_bytes
        )
        temporary = (
            self.SEMANTIC_TEMPORARY_BASE_BYTES
            + self._checked_product(
                source_bytes,
                self.SEMANTIC_TEMPORARY_BYTES_PER_SOURCE_BYTE,
                "canonical scratch",
            )
        )
        work = self._checked_product(
            source_bytes, self.SEMANTIC_WORK_PASSES, "semantic work"
        )
        if retained > U64_MAX or temporary > U64_MAX:
            raise CFError("HTTP upload semantic allocation exceeds the u64 domain")
        return retained, temporary, work

    def _poll(self) -> None:
        if self._deadline is not None:
            self._deadline.check("upload semantic preparation")

    def _validate_source_exact(self, *, polling: bool) -> None:
        source = self._source
        if source is None:
            raise CFError("HTTP upload semantic request source is unavailable")
        source._ensure_open(self._ledger)
        request = source._request
        records = source._records
        if request is None or records is None or dict.get(request, "objects") is not records:
            raise CFError("HTTP upload semantic request source changed")
        limit = source._parser_canonical_bytes
        actual = canonical_json_size_up_to(
            request,
            limit,
            self._poll if polling else None,
        )
        if actual != limit:
            raise CFError("HTTP upload parser scalar does not match its full request")

    def prepare(self, ledger: DecisionWorkLedger) -> None:
        """Prepare private semantic/copy inputs after caller ownership exists."""
        self._ensure_ledger(ledger)
        self._ensure_bound()
        if self._preparing:
            raise CFError("HTTP upload semantic prepare is already active")
        if self._prepare_used:
            raise CFError("HTTP upload semantic prepare is single-use")
        source = self._source
        if source is None:
            raise CFError("HTTP upload semantic request source is unavailable")
        source._ensure_open(ledger)
        records = source._records
        request = source._request
        if records is None or request is None:
            raise CFError("HTTP upload semantic request source is unavailable")
        source_bytes = source._parser_canonical_bytes
        retained, temporary, work = self._allocation_upper(
            source_bytes, len(records)
        )
        self._prepare_used = True
        self._preparing = True
        failure: BaseException | None = None
        digest_owner: AccountedRemoteObjectSetDigest | None = None
        record: dict[str, Any] | None = None
        digest: str | None = None
        local_branch: str | None = None
        head: str | None = None
        try:
            self._allocation.__init__(
                ledger,
                retained_primary=retained,
                temporary=temporary,
            )
            self._allocation.reserve(
                "query",
                charges={"aggregate_bytes": work},
                acquires={
                    "retained_bytes": retained,
                    "temporary_bytes": temporary,
                },
            )
            self._allocation.consume(
                phase="query",
                charges={"aggregate_bytes": work},
                acquires={
                    "retained_bytes": retained,
                    "temporary_bytes": temporary,
                },
            )
            self._allocation.cancel()
            self._validate_source_exact(polling=True)
            request_hasher = hashlib.sha256()
            _hash_canonical_json_polling(
                request_hasher, request, self._poll
            )
            self._request_digest = "sha256:" + request_hasher.hexdigest()
            request_hasher = None
            AccountedRemoteObjectSetDigest(
                records,
                ledger,
                source_bytes,
                self._deadline,
                _handoff_owner=self,
            )
            digest_owner = self._digest_owner
            if digest_owner is None or digest_owner._ordered is None:
                raise CFError("HTTP upload semantic digest owner is unavailable")
            self._record_refs = tuple(records)
            self._sorted_refs = tuple(digest_owner._ordered)
            self._copy_build = []
            for record in self._sorted_refs:
                self._poll()
                validate_object_record(record)
                # Freeze the exact bytes the post-terminal object-copy effect
                # can write. Digest evidence remains the full request record,
                # including historical ``remote`` extensions; publication
                # bytes intentionally use the existing core-plus-newline form.
                self._copy_build.append(_serialize_object_record_core(record))
            self._copy_bytes = tuple(self._copy_build)
            self._copy_build = None
            record = None
            digest = digest_owner._digest
            if digest is None:
                raise CFError("HTTP upload semantic digest is unavailable")
            local_branch = dict.get(request, "branch")
            head = dict.get(request, "head")
            self._semantic = {
                "stable_project_id": self._stable_project_id,
                "remote_branch": self._remote_branch,
                "local_branch": local_branch,
                "head": head,
                "object_set_digest": digest,
            }
            self._semantic_view = MappingProxyType(self._semantic)
            # The destination mapping owns the exact string before the child
            # drops its copy/reference collections and scalar reservation.
            digest_owner._digest = None
            digest_owner.close()
            self._digest_owner = None
            self._prepared = True
        except BaseException as error:
            AccountedRemoteObjectSetDigest._detach_failure_chain(error)
            failure = error
        source = None
        records = None
        request = None
        request_hasher = None
        digest_owner = None
        record = None
        digest = None
        local_branch = None
        head = None
        self._preparing = False
        close_requested = self._close_requested
        cleanup_failure: BaseException | None = None
        if close_requested:
            try:
                self.close(ledger)
            except BaseException as error:
                AccountedRemoteObjectSetDigest._detach_failure_chain(error)
                cleanup_failure = error
        if cleanup_failure is not None:
            if failure is not None:
                raise cleanup_failure from failure
            raise cleanup_failure from None
        if failure is not None:
            # The caller already owns every exact partial child/source field.
            raise failure from None
        if close_requested:
            raise CFError("HTTP upload semantic prepare was cancelled by close")

    def _selected_semantic(self) -> Any:
        if self._effect_semantic is not None:
            return self._effect_semantic
        return self._semantic_view

    def matches_semantic(self, expected: Any) -> bool:
        self._ensure_bound()
        if self._preparing or self._terminal_active:
            raise CFError("HTTP upload semantic owner is active")
        semantic = self._selected_semantic()
        if not self._prepared or semantic is None:
            raise CFError("HTTP upload semantic owner is not prepared")
        return type(expected) is dict and semantic == expected

    def _revalidate_terminal_inputs(self) -> None:
        self._validate_source_exact(polling=False)
        source = self._source
        if source is None or source._records is None:
            raise CFError("HTTP upload semantic request source is unavailable")
        records = source._records
        record_refs = self._record_refs
        sorted_refs = self._sorted_refs
        copy_bytes = self._copy_bytes
        semantic = self._semantic
        expected_request_digest = self._request_digest
        if (
            record_refs is None
            or sorted_refs is None
            or copy_bytes is None
            or semantic is None
            or expected_request_digest is None
            or len(records) != len(record_refs)
            or len(sorted_refs) != len(copy_bytes)
        ):
            raise CFError("HTTP upload semantic terminal inputs are unavailable")
        request = source._request
        if request is None:
            raise CFError("HTTP upload semantic request source is unavailable")
        actual_request_digest = "sha256:" + hashlib.sha256(
            canonical_json(request)
        ).hexdigest()
        if not hmac.compare_digest(
            actual_request_digest, expected_request_digest
        ):
            raise CFError("HTTP upload full request changed before terminal")
        for index, record in enumerate(records):
            if record is not record_refs[index]:
                raise CFError("HTTP upload request record identity changed")
        digest = hashlib.sha256()
        digest.update(b"[")
        prior_object_id: str | None = None
        for index, record in enumerate(sorted_refs):
            object_id = dict.get(record, "object_id") if type(record) is dict else None
            if type(object_id) is not str or not object_id:
                raise CFError("HTTP upload request record identity changed")
            if prior_object_id is not None and object_id <= prior_object_id:
                raise CFError("HTTP upload request record identity changed")
            prior_object_id = object_id
            encoded = canonical_json(record)
            if index:
                digest.update(b",")
            digest.update(encoded)
            encoded = None
            copy_input = _serialize_object_record_core(record)
            if copy_input != copy_bytes[index]:
                copy_input = None
                raise CFError("HTTP upload object-copy input changed before terminal")
            copy_input = None
        digest.update(b"]")
        actual = "sha256:" + digest.hexdigest()
        expected = dict.get(semantic, "object_set_digest")
        if type(expected) is not str or not hmac.compare_digest(actual, expected):
            raise CFError("HTTP upload semantic digest changed before terminal")

    def terminal_detach(self, ledger: DecisionWorkLedger) -> None:
        """Revalidate mutable input, then detach private effect slots."""
        self._ensure_ledger(ledger)
        self._ensure_bound()
        if not self._prepared:
            raise CFError("HTTP upload semantic owner is not prepared")
        if self._terminal_complete:
            raise CFError("HTTP upload semantic terminal detach is single-use")
        if self._terminal_active:
            raise CFError("HTTP upload semantic terminal detach is already active")
        if self._terminal_failed:
            raise CFError("HTTP upload semantic owner is abort-only")
        if self._terminal_started and not self._terminal_revalidated:
            raise CFError("HTTP upload semantic owner is abort-only")
        self._terminal_started = True
        self._terminal_active = True
        failure: BaseException | None = None
        try:
            if not self._terminal_revalidated:
                # This is the last callback-rich fence. Any mutation it
                # triggers is observed by the callback-free revalidation that
                # immediately follows.
                if self._deadline is not None:
                    self._deadline.check("upload semantic terminal")
                self._revalidate_terminal_inputs()
                # All locals in the revalidation frame are gone before the
                # parser source can release its mutable AST scalar.
                self._record_refs = None
                self._sorted_refs = None
                self._terminal_revalidated = True
            source = self._source
            if source is not None:
                source._close_from_destination(self)
                self._source = None
            self._allocation.release_temporary()
        except BaseException as error:
            AccountedRemoteObjectSetDigest._detach_failure_chain(error)
            failure = error
            if not self._terminal_revalidated:
                self._terminal_failed = True
        self._terminal_active = False
        close_requested = self._close_requested
        cleanup_failure: BaseException | None = None
        if close_requested:
            try:
                self.close(ledger)
            except BaseException as error:
                AccountedRemoteObjectSetDigest._detach_failure_chain(error)
                cleanup_failure = error
        if cleanup_failure is not None:
            if failure is not None:
                raise cleanup_failure from failure
            raise cleanup_failure from None
        if failure is not None:
            raise failure from None
        if close_requested:
            raise CFError("HTTP upload semantic terminal was cancelled by close")
        # Callback-free final detach: only prepublished field assignments.
        self._effect_semantic = self._semantic_view
        self._effect_copy_bytes = self._copy_bytes
        self._semantic = None
        self._semantic_view = None
        self._copy_bytes = None
        self._request_digest = None
        self._terminal_complete = True

    def close(self, ledger: DecisionWorkLedger) -> None:
        self._ensure_ledger(ledger)
        if self._closed:
            return
        if self._preparing or self._terminal_active:
            self._close_requested = True
            return
        if self._closing:
            return
        self._closing = True
        completed = False
        try:
            self._effect_semantic = None
            self._effect_copy_bytes = None
            self._semantic = None
            self._semantic_view = None
            self._copy_bytes = None
            self._request_digest = None
            self._copy_build = None
            self._record_refs = None
            self._sorted_refs = None
            digest_owner = self._digest_owner
            if digest_owner is not None:
                digest_owner.close()
                self._digest_owner = None
            source = self._source
            if source is not None:
                source._close_from_destination(self)
                self._source = None
            self._allocation.release_all()
            self._deadline = None
            self._stable_project_id = None
            self._remote_branch = None
            self._close_requested = False
            completed = True
        finally:
            if completed:
                self._closed = True
            self._closing = False

    def __del__(self) -> None:
        try:
            self.close(self._ledger)
        except BaseException:
            pass


def prepare_http_upload_semantic(
    source: AccountedHTTPUploadRequestSource,
    ledger: DecisionWorkLedger,
    stable_project_id: str,
    remote_branch: str,
    deadline: HTTPRequestDeadline | None = None,
) -> AccountedHTTPUploadSemantic:
    """Allocate the private semantic destination before explicit prepare."""
    return AccountedHTTPUploadSemantic(
        source,
        ledger,
        stable_project_id,
        remote_branch,
        deadline,
    )


def merge_request_object_set_digest(records: list[dict[str, Any]]) -> str:
    return "sha256:" + hashlib.sha256(
        canonical_json(canonical_remote_object_records(records))
    ).hexdigest()


def build_merge_request_subject(
    mr_id: str,
    source: dict[str, Any],
    target: dict[str, Any],
    source_head: str,
    target_head: str,
    object_set_digest: str,
) -> dict[str, Any]:
    return {
        "type": "codefire_merge_request_subject",
        "version": VERSION,
        "merge_request_id": mr_id,
        "source_project_id": remote_project_stable_id(source["project_root"]),
        "target_project_id": remote_project_stable_id(target["project_root"]),
        "source_branch": source["branch"],
        "target_branch": target["branch"],
        "source_head": source_head,
        "target_head_at_request": target_head,
        "source_object_set_digest": object_set_digest,
    }


def merge_request_subject_digest(subject: dict[str, Any]) -> str:
    return "sha256:" + hashlib.sha256(canonical_json(subject)).hexdigest()


def validate_merge_request_subject(
    mr: dict[str, Any], source: dict[str, Any], target: dict[str, Any]
) -> str:
    subject = mr.get("subject")
    if "subject" not in mr:
        raise CFError("legacy merge request requires a new subject-bound review before apply")
    if not isinstance(subject, dict):
        raise CFError("merge request subject is malformed")
    source_head = mr.get("source_head")
    if not isinstance(source_head, str):
        raise CFError("merge request subject does not match the current request")
    escrow_records = collect_object_records(remote_dirs(target["project_root"])["objects"], source_head)
    source_project_id = subject.get("source_project_id")
    valid_source_project_id = (
        isinstance(source_project_id, str)
        and source_project_id.startswith("CF-PROJECT-")
        and len(source_project_id.removeprefix("CF-PROJECT-")) == 32
        and all(character in "0123456789abcdefABCDEF" for character in source_project_id.removeprefix("CF-PROJECT-"))
    )
    valid = (
        set(subject) == MERGE_REQUEST_SUBJECT_FIELDS
        and subject.get("type") == "codefire_merge_request_subject"
        and subject.get("version") == VERSION
        and subject.get("merge_request_id") == mr.get("id")
        and valid_source_project_id
        and subject.get("target_project_id") == remote_project_stable_id(target["project_root"])
        and subject.get("source_branch") == source.get("branch")
        and subject.get("target_branch") == target.get("branch")
        and subject.get("source_head") == source_head
        and subject.get("target_head_at_request") == mr.get("target_head_at_request")
        and subject.get("source_object_set_digest") == merge_request_object_set_digest(escrow_records)
    )
    if not valid:
        raise CFError("merge request subject does not match the current request")
    digest = merge_request_subject_digest(subject)
    if mr.get("subject_digest") != digest:
        raise CFError("merge request subject digest diverged")
    return digest


def materialize_merge_request_subject(
    mr: dict[str, Any], source: dict[str, Any], target: dict[str, Any]
) -> str:
    if "subject" in mr:
        return validate_merge_request_subject(mr, source, target)
    reviews = mr.get("reviews")
    if isinstance(reviews, list) and reviews:
        if "legacy_review_history" in mr:
            raise CFError("legacy merge request review history is already materialized")
        mr["legacy_review_history"] = {
            "version": VERSION,
            "reason": "unbound_before_subject_v1",
            "reviews": reviews,
        }
        mr["reviews"] = []
    source_head = mr.get("source_head")
    target_head = mr.get("target_head_at_request")
    if not isinstance(source_head, str) or not isinstance(target_head, str):
        raise CFError("legacy merge request cannot materialize a subject")
    records = collect_object_records(remote_dirs(source["project_root"])["objects"], source_head)
    copy_object_graph(
        remote_dirs(source["project_root"])["objects"],
        remote_dirs(target["project_root"])["objects"],
        source_head,
    )
    subject = build_merge_request_subject(
        str(mr.get("id", "")),
        source,
        target,
        source_head,
        target_head,
        merge_request_object_set_digest(records),
    )
    digest = merge_request_subject_digest(subject)
    mr["subject"] = subject
    mr["subject_digest"] = digest
    return digest


def merge_request_has_effective_approval(mr: dict[str, Any], subject_digest: str) -> bool:
    reviews = mr.get("reviews")
    if not isinstance(reviews, list) or not reviews:
        return False
    for review in reviews:
        if (
            not isinstance(review, dict)
            or set(review) != MERGE_REQUEST_REVIEW_FIELDS
            or not isinstance(review.get("reviewer"), str)
            or not isinstance(review.get("comment"), str)
            or not isinstance(review.get("reviewed_at"), str)
            or not isinstance(review.get("subject_digest"), str)
            or review.get("decision") not in {"approve", "reject"}
        ):
            raise CFError("merge request review has an invalid or future schema")
    effective = reviews[-1]
    expected_status = "approved" if effective["decision"] == "approve" else "rejected"
    if mr.get("status") != expected_status:
        raise CFError("merge request status diverges from its effective review")
    return effective["decision"] == "approve" and effective["subject_digest"] == subject_digest


def validate_merge_request_record(mr: dict[str, Any]) -> None:
    validate_persisted_record_version(mr, "remote_merge_request")
    validate_remote_component(str(mr.get("id", "")), "merge-request ID")
    source = parse_cf_url(mr["source_url"])
    target = parse_cf_url(mr["target_url"])
    source_objects = (
        remote_dirs(target["project_root"])["objects"]
        if "subject" in mr
        else remote_dirs(source["project_root"])["objects"]
    )
    refs = [
        ("source_head", source_objects, mr.get("source_head")),
        ("target_head_at_request", remote_dirs(target["project_root"])["objects"], mr.get("target_head_at_request")),
    ]
    if mr.get("applied_head"):
        refs.append(("applied_head", remote_dirs(target["project_root"])["objects"], mr.get("applied_head")))
    for key, objects_root, commit_id in refs:
        if not isinstance(commit_id, str):
            raise CFError(f"merge request validation failed: {key} must be a commit object id")
        try:
            validate_sealed_commit(objects_root, commit_id)
        except CFError as exc:
            raise CFError(f"merge request validation failed: {key}: {exc}") from exc
    if "subject" in mr:
        validate_merge_request_subject(mr, source, target)


def validate_persisted_record_version(record: Any, contract: str) -> None:
    if not isinstance(record, dict):
        raise CFError(f"{contract} must be an object")
    version = record.get("version")
    if isinstance(version, bool) or version != 1:
        if version is None:
            raise CFError(f"{contract}.version is required")
        raise CFError(f"unsupported {contract}.version {version}; readable version is 1")


def validate_remote_branch_record(branch: Any) -> dict[str, Any]:
    validate_persisted_record_version(branch, "remote_branch")
    validate_remote_component(str(branch.get("name", "")), "branch")
    head = branch.get("head")
    if not isinstance(head, str) or not head.startswith("CF-COMMIT-"):
        raise CFError("remote branch head is not a commit object ID")
    return branch


def read_remote_branch_record(project_root: Path, branch: str) -> dict[str, Any] | None:
    record = read_json(remote_branch_path(project_root, branch))
    if record is None:
        return None
    return validate_remote_branch_record(record)


class RetainedObjectDocument:
    def __init__(
        self,
        object_id: str,
        path: Path | None,
        record: dict[str, Any],
        physical_bytes: int,
        retained_bytes: int,
        digest: str | None,
        subdir: str | None = None,
        file_name: str | None = None,
        identity: tuple[int, int] | None = None,
    ) -> None:
        self.object_id = object_id
        self.path = path
        self.record = record
        self.physical_bytes = physical_bytes
        self.retained_bytes = retained_bytes
        self.digest = digest
        self.subdir = subdir
        self.file_name = file_name
        self.identity = identity
        # Lazily populated before this retained record is exposed through the
        # production borrow surface.  The canonical fingerprint remains live
        # through the final fence so a caller cannot retain a raw payload,
        # close its handle, and mutate the session authority afterwards.
        self.borrow_token = 0
        self.borrow_canonical_bytes = 0
        self.borrow_digest: str | None = None
        self.borrow_fingerprint_bytes = 0


class _SealedValidationFileDescriptor:
    """One descriptor owner whose numeric close capability is single-use."""

    def __init__(self) -> None:
        self._fd = -1
        self._identity: tuple[int, int] | None = None

    def open(self, path: Any, flags: int, *, dir_fd: int | None = None) -> int:
        if self._fd >= 0:
            raise CFError("sealed validation descriptor owner is already occupied")
        if dir_fd is None:
            file_descriptor = os.open(path, flags)
        else:
            file_descriptor = os.open(path, flags, dir_fd=dir_fd)
        self._fd = file_descriptor
        return file_descriptor

    def capture_identity(self) -> os.stat_result:
        metadata = os.fstat(self.fileno())
        self._identity = (metadata.st_dev, metadata.st_ino)
        return metadata

    def fileno(self) -> int:
        if self._fd < 0:
            raise CFError("sealed validation descriptor is unavailable")
        return self._fd

    @property
    def identity(self) -> tuple[int, int] | None:
        return self._identity

    @staticmethod
    def _close_fd(file_descriptor: int) -> None:
        _CODEFIRE_OS_CLOSE(file_descriptor)

    def close(self) -> None:
        if self._fd < 0:
            return
        file_descriptor = self._fd
        # Linux does not provide a safe retry proof for close(2): the same
        # integer can be reopened onto the same inode before an exception is
        # observed. Consume numeric ownership before the one allowed call.
        self._fd = -1
        self._identity = None
        self._close_fd(file_descriptor)

    def __del__(self) -> None:
        try:
            self.close()
        except BaseException:
            pass


class SealedCommitValidationSession:
    """One command-scoped memo and snapshot boundary for sealed validation."""

    def __init__(
        self,
        objects_root: Path,
        ledger: DecisionWorkLedger,
        *,
        memory_owner: Any | None = None,
    ) -> None:
        self.objects_root = Path(os.path.abspath(objects_root))
        self.ledger = ledger
        self._memory_owner = memory_owner
        self.documents: dict[str, RetainedObjectDocument] = {}
        self.validated_commits: set[str] = set()
        self.closed = False
        self.finalized = False
        self._frame_bytes = 0
        self._aux_retained_bytes = 0
        self._pending_document_retained_bytes = 0
        self._pending_temporary_bytes = 0
        self.scanned_object_records = 0
        self._validation_active = False
        self._closing = False
        self._pending_terminal_reason: str | None = None
        self._fd_owners: list[_SealedValidationFileDescriptor] = []
        self._subdir_fds: dict[str, _SealedValidationFileDescriptor] = {}
        self._root_fd_owner = self._new_fd_owner()
        try:
            root_flags = (
                os.O_RDONLY
                | getattr(os, "O_DIRECTORY", 0)
                | getattr(os, "O_NOFOLLOW", 0)
            )
            self._root_fd_owner.open(self.objects_root, root_flags)
        except OSError as exc:
            raise CFError(f"object store is unavailable: {self.objects_root}") from exc
        root_stat = self._root_fd_owner.capture_identity()
        self._root_identity = (root_stat.st_dev, root_stat.st_ino)

    def _new_fd_owner(self) -> _SealedValidationFileDescriptor:
        owner = _SealedValidationFileDescriptor()
        self._fd_owners.append(owner)
        return owner

    def _memory_apply(
        self,
        phase: str,
        *,
        charges: dict[str, int] | None = None,
        maxima: dict[str, int] | None = None,
        acquires: dict[str, int] | None = None,
        counters: dict[str, int] | None = None,
    ) -> None:
        """Apply work atomically while a prepared owner covers Python heap memory."""
        if self._memory_owner is None:
            self.ledger.apply(
                phase,
                charges=charges,
                maxima=maxima,
                acquires=acquires,
                counters=counters,
            )
            return
        acquired = dict(acquires or {})
        for dimension, amount in acquired.items():
            self._memory_owner._claim_memory(dimension, amount)
        try:
            self.ledger.apply(
                phase,
                charges=charges,
                maxima=maxima,
                counters=counters,
            )
        except BaseException:
            for dimension, amount in reversed(tuple(acquired.items())):
                self._memory_owner._release_memory_claim(dimension, amount)
            raise

    def _memory_acquire(self, dimension: str, amount: int, phase: str) -> None:
        if self._memory_owner is None:
            self.ledger.acquire(dimension, amount, phase)
            return
        self._memory_owner._claim_memory(dimension, amount)

    def _memory_release(self, dimension: str, amount: int) -> None:
        if self._memory_owner is None:
            self.ledger.release(dimension, amount)
            return
        self._memory_owner._release_memory_claim(dimension, amount)

    def _memory_current(self, dimension: str) -> int:
        if self._memory_owner is None:
            return self.ledger._current.get(dimension, 0)
        return self._memory_owner._claimed_memory.get(dimension, 0)

    def _release_memory_scalar(
        self,
        dimension: str,
        scalar_name: str,
        amount: int | None = None,
    ) -> None:
        owned = getattr(self, scalar_name)
        release_amount = owned if amount is None else amount
        if not release_amount:
            return
        if release_amount > owned:
            raise CFError("sealed validation memory scalar underflow")
        current_before = self._memory_current(dimension)
        try:
            self._memory_release(dimension, release_amount)
            setattr(self, scalar_name, owned - release_amount)
        except BaseException:
            current_after = self._memory_current(dimension)
            if (
                current_before >= release_amount
                and current_after == current_before - release_amount
            ):
                setattr(self, scalar_name, owned - release_amount)
            raise

    @staticmethod
    def _object_location(object_id: str) -> tuple[str, str]:
        return exact_object_record_location(object_id)

    def _subdir_fd(self, subdir: str) -> int:
        retained = self._subdir_fds.get(subdir)
        if retained is not None:
            return retained.fileno()
        flags = os.O_RDONLY | getattr(os, "O_DIRECTORY", 0) | getattr(os, "O_NOFOLLOW", 0)
        owner = self._new_fd_owner()
        try:
            owner.open(subdir, flags, dir_fd=self._root_fd_owner.fileno())
        except OSError as exc:
            raise CFError(f"object store directory is unavailable: {subdir}") from exc
        owner.capture_identity()
        self._subdir_fds[subdir] = owner
        return owner.fileno()

    def _check_store_identity(self, poll: Any | None = None) -> None:
        def changed(path: Path) -> SealedValidationSubjectChanged:
            return SealedValidationSubjectChanged(
                "<object-store>", path, "store_identity_changed", 0, None
            )

        try:
            root = os.fstat(self._root_fd_owner.fileno())
        except OSError as exc:
            raise changed(self.objects_root) from exc
        if (root.st_dev, root.st_ino) != self._root_identity:
            raise changed(self.objects_root)
        for subdir, owner in self._subdir_fds.items():
            if poll is not None:
                poll()
            try:
                actual = os.fstat(owner.fileno())
            except OSError as exc:
                raise changed(self.objects_root / subdir) from exc
            if (actual.st_dev, actual.st_ino) != owner.identity:
                raise changed(self.objects_root / subdir)
        ambient_root_owner = self._new_fd_owner()
        try:
            root_flags = (
                os.O_RDONLY
                | getattr(os, "O_DIRECTORY", 0)
                | getattr(os, "O_NOFOLLOW", 0)
            )
            ambient_root_owner.open(self.objects_root, root_flags)
        except OSError as exc:
            raise changed(self.objects_root) from exc
        try:
            try:
                ambient_root = ambient_root_owner.capture_identity()
            except OSError as exc:
                raise changed(self.objects_root) from exc
            if (ambient_root.st_dev, ambient_root.st_ino) != self._root_identity:
                raise changed(self.objects_root)
            flags = (
                os.O_RDONLY
                | getattr(os, "O_DIRECTORY", 0)
                | getattr(os, "O_NOFOLLOW", 0)
            )
            for subdir, retained_owner in self._subdir_fds.items():
                if poll is not None:
                    poll()
                ambient_subdir_owner = self._new_fd_owner()
                try:
                    ambient_subdir_owner.open(
                        subdir,
                        flags,
                        dir_fd=ambient_root_owner.fileno(),
                    )
                    ambient_subdir = ambient_subdir_owner.capture_identity()
                    if (
                        ambient_subdir.st_dev,
                        ambient_subdir.st_ino,
                    ) != retained_owner.identity:
                        raise changed(self.objects_root / subdir)
                except SealedValidationSubjectChanged:
                    raise
                except OSError as exc:
                    raise changed(self.objects_root / subdir) from exc
                finally:
                    ambient_subdir_owner.close()
        finally:
            ambient_root_owner.close()

    def _read_exact_bounded(
        self,
        object_id: str,
        subdir: str,
        file_name: str,
        charge: Any,
        *,
        revalidation: bool,
        expected_document: RetainedObjectDocument | None = None,
        poll: Any | None = None,
    ) -> tuple[bytes, int, tuple[int, int]]:
        if poll is not None:
            poll()
        directory_fd = self._subdir_fd(subdir)
        flags = os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0)
        display_path = self.objects_root / subdir / file_name
        try:
            initial = os.stat(
                file_name,
                dir_fd=directory_fd,
                follow_symlinks=False,
            )
        except OSError as exc:
            if revalidation and expected_document is not None:
                raise SealedValidationSubjectChanged(
                    object_id,
                    display_path,
                    "unreadable",
                    expected_document.physical_bytes,
                    None,
                ) from exc
            raise CFError(f"object not found: {object_id}") from exc
        file_owner = self._new_fd_owner()
        try:
            file_owner.open(file_name, flags, dir_fd=directory_fd)
        except OSError as exc:
            if revalidation and expected_document is not None:
                raise SealedValidationSubjectChanged(
                    object_id,
                    display_path,
                    "unreadable",
                    expected_document.physical_bytes,
                    None,
                ) from exc
            raise CFError(f"object not found: {object_id}") from exc
        try:
            before = file_owner.capture_identity()
            initial_identity = (initial.st_dev, initial.st_ino)
            opened_identity = (before.st_dev, before.st_ino)
            if (
                not stat.S_ISREG(initial.st_mode)
                or not stat.S_ISREG(before.st_mode)
                or initial.st_nlink != 1
                or before.st_nlink != 1
                or initial_identity != opened_identity
                or initial.st_size != before.st_size
            ):
                if revalidation and expected_document is not None:
                    raise SealedValidationSubjectChanged(
                        object_id,
                        display_path,
                        "identity_changed",
                        expected_document.physical_bytes,
                        before.st_size,
                    )
                raise CFError(f"object record identity is invalid: {display_path}")
            size = before.st_size
            if size > MAX_OBJECT_RECORD_BYTES:
                if revalidation and expected_document is not None:
                    raise SealedValidationSubjectChanged(
                        object_id,
                        display_path,
                        "size_changed",
                        expected_document.physical_bytes,
                        size,
                    )
                raise CFError(
                    "object record exceeds the "
                    f"{MAX_OBJECT_RECORD_BYTES}-byte limit at {display_path}: {size} bytes"
                )
            charge(size)
            buffer = bytearray()
            while len(buffer) < size:
                if poll is not None:
                    poll()
                chunk = os.read(
                    file_owner.fileno(), min(64 * 1024, size - len(buffer))
                )
                if not chunk:
                    break
                buffer.extend(chunk)
            if poll is not None:
                poll()
            extension = os.read(file_owner.fileno(), 1)
            after = os.fstat(file_owner.fileno())
            identity_before = (before.st_dev, before.st_ino)
            identity_after = (after.st_dev, after.st_ino)
            try:
                named = os.stat(
                    file_name,
                    dir_fd=directory_fd,
                    follow_symlinks=False,
                )
            except OSError as exc:
                if revalidation and expected_document is not None:
                    raise SealedValidationSubjectChanged(
                        object_id,
                        display_path,
                        "unreadable",
                        expected_document.physical_bytes,
                        None,
                    ) from exc
                raise SealedValidationSubjectChanged(
                    object_id, display_path, "unreadable", size, None
                ) from exc
            named_identity = (named.st_dev, named.st_ino)
            if (
                len(buffer) != size
                or extension
                or identity_before != identity_after
                or after.st_size != size
                or after.st_nlink != 1
                or not stat.S_ISREG(named.st_mode)
                or named.st_nlink != 1
                or named_identity != identity_before
                or named.st_size != size
            ):
                actual_size = named.st_size
                if revalidation and expected_document is not None:
                    raise SealedValidationSubjectChanged(
                        object_id,
                        display_path,
                        "size_changed",
                        expected_document.physical_bytes,
                        actual_size,
                    )
                raise SealedValidationSubjectChanged(
                    object_id, display_path, "size_changed", size, actual_size
                )
            return bytes(buffer), size, identity_before
        finally:
            file_owner.close()

    def _ensure_open(self) -> None:
        if self.closed:
            raise CFError("sealed validation session is closed")

    def __del__(self) -> None:
        try:
            self.close(None)
        except Exception:
            pass

    def adopt_aux_retained(self, amount: int) -> None:
        self._ensure_open()
        self._aux_retained_bytes += amount

    @staticmethod
    def _frame_size(object_id: str) -> int:
        return 256 + len(object_id.encode("utf-8"))

    def _charge_frame(
        self, object_id: str, depth: int, frontier: int, *, edge: bool
    ) -> None:
        frame_bytes = self._frame_size(object_id)
        charges = {"graph_edges": 1} if edge else None
        counters = {"frontier_insertion_attempts": 1}
        if edge:
            counters["edge_occurrences"] = 1
        self._memory_apply(
            "graph_discovery",
            charges=charges,
            maxima={"logical_depth": depth, "maximum_frontier": frontier},
            acquires={"retained_bytes": frame_bytes},
            counters=counters,
        )
        self._frame_bytes += frame_bytes

    def _release_frame(self, object_id: str) -> None:
        frame_bytes = self._frame_size(object_id)
        self._release_memory_scalar(
            "retained_bytes", "_frame_bytes", frame_bytes
        )

    def _charge_root_edge(self) -> None:
        self.ledger.apply(
            "graph_discovery",
            charges={"graph_edges": 1},
            counters={"edge_occurrences": 1},
        )

    def _preflight_object_memory(self, object_id: str) -> None:
        if self._memory_owner is not None:
            self._memory_owner._preflight_source(self, object_id)

    def _load_payload_unprotected(
        self, object_id: str, poll: Any | None = None
    ) -> Any:
        if poll is not None:
            poll()
        self._ensure_open()
        retained = self.documents.get(object_id)
        if retained is not None:
            self.ledger.count("memo_hits", 1, "record_read")
            return retained.record["payload"]

        subdir, file_name = self._object_location(object_id)
        path = self.objects_root / subdir / file_name
        if load_object_from_root is not _DEFAULT_LOAD_OBJECT_FROM_ROOT and not path.exists():
            # Preserve the injectable loader used by the iterative cycle test
            # and treat such values as in-memory overlay documents.
            try:
                if poll is not None:
                    poll()
                payload = load_object_from_root(self.objects_root, object_id)
            except CFError:
                raise
            record = {"payload": payload}
            retained_bytes = canonical_json_size_up_to(record, U64_MAX, poll)
            if self._memory_owner is not None:
                self._memory_owner._observe_record(retained_bytes)
            self._memory_apply(
                "record_read",
                acquires={"retained_bytes": retained_bytes},
                counters={"memo_misses": 1, "unique_nodes_discovered": 1},
            )
            self._pending_document_retained_bytes += retained_bytes
            self.documents[object_id] = RetainedObjectDocument(
                object_id, None, record, 0, retained_bytes, None
            )
            return payload

        scratch_bytes = 0
        def charge_read(expected_size: int) -> None:
            nonlocal scratch_bytes
            if self._memory_owner is not None:
                self._memory_owner._observe_loaded_record(
                    object_id, expected_size
                )
            requested_scratch = expected_size * 2
            self._memory_apply(
                "record_read",
                charges={"aggregate_bytes": expected_size, "object_records": 1},
                acquires={"temporary_bytes": requested_scratch},
                counters={
                    "files_read": 1,
                    "file_bytes_read": expected_size,
                    "bytes_hashed": expected_size,
                    "record_reads": 1,
                    "memo_misses": 1,
                    "unique_nodes_discovered": 1,
                    "object_records": 1,
                },
            )
            scratch_bytes = requested_scratch
            self._pending_temporary_bytes += requested_scratch
        retained_bytes = 0
        retained_acquired = 0
        raw: bytes | None = None
        try:
            raw, expected_size, identity = self._read_exact_bounded(
                object_id,
                subdir,
                file_name,
                charge_read,
                revalidation=False,
                poll=poll,
            )
            if poll is not None:
                poll()
            digest = _sha256_hexdigest_polling(raw, poll)
            if poll is not None:
                poll()
            try:
                record = json.loads(raw)
            except (UnicodeDecodeError, json.JSONDecodeError) as exc:
                raise CFError(f"invalid object JSON: {path}: {exc}") from exc
            if poll is not None:
                poll()
            validate_object_record(
                record, expected_oid=object_id, path=path, poll=poll
            )
            self.ledger.count("semantic_validations", 1, "semantic_validation")
            retained_bytes = canonical_json_size_up_to(record, U64_MAX, poll)
            self._memory_acquire("retained_bytes", retained_bytes, "record_read")
            self._pending_document_retained_bytes += retained_bytes
            retained_acquired = retained_bytes
            retained = RetainedObjectDocument(
                object_id,
                path,
                record,
                expected_size,
                retained_bytes,
                digest,
                subdir,
                file_name,
                identity,
            )
            self.documents[object_id] = retained
            raw = None
            return record["payload"]
        except BaseException:
            if retained_acquired:
                self._release_memory_scalar(
                    "retained_bytes",
                    "_pending_document_retained_bytes",
                    retained_acquired,
                )
            raise
        finally:
            raw = None
            if scratch_bytes:
                self._release_memory_scalar(
                    "temporary_bytes", "_pending_temporary_bytes", scratch_bytes
                )

    def load_payload(self, object_id: str, poll: Any | None = None) -> Any:
        try:
            self._preflight_object_memory(object_id)
            return self._load_payload_unprotected(object_id, poll)
        except SealedValidationSubjectChanged:
            if not self._validation_active:
                self.close("subject_changed")
            raise
        except ResourceBudgetExceeded:
            if not self._validation_active:
                self.close(None)
            raise

    def _accounted_sorted_directory_names(
        self, directory_fd: int
    ) -> tuple[list[str], int]:
        names: list[str] = []
        names_bytes = 0
        try:
            with os.scandir(directory_fd) as entries:
                for entry in entries:
                    name_bytes = len(entry.name.encode("utf-8")) + 64
                    self.ledger.acquire(
                        "temporary_bytes", name_bytes, "graph_discovery"
                    )
                    names_bytes += name_bytes
                    names.append(entry.name)
            sort_scratch = names_bytes + 8 * len(names)
            self.ledger.acquire("temporary_bytes", sort_scratch, "query")
            try:
                names.sort()
            finally:
                self.ledger.release("temporary_bytes", sort_scratch)
            return names, names_bytes
        except Exception:
            names.clear()
            if names_bytes:
                self.ledger.release("temporary_bytes", names_bytes)
            raise

    def scan_object_hash_errors(self) -> list[Path]:
        """Validate every exact object record once through this session memo."""
        self._ensure_open()
        bad: list[Path] = []
        for type_tag in OBJECT_PREFIXES:
            subdir = object_subdir(type_tag)
            try:
                directory_fd = self._subdir_fd(subdir)
            except CFError:
                continue
            names, names_bytes = self._accounted_sorted_directory_names(
                directory_fd
            )
            try:
                for name in names:
                    self.ledger.apply(
                        "graph_discovery",
                        maxima={"maximum_frontier": 1},
                        counters={"frontier_insertion_attempts": 1},
                    )
                    path = self.objects_root / subdir / name
                    if not name.endswith(".json"):
                        path_bytes = len(str(path).encode("utf-8")) + 32
                        self.ledger.acquire(
                            "retained_bytes", path_bytes, "graph_discovery"
                        )
                        self.adopt_aux_retained(path_bytes)
                        bad.append(path)
                        continue
                    self.scanned_object_records += 1
                    object_id = name[:-5]
                    try:
                        expected_subdir, expected_name = exact_object_record_location(
                            object_id
                        )
                        if expected_subdir != subdir or expected_name != name:
                            raise CFError("object filename/type mismatch")
                        self.load_payload(object_id)
                    except (ResourceBudgetExceeded, SealedValidationSubjectChanged):
                        raise
                    except (CFError, OSError):
                        path_bytes = len(str(path).encode("utf-8")) + 32
                        self.ledger.acquire(
                            "retained_bytes", path_bytes, "graph_discovery"
                        )
                        self.adopt_aux_retained(path_bytes)
                        bad.append(path)
            finally:
                names.clear()
                if names_bytes:
                    self.ledger.release("temporary_bytes", names_bytes)
        scratch = sum(len(str(path).encode("utf-8")) + 32 for path in bad)
        self.ledger.acquire("temporary_bytes", scratch, "query")
        try:
            return sorted(bad)
        finally:
            self.ledger.release("temporary_bytes", scratch)

    def missing_references(self, roots: list[str]) -> list[str]:
        """Traverse references through the same document memo used by validation."""
        self._ensure_open()
        missing: set[str] = set()
        seen: set[str] = set()
        missing_output_bytes = 0
        stack: list[str] = []
        stack_bytes = 0
        try:
            for root in reversed(roots):
                frame_bytes = self._frame_size(root)
                self.ledger.apply(
                    "graph_discovery",
                    maxima={"maximum_frontier": len(stack) + 1},
                    acquires={"retained_bytes": frame_bytes},
                    counters={"frontier_insertion_attempts": 1},
                )
                stack_bytes += frame_bytes
                stack.append(root)
            while stack:
                object_id = stack.pop()
                frame_bytes = self._frame_size(object_id)
                stack_bytes -= frame_bytes
                self.ledger.release("retained_bytes", frame_bytes)
                if object_id in seen:
                    self.ledger.count("revisits", 1, "graph_discovery")
                    continue
                seen.add(object_id)
                try:
                    self.load_payload(object_id)
                    record = self.documents[object_id].record
                except (ResourceBudgetExceeded, SealedValidationSubjectChanged):
                    raise
                except CFError:
                    if object_record_path(self.objects_root, object_id) is not None:
                        continue
                    missing_bytes = len(object_id.encode("utf-8")) + 32
                    self.ledger.acquire(
                        "retained_bytes", missing_bytes, "graph_discovery"
                    )
                    self.adopt_aux_retained(missing_bytes)
                    missing_output_bytes += missing_bytes
                    missing.add(object_id)
                    continue
                references = object_record_references(record)
                for reference in reversed(references):
                    frame_bytes = self._frame_size(reference)
                    self.ledger.apply(
                        "graph_discovery",
                        charges={"graph_edges": 1},
                        maxima={"maximum_frontier": len(stack) + 1},
                        acquires={"retained_bytes": frame_bytes},
                        counters={
                            "edge_occurrences": 1,
                            "frontier_insertion_attempts": 1,
                        },
                    )
                    stack_bytes += frame_bytes
                    stack.append(reference)
            sort_scratch = missing_output_bytes + 8 * len(missing)
            self.ledger.acquire("temporary_bytes", sort_scratch, "query")
            try:
                return sorted(missing)
            finally:
                self.ledger.release("temporary_bytes", sort_scratch)
        except SealedValidationSubjectChanged:
            self.close("subject_changed")
            raise
        except ResourceBudgetExceeded:
            self.close(None)
            raise
        finally:
            if stack_bytes:
                self.ledger.release("retained_bytes", stack_bytes)

    def validate_commit(self, commit_id: str, poll: Any | None = None) -> None:
        self._ensure_open()
        active: set[str] = set()
        stack: list[tuple[Any, ...]] = []
        terminal_failure: str | None = None
        self._validation_active = True
        try:
            if poll is not None:
                poll()
            self._preflight_object_memory(commit_id)
            self._charge_frame(commit_id, 0, 1, edge=False)
            stack.append(("enter", commit_id, 0))
            while stack:
                if poll is not None:
                    poll()
                frame = stack.pop()
                action = frame[0]
                if action == "enter":
                    current, depth = frame[1], frame[2]
                    if current in self.validated_commits:
                        self._memory_apply(
                            "semantic_validation",
                            counters={"memo_hits": 1, "revisits": 1},
                        )
                        self._release_frame(current)
                        continue
                    if current in active:
                        raise CFError(
                            "sealed commit validation failed: "
                            f"parent cycle detected at {current}"
                        )
                    active.add(current)
                    commit = self.load_payload(current, poll)
                    if not isinstance(commit, dict) or commit.get("type") != "commit":
                        raise CFError(f"not a commit object: {current}")
                    parents = commit.get("parents")
                    if not isinstance(parents, list):
                        raise CFError(
                            "sealed commit validation failed: parents must be a list"
                        )
                    stack.append(("parent", current, commit, parents, 0, depth))
                    continue

                if action == "parent":
                    current, commit, parents, index, depth = frame[1:]
                    if index >= len(parents):
                        stack.append(("finish", current, commit))
                        continue
                    parent = parents[index]
                    if not isinstance(parent, str) or not parent.startswith("CF-COMMIT-"):
                        raise CFError(
                            "sealed commit validation failed: "
                            f"parent {index} must be a commit object id"
                        )
                    stack.append(
                        ("parent", current, commit, parents, index + 1, depth)
                    )
                    child_depth = depth + 1
                    self._preflight_object_memory(parent)
                    self._charge_frame(
                        parent, child_depth, len(stack) + 1, edge=True
                    )
                    stack.append(("enter", parent, child_depth))
                    continue

                current, commit = frame[1], frame[2]
                self.ledger.apply(
                    "semantic_validation",
                    charges={"graph_nodes": 1},
                    counters={"semantic_validations": 1},
                )
                if poll is not None:
                    poll()
                _validate_sealed_commit_payload(
                    commit,
                    lambda object_id: self.load_payload(object_id, poll),
                    self._charge_root_edge,
                    poll,
                    self._preflight_object_memory,
                )
                active.remove(current)
                self.validated_commits.add(current)
                self._release_frame(current)
        except SealedValidationSubjectChanged:
            terminal_failure = "subject_changed"
            raise
        except ResourceBudgetExceeded:
            terminal_failure = "budget_exceeded"
            raise
        finally:
            stack.clear()
            active.clear()
            remaining_frame_bytes = self._frame_bytes
            if remaining_frame_bytes:
                self._release_memory_scalar(
                    "retained_bytes", "_frame_bytes", remaining_frame_bytes
                )
            self._validation_active = False
            if terminal_failure == "subject_changed":
                self.close("subject_changed")
            elif terminal_failure == "budget_exceeded":
                self.close(None)

    def finalize(
        self,
        *,
        terminate: bool = True,
        poll: Any | None = None,
        retain_documents: bool = False,
    ) -> None:
        self._ensure_open()
        if retain_documents and terminate:
            raise CFError(
                "sealed validation cannot retain documents while terminating"
            )
        try:
            if poll is not None:
                poll()
            self._check_store_identity(poll)
            ordered_object_ids = list(self.documents)
            _sort_strings_polling(ordered_object_ids, poll)
            for object_id in ordered_object_ids:
                if poll is not None:
                    poll()
                retained = self.documents[object_id]
                if retained.path is None:
                    continue
                scratch_bytes = 0
                def charge_revalidation(actual_size: int) -> None:
                    nonlocal scratch_bytes
                    self._memory_apply(
                        "snapshot_revalidation",
                        charges={
                            "snapshot_revalidation_records": 1,
                            "snapshot_revalidation_bytes": actual_size,
                        },
                        acquires={"temporary_bytes": actual_size * 2},
                        counters={
                            "snapshot_revalidation_records": 1,
                            "snapshot_revalidation_bytes": actual_size,
                            "files_read": 1,
                            "file_bytes_read": actual_size,
                            "bytes_hashed": actual_size,
                        },
                    )
                    scratch_bytes = actual_size * 2
                    self._pending_temporary_bytes += scratch_bytes
                raw: bytes | None = None
                actual_length = 0
                try:
                    raw, actual_size, actual_identity = self._read_exact_bounded(
                        object_id,
                        retained.subdir,
                        retained.file_name,
                        charge_revalidation,
                        revalidation=True,
                        expected_document=retained,
                        poll=poll,
                    )
                    actual_length = len(raw)
                    if poll is not None:
                        poll()
                    digest = _sha256_hexdigest_polling(raw, poll)
                    if poll is not None:
                        poll()
                finally:
                    raw = None
                    if scratch_bytes:
                        self._release_memory_scalar(
                            "temporary_bytes",
                            "_pending_temporary_bytes",
                            scratch_bytes,
                        )
                if actual_length != retained.physical_bytes:
                    raise SealedValidationSubjectChanged(
                        object_id,
                        retained.path,
                        "size_changed",
                        retained.physical_bytes,
                        actual_length,
                    )
                if actual_identity != retained.identity:
                    raise SealedValidationSubjectChanged(
                        object_id,
                        retained.path,
                        "identity_changed",
                        retained.physical_bytes,
                        actual_length,
                    )
                if digest != retained.digest:
                    raise SealedValidationSubjectChanged(
                        object_id,
                        retained.path,
                        "digest_changed",
                        retained.physical_bytes,
                        actual_length,
                    )
            if poll is not None:
                poll()
            self._check_store_identity(poll)
            self.finalized = True
            if not retain_documents:
                self.close("complete" if terminate else None)
        except SealedValidationSubjectChanged:
            self.close("subject_changed")
            raise
        except BaseException:
            self.close(None)
            raise

    def close(self, terminal_reason: str | None = None) -> None:
        if self.closed or self._closing:
            return
        if terminal_reason is not None and self._pending_terminal_reason is None:
            self._pending_terminal_reason = terminal_reason
        self._closing = True
        completed = False
        try:
            self.documents.clear()
            self.validated_commits.clear()
            self._release_memory_scalar("retained_bytes", "_frame_bytes")
            self._release_memory_scalar(
                "retained_bytes", "_pending_document_retained_bytes"
            )
            self._release_memory_scalar("retained_bytes", "_aux_retained_bytes")
            self._release_memory_scalar(
                "temporary_bytes", "_pending_temporary_bytes"
            )
            for owner in reversed(self._fd_owners):
                owner.close()
            self._subdir_fds.clear()
            self._fd_owners.clear()
            if (
                self._pending_terminal_reason is not None
                and self.ledger.terminal_reason is None
            ):
                self.ledger.terminate(self._pending_terminal_reason)
            self._pending_terminal_reason = None
            completed = True
        finally:
            if completed:
                self.closed = True
            self._closing = False


class _HTTPUploadSealedCommitBorrow:
    """Revocable callable view over already-validated retained commits.

    The handle is allocated inside the sealed owner's pre-acquired fixed
    overhead.  It never loads a document or widens the validated authority;
    callers may only borrow commit payloads already retained by the session.
    """

    def __init__(self, owner: Any, mode: str) -> None:
        self._owner: Any | None = owner
        self._token = 0
        self._mode = mode
        self._used = False

    def _activate(self, token: int) -> None:
        if self._used:
            raise CFError("HTTP upload sealed commit borrow is single-use")
        self._used = True
        self._token = token

    def _revoke(self, owner: Any) -> None:
        if self._owner is owner:
            self._token = 0

    def _detach(self, owner: Any) -> None:
        self._revoke(owner)
        if self._owner is owner:
            self._owner = None

    def __call__(self, object_id: str) -> Any:
        owner = self._owner
        if owner is None or not self._token:
            raise CFError("HTTP upload sealed commit borrow is revoked")
        failure: BaseException | None = None
        result: Any = None
        try:
            result = owner._borrow_commit(
                self, self._token, self._mode, object_id
            )
        except BaseException as exc:
            failure = owner._detach_failure(exc)
        owner = None
        if failure is not None:
            raise failure.with_traceback(None)
        return result

    def close(self, ledger: DecisionWorkLedger | None = None) -> None:
        owner = self._owner
        if owner is None:
            return
        owner._release_commit_borrow(self, self._token, ledger)


class AccountedHTTPUploadSealedValidation:
    """Single-use owner for the post-staging sealed-validation prerequisite.

    The caller supplies immutable upper bounds already known by the staging
    planner.  One reservation is acquired before the validation session (and
    therefore its dict/set/list/path allocators) is constructed.  The owner
    borrows the staged object capability and the session's parsed documents;
    it never clones either payload collection.
    """

    RETAINED_BASE_BYTES = 64 * 1024
    TEMPORARY_BASE_BYTES = 64 * 1024
    RETAINED_BYTES_MULTIPLIER = 128
    TEMPORARY_BYTES_MULTIPLIER = 128
    RETAINED_RECORD_BYTES = 4096
    TEMPORARY_RECORD_BYTES = 128
    BORROW_CONTROL_BYTES = 4096
    # Covers the retained baseline digest and the transient size/digest return
    # used to compare it after Temporary encoder storage is released.
    BORROW_FINGERPRINT_BYTES = 1024

    def __init__(self, *args: Any, **kwargs: Any) -> None:
        raise TypeError("use prepare_http_upload_sealed_validation")

    @staticmethod
    def _checked_bound(value: int, label: str) -> int:
        if isinstance(value, bool) or not isinstance(value, int) or value < 0:
            raise CFError(f"HTTP upload sealed-validation {label} must be non-negative")
        if value > U64_MAX:
            raise CFError(f"HTTP upload sealed-validation {label} must fit u64")
        return value

    @classmethod
    def allocation_upper(
        cls,
        record_count_upper: int,
        aggregate_bytes_upper: int,
        maximum_record_bytes_upper: int,
    ) -> tuple[int, int]:
        record_count = cls._checked_bound(record_count_upper, "record count upper")
        aggregate_bytes = cls._checked_bound(
            aggregate_bytes_upper, "aggregate byte upper"
        )
        maximum_record_bytes = cls._checked_bound(
            maximum_record_bytes_upper, "maximum record byte upper"
        )
        if maximum_record_bytes > aggregate_bytes:
            raise CFError(
                "HTTP upload sealed-validation maximum record upper exceeds aggregate upper"
            )
        if record_count == 0 and (aggregate_bytes or maximum_record_bytes):
            raise CFError(
                "HTTP upload sealed-validation empty record bound has nonzero bytes"
            )
        retained = (
            cls.RETAINED_BASE_BYTES
            + cls.BORROW_CONTROL_BYTES
            + (cls.RETAINED_RECORD_BYTES + cls.BORROW_FINGERPRINT_BYTES)
            * record_count
            + cls.RETAINED_BYTES_MULTIPLIER * aggregate_bytes
        )
        temporary = (
            cls.TEMPORARY_BASE_BYTES
            + cls.TEMPORARY_RECORD_BYTES * record_count
            + cls.TEMPORARY_BYTES_MULTIPLIER * maximum_record_bytes
        )
        if retained > U64_MAX or temporary > U64_MAX:
            raise CFError("HTTP upload sealed-validation allocation upper overflows u64")
        return retained, temporary

    @classmethod
    def _from_acquired(
        cls,
        ledger: DecisionWorkLedger,
        objects_root: Path,
        head: str,
        record_count_upper: int,
        aggregate_bytes_upper: int,
        maximum_record_bytes_upper: int,
        retained_upper: int,
        temporary_upper: int,
        scalar_owner: Any,
        deadline: HTTPRequestDeadline | None,
    ) -> tuple[
        "AccountedHTTPUploadSealedValidation | None", BaseException | None
    ]:
        owner = object.__new__(cls)
        owner._ledger = ledger
        owner._objects_root = objects_root
        owner._head = head
        owner._deadline = deadline
        owner._record_count_upper = record_count_upper
        owner._aggregate_bytes_upper = aggregate_bytes_upper
        owner._maximum_record_bytes_upper = maximum_record_bytes_upper
        owner._observed_records = 0
        owner._observed_aggregate_bytes = 0
        owner._source_sizes = {}
        owner._claimed_memory = {"retained_bytes": 0, "temporary_bytes": 0}
        owner._coverage_retained_upper = retained_upper
        owner._coverage_temporary_upper = temporary_upper
        # The same fixed owner that held the permit before consume remains the
        # sole scalar owner for the lifetime of this payload owner.  There is
        # no post-consume numeric hand-off window.
        owner._scalar_owner = scalar_owner
        owner._validated = False
        owner._borrow_generation = 0
        owner._active_borrow_token = 0
        owner._borrow_failed = False
        owner._borrow_releasing = False
        owner._borrow_reading = False
        owner._upload_terminal_active = False
        owner._upload_terminal_owner = None
        owner._closed = False
        owner._closing = False
        owner._finishing = False
        owner._session = None
        # Publish the collection before either handle allocator so a partial
        # constructor always remains closeable by the scalar retry owner.
        owner._borrow_handles: dict[str, _HTTPUploadSealedCommitBorrow] = {}
        failure: BaseException | None = None
        try:
            owner._borrow_handles["signature"] = _HTTPUploadSealedCommitBorrow(
                owner, "signature"
            )
            owner._borrow_handles["ancestry"] = _HTTPUploadSealedCommitBorrow(
                owner, "ancestry"
            )
            owner._poll()
            session_type = SealedCommitValidationSession
            owner._session = session_type.__new__(session_type)
            session_type.__init__(
                owner._session, objects_root, ledger, memory_owner=owner
            )
        except BaseException as exc:
            failure = cls._detach_failure(exc)
        if failure is not None:
            # The partial session is reachable only from the detached
            # construction traceback. The separate scalar retry owner retains
            # the acquired upper until construction succeeds.
            owner._source_sizes.clear()
            owner._objects_root = None
            owner._head = None
            owner._deadline = None
            return owner, failure
        return owner, None

    def _ensure_ledger(self, ledger: DecisionWorkLedger) -> None:
        if ledger is not self._ledger:
            raise CFError("HTTP upload sealed validation belongs to a different ledger")

    def _ensure_open(self, ledger: DecisionWorkLedger) -> None:
        self._ensure_ledger(ledger)
        if self._closed:
            raise CFError("HTTP upload sealed validation owner is closed")

    def _ensure_upload_terminal_access(self, owner: Any | None) -> None:
        ledger_bound = self._ledger._upload_terminal_owner
        bound = self._upload_terminal_owner
        if (
            ledger_bound is not None
            and ledger_bound is not owner
            and getattr(ledger_bound, "_sealed_owner", None) is self
        ):
            raise CFError("upload terminal composite owns sealed authority")
        if bound is not None and bound is not owner:
            raise CFError("upload terminal composite owns sealed authority")

    def _poll(self) -> None:
        if self._deadline is not None:
            self._deadline.check("upload sealed validation")

    def _observe_record(self, physical_bytes: int) -> None:
        if physical_bytes < 0:
            raise CFError("HTTP upload sealed validation observed a negative record size")
        # Filesystem-backed records were charged before their first DFS frame
        # or root-key list. In-memory test overlays have no source stat and are
        # bounded here before their borrowed payload is retained.
        next_records = self._observed_records + 1
        next_bytes = self._observed_aggregate_bytes + physical_bytes
        if next_records > self._record_count_upper:
            raise CFError("HTTP upload sealed validation exceeded its record-count upper")
        if physical_bytes > self._maximum_record_bytes_upper:
            raise CFError("HTTP upload sealed validation exceeded its record-size upper")
        if next_bytes > self._aggregate_bytes_upper:
            raise CFError("HTTP upload sealed validation exceeded its aggregate-byte upper")
        self._observed_records = next_records
        self._observed_aggregate_bytes = next_bytes

    def _preflight_source(
        self, session: SealedCommitValidationSession, object_id: str
    ) -> None:
        if object_id in self._source_sizes or object_id in session.documents:
            return
        try:
            subdir, file_name = session._object_location(object_id)
            directory_fd = session._subdir_fd(subdir)
            metadata = os.stat(file_name, dir_fd=directory_fd, follow_symlinks=False)
        except (CFError, OSError):
            # Semantic lookup owns invalid/missing precedence. Bounds preflight
            # must not convert those cases into a different diagnostic.
            return
        if (
            not stat.S_ISREG(metadata.st_mode)
            or metadata.st_nlink != 1
            or metadata.st_size < 0
            or metadata.st_size > MAX_OBJECT_RECORD_BYTES
        ):
            # Preserve the legacy identity/oversize diagnostic. Only a source
            # that the real reader could admit may consume a caller upper.
            return
        physical_bytes = metadata.st_size
        self._observe_record(physical_bytes)
        self._source_sizes[object_id] = physical_bytes

    def _observe_loaded_record(self, object_id: str, physical_bytes: int) -> None:
        expected = self._source_sizes.get(object_id)
        if expected is None:
            self._observe_record(physical_bytes)
            return
        if expected != physical_bytes:
            subdir, file_name = exact_object_record_location(object_id)
            raise SealedValidationSubjectChanged(
                object_id,
                self._objects_root / subdir / file_name,
                "size_changed",
                expected,
                physical_bytes,
            )

    def _claim_memory(self, dimension: str, amount: int) -> None:
        if dimension not in self._claimed_memory:
            raise CFError("HTTP upload sealed validation claimed an unknown memory dimension")
        upper = (
            self._coverage_retained_upper
            if dimension == "retained_bytes"
            else self._coverage_temporary_upper
        )
        claimed = self._claimed_memory[dimension] + amount
        if claimed > upper:
            raise CFError(
                f"HTTP upload sealed validation exceeded prepared {dimension}"
            )
        self._claimed_memory[dimension] = claimed

    def _release_memory_claim(self, dimension: str, amount: int) -> None:
        current = self._claimed_memory.get(dimension)
        if current is None or amount > current:
            raise CFError("HTTP upload sealed validation memory claim underflow")
        self._claimed_memory[dimension] = current - amount

    @staticmethod
    def _detach_failure(failure: BaseException) -> BaseException:
        current: BaseException | None = failure
        while current is not None:
            # Save the effective next link before destructively severing this
            # node.  Clearing each visited link also makes exception cycles
            # terminate without allocating a visited set.
            next_failure = current.__cause__
            if next_failure is None:
                next_failure = current.__context__
            current.__traceback__ = None
            current.__context__ = None
            current.__cause__ = None
            current = next_failure
        return failure

    def validate(self, ledger: DecisionWorkLedger) -> None:
        self._ensure_open(ledger)
        if self._validated:
            raise CFError("HTTP upload sealed validation owner is single-use")
        session = self._session
        if session is None:
            raise CFError("HTTP upload sealed validation session is unavailable")
        failure: BaseException | None = None
        try:
            self._poll()
            session.validate_commit(self._head, poll=self._poll)
            self._poll()
            self._validated = True
        except BaseException as exc:
            failure = self._detach_failure(exc)
        if failure is not None:
            # Leave the exception handler and drop its session local before
            # payload cleanup can release the preaccounted scalar owner.
            session = None
            self.close(ledger)
            raise failure

    def borrow_commits(
        self,
        ledger: DecisionWorkLedger,
        mode: str,
        *,
        _handoff_owner: Any | None = None,
        _upload_terminal_owner: Any | None = None,
    ) -> _HTTPUploadSealedCommitBorrow:
        """Activate the preallocated callable for one synchronous consumer."""
        self._ensure_open(ledger)
        self._ensure_upload_terminal_access(_upload_terminal_owner)
        if not self._validated:
            raise CFError("HTTP upload sealed validation has not validated its head")
        if self._finishing:
            raise CFError("HTTP upload sealed validation final fence is active")
        if self._borrow_releasing:
            raise CFError("HTTP upload sealed commit borrow release is active")
        if self._borrow_reading:
            raise CFError("HTTP upload sealed commit lookup is active")
        if self._borrow_failed:
            raise CFError("HTTP upload sealed commit borrow owner is abort-only")
        if mode != "signature" and mode != "ancestry":
            raise CFError("HTTP upload sealed commit borrow mode is invalid")
        if self._active_borrow_token:
            raise CFError("HTTP upload sealed commit borrow is already active")
        handle = self._borrow_handles.get(mode)
        if handle is None:
            raise CFError("HTTP upload sealed commit borrow is unavailable")
        if handle._used:
            raise CFError("HTTP upload sealed commit borrow is single-use")
        if _handoff_owner is not None:
            if object.__getattribute__(_handoff_owner, "_borrow") is not None:
                raise CFError("HTTP upload sealed borrow handoff slot is occupied")
            # Destination-first publication closes the activation-return gap.
            # A post-effect activation fault leaves this exact handle under
            # composite cleanup even when it is already revoked/abort-only.
            object.__setattr__(_handoff_owner, "_borrow", handle)
        token = self._borrow_generation + 1
        try:
            handle._activate(token)
        except BaseException as exc:
            failure = self._detach_failure(exc)
            # A failed activation can consume the purpose's single-use bit
            # even when its token was never published. The request cannot
            # prove that mandatory purpose remains available, so only abort
            # may follow either a pre- or post-token failure.
            self._borrow_failed = True
            if handle._token == token:
                # The effect committed but the caller never received the
                # handle. Revoke without another fallible call, make the owner
                # abort-only, and preserve even control-flow BaseExceptions.
                handle._token = 0
                self._active_borrow_token = 0
            raise failure
        self._borrow_generation = token
        self._active_borrow_token = token
        return handle

    def _borrow_mutation_failure(
        self, document: RetainedObjectDocument, actual_size: int | None
    ) -> CFError:
        self._borrow_failed = True
        actual = "unavailable" if actual_size is None else str(actual_size)
        return CFError(
            "HTTP upload sealed borrowed commit changed: "
            f"{document.object_id} (expected {document.borrow_canonical_bytes} "
            f"canonical bytes, actual {actual})"
        )

    def _canonical_borrow_digest(
        self, document: RetainedObjectDocument
    ) -> tuple[int, str]:
        """Fingerprint one retained record under the prepared request upper."""
        expected_upper = document.retained_bytes
        scratch_bytes = expected_upper * self.TEMPORARY_BYTES_MULTIPLIER
        self._claim_memory("temporary_bytes", scratch_bytes)
        encoded: bytes | None = None
        try:
            # Reserve all bounded work before the first traversal/encoder
            # allocation.  This is intentionally separate from the raw-file
            # digest: persisted records are pretty-printed while this seal is
            # over the parsed record's canonical semantic representation.
            self._ledger.apply(
                "snapshot_revalidation",
                charges={"snapshot_revalidation_bytes": expected_upper},
                counters={"bytes_hashed": expected_upper},
            )
            self._poll()
            actual_size = canonical_json_size_up_to(
                document.record, expected_upper, self._poll
            )
            if actual_size != expected_upper:
                raise self._borrow_mutation_failure(document, actual_size)
            self._poll()
            encoded = canonical_json(document.record)
            self._poll()
            if len(encoded) != actual_size:
                raise self._borrow_mutation_failure(document, len(encoded))
            digest = _sha256_hexdigest_polling(encoded, self._poll)
            return actual_size, digest
        finally:
            encoded = None
            self._release_memory_claim("temporary_bytes", scratch_bytes)

    def _seal_borrowed_document(
        self, document: RetainedObjectDocument, token: int
    ) -> None:
        initial_fingerprint = document.borrow_digest is None
        if initial_fingerprint:
            fingerprint_bytes = self.BORROW_FINGERPRINT_BYTES
            self._claim_memory("retained_bytes", fingerprint_bytes)
            # Publish the destination ownership before the digest allocator.
            document.borrow_fingerprint_bytes = fingerprint_bytes
        try:
            actual_size, digest = self._canonical_borrow_digest(document)
        except BaseException:
            if initial_fingerprint:
                document.borrow_fingerprint_bytes = 0
                self._release_memory_claim("retained_bytes", fingerprint_bytes)
            raise
        if initial_fingerprint:
            try:
                document.borrow_canonical_bytes = actual_size
                document.borrow_digest = digest
            except BaseException:
                document.borrow_canonical_bytes = 0
                document.borrow_digest = None
                document.borrow_fingerprint_bytes = 0
                self._release_memory_claim("retained_bytes", fingerprint_bytes)
                raise
        elif (
            actual_size != document.borrow_canonical_bytes
            or digest != document.borrow_digest
        ):
            raise self._borrow_mutation_failure(document, actual_size)
        document.borrow_token = token

    def _verify_borrowed_documents(self, token: int | None = None) -> None:
        session = self._session
        if session is None:
            raise CFError("HTTP upload sealed validation session is unavailable")
        try:
            for document in session.documents.values():
                if document.borrow_digest is None:
                    continue
                if token is not None and document.borrow_token != token:
                    continue
                self._seal_borrowed_document(document, document.borrow_token)
        except BaseException:
            self._borrow_failed = True
            raise

    def _final_detach_borrowed_documents(self) -> None:
        """Verify and detach borrowed authority without a post-read callback."""
        session = self._session
        if session is None:
            raise CFError("HTTP upload sealed validation session is unavailable")
        while True:
            selected: RetainedObjectDocument | None = None
            for document in session.documents.values():
                if document.borrow_digest is not None:
                    selected = document
                    break
            if selected is None:
                return
            expected_size = selected.borrow_canonical_bytes
            scratch_bytes = selected.retained_bytes * self.TEMPORARY_BYTES_MULTIPLIER
            self._claim_memory("temporary_bytes", scratch_bytes)
            encoded: bytes | None = None
            try:
                # All fallible accounting and cooperative interruption happen
                # before the final critical read. No callback may mutate the
                # raw alias after this canonical snapshot and before the
                # corresponding document is removed from session authority.
                self._ledger.apply(
                    "snapshot_revalidation",
                    charges={"snapshot_revalidation_bytes": selected.retained_bytes},
                    counters={"bytes_hashed": selected.retained_bytes},
                )
                self._poll()
                actual_size = canonical_json_size_up_to(
                    selected.record, selected.retained_bytes, None
                )
                if actual_size != expected_size:
                    raise self._borrow_mutation_failure(selected, actual_size)
                encoded = canonical_json(selected.record)
                if len(encoded) != actual_size:
                    raise self._borrow_mutation_failure(selected, len(encoded))
                digest = hashlib.sha256(encoded).hexdigest()
                if digest != selected.borrow_digest:
                    raise self._borrow_mutation_failure(selected, actual_size)
                object_id = selected.object_id
                selected.borrow_token = 0
                del session.documents[object_id]
                session.validated_commits.discard(object_id)
            finally:
                encoded = None
                selected = None
                self._release_memory_claim("temporary_bytes", scratch_bytes)

    def _borrow_commit(
        self,
        handle: _HTTPUploadSealedCommitBorrow,
        token: int,
        mode: str | None,
        object_id: str,
    ) -> Any:
        self._ensure_open(self._ledger)
        if self._borrow_reading:
            raise CFError("HTTP upload sealed commit lookup is already active")
        if (
            handle is not self._borrow_handles.get(mode)
            or not token
            or token != self._active_borrow_token
        ):
            raise CFError("HTTP upload sealed commit borrow is revoked")
        self._borrow_reading = True
        try:
            if not isinstance(object_id, str) or not object_id.startswith("CF-COMMIT-"):
                raise CFError("HTTP upload sealed commit borrow requires a commit object ID")
            session = self._session
            if session is None or object_id not in session.validated_commits:
                raise CFError(
                    "HTTP upload sealed commit borrow is outside validated authority"
                )
            document = session.documents.get(object_id)
            if document is None:
                raise CFError("HTTP upload sealed commit is not retained by its session")
            if document.path is None or document.digest is None:
                raise CFError(
                    "HTTP upload sealed commit borrow requires pinned filesystem authority"
                )
            self._seal_borrowed_document(document, token)
            # Fingerprinting contains deadline/accounting callbacks. Recheck
            # every authority component before obtaining the raw payload, so
            # no revoked lookup can complete even under an injected callback.
            if (
                handle is not self._borrow_handles.get(mode)
                or handle._token != token
                or token != self._active_borrow_token
            ):
                raise CFError("HTTP upload sealed commit borrow is revoked")
            payload = document.record.get("payload")
            if not isinstance(payload, dict) or payload.get("type") != "commit":
                payload = None
                raise CFError("HTTP upload sealed retained commit is invalid")
            if mode == "signature":
                return payload, document.retained_bytes
            if mode == "ancestry":
                return payload
            payload = None
            raise CFError("HTTP upload sealed commit borrow is revoked")
        finally:
            self._borrow_reading = False

    def _release_commit_borrow(
        self,
        handle: _HTTPUploadSealedCommitBorrow,
        token: int,
        ledger: DecisionWorkLedger | None,
    ) -> None:
        selected = self._ledger if ledger is None else ledger
        self._ensure_ledger(selected)
        if self._borrow_reading:
            raise CFError("HTTP upload sealed commit lookup is active")
        if self._borrow_releasing:
            raise CFError("HTTP upload sealed commit borrow release is already active")
        if handle is not self._borrow_handles.get(handle._mode):
            raise CFError("HTTP upload sealed commit borrow has a foreign owner")
        self._borrow_releasing = True
        try:
            if token and token == self._active_borrow_token:
                # Revoke in the owner first. A retry after interruption can
                # safely clear the stale handle token without reopening
                # authority. The release single-flight blocks another purpose
                # from entering during deadline/accounting callbacks.
                self._active_borrow_token = 0
            verification_failure: BaseException | None = None
            try:
                if token:
                    self._verify_borrowed_documents(token)
            except BaseException as exc:
                verification_failure = self._detach_failure(exc)
            revoke_failure: BaseException | None = None
            try:
                handle._revoke(self)
            except BaseException as exc:
                revoke_failure = self._detach_failure(exc)
            if revoke_failure is not None:
                raise revoke_failure
            if verification_failure is not None:
                raise verification_failure
        finally:
            self._borrow_releasing = False

    def finish(self, ledger: DecisionWorkLedger) -> None:
        self._ensure_open(ledger)
        self._ensure_upload_terminal_access(None)
        if self._upload_terminal_active:
            raise CFError("sealed signature handoff is active")
        if self._finishing:
            raise CFError("HTTP upload sealed validation final fence is already active")
        if self._borrow_releasing:
            raise CFError("HTTP upload sealed commit borrow release is active")
        if not self._validated:
            raise CFError("HTTP upload sealed validation has not validated its head")
        if self._active_borrow_token:
            raise CFError("HTTP upload sealed commit borrow is still active")
        if self._borrow_failed:
            raise CFError("HTTP upload sealed commit borrow owner is abort-only")
        session = self._session
        if session is None:
            raise CFError("HTTP upload sealed validation session is unavailable")
        failure: BaseException | None = None
        self._finishing = True
        try:
            self._poll()
            # Recheck every ever-borrowed record.  Raw payload references can
            # outlive handle revocation, but no mutation may cross this final
            # pre-effect fence.
            self._verify_borrowed_documents()
            self._poll()
            session.finalize(
                terminate=False,
                poll=self._poll,
                retain_documents=True,
            )
            self._final_detach_borrowed_documents()
            # Detach every remaining, never-exposed document before close can
            # invoke a scalar-release callback. Borrowed documents were
            # removed immediately after their callback-free final read.
            session.close(None)
        except BaseException as exc:
            failure = self._detach_failure(exc)
        session = None
        self._finishing = False
        self.close(ledger)
        if failure is not None:
            raise failure

    def close(
        self,
        ledger: DecisionWorkLedger,
        *,
        _upload_terminal_owner: Any | None = None,
    ) -> None:
        self._ensure_upload_terminal_access(_upload_terminal_owner)
        if self._closed:
            self._ensure_ledger(ledger)
            return
        self._ensure_ledger(ledger)
        if self._closing:
            return
        if (
            self._finishing
            or self._borrow_releasing
            or self._borrow_reading
            or self._upload_terminal_active
        ):
            # Abort remains available after the outer release attempt exits;
            # do not tear down document or scalar ownership from a
            # deadline/accounting callback while fingerprint/final-fence
            # locals are live. finish clears its flag before its own close.
            return
        self._closing = True
        completed = False
        try:
            self._finishing = False
            self._borrow_releasing = False
            self._borrow_reading = False
            borrow_handles = self._borrow_handles
            self._active_borrow_token = 0
            for borrow_handle in borrow_handles.values():
                borrow_handle._detach(self)
            borrow_handles.clear()
            if self._session is not None:
                close_session = getattr(self._session, "close", None)
                if close_session is not None:
                    close_session(None)
                self._session = None
            self._source_sizes.clear()
            self._head = None
            self._objects_root = None
            self._deadline = None
            self._claimed_memory["retained_bytes"] = 0
            self._claimed_memory["temporary_bytes"] = 0
            if self._scalar_owner is not None:
                self._scalar_owner.close()
                self._scalar_owner = None
            completed = True
        finally:
            if completed:
                self._closed = True
            self._closing = False

    def __del__(self) -> None:
        try:
            self.close(self._ledger)
        except BaseException:
            pass


class AccountedHTTPUploadSignatureVerificationComposite:
    """Own the sealed-to-signature-to-verification prerequisite handoff.

    Construction transfers the two parent owners to this production-unwired
    controller.  Callers must not use stale parent aliases.  ``prepare`` lends
    the sealed owner's exact preallocated signature handle and revokes it
    before any verification child can be constructed or published.
    """

    def __init__(
        self,
        sealed_owner: AccountedHTTPUploadSealedValidation,
        policy_authority: AccountedRemoteSignaturePolicyAuthority,
        ledger: DecisionWorkLedger,
    ) -> None:
        if not isinstance(sealed_owner, AccountedHTTPUploadSealedValidation):
            raise CFError("signature verification composite requires a sealed owner")
        if not isinstance(
            policy_authority, AccountedRemoteSignaturePolicyAuthority
        ):
            raise CFError(
                "signature verification composite requires a policy authority"
            )
        sealed_owner._ensure_open(ledger)
        policy_authority._ensure_open(ledger)
        if sealed_owner._deadline is not policy_authority._deadline:
            raise CFError(
                "signature verification composite requires the same deadline"
            )
        if not sealed_owner._validated:
            raise CFError(
                "signature verification composite requires validated authority"
            )
        if sealed_owner._upload_terminal_active:
            raise CFError("signature verification composite is already active")
        if policy_authority._policy_bound or policy_authority._verification_bound:
            raise CFError(
                "signature verification composite requires an unused policy authority"
            )
        if (
            sealed_owner._upload_terminal_owner is not None
            or policy_authority._upload_terminal_owner is not None
            or ledger._upload_terminal_owner is not None
        ):
            raise CFError("signature verification composite already owns a parent")
        self._ledger = ledger
        self._sealed_owner: AccountedHTTPUploadSealedValidation | None = sealed_owner
        self._policy_authority: AccountedRemoteSignaturePolicyAuthority | None = (
            policy_authority
        )
        self._signature_borrow: _HTTPUploadSealedCommitBorrow | None = None
        self._used = False
        self._operating = False
        self._closing = False
        self._abort_only = False
        self._closed = False
        self._binding = True
        bind_failure: BaseException | None = None
        try:
            object.__setattr__(ledger, "_upload_terminal_owner", self)
            object.__setattr__(sealed_owner, "_upload_terminal_owner", self)
            object.__setattr__(policy_authority, "_upload_terminal_owner", self)
        except BaseException as error:
            _detach_exception_chain(error)
            bind_failure = error
        if bind_failure is not None:
            # The caller cannot receive this controller after constructor
            # failure. Bypass replaceable __setattr__ hooks and roll back only
            # fields whose pre/post-effect assignment published this exact
            # controller, leaving any foreign authority untouched.
            if (
                object.__getattribute__(
                    sealed_owner, "_upload_terminal_owner"
                )
                is self
            ):
                object.__setattr__(
                    sealed_owner, "_upload_terminal_owner", None
                )
            if (
                object.__getattribute__(
                    policy_authority, "_upload_terminal_owner"
                )
                is self
            ):
                object.__setattr__(
                    policy_authority, "_upload_terminal_owner", None
                )
            if object.__getattribute__(ledger, "_upload_terminal_owner") is self:
                object.__setattr__(ledger, "_upload_terminal_owner", None)
            # A failed constructor never transferred parent ownership. Make
            # this unreachable partial controller inert before rethrow so its
            # finalizer cannot later close caller-owned parents.
            object.__setattr__(self, "_policy_authority", None)
            object.__setattr__(self, "_sealed_owner", None)
            object.__setattr__(self, "_closed", True)
            raise bind_failure.with_traceback(None)
        object.__setattr__(self, "_binding", False)

    def _ensure_ledger(self, ledger: DecisionWorkLedger) -> None:
        if ledger is not self._ledger:
            raise CFError(
                "signature verification composite belongs to a different ledger"
            )

    def prepare(
        self,
        branch: str,
        commit_id: str,
        ledger: DecisionWorkLedger,
        *,
        output_limit_bytes: int = 1024 * 1024,
        allow_missing_project: bool = False,
    ) -> "AccountedServerVerification":
        self._ensure_ledger(ledger)
        if self._binding:
            raise CFError("signature verification composite binding is in progress")
        if self._closed:
            raise CFError("signature verification composite is closed")
        if self._used:
            raise CFError("signature verification composite is single-use")
        if self._operating or self._closing:
            raise CFError("signature verification composite is already active")
        sealed_owner = self._sealed_owner
        policy_authority = self._policy_authority
        if sealed_owner is None or policy_authority is None:
            raise CFError("signature verification composite has no parent authority")
        sealed_owner._ensure_open(ledger)
        policy_authority._ensure_open(ledger)
        if sealed_owner._head != commit_id:
            raise CFError(
                "signature verification composite requires the validated head"
            )

        self._used = True
        authority_started = False
        verification_owner: AccountedServerVerification | None = None
        failure: BaseException | None = None
        try:
            # Both operating guards are inside this try so a pre/post-effect
            # __setattr__ or asynchronous exception still enters the
            # callback-free finally rollback below.
            self._operating = True
            sealed_owner._upload_terminal_active = True
            try:
                # Publish finally-cleanup responsibility before the fallible
                # begin call. A wrapper may raise after begin committed its
                # construction guard but before control returns here.
                authority_started = True
                policy_authority._begin_verified_server_verification(
                    branch,
                    commit_id,
                    ledger,
                    _upload_terminal_owner=self,
                )
                expected_borrow = sealed_owner._borrow_handles.get("signature")
                if not isinstance(expected_borrow, _HTTPUploadSealedCommitBorrow):
                    raise CFError(
                        "signature verification composite has no signature borrow"
                    )
                # Publish the exact preallocated cleanup authority before the
                # fallible activation call. A wrapper that raises after the
                # real borrow returned cannot strand the active token.
                self._signature_borrow = expected_borrow
                signature_borrow = sealed_owner.borrow_commits(
                    ledger,
                    "signature",
                    _upload_terminal_owner=self,
                )
                if signature_borrow is not expected_borrow:
                    raise CFError(
                        "signature verification composite received a foreign borrow"
                    )
                verification_owner = (
                    policy_authority._prepare_verified_server_verification_core(
                        signature_borrow,
                        branch,
                        commit_id,
                        output_limit_bytes=output_limit_bytes,
                        allow_missing_project=allow_missing_project,
                        close_loader=True,
                        _upload_terminal_owner=self,
                    )
                )
                if (
                    not isinstance(
                        verification_owner, AccountedServerVerification
                    )
                    or verification_owner
                    is not policy_authority._verification_owner
                ):
                    raise CFError(
                        "signature verification composite received a foreign "
                        "verification owner"
                    )
            except BaseException as error:
                _detach_exception_chain(error)
                failure = error

            cleanup_failure: BaseException | None = None
            signature_borrow = self._signature_borrow
            if (
                signature_borrow is not None
                and object.__getattribute__(signature_borrow, "_token")
            ):
                try:
                    signature_borrow.close(ledger)
                except BaseException as error:
                    _detach_exception_chain(error)
                    cleanup_failure = error
            if signature_borrow is not None:
                borrow_owner = object.__getattribute__(
                    signature_borrow, "_owner"
                )
                release_complete = (
                    borrow_owner is sealed_owner
                    and object.__getattribute__(signature_borrow, "_token") == 0
                    and object.__getattribute__(
                        sealed_owner, "_active_borrow_token"
                    )
                    == 0
                )
                if release_complete:
                    self._signature_borrow = None
                elif cleanup_failure is None:
                    cleanup_failure = CFError(
                        "sealed signature handoff borrow release is incomplete"
                    )
            signature_borrow = None

            if failure is not None or cleanup_failure is not None:
                self._abort_only = True
            if cleanup_failure is not None:
                if failure is not None:
                    raise cleanup_failure.with_traceback(None) from failure
                raise cleanup_failure.with_traceback(None)
            if failure is not None:
                raise failure.with_traceback(None)
            if verification_owner is None:
                self._abort_only = True
                raise CFError(
                    "signature verification composite produced no verification owner"
                )
            return verification_owner
        finally:
            verification_owner = None
            if authority_started:
                # This composite published cleanup responsibility before
                # begin. Clear the two existing guard fields directly so a
                # replaceable helper call cannot introduce a pre-effect
                # cleanup fault that strands the parent forever.
                object.__setattr__(
                    policy_authority, "_verification_handoff_open", False
                )
                object.__setattr__(
                    policy_authority, "_verification_constructing", False
                )
            object.__setattr__(
                sealed_owner, "_upload_terminal_active", False
            )
            object.__setattr__(self, "_operating", False)

    def close(self, ledger: DecisionWorkLedger) -> None:
        self._ensure_ledger(ledger)
        if self._binding:
            raise CFError("signature verification composite binding is in progress")
        if self._closed:
            return
        if self._operating:
            raise CFError("signature verification composite operation is in progress")
        if self._closing:
            raise CFError("signature verification composite cleanup is in progress")
        completed = False
        failure: BaseException | None = None
        try:
            # As with prepare, install the reentry guard only after the
            # finally cleanup region is active.
            self._closing = True
            signature_borrow = self._signature_borrow
            if signature_borrow is not None:
                try:
                    signature_borrow.close(ledger)
                except BaseException as error:
                    _detach_exception_chain(error)
                    failure = error
                if not signature_borrow._token:
                    self._signature_borrow = None
            signature_borrow = None
            if failure is None:
                policy_authority = self._policy_authority
                if policy_authority is not None:
                    try:
                        policy_authority.close(
                            ledger, _upload_terminal_owner=self
                        )
                    except BaseException as error:
                        _detach_exception_chain(error)
                        failure = error
            if failure is None:
                sealed_owner = self._sealed_owner
                if sealed_owner is not None:
                    try:
                        sealed_owner.close(
                            ledger, _upload_terminal_owner=self
                        )
                    except BaseException as error:
                        _detach_exception_chain(error)
                        failure = error
            policy_authority = self._policy_authority
            sealed_owner = self._sealed_owner
            completed = (
                failure is None
                and self._signature_borrow is None
                and (policy_authority is None or policy_authority._closed)
                and (sealed_owner is None or sealed_owner._closed)
            )
            if completed:
                if policy_authority is not None:
                    policy_authority._upload_terminal_owner = None
                if sealed_owner is not None:
                    sealed_owner._upload_terminal_owner = None
                object.__setattr__(self._ledger, "_upload_terminal_owner", None)
                self._policy_authority = None
                self._sealed_owner = None
                self._closed = True
        finally:
            object.__setattr__(self, "_closing", False)
        if failure is not None:
            raise failure.with_traceback(None)
        if not completed:
            raise CFError("signature verification composite cleanup is incomplete")

    def __del__(self) -> None:
        try:
            self.close(self._ledger)
        except BaseException:
            pass


class AccountedHTTPUploadExistingTerminalOwner:
    """Own all existing-project consumers under one parent authority token.

    This production-unwired owner closes the lifetime gap between signature,
    server verification, and ancestry consumers.  It intentionally exposes
    no child or borrow and provides no final pair fence, semantic detach,
    publication input, or handler wiring.
    """

    BOUND = "BOUND"
    VERIFYING = "VERIFYING"
    VERIFIED = "VERIFIED"
    ANCESTRY_RUNNING = "ANCESTRY_RUNNING"
    ANCESTRY_DONE = "ANCESTRY_DONE"
    ABORT_ONLY = "ABORT_ONLY"

    @staticmethod
    def _bind_parent_tokens(
        sealed_owner: AccountedHTTPUploadSealedValidation,
        policy_authority: AccountedRemoteSignaturePolicyAuthority,
        owner: "AccountedHTTPUploadExistingTerminalOwner",
    ) -> None:
        """Publish both diagnostic mirrors without replaceable callbacks."""
        object.__setattr__(sealed_owner, "_upload_terminal_owner", owner)
        object.__setattr__(policy_authority, "_upload_terminal_owner", owner)

    def __init__(
        self,
        sealed_owner: AccountedHTTPUploadSealedValidation,
        policy_authority: AccountedRemoteSignaturePolicyAuthority,
        ledger: DecisionWorkLedger,
    ) -> None:
        if not isinstance(sealed_owner, AccountedHTTPUploadSealedValidation):
            raise CFError("existing upload terminal requires a sealed owner")
        if not isinstance(
            policy_authority, AccountedRemoteSignaturePolicyAuthority
        ):
            raise CFError("existing upload terminal requires a policy authority")
        sealed_owner._ensure_open(ledger)
        policy_authority._ensure_open(ledger)
        if sealed_owner._deadline is not policy_authority._deadline:
            raise CFError("existing upload terminal requires the same deadline")
        if not sealed_owner._validated:
            raise CFError("existing upload terminal requires validated authority")
        if policy_authority._policy_bound or policy_authority._verification_bound:
            raise CFError("existing upload terminal requires an unused policy authority")
        if policy_authority._project_fd < 0 or policy_authority._missing_parts:
            raise CFError("existing upload terminal requires an existing project")
        if (
            sealed_owner._active_borrow_token
            or sealed_owner._borrow_failed
            or sealed_owner._borrow_releasing
            or sealed_owner._borrow_reading
            or sealed_owner._upload_terminal_active
            or sealed_owner._finishing
            or sealed_owner._closing
        ):
            raise CFError("existing upload terminal requires idle sealed authority")
        if (
            policy_authority._verification_constructing
            or policy_authority._verification_handoff_open
        ):
            raise CFError("existing upload terminal requires idle policy authority")
        for purpose in ("signature", "ancestry"):
            handle = sealed_owner._borrow_handles.get(purpose)
            if not isinstance(handle, _HTTPUploadSealedCommitBorrow) or handle._used:
                raise CFError("existing upload terminal requires unused consumer handles")
        if (
            sealed_owner._upload_terminal_owner is not None
            or policy_authority._upload_terminal_owner is not None
            or ledger._upload_terminal_owner is not None
        ):
            raise CFError("existing upload terminal already owns a parent")

        # Publish every cleanup field before binding either parent.  A failed
        # second bind can roll back both tokens without an unreachable owner.
        self._ledger = ledger
        self._ledger_identity = id(ledger)
        self._deadline = sealed_owner._deadline
        self._sealed_owner: AccountedHTTPUploadSealedValidation | None = (
            sealed_owner
        )
        self._policy_authority: (
            AccountedRemoteSignaturePolicyAuthority | None
        ) = policy_authority
        self._signature_borrow: _HTTPUploadSealedCommitBorrow | None = None
        self._verification: AccountedServerVerification | None = None
        self._ancestry_borrow: _HTTPUploadSealedCommitBorrow | None = None
        self._ancestry: AccountedHTTPUploadAncestry | None = None
        self._state = self.BOUND
        self._operating = False
        self._closing = False
        self._close_requested = False
        self._closed = False
        self._binding = True

        bind_failure: BaseException | None = None
        try:
            # One callback-free request registry assignment blocks stale
            # aliases of both parents before either diagnostic mirror bind.
            object.__setattr__(ledger, "_upload_terminal_owner", self)
            type(self)._bind_parent_tokens(
                sealed_owner, policy_authority, self
            )
        except BaseException as exc:
            _detach_exception_chain(exc)
            bind_failure = exc
        if bind_failure is not None:
            if object.__getattribute__(sealed_owner, "_upload_terminal_owner") is self:
                object.__setattr__(sealed_owner, "_upload_terminal_owner", None)
            if object.__getattribute__(policy_authority, "_upload_terminal_owner") is self:
                object.__setattr__(policy_authority, "_upload_terminal_owner", None)
            if object.__getattribute__(ledger, "_upload_terminal_owner") is self:
                object.__setattr__(ledger, "_upload_terminal_owner", None)
            object.__setattr__(self, "_sealed_owner", None)
            object.__setattr__(self, "_policy_authority", None)
            object.__setattr__(self, "_closed", True)
            raise bind_failure.with_traceback(None)
        object.__setattr__(self, "_binding", False)
        if self._close_requested:
            self.close(ledger)
            raise CFError("existing upload terminal binding was cancelled by close")

    @staticmethod
    def _detach_failure(exc: BaseException) -> BaseException:
        _detach_exception_chain(exc)
        return exc

    def _ensure_ledger(self, ledger: DecisionWorkLedger) -> None:
        if ledger is not self._ledger or id(ledger) != self._ledger_identity:
            raise CFError("existing upload terminal belongs to a different ledger")

    def _ensure_available(self) -> None:
        if self._binding:
            raise CFError("existing upload terminal binding is in progress")
        if self._closed:
            raise CFError("existing upload terminal is closed")
        if self._closing:
            raise CFError("existing upload terminal cleanup is in progress")

    @staticmethod
    def _borrow_released(
        borrow: _HTTPUploadSealedCommitBorrow,
        sealed_owner: AccountedHTTPUploadSealedValidation,
    ) -> bool:
        return (
            object.__getattribute__(borrow, "_owner") is sealed_owner
            and object.__getattribute__(borrow, "_token") == 0
            and object.__getattribute__(sealed_owner, "_active_borrow_token") == 0
        )

    def _finish_operation(
        self,
        failure: BaseException | None,
        cancellation: str,
    ) -> None:
        close_requested = self._close_requested
        if failure is not None or close_requested:
            object.__setattr__(self, "_state", self.ABORT_ONLY)
            cleanup_failure: BaseException | None = None
            try:
                self.close(self._ledger)
            except BaseException as exc:
                cleanup_failure = self._detach_failure(exc)
            if cleanup_failure is not None:
                if failure is not None:
                    raise cleanup_failure.with_traceback(None) from failure
                raise cleanup_failure.with_traceback(None)
            if failure is not None:
                raise failure.with_traceback(None)
            raise CFError(cancellation)

    def verify_signature_and_server(
        self,
        branch: str,
        head: str,
        ledger: DecisionWorkLedger,
        *,
        output_limit_bytes: int = AccountedServerVerification.DEFAULT_OUTPUT_LIMIT_BYTES,
    ) -> None:
        """Run and close both consumers without exposing either child."""
        self._ensure_ledger(ledger)
        self._ensure_available()
        if self._operating:
            raise CFError("existing upload terminal operation is in progress")
        if self._state != self.BOUND:
            if self._state == self.ABORT_ONLY:
                raise CFError("existing upload terminal is abort-only")
            raise CFError("existing upload terminal verification is single-use")
        sealed_owner = self._sealed_owner
        policy_authority = self._policy_authority
        if sealed_owner is None or policy_authority is None:
            raise CFError("existing upload terminal has no parent authority")
        if sealed_owner._head != head:
            raise CFError("existing upload terminal requires the validated head")

        failure: BaseException | None = None
        authority_started = False
        try:
            object.__setattr__(self, "_state", self.VERIFYING)
            object.__setattr__(self, "_operating", True)
            object.__setattr__(sealed_owner, "_upload_terminal_active", True)
            authority_started = True
            policy_authority._begin_verified_server_verification(
                branch,
                head,
                ledger,
                _upload_terminal_owner=self,
            )
            expected = sealed_owner._borrow_handles.get("signature")
            if not isinstance(expected, _HTTPUploadSealedCommitBorrow):
                raise CFError("existing upload terminal has no signature borrow")
            # Publish the exact preallocated handle before activation.
            self._signature_borrow = expected
            borrowed = sealed_owner.borrow_commits(
                ledger,
                "signature",
                _upload_terminal_owner=self,
            )
            if borrowed is not expected:
                raise CFError("existing upload terminal received a foreign borrow")
            verification = policy_authority._prepare_verified_server_verification_core(
                borrowed,
                branch,
                head,
                output_limit_bytes=output_limit_bytes,
                allow_missing_project=False,
                close_loader=True,
                _upload_terminal_owner=self,
            )
            if verification is not self._verification:
                raise CFError("existing upload terminal received a foreign verification child")
            if self._borrow_released(expected, sealed_owner):
                self._signature_borrow = None
            if self._close_requested:
                raise CFError(
                    "existing upload terminal verification was cancelled before execution"
                )
            verification.run()
            verification.close()
            if not verification._closed:
                raise CFError("existing upload terminal verification cleanup is incomplete")
            self._verification = None
            object.__setattr__(self, "_state", self.VERIFIED)
        except BaseException as exc:
            failure = self._detach_failure(exc)
            # Construction publishes partial verification into this owner.
            if self._verification is None:
                child = policy_authority._verification_owner
                if child is not None:
                    object.__setattr__(self, "_verification", child)
        finally:
            if authority_started:
                object.__setattr__(policy_authority, "_verification_handoff_open", False)
                object.__setattr__(policy_authority, "_verification_constructing", False)
            object.__setattr__(sealed_owner, "_upload_terminal_active", False)
            object.__setattr__(self, "_operating", False)
        sealed_owner = None
        policy_authority = None
        self._finish_operation(
            failure,
            "existing upload terminal verification was cancelled by close",
        )

    def contains_ancestor(
        self,
        ancestor: str,
        head: str,
        ledger: DecisionWorkLedger,
    ) -> bool:
        """Run the complete exact-handle BFS without exposing its borrow."""
        self._ensure_ledger(ledger)
        self._ensure_available()
        if self._operating:
            raise CFError("existing upload terminal operation is in progress")
        if self._state == self.ABORT_ONLY:
            raise CFError("existing upload terminal is abort-only")
        if self._state != self.VERIFIED:
            raise CFError("existing upload terminal ancestry requires verification")
        sealed_owner = self._sealed_owner
        if sealed_owner is None:
            raise CFError("existing upload terminal has no sealed authority")
        if sealed_owner._head != head:
            raise CFError("existing upload terminal requires the validated head")

        result = False
        failure: BaseException | None = None
        try:
            object.__setattr__(self, "_state", self.ANCESTRY_RUNNING)
            object.__setattr__(self, "_operating", True)
            object.__setattr__(sealed_owner, "_upload_terminal_active", True)
            expected = sealed_owner._borrow_handles.get("ancestry")
            if not isinstance(expected, _HTTPUploadSealedCommitBorrow):
                raise CFError("existing upload terminal has no ancestry borrow")
            self._ancestry_borrow = expected
            borrowed = sealed_owner.borrow_commits(
                ledger,
                "ancestry",
                _upload_terminal_owner=self,
            )
            if borrowed is not expected:
                raise CFError("existing upload terminal received a foreign borrow")
            AccountedHTTPUploadAncestry(
                ledger,
                borrowed,
                self._deadline,
                _handoff_owner=self,
            )
            ancestry = self._ancestry
            if ancestry is None:
                raise CFError("existing upload terminal produced no ancestry child")
            if self._close_requested:
                raise CFError(
                    "existing upload terminal ancestry was cancelled before decision"
                )
            result = ancestry.contains(ancestor, head)
            ancestry.close(ledger)
            if ancestry._closed:
                self._ancestry = None
            borrowed.close(ledger)
            if not self._borrow_released(borrowed, sealed_owner):
                raise CFError("existing upload terminal ancestry release is incomplete")
            self._ancestry_borrow = None
            object.__setattr__(self, "_state", self.ANCESTRY_DONE)
        except BaseException as exc:
            failure = self._detach_failure(exc)
        finally:
            object.__setattr__(sealed_owner, "_upload_terminal_active", False)
            object.__setattr__(self, "_operating", False)
        sealed_owner = None
        self._finish_operation(
            failure,
            "existing upload terminal ancestry was cancelled by close",
        )
        return result

    def close(self, ledger: DecisionWorkLedger) -> None:
        self._ensure_ledger(ledger)
        if self._binding:
            object.__setattr__(self, "_close_requested", True)
            return
        if self._closed:
            return
        if self._operating:
            self._close_requested = True
            return
        if self._closing:
            return
        object.__setattr__(self, "_closing", True)
        failure: BaseException | None = None
        try:
            sealed_owner = self._sealed_owner
            ancestry = self._ancestry
            if ancestry is not None:
                try:
                    ancestry.close(ledger)
                except BaseException as exc:
                    failure = self._detach_failure(exc)
                if ancestry._closed:
                    self._ancestry = None
            ancestry = None

            if failure is None:
                borrow = self._ancestry_borrow
                if borrow is not None:
                    try:
                        borrow.close(ledger)
                    except BaseException as exc:
                        failure = self._detach_failure(exc)
                    if sealed_owner is not None and self._borrow_released(
                        borrow, sealed_owner
                    ):
                        self._ancestry_borrow = None
                borrow = None

            if failure is None:
                verification = self._verification
                if verification is not None:
                    try:
                        verification.close()
                    except BaseException as exc:
                        failure = self._detach_failure(exc)
                    if verification._closed:
                        self._verification = None
                verification = None

            policy_authority = self._policy_authority
            if failure is None and policy_authority is not None:
                signature = policy_authority._policy_owner
                if signature is not None:
                    try:
                        signature.close(ledger)
                    except BaseException as exc:
                        failure = self._detach_failure(exc)
                    if signature._closed:
                        policy_authority._policy_owner = None
                signature = None

            if failure is None:
                borrow = self._signature_borrow
                if borrow is not None:
                    try:
                        borrow.close(ledger)
                    except BaseException as exc:
                        failure = self._detach_failure(exc)
                    if sealed_owner is not None and self._borrow_released(
                        borrow, sealed_owner
                    ):
                        self._signature_borrow = None
                borrow = None

            if failure is None and policy_authority is not None:
                try:
                    policy_authority.close(
                        ledger, _upload_terminal_owner=self
                    )
                except BaseException as exc:
                    failure = self._detach_failure(exc)

            if failure is None and sealed_owner is not None:
                try:
                    sealed_owner.close(
                        ledger, _upload_terminal_owner=self
                    )
                except BaseException as exc:
                    failure = self._detach_failure(exc)

            completed = (
                failure is None
                and self._ancestry is None
                and self._ancestry_borrow is None
                and self._verification is None
                and self._signature_borrow is None
                and (policy_authority is None or policy_authority._closed)
                and (sealed_owner is None or sealed_owner._closed)
            )
            if completed:
                if policy_authority is not None:
                    object.__setattr__(
                        policy_authority, "_upload_terminal_owner", None
                    )
                if sealed_owner is not None:
                    object.__setattr__(sealed_owner, "_upload_terminal_owner", None)
                object.__setattr__(self._ledger, "_upload_terminal_owner", None)
                self._policy_authority = None
                self._sealed_owner = None
                self._deadline = None
                self._close_requested = False
                self._closed = True
        finally:
            object.__setattr__(self, "_closing", False)
        if failure is not None:
            raise failure.with_traceback(None)
        if not self._closed:
            raise CFError("existing upload terminal cleanup is incomplete")

    def __del__(self) -> None:
        try:
            self.close(self._ledger)
        except BaseException:
            pass


class _HTTPUploadSealedValidationReservation:
    """Stable retry owner for both the permit and its consumed scalars."""

    def __init__(
        self,
        ledger: DecisionWorkLedger,
        temporary_bytes: int,
        retained_bytes: int,
    ) -> None:
        self._ledger = ledger
        self._permit: DecisionWorkPermit | None = DecisionWorkPermit()
        self._armed = True
        self._acquired = False
        self._temporary_bytes = temporary_bytes
        self._retained_bytes = retained_bytes
        self._temporary_baseline = ledger._current.get("temporary_bytes", 0)
        self._retained_baseline = ledger._current.get("retained_bytes", 0)
        self._temporary_consumed = self._temporary_baseline + temporary_bytes
        self._retained_consumed = self._retained_baseline + retained_bytes

    def borrow(self) -> DecisionWorkPermit:
        if self._permit is None:
            raise CFError("HTTP upload sealed reservation has no permit")
        return self._permit

    def _release_dimension(self, dimension: str, scalar_name: str) -> None:
        amount = getattr(self, scalar_name)
        if not amount:
            return
        current_before = self._ledger._current.get(dimension, 0)
        try:
            self._ledger.release(dimension, amount)
            setattr(self, scalar_name, 0)
        except BaseException:
            current_after = self._ledger._current.get(dimension, 0)
            if (
                current_before >= amount
                and current_after == current_before - amount
            ):
                # The ledger committed and a wrapper/asynchronous exception
                # arrived after it returned. Reconcile before propagating so a
                # retry cannot release the same scalar twice.
                setattr(self, scalar_name, 0)
            raise

    def close(self) -> None:
        if not self._armed:
            return
        permit = self._permit
        if permit is not None:
            if self._ledger.permit_is_open(permit):
                self._ledger.cancel_permit(permit)
                # Publish completion first: an asynchronous interruption after
                # cancel committed may safely re-enter close as a no-op.
                self._armed = False
                self._permit = None
                self._temporary_bytes = 0
                self._retained_bytes = 0
                return
            temporary_current = self._ledger._current.get("temporary_bytes", 0)
            retained_current = self._ledger._current.get("retained_bytes", 0)
            if (
                temporary_current == self._temporary_baseline
                and retained_current == self._retained_baseline
            ):
                # cancel committed and a wrapper/asynchronous exception was
                # raised before this owner could clear its permit field.
                self._armed = False
                self._permit = None
                self._temporary_bytes = 0
                self._retained_bytes = 0
                return
            if not (
                temporary_current == self._temporary_consumed
                and retained_current == self._retained_consumed
            ):
                raise CFError(
                    "HTTP upload sealed reservation closed with indeterminate scalars"
                )
            # consume committed. This also covers an exception raised before
            # factory code could execute another ownership operation.
            self._acquired = True
            self._permit = None
        if not self._acquired:
            raise CFError("HTTP upload sealed reservation ownership is indeterminate")
        self._release_dimension("temporary_bytes", "_temporary_bytes")
        self._release_dimension("retained_bytes", "_retained_bytes")
        self._armed = False
        self._acquired = False

    def __del__(self) -> None:
        try:
            self.close()
        except BaseException:
            pass


def prepare_http_upload_sealed_validation(
    ledger: DecisionWorkLedger,
    objects_root: Path,
    head: str,
    *,
    record_count_upper: int,
    aggregate_bytes_upper: int,
    maximum_record_bytes_upper: int,
    deadline: HTTPRequestDeadline | None,
) -> AccountedHTTPUploadSealedValidation:
    """Acquire the complete validation heap upper before its first allocator."""
    if not isinstance(head, str) or not head.startswith("CF-COMMIT-"):
        raise CFError("HTTP upload sealed validation requires a commit object ID")
    retained_upper, temporary_upper = (
        AccountedHTTPUploadSealedValidation.allocation_upper(
            record_count_upper,
            aggregate_bytes_upper,
            maximum_record_bytes_upper,
        )
    )
    reservation_owner = _HTTPUploadSealedValidationReservation(
        ledger, temporary_upper, retained_upper
    )
    reservation_failure: BaseException | None = None
    try:
        ledger.reserve_into(
            reservation_owner.borrow(),
            "semantic_validation",
            acquires={
                "retained_bytes": retained_upper,
                "temporary_bytes": temporary_upper,
            },
        )
        if deadline is not None:
            deadline.check("upload sealed validation")
        ledger.consume_reserved(
            reservation_owner.borrow(),
            phase="semantic_validation",
            acquires={
                "retained_bytes": retained_upper,
                "temporary_bytes": temporary_upper,
            },
        )
    except BaseException as exc:
        reservation_failure = AccountedHTTPUploadSealedValidation._detach_failure(
            exc
        )
    if reservation_failure is not None:
        cleanup_failure: BaseException | None = None
        try:
            reservation_owner.close()
        except BaseException as exc:
            cleanup_failure = AccountedHTTPUploadSealedValidation._detach_failure(
                exc
            )
        if cleanup_failure is not None:
            retry_failure: BaseException | None = None
            try:
                reservation_owner.close()
            except BaseException as exc:
                retry_failure = AccountedHTTPUploadSealedValidation._detach_failure(
                    exc
                )
            if retry_failure is not None:
                raise retry_failure
            raise cleanup_failure
        raise reservation_failure

    owner: AccountedHTTPUploadSealedValidation | None = None
    construction_failure: BaseException | None = None
    try:
        owner, construction_failure = (
            AccountedHTTPUploadSealedValidation._from_acquired(
                ledger,
                objects_root,
                head,
                record_count_upper,
                aggregate_bytes_upper,
                maximum_record_bytes_upper,
                retained_upper,
                temporary_upper,
                reservation_owner,
                deadline,
            )
        )
    except BaseException as exc:
        construction_failure = AccountedHTTPUploadSealedValidation._detach_failure(
            exc
        )
    if owner is None and construction_failure is None:
        construction_failure = CFError(
            "HTTP upload sealed validation constructor returned no owner"
        )
    if construction_failure is not None:
        cleanup_failure: BaseException | None = None
        if owner is not None:
            try:
                owner.close(ledger)
            except BaseException as exc:
                cleanup_failure = AccountedHTTPUploadSealedValidation._detach_failure(
                    exc
                )
        else:
            try:
                reservation_owner.close()
            except BaseException as exc:
                cleanup_failure = AccountedHTTPUploadSealedValidation._detach_failure(
                    exc
                )
        if cleanup_failure is not None:
            retry_failure: BaseException | None = None
            try:
                if owner is not None:
                    owner.close(ledger)
                else:
                    reservation_owner.close()
            except BaseException as exc:
                retry_failure = AccountedHTTPUploadSealedValidation._detach_failure(
                    exc
                )
            if retry_failure is not None:
                raise retry_failure
            raise cleanup_failure
        owner = None
        raise construction_failure
    return owner


class AccountedHTTPUploadSealedAncestry:
    """Own one sealed commit borrow through one accounted ancestry walk.

    This is a production-unwired handoff.  It never reopens or clones a
    commit: ``AccountedHTTPUploadAncestry`` receives only the sealed owner's
    purpose-specific callable borrow.  The ancestry payload/loader is always
    dropped before the borrow is released, and the sealed owner remains with
    its caller for the later terminal fence.
    """

    def __init__(
        self,
        sealed_owner: AccountedHTTPUploadSealedValidation,
        ledger: DecisionWorkLedger,
        deadline: HTTPRequestDeadline | None,
    ) -> None:
        # Publish every cleanup field before the first fallible authority
        # operation.  A prepare fault can then unwind through this same
        # object without losing an activated sealed borrow.
        self._ledger = ledger
        self._ledger_identity = id(ledger)
        self._deadline = deadline
        self._sealed_owner: AccountedHTTPUploadSealedValidation | None = None
        self._borrow: _HTTPUploadSealedCommitBorrow | None = None
        self._ancestry: AccountedHTTPUploadAncestry | None = None
        self._preparing = False
        self._prepared = False
        self._running = False
        self._closing = False
        self._close_requested = False
        self._closed = False
        self._prepare_used = False
        self._decision_used = False

        if not isinstance(sealed_owner, AccountedHTTPUploadSealedValidation):
            raise CFError("HTTP upload sealed ancestry requires a sealed owner")
        sealed_owner._ensure_open(ledger)
        if sealed_owner._deadline is not deadline:
            raise CFError(
                "HTTP upload sealed ancestry must share the sealed deadline"
            )
        self._sealed_owner = sealed_owner

    def _ensure_ledger(self, ledger: DecisionWorkLedger) -> None:
        if (
            id(ledger) != self._ledger_identity
            or id(self._ledger) != self._ledger_identity
        ):
            raise CFError(
                "HTTP upload sealed ancestry belongs to a different ledger"
            )

    def _ensure_bound(self) -> None:
        self._ensure_ledger(self._ledger)
        if self._closed:
            raise CFError("HTTP upload sealed ancestry owner is closed")

    def _ensure_open(self) -> None:
        self._ensure_bound()
        if (
            not self._prepared
            or self._borrow is None
            or self._ancestry is None
        ):
            raise CFError("HTTP upload sealed ancestry owner is not prepared")

    def prepare(self, ledger: DecisionWorkLedger) -> None:
        """Activate both child owners after the caller owns this composite."""
        self._ensure_ledger(ledger)
        self._ensure_bound()
        if self._preparing:
            raise CFError("HTTP upload sealed ancestry prepare is already active")
        if self._prepare_used:
            raise CFError("HTTP upload sealed ancestry prepare is single-use")
        sealed_owner = self._sealed_owner
        if sealed_owner is None:
            raise CFError("HTTP upload sealed ancestry has no sealed owner")
        if sealed_owner._deadline is not self._deadline:
            raise CFError(
                "HTTP upload sealed ancestry deadline changed before prepare"
            )
        self._prepare_used = True
        self._preparing = True
        failure: BaseException | None = None
        try:
            sealed_owner.borrow_commits(
                ledger, "ancestry", _handoff_owner=self
            )
            assert self._borrow is not None
            AccountedHTTPUploadAncestry(
                ledger,
                self._borrow,
                self._deadline,
                _handoff_owner=self,
            )
            self._prepared = True
        except BaseException as exc:
            _detach_ancestry_exception_chain(exc)
            failure = exc
        sealed_owner = None
        self._sealed_owner = None
        self._preparing = False
        close_requested = self._close_requested
        cleanup_failure: BaseException | None = None
        if close_requested:
            try:
                self.close(ledger)
            except BaseException as exc:
                _detach_ancestry_exception_chain(exc)
                cleanup_failure = exc
        if cleanup_failure is not None:
            if failure is not None:
                raise cleanup_failure from failure
            raise cleanup_failure from None
        if failure is not None:
            # Do not auto-close.  The caller received this owner before
            # prepare and can retry an arbitrary cleanup failure on the same
            # exact ancestry/borrow fields.
            raise failure from None
        if close_requested:
            raise CFError(
                "HTTP upload sealed ancestry prepare was cancelled by close"
            )

    def contains(self, ancestor: str, head: str) -> bool:
        self._ensure_open()
        if self._running:
            raise CFError("HTTP upload sealed ancestry decision is already active")
        if self._decision_used:
            raise CFError("HTTP upload sealed ancestry owner is single-use")
        self._decision_used = True
        self._running = True
        result = False
        failure: BaseException | None = None
        ancestry = self._ancestry
        try:
            assert ancestry is not None
            result = ancestry.contains(ancestor, head)
        except BaseException as exc:
            _detach_ancestry_exception_chain(exc)
            failure = exc
        ancestry = None
        self._running = False

        cleanup_failure: BaseException | None = None
        try:
            self.close(self._ledger)
        except BaseException as exc:
            _detach_ancestry_exception_chain(exc)
            cleanup_failure = exc
        if cleanup_failure is not None:
            result = False
            if failure is not None:
                raise cleanup_failure from failure
            raise cleanup_failure from None
        if failure is not None:
            raise failure from None
        return result

    def close(self, ledger: DecisionWorkLedger | None = None) -> None:
        selected = self._ledger if ledger is None else ledger
        self._ensure_ledger(selected)
        if self._closed:
            return
        if self._preparing:
            self._close_requested = True
            return
        if self._running:
            # A deadline/accounting callback may request teardown while the
            # ancestry owner or borrow lookup still has payload locals.  The
            # outer decision performs the close after those frames unwind.
            self._close_requested = True
            return
        if self._closing:
            return
        self._closing = True
        completed = False
        try:
            ancestry = self._ancestry
            if ancestry is not None:
                ancestry.close(self._ledger)
                self._ancestry = None
            borrow = self._borrow
            if borrow is not None:
                borrow.close(self._ledger)
                self._borrow = None
            self._sealed_owner = None
            self._deadline = None
            self._prepared = False
            self._close_requested = False
            completed = True
        finally:
            if completed:
                self._closed = True
            self._closing = False

    def __del__(self) -> None:
        try:
            self.close(self._ledger)
        except BaseException:
            pass


def prepare_http_upload_sealed_ancestry(
    sealed_owner: AccountedHTTPUploadSealedValidation,
    ledger: DecisionWorkLedger,
    deadline: HTTPRequestDeadline | None = None,
) -> AccountedHTTPUploadSealedAncestry:
    """Allocate the handoff destination before its explicit prepare step."""
    return AccountedHTTPUploadSealedAncestry(
        sealed_owner, ledger, deadline
    )


def validate_sealed_commit(objects_root: Path, commit_id: str, seen: set[str] | None = None) -> None:
    ledger = DecisionWorkLedger(DecisionWorkProfile.local_v1(), "sealed validation")
    session = SealedCommitValidationSession(objects_root, ledger)
    if seen:
        session.validated_commits.update(seen)
    try:
        session.validate_commit(commit_id)
        if seen is not None:
            seen.update(session.validated_commits)
        session.finalize()
    finally:
        session.close(None)


def _validate_sealed_commit_payload(
    commit: dict[str, Any],
    load_payload: Any,
    charge_edge: Any = lambda: None,
    poll: Any | None = None,
    preflight_source: Any | None = None,
) -> None:
    def check() -> None:
        if poll is not None:
            poll()

    roots = commit.get("roots")
    if not isinstance(roots, dict):
        raise CFError("sealed commit validation failed: roots must be an object")
    required_roots = ["content_manifest", "atom_index", "trace_graph", "fire_delta", "verification", "policy"]
    expected_root_types = {
        "content_manifest": "content_manifest",
        "atom_index": "atom_index",
        "trace_graph": "trace_graph",
        "fire_delta": "fire_ledger",
        "resolution_ledger": "resolution_ledger",
        "verification": "verification",
        "policy": "policy",
    }
    for root in required_roots:
        check()
        if root not in roots:
            raise CFError(f"sealed commit validation failed: missing root {root}")
    ordered_roots = list(roots)
    _sort_strings_polling(ordered_roots, poll)
    for root in ordered_roots:
        check()
        oid = roots[root]
        if not isinstance(oid, str) or not oid.startswith("CF-"):
            raise CFError(f"sealed commit validation failed: root {root} must be an object id")
        expected_type = expected_root_types.get(root)
        if expected_type and preflight_source is not None:
            preflight_source(oid)
        charge_edge()
        if not expected_type:
            continue
        payload = load_payload(oid)
        if payload.get("type") != expected_type:
            raise CFError(f"sealed commit validation failed: root {root} has type {payload.get('type', '(missing)')}, expected {expected_type}")
    certificate = commit.get("certificate")
    if not isinstance(certificate, dict):
        raise CFError("sealed commit validation failed: certificate must be an object")
    if certificate.get("result") != "consistent":
        raise CFError("sealed commit validation failed: certificate is not consistent")
    policy_record = load_payload(roots["policy"])
    policy = policy_record.get("policy", {})
    if policy.get("require_commit_signature"):
        validate_commit_signature_structure(commit, required=True)
    else:
        validate_commit_signature_structure(commit, required=False)
    verification = load_payload(roots["verification"])
    check()
    if verification.get("result") != "passed":
        raise CFError("sealed commit validation failed: verification object did not pass")
    for failed_check in verification.get("failed_checks", []):
        check()
        if failed_check.get("id") == "merge-conflicts":
            raise CFError("sealed commit validation failed: merge conflicts remain")
    if policy_enabled(policy, "require_no_required_fires") and certificate.get("open_required_fires", 0) != 0:
        raise CFError("sealed commit validation failed: open fires remain")
    if policy_enabled(policy, "require_verification_success") and certificate.get("failed_checks", 0) != 0:
        raise CFError("sealed commit validation failed: verification checks failed")
    if policy_enabled(policy, "require_trace_completeness") and certificate.get("missing_required_links", 0) != 0:
        raise CFError("sealed commit validation failed: required links are missing")
    if policy_enabled(policy, "require_no_stale_resolutions") and certificate.get("stale_resolutions", 0) != 0:
        raise CFError("sealed commit validation failed: stale resolutions remain")
    if policy_enabled(policy, "reject_duplicate_atom_ids") and certificate.get("duplicate_atom_ids", 0) != 0:
        raise CFError("sealed commit validation failed: duplicate Atom IDs remain")


def ref_file_name(name: str) -> str:
    return urllib.parse.quote(name, safe="")


def branch_path(repo_root: Path, name: str) -> Path:
    return repo_dirs(repo_root)["branches"] / f"{ref_file_name(name)}.json"


def load_branch(repo_root: Path, name: str) -> dict[str, Any]:
    data = read_json(branch_path(repo_root, name))
    if not data:
        raise CFError(f"unknown branch: {name}")
    return data


def opened_registry_path(repo_root: Path, branch: str) -> Path:
    return repo_dirs(repo_root)["opened"] / f"{ref_file_name(branch)}.json"


def opened_branch_state(repo_root: Path, branch: str) -> str | None:
    registry = read_json(opened_registry_path(repo_root, branch))
    if not registry:
        return None
    return registry.get("state", {}).get("last_known", "open-clean")


def require_source_branch_sealed(repo_root: Path, branch: str, operation: str) -> None:
    state = opened_branch_state(repo_root, branch)
    if state and state != "open-clean":
        raise CFError(f"cannot {operation} from branch '{branch}' while it is {state}; commit or discard first")


def save_branch(repo_root: Path, data: dict[str, Any]) -> None:
    lock_name = f"branch-{ref_file_name(data['name'])}.lock"
    with file_lock(repo_dirs(repo_root)["locks"] / lock_name):
        write_json(branch_path(repo_root, data["name"]), data)
        store_object(repo_root, "branch", data)


def branch_names(repo_root: Path) -> list[str]:
    names = []
    for path in sorted(repo_dirs(repo_root)["branches"].glob("*.json")):
        names.append(read_json(path)["name"])
    return names


def active_dir(repo_root: Path, open_instance_id: str) -> Path:
    return repo_dirs(repo_root)["active"] / open_instance_id


def rel_files(open_dir: Path) -> list[Path]:
    files: list[Path] = []
    for root, dirs, names in os.walk(open_dir):
        root_path = Path(root)
        dirs[:] = [d for d in dirs if d not in {".codefire", "__pycache__", ".pytest_cache"}]
        for name in names:
            path = root_path / name
            rel = path.relative_to(open_dir)
            if rel.as_posix() == ".codefire-open":
                continue
            files.append(rel)
    return sorted(files, key=lambda p: p.as_posix())


def read_text_lossy(path: Path) -> str:
    return path.read_text(encoding="utf-8", errors="replace")


def parse_links(path: Path) -> list[dict[str, str]]:
    if not path.exists():
        return []
    links: list[dict[str, str]] = []
    current: dict[str, str] | None = None
    current_line = 0

    def flush_link() -> None:
        if current is None:
            return
        missing = {"from", "to", "type"} - set(current)
        if missing:
            raise CFError(f"invalid codefire.links.yaml: link at line {current_line} missing {', '.join(sorted(missing))}")
        links.append(current)

    for line_no, raw_line in enumerate(path.read_text(encoding="utf-8").splitlines(), start=1):
        line = raw_line.split("#", 1)[0]
        stripped = line.strip()
        if not stripped:
            continue
        m = re.match(r"-\s+from:\s*(.+)$", stripped)
        if m:
            flush_link()
            current = {"from": unquote(m.group(1))}
            current_line = line_no
            continue
        if current is None:
            continue
        m = re.match(r"(to|type):\s*(.+)$", stripped)
        if m:
            current[m.group(1)] = unquote(m.group(2))
    flush_link()
    return links


def unquote(value: str) -> str:
    value = value.strip()
    if len(value) >= 2 and value[0] in {'"', "'"} and value[-1] == value[0]:
        return value[1:-1]
    return value


def parse_bool(value: str) -> bool:
    normalized = unquote(value).strip().lower()
    if normalized in {"true", "yes", "on", "1"}:
        return True
    if normalized in {"false", "no", "off", "0"}:
        return False
    raise CFError(f"invalid boolean value in policy: {value}")


def policy_enabled(policy: dict[str, Any], key: str) -> bool:
    return bool(policy.get(key, True))


def parse_config(open_dir: Path) -> dict[str, list[str]]:
    defaults = {
        "requirements": ["docs/spec/**/*.md", "docs/requirements/**/*.md"],
        "designs": ["docs/design/**/*.md"],
        "adrs": ["adr/**/*.md", "docs/adr/**/*.md", "docs/adrs/**/*.md"],
        "ops": ["docs/ops/**/*.md", "docs/runbooks/**/*.md", "runbooks/**/*.md"],
        "apis": [
            "docs/api/**/*.json",
            "docs/api/**/*.yaml",
            "docs/api/**/*.yml",
            "openapi/**/*.json",
            "openapi/**/*.yaml",
            "openapi/**/*.yml",
            "api/**/*.json",
            "api/**/*.yaml",
            "api/**/*.yml",
        ],
        "db": ["db/**/*.sql", "schema/**/*.sql", "schemas/**/*.sql"],
        "code": ["src/**/*.py"],
        "tests": ["tests/**/*.py"],
    }
    path = open_dir / "codefire.yaml"
    if not path.exists():
        return defaults
    config = {k: [] for k in defaults}
    current: str | None = None
    for line_no, raw_line in enumerate(path.read_text(encoding="utf-8").splitlines(), start=1):
        line = raw_line.split("#", 1)[0]
        stripped = line.strip()
        if not stripped:
            continue
        if not raw_line.startswith((" ", "\t")):
            current = None
        if stripped.rstrip(":") in config and stripped.endswith(":"):
            current = stripped[:-1]
            continue
        m = re.match(r"-\s+path:\s*(.+)$", stripped)
        if current and m:
            value = unquote(m.group(1))
            if not value:
                raise CFError(f"invalid codefire.yaml: empty path at line {line_no}")
            config[current].append(value)
            continue
        if current and stripped.startswith("- "):
            raise CFError(f"invalid codefire.yaml: artifact entry at line {line_no} must start with 'path:'")
    for key, value in defaults.items():
        if not config[key]:
            config[key] = value
    return config


def parse_policy(open_dir: Path) -> dict[str, Any]:
    path = open_dir / "codefire.policy.yaml"
    default_required_links = {
        "requirement": [
            {"type": "refined_by", "target_kind": "design", "min": 1},
            {"type": "verified_by", "target_kind": "test", "min": 1},
        ],
        "design": [{"type": "implemented_by", "target_kind": "code", "min": 1}],
    }
    policy = {
        "require_no_required_fires": True,
        "require_no_stale_resolutions": True,
        "require_trace_completeness": True,
        "require_verification_success": True,
        "reject_duplicate_atom_ids": True,
        "no_change_required_requires_rationale": True,
        "required_links": default_required_links,
        "verification": [],
    }
    if not path.exists():
        return policy
    checks: list[dict[str, str]] = []
    current: dict[str, str] | None = None
    custom_required_links: dict[str, list[dict[str, Any]]] = {}
    current_link_kind: str | None = None
    current_link_rule: dict[str, Any] | None = None
    in_required_links = False
    in_commit_policy = False
    in_extinguish_policy = False
    in_no_change_required_policy = False

    def flush_check() -> None:
        if current and current.get("command"):
            check = dict(current)
            check.setdefault("id", f"verification-{len(checks) + 1}")
            check.setdefault("cwd", ".")
            checks.append(check)
        elif current:
            raise CFError("invalid codefire.policy.yaml: verification entry missing command")

    def flush_required_link() -> None:
        if current_link_kind and current_link_rule:
            missing = {"type", "target_kind"} - set(current_link_rule)
            if missing:
                raise CFError(f"invalid codefire.policy.yaml: required_links.{current_link_kind} missing {', '.join(sorted(missing))}")
            rule = dict(current_link_rule)
            try:
                rule["min"] = int(rule.get("min", 1) or 1)
            except ValueError as exc:
                raise CFError(f"invalid codefire.policy.yaml: required_links.{current_link_kind}.min must be an integer") from exc
            custom_required_links.setdefault(current_link_kind, []).append(rule)

    for raw_line in path.read_text(encoding="utf-8").splitlines():
        line = raw_line.split("#", 1)[0].rstrip()
        stripped = line.strip()
        if not stripped:
            continue
        if not raw_line.startswith((" ", "\t")):
            if stripped == "required_links:":
                flush_required_link()
                current_link_kind = None
                current_link_rule = None
                in_required_links = True
                in_commit_policy = False
            elif stripped == "commit_policy:":
                flush_required_link()
                current_link_kind = None
                current_link_rule = None
                in_required_links = False
                in_commit_policy = True
                in_extinguish_policy = False
                in_no_change_required_policy = False
            elif stripped == "extinguish_policy:":
                flush_required_link()
                current_link_kind = None
                current_link_rule = None
                in_required_links = False
                in_commit_policy = False
                in_extinguish_policy = True
                in_no_change_required_policy = False
            else:
                flush_required_link()
                current_link_kind = None
                current_link_rule = None
                in_required_links = False
                in_commit_policy = False
                in_extinguish_policy = False
                in_no_change_required_policy = False
        if in_commit_policy:
            m = re.match(r"(require_no_required_fires|require_no_stale_resolutions|require_trace_completeness|require_verification_success|reject_duplicate_atom_ids):\s*(.+)$", stripped)
            if m:
                policy[m.group(1)] = parse_bool(m.group(2))
                continue
        if in_extinguish_policy:
            if re.match(r"^\s{2}no-change-required:\s*$", line):
                in_no_change_required_policy = True
                continue
            m = re.match(r"requires_rationale:\s*(.+)$", stripped)
            if m and in_no_change_required_policy:
                policy["no_change_required_requires_rationale"] = parse_bool(m.group(1))
                continue
        if in_required_links:
            m = re.match(r"^\s{2}([A-Za-z_][A-Za-z0-9_-]*):\s*$", line)
            if m:
                flush_required_link()
                current_link_kind = m.group(1)
                current_link_rule = None
                custom_required_links.setdefault(current_link_kind, [])
                continue
            m = re.match(r"-\s+(type|target_kind|min):\s*(.+)$", stripped)
            if m:
                flush_required_link()
                current_link_rule = {m.group(1): unquote(m.group(2))}
                continue
            m = re.match(r"(type|target_kind|min):\s*(.+)$", stripped)
            if m and current_link_rule is not None:
                current_link_rule[m.group(1)] = unquote(m.group(2))
                continue
        m = re.match(r"-\s+(id|command|cwd):\s*(.+)$", stripped)
        if m:
            flush_check()
            current = {m.group(1): unquote(m.group(2))}
            if "cwd" not in current:
                current["cwd"] = "."
            continue
        m = re.match(r"(id|command|cwd):\s*(.+)$", stripped)
        if m:
            if current is None:
                current = {"cwd": "."}
            current[m.group(1)] = unquote(m.group(2))
    flush_check()
    flush_required_link()
    if custom_required_links:
        policy["required_links"] = custom_required_links
    policy["verification"].extend(checks)
    return policy


def matches_any(rel: Path, patterns: list[str]) -> bool:
    s = rel.as_posix()
    for pat in patterns:
        if fnmatch.fnmatch(s, pat):
            return True
        if "**/" in pat and fnmatch.fnmatch(s, pat.replace("**/", "")):
            return True
    return False


def kind_from_atom_id(atom_id: str, fallback: str = "unknown") -> str:
    if atom_id.startswith("REQ-"):
        return "requirement"
    if atom_id.startswith("DES-"):
        return "design"
    if atom_id.startswith("TEST-"):
        return "test"
    if atom_id.startswith("CODE-") or atom_id.startswith("CODE:"):
        return "code"
    if atom_id.startswith("ADR-"):
        return "adr"
    if atom_id.startswith("OPS-"):
        return "ops"
    if atom_id.startswith("API-"):
        return "api"
    if atom_id.startswith("DB-"):
        return "db"
    return fallback


def hash_text(text: str) -> str:
    return digest_bytes(text.encode("utf-8"))


def extract_markdown_atoms(path: Path, rel: Path, fallback_kind: str) -> list[dict[str, Any]]:
    lines = read_text_lossy(path).splitlines()
    headings: list[tuple[int, int, str]] = []
    for i, line in enumerate(lines):
        m = re.match(r"^(#{1,6})\s+([A-Z]+-[A-Za-z0-9_.-]+)(?::|\s|$)", line)
        if m:
            headings.append((i, len(m.group(1)), m.group(2)))
    atoms: list[dict[str, Any]] = []
    for idx, (start, level, atom_id) in enumerate(headings):
        end = len(lines)
        for next_start, next_level, _ in headings[idx + 1 :]:
            if next_level <= level:
                end = next_start
                break
        content = "\n".join(lines[start:end]).strip() + "\n"
        atoms.append(
            {
                "atom_id": atom_id,
                "kind": kind_from_atom_id(atom_id, fallback_kind),
                "artifact_path": rel.as_posix(),
                "selector": {"type": "markdown_heading", "value": atom_id},
                "content_hash": hash_text(content),
            }
        )
    return atoms


def python_blocks(lines: list[str]) -> list[tuple[int, int, str, str]]:
    blocks: list[tuple[int, int, str, str]] = []
    class_stack: list[tuple[int, str]] = []
    for i, line in enumerate(lines):
        m = re.match(r"^(\s*)(class|def)\s+([A-Za-z_][A-Za-z0-9_]*)", line)
        if not m:
            continue
        indent = len(m.group(1))
        while class_stack and indent <= class_stack[-1][0]:
            class_stack.pop()
        end = len(lines)
        for j in range(i + 1, len(lines)):
            text = lines[j]
            if text.strip() == "":
                continue
            current_indent = len(text) - len(text.lstrip(" "))
            if current_indent <= indent and not text.lstrip().startswith(("#", "@")):
                end = j
                break
        symbol_type = m.group(2)
        name = m.group(3)
        if symbol_type == "class":
            class_stack.append((indent, name))
        elif class_stack:
            symbol_type = "method"
            name = f"{class_stack[-1][1]}.{name}"
        blocks.append((i, end, symbol_type, name))
    return blocks


def extract_python_atoms(path: Path, rel: Path, fallback_kind: str) -> list[dict[str, Any]]:
    lines = read_text_lossy(path).splitlines()
    explicit_by_line: dict[int, str] = {}
    for i, line in enumerate(lines):
        m = re.search(r"#\s*cf-atom:\s*([A-Za-z0-9_.:-]+)", line)
        if m:
            explicit_by_line[i] = m.group(1)
    atoms: list[dict[str, Any]] = []
    used_explicit: set[int] = set()
    for start, end, symbol_type, name in python_blocks(lines):
        explicit_line = None
        for candidate in range(max(0, start - 3), start + 1):
            if candidate in explicit_by_line and candidate not in used_explicit:
                explicit_line = candidate
        if explicit_line is not None:
            atom_id = explicit_by_line[explicit_line]
            used_explicit.add(explicit_line)
        else:
            prefix = "TEST" if fallback_kind == "test" else "CODE"
            atom_id = f"{prefix}:{rel.as_posix()}::{symbol_type}:{name}"
        content_start = explicit_line if explicit_line is not None else start
        content = "\n".join(lines[content_start:end]).strip() + "\n"
        atoms.append(
            {
                "atom_id": atom_id,
                "kind": kind_from_atom_id(atom_id, fallback_kind),
                "artifact_path": rel.as_posix(),
                "selector": {"type": f"python_{symbol_type}", "value": name},
                "content_hash": hash_text(content),
            }
        )
    for line_no, atom_id in explicit_by_line.items():
        if line_no in used_explicit:
            continue
        content = lines[line_no].strip() + "\n"
        atoms.append(
            {
                "atom_id": atom_id,
                "kind": kind_from_atom_id(atom_id, fallback_kind),
                "artifact_path": rel.as_posix(),
                "selector": {"type": "python_comment", "value": atom_id},
                "content_hash": hash_text(content),
            }
        )
    return atoms


def javascript_blocks(lines: list[str]) -> list[tuple[int, int, str, str]]:
    blocks: list[tuple[int, int, str, str]] = []
    patterns = [
        (re.compile(r"^\s*(?:export\s+default\s+|export\s+)?class\s+([A-Za-z_$][A-Za-z0-9_$]*)"), "class"),
        (re.compile(r"^\s*(?:export\s+)?(?:async\s+)?function\s+([A-Za-z_$][A-Za-z0-9_$]*)"), "function"),
        (re.compile(r"^\s*(?:export\s+)?(?:const|let|var)\s+([A-Za-z_$][A-Za-z0-9_$]*)\s*=\s*(?:async\s*)?\(?[^=]*\)?\s*=>"), "function"),
    ]
    for i, line in enumerate(lines):
        symbol_type = ""
        name = ""
        for pattern, candidate_type in patterns:
            m = pattern.match(line)
            if m:
                symbol_type = candidate_type
                name = m.group(1)
                break
        if not name:
            continue
        end = len(lines)
        brace_balance = line.count("{") - line.count("}")
        if brace_balance > 0:
            for j in range(i + 1, len(lines)):
                brace_balance += lines[j].count("{") - lines[j].count("}")
                if brace_balance <= 0:
                    end = j + 1
                    break
        else:
            for j in range(i + 1, len(lines)):
                if lines[j].strip() and re.match(r"^\s*(?:export\s+)?(?:class|async\s+function|function|const|let|var)\s+", lines[j]):
                    end = j
                    break
        blocks.append((i, end, symbol_type, name))
    return blocks


