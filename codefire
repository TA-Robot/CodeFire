        payload = {
            "actor": actor_from_args(args),
            "token": token_from_args(args),
        }
        attach_request_signature(payload, args, "apply", remote_request_target(info, "apply", mr_id=args.mr_id))
        response = http_json(
            "POST",
            http_remote_path(info, "merge-requests", args.mr_id, "apply"),
            payload,
        )
        print(f"applied {args.mr_id}")
        print(f"target: {response['target_branch']}@{response['head']}")
        return 0
    info = parse_cf_project_url(args.server_url)
    dirs = remote_dirs(info["project_root"])
    actor = authorize_remote(info["project_root"], "apply", args, target=remote_request_target(info, "apply", mr_id=args.mr_id))
    mr_path = dirs["merge_requests"] / f"{args.mr_id}.json"
    mr = read_json(mr_path)
    if not mr:
        raise CFError(f"merge request not found: {args.mr_id}")
    validate_merge_request_record(mr)
    if mr.get("status") != "approved":
        raise CFError(f"merge request must be approved before apply: {args.mr_id}")
    source = parse_cf_url(mr["source_url"])
    target = parse_cf_url(mr["target_url"])
    source_branch = read_json(remote_branch_path(source["project_root"], source["branch"]))
    target_branch = read_json(remote_branch_path(target["project_root"], target["branch"]))
    if not source_branch:
        raise CFError(f"source remote branch not found: {mr['source_url']}")
    if not target_branch:
        raise CFError(f"target remote branch not found: {mr['target_url']}")
    check_remote_branch_protection(target["project_root"], target["branch"], "apply", actor)
    if target_branch["head"] != mr["target_head_at_request"]:
        mr["status"] = "stale"
        write_json(mr_path, mr)
        raise CFError(f"merge request is stale: {args.mr_id}")
    validate_sealed_commit(remote_dirs(source["project_root"])["objects"], source_branch["head"])
    validate_sealed_commit(remote_dirs(target["project_root"])["objects"], target_branch["head"])
    enforce_remote_commit_signature_policy(target["project_root"], remote_dirs(source["project_root"])["objects"], source_branch["head"])
    if not remote_is_ancestor(source["project_root"], target_branch["head"], source_branch["head"]):
        raise CFError("request apply rejected: source is not a fast-forward of target")
    with file_lock(remote_dirs(target["project_root"])["locks"] / f"branch-{ref_file_name(target['branch'])}.lock"):
        # Re-read under lock to avoid applying over a moved target.
        current_target = read_json(remote_branch_path(target["project_root"], target["branch"]))
        if current_target["head"] != mr["target_head_at_request"]:
            mr["status"] = "stale"
            write_json(mr_path, mr)
            raise CFError(f"merge request is stale: {args.mr_id}")
        generation = next_remote_generation(target["project_root"])
        if source["project_root"] != target["project_root"]:
            copy_object_graph(remote_dirs(source["project_root"])["objects"], remote_dirs(target["project_root"])["objects"], source_branch["head"], generation)
        else:
            copy_object_graph(remote_dirs(source["project_root"])["objects"], remote_dirs(target["project_root"])["objects"], source_branch["head"], generation)
        write_json(
            remote_branch_path(target["project_root"], target["branch"]),
            {
                "version": VERSION,
                "name": target["branch"],
                "head": source_branch["head"],
                "generation": generation,
                "applied_from": mr["source_url"],
                "applied_by": actor,
                "updated_at": now_iso(),
            },
        )
        mr["status"] = "applied"
        mr["applied_at"] = now_iso()
        mr["applied_by"] = actor
        mr["applied_head"] = source_branch["head"]
        write_json(mr_path, mr)
    print(f"applied {args.mr_id}")
    print(f"target: {target['branch']}@{source_branch['head']}")
    return 0


def cmd_gc(args: argparse.Namespace) -> int:
    if is_http_remote_url(args.server_url):
        info = parse_cf_http_project_url(args.server_url)
        payload = {
            "actor": actor_from_args(args),
            "token": token_from_args(args),
            "dry_run": bool(args.dry_run),
        }
        attach_request_signature(payload, args, "gc", remote_request_target(info, "gc"))
        response = http_json(
            "POST",
            http_remote_path(info, "gc"),
            payload,
        )
        for oid in response.get("would_remove", []):
            print(f"would remove {oid}")
        print(f"reachable_objects: {response['reachable_objects']}")
        print(f"objects_protected: {response['objects_protected']}")
        print(f"objects_removed: {response['objects_removed']}")
        print(f"audit_log: {response['audit_log']}")
        return 0
    info = parse_cf_project_url(args.server_url)
    dirs = remote_dirs(info["project_root"])
    if not dirs["project"].exists():
        raise CFError(f"remote project not found: {args.server_url}")
    actor = authorize_remote(info["project_root"], "gc", args, target=remote_request_target(info, "gc"))
    with file_lock(dirs["locks"] / "gc.lock"):
        bad_paths = object_hash_error_paths(dirs["objects"])
        if bad_paths:
            raise CFError(f"gc blocked: object hash errors: {len(bad_paths)}")
        missing_refs = object_graph_missing_references(dirs["objects"], remote_graph_roots(info["project_root"]))
        if missing_refs:
            raise CFError(f"gc blocked: missing object references: {len(missing_refs)}")
        invalid_sealed_refs = sealed_commit_reference_errors(dirs["objects"], remote_sealed_commit_refs(info["project_root"]))
        if invalid_sealed_refs:
            raise CFError(f"gc blocked: invalid sealed commit references: {len(invalid_sealed_refs)}")
        invalid_signatures = remote_commit_signature_errors(info["project_root"], remote_sealed_commit_refs(info["project_root"]))
        if invalid_signatures:
            raise CFError(f"gc blocked: invalid commit signatures: {len(invalid_signatures)}")
        policy = read_json(remote_policy_path(info["project_root"]), {})
        retention_seconds = int(policy.get("gc", {}).get("retention_seconds", 0) or 0)
        retention_generations = int(policy.get("gc", {}).get("retention_generations", 0) or 0)
        current_generation = current_remote_generation(info["project_root"])
        now = time.time()
        reachable = reachable_remote_objects(info["project_root"])
        removed = 0
        protected = 0
        removed_objects: list[dict[str, Any]] = []
        protected_objects: list[dict[str, Any]] = []
        for path in all_remote_object_records(info["project_root"]):
            record = read_json(path)
            oid = record.get("object_id")
            if oid in reachable:
                continue
            item = {
                "object_id": oid,
                "type": record.get("type"),
                "path": path.relative_to(info["project_root"]).as_posix(),
                "last_seen_generation": record.get("remote", {}).get("last_seen_generation") if isinstance(record.get("remote"), dict) else None,
            }
            if retention_seconds > 0 and now - path.stat().st_mtime < retention_seconds:
                protected += 1
                protected_objects.append(item)
                continue
            last_seen = item["last_seen_generation"]
            if retention_generations > 0 and isinstance(last_seen, int) and current_generation - last_seen <= retention_generations:
                protected += 1
                protected_objects.append(item)
                continue
            if args.dry_run:
                print(f"would remove {oid}")
            else:
                path.unlink()
            removed_objects.append(item)
            removed += 1
        audit_entry = {
            "type": "gc_audit",
            "version": VERSION,
            "project": {"org": info["org"], "app": info["app"], "url": remote_project_url(info)},
            "actor": actor,
            "dry_run": bool(args.dry_run),
            "retention_seconds": retention_seconds,
            "retention_generations": retention_generations,
            "current_generation": current_generation,
            "reachable_objects": len(reachable),
            "objects_protected": protected,
            "objects_removed": removed,
            "removed_objects": removed_objects,
            "protected_objects": protected_objects,
            "created_at": now_iso(),
        }
        append_jsonl(dirs["audit"] / "gc.jsonl", audit_entry)
    print(f"reachable_objects: {len(reachable)}")
    print(f"objects_protected: {protected}")
    print(f"objects_removed: {removed}")
    print(f"audit_log: {(dirs['audit'] / 'gc.jsonl').relative_to(info['project_root']).as_posix()}")
    return 0


