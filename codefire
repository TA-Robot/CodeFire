    repo_id = "repo_" + hashlib.sha1(str(repo_root).encode()).hexdigest()[:12]
    write_json(repo_root / ".codefire" / "repo.json", {"version": VERSION, "repository_id": repo_id, "created_at": now_iso()})
    empty_manifest = {"type": "content_manifest", "version": VERSION, "entries": []}
    empty_atom = {"type": "atom_index", "version": VERSION, "atoms": [], "duplicate_atom_ids": []}
    empty_trace = {"type": "trace_graph", "version": VERSION, "links": []}
    verification = {
        "type": "verification",
        "version": VERSION,
        "result": "passed",
        "open_required_fires": 0,
        "failed_checks": [],
        "missing_required_links": [],
        "stale_resolutions": [],
        "duplicate_atom_ids": [],
        "verified_at": now_iso(),
    }
    roots = {
        "content_manifest": store_object(repo_root, "content_manifest", empty_manifest),
        "atom_index": store_object(repo_root, "atom_index", empty_atom),
        "trace_graph": store_object(repo_root, "trace_graph", empty_trace),
        "fire_delta": store_object(repo_root, "fire_ledger", {"type": "fire_ledger", "version": VERSION, "fires": []}),
        "verification": store_object(repo_root, "verification", verification),
        "policy": store_object(repo_root, "policy", {"type": "policy", "version": VERSION, "policy": {}}),
    }
    commit = {
        "type": "commit",
        "version": VERSION,
        "parents": [],
        "message": "Initial empty CodeFire repository",
        "roots": roots,
        "certificate": {
            "result": "consistent",
            "open_required_fires": 0,
            "failed_checks": 0,
            "missing_required_links": 0,
            "stale_resolutions": 0,
            "duplicate_atom_ids": 0,
        },
        "changed_atoms": [],
        "extinguished_fires": [],
        "created_at": now_iso(),
