def go_blocks(lines: list[str]) -> list[tuple[int, int, str, str]]:
    blocks: list[tuple[int, int, str, str]] = []
    type_pattern = re.compile(r"^\s*type\s+([A-Za-z_][A-Za-z0-9_]*)\s+(?:struct|interface)\b")
    function_pattern = re.compile(r"^\s*func\s+([A-Za-z_][A-Za-z0-9_]*)\s*\(")
    method_pattern = re.compile(
        r"^\s*func\s+\(\s*[A-Za-z_][A-Za-z0-9_]*\s+\*?([A-Za-z_][A-Za-z0-9_]*)\s*\)\s+([A-Za-z_][A-Za-z0-9_]*)\s*\("
    )
    for i, line in enumerate(lines):
        symbol_type = ""
        name = ""
        method_match = method_pattern.match(line)
        if method_match:
            symbol_type = "method"
            name = f"{method_match.group(1)}.{method_match.group(2)}"
        else:
            function_match = function_pattern.match(line)
            if function_match:
                symbol_type = "function"
                name = function_match.group(1)
            else:
                type_match = type_pattern.match(line)
                if type_match:
                    symbol_type = "type"
                    name = type_match.group(1)
        if not name:
            continue
        end = len(lines)
        brace_balance = line.count("{") - line.count("}")
        if brace_balance > 0:
            for j in range(i + 1, len(lines)):
                brace_balance += lines[j].count("{") - lines[j].count("}")
                if brace_balance <= 0:
                    end = j + 1
                    break
        else:
            for j in range(i + 1, len(lines)):
                if lines[j].strip() and re.match(r"^\s*(?:type|func)\s+", lines[j]):
                    end = j
                    break
        blocks.append((i, end, symbol_type, name))
    return blocks


