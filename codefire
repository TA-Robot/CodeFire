class TraceEvaluationIndex:
    def __init__(
        self,
        atoms: tuple[tuple[str, str], ...],
        atom_kinds: dict[str, str],
        adjacency: dict[str, tuple[str, ...]],
        required_counts: dict[tuple[str, str, str], int],
        ledger: DecisionWorkLedger,
        retained_bytes: int,
    ) -> None:
        self._atoms = atoms
        self._atom_kinds = MappingProxyType(atom_kinds)
        self._adjacency = MappingProxyType(adjacency)
        self._required_counts = MappingProxyType(required_counts)
        self._ledger = ledger
        self._retained_bytes = retained_bytes
        self._closed = False

    def _ensure_open(self) -> None:
        if self._closed:
            raise CFError("trace evaluation index is closed")

    @property
    def atoms(self) -> tuple[tuple[str, str], ...]:
        self._ensure_open()
        return self._atoms

    @property
    def atom_kinds(self) -> MappingProxyType:
        self._ensure_open()
        return self._atom_kinds

    @property
    def adjacency(self) -> MappingProxyType:
        self._ensure_open()
        return self._adjacency

    @property
    def required_counts(self) -> MappingProxyType:
        self._ensure_open()
        return self._required_counts

    @property
    def ledger(self) -> DecisionWorkLedger:
        self._ensure_open()
        return self._ledger

    @property
    def retained_bytes(self) -> int:
        return self._retained_bytes

    def adopt_accounted_retained(self, amount: int) -> None:
        self._ensure_open()
        self._retained_bytes += amount

    def acquire_owned_retained(self, amount: int, phase: str = "query") -> None:
        self._ensure_open()
        self._ledger.acquire("retained_bytes", amount, phase)
        self._retained_bytes += amount

    @property
    def closed(self) -> bool:
        return self._closed

    def close(self) -> None:
        if self._closed:
            return
        retained_bytes = self._retained_bytes
        self._atoms = ()
        self._atom_kinds = MappingProxyType({})
        self._adjacency = MappingProxyType({})
        self._required_counts = MappingProxyType({})
        self._retained_bytes = 0
        self._closed = True
        self._ledger.release("retained_bytes", retained_bytes)

    def __del__(self) -> None:
        try:
            self.close()
        except Exception:
            pass


class AccountedAdjacentAtoms(list):
    def __init__(
        self,
        ledger: DecisionWorkLedger,
        retained_bytes: int,
    ) -> None:
        super().__init__()
        self._ledger = ledger
        self._retained_bytes = retained_bytes
        self._closed = False

    @property
    def ledger(self) -> DecisionWorkLedger:
        return self._ledger

    @property
    def retained_bytes(self) -> int:
        return self._retained_bytes

    @property
    def closed(self) -> bool:
        return self._closed

    def _ensure_open(self) -> None:
        if self._closed:
            raise CFError("adjacent atom result is closed")

    def __iter__(self):
        self._ensure_open()
        return super().__iter__()

    def __len__(self) -> int:
        self._ensure_open()
        return super().__len__()

    def __getitem__(self, index: Any) -> Any:
        self._ensure_open()
        return super().__getitem__(index)

    def close(self) -> None:
        if self._closed:
            return
        retained_bytes = self._retained_bytes
        list.clear(self)
        self._retained_bytes = 0
        self._closed = True
        self._ledger.release("retained_bytes", retained_bytes)

    def __del__(self) -> None:
        try:
            self.close()
        except Exception:
            pass


def compile_trace_evaluation_index(
    atom_index: dict[str, Any],
    trace_graph: dict[str, Any],
    ledger: DecisionWorkLedger,
) -> TraceEvaluationIndex:
    """Build the direct-only Trace index once while preserving Link order."""
    temporary_bytes = 4 * (
        canonical_json_size(atom_index) + canonical_json_size(trace_graph)
    ) + 4096
    ledger.acquire("temporary_bytes", temporary_bytes, "graph_discovery")
    atoms: list[tuple[str, str]] = []
    atom_kinds: dict[str, str] = {}
    adjacency: dict[str, list[str]] = {}
    required_counts: dict[tuple[str, str, str], int] = {}
    retained_permit: DecisionWorkPermit | None = None
    retained_acquired = 0
    retained_value: dict[str, Any] | None = None
    try:
        for atom in atom_index.get("atoms", []):
            ledger.apply(
                "graph_discovery",
                charges={"graph_nodes": 1},
                counters={"atoms_indexed": 1},
            )
            atom_id = str(atom["atom_id"])
            atom_kind = str(atom["kind"])
            atoms.append((atom_id, atom_kind))
            atom_kinds[atom_id] = atom_kind

        for link in trace_graph.get("links", []):
            ledger.apply(
                "graph_discovery",
                charges={"graph_edges": 1},
                counters={"trace_links_indexed": 1},
            )
            source = str(link["from"])
            target = str(link["to"])
            link_type = str(link["type"])
            adjacency.setdefault(source, []).append(target)
            if target != source:
                adjacency.setdefault(target, []).append(source)
            target_kind = atom_kinds.get(target)
            if target_kind is not None:
                key = (source, link_type, target_kind)
                required_counts[key] = required_counts.get(key, 0) + 1
        frozen_adjacency = {key: tuple(values) for key, values in adjacency.items()}
        adjacency.clear()
        frozen_atoms = tuple(atoms)
        atoms.clear()
        retained_value = {
            "atoms": frozen_atoms,
            "adjacency": frozen_adjacency,
            "required_counts": [
                [*key, value] for key, value in sorted(required_counts.items())
            ],
        }
        retained_bytes = canonical_json_size(retained_value)
        retained_permit = ledger.reserve(
            "graph_discovery", acquires={"retained_bytes": retained_bytes}
        )
        ledger.consume_reserved(
            retained_permit,
            phase="graph_discovery",
            acquires={"retained_bytes": retained_bytes},
        )
        retained_permit = None
        retained_acquired = retained_bytes
        result = TraceEvaluationIndex(
            frozen_atoms,
            atom_kinds,
            frozen_adjacency,
            required_counts,
            ledger,
            retained_bytes,
        )
        retained_value.clear()
        ledger.release("temporary_bytes", temporary_bytes)
        return result
    except Exception:
        if retained_value is not None:
            retained_value.clear()
        atoms.clear()
        atom_kinds.clear()
        adjacency.clear()
        required_counts.clear()
        if retained_permit is not None:
            ledger.cancel_permit(retained_permit)
        if retained_acquired:
            ledger.release("retained_bytes", retained_acquired)
        ledger.release("temporary_bytes", temporary_bytes)
        raise


def required_link_missing(
    atom_index: dict[str, Any],
    trace_graph: dict[str, Any],
    required_links: dict[str, list[dict[str, Any]]],
    ledger: DecisionWorkLedger | None = None,
    trace_index: TraceEvaluationIndex | None = None,
) -> list[dict[str, Any]]:
    owns_ledger = ledger is None
    if ledger is None:
        ledger = DecisionWorkLedger(
            DecisionWorkProfile.local_v1(), "required-link evaluation"
        )
    owns_index = trace_index is None
    if trace_index is None:
        trace_index = compile_trace_evaluation_index(atom_index, trace_graph, ledger)
    missing: list[dict[str, Any]] = []
    try:
        for atom_id, atom_kind in trace_index.atoms:
            for rule in required_links.get(atom_kind, []):
                ledger.count("rules_evaluated", 1, "query")
                link_type = rule["type"]
                target_kind = rule["target_kind"]
                min_count = int(rule.get("min", 1) or 1)
                count = trace_index.required_counts.get(
                    (atom_id, link_type, target_kind), 0
                )
                if count < min_count:
                    missing.append({"atom_id": atom_id, "required_type": link_type, "target_kind": target_kind, "min": min_count, "found": count})
    finally:
        if owns_index:
            trace_index.close()
    if owns_ledger:
        ledger.terminate("complete")
    return missing


