def cmd_open(args: argparse.Namespace) -> int:
    repo_root = find_repo_root(Path.cwd())
    with file_lock(repo_dirs(repo_root)["locks"] / "repo.lock"):
        branch = load_branch(repo_root, args.branch)
        validate_sealed_commit(repo_dirs(repo_root)["objects"], branch["head"])
        target = Path(args.path).resolve()
        if target.exists() and not is_empty_dir(target):
            raise CFError(f"target path must not exist or must be empty: {target}")
        if opened_registry_path(repo_root, args.branch).exists():
            raise CFError(f"branch is already open: {args.branch}")
        target.mkdir(parents=True, exist_ok=True)
        materialize_commit(repo_root, branch["head"], target)
        open_instance_id = "open_" + hashlib.sha1(f"{args.branch}:{target}:{time.time()}".encode()).hexdigest()[:12]
        identity = {
            "version": VERSION,
            "repository": {"path": str((repo_root / ".codefire").resolve()), "repository_id": read_json(repo_root / ".codefire" / "repo.json")["repository_id"]},
            "branch": {"name": args.branch, "opened_from_commit": branch["head"]},
            "open": {"open_instance_id": open_instance_id, "opened_path": str(target), "opened_at": now_iso()},
        }
        write_json(target / ".codefire-open", identity)
        registry = {
            "version": VERSION,
            "branch": {"name": args.branch},
            "open": {
                "open_instance_id": open_instance_id,
                "path": str(target),
                "opened_from_commit": branch["head"],
                "current_base_commit": branch["head"],
                "active_state_path": str(active_dir(repo_root, open_instance_id)),
            },
            "state": {"last_known": "open-clean"},
        }
        write_json(opened_registry_path(repo_root, args.branch), registry)
        active_dir(repo_root, open_instance_id).mkdir(parents=True, exist_ok=True)
        write_json(active_dir(repo_root, open_instance_id) / "state.json", {"state": "open-clean"})
        branch["state"] = "open-clean"
        save_branch(repo_root, branch)
    print(f"opened {args.branch}: {target}")
    return 0


def cmd_close(args: argparse.Namespace) -> int:
    repo_root = find_repo_root(Path.cwd())
    with file_lock(repo_dirs(repo_root)["locks"] / "repo.lock"):
        registry_path = opened_registry_path(repo_root, args.branch)
        registry = read_json(registry_path)
        if not registry:
            raise CFError(f"branch is not open: {args.branch}")
        state = registry["state"]["last_known"]
        if state != "open-clean" and not args.discard:
            raise CFError(f"branch is {state}; use --discard to close and delete uncommitted work")
        path = Path(registry["open"]["path"])
        if path.exists():
            shutil.rmtree(path)
        registry_path.unlink()
        shutil.rmtree(active_dir(repo_root, registry["open"]["open_instance_id"]), ignore_errors=True)
        branch = load_branch(repo_root, args.branch)
        branch["state"] = "closed"
        save_branch(repo_root, branch)
    print(f"closed {args.branch}")
    return 0


def cmd_discard(args: argparse.Namespace) -> int:
    args.discard = True
    return cmd_close(args)


def cmd_clone(args: argparse.Namespace) -> int:
    repo_root = find_repo_root(Path.cwd())
    with file_lock(repo_dirs(repo_root)["locks"] / "repo.lock"):
        if is_http_remote_url(args.source):
            info = parse_cf_http_url(args.source)
            bundle = http_json("GET", http_remote_path(info, "branches", info["branch"], "bundle"))
            branch_record = bundle.get("branch")
            records = bundle.get("objects")
            if not isinstance(branch_record, dict) or not isinstance(records, list):
                raise CFError("HTTP remote returned an invalid branch bundle")
            if branch_path(repo_root, args.new_branch).exists():
                raise CFError(f"branch already exists: {args.new_branch}")
            ensure_repo_layout(repo_root)
            write_object_records(repo_dirs(repo_root)["objects"], records)
            validate_sealed_commit(repo_dirs(repo_root)["objects"], branch_record["head"])
            branch = {
                "type": "branch",
                "version": VERSION,
                "name": args.new_branch,
                "head": branch_record["head"],
                "state": "closed",
                "created_from": args.source,
                "created_at": now_iso(),
            }
            save_branch(repo_root, branch)
            print(f"cloned {args.source} -> {args.new_branch}")
            return 0
        if args.source.startswith("cf://"):
            info = parse_cf_url(args.source)
            project_root = info["project_root"]
            with remote_project_gate(project_root, shared=True):
                branch_record = read_remote_branch_record(project_root, info["branch"])
                if not branch_record:
                    raise CFError(f"remote branch not found: {args.source}")
                validate_sealed_commit(remote_dirs(project_root)["objects"], branch_record["head"])
                if branch_path(repo_root, args.new_branch).exists():
                    raise CFError(f"branch already exists: {args.new_branch}")
                ensure_repo_layout(repo_root)
                copy_object_graph(remote_dirs(project_root)["objects"], repo_dirs(repo_root)["objects"], branch_record["head"])
            branch = {
                "type": "branch",
                "version": VERSION,
                "name": args.new_branch,
                "head": branch_record["head"],
                "state": "closed",
                "created_from": args.source,
                "created_at": now_iso(),
            }
            save_branch(repo_root, branch)
            print(f"cloned {args.source} -> {args.new_branch}")
            return 0
        source = load_branch(repo_root, args.source)
        require_source_branch_sealed(repo_root, args.source, "clone")
        validate_sealed_commit(repo_dirs(repo_root)["objects"], source["head"])
        if branch_path(repo_root, args.new_branch).exists():
            raise CFError(f"branch already exists: {args.new_branch}")
        branch = {
            "type": "branch",
            "version": VERSION,
            "name": args.new_branch,
            "head": source["head"],
            "state": "closed",
            "created_from": args.source,
            "created_at": now_iso(),
        }
        save_branch(repo_root, branch)
    print(f"cloned {args.source} -> {args.new_branch}")
    return 0


def cmd_upload(args: argparse.Namespace) -> int:
    repo_root = find_repo_root(Path.cwd())
    branch = load_branch(repo_root, args.branch)
    validate_sealed_commit(repo_dirs(repo_root)["objects"], branch["head"])
    registry = read_json(opened_registry_path(repo_root, args.branch))
    if registry and registry["state"]["last_known"] != "open-clean":
        raise CFError(f"branch is {registry['state']['last_known']}; commit or discard before upload")
    if is_http_remote_url(args.remote_url):
        info = parse_cf_http_url(args.remote_url)
        actor = actor_from_args(args)
        payload = {
            "branch": args.branch,
            "head": branch["head"],
            "objects": collect_object_records(repo_dirs(repo_root)["objects"], branch["head"]),
            "actor": actor,
            "token": token_from_args(args),
            "idempotency_key": args.idempotency_key,
        }
        attach_request_signature(payload, args, "upload", remote_request_target(info, "upload", branch=info["branch"]))
        response = http_json("POST", http_remote_path(info, "branches", info["branch"], "upload"), payload)
        print(f"uploaded {args.branch}@{response.get('head', branch['head'])} -> {args.remote_url}")
        return 0
    info = parse_cf_url(args.remote_url)
    if info["branch"] != args.branch:
        # Uploading under a different remote branch name is useful, but make it explicit in output.
        remote_branch = info["branch"]
    else:
        remote_branch = args.branch
    actor = actor_from_args(args)
    request_payload = {
        "branch": args.branch,
        "head": branch["head"],
        "objects": collect_object_records(repo_dirs(repo_root)["objects"], branch["head"]),
        "actor": actor,
        "token": token_from_args(args),
        "idempotency_key": args.idempotency_key,
    }
    actor = authorize_remote(
        info["project_root"],
        "upload",
        args,
        target=remote_request_target(info, "upload", branch=remote_branch),
        payload=request_payload,
    )
    ensure_remote_layout(info["project_root"])
    check_remote_branch_protection(info["project_root"], remote_branch, "upload", actor)
    dirs = remote_dirs(info["project_root"])
    with remote_project_gate(info["project_root"]):
        enforce_remote_commit_signature_policy(
            info["project_root"],
            repo_dirs(repo_root)["objects"],
            branch["head"],
        )
        run_server_verification(info["project_root"], remote_branch, branch["head"])
        copy_object_graph(
            repo_dirs(repo_root)["objects"], dirs["objects"], branch["head"]
        )
        object_records = collect_object_records(
            repo_dirs(repo_root)["objects"], branch["head"]
        )
        semantic = {
            "stable_project_id": remote_project_stable_id(info["project_root"]),
            "remote_branch": remote_branch,
            "local_branch": args.branch,
            "head": branch["head"],
            "object_set_digest": merge_request_object_set_digest(object_records),
        }
        result = {"branch": remote_branch, "head": branch["head"]}
        if remote_publication_recovery_exists(
            info["project_root"], "remote_upload", actor, args.idempotency_key
        ):
            generation_current = read_json(remote_generation_path(info["project_root"]))
            branch_current = read_remote_branch_record(
                info["project_root"], remote_branch
            )
            execute_remote_json_publication(
                info["project_root"],
                "remote_upload",
                actor,
                semantic,
                [
                    (
                        {"kind": "generation"},
                        generation_current,
                        generation_current,
                    ),
                    (
                        {"kind": "branch", "name": remote_branch},
                        branch_current,
                        branch_current,
                    ),
                ],
                result,
                idempotency_key=args.idempotency_key,
                object_roots=[branch["head"]],
            )
            print(f"uploaded {args.branch}@{branch['head']} -> {args.remote_url}")
            return 0
        current = read_remote_branch_record(info["project_root"], remote_branch)
        if current and not is_ancestor(repo_root, current["head"], branch["head"]):
            raise CFError("upload rejected: remote branch is not an ancestor of local branch head")
        generation_before = read_json(remote_generation_path(info["project_root"]))
        generation = (
            generation_before.get("current_generation", 0)
            if isinstance(generation_before, dict)
            else 0
        ) + 1
        branch_after = {
            "version": VERSION,
            "name": remote_branch,
            "head": branch["head"],
            "generation": generation,
            "uploaded_from": args.branch,
            "uploaded_by": actor,
            "updated_at": now_iso(),
        }
        execute_remote_json_publication(
            info["project_root"],
            "remote_upload",
            actor,
            semantic,
            [
                (
                    {"kind": "generation"},
                    generation_before,
                    {"current_generation": generation},
                ),
                (
                    {"kind": "branch", "name": remote_branch},
                    current,
                    branch_after,
                ),
            ],
            result,
            idempotency_key=args.idempotency_key,
            object_roots=[branch["head"]],
        )
    print(f"uploaded {args.branch}@{branch['head']} -> {args.remote_url}")
    return 0


def cmd_list(args: argparse.Namespace) -> int:
    if is_http_remote_url(args.server_url):
        info = parse_cf_http_project_url(args.server_url)
        response = http_json("GET", http_remote_path(info, "branches"))
        branches = response.get("branches")
        if not isinstance(branches, list):
            raise CFError("HTTP remote returned an invalid branch list")
        for branch in branches:
            validate_remote_branch_record(branch)
            print(f"{branch['name']}\t{branch['head']}")
        return 0
    info = parse_cf_project_url(args.server_url)
    dirs = remote_dirs(info["project_root"])
    branches_dir = dirs["branches"]
    if not branches_dir.exists():
        raise CFError(f"remote project not found: {args.server_url}")
    with remote_project_gate(info["project_root"], shared=True):
        ledger = DecisionWorkLedger(
            DecisionWorkProfile.local_v1(), "remote branch list"
        )
        session = SealedCommitValidationSession(dirs["objects"], ledger)
        branch_paths: list[Path] = []
        branch_retained = 0
        branches: list[dict[str, Any]] = []
        try:
            branch_paths, branch_retained = accounted_sorted_json_paths(
                branches_dir, ledger
            )
            for path in branch_paths:
                branch, retained = read_json_accounted(path, ledger)
                branch_retained += retained
                branches.append(validate_remote_branch_record(branch))
            for branch in branches:
                session.validate_commit(branch["head"])
            session.finalize(terminate=False)
            for branch in branches:
                print(f"{branch['name']}\t{branch['head']}")
            branch_paths.clear()
            branches.clear()
            ledger.release("retained_bytes", branch_retained)
            branch_retained = 0
            ledger.terminate("complete")
        finally:
            branch_paths.clear()
            branches.clear()
            if branch_retained:
                ledger.release("retained_bytes", branch_retained)
            session.close(None)
    return 0


def cmd_request_merge(args: argparse.Namespace) -> int:
    if is_http_remote_url(args.source_url) and is_http_remote_url(args.target_url):
        target = parse_cf_http_url(args.target_url)
        actor = actor_from_args(args)
        payload = {
            "source_url": args.source_url,
            "target_url": args.target_url,
            "actor": actor,
            "token": token_from_args(args),
            "idempotency_key": args.idempotency_key,
        }
        attach_request_signature(payload, args, "request_merge", remote_request_target(target, "request_merge"))
        response = http_json("POST", http_remote_path(target, "merge-requests"), payload)
        print(f"created {response['id']}")
        print(f"source: {response['source_head']}")
        print(f"target: {response['target_head']}")
        return 0
    if is_http_remote_url(args.source_url) or is_http_remote_url(args.target_url):
        raise CFError("request-merge requires both URLs to use the same remote transport")
    source = parse_cf_url(args.source_url)
    target = parse_cf_url(args.target_url)
    source_branch = read_remote_branch_record(source["project_root"], source["branch"])
    target_branch = read_remote_branch_record(target["project_root"], target["branch"])
    if not source_branch:
        raise CFError(f"source remote branch not found: {args.source_url}")
    if not target_branch:
        raise CFError(f"target remote branch not found: {args.target_url}")
    validate_sealed_commit(remote_dirs(source["project_root"])["objects"], source_branch["head"])
    validate_sealed_commit(remote_dirs(target["project_root"])["objects"], target_branch["head"])
    source_records = collect_object_records(
        remote_dirs(source["project_root"])["objects"], source_branch["head"]
    )
    object_set_digest = merge_request_object_set_digest(source_records)
    actor = actor_from_args(args)
    request_payload = {
        "source_url": args.source_url,
        "target_url": args.target_url,
        "actor": actor,
        "token": token_from_args(args),
        "idempotency_key": args.idempotency_key,
    }
    actor = authorize_remote(
        target["project_root"],
        "request_merge",
        args,
        target=remote_request_target(target, "request_merge"),
        payload=request_payload,
    )
    ensure_remote_layout(target["project_root"])
    dirs = remote_dirs(target["project_root"])
    mr_payload = {
        "version": VERSION,
        "source_url": args.source_url,
        "source_head": source_branch["head"],
        "target_url": args.target_url,
        "target_head_at_request": target_branch["head"],
        "status": "open",
        "created_by": actor,
        "created_at": now_iso(),
    }
    mr_id = "MR-" + hashlib.sha256(canonical_json(mr_payload)).hexdigest()[:12]
    mr_payload["id"] = mr_id
    subject = build_merge_request_subject(
        mr_id,
        source,
        target,
        source_branch["head"],
        target_branch["head"],
        object_set_digest,
    )
    mr_payload["subject"] = subject
    mr_payload["subject_digest"] = merge_request_subject_digest(subject)
    with ordered_remote_merge_gates(source["project_root"], target["project_root"]):
        locked_source = read_remote_branch_record(source["project_root"], source["branch"])
        locked_target = read_remote_branch_record(target["project_root"], target["branch"])
        if (
            not locked_source
            or not locked_target
            or locked_source["head"] != source_branch["head"]
            or locked_target["head"] != target_branch["head"]
        ):
            raise CFError("request-merge source or target changed while acquiring project gate")
        copy_object_graph(
            remote_dirs(source["project_root"])["objects"],
            remote_dirs(target["project_root"])["objects"],
            source_branch["head"],
        )
        execute_remote_json_publication(
            target["project_root"],
            "remote_request_merge",
            actor,
            {
                "source_project_id": remote_project_stable_id(source["project_root"]),
                "target_project_id": remote_project_stable_id(target["project_root"]),
                "source_branch": source["branch"],
                "target_branch": target["branch"],
                "source_head": source_branch["head"],
                "target_head_at_request": target_branch["head"],
                "source_object_set_digest": object_set_digest,
            },
            [
                (
                    {"kind": "merge_request", "id": mr_id},
                    None,
                    mr_payload,
                )
            ],
            {
                "id": mr_id,
                "source_head": source_branch["head"],
                "target_head": target_branch["head"],
            },
            idempotency_key=args.idempotency_key,
            object_roots=[source_branch["head"]],
        )
    print(f"created {mr_id}")
    print(f"source: {source_branch['head']}")
    print(f"target: {target_branch['head']}")
    return 0


def cmd_request_list(args: argparse.Namespace) -> int:
    if is_http_remote_url(args.server_url):
        info = parse_cf_http_project_url(args.server_url)
        response = http_json("GET", http_remote_path(info, "merge-requests"))
        requests = response.get("merge_requests")
        if not isinstance(requests, list):
            raise CFError("HTTP remote returned an invalid merge request list")
        for mr in requests:
            print(f"{mr['id']}\t{mr['status']}\t{mr['source_url']}\t{mr['target_url']}")
        return 0
    info = parse_cf_project_url(args.server_url)
    dirs = remote_dirs(info["project_root"])
    if not dirs["merge_requests"].exists():
        raise CFError(f"remote project not found: {args.server_url}")
    with remote_project_gate(info["project_root"], shared=True):
        for path in sorted(dirs["merge_requests"].glob("*.json")):
            mr = read_remote_merge_request_path(path)
            source = parse_cf_url(mr["source_url"])
            target = parse_cf_url(mr["target_url"])
            if target["project_root"] != info["project_root"]:
                raise CFError(
                    "merge request target does not belong to the listed project"
                )
            reject_legacy_cross_project_merge_request_read(
                mr, source["project_root"], target["project_root"]
            )
            validate_merge_request_record(mr)
            current_target = read_remote_branch_record(target["project_root"], target["branch"])
            if current_target:
                validate_sealed_commit(remote_dirs(target["project_root"])["objects"], current_target["head"])
            status = mr.get("status", "open")
            if current_target and current_target["head"] != mr["target_head_at_request"]:
                status = "stale"
            print(f"{mr['id']}\t{status}\t{mr['source_url']}\t{mr['target_url']}")
    return 0


def cmd_request_review(args: argparse.Namespace) -> int:
    validate_remote_component(args.mr_id, "merge-request ID")
    if is_http_remote_url(args.server_url):
        info = parse_cf_http_project_url(args.server_url)
        payload = {
            "reviewer": args.reviewer,
            "decision": args.decision,
            "comment": args.comment,
            "actor": actor_from_args(args),
            "token": token_from_args(args),
            "idempotency_key": args.idempotency_key,
        }
        attach_request_signature(payload, args, "review", remote_request_target(info, "review", mr_id=args.mr_id))
        response = http_json(
            "POST",
            http_remote_path(info, "merge-requests", args.mr_id, "review"),
            payload,
        )
        print(f"{response['decision']}d {args.mr_id} by {response['reviewer']}")
        return 0
    info = parse_cf_project_url(args.server_url)
    dirs = remote_dirs(info["project_root"])
    actor = actor_from_args(args)
    request_payload = {
        "reviewer": args.reviewer,
        "decision": args.decision,
        "comment": args.comment,
        "actor": actor,
        "token": token_from_args(args),
        "idempotency_key": args.idempotency_key,
    }
    actor = authorize_remote(
        info["project_root"],
        "review",
        args,
        target=remote_request_target(info, "review", mr_id=args.mr_id),
        payload=request_payload,
    )
    mr_path = remote_merge_request_path(info["project_root"], args.mr_id)
    mr = read_remote_merge_request_path(mr_path)
    if not mr:
        raise CFError(f"merge request not found: {args.mr_id}")
    initial_source_url = mr.get("source_url")
    initial_target_url = mr.get("target_url")
    target = parse_cf_url(mr["target_url"])
    source = parse_cf_url(mr["source_url"])
    if target["project_root"] != info["project_root"]:
        raise CFError("merge request target does not belong to the reviewed project")
    review_gate = (
        remote_project_gate(target["project_root"])
        if "subject" in mr
        else ordered_remote_merge_gates(source["project_root"], target["project_root"])
    )
    with review_gate:
        mr = read_remote_merge_request_path(mr_path)
        if not mr:
            raise CFError(f"merge request not found: {args.mr_id}")
        if (
            mr.get("source_url") != initial_source_url
            or mr.get("target_url") != initial_target_url
        ):
            raise CFError(
                "merge request endpoints changed while acquiring project gates"
            )
        validate_merge_request_record(mr)
        target = parse_cf_url(mr["target_url"])
        current_target = read_remote_branch_record(target["project_root"], target["branch"])
        subject_is_materialized = "subject" in mr
        if (
            not subject_is_materialized
            and current_target
            and current_target["head"] != mr["target_head_at_request"]
        ):
            raise CFError(f"merge request is stale: {args.mr_id}")
        mr_before = dict(mr)
        subject_digest = materialize_merge_request_subject(mr, source, target)
        comment = args.comment if isinstance(args.comment, str) else ""
        review = {
            "reviewer": args.reviewer,
            "decision": args.decision,
            "comment": comment,
            "subject_digest": subject_digest,
            "reviewed_at": now_iso(),
        }
        reviews = list(mr.get("reviews", []))
        reviews.append(review)
        mr["reviews"] = reviews
        if args.decision == "approve":
            mr["status"] = "approved"
        elif args.decision == "reject":
            mr["status"] = "rejected"
        semantic = {
            "stable_project_id": remote_project_stable_id(target["project_root"]),
            "merge_request_id": args.mr_id,
            "reviewer": args.reviewer,
            "decision": args.decision,
            "comment": comment,
            "subject_digest": subject_digest,
        }
        writes = [
            (
                {"kind": "merge_request", "id": args.mr_id},
                mr_before,
                mr,
            )
        ]
        result = {
            "id": args.mr_id,
            "reviewer": args.reviewer,
            "decision": args.decision,
        }
        if remote_publication_recovery_exists(
            target["project_root"],
            "remote_request_review",
            actor,
            args.idempotency_key,
        ):
            execute_remote_json_publication(
                target["project_root"],
                "remote_request_review",
                actor,
                semantic,
                writes,
                result,
                idempotency_key=args.idempotency_key,
                object_roots=[str(mr["source_head"])],
            )
        else:
            if (
                subject_is_materialized
                and current_target
                and current_target["head"] != mr["target_head_at_request"]
            ):
                raise CFError(f"merge request is stale: {args.mr_id}")
            execute_remote_json_publication(
                target["project_root"],
                "remote_request_review",
                actor,
                semantic,
                writes,
                result,
                idempotency_key=args.idempotency_key,
                object_roots=[str(mr["source_head"])],
            )
    print(f"{args.decision}d {args.mr_id} by {args.reviewer}")
    return 0


