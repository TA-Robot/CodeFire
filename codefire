def find_matching_paren(text: str, open_index: int) -> int:
    depth = 0
    quote = ""
    i = open_index
    while i < len(text):
        ch = text[i]
        if quote:
            if ch == quote:
                quote = ""
            elif ch == "\\":
                i += 1
        elif ch in {"'", '"', "`"}:
            quote = ch
        elif ch == "[":
            quote = "]"
        elif ch == "(":
            depth += 1
        elif ch == ")":
            depth -= 1
            if depth == 0:
                return i
        i += 1
    return -1


def split_sql_top_level_commas(text: str) -> list[str]:
    parts: list[str] = []
    start = 0
    depth = 0
    quote = ""
    i = 0
    while i < len(text):
        ch = text[i]
        if quote:
            if ch == quote:
                quote = ""
            elif ch == "\\":
                i += 1
        elif ch in {"'", '"', "`"}:
            quote = ch
        elif ch == "[":
            quote = "]"
        elif ch == "(":
            depth += 1
        elif ch == ")":
            depth = max(0, depth - 1)
        elif ch == "," and depth == 0:
            parts.append(text[start:i].strip())
            start = i + 1
        i += 1
    final = text[start:].strip()
    if final:
        parts.append(final)
    return parts


def sql_column_name(definition: str) -> str | None:
    stripped = definition.strip()
    if not stripped:
        return None
    keyword = stripped.split(None, 1)[0].strip('"`[]').upper()
    if keyword in {"CONSTRAINT", "PRIMARY", "FOREIGN", "UNIQUE", "CHECK", "EXCLUDE", "KEY"}:
        return None
    m = re.match(r'\s*("[^"]+"|`[^`]+`|\[[^\]]+\]|[A-Za-z_][A-Za-z0-9_$]*)', stripped)
    if not m:
        return None
    return m.group(1).strip('"`[]')


def strip_sql_identifier(value: str) -> str:
    return value.strip().strip('"`[]')


def find_sql_statement_end(text: str, start: int) -> int:
    quote = ""
    i = start
    while i < len(text):
        ch = text[i]
        if quote:
            if quote.startswith("$"):
                if text.startswith(quote, i):
                    i += len(quote) - 1
                    quote = ""
            elif ch == quote:
                quote = ""
            elif ch == "\\":
                i += 1
        elif ch in {"'", '"', "`"}:
            quote = ch
        elif ch == "[":
            quote = "]"
        elif ch == "$":
            dollar_quote = re.match(r"\$[A-Za-z_][A-Za-z0-9_]*\$|\$\$", text[i:])
            if dollar_quote:
                quote = dollar_quote.group(0)
                i += len(quote) - 1
        elif ch == ";":
            return i + 1
        i += 1
    return len(text)


def find_sql_trigger_statement_end(text: str, start: int) -> int:
    first_end = find_sql_statement_end(text, start)
    first_statement = text[start:first_end]
    if not re.search(r"\bBEGIN\b", first_statement, re.IGNORECASE):
        return first_end
    match = re.search(r"\bEND\s*;", text[start:], re.IGNORECASE)
    if match:
        return start + match.end()
    return first_end


def extract_db_schema_atoms(path: Path, rel: Path) -> list[dict[str, Any]]:
    text = read_text_lossy(path)
    table_pattern = re.compile(
        r"\bCREATE\s+TABLE\s+(?:IF\s+NOT\s+EXISTS\s+)?([A-Za-z_][A-Za-z0-9_.$]*|\"[^\"]+\"|`[^`]+`|\[[^\]]+\])\s*\(",
        re.IGNORECASE,
    )
    atoms: list[dict[str, Any]] = []
    for match in table_pattern.finditer(text):
        table_name = strip_sql_identifier(match.group(1))
        close_paren = find_matching_paren(text, match.end() - 1)
        semicolon = text.find(";", close_paren if close_paren != -1 else match.end())
        if semicolon == -1:
            end = len(text)
        else:
            end = semicolon + 1
        content = text[match.start() : end].strip() + "\n"
        atom_id = db_atom_id(table_name)
        atoms.append(
            {
                "atom_id": atom_id,
                "kind": "db",
                "artifact_path": rel.as_posix(),
                "selector": {"type": "sql_table", "value": table_name},
                "content_hash": hash_text(content),
            }
        )
        if close_paren == -1:
            continue
        columns_block = text[match.end() : close_paren]
        for definition in split_sql_top_level_commas(columns_block):
            column_name = sql_column_name(definition)
            if not column_name:
                continue
            column_atom_id = db_column_atom_id(table_name, column_name)
            atoms.append(
                {
                    "atom_id": column_atom_id,
                    "kind": "db",
                    "artifact_path": rel.as_posix(),
                    "selector": {"type": "sql_column", "table": table_name, "column": column_name},
                    "content_hash": hash_text(definition.strip() + "\n"),
                }
            )
    index_pattern = re.compile(
        r"\bCREATE\s+(UNIQUE\s+)?INDEX\s+(?:IF\s+NOT\s+EXISTS\s+)?([A-Za-z_][A-Za-z0-9_.$]*|\"[^\"]+\"|`[^`]+`|\[[^\]]+\])\s+ON\s+([A-Za-z_][A-Za-z0-9_.$]*|\"[^\"]+\"|`[^`]+`|\[[^\]]+\])\s*\(",
        re.IGNORECASE,
    )
    for match in index_pattern.finditer(text):
        index_name = strip_sql_identifier(match.group(2))
        table_name = strip_sql_identifier(match.group(3))
        close_paren = find_matching_paren(text, match.end() - 1)
        semicolon = text.find(";", close_paren if close_paren != -1 else match.end())
        if semicolon == -1:
            end = len(text)
        else:
            end = semicolon + 1
        content = text[match.start() : end].strip() + "\n"
        atom_id = db_index_atom_id(index_name)
        atoms.append(
            {
                "atom_id": atom_id,
                "kind": "db",
                "artifact_path": rel.as_posix(),
                "selector": {
                    "type": "sql_index",
                    "value": index_name,
                    "table": table_name,
                    "unique": bool(match.group(1)),
                },
                "content_hash": hash_text(content),
            }
        )
    view_pattern = re.compile(
        r"\bCREATE\s+(?:OR\s+REPLACE\s+)?(?:TEMP(?:ORARY)?\s+)?VIEW\s+(?:IF\s+NOT\s+EXISTS\s+)?([A-Za-z_][A-Za-z0-9_.$]*|\"[^\"]+\"|`[^`]+`|\[[^\]]+\])(?:\s*\([^;]*?\))?\s+AS\b",
        re.IGNORECASE,
    )
    for match in view_pattern.finditer(text):
        view_name = strip_sql_identifier(match.group(1))
        end = find_sql_statement_end(text, match.end())
        content = text[match.start() : end].strip() + "\n"
        atom_id = db_view_atom_id(view_name)
        atoms.append(
            {
                "atom_id": atom_id,
                "kind": "db",
                "artifact_path": rel.as_posix(),
                "selector": {"type": "sql_view", "value": view_name},
                "content_hash": hash_text(content),
            }
        )
    trigger_pattern = re.compile(
        r"\bCREATE\s+(?:OR\s+REPLACE\s+)?(?:TEMP(?:ORARY)?\s+)?TRIGGER\s+(?:IF\s+NOT\s+EXISTS\s+)?([A-Za-z_][A-Za-z0-9_.$]*|\"[^\"]+\"|`[^`]+`|\[[^\]]+\])",
        re.IGNORECASE,
    )
    for match in trigger_pattern.finditer(text):
        trigger_name = strip_sql_identifier(match.group(1))
        end = find_sql_trigger_statement_end(text, match.end())
        content = text[match.start() : end].strip() + "\n"
        table_match = re.search(
            r"\bON\s+([A-Za-z_][A-Za-z0-9_.$]*|\"[^\"]+\"|`[^`]+`|\[[^\]]+\])\b",
            content,
            re.IGNORECASE,
        )
        selector: dict[str, Any] = {"type": "sql_trigger", "value": trigger_name}
        if table_match:
            selector["table"] = strip_sql_identifier(table_match.group(1))
        atom_id = db_trigger_atom_id(trigger_name)
        atoms.append(
            {
                "atom_id": atom_id,
                "kind": "db",
                "artifact_path": rel.as_posix(),
                "selector": selector,
                "content_hash": hash_text(content),
            }
        )
    routine_pattern = re.compile(
        r"\bCREATE\s+(?:OR\s+REPLACE\s+)?(?:TEMP(?:ORARY)?\s+)?(FUNCTION|PROCEDURE)\s+(?:IF\s+NOT\s+EXISTS\s+)?([A-Za-z_][A-Za-z0-9_.$]*|\"[^\"]+\"|`[^`]+`|\[[^\]]+\])\s*\(",
        re.IGNORECASE,
    )
    for match in routine_pattern.finditer(text):
        routine_type = match.group(1).lower()
        routine_name = strip_sql_identifier(match.group(2))
        end = find_sql_statement_end(text, match.end())
        content = text[match.start() : end].strip() + "\n"
        atom_id = db_routine_atom_id(routine_name)
        atoms.append(
            {
                "atom_id": atom_id,
                "kind": "db",
                "artifact_path": rel.as_posix(),
                "selector": {"type": f"sql_{routine_type}", "value": routine_name},
                "content_hash": hash_text(content),
            }
        )
    materialized_view_pattern = re.compile(
        r"\bCREATE\s+(?:OR\s+REPLACE\s+)?MATERIALIZED\s+VIEW\s+(?:IF\s+NOT\s+EXISTS\s+)?([A-Za-z_][A-Za-z0-9_.$]*|\"[^\"]+\"|`[^`]+`|\[[^\]]+\])(?:\s*\([^;]*?\))?\s+AS\b",
        re.IGNORECASE,
    )
    for match in materialized_view_pattern.finditer(text):
        view_name = strip_sql_identifier(match.group(1))
        end = find_sql_statement_end(text, match.end())
        content = text[match.start() : end].strip() + "\n"
        atom_id = db_schema_object_atom_id(view_name, "materialized-view")
        atoms.append(
            {
                "atom_id": atom_id,
                "kind": "db",
                "artifact_path": rel.as_posix(),
                "selector": {"type": "sql_materialized_view", "value": view_name},
                "content_hash": hash_text(content),
            }
        )
    sequence_pattern = re.compile(
        r"\bCREATE\s+(?:TEMP(?:ORARY)?\s+)?SEQUENCE\s+(?:IF\s+NOT\s+EXISTS\s+)?([A-Za-z_][A-Za-z0-9_.$]*|\"[^\"]+\"|`[^`]+`|\[[^\]]+\])\b",
        re.IGNORECASE,
    )
    for match in sequence_pattern.finditer(text):
        sequence_name = strip_sql_identifier(match.group(1))
        end = find_sql_statement_end(text, match.end())
        content = text[match.start() : end].strip() + "\n"
        atom_id = db_schema_object_atom_id(sequence_name, "sequence")
        atoms.append(
            {
                "atom_id": atom_id,
                "kind": "db",
                "artifact_path": rel.as_posix(),
                "selector": {"type": "sql_sequence", "value": sequence_name},
                "content_hash": hash_text(content),
            }
        )
    type_pattern = re.compile(
        r"\bCREATE\s+(?:OR\s+REPLACE\s+)?TYPE\s+([A-Za-z_][A-Za-z0-9_.$]*|\"[^\"]+\"|`[^`]+`|\[[^\]]+\])\b",
        re.IGNORECASE,
    )
    for match in type_pattern.finditer(text):
        type_name = strip_sql_identifier(match.group(1))
        end = find_sql_statement_end(text, match.end())
        content = text[match.start() : end].strip() + "\n"
        atom_id = db_schema_object_atom_id(type_name, "type")
        atoms.append(
            {
                "atom_id": atom_id,
                "kind": "db",
                "artifact_path": rel.as_posix(),
                "selector": {"type": "sql_type", "value": type_name},
                "content_hash": hash_text(content),
            }
        )
    return atoms


def build_atom_index(open_dir: Path) -> dict[str, Any]:
    config = parse_config(open_dir)
    atoms: list[dict[str, Any]] = []
    for rel in rel_files(open_dir):
        path = open_dir / rel
        if matches_any(rel, config["requirements"]):
            atoms.extend(extract_markdown_atoms(path, rel, "requirement"))
        elif matches_any(rel, config["designs"]):
            atoms.extend(extract_markdown_atoms(path, rel, "design"))
        elif matches_any(rel, config["adrs"]):
            atoms.extend(extract_markdown_atoms(path, rel, "adr"))
        elif matches_any(rel, config["ops"]):
            atoms.extend(extract_markdown_atoms(path, rel, "ops"))
        elif matches_any(rel, config["apis"]):
            atoms.extend(extract_openapi_atoms(path, rel))
        elif matches_any(rel, config["db"]):
            atoms.extend(extract_db_schema_atoms(path, rel))
        elif matches_any(rel, config["tests"]):
            atoms.extend(extract_python_atoms(path, rel, "test"))
        elif matches_any(rel, config["code"]):
            if path.suffix in {".js", ".jsx", ".ts", ".tsx"}:
                atoms.extend(extract_javascript_atoms(path, rel, "code"))
            elif path.suffix == ".go":
                atoms.extend(extract_go_atoms(path, rel, "code"))
            elif path.suffix == ".java":
                atoms.extend(extract_java_atoms(path, rel, "code"))
            elif path.suffix == ".cs":
                atoms.extend(extract_csharp_atoms(path, rel, "code"))
            elif path.suffix == ".rs":
                atoms.extend(extract_rust_atoms(path, rel, "code"))
            elif path.suffix in {".kt", ".kts"}:
                atoms.extend(extract_kotlin_atoms(path, rel, "code"))
            elif path.suffix == ".php":
                atoms.extend(extract_php_atoms(path, rel, "code"))
            elif path.suffix == ".rb":
                atoms.extend(extract_ruby_atoms(path, rel, "code"))
            elif path.suffix == ".swift":
                atoms.extend(extract_swift_atoms(path, rel, "code"))
            elif path.suffix in {".c", ".h", ".cc", ".cpp", ".cxx", ".hpp", ".hh", ".hxx"}:
                atoms.extend(extract_cpp_atoms(path, rel, "code"))
            else:
                atoms.extend(extract_python_atoms(path, rel, "code"))
    atoms.sort(key=lambda a: (a["atom_id"], a["artifact_path"]))
    counts: dict[str, int] = {}
    for atom in atoms:
        counts[atom["atom_id"]] = counts.get(atom["atom_id"], 0) + 1
    duplicates = sorted([atom_id for atom_id, count in counts.items() if count > 1])
    return {"type": "atom_index", "version": VERSION, "atoms": atoms, "duplicate_atom_ids": duplicates}


def atom_map(atom_index: dict[str, Any]) -> dict[str, dict[str, Any]]:
    return {a["atom_id"]: a for a in atom_index.get("atoms", [])}


def base_commit(registry: dict[str, Any]) -> str:
    return registry["open"]["current_base_commit"]


def commit_payload(repo_root: Path, commit_id: str) -> dict[str, Any]:
    return load_object(repo_root, commit_id)


def root_object(repo_root: Path, commit_id: str, root_name: str) -> Any:
    commit = commit_payload(repo_root, commit_id)
    oid = commit.get("roots", {}).get(root_name)
    if not oid:
        return {"type": root_name, "version": VERSION}
    return load_object(repo_root, oid)


def base_atom_index(repo_root: Path, registry: dict[str, Any]) -> dict[str, Any]:
    return root_object(repo_root, base_commit(registry), "atom_index")


def current_trace_graph(open_dir: Path) -> dict[str, Any]:
    links = parse_links(open_dir / "codefire.links.yaml")
    for link in links:
        link["link_id"] = f"LINK-{link['from']}-{link['type']}-{link['to']}"
        link["link_hash"] = digest_bytes(canonical_json(link))
    return {"type": "trace_graph", "version": VERSION, "links": links}


def required_link_missing(atom_index: dict[str, Any], trace_graph: dict[str, Any], required_links: dict[str, list[dict[str, Any]]]) -> list[dict[str, Any]]:
    atoms = atom_map(atom_index)
    links = trace_graph.get("links", [])
    missing: list[dict[str, Any]] = []
    for atom_id, atom in atoms.items():
        for rule in required_links.get(atom["kind"], []):
            link_type = rule["type"]
            target_kind = rule["target_kind"]
            min_count = int(rule.get("min", 1) or 1)
            count = sum(
                1
                for l in links
                if (
                l["from"] == atom_id
                and l["type"] == link_type
                and l["to"] in atoms
                and atoms[l["to"]]["kind"] == target_kind
                )
            )
            if count < min_count:
                missing.append({"atom_id": atom_id, "required_type": link_type, "target_kind": target_kind, "min": min_count, "found": count})
    return missing


def active_state(repo_root: Path, registry: dict[str, Any]) -> dict[str, Any]:
