def cmd_commit(args: argparse.Namespace) -> int:
    repo_root, open_dir, identity, registry = open_context(Path.cwd())
    verification = run_verify()
    if verification["result"] != "passed":
        raise CFError("commit blocked: verification failed or consistency blockers remain")
    policy = parse_policy(open_dir)
    scan = read_json(active_dir(repo_root, registry["open"]["open_instance_id"]) / "scan.json")
    manifest = build_manifest(repo_root, open_dir)
    manifest_id = store_object(repo_root, "content_manifest", manifest)
    atom_id = store_object(repo_root, "atom_index", scan["atom_index"])
    trace_id = store_object(repo_root, "trace_graph", scan["trace_graph"])
    fires = load_fires(repo_root, registry)
    resolutions = load_resolutions(repo_root, registry)
    fire_id = store_object(repo_root, "fire_ledger", {"type": "fire_ledger", "version": VERSION, "fires": fires})
    resolution_id = store_object(repo_root, "resolution_ledger", {"type": "resolution_ledger", "version": VERSION, "resolutions": resolutions})
    verification_id = store_object(repo_root, "verification", verification)
    policy_id = store_object(repo_root, "policy", {"type": "policy", "version": VERSION, "policy": policy})
    state = active_state(repo_root, registry)
    parents = [registry["open"]["current_base_commit"]]
    if state.get("pending_merge_parent"):
        parents.append(state["pending_merge_parent"])
    commit = {
        "type": "commit",
        "version": VERSION,
        "parents": parents,
        "message": args.message,
        "roots": {
            "content_manifest": manifest_id,
            "atom_index": atom_id,
            "trace_graph": trace_id,
            "fire_delta": fire_id,
            "resolution_ledger": resolution_id,
            "verification": verification_id,
            "policy": policy_id,
        },
        "certificate": {
            "result": "consistent",
            "open_required_fires": verification["open_required_fires"],
            "failed_checks": len(verification["failed_checks"]),
            "missing_required_links": len(verification["missing_required_links"]),
            "stale_resolutions": len(verification["stale_resolutions"]),
            "duplicate_atom_ids": len(verification["duplicate_atom_ids"]),
        },
        "changed_atoms": scan["changed_atoms"],
        "extinguished_fires": [f["fire_uid"] for f in fires if f.get("status") == "extinguished"],
        "created_at": now_iso(),
    }
    signing_key = os.environ.get("CODEFIRE_SIGNING_KEY", "")
    signer = args.signer or os.environ.get("CODEFIRE_SIGNER") or os.environ.get("USER") or "anonymous"
    key_id = args.key_id or os.environ.get("CODEFIRE_SIGNING_KEY_ID") or signer
    if signing_key:
        commit = sign_commit_payload(commit, signer, signing_key, key_id)
    elif policy.get("require_commit_signature"):
        raise CFError("commit blocked: commit signature is required but CODEFIRE_SIGNING_KEY is not set")
    commit_id = store_object(repo_root, "commit", commit)
    with file_lock(repo_dirs(repo_root)["locks"] / "repo.lock"):
        branch = load_branch(repo_root, identity["branch"]["name"])
        branch["head"] = commit_id
        branch["state"] = "open-clean"
        save_branch(repo_root, branch)
        registry["open"]["current_base_commit"] = commit_id
        registry["state"]["last_known"] = "open-clean"
        write_json(opened_registry_path(repo_root, identity["branch"]["name"]), registry)
        reset_active(repo_root, registry, "open-clean")
    print("Sealed commit created.")
    print(f"Commit: {commit_id}")
    print(f"Branch: {identity['branch']['name']}")
    print("State: open-clean")
    return 0


def cmd_merge(args: argparse.Namespace) -> int:
    repo_root = find_repo_root(Path.cwd())
    with file_lock(repo_dirs(repo_root)["locks"] / "repo.lock"):
        source = load_branch(repo_root, args.source_branch)
        require_source_branch_sealed(repo_root, args.source_branch, "merge")
        target_branch = load_branch(repo_root, args.into)
        validate_sealed_commit(repo_dirs(repo_root)["objects"], source["head"])
        validate_sealed_commit(repo_dirs(repo_root)["objects"], target_branch["head"])
        registry = read_json(opened_registry_path(repo_root, args.into))
        if not registry:
            raise CFError(f"target branch must be open: {args.into}")
        if registry["state"]["last_known"] != "open-clean":
            raise CFError("target branch must be open-clean before merge")
        base = common_ancestor(repo_root, source["head"], target_branch["head"])
        if not base:
            raise CFError("no common ancestor found")
        target_dir = Path(registry["open"]["path"])
        base_files = manifest_contents(repo_root, base)
        source_files = manifest_contents(repo_root, source["head"])
        target_files = manifest_contents(repo_root, target_branch["head"])
        conflicts: list[str] = []
        for rel in sorted(set(base_files) | set(source_files) | set(target_files)):
            b = base_files.get(rel)
            s = source_files.get(rel)
            t = target_files.get(rel)
            out = target_dir / rel
            if s == b:
                continue
            if t == b:
                write_merged_file(out, s)
                continue
            if s == t:
                continue
            conflicts.append(rel)
            write_merged_file(out, conflict_content(t, s))
        state_path = active_dir(repo_root, registry["open"]["open_instance_id"]) / "state.json"
        state = read_json(state_path, {})
        state["pending_merge_parent"] = source["head"]
        state["pending_merge_base"] = base
        state["merge_conflicts"] = conflicts
        write_json(state_path, state)
        set_open_state(repo_root, args.into, registry["open"]["open_instance_id"], "open-burning")
    if conflicts:
        print(f"merged {args.source_branch} into {args.into} with conflicts; target is open-burning")
        for rel in conflicts:
            print(f"  conflict: {rel}")
    else:
        print(f"merged {args.source_branch} into {args.into}; target is open-burning")
    return 0


