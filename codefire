def api_atom_id(operation: dict[str, Any], method: str, api_path: str) -> str:
    explicit = operation.get("x-codefire-atom-id")
    if isinstance(explicit, str) and explicit:
        return explicit
    operation_id = operation.get("operationId")
    if isinstance(operation_id, str) and operation_id:
        suffix = re.sub(r"[^A-Za-z0-9_.-]+", "-", operation_id).strip("-")
    else:
        suffix = re.sub(r"[^A-Za-z0-9_.-]+", "-", f"{method}-{api_path}").strip("-")
    return f"API-{suffix or 'operation'}"


def yaml_key(line: str) -> str | None:
    stripped = line.strip()
    if not stripped.endswith(":"):
        return None
    key = stripped[:-1].strip()
    if not key:
        return None
    return unquote(key)


def yaml_scalar(line: str, key: str) -> str | None:
    m = re.match(rf"{re.escape(key)}:\s*(.+)$", line.strip())
    if not m:
        return None
    return unquote(m.group(1))


def parse_openapi_yaml_operations(text: str, rel: Path) -> list[dict[str, Any]]:
    methods = {"get", "put", "post", "delete", "patch", "head", "options", "trace"}
    lines = text.splitlines()
    in_paths = False
    paths_indent = -1
    current_path: str | None = None
    path_indent = -1
    operations: list[dict[str, Any]] = []
    i = 0
    while i < len(lines):
        raw_line = lines[i]
        line = raw_line.split("#", 1)[0].rstrip()
        stripped = line.strip()
        if not stripped:
            i += 1
            continue
        if "\t" in raw_line[: len(raw_line) - len(raw_line.lstrip())]:
            raise CFError(f"invalid OpenAPI YAML: {rel.as_posix()}: tabs are not supported")
        indent = len(line) - len(line.lstrip(" "))
        if stripped == "paths:":
            in_paths = True
            paths_indent = indent
            current_path = None
            path_indent = -1
            i += 1
            continue
        if in_paths and indent <= paths_indent:
            in_paths = False
            current_path = None
            path_indent = -1
        if not in_paths:
            i += 1
            continue

        key = yaml_key(stripped)
        if key and indent > paths_indent and key.startswith("/"):
            current_path = key
            path_indent = indent
            i += 1
            continue
        if current_path and key and indent > path_indent and key.lower() in methods:
            method = key.lower()
            method_indent = indent
            start = i
            operation: dict[str, Any] = {}
            i += 1
            while i < len(lines):
                child_raw = lines[i]
                child_line = child_raw.split("#", 1)[0].rstrip()
                child_stripped = child_line.strip()
                if not child_stripped:
                    i += 1
                    continue
                child_indent = len(child_line) - len(child_line.lstrip(" "))
                if child_indent <= method_indent:
                    break
                for scalar_key in ["operationId", "x-codefire-atom-id"]:
                    value = yaml_scalar(child_stripped, scalar_key)
                    if value is not None:
                        operation[scalar_key] = value
                i += 1
            block = "\n".join(lines[start:i]).strip() + "\n"
            operation["_codefire_yaml_block_hash"] = hash_text(block)
            operations.append({"path": current_path, "method": method, "operation": operation})
            continue
        i += 1
    return operations


def extract_openapi_atoms(path: Path, rel: Path) -> list[dict[str, Any]]:
    methods = {"get", "put", "post", "delete", "patch", "head", "options", "trace"}
    if path.suffix.lower() == ".json":
        try:
            spec = json.loads(read_text_lossy(path))
        except json.JSONDecodeError as exc:
            raise CFError(f"invalid OpenAPI JSON: {rel.as_posix()}: {exc.msg}") from exc
        paths = spec.get("paths", {}) if isinstance(spec, dict) else {}
        if not isinstance(paths, dict):
            raise CFError(f"invalid OpenAPI JSON: {rel.as_posix()}: paths must be an object")
        operations = []
        for api_path, path_item in sorted(paths.items()):
            if not isinstance(path_item, dict):
                continue
            for method, operation in sorted(path_item.items()):
                if method.lower() not in methods or not isinstance(operation, dict):
                    continue
                operations.append({"path": api_path, "method": method.lower(), "operation": operation})
    else:
        operations = parse_openapi_yaml_operations(read_text_lossy(path), rel)
    atoms: list[dict[str, Any]] = []
    for item in sorted(operations, key=lambda op: (str(op["path"]), str(op["method"]))):
        api_path = str(item["path"])
        method = str(item["method"]).lower()
        operation = item["operation"]
        atom_id = api_atom_id(operation, method, api_path)
        content = {
            "path": api_path,
            "method": method,
            "operation": operation,
        }
        atoms.append(
            {
                "atom_id": atom_id,
                "kind": kind_from_atom_id(atom_id, "api"),
                "artifact_path": rel.as_posix(),
                "selector": {"type": "openapi_operation", "path": api_path, "method": method},
                "content_hash": digest_bytes(canonical_json(content)),
            }
        )
    return atoms


