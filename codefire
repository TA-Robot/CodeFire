    )
    return refs


class AccountedDoctorPayload(dict[str, Any]):
    """A doctor result whose retained-byte ownership follows its lifetime."""

    def __init__(
        self,
        payload: dict[str, Any],
        ledger: DecisionWorkLedger,
        retained_bytes: int,
    ) -> None:
        super().__init__(payload)
        self._ledger = ledger
        self._retained_bytes = retained_bytes
        self._closed = False

    def close(self) -> None:
        if self._closed:
            return
        self._closed = True
        dict.clear(self)
        if self._retained_bytes:
            self._ledger.release("retained_bytes", self._retained_bytes)
            self._retained_bytes = 0
        if self._ledger.terminal_reason is None:
            self._ledger.terminate("complete")

    def __del__(self) -> None:
        try:
            self.close()
        except Exception:
            pass


def _account_doctor_payload(
    payload: dict[str, Any], ledger: DecisionWorkLedger
) -> AccountedDoctorPayload:
    retained_bytes = canonical_json_size(payload)
    ledger.apply(
        "query",
        acquires={
            "retained_bytes": retained_bytes,
            "temporary_bytes": retained_bytes,
        },
    )
    try:
        accounted = AccountedDoctorPayload(payload, ledger, retained_bytes)
        payload.clear()
    except Exception:
        _clear_doctor_payload_tree(payload)
        ledger.release("retained_bytes", retained_bytes)
        raise
    finally:
        ledger.release("temporary_bytes", retained_bytes)
    return accounted


def _clear_doctor_payload_tree(value: Any) -> None:
    """Clear a failed output graph before releasing its reserved live bytes."""
    if isinstance(value, dict):
        while value:
            _, child = value.popitem()
            _clear_doctor_payload_tree(child)
    elif isinstance(value, list):
        while value:
            _clear_doctor_payload_tree(value.pop())
    elif isinstance(value, tuple):
        for child in value:
            _clear_doctor_payload_tree(child)


def remote_doctor_payload(
    project_root: Path, url: str, *, quick: bool = False
) -> dict[str, Any]:
    doctor_ledger = DecisionWorkLedger(
        DecisionWorkProfile.local_v1(), "remote doctor"
    )
    cleanup: dict[str, Any] = {"session": None}
    transferred = False
    try:
        payload = _remote_doctor_payload(
            project_root,
            url,
            quick=quick,
            doctor_ledger=doctor_ledger,
            cleanup=cleanup,
        )
        transferred = True
        return payload
    finally:
        if not transferred:
            session = cleanup.get("session")
            if session is not None:
                session.close(None)
            retained = doctor_ledger.current.get("retained_bytes", 0)
            if retained:
                doctor_ledger.release("retained_bytes", retained)
            temporary = doctor_ledger.current.get("temporary_bytes", 0)
            if temporary:
                doctor_ledger.release("temporary_bytes", temporary)
            if doctor_ledger.terminal_reason is None:
                doctor_ledger.terminate("corrupt_subject")


class _RemoteDoctorInputOwnership:
    """Drop Doctor input values before releasing their aggregate accounting."""

    def __init__(self, ledger: DecisionWorkLedger) -> None:
        self.ledger = ledger
        self.retained_bytes = 0
        self.values: list[Any] = []
        self.session: Any = None
        self.closed = False

    def adopt(self, value: Any, retained_bytes: int) -> Any:
        self.retained_bytes += retained_bytes
        self.values.append(value)
        return value

    def transfer(self, value: Any) -> None:
        for index, owned in enumerate(self.values):
            if owned is value:
                del self.values[index]
                return
        raise CFError("remote Doctor input ownership is not active")

    def close(self) -> None:
        if self.closed:
            return
        self.closed = True
        for value in reversed(self.values):
            clear = getattr(value, "clear", None)
            if clear is not None:
                clear()
        self.values.clear()
        if self.session is not None:
            self.session.close(None)
            self.session = None
        retained_bytes = self.retained_bytes
        self.retained_bytes = 0
        if retained_bytes:
            self.ledger.release("retained_bytes", retained_bytes)


def _remote_doctor_payload(
    project_root: Path,
    url: str,
    *,
    quick: bool,
    doctor_ledger: DecisionWorkLedger,
    cleanup: dict[str, Any],
) -> AccountedDoctorPayload:
    ownership = _RemoteDoctorInputOwnership(doctor_ledger)
    try:
        return _remote_doctor_payload_owned(
            project_root,
            url,
            quick=quick,
            doctor_ledger=doctor_ledger,
            cleanup=cleanup,
            ownership=ownership,
        )
    finally:
        ownership.close()
        cleanup["session"] = None


def _remote_doctor_payload_owned(
    project_root: Path,
    url: str,
    *,
    quick: bool,
    doctor_ledger: DecisionWorkLedger,
    cleanup: dict[str, Any],
    ownership: _RemoteDoctorInputOwnership,
) -> AccountedDoctorPayload:
    dirs = remote_dirs(project_root)
    project_exists = dirs["project"].exists()
    layout = {
        name: dirs[name].exists()
        for name in ["objects", "branches", "merge_requests", "locks", "idempotency"]
    }
    transport = (
        "https"
        if url.startswith("cf+https://")
        else "http"
        if url.startswith("cf+http://")
        else "file"
    )
    common = {
        "type": "codefire_remote_doctor_report",
        "version": 1,
        "schema": "codefire.remote_doctor.v1",
        "project": url,
        "transport": transport,
        "semantic_profile": CURRENT_SEMANTIC_PROFILE,
        "project_exists": project_exists,
        "layout": layout,
        "checked_objects": 0,
        "branch_count": 0,
        "merge_request_count": 0,
        "object_hash_errors": 0,
        "missing_object_references": 0,
        "invalid_sealed_commit_references": 0,
        "invalid_record_versions": 0,
        "diagnostics_truncated": False,
        "quick": quick,
        "skipped_checks": ["object_hash_and_reference_graph"] if quick else [],
        "issues": [],
    }
    ownership.adopt(common, 0)
    ownership.adopt(layout, 0)
    if not project_exists:
        accounted = _account_doctor_payload(common | {
            "bad_objects": [],
            "missing_objects": [],
            "invalid_sealed_refs": [],
            "invalid_commit_signatures": [],
            "invalid_commit_signature_references": 0,
            "issues": [
                {
                    "kind": "remote_project_missing",
                    "message": "remote project does not exist",
                    "subject": url,
                }
            ],
            "ok": False,
        }, doctor_ledger)
        ownership.transfer(layout)
        return accounted
    issues: list[dict[str, Any]] = []
    ownership.adopt(issues, 0)
    invalid_record_versions = 0
    branch_records: list[tuple[Path, dict[str, Any]]] = []
    merge_request_records: list[tuple[Path, dict[str, Any]]] = []
    ownership.adopt(branch_records, 0)
    ownership.adopt(merge_request_records, 0)
    doctor_session = (
        SealedCommitValidationSession(dirs["objects"], doctor_ledger)
        if dirs["objects"].is_dir()
        else None
    )
    cleanup["session"] = doctor_session
    ownership.session = doctor_session
    branch_paths, branch_paths_retained = accounted_sorted_json_paths(
        dirs["branches"], doctor_ledger
    )
    ownership.adopt(branch_paths, branch_paths_retained)
    merge_request_paths, merge_request_paths_retained = accounted_sorted_json_paths(
        dirs["merge_requests"], doctor_ledger
    )
    ownership.adopt(merge_request_paths, merge_request_paths_retained)
    for path in branch_paths:
        record = None
        try:
            doctor_ledger.apply(
                "graph_discovery",
                charges={"graph_nodes": 1},
                maxima={"maximum_frontier": 1},
                counters={
                    "unique_nodes_discovered": 1,
                    "frontier_insertion_attempts": 1,
                },
            )
            record, retained = read_json_accounted(path, doctor_ledger)
            ownership.adopt(record, retained)
            try:
                validate_persisted_record_version(record, "remote_branch")
            except CFError as exc:
                invalid_record_versions += 1
                issues.append(
                    {
                        "kind": "remote_record_version_unsupported",
                        "message": str(exc),
                        "subject": str(path),
                    }
                )
                continue
            branch_records.append((path, record))
        finally:
            record = None
            path = None
    for path in merge_request_paths:
        record = None
        try:
            doctor_ledger.apply(
                "graph_discovery",
                charges={"graph_nodes": 1},
                maxima={"maximum_frontier": 1},
                counters={
                    "unique_nodes_discovered": 1,
                    "frontier_insertion_attempts": 1,
                },
            )
            record, retained = read_json_accounted(path, doctor_ledger)
            ownership.adopt(record, retained)
            try:
                validate_persisted_record_version(record, "remote_merge_request")
            except CFError as exc:
                invalid_record_versions += 1
                issues.append(
                    {
                        "kind": "remote_record_version_unsupported",
                        "message": str(exc),
                        "subject": str(path),
                    }
                )
                continue
            merge_request_records.append((path, record))
        finally:
            record = None
            path = None
    sealed_refs: list[tuple[str, str]] = []
    for path, branch in branch_records:
        head = branch.get("head")
        if isinstance(head, str):
            sealed_refs.append((f"branch {branch.get('name', path.stem)}", head))
    for path, mr in merge_request_records:
        label = mr.get("mr_id", path.stem)
        for key in ["source_head", "target_head_at_request", "applied_head"]:
            head = mr.get(key)
            if isinstance(head, str):
                sealed_refs.append((f"merge_request {label} {key}", head))
    try:
        pending_roots = remote_pending_object_roots(project_root)
        pending_retained = canonical_json_size(pending_roots)
        doctor_ledger.acquire("retained_bytes", pending_retained, "query")
        ownership.adopt(pending_roots, pending_retained)
        sealed_refs.extend(
            (f"pending_transaction object_root {index}", root)
            for index, root in enumerate(pending_roots)
        )
        refs_retained = canonical_json_size(sealed_refs)
        doctor_ledger.acquire("retained_bytes", refs_retained, "query")
        ownership.adopt(sealed_refs, refs_retained)
        if quick:
            bad_paths = []
            ownership.adopt(bad_paths, 0)
            missing_refs = []
            ownership.adopt(missing_refs, 0)
            invalid_sealed_refs = []
            ownership.adopt(invalid_sealed_refs, 0)
            invalid_signatures = []
            ownership.adopt(invalid_signatures, 0)
        else:
            if doctor_session is None:
                raise CFError("remote object store is unavailable")
            bad_paths = doctor_session.scan_object_hash_errors()
            ownership.adopt(bad_paths, 0)
            missing_refs = doctor_session.missing_references(
                [reference for _, reference in sealed_refs]
            )
            ownership.adopt(missing_refs, 0)
            invalid_sealed_refs = sealed_commit_reference_errors(
                dirs["objects"], sealed_refs, session=doctor_session
            )
            ownership.adopt(invalid_sealed_refs, 0)
            signature_policy, policy_retained = read_json_accounted(
                remote_policy_path(project_root), doctor_ledger, default={}
            )
            ownership.adopt(signature_policy, policy_retained)
            invalid_signatures = remote_commit_signature_errors(
                project_root,
                sealed_refs,
                session=doctor_session,
                policy=signature_policy,
            )
            ownership.adopt(invalid_signatures, 0)
    except (ResourceBudgetExceeded, SealedValidationSubjectChanged):
        raise
    except CFError as exc:
        bad_paths = []
        missing_refs = []
        invalid_sealed_refs = []
        invalid_signatures = []
        issues.append({"kind": "remote_semantic_profile_invalid", "message": str(exc)})
        ownership.adopt(bad_paths, 0)
        ownership.adopt(missing_refs, 0)
        ownership.adopt(invalid_sealed_refs, 0)
        ownership.adopt(invalid_signatures, 0)
    branch_count = len(branch_paths)
    mr_count = len(merge_request_paths)
    checked_objects = (
        0
        if quick or doctor_session is None
        else doctor_session.scanned_object_records
    )
    diagnostics_retained = canonical_json_size(
        [bad_paths, missing_refs, invalid_sealed_refs, invalid_signatures]
    )
    doctor_ledger.acquire("retained_bytes", diagnostics_retained, "query")
    ownership.retained_bytes += diagnostics_retained
    for name, present in layout.items():
        if not present:
            issues.append(
                {
                    "kind": "remote_layout_missing",
                    "message": f"remote layout component is missing: {name}",
                    "subject": name,
                }
            )
    issues.extend(
        {
            "kind": "remote_object_invalid",
            "message": f"invalid object record: {path}",
            "subject": str(path),
        }
        for path in bad_paths
    )
    issues.extend(
        {
            "kind": "remote_object_reference_missing",
            "message": f"missing object reference: {object_id}",
            "subject": object_id,
        }
        for object_id in missing_refs
    )
    issues.extend(
        {
            "kind": "remote_sealed_commit_invalid",
            "message": error,
        }
        for error in invalid_sealed_refs
    )
    issues.extend(
        {
            "kind": "remote_commit_signature_invalid",
            "message": error,
        }
        for error in invalid_signatures
    )
    ok = not (
        bad_paths
        or missing_refs
        or invalid_sealed_refs
        or invalid_signatures
        or issues
    )
    payload = common | {
        "bad_objects": [str(path) for path in bad_paths],
        "missing_objects": missing_refs,
        "invalid_sealed_refs": invalid_sealed_refs,
        "invalid_commit_signatures": invalid_signatures,
        "checked_objects": checked_objects,
        "branch_count": branch_count,
        "merge_request_count": mr_count,
        "object_hash_errors": len(bad_paths),
        "missing_object_references": len(missing_refs),
        "invalid_sealed_commit_references": len(invalid_sealed_refs),
        "invalid_record_versions": invalid_record_versions,
        "invalid_commit_signature_references": len(invalid_signatures),
        "issues": issues[:128],
        "diagnostics_truncated": len(issues) > 128,
        "ok": ok,
    }
    if doctor_session is not None:
        doctor_session.finalize(terminate=False)
    accounted_payload = _account_doctor_payload(payload, doctor_ledger)
    ownership.transfer(layout)
    ownership.transfer(missing_refs)
    ownership.transfer(invalid_sealed_refs)
    ownership.transfer(invalid_signatures)
    return accounted_payload


def print_remote_doctor_payload(payload: dict[str, Any]) -> int:
    try:
        return _print_remote_doctor_payload(payload)
    finally:
        close = getattr(payload, "close", None)
        if close is not None:
            close()


def _print_remote_doctor_payload(payload: dict[str, Any]) -> int:
    print("CodeFire remote doctor")
    print(f"project: {payload['project']}")
    if not payload.get("project_exists"):
        print("project: missing")
        return 1
    for name in ["objects", "branches", "merge_requests"]:
        print(f"{name}: {'ok' if payload.get('layout', {}).get(name) else 'missing'}")
    for path in payload.get("bad_objects", []):
        print(f"bad object: {path}")
    for oid in payload.get("missing_objects", []):
        print(f"missing object: {oid}")
    for err in payload.get("invalid_sealed_refs", []):
        print(f"invalid sealed ref: {err}")
    for err in payload.get("invalid_commit_signatures", []):
        print(f"invalid commit signature: {err}")
    print(f"branches: {payload.get('branch_count', 0)}")
    print(f"merge_requests: {payload.get('merge_request_count', 0)}")
    print(f"object hash errors: {payload.get('object_hash_errors', 0)}")
    print(f"missing object references: {payload.get('missing_object_references', 0)}")
    print(f"invalid sealed commit references: {payload.get('invalid_sealed_commit_references', 0)}")
    print(f"invalid commit signature references: {payload.get('invalid_commit_signature_references', 0)}")
    return 0 if payload.get("ok") else 1


REMOTE_GC_MAX_OBJECTS = 31_744
REMOTE_GC_MANIFEST_RECORDS = 256


def _remote_gc_policy(project_root: Path) -> tuple[dict[str, Any], int, int]:
    policy = read_json(remote_policy_path(project_root), {})
    if not isinstance(policy, dict) or (
        "version" in policy and policy.get("version") != VERSION
    ):
        raise CFError("gc blocked: unknown or malformed policy version")
    gc_policy = policy.get("gc", {})
    if not isinstance(gc_policy, dict):
        raise CFError("gc blocked: malformed gc policy")
    values = []
    for name in ["retention_seconds", "retention_generations"]:
        value = gc_policy.get(name, 0) or 0
        if isinstance(value, bool) or not isinstance(value, int) or value < 0:
            raise CFError(f"gc blocked: {name} must be a non-negative integer")
        values.append(value)
    return policy, values[0], values[1]


def _remote_gc_roots(project_root: Path) -> list[dict[str, str]]:
    roots: list[dict[str, str]] = []
    for kind, directory in [
        ("branch", remote_dirs(project_root)["branches"]),
        ("merge_request", remote_dirs(project_root)["merge_requests"]),
    ]:
        directory_fd = _open_directory_nofollow(directory)
        try:
            names = sorted(os.listdir(directory_fd))
            if len(names) > 10_000:
                raise CFError(f"gc blocked: {kind} authority count exceeds limit")
            for name in names:
                if not name.isascii() or not name.endswith(".json"):
                    raise CFError(f"gc blocked: foreign {kind} authority entry")
                raw = _read_regular_bounded_at(directory_fd, name, 16 * 1024 * 1024)
                try:
                    value = json.loads(raw)
                except (UnicodeDecodeError, json.JSONDecodeError) as exc:
                    raise CFError(f"gc blocked: malformed {kind} authority") from exc
                if not isinstance(value, dict) or value.get("version") != VERSION:
                    raise CFError(f"gc blocked: unknown {kind} authority version")
                if kind == "branch":
                    head = value.get("head")
                    if not isinstance(head, str):
                        raise CFError("gc blocked: branch head is malformed")
                    roots.append(
                        {
                            "kind": "sealed_commit",
                            "id": head,
                            "reason": f"branch:{value.get('name', name[:-5])}",
                        }
                    )
                else:
                    label = str(value.get("mr_id", name[:-5]))
                    for field in ["source_head", "target_head_at_request", "applied_head"]:
                        head = value.get(field)
                        if head is not None:
                            if not isinstance(head, str):
                                raise CFError("gc blocked: merge-request root is malformed")
                            roots.append(
                                {
                                    "kind": "sealed_commit",
                                    "id": head,
                                    "reason": f"merge_request:{label}:{field}",
                                }
                            )
        finally:
            os.close(directory_fd)
    return sorted(roots, key=lambda item: (item["reason"], item["id"]))


def _remote_gc_inventory(
    project_root: Path, allowed_quarantines: set[str] | None = None
) -> list[dict[str, Any]]:
    objects_fd = _open_directory_nofollow(remote_dirs(project_root)["objects"])
    inventory: list[dict[str, Any]] = []
    try:
        actual_subdirs = set(os.listdir(objects_fd))
        if actual_subdirs != set(REMOTE_OBJECT_SUBDIRS):
            raise CFError("gc blocked: unknown or missing object directory")
        for subdir in sorted(REMOTE_OBJECT_SUBDIRS):
            subdir_fd = _open_directory_at(objects_fd, subdir)
            try:
                for name in sorted(os.listdir(subdir_fd)):
                    relative = f"objects/{subdir}/{name}"
                    if allowed_quarantines is not None and relative in allowed_quarantines:
                        continue
                    if len(inventory) >= REMOTE_GC_MAX_OBJECTS:
                        raise CFError("gc blocked: object inventory exceeds bounded limit")
                    if not name.isascii() or not name.endswith(".json"):
                        raise CFError("gc blocked: foreign object-store entry")
                    raw = _read_regular_bounded_at(
                        subdir_fd, name, 64 * 1024 * 1024
                    )
                    metadata = os.stat(
                        name, dir_fd=subdir_fd, follow_symlinks=False
                    )
                    try:
                        record = json.loads(raw)
                    except (UnicodeDecodeError, json.JSONDecodeError) as exc:
                        raise CFError("gc blocked: malformed object JSON") from exc
                    path = project_root / "objects" / subdir / name
                    validate_object_record(record, expected_oid=name[:-5], path=path)
                    payload = record.get("payload")
                    if isinstance(payload, dict) and (
                        "version" in payload and payload.get("version") != VERSION
                    ):
                        raise CFError("gc blocked: unknown object payload version")
                    inventory.append(
                        {
                            "object_id": record["object_id"],
                            "type": record["type"],
                            "path": f"objects/{subdir}/{name}",
                            "record_hash": hashlib.sha256(raw).hexdigest(),
                            "identity": {
                                "device": metadata.st_dev,
                                "inode": metadata.st_ino,
                                "size": metadata.st_size,
                                "mtime_ns": metadata.st_mtime_ns,
                            },
                        }
                    )
            finally:
                os.close(subdir_fd)
    finally:
        os.close(objects_fd)
    return inventory


def _remote_gc_retention_index(
    project_root: Path, current_generation: int | None = None
) -> dict[str, Any] | None:
    project_fd = _open_directory_nofollow(project_root)
    try:
        try:
            raw = _read_regular_bounded_at(
                project_fd, "retention_index.json", 16 * 1024 * 1024
            )
        except FileNotFoundError:
            return None
    finally:
        os.close(project_fd)
    try:
        index = json.loads(raw)
    except (UnicodeDecodeError, json.JSONDecodeError) as exc:
        raise CFError("gc blocked: malformed retention index JSON") from exc
    if (
        not isinstance(index, dict)
        or set(index) != {"type", "version", "objects", "updated_generation"}
        or index.get("type") != "remote_retention_index"
        or index.get("version") != VERSION
        or not isinstance(index.get("objects"), dict)
        or not isinstance(index.get("updated_generation"), int)
        or index.get("updated_generation") < 0
        or len(index.get("objects")) > REMOTE_GC_MAX_OBJECTS
        or (
            current_generation is not None
            and index.get("updated_generation") > current_generation
        )
    ):
        raise CFError("gc blocked: unknown or malformed retention index")
    for oid, entry in index["objects"].items():
        if (
            not isinstance(oid, str)
            or not oid.startswith("CF-")
            or not isinstance(entry, dict)
            or set(entry) != {
                "first_unreachable_generation",
                "last_unreachable_generation",
            }
            or not all(isinstance(value, int) and value >= 0 for value in entry.values())
            or entry["first_unreachable_generation"]
            > entry["last_unreachable_generation"]
            or entry["last_unreachable_generation"]
            > index["updated_generation"]
        ):
            raise CFError("gc blocked: malformed retention index entry")
    return index


def _remote_gc_decide_inventory(
    base_inventory: list[dict[str, Any]],
    reachable: set[str],
    retention_before: dict[str, Any] | None,
    generation: int,
    retention_seconds: int,
    retention_generations: int,
    planned_at_ns: int,
) -> tuple[list[dict[str, Any]], dict[str, Any], list[dict[str, Any]], list[dict[str, Any]]]:
    inventory = [dict(item) for item in base_inventory]
    old_entries = retention_before["objects"] if retention_before else {}
    new_entries: dict[str, Any] = {}
    protected_objects: list[dict[str, Any]] = []
    removed_objects: list[dict[str, Any]] = []
    delete_index = 0
    for item in inventory:
        oid = item["object_id"]
        if oid in reachable:
            item.update(
                decision="reachable", reason="root_reachable", delete_index=None
            )
            continue
        entry = old_entries.get(oid)
        first_generation = (
            entry.get("first_unreachable_generation")
            if isinstance(entry, dict)
            else generation
        )
        age_protected = retention_seconds > 0 and (
            planned_at_ns - item["identity"]["mtime_ns"]
        ) < retention_seconds * 1_000_000_000
        generation_protected = retention_generations > 0 and (
            generation - first_generation <= retention_generations
        )
        summary = {
            "object_id": oid,
            "type": item["type"],
            "path": item["path"],
            "first_unreachable_generation": first_generation,
        }
        if age_protected or generation_protected:
            item.update(
                decision="protected",
                reason=(
                    "retention_seconds"
                    if age_protected
                    else "retention_generations"
                ),
                delete_index=None,
            )
            new_entries[oid] = {
                "first_unreachable_generation": first_generation,
                "last_unreachable_generation": generation,
            }
            protected_objects.append(summary)
        else:
            item.update(
                decision="delete",
                reason="unreachable_retention_expired",
                delete_index=delete_index,
            )
            delete_index += 1
            removed_objects.append(summary)
    retention_after = {
        "type": "remote_retention_index",
        "version": VERSION,
        "objects": dict(sorted(new_entries.items())),
        "updated_generation": generation,
    }
    return inventory, retention_after, protected_objects, removed_objects


def _remote_gc_prepare_plan(
    project_root: Path,
    project: dict[str, Any],
    actor: str,
    dry_run: bool,
) -> dict[str, Any]:
    policy, retention_seconds, retention_generations = _remote_gc_policy(project_root)
    roots = _remote_gc_roots(project_root)
    root_ids = [root["id"] for root in roots]
    missing_refs = object_graph_missing_references(
        remote_dirs(project_root)["objects"], root_ids
    )
    if missing_refs:
        raise CFError(f"gc blocked: missing object references: {len(missing_refs)}")
    invalid_sealed_refs = sealed_commit_reference_errors(
        remote_dirs(project_root)["objects"],
        [(root["reason"], root["id"]) for root in roots],
    )
    if invalid_sealed_refs:
        raise CFError(
            f"gc blocked: invalid sealed commit references: {len(invalid_sealed_refs)}"
        )
    invalid_signatures = remote_commit_signature_errors(
        project_root, [(root["reason"], root["id"]) for root in roots]
    )
    if invalid_signatures:
        raise CFError(f"gc blocked: invalid commit signatures: {len(invalid_signatures)}")
    reachable: set[str] = set()
    stack = root_ids[:]
    objects_root = remote_dirs(project_root)["objects"]
    while stack:
        oid = stack.pop()
        if oid in reachable:
            continue
        reachable.add(oid)
        stack.extend(object_record_references(load_object_record_from_root(objects_root, oid)))
    base_inventory = _remote_gc_inventory(project_root)
    generation = current_remote_generation(project_root)
    retention_before = _remote_gc_retention_index(project_root, generation)
    now_ns = time.time_ns()
    inventory, retention_after, protected_objects, removed_objects = (
        _remote_gc_decide_inventory(
            base_inventory,
            reachable,
            retention_before,
            generation,
            retention_seconds,
            retention_generations,
            now_ns,
        )
    )
    plan_id = f"GC-{secrets.token_hex(16)}"
    created_at = now_iso()
    audit = {
        "type": "gc_audit",
        "version": VERSION,
        "plan_id": plan_id,
        "stable_project_id": remote_project_stable_id(project_root),
        "project": project,
        "actor": actor,
        "dry_run": bool(dry_run),
        "policy_digest": _remote_json_hash(policy),
        "retention_seconds": retention_seconds,
        "retention_generations": retention_generations,
        "current_generation": generation,
        "root_fingerprint": _remote_json_hash(roots),
        "inventory_fingerprint": _remote_json_hash(inventory),
        "reachable_objects": len(reachable),
        "objects_protected": len(protected_objects),
        "objects_removed": len(removed_objects),
        "removed_objects": removed_objects,
        "protected_objects": protected_objects,
        "created_at": created_at,
        "created_at_ns": now_ns,
    }
    return {
        "plan_id": plan_id,
        "created_at": created_at,
        "planned_at_ns": now_ns,
        "policy": policy,
        "roots": roots,
        "inventory": inventory,
        "retention_before": retention_before,
        "retention_after": retention_after,
        "audit": audit,
    }


def _remote_gc_stage_plan(
    project_root: Path, actor: str, dry_run: bool, plan: dict[str, Any]
) -> dict[str, Any]:
    transaction_id = f"GC-TX-{secrets.token_hex(16)}"
    transaction_dir = remote_dirs(project_root)["transactions"] / transaction_id
    transaction_dir.mkdir(mode=0o700)
    _sync_directory(transaction_dir.parent)
    stages: list[dict[str, Any]] = []
    chunks = [
        plan["inventory"][index : index + REMOTE_GC_MANIFEST_RECORDS]
        for index in range(0, len(plan["inventory"]), REMOTE_GC_MANIFEST_RECORDS)
    ] or [[]]
    payloads = [
        (
            f"manifest-{index:04d}.json",
            {
                "type": "remote_gc_inventory_manifest",
                "version": VERSION,
                "index": index,
                "records": chunk,
            },
        )
        for index, chunk in enumerate(chunks)
    ]
    payloads.extend(
        [
            ("roots.json", {"type": "remote_gc_roots", "version": VERSION, "roots": plan["roots"]}),
            (
                "retention-before.json",
                {
                    "type": "remote_gc_retention_preimage",
                    "version": VERSION,
                    "value": plan["retention_before"],
                },
            ),
            ("retention.json", plan["retention_after"]),
            ("audit.json", plan["audit"]),
        ]
    )
    try:
        for name, value in payloads:
            raw = canonical_json(value)
            fd = os.open(
                transaction_dir / name,
                os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW,
                0o600,
            )
            try:
                _write_all_fd(fd, raw)
                os.fsync(fd)
            finally:
                os.close(fd)
            stages.append(
                {"name": name, "hash": hashlib.sha256(raw).hexdigest(), "size": len(raw)}
            )
        _sync_directory(transaction_dir)
        request_hash = _remote_json_hash(
            {
                "type": "remote_gc_request",
                "version": VERSION,
                "stable_project_id": remote_project_stable_id(project_root),
                "actor": actor,
                "dry_run": bool(dry_run),
            }
        )
        plan_fingerprint = _remote_json_hash(
            {
                "policy": plan["policy"],
                "roots": plan["roots"],
                "inventory": plan["inventory"],
                "retention_before": plan["retention_before"],
                "retention_after": plan["retention_after"],
                "audit": plan["audit"],
            }
        )
        retention_before_hash = (
            None
            if plan["retention_before"] is None
            else _remote_json_hash(plan["retention_before"])
        )
        pending = {
            "type": "remote_gc_transaction",
            "version": VERSION,
            "status": "pending",
            "phase": "deleting",
            "operation": "remote_gc",
            "transaction_id": transaction_id,
            "plan_id": plan["plan_id"],
            "actor": actor,
            "dry_run": bool(dry_run),
            "request_hash": request_hash,
            "plan_fingerprint": plan_fingerprint,
            "policy_digest": _remote_json_hash(plan["policy"]),
            "generation": plan["audit"]["current_generation"],
            "root_fingerprint": plan["audit"]["root_fingerprint"],
            "inventory_fingerprint": plan["audit"]["inventory_fingerprint"],
            "retention_before_hash": retention_before_hash,
            "retention_plan_hash": _remote_json_hash(plan["retention_after"]),
            "retention_after_hash": retention_before_hash
            if dry_run
            else _remote_json_hash(plan["retention_after"]),
            "retention_published": False,
            "candidate_count": plan["audit"]["objects_removed"],
            "deleted_count": 0,
            "audit_published": False,
            "stages": stages,
            "created_at": plan["created_at"],
            "planned_at_ns": plan["planned_at_ns"],
        }
        project_fd = _open_directory_nofollow(project_root)
        try:
            _write_create_noreplace_at(
                project_fd, "pending_transaction.json", canonical_json(pending)
            )
        finally:
            os.close(project_fd)
        return pending
    except Exception:
        if not (project_root / "pending_transaction.json").exists():
            shutil.rmtree(transaction_dir, ignore_errors=True)
        raise


def _remote_gc_load_stages(
    project_root: Path, pending: dict[str, Any]
) -> tuple[
    list[dict[str, Any]],
    list[dict[str, str]],
    dict[str, Any] | None,
    dict[str, Any],
    dict[str, Any],
]:
    transaction_id = pending["transaction_id"]
    expected = pending.get("stages")
    if not isinstance(expected, list) or not expected or len(expected) > 128:
        raise CFError("gc pending stage set is malformed")
    names = remote_transaction_entry_names(project_root, transaction_id)
    if names is None or names != {stage.get("name") for stage in expected if isinstance(stage, dict)}:
        raise CFError("gc pending staging set diverged")
    inventory: list[dict[str, Any]] = []
    roots = retention_before_marker = retention = audit = None
    for stage in expected:
        if (
            not isinstance(stage, dict)
            or set(stage) != {"name", "hash", "size"}
            or not isinstance(stage.get("name"), str)
            or not isinstance(stage.get("hash"), str)
            or not isinstance(stage.get("size"), int)
        ):
            raise CFError("gc pending stage descriptor is malformed")
        raw = read_remote_transaction_stage(project_root, transaction_id, stage["name"])
        if len(raw) != stage["size"] or hashlib.sha256(raw).hexdigest() != stage["hash"]:
            raise CFError("gc staged manifest diverged")
        value = json.loads(raw)
        if stage["name"].startswith("manifest-"):
            if value.get("type") != "remote_gc_inventory_manifest" or value.get("version") != VERSION:
                raise CFError("gc inventory manifest is malformed or future")
            inventory.extend(value.get("records", []))
        elif stage["name"] == "roots.json":
            roots = value.get("roots") if value.get("type") == "remote_gc_roots" and value.get("version") == VERSION else None
        elif stage["name"] == "retention-before.json":
            retention_before_marker = value
        elif stage["name"] == "retention.json":
            retention = value
        elif stage["name"] == "audit.json":
            audit = value
        else:
            raise CFError("gc pending contains a foreign stage")
    if (
        not isinstance(roots, list)
        or not isinstance(retention_before_marker, dict)
        or set(retention_before_marker) != {"type", "version", "value"}
        or retention_before_marker.get("type") != "remote_gc_retention_preimage"
        or retention_before_marker.get("version") != VERSION
        or (
            retention_before_marker.get("value") is not None
            and not isinstance(retention_before_marker.get("value"), dict)
        )
        or not isinstance(retention, dict)
        or not isinstance(audit, dict)
    ):
        raise CFError("gc staged plan is incomplete")
    return inventory, roots, retention_before_marker["value"], retention, audit


def _remote_gc_delete_candidate(
    project_root: Path, plan_id: str, item: dict[str, Any]
) -> bool:
    parts = Path(item["path"]).parts
    if len(parts) != 3 or parts[0] != "objects" or parts[1] not in REMOTE_OBJECT_SUBDIRS:
        raise CFError("gc candidate path is not contained")
    objects_fd = _open_directory_nofollow(remote_dirs(project_root)["objects"])
    subdir_fd = -1
    try:
        subdir_fd = _open_directory_at(objects_fd, parts[1])
        quarantine = f".{parts[2]}.gc-removing-{plan_id}"
        original_exists = _entry_exists_at(subdir_fd, parts[2])
        quarantine_exists = _entry_exists_at(subdir_fd, quarantine)
        if original_exists and quarantine_exists:
            raise CFError("gc candidate and quarantine both exist")
        if not original_exists and not quarantine_exists:
            return False
        name = quarantine if quarantine_exists else parts[2]
        raw = _read_regular_bounded_at(subdir_fd, name, 64 * 1024 * 1024)
        metadata = os.stat(name, dir_fd=subdir_fd, follow_symlinks=False)
        identity = item["identity"]
        actual_identity = {
            "device": metadata.st_dev,
            "inode": metadata.st_ino,
            "size": metadata.st_size,
            "mtime_ns": metadata.st_mtime_ns,
        }
        if actual_identity != identity or hashlib.sha256(raw).hexdigest() != item["record_hash"]:
            raise CFError("gc candidate identity or record hash diverged")
        if original_exists:
            _rename_directory_noreplace_at(subdir_fd, parts[2], quarantine)
            os.fsync(subdir_fd)
            quarantined_raw = _read_regular_bounded_at(
                subdir_fd, quarantine, 64 * 1024 * 1024
            )
            quarantined_metadata = os.stat(
                quarantine, dir_fd=subdir_fd, follow_symlinks=False
            )
            quarantined_identity = {
                "device": quarantined_metadata.st_dev,
                "inode": quarantined_metadata.st_ino,
                "size": quarantined_metadata.st_size,
                "mtime_ns": quarantined_metadata.st_mtime_ns,
            }
            if (
                quarantined_identity != identity
                or hashlib.sha256(quarantined_raw).hexdigest()
                != item["record_hash"]
            ):
                raise CFError("gc quarantined candidate identity diverged")
        os.unlink(quarantine, dir_fd=subdir_fd)
        os.fsync(subdir_fd)
        return True
    finally:
        if subdir_fd >= 0:
            os.close(subdir_fd)
        os.close(objects_fd)


def _remote_gc_refresh_jsonl(project_root: Path) -> None:
    gc_fd = _open_directory_nofollow(remote_dirs(project_root)["gc"])
    audit_fd = _open_directory_nofollow(remote_dirs(project_root)["audit"])
    try:
        records: list[dict[str, Any]] = []
        for name in sorted(os.listdir(gc_fd)):
            if not name.endswith(".json"):
                raise CFError("foreign exact GC audit entry is preserved")
            value = json.loads(_read_regular_bounded_at(gc_fd, name, 64 * 1024 * 1024))
            if value.get("type") != "gc_audit" or value.get("version") != VERSION:
                raise CFError("unknown exact GC audit version")
            records.append(value)
        records.sort(
            key=lambda value: (
                int(value.get("created_at_ns", 0)),
                str(value.get("plan_id", "")),
            )
        )
        lines = [canonical_json(value).decode("utf-8") for value in records]
        payload = ("\n".join(lines) + ("\n" if lines else "")).encode("utf-8")
        _write_atomic_durable_at(audit_fd, "gc.jsonl", payload)
    finally:
        os.close(audit_fd)
        os.close(gc_fd)


def _remote_gc_completed_cleanup(
    project_root: Path, pending: dict[str, Any]
) -> dict[str, Any]:
    expected_deleted = 0 if pending.get("dry_run") is True else pending.get("candidate_count")
    if (
        pending.get("deleted_count") != expected_deleted
        or pending.get("retention_published") is not True
        or pending.get("audit_published") is not True
    ):
        raise CFError("completed GC transaction has incomplete durable progress")
    plan_id = pending["plan_id"]
    audit_name = f"{plan_id}.json"
    gc_fd = _open_directory_nofollow(remote_dirs(project_root)["gc"])
    try:
        audit_raw = _read_regular_bounded_at(
            gc_fd, audit_name, 64 * 1024 * 1024
        )
    finally:
        os.close(gc_fd)
    audit_stage = next(
        (
            stage
            for stage in pending["stages"]
            if isinstance(stage, dict) and stage.get("name") == "audit.json"
        ),
        None,
    )
    if (
        not isinstance(audit_stage, dict)
        or hashlib.sha256(audit_raw).hexdigest() != audit_stage.get("hash")
    ):
        raise CFError("completed GC exact audit diverged from its staged hash")
    audit = json.loads(audit_raw)
    if (
        audit.get("type") != "gc_audit"
        or audit.get("version") != VERSION
        or audit.get("plan_id") != plan_id
    ):
        raise CFError("completed GC exact audit is malformed or future")
    retention = _remote_gc_retention_index(project_root, pending.get("generation"))
    retention_hash = None if retention is None else _remote_json_hash(retention)
    if retention_hash != pending["retention_after_hash"]:
        raise CFError("completed GC retention authority diverged")
    transaction_id = pending["transaction_id"]
    expected = {
        stage.get("name"): stage
        for stage in pending["stages"]
        if isinstance(stage, dict) and isinstance(stage.get("name"), str)
    }
    if len(expected) != len(pending["stages"]):
        raise CFError("completed GC stage descriptors are malformed")
    actual = remote_transaction_entry_names(project_root, transaction_id)
    if actual is not None:
        if not actual.issubset(set(expected)):
            raise CFError("completed GC staging contains foreign entries")
        for name in sorted(actual):
            raw = read_remote_transaction_stage(project_root, transaction_id, name)
            stage = expected[name]
            if (
                len(raw) != stage.get("size")
                or hashlib.sha256(raw).hexdigest() != stage.get("hash")
            ):
                raise CFError("completed GC staged cleanup content diverged")
            remove_remote_transaction_stage(
                project_root, transaction_id, name, raw
            )
        remove_empty_remote_transaction_dir(project_root, transaction_id)
    else:
        remove_remote_transaction_dir_quarantine(project_root, transaction_id)
    pending_path = project_root / "pending_transaction.json"
    if read_json(pending_path) != pending:
        raise CFError("completed GC pending marker changed before release")
    pending_path.unlink()
    _sync_directory(project_root)
    _remote_gc_refresh_jsonl(project_root)
    return {
        "reachable_objects": audit["reachable_objects"],
        "objects_protected": audit["objects_protected"],
        "objects_removed": audit["objects_removed"],
        "audit_log": "audit/gc.jsonl",
        "would_remove": [item["object_id"] for item in audit["removed_objects"]]
        if audit["dry_run"]
        else [],
    }


def _remote_gc_resume(
    project_root: Path, actor: str, dry_run: bool, pending: dict[str, Any]
) -> dict[str, Any]:
    expected_fields = {
        "type", "version", "status", "phase", "operation", "transaction_id",
        "plan_id", "actor", "dry_run", "request_hash", "policy_digest", "generation",
        "plan_fingerprint", "root_fingerprint", "inventory_fingerprint",
        "retention_before_hash", "retention_plan_hash", "retention_after_hash",
        "retention_published", "candidate_count", "deleted_count",
        "audit_published", "stages", "created_at", "planned_at_ns",
    }
    if pending.get("status") == "completed":
        expected_fields.add("completed_at")
    request_hash = _remote_json_hash(
        {
            "type": "remote_gc_request", "version": VERSION,
            "stable_project_id": remote_project_stable_id(project_root),
            "actor": actor, "dry_run": bool(dry_run),
        }
    )
    if (
        set(pending) != expected_fields
        or pending.get("type") != "remote_gc_transaction"
        or pending.get("version") != VERSION
        or pending.get("operation") != "remote_gc"
        or pending.get("actor") != actor
        or pending.get("dry_run") is not bool(dry_run)
        or pending.get("request_hash") != request_hash
        or (pending.get("status"), pending.get("phase"))
        not in {("pending", "deleting"), ("completed", "completed")}
    ):
        raise CFError("foreign, future, or different GC transaction is preserved")
    transaction_id = pending.get("transaction_id")
    plan_id = pending.get("plan_id")
    planned_at_ns = pending.get("planned_at_ns")
    if (
        not isinstance(transaction_id, str)
        or not isinstance(plan_id, str)
        or isinstance(planned_at_ns, bool)
        or not isinstance(planned_at_ns, int)
        or planned_at_ns < 0
        or planned_at_ns > time.time_ns()
    ):
        raise CFError("gc pending identity is malformed")
    validate_remote_component(transaction_id, "transaction ID")
    validate_remote_component(plan_id, "GC plan ID")
    if pending.get("status") == "completed":
        return _remote_gc_completed_cleanup(project_root, pending)
    inventory, roots, retention_before, retention_after, audit = (
        _remote_gc_load_stages(project_root, pending)
    )
    if len(inventory) > REMOTE_GC_MAX_OBJECTS or _remote_json_hash(inventory) != pending["inventory_fingerprint"]:
        raise CFError("gc inventory manifest fingerprint diverged")
    if _remote_json_hash(roots) != pending["root_fingerprint"]:
        raise CFError("gc root manifest fingerprint diverged")
    policy, retention_seconds, retention_generations = _remote_gc_policy(
        project_root
    )
    if _remote_json_hash(policy) != pending["policy_digest"]:
        raise CFError("gc policy changed while a plan is pending")
    if current_remote_generation(project_root) != pending["generation"]:
        raise CFError("gc generation changed while a plan is pending")
    if _remote_json_hash(_remote_gc_roots(project_root)) != pending["root_fingerprint"]:
        raise CFError("gc roots changed while a plan is pending")
    if _remote_json_hash(retention_after) != pending["retention_plan_hash"]:
        raise CFError("gc retention postimage diverged")
    retention_before_hash = (
        None
        if retention_before is None
        else _remote_json_hash(retention_before)
    )
    if retention_before_hash != pending["retention_before_hash"]:
        raise CFError("gc retention preimage manifest diverged")
    current_roots = _remote_gc_roots(project_root)
    reachable: set[str] = set()
    stack = [root["id"] for root in current_roots]
    objects_root = remote_dirs(project_root)["objects"]
    while stack:
        oid = stack.pop()
        if oid in reachable:
            continue
        reachable.add(oid)
        stack.extend(object_record_references(load_object_record_from_root(objects_root, oid)))
    base_fields = {"object_id", "type", "path", "record_hash", "identity"}
    decision_fields = base_fields | {"decision", "reason", "delete_index"}
    if any(not isinstance(item, dict) or set(item) != decision_fields for item in inventory):
        raise CFError("gc inventory decision record is malformed")
    expected_inventory, expected_retention, protected_objects, removed_objects = (
        _remote_gc_decide_inventory(
            [{key: item[key] for key in base_fields} for item in inventory],
            reachable,
            retention_before,
            pending["generation"],
            retention_seconds,
            retention_generations,
            pending["planned_at_ns"],
        )
    )
    if inventory != expected_inventory or retention_after != expected_retention:
        raise CFError("gc staged decisions do not match the canonical planner")
    audit_fields = {
        "type", "version", "plan_id", "stable_project_id", "project", "actor",
        "dry_run", "policy_digest", "retention_seconds", "retention_generations",
        "current_generation", "root_fingerprint", "inventory_fingerprint",
        "reachable_objects", "objects_protected", "objects_removed",
        "removed_objects", "protected_objects", "created_at", "created_at_ns",
    }
    expected_audit_values = {
        "type": "gc_audit",
        "version": VERSION,
        "plan_id": plan_id,
        "stable_project_id": remote_project_stable_id(project_root),
        "actor": actor,
        "dry_run": bool(dry_run),
        "policy_digest": pending["policy_digest"],
        "retention_seconds": retention_seconds,
        "retention_generations": retention_generations,
        "current_generation": pending["generation"],
        "root_fingerprint": pending["root_fingerprint"],
        "inventory_fingerprint": pending["inventory_fingerprint"],
        "reachable_objects": len(reachable),
        "objects_protected": len(protected_objects),
        "objects_removed": len(removed_objects),
        "removed_objects": removed_objects,
        "protected_objects": protected_objects,
        "created_at": pending["created_at"],
        "created_at_ns": pending["planned_at_ns"],
    }
    if (
        not isinstance(audit, dict)
        or set(audit) != audit_fields
        or not isinstance(audit.get("project"), dict)
        or any(audit.get(key) != value for key, value in expected_audit_values.items())
    ):
        raise CFError("gc staged audit does not match the canonical planner")
    recomputed_plan_fingerprint = _remote_json_hash(
        {
            "policy": policy,
            "roots": roots,
            "inventory": inventory,
            "retention_before": retention_before,
            "retention_after": retention_after,
            "audit": audit,
        }
    )
    if recomputed_plan_fingerprint != pending["plan_fingerprint"]:
        raise CFError("gc plan fingerprint diverged")
    allowed_quarantines = {
        f"objects/{Path(item['path']).parts[1]}/.{Path(item['path']).name}.gc-removing-{plan_id}"
        for item in expected_inventory
        if item["decision"] == "delete"
    }
    current_inventory = {
        item["path"]: item
        for item in _remote_gc_inventory(project_root, allowed_quarantines)
    }
    initial_paths = {item["path"] for item in inventory}
    if not set(current_inventory).issubset(initial_paths):
        raise CFError("gc object inventory gained a foreign entry")
    deleted_count = pending.get("deleted_count")
    candidate_count = pending.get("candidate_count")
    if (
        not isinstance(deleted_count, int) or not isinstance(candidate_count, int)
        or deleted_count < 0 or deleted_count > candidate_count
    ):
        raise CFError("gc deletion progress is malformed")
    candidates = sorted(
        (item for item in inventory if item.get("decision") == "delete"),
        key=lambda item: item.get("delete_index", -1),
    )
    if len(candidates) != candidate_count or [item.get("delete_index") for item in candidates] != list(range(candidate_count)):
        raise CFError("gc candidate order is malformed")
    for item in inventory:
        current = current_inventory.get(item["path"])
        index = item.get("delete_index")
        may_be_absent = (
            not dry_run and item.get("decision") == "delete"
            and isinstance(index, int) and index <= deleted_count
        )
        if current is None and not may_be_absent:
            raise CFError("gc inventory entry disappeared outside recorded progress")
        if current is not None and (
            current["record_hash"] != item.get("record_hash")
            or current["identity"] != item.get("identity")
        ):
            raise CFError("gc inventory identity diverged")
        if isinstance(index, int) and index < deleted_count and current is not None:
            raise CFError("gc recorded deletion is still present")
    retention_path = project_root / "retention_index.json"
    current_retention = _remote_gc_retention_index(
        project_root, pending["generation"]
    )
    current_retention_hash = None if current_retention is None else _remote_json_hash(current_retention)
    if not pending["retention_published"]:
        if dry_run:
            if current_retention_hash != pending["retention_before_hash"]:
                raise CFError("dry-run GC retention authority changed")
        elif current_retention_hash == pending["retention_before_hash"]:
            write_remote_publication_json_durable(retention_path, retention_after)
        elif current_retention_hash != pending["retention_after_hash"]:
            raise CFError("gc retention authority diverged at publication boundary")
        pending["retention_published"] = True
        write_remote_publication_json_durable(project_root / "pending_transaction.json", pending)
    elif current_retention_hash != pending["retention_after_hash"]:
        raise CFError("gc retention authority diverged after publication")
    if not dry_run:
        for item in candidates[deleted_count:]:
            _remote_gc_delete_candidate(project_root, plan_id, item)
            deleted_count += 1
            pending["deleted_count"] = deleted_count
            write_remote_publication_json_durable(project_root / "pending_transaction.json", pending)
    elif deleted_count != 0:
        raise CFError("dry-run GC recorded deletion progress")
    audit_path = remote_dirs(project_root)["gc"] / f"{plan_id}.json"
    audit_raw = canonical_json(audit)
    gc_fd = _open_directory_nofollow(remote_dirs(project_root)["gc"])
    try:
        try:
            _write_create_noreplace_at(gc_fd, f"{plan_id}.json", audit_raw)
        except FileExistsError:
            if _read_regular_bounded_at(gc_fd, f"{plan_id}.json", 64 * 1024 * 1024) != audit_raw:
                raise CFError("exact GC audit authority diverged")
    finally:
        os.close(gc_fd)
    if not pending["audit_published"]:
        pending["audit_published"] = True
        write_remote_publication_json_durable(project_root / "pending_transaction.json", pending)
    if pending["status"] != "completed":
        pending["status"] = "completed"
        pending["phase"] = "completed"
        pending["completed_at"] = now_iso()
        write_remote_publication_json_durable(project_root / "pending_transaction.json", pending)
    for stage in pending["stages"]:
        raw = read_remote_transaction_stage(project_root, transaction_id, stage["name"])
        remove_remote_transaction_stage(project_root, transaction_id, stage["name"], raw)
    remove_empty_remote_transaction_dir(project_root, transaction_id)
    current_pending = read_json(project_root / "pending_transaction.json")
    if current_pending != pending:
        raise CFError("gc pending transaction changed before release")
    os.unlink(project_root / "pending_transaction.json")
    _sync_directory(project_root)
    _remote_gc_refresh_jsonl(project_root)
    return {
        "reachable_objects": audit["reachable_objects"],
        "objects_protected": audit["objects_protected"],
        "objects_removed": audit["objects_removed"],
        "audit_log": (remote_dirs(project_root)["audit"] / "gc.jsonl")
        .relative_to(project_root)
        .as_posix(),
        "would_remove": [item["object_id"] for item in audit["removed_objects"]] if dry_run else [],
    }


def remote_gc_payload(project_root: Path, project: dict[str, Any], actor: str, dry_run: bool) -> dict[str, Any]:
    dirs = remote_dirs(project_root)
    with remote_project_gate(project_root), stable_remote_lock(dirs["locks"] / "gc.lock"):
        recover_remote_pending_quarantine(project_root)
        pending = read_json(project_root / "pending_transaction.json")
        if pending is None:
            plan = _remote_gc_prepare_plan(project_root, project, actor, dry_run)
            pending = _remote_gc_stage_plan(project_root, actor, dry_run, plan)
        if not isinstance(pending, dict):
            raise CFError("foreign or malformed remote pending transaction is preserved")
        return _remote_gc_resume(project_root, actor, dry_run, pending)


def sealed_commit_reference_errors(
    objects_root: Path,
    refs: list[tuple[str, str]],
    *,
    session: Any = None,
) -> list[str]:
    errors = []
    owns_session = session is None
    if session is None:
        ledger = DecisionWorkLedger(
            DecisionWorkProfile.local_v1(), "sealed reference validation"
        )
        session = SealedCommitValidationSession(objects_root, ledger)
    else:
        ledger = session.ledger
    error_output_bytes = 0
    try:
        for label, commit_id in refs:
            try:
                session.validate_commit(commit_id)
            except (ResourceBudgetExceeded, SealedValidationSubjectChanged):
                raise
            except CFError as exc:
                error_bytes = (
                    len(label.encode("utf-8"))
                    + len(commit_id.encode("utf-8"))
                    + len(str(exc).encode("utf-8"))
                    + 68
                )
                ledger.acquire("retained_bytes", error_bytes, "query")
                session.adopt_aux_retained(error_bytes)
                error_output_bytes += error_bytes
                errors.append(f"{label}: {commit_id}: {exc}")
        if owns_session:
            session.finalize(terminate=False)
        sort_scratch = error_output_bytes + 8 * len(errors)
        ledger.acquire("temporary_bytes", sort_scratch, "query")
        try:
            result = sorted(errors)
        finally:
            ledger.release("temporary_bytes", sort_scratch)
        if owns_session:
            ledger.terminate("complete")
        return result
    finally:
        if owns_session:
            session.close(None)


MERGE_REQUEST_SUBJECT_FIELDS = {
    "type",
    "version",
    "merge_request_id",
    "source_project_id",
    "target_project_id",
    "source_branch",
    "target_branch",
    "source_head",
    "target_head_at_request",
    "source_object_set_digest",
}
MERGE_REQUEST_REVIEW_FIELDS = {"reviewer", "decision", "comment", "subject_digest", "reviewed_at"}


def reject_legacy_cross_project_merge_request_read(
    mr: dict[str, Any], source_project_root: Path, target_project_root: Path
) -> None:
    if "subject" not in mr and source_project_root != target_project_root:
        raise CFError(
            "legacy cross-project merge request cannot be read without holding both "
            "project gates; run request-review to materialize its target-local subject"
        )


def canonical_remote_object_records(
    records: list[dict[str, Any]],
) -> list[dict[str, Any]]:
    canonical = sorted(
        records,
        key=lambda record: str(record.get("object_id", ""))
        if isinstance(record, dict)
        else "",
    )
    seen: set[str] = set()
    for record in canonical:
        object_id = record.get("object_id") if isinstance(record, dict) else None
        if not isinstance(object_id, str) or not object_id:
            raise CFError("remote object set contains a record without an object ID")
        if object_id in seen:
            raise CFError("remote object set contains a duplicate object ID")
        seen.add(object_id)
    return canonical


def merge_request_object_set_digest(records: list[dict[str, Any]]) -> str:
    return "sha256:" + hashlib.sha256(
        canonical_json(canonical_remote_object_records(records))
    ).hexdigest()


def build_merge_request_subject(
    mr_id: str,
    source: dict[str, Any],
    target: dict[str, Any],
    source_head: str,
    target_head: str,
    object_set_digest: str,
) -> dict[str, Any]:
    return {
        "type": "codefire_merge_request_subject",
        "version": VERSION,
        "merge_request_id": mr_id,
        "source_project_id": remote_project_stable_id(source["project_root"]),
        "target_project_id": remote_project_stable_id(target["project_root"]),
        "source_branch": source["branch"],
        "target_branch": target["branch"],
        "source_head": source_head,
        "target_head_at_request": target_head,
        "source_object_set_digest": object_set_digest,
    }


def merge_request_subject_digest(subject: dict[str, Any]) -> str:
    return "sha256:" + hashlib.sha256(canonical_json(subject)).hexdigest()


def validate_merge_request_subject(
    mr: dict[str, Any], source: dict[str, Any], target: dict[str, Any]
) -> str:
    subject = mr.get("subject")
    if "subject" not in mr:
        raise CFError("legacy merge request requires a new subject-bound review before apply")
    if not isinstance(subject, dict):
        raise CFError("merge request subject is malformed")
    source_head = mr.get("source_head")
    if not isinstance(source_head, str):
        raise CFError("merge request subject does not match the current request")
    escrow_records = collect_object_records(remote_dirs(target["project_root"])["objects"], source_head)
    source_project_id = subject.get("source_project_id")
    valid_source_project_id = (
        isinstance(source_project_id, str)
        and source_project_id.startswith("CF-PROJECT-")
        and len(source_project_id.removeprefix("CF-PROJECT-")) == 32
        and all(character in "0123456789abcdefABCDEF" for character in source_project_id.removeprefix("CF-PROJECT-"))
    )
    valid = (
        set(subject) == MERGE_REQUEST_SUBJECT_FIELDS
        and subject.get("type") == "codefire_merge_request_subject"
        and subject.get("version") == VERSION
        and subject.get("merge_request_id") == mr.get("id")
        and valid_source_project_id
        and subject.get("target_project_id") == remote_project_stable_id(target["project_root"])
        and subject.get("source_branch") == source.get("branch")
        and subject.get("target_branch") == target.get("branch")
        and subject.get("source_head") == source_head
        and subject.get("target_head_at_request") == mr.get("target_head_at_request")
        and subject.get("source_object_set_digest") == merge_request_object_set_digest(escrow_records)
    )
    if not valid:
        raise CFError("merge request subject does not match the current request")
    digest = merge_request_subject_digest(subject)
    if mr.get("subject_digest") != digest:
        raise CFError("merge request subject digest diverged")
    return digest


def materialize_merge_request_subject(
    mr: dict[str, Any], source: dict[str, Any], target: dict[str, Any]
) -> str:
    if "subject" in mr:
        return validate_merge_request_subject(mr, source, target)
    reviews = mr.get("reviews")
    if isinstance(reviews, list) and reviews:
        if "legacy_review_history" in mr:
            raise CFError("legacy merge request review history is already materialized")
        mr["legacy_review_history"] = {
            "version": VERSION,
            "reason": "unbound_before_subject_v1",
            "reviews": reviews,
        }
        mr["reviews"] = []
    source_head = mr.get("source_head")
    target_head = mr.get("target_head_at_request")
    if not isinstance(source_head, str) or not isinstance(target_head, str):
        raise CFError("legacy merge request cannot materialize a subject")
    records = collect_object_records(remote_dirs(source["project_root"])["objects"], source_head)
    copy_object_graph(
        remote_dirs(source["project_root"])["objects"],
        remote_dirs(target["project_root"])["objects"],
        source_head,
    )
    subject = build_merge_request_subject(
        str(mr.get("id", "")),
        source,
        target,
        source_head,
        target_head,
        merge_request_object_set_digest(records),
    )
    digest = merge_request_subject_digest(subject)
    mr["subject"] = subject
    mr["subject_digest"] = digest
    return digest


def merge_request_has_effective_approval(mr: dict[str, Any], subject_digest: str) -> bool:
    reviews = mr.get("reviews")
    if not isinstance(reviews, list) or not reviews:
        return False
    for review in reviews:
        if (
            not isinstance(review, dict)
            or set(review) != MERGE_REQUEST_REVIEW_FIELDS
            or not isinstance(review.get("reviewer"), str)
            or not isinstance(review.get("comment"), str)
            or not isinstance(review.get("reviewed_at"), str)
            or not isinstance(review.get("subject_digest"), str)
            or review.get("decision") not in {"approve", "reject"}
        ):
            raise CFError("merge request review has an invalid or future schema")
    effective = reviews[-1]
    expected_status = "approved" if effective["decision"] == "approve" else "rejected"
    if mr.get("status") != expected_status:
        raise CFError("merge request status diverges from its effective review")
    return effective["decision"] == "approve" and effective["subject_digest"] == subject_digest


def validate_merge_request_record(mr: dict[str, Any]) -> None:
    validate_persisted_record_version(mr, "remote_merge_request")
    validate_remote_component(str(mr.get("id", "")), "merge-request ID")
    source = parse_cf_url(mr["source_url"])
    target = parse_cf_url(mr["target_url"])
    source_objects = (
        remote_dirs(target["project_root"])["objects"]
        if "subject" in mr
        else remote_dirs(source["project_root"])["objects"]
    )
    refs = [
        ("source_head", source_objects, mr.get("source_head")),
        ("target_head_at_request", remote_dirs(target["project_root"])["objects"], mr.get("target_head_at_request")),
    ]
    if mr.get("applied_head"):
        refs.append(("applied_head", remote_dirs(target["project_root"])["objects"], mr.get("applied_head")))
    for key, objects_root, commit_id in refs:
        if not isinstance(commit_id, str):
            raise CFError(f"merge request validation failed: {key} must be a commit object id")
        try:
            validate_sealed_commit(objects_root, commit_id)
        except CFError as exc:
            raise CFError(f"merge request validation failed: {key}: {exc}") from exc
    if "subject" in mr:
        validate_merge_request_subject(mr, source, target)


def validate_persisted_record_version(record: Any, contract: str) -> None:
    if not isinstance(record, dict):
        raise CFError(f"{contract} must be an object")
    version = record.get("version")
    if isinstance(version, bool) or version != 1:
        if version is None:
            raise CFError(f"{contract}.version is required")
        raise CFError(f"unsupported {contract}.version {version}; readable version is 1")


def validate_remote_branch_record(branch: Any) -> dict[str, Any]:
    validate_persisted_record_version(branch, "remote_branch")
    validate_remote_component(str(branch.get("name", "")), "branch")
    head = branch.get("head")
    if not isinstance(head, str) or not head.startswith("CF-COMMIT-"):
        raise CFError("remote branch head is not a commit object ID")
    return branch


def read_remote_branch_record(project_root: Path, branch: str) -> dict[str, Any] | None:
    record = read_json(remote_branch_path(project_root, branch))
    if record is None:
        return None
    return validate_remote_branch_record(record)


class RetainedObjectDocument:
    def __init__(
        self,
        object_id: str,
        path: Path | None,
        record: dict[str, Any],
        physical_bytes: int,
        retained_bytes: int,
        digest: str | None,
        subdir: str | None = None,
        file_name: str | None = None,
    ) -> None:
        self.object_id = object_id
        self.path = path
        self.record = record
        self.physical_bytes = physical_bytes
        self.retained_bytes = retained_bytes
        self.digest = digest
        self.subdir = subdir
        self.file_name = file_name


class SealedCommitValidationSession:
    """One command-scoped memo and snapshot boundary for sealed validation."""

    def __init__(self, objects_root: Path, ledger: DecisionWorkLedger) -> None:
        self.objects_root = Path(os.path.abspath(objects_root))
        self.ledger = ledger
        self.documents: dict[str, RetainedObjectDocument] = {}
        self.validated_commits: set[str] = set()
        self.closed = False
        self.finalized = False
        self._frame_bytes = 0
        self._aux_retained_bytes = 0
        self.scanned_object_records = 0
        self._validation_active = False
        self._subdir_fds: dict[str, tuple[int, tuple[int, int]]] = {}
        try:
            self._root_fd = _open_directory_nofollow(self.objects_root)
        except OSError as exc:
            raise CFError(f"object store is unavailable: {self.objects_root}") from exc
        root_stat = os.fstat(self._root_fd)
        self._root_identity = (root_stat.st_dev, root_stat.st_ino)

    @staticmethod
    def _object_location(object_id: str) -> tuple[str, str]:
        return exact_object_record_location(object_id)

    def _subdir_fd(self, subdir: str) -> int:
        retained = self._subdir_fds.get(subdir)
        if retained is not None:
            return retained[0]
        flags = os.O_RDONLY | getattr(os, "O_DIRECTORY", 0) | getattr(os, "O_NOFOLLOW", 0)
        try:
            fd = os.open(subdir, flags, dir_fd=self._root_fd)
        except OSError as exc:
            raise CFError(f"object store directory is unavailable: {subdir}") from exc
        metadata = os.fstat(fd)
        self._subdir_fds[subdir] = (fd, (metadata.st_dev, metadata.st_ino))
        return fd

    def _check_store_identity(self) -> None:
        def changed(path: Path) -> SealedValidationSubjectChanged:
            return SealedValidationSubjectChanged(
                "<object-store>", path, "store_identity_changed", 0, None
            )

        try:
            root = os.fstat(self._root_fd)
        except OSError as exc:
            raise changed(self.objects_root) from exc
        if (root.st_dev, root.st_ino) != self._root_identity:
            raise changed(self.objects_root)
        for subdir, (fd, expected) in self._subdir_fds.items():
            try:
                actual = os.fstat(fd)
            except OSError as exc:
                raise changed(self.objects_root / subdir) from exc
            if (actual.st_dev, actual.st_ino) != expected:
                raise changed(self.objects_root / subdir)
        try:
            ambient_root_fd = _open_directory_nofollow(self.objects_root)
        except OSError as exc:
            raise changed(self.objects_root) from exc
        try:
            try:
                ambient_root = os.fstat(ambient_root_fd)
            except OSError as exc:
                raise changed(self.objects_root) from exc
            if (ambient_root.st_dev, ambient_root.st_ino) != self._root_identity:
                raise changed(self.objects_root)
            flags = (
                os.O_RDONLY
                | getattr(os, "O_DIRECTORY", 0)
                | getattr(os, "O_NOFOLLOW", 0)
            )
            for subdir, (_, expected) in self._subdir_fds.items():
                ambient_subdir_fd = -1
                try:
                    ambient_subdir_fd = os.open(
                        subdir, flags, dir_fd=ambient_root_fd
                    )
                    ambient_subdir = os.fstat(ambient_subdir_fd)
                    if (ambient_subdir.st_dev, ambient_subdir.st_ino) != expected:
                        raise changed(self.objects_root / subdir)
                except SealedValidationSubjectChanged:
                    raise
                except OSError as exc:
                    raise changed(self.objects_root / subdir) from exc
                finally:
                    if ambient_subdir_fd >= 0:
                        os.close(ambient_subdir_fd)
        finally:
            os.close(ambient_root_fd)

    def _read_exact_bounded(
        self,
        object_id: str,
        subdir: str,
        file_name: str,
        charge: Any,
        *,
        revalidation: bool,
        expected_document: RetainedObjectDocument | None = None,
    ) -> tuple[bytes, int, tuple[int, int]]:
        directory_fd = self._subdir_fd(subdir)
        flags = os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0)
        display_path = self.objects_root / subdir / file_name
        try:
            initial = os.stat(
                file_name,
                dir_fd=directory_fd,
                follow_symlinks=False,
            )
        except OSError as exc:
            if revalidation and expected_document is not None:
                raise SealedValidationSubjectChanged(
                    object_id,
                    display_path,
                    "unreadable",
                    expected_document.physical_bytes,
                    None,
                ) from exc
            raise CFError(f"object not found: {object_id}") from exc
        try:
            fd = os.open(file_name, flags, dir_fd=directory_fd)
        except OSError as exc:
            if revalidation and expected_document is not None:
                raise SealedValidationSubjectChanged(
                    object_id,
                    display_path,
                    "unreadable",
                    expected_document.physical_bytes,
                    None,
                ) from exc
            raise CFError(f"object not found: {object_id}") from exc
        try:
            before = os.fstat(fd)
            initial_identity = (initial.st_dev, initial.st_ino)
            opened_identity = (before.st_dev, before.st_ino)
            if (
                not stat.S_ISREG(initial.st_mode)
                or not stat.S_ISREG(before.st_mode)
                or initial.st_nlink != 1
                or before.st_nlink != 1
                or initial_identity != opened_identity
                or initial.st_size != before.st_size
            ):
                if revalidation and expected_document is not None:
                    raise SealedValidationSubjectChanged(
                        object_id,
                        display_path,
                        "identity_changed",
                        expected_document.physical_bytes,
                        before.st_size,
                    )
                raise CFError(f"object record identity is invalid: {display_path}")
            size = before.st_size
            if size > MAX_OBJECT_RECORD_BYTES:
                if revalidation and expected_document is not None:
                    raise SealedValidationSubjectChanged(
                        object_id,
                        display_path,
                        "size_changed",
                        expected_document.physical_bytes,
                        size,
                    )
                raise CFError(
                    "object record exceeds the "
                    f"{MAX_OBJECT_RECORD_BYTES}-byte limit at {display_path}: {size} bytes"
                )
            charge(size)
            buffer = bytearray()
            while len(buffer) < size:
                chunk = os.read(fd, min(64 * 1024, size - len(buffer)))
                if not chunk:
                    break
                buffer.extend(chunk)
            extension = os.read(fd, 1)
            after = os.fstat(fd)
            identity_before = (before.st_dev, before.st_ino)
            identity_after = (after.st_dev, after.st_ino)
            try:
                named = os.stat(
                    file_name,
                    dir_fd=directory_fd,
                    follow_symlinks=False,
                )
            except OSError as exc:
                if revalidation and expected_document is not None:
                    raise SealedValidationSubjectChanged(
                        object_id,
                        display_path,
                        "unreadable",
                        expected_document.physical_bytes,
                        None,
                    ) from exc
                raise SealedValidationSubjectChanged(
                    object_id, display_path, "unreadable", size, None
                ) from exc
            named_identity = (named.st_dev, named.st_ino)
            if (
                len(buffer) != size
                or extension
                or identity_before != identity_after
                or after.st_size != size
                or after.st_nlink != 1
                or not stat.S_ISREG(named.st_mode)
                or named.st_nlink != 1
                or named_identity != identity_before
                or named.st_size != size
            ):
                actual_size = named.st_size
                if revalidation and expected_document is not None:
                    raise SealedValidationSubjectChanged(
                        object_id,
                        display_path,
                        "size_changed",
                        expected_document.physical_bytes,
                        actual_size,
                    )
                raise SealedValidationSubjectChanged(
                    object_id, display_path, "size_changed", size, actual_size
                )
            return bytes(buffer), size, identity_before
        finally:
            os.close(fd)

    def _ensure_open(self) -> None:
        if self.closed:
            raise CFError("sealed validation session is closed")

    def __del__(self) -> None:
        try:
            self.close(None)
        except Exception:
            pass

    def adopt_aux_retained(self, amount: int) -> None:
        self._ensure_open()
        self._aux_retained_bytes += amount

    @staticmethod
    def _frame_size(object_id: str) -> int:
        return 256 + len(object_id.encode("utf-8"))

    def _charge_frame(
        self, object_id: str, depth: int, frontier: int, *, edge: bool
    ) -> None:
        frame_bytes = self._frame_size(object_id)
        charges = {"graph_edges": 1} if edge else None
        counters = {"frontier_insertion_attempts": 1}
        if edge:
            counters["edge_occurrences"] = 1
        self.ledger.apply(
            "graph_discovery",
            charges=charges,
            maxima={"logical_depth": depth, "maximum_frontier": frontier},
            acquires={"retained_bytes": frame_bytes},
            counters=counters,
        )
        self._frame_bytes += frame_bytes

    def _release_frame(self, object_id: str) -> None:
        frame_bytes = self._frame_size(object_id)
        self._frame_bytes -= frame_bytes
        self.ledger.release("retained_bytes", frame_bytes)

    def _charge_root_edge(self) -> None:
        self.ledger.apply(
            "graph_discovery",
            charges={"graph_edges": 1},
            counters={"edge_occurrences": 1},
        )

    def _load_payload_unprotected(self, object_id: str) -> Any:
        self._ensure_open()
        retained = self.documents.get(object_id)
        if retained is not None:
            self.ledger.count("memo_hits", 1, "record_read")
            return retained.record["payload"]

        subdir, file_name = self._object_location(object_id)
        path = self.objects_root / subdir / file_name
        if load_object_from_root is not _DEFAULT_LOAD_OBJECT_FROM_ROOT and not path.exists():
            # Preserve the injectable loader used by the iterative cycle test
            # and treat such values as in-memory overlay documents.
            try:
                payload = load_object_from_root(self.objects_root, object_id)
            except CFError:
                raise
            record = {"payload": payload}
            retained_bytes = canonical_json_size(record)
            self.ledger.apply(
                "record_read",
                acquires={"retained_bytes": retained_bytes},
                counters={"memo_misses": 1, "unique_nodes_discovered": 1},
            )
            self.documents[object_id] = RetainedObjectDocument(
                object_id, None, record, 0, retained_bytes, None
            )
            return payload

        scratch_bytes = 0
        def charge_read(expected_size: int) -> None:
            nonlocal scratch_bytes
            requested_scratch = expected_size * 2
            self.ledger.apply(
                "record_read",
                charges={"aggregate_bytes": expected_size, "object_records": 1},
                acquires={"temporary_bytes": requested_scratch},
                counters={
                    "files_read": 1,
                    "file_bytes_read": expected_size,
                    "bytes_hashed": expected_size,
                    "record_reads": 1,
                    "memo_misses": 1,
                    "unique_nodes_discovered": 1,
                    "object_records": 1,
                },
            )
            scratch_bytes = requested_scratch
        retained_bytes = 0
        raw: bytes | None = None
        try:
            raw, expected_size, _ = self._read_exact_bounded(
                object_id,
                subdir,
                file_name,
                charge_read,
                revalidation=False,
            )
            digest = hashlib.sha256(raw).hexdigest()
            try:
                record = json.loads(raw)
            except (UnicodeDecodeError, json.JSONDecodeError) as exc:
                raise CFError(f"invalid object JSON: {path}: {exc}") from exc
            validate_object_record(record, expected_oid=object_id, path=path)
            self.ledger.count("semantic_validations", 1, "semantic_validation")
            retained_bytes = canonical_json_size(record)
            self.ledger.acquire("retained_bytes", retained_bytes, "record_read")
            retained = RetainedObjectDocument(
                object_id,
                path,
                record,
                expected_size,
                retained_bytes,
                digest,
                subdir,
                file_name,
            )
            self.documents[object_id] = retained
            raw = None
            return record["payload"]
        except Exception:
            if retained_bytes:
                self.ledger.release("retained_bytes", retained_bytes)
            raise
        finally:
            raw = None
            if scratch_bytes:
                self.ledger.release("temporary_bytes", scratch_bytes)

    def load_payload(self, object_id: str) -> Any:
        try:
            return self._load_payload_unprotected(object_id)
        except SealedValidationSubjectChanged:
            if not self._validation_active:
                self.close("subject_changed")
            raise
        except ResourceBudgetExceeded:
            if not self._validation_active:
                self.close(None)
            raise

    def _accounted_sorted_directory_names(
        self, directory_fd: int
    ) -> tuple[list[str], int]:
        names: list[str] = []
        names_bytes = 0
        try:
            with os.scandir(directory_fd) as entries:
                for entry in entries:
                    name_bytes = len(entry.name.encode("utf-8")) + 64
                    self.ledger.acquire(
                        "temporary_bytes", name_bytes, "graph_discovery"
                    )
                    names_bytes += name_bytes
                    names.append(entry.name)
            sort_scratch = names_bytes + 8 * len(names)
            self.ledger.acquire("temporary_bytes", sort_scratch, "query")
            try:
                names.sort()
            finally:
                self.ledger.release("temporary_bytes", sort_scratch)
            return names, names_bytes
        except Exception:
            names.clear()
            if names_bytes:
                self.ledger.release("temporary_bytes", names_bytes)
            raise

    def scan_object_hash_errors(self) -> list[Path]:
        """Validate every exact object record once through this session memo."""
        self._ensure_open()
        bad: list[Path] = []
        for type_tag in OBJECT_PREFIXES:
            subdir = object_subdir(type_tag)
            try:
                directory_fd = self._subdir_fd(subdir)
            except CFError:
                continue
            names, names_bytes = self._accounted_sorted_directory_names(
                directory_fd
            )
            try:
                for name in names:
                    self.ledger.apply(
                        "graph_discovery",
                        maxima={"maximum_frontier": 1},
                        counters={"frontier_insertion_attempts": 1},
                    )
                    path = self.objects_root / subdir / name
                    if not name.endswith(".json"):
                        path_bytes = len(str(path).encode("utf-8")) + 32
                        self.ledger.acquire(
                            "retained_bytes", path_bytes, "graph_discovery"
                        )
                        self.adopt_aux_retained(path_bytes)
                        bad.append(path)
                        continue
                    self.scanned_object_records += 1
                    object_id = name[:-5]
                    try:
                        expected_subdir, expected_name = exact_object_record_location(
                            object_id
                        )
                        if expected_subdir != subdir or expected_name != name:
                            raise CFError("object filename/type mismatch")
                        self.load_payload(object_id)
                    except (ResourceBudgetExceeded, SealedValidationSubjectChanged):
                        raise
                    except (CFError, OSError):
                        path_bytes = len(str(path).encode("utf-8")) + 32
                        self.ledger.acquire(
                            "retained_bytes", path_bytes, "graph_discovery"
                        )
                        self.adopt_aux_retained(path_bytes)
                        bad.append(path)
            finally:
                names.clear()
                if names_bytes:
                    self.ledger.release("temporary_bytes", names_bytes)
        scratch = sum(len(str(path).encode("utf-8")) + 32 for path in bad)
        self.ledger.acquire("temporary_bytes", scratch, "query")
        try:
            return sorted(bad)
        finally:
            self.ledger.release("temporary_bytes", scratch)

    def missing_references(self, roots: list[str]) -> list[str]:
        """Traverse references through the same document memo used by validation."""
        self._ensure_open()
        missing: set[str] = set()
        seen: set[str] = set()
        missing_output_bytes = 0
        stack: list[str] = []
        stack_bytes = 0
        try:
            for root in reversed(roots):
                frame_bytes = self._frame_size(root)
                self.ledger.apply(
                    "graph_discovery",
                    maxima={"maximum_frontier": len(stack) + 1},
                    acquires={"retained_bytes": frame_bytes},
                    counters={"frontier_insertion_attempts": 1},
                )
                stack_bytes += frame_bytes
                stack.append(root)
            while stack:
                object_id = stack.pop()
                frame_bytes = self._frame_size(object_id)
                stack_bytes -= frame_bytes
                self.ledger.release("retained_bytes", frame_bytes)
                if object_id in seen:
                    self.ledger.count("revisits", 1, "graph_discovery")
                    continue
                seen.add(object_id)
                try:
                    self.load_payload(object_id)
                    record = self.documents[object_id].record
                except (ResourceBudgetExceeded, SealedValidationSubjectChanged):
                    raise
                except CFError:
                    if object_record_path(self.objects_root, object_id) is not None:
                        continue
                    missing_bytes = len(object_id.encode("utf-8")) + 32
                    self.ledger.acquire(
                        "retained_bytes", missing_bytes, "graph_discovery"
                    )
                    self.adopt_aux_retained(missing_bytes)
                    missing_output_bytes += missing_bytes
                    missing.add(object_id)
                    continue
                references = object_record_references(record)
                for reference in reversed(references):
                    frame_bytes = self._frame_size(reference)
                    self.ledger.apply(
                        "graph_discovery",
                        charges={"graph_edges": 1},
                        maxima={"maximum_frontier": len(stack) + 1},
                        acquires={"retained_bytes": frame_bytes},
                        counters={
                            "edge_occurrences": 1,
                            "frontier_insertion_attempts": 1,
                        },
                    )
                    stack_bytes += frame_bytes
                    stack.append(reference)
            sort_scratch = missing_output_bytes + 8 * len(missing)
            self.ledger.acquire("temporary_bytes", sort_scratch, "query")
            try:
                return sorted(missing)
            finally:
                self.ledger.release("temporary_bytes", sort_scratch)
        except SealedValidationSubjectChanged:
            self.close("subject_changed")
            raise
        except ResourceBudgetExceeded:
            self.close(None)
            raise
        finally:
            if stack_bytes:
                self.ledger.release("retained_bytes", stack_bytes)

    def validate_commit(self, commit_id: str) -> None:
        self._ensure_open()
        active: set[str] = set()
        charged_frames: list[str] = []
        stack: list[tuple[Any, ...]] = []
        terminal_failure: str | None = None
        self._validation_active = True
        try:
            self._charge_frame(commit_id, 0, 1, edge=False)
            charged_frames.append(commit_id)
            stack.append(("enter", commit_id, 0))
            while stack:
                frame = stack.pop()
                action = frame[0]
                if action == "enter":
                    current, depth = frame[1], frame[2]
                    if current in self.validated_commits:
                        self.ledger.apply(
                            "semantic_validation",
                            counters={"memo_hits": 1, "revisits": 1},
                        )
                        charged_frames.remove(current)
                        self._release_frame(current)
                        continue
                    if current in active:
                        raise CFError(
                            "sealed commit validation failed: "
                            f"parent cycle detected at {current}"
                        )
                    active.add(current)
                    commit = self.load_payload(current)
                    if not isinstance(commit, dict) or commit.get("type") != "commit":
                        raise CFError(f"not a commit object: {current}")
                    parents = commit.get("parents")
                    if not isinstance(parents, list):
                        raise CFError(
                            "sealed commit validation failed: parents must be a list"
                        )
                    stack.append(("parent", current, commit, parents, 0, depth))
                    continue

                if action == "parent":
                    current, commit, parents, index, depth = frame[1:]
                    if index >= len(parents):
                        stack.append(("finish", current, commit))
                        continue
                    parent = parents[index]
                    if not isinstance(parent, str) or not parent.startswith("CF-COMMIT-"):
                        raise CFError(
                            "sealed commit validation failed: "
                            f"parent {index} must be a commit object id"
                        )
                    stack.append(
                        ("parent", current, commit, parents, index + 1, depth)
                    )
                    child_depth = depth + 1
                    self._charge_frame(
                        parent, child_depth, len(stack) + 1, edge=True
                    )
                    charged_frames.append(parent)
                    stack.append(("enter", parent, child_depth))
                    continue

                current, commit = frame[1], frame[2]
                self.ledger.apply(
                    "semantic_validation",
                    charges={"graph_nodes": 1},
                    counters={"semantic_validations": 1},
                )
                _validate_sealed_commit_payload(
                    commit, self.load_payload, self._charge_root_edge
                )
                active.remove(current)
                self.validated_commits.add(current)
                charged_frames.remove(current)
                self._release_frame(current)
        except SealedValidationSubjectChanged:
            terminal_failure = "subject_changed"
            raise
        except ResourceBudgetExceeded:
            terminal_failure = "budget_exceeded"
            raise
        finally:
            remaining_frame_bytes = sum(
                self._frame_size(object_id) for object_id in charged_frames
            )
            stack.clear()
            active.clear()
            charged_frames.clear()
            if remaining_frame_bytes:
                self._frame_bytes -= remaining_frame_bytes
                self.ledger.release("retained_bytes", remaining_frame_bytes)
            self._validation_active = False
            if terminal_failure == "subject_changed":
                self.close("subject_changed")
            elif terminal_failure == "budget_exceeded":
                self.close(None)

    def finalize(self, *, terminate: bool = True) -> None:
        self._ensure_open()
        try:
            self._check_store_identity()
            for object_id in sorted(self.documents):
                retained = self.documents[object_id]
                if retained.path is None:
                    continue
                scratch_bytes = 0
                def charge_revalidation(actual_size: int) -> None:
                    nonlocal scratch_bytes
                    self.ledger.apply(
                        "snapshot_revalidation",
                        charges={
                            "snapshot_revalidation_records": 1,
                            "snapshot_revalidation_bytes": actual_size,
                        },
                        acquires={"temporary_bytes": actual_size * 2},
                        counters={
                            "snapshot_revalidation_records": 1,
                            "snapshot_revalidation_bytes": actual_size,
                            "files_read": 1,
                            "file_bytes_read": actual_size,
                            "bytes_hashed": actual_size,
                        },
                    )
                    scratch_bytes = actual_size * 2
                raw: bytes | None = None
                actual_length = 0
                try:
                    raw, actual_size, _ = self._read_exact_bounded(
                        object_id,
                        retained.subdir,
                        retained.file_name,
                        charge_revalidation,
                        revalidation=True,
                        expected_document=retained,
                    )
                    actual_length = len(raw)
                    digest = hashlib.sha256(raw).hexdigest()
                finally:
                    raw = None
                    if scratch_bytes:
                        self.ledger.release("temporary_bytes", scratch_bytes)
                if actual_length != retained.physical_bytes:
                    raise SealedValidationSubjectChanged(
                        object_id,
                        retained.path,
                        "size_changed",
                        retained.physical_bytes,
                        actual_length,
                    )
                if digest != retained.digest:
                    raise SealedValidationSubjectChanged(
                        object_id,
                        retained.path,
                        "digest_changed",
                        retained.physical_bytes,
                        actual_length,
                    )
            self._check_store_identity()
            self.finalized = True
            self.close("complete" if terminate else None)
        except SealedValidationSubjectChanged:
            self.close("subject_changed")
            raise
        except Exception:
            self.close(None)
            raise

    def close(self, terminal_reason: str | None = None) -> None:
        if self.closed:
            return
        retained_bytes = sum(
            document.retained_bytes for document in self.documents.values()
        )
        self.documents.clear()
        self.validated_commits.clear()
        self.closed = True
        if self._frame_bytes:
            self.ledger.release("retained_bytes", self._frame_bytes)
            self._frame_bytes = 0
        if retained_bytes:
            self.ledger.release("retained_bytes", retained_bytes)
        if self._aux_retained_bytes:
            self.ledger.release("retained_bytes", self._aux_retained_bytes)
            self._aux_retained_bytes = 0
        for fd, _ in self._subdir_fds.values():
            os.close(fd)
        self._subdir_fds.clear()
        os.close(self._root_fd)
        if terminal_reason is not None and self.ledger.terminal_reason is None:
            self.ledger.terminate(terminal_reason)


def validate_sealed_commit(objects_root: Path, commit_id: str, seen: set[str] | None = None) -> None:
    ledger = DecisionWorkLedger(DecisionWorkProfile.local_v1(), "sealed validation")
    session = SealedCommitValidationSession(objects_root, ledger)
    if seen:
        session.validated_commits.update(seen)
    try:
        session.validate_commit(commit_id)
        if seen is not None:
            seen.update(session.validated_commits)
        session.finalize()
    finally:
        session.close(None)


def _validate_sealed_commit_payload(
    commit: dict[str, Any],
    load_payload: Any,
    charge_edge: Any = lambda: None,
) -> None:
    roots = commit.get("roots")
    if not isinstance(roots, dict):
        raise CFError("sealed commit validation failed: roots must be an object")
    required_roots = ["content_manifest", "atom_index", "trace_graph", "fire_delta", "verification", "policy"]
    expected_root_types = {
        "content_manifest": "content_manifest",
        "atom_index": "atom_index",
        "trace_graph": "trace_graph",
        "fire_delta": "fire_ledger",
        "resolution_ledger": "resolution_ledger",
        "verification": "verification",
        "policy": "policy",
    }
    for root in required_roots:
        if root not in roots:
            raise CFError(f"sealed commit validation failed: missing root {root}")
    for root, oid in sorted(roots.items()):
        if not isinstance(oid, str) or not oid.startswith("CF-"):
            raise CFError(f"sealed commit validation failed: root {root} must be an object id")
        charge_edge()
        expected_type = expected_root_types.get(root)
        if not expected_type:
            continue
        payload = load_payload(oid)
        if payload.get("type") != expected_type:
            raise CFError(f"sealed commit validation failed: root {root} has type {payload.get('type', '(missing)')}, expected {expected_type}")
    certificate = commit.get("certificate")
    if not isinstance(certificate, dict):
        raise CFError("sealed commit validation failed: certificate must be an object")
    if certificate.get("result") != "consistent":
        raise CFError("sealed commit validation failed: certificate is not consistent")
    policy_record = load_payload(roots["policy"])
    policy = policy_record.get("policy", {})
    if policy.get("require_commit_signature"):
        validate_commit_signature_structure(commit, required=True)
    else:
        validate_commit_signature_structure(commit, required=False)
    verification = load_payload(roots["verification"])
    if verification.get("result") != "passed":
        raise CFError("sealed commit validation failed: verification object did not pass")
    if any(check.get("id") == "merge-conflicts" for check in verification.get("failed_checks", [])):
        raise CFError("sealed commit validation failed: merge conflicts remain")
    if policy_enabled(policy, "require_no_required_fires") and certificate.get("open_required_fires", 0) != 0:
        raise CFError("sealed commit validation failed: open fires remain")
    if policy_enabled(policy, "require_verification_success") and certificate.get("failed_checks", 0) != 0:
        raise CFError("sealed commit validation failed: verification checks failed")
    if policy_enabled(policy, "require_trace_completeness") and certificate.get("missing_required_links", 0) != 0:
        raise CFError("sealed commit validation failed: required links are missing")
    if policy_enabled(policy, "require_no_stale_resolutions") and certificate.get("stale_resolutions", 0) != 0:
        raise CFError("sealed commit validation failed: stale resolutions remain")
    if policy_enabled(policy, "reject_duplicate_atom_ids") and certificate.get("duplicate_atom_ids", 0) != 0:
        raise CFError("sealed commit validation failed: duplicate Atom IDs remain")


def ref_file_name(name: str) -> str:
    return urllib.parse.quote(name, safe="")


def branch_path(repo_root: Path, name: str) -> Path:
    return repo_dirs(repo_root)["branches"] / f"{ref_file_name(name)}.json"


def load_branch(repo_root: Path, name: str) -> dict[str, Any]:
    data = read_json(branch_path(repo_root, name))
    if not data:
        raise CFError(f"unknown branch: {name}")
    return data


def opened_registry_path(repo_root: Path, branch: str) -> Path:
    return repo_dirs(repo_root)["opened"] / f"{ref_file_name(branch)}.json"


def opened_branch_state(repo_root: Path, branch: str) -> str | None:
    registry = read_json(opened_registry_path(repo_root, branch))
    if not registry:
        return None
    return registry.get("state", {}).get("last_known", "open-clean")


def require_source_branch_sealed(repo_root: Path, branch: str, operation: str) -> None:
    state = opened_branch_state(repo_root, branch)
    if state and state != "open-clean":
        raise CFError(f"cannot {operation} from branch '{branch}' while it is {state}; commit or discard first")


def save_branch(repo_root: Path, data: dict[str, Any]) -> None:
    lock_name = f"branch-{ref_file_name(data['name'])}.lock"
    with file_lock(repo_dirs(repo_root)["locks"] / lock_name):
        write_json(branch_path(repo_root, data["name"]), data)
        store_object(repo_root, "branch", data)


def branch_names(repo_root: Path) -> list[str]:
    names = []
    for path in sorted(repo_dirs(repo_root)["branches"].glob("*.json")):
        names.append(read_json(path)["name"])
    return names


def active_dir(repo_root: Path, open_instance_id: str) -> Path:
    return repo_dirs(repo_root)["active"] / open_instance_id


def rel_files(open_dir: Path) -> list[Path]:
    files: list[Path] = []
    for root, dirs, names in os.walk(open_dir):
        root_path = Path(root)
        dirs[:] = [d for d in dirs if d not in {".codefire", "__pycache__", ".pytest_cache"}]
        for name in names:
            path = root_path / name
            rel = path.relative_to(open_dir)
            if rel.as_posix() == ".codefire-open":
                continue
            files.append(rel)
    return sorted(files, key=lambda p: p.as_posix())


def read_text_lossy(path: Path) -> str:
    return path.read_text(encoding="utf-8", errors="replace")


def parse_links(path: Path) -> list[dict[str, str]]:
    if not path.exists():
        return []
    links: list[dict[str, str]] = []
    current: dict[str, str] | None = None
    current_line = 0

    def flush_link() -> None:
        if current is None:
            return
        missing = {"from", "to", "type"} - set(current)
        if missing:
            raise CFError(f"invalid codefire.links.yaml: link at line {current_line} missing {', '.join(sorted(missing))}")
        links.append(current)

    for line_no, raw_line in enumerate(path.read_text(encoding="utf-8").splitlines(), start=1):
        line = raw_line.split("#", 1)[0]
        stripped = line.strip()
        if not stripped:
            continue
        m = re.match(r"-\s+from:\s*(.+)$", stripped)
        if m:
            flush_link()
            current = {"from": unquote(m.group(1))}
            current_line = line_no
            continue
        if current is None:
            continue
        m = re.match(r"(to|type):\s*(.+)$", stripped)
        if m:
            current[m.group(1)] = unquote(m.group(2))
    flush_link()
    return links


def unquote(value: str) -> str:
    value = value.strip()
    if len(value) >= 2 and value[0] in {'"', "'"} and value[-1] == value[0]:
        return value[1:-1]
    return value


def parse_bool(value: str) -> bool:
    normalized = unquote(value).strip().lower()
    if normalized in {"true", "yes", "on", "1"}:
        return True
    if normalized in {"false", "no", "off", "0"}:
        return False
    raise CFError(f"invalid boolean value in policy: {value}")


def policy_enabled(policy: dict[str, Any], key: str) -> bool:
    return bool(policy.get(key, True))


def parse_config(open_dir: Path) -> dict[str, list[str]]:
    defaults = {
        "requirements": ["docs/spec/**/*.md", "docs/requirements/**/*.md"],
        "designs": ["docs/design/**/*.md"],
        "adrs": ["adr/**/*.md", "docs/adr/**/*.md", "docs/adrs/**/*.md"],
        "ops": ["docs/ops/**/*.md", "docs/runbooks/**/*.md", "runbooks/**/*.md"],
        "apis": [
            "docs/api/**/*.json",
            "docs/api/**/*.yaml",
            "docs/api/**/*.yml",
            "openapi/**/*.json",
            "openapi/**/*.yaml",
            "openapi/**/*.yml",
            "api/**/*.json",
            "api/**/*.yaml",
            "api/**/*.yml",
        ],
        "db": ["db/**/*.sql", "schema/**/*.sql", "schemas/**/*.sql"],
        "code": ["src/**/*.py"],
        "tests": ["tests/**/*.py"],
    }
    path = open_dir / "codefire.yaml"
    if not path.exists():
        return defaults
    config = {k: [] for k in defaults}
    current: str | None = None
    for line_no, raw_line in enumerate(path.read_text(encoding="utf-8").splitlines(), start=1):
        line = raw_line.split("#", 1)[0]
        stripped = line.strip()
        if not stripped:
            continue
        if not raw_line.startswith((" ", "\t")):
            current = None
        if stripped.rstrip(":") in config and stripped.endswith(":"):
            current = stripped[:-1]
            continue
        m = re.match(r"-\s+path:\s*(.+)$", stripped)
        if current and m:
            value = unquote(m.group(1))
            if not value:
                raise CFError(f"invalid codefire.yaml: empty path at line {line_no}")
            config[current].append(value)
            continue
        if current and stripped.startswith("- "):
            raise CFError(f"invalid codefire.yaml: artifact entry at line {line_no} must start with 'path:'")
    for key, value in defaults.items():
        if not config[key]:
            config[key] = value
    return config


def parse_policy(open_dir: Path) -> dict[str, Any]:
    path = open_dir / "codefire.policy.yaml"
    default_required_links = {
        "requirement": [
            {"type": "refined_by", "target_kind": "design", "min": 1},
            {"type": "verified_by", "target_kind": "test", "min": 1},
        ],
        "design": [{"type": "implemented_by", "target_kind": "code", "min": 1}],
    }
    policy = {
        "require_no_required_fires": True,
        "require_no_stale_resolutions": True,
        "require_trace_completeness": True,
        "require_verification_success": True,
        "reject_duplicate_atom_ids": True,
        "no_change_required_requires_rationale": True,
        "required_links": default_required_links,
        "verification": [],
    }
    if not path.exists():
        return policy
    checks: list[dict[str, str]] = []
    current: dict[str, str] | None = None
    custom_required_links: dict[str, list[dict[str, Any]]] = {}
    current_link_kind: str | None = None
    current_link_rule: dict[str, Any] | None = None
    in_required_links = False
    in_commit_policy = False
    in_extinguish_policy = False
    in_no_change_required_policy = False

    def flush_check() -> None:
        if current and current.get("command"):
            check = dict(current)
            check.setdefault("id", f"verification-{len(checks) + 1}")
            check.setdefault("cwd", ".")
            checks.append(check)
        elif current:
            raise CFError("invalid codefire.policy.yaml: verification entry missing command")

    def flush_required_link() -> None:
        if current_link_kind and current_link_rule:
            missing = {"type", "target_kind"} - set(current_link_rule)
            if missing:
                raise CFError(f"invalid codefire.policy.yaml: required_links.{current_link_kind} missing {', '.join(sorted(missing))}")
            rule = dict(current_link_rule)
            try:
                rule["min"] = int(rule.get("min", 1) or 1)
            except ValueError as exc:
                raise CFError(f"invalid codefire.policy.yaml: required_links.{current_link_kind}.min must be an integer") from exc
            custom_required_links.setdefault(current_link_kind, []).append(rule)

    for raw_line in path.read_text(encoding="utf-8").splitlines():
        line = raw_line.split("#", 1)[0].rstrip()
        stripped = line.strip()
        if not stripped:
            continue
        if not raw_line.startswith((" ", "\t")):
            if stripped == "required_links:":
                flush_required_link()
                current_link_kind = None
                current_link_rule = None
                in_required_links = True
                in_commit_policy = False
            elif stripped == "commit_policy:":
                flush_required_link()
                current_link_kind = None
                current_link_rule = None
                in_required_links = False
                in_commit_policy = True
                in_extinguish_policy = False
                in_no_change_required_policy = False
            elif stripped == "extinguish_policy:":
                flush_required_link()
                current_link_kind = None
                current_link_rule = None
                in_required_links = False
                in_commit_policy = False
                in_extinguish_policy = True
                in_no_change_required_policy = False
            else:
                flush_required_link()
                current_link_kind = None
                current_link_rule = None
                in_required_links = False
                in_commit_policy = False
                in_extinguish_policy = False
                in_no_change_required_policy = False
        if in_commit_policy:
            m = re.match(r"(require_no_required_fires|require_no_stale_resolutions|require_trace_completeness|require_verification_success|reject_duplicate_atom_ids):\s*(.+)$", stripped)
            if m:
                policy[m.group(1)] = parse_bool(m.group(2))
                continue
        if in_extinguish_policy:
            if re.match(r"^\s{2}no-change-required:\s*$", line):
                in_no_change_required_policy = True
                continue
            m = re.match(r"requires_rationale:\s*(.+)$", stripped)
            if m and in_no_change_required_policy:
                policy["no_change_required_requires_rationale"] = parse_bool(m.group(1))
                continue
        if in_required_links:
            m = re.match(r"^\s{2}([A-Za-z_][A-Za-z0-9_-]*):\s*$", line)
            if m:
                flush_required_link()
                current_link_kind = m.group(1)
                current_link_rule = None
                custom_required_links.setdefault(current_link_kind, [])
                continue
            m = re.match(r"-\s+(type|target_kind|min):\s*(.+)$", stripped)
            if m:
                flush_required_link()
                current_link_rule = {m.group(1): unquote(m.group(2))}
                continue
            m = re.match(r"(type|target_kind|min):\s*(.+)$", stripped)
            if m and current_link_rule is not None:
                current_link_rule[m.group(1)] = unquote(m.group(2))
                continue
        m = re.match(r"-\s+(id|command|cwd):\s*(.+)$", stripped)
        if m:
            flush_check()
            current = {m.group(1): unquote(m.group(2))}
            if "cwd" not in current:
                current["cwd"] = "."
            continue
        m = re.match(r"(id|command|cwd):\s*(.+)$", stripped)
        if m:
            if current is None:
                current = {"cwd": "."}
            current[m.group(1)] = unquote(m.group(2))
    flush_check()
    flush_required_link()
    if custom_required_links:
        policy["required_links"] = custom_required_links
    policy["verification"].extend(checks)
    return policy


def matches_any(rel: Path, patterns: list[str]) -> bool:
    s = rel.as_posix()
    for pat in patterns:
        if fnmatch.fnmatch(s, pat):
            return True
        if "**/" in pat and fnmatch.fnmatch(s, pat.replace("**/", "")):
            return True
    return False


def kind_from_atom_id(atom_id: str, fallback: str = "unknown") -> str:
    if atom_id.startswith("REQ-"):
        return "requirement"
    if atom_id.startswith("DES-"):
        return "design"
    if atom_id.startswith("TEST-"):
        return "test"
    if atom_id.startswith("CODE-") or atom_id.startswith("CODE:"):
        return "code"
    if atom_id.startswith("ADR-"):
        return "adr"
    if atom_id.startswith("OPS-"):
        return "ops"
    if atom_id.startswith("API-"):
        return "api"
    if atom_id.startswith("DB-"):
        return "db"
    return fallback


def hash_text(text: str) -> str:
    return digest_bytes(text.encode("utf-8"))


def extract_markdown_atoms(path: Path, rel: Path, fallback_kind: str) -> list[dict[str, Any]]:
    lines = read_text_lossy(path).splitlines()
    headings: list[tuple[int, int, str]] = []
    for i, line in enumerate(lines):
        m = re.match(r"^(#{1,6})\s+([A-Z]+-[A-Za-z0-9_.-]+)(?::|\s|$)", line)
        if m:
            headings.append((i, len(m.group(1)), m.group(2)))
    atoms: list[dict[str, Any]] = []
    for idx, (start, level, atom_id) in enumerate(headings):
        end = len(lines)
        for next_start, next_level, _ in headings[idx + 1 :]:
            if next_level <= level:
                end = next_start
                break
        content = "\n".join(lines[start:end]).strip() + "\n"
        atoms.append(
            {
                "atom_id": atom_id,
                "kind": kind_from_atom_id(atom_id, fallback_kind),
                "artifact_path": rel.as_posix(),
                "selector": {"type": "markdown_heading", "value": atom_id},
                "content_hash": hash_text(content),
            }
        )
    return atoms


def python_blocks(lines: list[str]) -> list[tuple[int, int, str, str]]:
    blocks: list[tuple[int, int, str, str]] = []
    class_stack: list[tuple[int, str]] = []
    for i, line in enumerate(lines):
        m = re.match(r"^(\s*)(class|def)\s+([A-Za-z_][A-Za-z0-9_]*)", line)
        if not m:
            continue
        indent = len(m.group(1))
        while class_stack and indent <= class_stack[-1][0]:
            class_stack.pop()
        end = len(lines)
        for j in range(i + 1, len(lines)):
            text = lines[j]
            if text.strip() == "":
                continue
            current_indent = len(text) - len(text.lstrip(" "))
            if current_indent <= indent and not text.lstrip().startswith(("#", "@")):
                end = j
                break
        symbol_type = m.group(2)
        name = m.group(3)
        if symbol_type == "class":
            class_stack.append((indent, name))
        elif class_stack:
            symbol_type = "method"
            name = f"{class_stack[-1][1]}.{name}"
        blocks.append((i, end, symbol_type, name))
    return blocks


def extract_python_atoms(path: Path, rel: Path, fallback_kind: str) -> list[dict[str, Any]]:
    lines = read_text_lossy(path).splitlines()
    explicit_by_line: dict[int, str] = {}
    for i, line in enumerate(lines):
        m = re.search(r"#\s*cf-atom:\s*([A-Za-z0-9_.:-]+)", line)
        if m:
            explicit_by_line[i] = m.group(1)
    atoms: list[dict[str, Any]] = []
    used_explicit: set[int] = set()
    for start, end, symbol_type, name in python_blocks(lines):
        explicit_line = None
        for candidate in range(max(0, start - 3), start + 1):
            if candidate in explicit_by_line and candidate not in used_explicit:
                explicit_line = candidate
        if explicit_line is not None:
            atom_id = explicit_by_line[explicit_line]
            used_explicit.add(explicit_line)
        else:
            prefix = "TEST" if fallback_kind == "test" else "CODE"
            atom_id = f"{prefix}:{rel.as_posix()}::{symbol_type}:{name}"
        content_start = explicit_line if explicit_line is not None else start
        content = "\n".join(lines[content_start:end]).strip() + "\n"
        atoms.append(
            {
                "atom_id": atom_id,
                "kind": kind_from_atom_id(atom_id, fallback_kind),
                "artifact_path": rel.as_posix(),
                "selector": {"type": f"python_{symbol_type}", "value": name},
                "content_hash": hash_text(content),
            }
        )
    for line_no, atom_id in explicit_by_line.items():
        if line_no in used_explicit:
            continue
        content = lines[line_no].strip() + "\n"
        atoms.append(
            {
                "atom_id": atom_id,
                "kind": kind_from_atom_id(atom_id, fallback_kind),
                "artifact_path": rel.as_posix(),
                "selector": {"type": "python_comment", "value": atom_id},
                "content_hash": hash_text(content),
            }
        )
    return atoms


def javascript_blocks(lines: list[str]) -> list[tuple[int, int, str, str]]:
    blocks: list[tuple[int, int, str, str]] = []
    patterns = [
        (re.compile(r"^\s*(?:export\s+default\s+|export\s+)?class\s+([A-Za-z_$][A-Za-z0-9_$]*)"), "class"),
        (re.compile(r"^\s*(?:export\s+)?(?:async\s+)?function\s+([A-Za-z_$][A-Za-z0-9_$]*)"), "function"),
        (re.compile(r"^\s*(?:export\s+)?(?:const|let|var)\s+([A-Za-z_$][A-Za-z0-9_$]*)\s*=\s*(?:async\s*)?\(?[^=]*\)?\s*=>"), "function"),
    ]
    for i, line in enumerate(lines):
        symbol_type = ""
        name = ""
        for pattern, candidate_type in patterns:
            m = pattern.match(line)
            if m:
                symbol_type = candidate_type
                name = m.group(1)
                break
        if not name:
            continue
        end = len(lines)
        brace_balance = line.count("{") - line.count("}")
        if brace_balance > 0:
            for j in range(i + 1, len(lines)):
                brace_balance += lines[j].count("{") - lines[j].count("}")
                if brace_balance <= 0:
                    end = j + 1
                    break
        else:
            for j in range(i + 1, len(lines)):
                if lines[j].strip() and re.match(r"^\s*(?:export\s+)?(?:class|async\s+function|function|const|let|var)\s+", lines[j]):
                    end = j
                    break
        blocks.append((i, end, symbol_type, name))
    return blocks


