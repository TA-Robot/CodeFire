{
  "schema": "codefire.ai_focused_test_map.v1",
  "rules": [
    {
      "id": "ai-development-system",
      "paths": [".codex/**", "docs/development/ai/**", "docs/development/exploration/**", "docs/development/strategy/**", "docs/development/tools/*.py"],
      "commands": [
        {
          "command": "python3 docs/development/tools/check_ai_development.py",
          "capability": "python3",
          "purpose": "Validate AI docs, packet contracts, routing, runtime configuration, and tool tests."
        }
      ]
    },
    {
      "id": "rust-cli",
      "paths": ["crates/codefire-cli/**"],
      "commands": [
        {"command": "cargo fmt --check", "capability": "cargo", "purpose": "Check workspace formatting."},
        {"command": "cargo test -p codefire-cli --bin codefire-rs", "capability": "cargo", "purpose": "Run CLI unit and integration coverage."},
        {"command": "cargo clippy -p codefire-cli --all-targets -- -D warnings", "capability": "cargo", "purpose": "Reject CLI warnings."}
      ]
    },
    {
      "id": "rust-core",
      "paths": ["crates/codefire-core/**"],
      "commands": [
        {"command": "cargo fmt --check", "capability": "cargo", "purpose": "Check workspace formatting."},
        {"command": "cargo test -p codefire-core", "capability": "cargo", "purpose": "Run domain-rule tests."},
        {"command": "cargo clippy -p codefire-core --all-targets -- -D warnings", "capability": "cargo", "purpose": "Reject core warnings."}
      ]
    },
    {
      "id": "rust-store",
      "paths": ["crates/codefire-store/**"],
      "commands": [
        {"command": "cargo fmt --check", "capability": "cargo", "purpose": "Check workspace formatting."},
        {"command": "cargo test -p codefire-store", "capability": "cargo", "purpose": "Run object/store integrity tests."},
        {"command": "cargo clippy -p codefire-store --all-targets -- -D warnings", "capability": "cargo", "purpose": "Reject store warnings."}
      ]
    },
    {
      "id": "rust-util-or-workspace",
      "paths": ["Cargo.toml", "Cargo.lock", "crates/codefire-util/**"],
      "commands": [
        {"command": "cargo fmt --check", "capability": "cargo", "purpose": "Check workspace formatting."},
        {"command": "cargo test --workspace", "capability": "cargo", "purpose": "Run cross-crate coverage."},
        {"command": "cargo clippy --workspace --all-targets -- -D warnings", "capability": "cargo", "purpose": "Reject workspace warnings."}
      ]
    },
    {
      "id": "python-reference",
      "paths": ["codefire", "tests/**", "pyproject.toml", "setup.py"],
      "commands": [
        {"command": "python3 -m py_compile codefire tests/test_codefire_cli.py", "capability": "python3", "purpose": "Compile the Python CLI and test module."},
        {"command": "python3 -m unittest discover -s tests -v", "capability": "python3", "purpose": "Run Python reference behavior tests."}
      ]
    },
    {
      "id": "installer",
      "paths": ["install.sh"],
      "commands": [
        {"command": "bash -n install.sh", "capability": "bash", "purpose": "Check installer syntax."},
        {"command": "./install.sh --prefix /tmp/codefire-install-smoke", "capability": "rust-source-bound-binary", "purpose": "Exercise the Rust-first temporary-prefix install with a binary bound to current source."},
        {"command": "/tmp/codefire-install-smoke/bin/codefire --help", "capability": "rust-source-bound-binary", "purpose": "Smoke the installed current-source Rust CLI."},
        {"command": "/tmp/codefire-install-smoke/bin/codefire-py --help", "capability": "python3", "purpose": "Smoke the installed Python fallback."}
      ]
    },
    {
      "id": "source-documentation",
      "paths": ["crates/codefire-cli/src/**", "crates/codefire-core/src/**", "crates/codefire-store/src/**", "docs/development/source-architecture.md", "docs/development/command-source-trace.md", "docs/development/source-data-model-catalog.md", "docs/development/change-playbook.md"],
      "commands": [
        {"command": "python3 docs/development/tools/check_source_docs.py", "capability": "python3", "purpose": "Check module, command, object-kind, version, and retired-source-doc consistency."}
      ]
    },
    {
      "id": "product-contract-docs",
      "paths": ["README.md", "AGENTS.md", "docs/*.md", "adr/**", "schemas/**", "docs/development/**"],
      "commands": [
        {"command": "python3 docs/development/tools/check_project_docs.py", "capability": "python3", "purpose": "Check links, document lifecycle, ledgers, and current-state ownership."}
      ]
    },
    {
      "id": "dogfood-project",
      "paths": ["subprojects/algorithm-evolution-agent-lab/**"],
      "commands": [
        {"command": "PYTHONPATH=src python3 -m unittest discover -s tests -v", "capability": "python3", "purpose": "Run the dogfood project tests from its repository root.", "cwd": "subprojects/algorithm-evolution-agent-lab"},
        {"command": "codefire status --path subprojects/algorithm-evolution-agent-lab --json", "capability": "codefire", "purpose": "Inspect dogfood consistency without mutation."}
      ]
    }
  ]
}
