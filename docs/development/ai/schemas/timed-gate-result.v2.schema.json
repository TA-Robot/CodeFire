{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codefire.dev/schemas/ai/timed-gate-result.v2.schema.json",
  "title": "CodeFire timed gate result v2",
  "description": "Compatibility-distinct successor to codefire.timed_gate.v1. The runner derives the Git root containing its cwd, the canonical HEAD revision and HEAD tree, the porcelain status immediately before and after the command, and the index entries whose tag is not H. It proves that the record, the committed candidate identity, the clean-before and clean-after states, the timed result and the retained bytes agree. It does not prove honest execution, semantic oracle quality, nonzero test selection, or the absence of mutate-and-restore activity inside the command.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "argv",
    "cwd",
    "timeout_seconds",
    "timed_out",
    "exit_code",
    "status",
    "started_at",
    "ended_at",
    "duration_seconds",
    "duration_source",
    "wall_elapsed_seconds",
    "wall_minus_monotonic_seconds",
    "wall_clock_discontinuity",
    "drift_threshold_seconds",
    "source",
    "worktree",
    "log",
    "result",
    "limits"
  ],
  "properties": {
    "schema": {
      "const": "codefire.timed_gate.v2"
    },
    "argv": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "cwd": {
      "type": "string",
      "minLength": 1,
      "pattern": "^/(?:[^/\\\\\\u0000-\\u001F\\u007F]+/)*[^/\\\\\\u0000-\\u001F\\u007F]*$",
      "description": "Machine-specific absolute path. Diagnostic only."
    },
    "timeout_seconds": {
      "type": "number",
      "minimum": 0,
      "description": "Runtime semantic validation additionally requires a finite value greater than zero."
    },
    "timed_out": {
      "type": "boolean"
    },
    "exit_code": {
      "type": "integer"
    },
    "status": {
      "enum": ["passed", "failed"]
    },
    "started_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"
    },
    "ended_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"
    },
    "duration_seconds": {
      "type": "number",
      "minimum": 0
    },
    "duration_source": {
      "const": "time.monotonic_ns"
    },
    "wall_elapsed_seconds": {
      "type": "number"
    },
    "wall_minus_monotonic_seconds": {
      "type": "number"
    },
    "wall_clock_discontinuity": {
      "type": "boolean"
    },
    "drift_threshold_seconds": {
      "type": "number",
      "minimum": 0
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["git_root", "revision", "tree", "derived"],
      "properties": {
        "git_root": {
          "type": "string",
          "minLength": 1,
          "pattern": "^/(?:[^/\\\\\\u0000-\\u001F\\u007F]+/)*[^/\\\\\\u0000-\\u001F\\u007F]*$",
          "description": "Machine-specific absolute path of the Git root containing cwd. Diagnostic only; identity is carried by revision and tree."
        },
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "tree": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "derived": {
          "const": "git -C <cwd> rev-parse --show-toplevel HEAD HEAD^{tree}"
        }
      }
    },
    "worktree": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "clean_before",
        "clean_after",
        "status_before",
        "status_after",
        "index_flagged_entries",
        "index_flags_clean",
        "head_revision_after",
        "head_tree_after",
        "head_unchanged",
        "head_probe_error",
        "log_inside_source_worktree",
        "result_inside_source_worktree",
        "status_command",
        "index_command"
      ],
      "properties": {
        "clean_before": {
          "type": "boolean"
        },
        "clean_after": {
          "type": "boolean"
        },
        "status_before": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "status_after": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "index_flagged_entries": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "The union, before and after execution, of every git ls-files -v entry whose tag is not H, rendered as '<tag>\\t<path>'. This covers assume-unchanged (lowercase tags) and skip-worktree (S), including a flag cleared during execution."
        },
        "index_flags_clean": {
          "type": "boolean"
        },
        "head_revision_after": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{40}$"
        },
        "head_tree_after": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{40}$"
        },
        "head_unchanged": {
          "type": "boolean",
          "description": "Derived by comparing canonical HEAD and HEAD^{tree} immediately after execution with the source revision/tree captured before execution. Recurrence acceptance requires true."
        },
        "head_probe_error": {
          "type": ["string", "null"],
          "description": "Null when the post-command HEAD/tree probe succeeded; otherwise the diagnostic probe failure and head_unchanged is false."
        },
        "log_inside_source_worktree": {
          "type": "boolean",
          "description": "Logs and results are written outside the source worktree and copied byte-identically into the evidence commit, so they do not make the checkout dirty. A true value is emitted rather than hidden."
        },
        "result_inside_source_worktree": {
          "type": "boolean",
          "description": "True when the requested result path is inside the source worktree. Recurrence acceptance requires false, and the v2 runner refuses to run unless an explicit --result path is supplied."
        },
        "status_command": {
          "const": "git status --porcelain=v1 -z --untracked-files=all"
        },
        "index_command": {
          "const": "git ls-files -v -z"
        }
      }
    },
    "log": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256", "complete"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^/(?:[^/\\\\\\u0000-\\u001F\\u007F]+/)*[^/\\\\\\u0000-\\u001F\\u007F]*$",
          "description": "Machine-specific absolute path. Diagnostic only; the committed log is linked by digest and byte count."
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "complete": {
          "type": "boolean"
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^/(?:[^/\\\\\\u0000-\\u001F\\u007F]+/)*[^/\\\\\\u0000-\\u001F\\u007F]*$",
          "description": "Resolved machine-specific absolute output path. Runtime replay requires it to be distinct from the log and lexically outside source.git_root."
        }
      }
    },
    "limits": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
