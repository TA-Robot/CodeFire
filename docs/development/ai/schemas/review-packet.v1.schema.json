{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codefire.dev/schemas/ai/review-packet.v1.schema.json",
  "title": "CodeFire AI Review Packet v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "review_id",
    "task_packet_id",
    "task_packet_sha256",
    "base_revision",
    "head_revision",
    "patch_sha256",
    "reviewer_independent",
    "review_tier",
    "files_changed",
    "claims",
    "validation_evidence",
    "findings",
    "decision"
  ],
  "properties": {
    "schema": {"const": "codefire.ai_review_packet.v1"},
    "review_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"},
    "task_packet_id": {"type": "string", "minLength": 1},
    "task_packet_sha256": {"$ref": "#/$defs/sha256"},
    "base_revision": {"type": "string", "minLength": 1},
    "head_revision": {"type": "string", "minLength": 1},
    "patch_sha256": {"$ref": "#/$defs/sha256"},
    "reviewer_independent": {"type": "boolean"},
    "review_tier": {"enum": ["high", "ultra"]},
    "files_changed": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim", "evidence_refs", "verified"],
        "properties": {
          "claim": {"type": "string", "minLength": 1},
          "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "verified": {"type": "boolean"}
        }
      }
    },
    "validation_evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["validation_id", "command", "status", "summary"],
        "properties": {
          "validation_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{1,127}$"},
          "command": {"type": "string", "minLength": 1},
          "status": {"enum": ["passed", "failed", "blocked", "not_run"]},
          "summary": {"type": "string", "minLength": 1},
          "log_sha256": {"$ref": "#/$defs/sha256"},
          "capability_evidence_sha256": {"$ref": "#/$defs/sha256"},
          "capability_evidence_path": {"type": "string", "minLength": 1, "maxLength": 4096}
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "statement", "evidence_ref", "required_action"],
        "properties": {
          "severity": {"enum": ["block", "high", "medium", "low"]},
          "statement": {"type": "string", "minLength": 1},
          "evidence_ref": {"type": "string", "minLength": 1},
          "required_action": {"type": "string", "minLength": 1}
        }
      }
    },
    "decision": {"enum": ["approve", "request_changes", "block"]},
    "residual_risks": {"type": "array", "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
