{
  "schema": "codefire.ai_provider_routing.v1",
  "policy_version": "low-codex-v1",
  "decision_order": [
    "task_packet_risk_tier",
    "role_default",
    "explicit_provider_override"
  ],
  "tier_routes": {
    "medium": {
      "provider": "fugu",
      "model": "fugu-ultra-v1.1",
      "default_timeout": "2h",
      "use_for": [
        "bounded_repository_evidence",
        "classification",
        "deterministic_validation",
        "source_backed_docs",
        "strong_oracle_small_change"
      ]
    },
    "high": {
      "provider": "claude",
      "models": {
        "implementation": "claude-opus-5",
        "review_or_research": "claude-opus-5"
      },
      "default_timeout": {
        "implementation": "6h",
        "review_or_research": "4h"
      },
      "use_for": [
        "focused_implementation",
        "debugging",
        "root_cause_analysis",
        "independent_review",
        "dogfood"
      ]
    },
    "ultra": {
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "default_timeout": "3h",
      "requires_explicit_allow_codex": true,
      "use_for": [
        "cross_subsystem_architecture",
        "invariant_or_security_decision",
        "conflicting_evidence",
        "integration_branch",
        "release_completion_audit"
      ]
    }
  },
  "role_defaults": {
    "manager": "codex",
    "architect": "codex",
    "integrator": "codex",
    "final_auditor": "codex",
    "implementer": "claude",
    "reviewer": "claude",
    "researcher": "claude",
    "dogfood_runner": "claude",
    "debugger": "claude",
    "classifier": "fugu",
    "docs_synchronizer": "fugu",
    "validation_runner": "fugu",
    "triage": "fugu",
    "test_generator": "fugu"
  },
  "concurrency": {
    "fugu": 4,
    "claude": 2,
    "codex": 1
  },
  "fallback": {
    "automatic_codex_fallback": false,
    "fugu_to_claude_requires_explicit_allow": true,
    "claude_to_codex": "forbidden",
    "unavailable_provider": "preserve_worktree_session_and_commits_then_stop_or_explicitly_reroute"
  },
  "integration": {
    "implementation_and_review_must_use_independent_agents": true,
    "review_decision_gate": "machine_readable_result_json",
    "automatic_main_merge": false,
    "integration_branch_required": true
  }
}
